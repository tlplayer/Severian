import artifact
import mlir
import universal
import "error.sev"
import "model.sev"

trait CompileHandler:
    compile(region: CompileRegion, context: CompileContext) -> mlir.MlirArtifact | CompileError


class CompilerRegistry:
    handlers: map[universal.CompilerId, CompileHandler]

    def CompilerRegistry():
        handlers = {}

    def register(compiler: universal.CompilerId, handler: CompileHandler) -> unit | CompileError:
        if handlers.contains(compiler):
            return error(DuplicateHandler(compiler))
        handlers[compiler] = handler
        return unit

    def compile(plan: CompilePlan, context: CompileContext) -> list[mlir.VerifiedMlirArtifact] | CompileError:
        artifacts: list[mlir.VerifiedMlirArtifact] = []
        regions: list[CompileRegion] = plan.nested_regions.copy()
        for segment in plan.initializer.segments:
            match segment:
                case Compiler: regions.append(region)
        for function in plan.functions:
            if function.body != None:
                for segment in function.body.segments:
                    match segment:
                        case Compiler: regions.append(region)
        for region in regions:
            handler = handlers.get(region.compiler)
            if handler == None:
                return error(MissingHandler(region.compiler))
            generated = handler.compile(region, context)
            if len(generated.inputs) != len(region.inputs) or len(generated.outputs) != len(region.outputs):
                return error(InvalidArtifact("handler output does not match region"))
            artifacts.append(mlir.verify_artifact(artifact.artifact_for_region(region.id), generated, context.target_spec))
        return artifacts

