import artifact
import mir
import target
import universal

class EffectSet:
    reads_memory: bool
    writes_memory: bool
    may_trap: bool


class CompileRegion:
    id: universal.CompiledRegionId
    compiler: universal.CompilerId
    operations: list[universal.Operation]
    inputs: list[universal.Value]
    outputs: list[universal.Value]
    effects: EffectSet


class StandardRegion:
    operations: list[universal.Operation]


enum PlanSegment:
    Standard(region: StandardRegion)
    Compiler(region: CompileRegion)


class PlannedBlock:
    source: universal.Block
    segments: list[PlanSegment]


class PlannedFunction:
    declaration: universal.FunctionDeclaration
    body: PlannedBlock | None


class CompilePlan:
    source: universal.Module
    initializer: PlannedBlock
    functions: list[PlannedFunction]
    nested_regions: list[CompileRegion]

    def has_custom_regions() -> bool:
        if len(nested_regions) > 0:
            return true
        for segment in initializer.segments:
            match segment:
                case Compiler:
                    return true
        for function in functions:
            if function.body != None:
                for segment in function.body.segments:
                    match segment:
                        case Compiler:
                            return true
        return false

    def resumed_mir() -> universal.Module:
        module = source
        module.initializer = resume_block(initializer)
        module.functions = []
        for function in functions:
            declaration = function.declaration
            if function.body != None:
                declaration.body = resume_block(function.body)
            module.functions.append(declaration)
        return module


class CompileContext:
    types: universal.TypeContext
    target_spec: target.TargetSpec


def resume_block(block: PlannedBlock) -> universal.Block:
    operations: list[universal.Operation] = []
    for segment in block.segments:
        match segment:
            case Standard:
                for operation in region.operations:
                    operations.append(operation)
            case Compiler:
                inputs: list[universal.ValueId] = []
                outputs: list[universal.ValueId] = []
                for value in region.inputs:
                    inputs.append(value.id)
                for value in region.outputs:
                    outputs.append(value.id)
                operations.append(universal.CompiledRegionCall(artifact.artifact_for_region(region.id), inputs, outputs))
    block.source.operations = operations
    return block.source
