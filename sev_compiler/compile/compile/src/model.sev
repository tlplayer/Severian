import * from "../../../hir/module/module.sev" as model_hir_module_module
import * from "../../../mir/value.sev" as model_mir_value
import * from "../../../syntax/block/block.sev" as model_syntax_block_block
import * from "../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import artifact
import mir
import target
import universal

class EffectSet:
    reads_memory: bool
    writes_memory: bool
    may_trap: bool


class CompileRegion:
    id: model_syntax_symbol_symbol.CompiledRegionId
    compiler: model_syntax_symbol_symbol.CompilerId
    operations: list[model_syntax_function_function.Operation]
    inputs: list[model_mir_value.Value]
    outputs: list[model_mir_value.Value]
    effects: EffectSet


class StandardRegion:
    operations: list[model_syntax_function_function.Operation]


enum PlanSegment:
    Standard(region: StandardRegion)
    Compiler(region: CompileRegion)


class PlannedBlock:
    source: model_syntax_block_block.Block
    segments: list[PlanSegment]


class PlannedFunction:
    declaration: model_syntax_function_function.FunctionDeclaration
    body: PlannedBlock | None


class CompilePlan:
    source: model_hir_module_module.Module
    initializer: PlannedBlock
    functions: list[PlannedFunction]
    nested_regions: list[CompileRegion]

    def has_custom_regions() -> bool:
        if len(nested_regions) > 0:
            return true
        for segment in initializer.segments:
            match segment:
                case Compiler:
                    return true
        for function in functions:
            if function.body != None:
                for segment in function.body.segments:
                    match segment:
                        case Compiler:
                            return true
        return false

    def resumed_mir() -> model_hir_module_module.Module:
        module = source
        module.initializer = resume_block(initializer)
        module.functions = []
        for function in functions:
            declaration = function.declaration
            if function.body != None:
                declaration.body = resume_block(function.body)
            module.functions.append(declaration)
        return module


class CompileContext:
    types: universal.TypeContext
    target_spec: target.TargetSpec


def resume_block(block: PlannedBlock) -> model_syntax_block_block.Block:
    operations: list[model_syntax_function_function.Operation] = []
    for segment in block.segments:
        match segment:
            case Standard:
                for operation in region.operations:
                    operations.append(operation)
            case Compiler:
                inputs: list[model_syntax_symbol_symbol.ValueId] = []
                outputs: list[model_syntax_symbol_symbol.ValueId] = []
                for value in region.inputs:
                    inputs.append(value.id)
                for value in region.outputs:
                    outputs.append(value.id)
                operations.append(model_syntax_function_function.CompiledRegionCall(artifact.artifact_for_region(region.id), inputs, outputs))
    block.source.operations = operations
    return block.source
