import "../../../hir/module/module.sev" as model_hir_module_module
import "../../../mir/value.sev" as model_mir_value
import "../../../syntax/block/block.sev" as model_syntax_block_block
import "../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import artifact
import mir
import universal
import CompileError from "error.sev"
import CompilePlan, CompileRegion, EffectSet, PlanSegment, PlannedBlock, PlannedFunction, StandardRegion from "model.sev"

def operation_inputs(operation: model_syntax_function_function.Operation) -> list[model_syntax_symbol_symbol.ValueId]:
    match operation:
        case Unary:
            return [operand]
        case Binary:
            return [left, right]
        case Call:
            return arguments
        case Return:
            return [value] if value != None else []
        case Assert:
            return [condition, message] if message != None else [condition]
        case If:
            result: list[model_syntax_symbol_symbol.ValueId] = [condition]
            for nested in then_block.operations:
                for value in operation_inputs(nested):
                    result.append(value)
            for nested in else_block.operations:
                for value in operation_inputs(nested):
                    result.append(value)
            return result
        case Match:
            return [subject]
        case CompiledRegionCall:
            return inputs
        else:
            return []


def operation_outputs(operation: model_syntax_function_function.Operation) -> list[model_syntax_symbol_symbol.ValueId]:
    match operation:
        case Constant:
            return [result]
        case Unary:
            return [result]
        case Binary:
            return [result]
        case Call:
            return [result]
        case CompiledRegionCall:
            return outputs
        else:
            return []


def operation_route(operation: model_syntax_function_function.Operation, values: map[model_syntax_symbol_symbol.ValueId, model_mir_value.Value], types: universal.TypeContext, index: int) -> model_syntax_function_function.CompileRoute | CompileError:
    match operation:
        case CompiledRegionCall:
            return error(PlannerGeneratedOperation(index))
        case Coverage:
            return model_syntax_function_function.Standard
        case Return:
            return model_syntax_function_function.Standard
        case Assert:
            return model_syntax_function_function.Standard
        case If:
            return model_syntax_function_function.Standard
        case Match:
            return model_syntax_function_function.Standard
    compilers: set[model_syntax_symbol_symbol.CompilerId] = set()
    all_values = operation_inputs(operation) + operation_outputs(operation)
    for value_id in all_values:
        value = values.get(value_id)
        if value == None:
            return error(MissingValue(value_id.index))
        route = types.compile_route(value.type_id)
        match route:
            case Compiler:
                compilers.add(compiler)
    if len(compilers) == 0:
        return model_syntax_function_function.Standard
    if len(compilers) == 1:
        return model_syntax_function_function.Compiler(compilers.values()[0])
    return error(ConflictingCompilers(index, compilers.values()))


def build_region(id: model_syntax_symbol_symbol.CompiledRegionId, compiler: model_syntax_symbol_symbol.CompilerId, operations: list[model_syntax_function_function.Operation], values: map[model_syntax_symbol_symbol.ValueId, model_mir_value.Value]) -> CompileRegion | CompileError:
    produced: set[model_syntax_symbol_symbol.ValueId] = set()
    for operation in operations:
        for output in operation_outputs(operation):
            produced.add(output)
    inputs: list[model_mir_value.Value] = []
    for operation in operations:
        for input in operation_inputs(operation):
            if input not in produced and not inputs.contains(values[input]):
                inputs.append(values[input])
    outputs: list[model_mir_value.Value] = []
    for output in produced:
        outputs.append(values[output])
    effects = EffectSet(false, false, false)
    for operation in operations:
        match operation:
            case Call:
                effects.reads_memory = true
                effects.writes_memory = true
                effects.may_trap = true
    return CompileRegion(id, compiler, operations, inputs, outputs, effects)


def plan_block(block: model_syntax_block_block.Block, values: map[model_syntax_symbol_symbol.ValueId, model_mir_value.Value], types: universal.TypeContext, next_region: u32) -> tuple[PlannedBlock, u32] | CompileError:
    segments: list[PlanSegment] = []
    current_standard: list[model_syntax_function_function.Operation] = []
    current_custom: list[model_syntax_function_function.Operation] = []
    current_compiler: model_syntax_symbol_symbol.CompilerId | None = None

    for index, operation in block.operations.enumerated():
        route = operation_route(operation, values, types, index)
        match route:
            case Standard:
                if len(current_custom) > 0:
                    segments.append(Compiler(build_region(model_syntax_symbol_symbol.CompiledRegionId(next_region), current_compiler, current_custom, values)))
                    next_region += 1
                    current_custom = []
                    current_compiler = None
                current_standard.append(operation)
            case Compiler:
                if len(current_standard) > 0:
                    segments.append(Standard(StandardRegion(current_standard)))
                    current_standard = []
                if current_compiler != None and current_compiler != compiler:
                    segments.append(Compiler(build_region(model_syntax_symbol_symbol.CompiledRegionId(next_region), current_compiler, current_custom, values)))
                    next_region += 1
                    current_custom = []
                current_compiler = compiler
                current_custom.append(operation)

    if len(current_standard) > 0:
        segments.append(Standard(StandardRegion(current_standard)))
    if len(current_custom) > 0:
        segments.append(Compiler(build_region(model_syntax_symbol_symbol.CompiledRegionId(next_region), current_compiler, current_custom, values)))
        next_region += 1
    return (PlannedBlock(block, segments), next_region)


def plan(module: model_hir_module_module.Module, types: universal.TypeContext) -> CompilePlan | CompileError:
    values: map[model_syntax_symbol_symbol.ValueId, model_mir_value.Value] = {}
    for value in module.values:
        values[value.id] = value
    next_region: u32 = 0
    initializer_result = plan_block(module.initializer, values, types, next_region)
    next_region = initializer_result[1]
    functions: list[PlannedFunction] = []
    for function in module.functions:
        body: PlannedBlock | None = None
        if function.body != None:
            planned = plan_block(function.body, values, types, next_region)
            body = planned[0]
            next_region = planned[1]
        functions.append(PlannedFunction(function, body))
    return CompilePlan(module, initializer_result[0], functions, [])
