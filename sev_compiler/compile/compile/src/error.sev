import "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import mir

enum CompileError:
    ConflictingCompilers(operation: int, compilers: list[model_syntax_symbol_symbol.CompilerId])
    InvalidArtifact(message: string)
    DuplicateHandler(compiler: model_syntax_symbol_symbol.CompilerId)
    MissingHandler(compiler: model_syntax_symbol_symbol.CompilerId)
    MissingValue(value: u32)
    PlannerGeneratedOperation(operation: int)
    Type(type_id: model_syntax_symbol_symbol.TypeId, message: string)

