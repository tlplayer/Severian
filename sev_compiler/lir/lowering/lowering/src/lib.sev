import MirAnalysis from "package:mir/mir/src/model.sev"
import "package:syntax/symbol/symbol.sev" as symbols
import "package:syntax/function/function.sev" as callable
import "package:mlir/mlir/src/emit/callable.sev" as emission
import "package:mlir/mlir/src/ir/model.sev" as mlir


def lower_type(type_id: symbols.TypeId, records: borrow list[callable.RecordDeclaration] = []) -> mlir.MlirType:
    return emission.callable_mlir_type(type_id, records)


def lower(module: borrow MirAnalysis, library: bool = false, export_names: list[string] = [], export_symbols: list[string] = [], selected: list[int] = [], partitioned: bool = false) -> mlir.MlirProgram:
    return emission.lower_callables(module, library, export_names, export_symbols, selected, partitioned)
