import process

class MlirBuildConfiguration:
    llvm_config: string
    include_directory: string
    library_directory: string


def configuration(llvm_config: string) -> MlirBuildConfiguration | Error:
    includes = process.execute([llvm_config, "--includedir"])
    if includes.status != 0:
        throw Error("llvm-config --includedir failed: " + includes.stderr)
    libraries = process.execute([llvm_config, "--libdir"])
    if libraries.status != 0:
        throw Error("llvm-config --libdir failed: " + libraries.stderr)
    include_directory = includes.stdout.strip()
    library_directory = libraries.stdout.strip()
    return MlirBuildConfiguration(llvm_config, include_directory, library_directory)

