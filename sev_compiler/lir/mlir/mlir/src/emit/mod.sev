import MirAnalysis from "../../../../../mir/mir/src/model.sev"
import lower_callables from "callable.sev"
import MlirProgram from "../ir/model.sev"
import print_program from "../ir/text.sev"


def lower(analysis: borrow MirAnalysis) -> MlirProgram:
    return lower_callables(analysis)


def render(analysis: borrow MirAnalysis) -> string:
    return print_program(lower(analysis))
