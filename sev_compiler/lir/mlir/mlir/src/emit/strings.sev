import MlirAffineExpression, MlirAffineExpressionKind, MlirAffineMap, MlirAttributeKind, MlirAttributeValue, MlirBlock, MlirBlockHandle, MlirBuilderError, MlirDebugVariable, MlirFunctionHandle, MlirFunctionIdentity, MlirFunctionName, MlirFunctionOp, MlirLocation, MlirNamedAttribute, MlirNamedProperty, MlirOpBuilder, MlirOperation, MlirOperationDefinition, MlirOperationName, MlirOperationState, MlirProgram, MlirRegion, MlirScalarType, MlirType, MlirTypeBinding, MlirTypeParameter, MlirTypeProvider, MlirValue, MlirVerificationError, MlirVisibility, affine_add, affine_binary, affine_ceil_divide, affine_constant, affine_dimension, affine_expression_kind_name, affine_floor_divide, affine_map_attribute, affine_modulo, affine_multiply, affine_symbol, array_attribute, array_mlir, array_type, attribute_kind_name, availability, bf16_scalar_type, bf16_type, boolean_attribute, builder_append_operation, builder_assert, builder_binary, builder_call, builder_constant, builder_create, builder_create_block, builder_create_function, builder_create_function_at, builder_create_generated_function, builder_create_operation, builder_create_operation_at, builder_create_region, builder_if, builder_new_value, builder_operation_from_state, builder_return, builder_set_insertion_point, builder_value, builder_yield, byte_view_mlir, copy_values, declared_mlir_type, dimension_identity, dimension_text, dynamic_dimension, empty_program, explicit_mlir_function_name, file_line_column, float8_type, float_attribute, float_type, generated_mlir_function_name, graph, index_mlir, index_type, integer_attribute, integer_type, is_boolean, is_float, is_integer, known_dimension, memref_mlir, memref_type, mlir_function_identity_text, mlir_identity_component, operation_definition, operation_name, operation_name_text, operation_state, pointer_type, private_visibility, program_is_valid, public_visibility, ranked_memref_storage, region_dominators, region_index, same_scalar_type, same_type, scalar_kind_name, scalar_mlir, select_mlir_function_name, string_array_attribute, string_attribute_value, struct_mlir, struct_type, symbol_attribute, tensor_mlir, tensor_type, type_attribute, type_kind_name, unranked_memref_mlir, unranked_memref_type, unranked_tensor_mlir, unranked_tensor_type, validate, validate_affine_expression, validate_attribute, validate_flat_region, validate_location, validate_operation, validate_operation_signature, validate_region, validate_type, visibility_name from "../ir/lib.sev"
import "../../../../../syntax/primitive/char/encoding.sev" as encoding


def utf8_view_type() -> MlirType:
    return memref_type(integer_type(8, false).scalar, [-1])


# Byte attributes are immutable IR values. Reuse the 256 possible descriptors
# across literals instead of boxing a type and attribute for every byte.
Utf8ByteAttributes: list[MlirAttributeValue] = []


def utf8_byte_attribute(byte: u8) -> MlirAttributeValue:
    if len(Utf8ByteAttributes) == 0:
        type_id = integer_type(8)
        for value in range(256):
            Utf8ByteAttributes.append(integer_attribute(value - 256 if value >= 128 else value, type_id))
    return Utf8ByteAttributes[int(byte)]


def string_literal(builder: MlirOpBuilder, value: string, output: MlirValue):
    element_type = output.type_id.scalar
    elements: list[MlirAttributeValue] = []
    if element_type.bits == 32:
        for character in value.characters():
            bytes = character.bytes()
            codepoint := int(bytes[0])
            if len(bytes) == 2:
                codepoint = encoding.decode_two(int(bytes[0]), int(bytes[1]))
            elif len(bytes) == 3:
                codepoint = encoding.decode_three(int(bytes[0]), int(bytes[1]), int(bytes[2]))
            elif len(bytes) == 4:
                codepoint = encoding.decode_four(int(bytes[0]), int(bytes[1]), int(bytes[2]), int(bytes[3]))
            elements.append(integer_attribute(codepoint, integer_type(32)))
    else:
        for byte in value.bytes():
            elements.append(utf8_byte_attribute(byte))
    count = int(len(elements))
    storage_type = memref_type(element_type, [count])
    tensor = tensor_type(element_type, [count])
    dense = MlirAttributeValue(DenseIntegerAttributeKind, "", 0, false, tensor, [], elements)
    constant = MlirAttributeValue(UnitAttributeKind, "", 0, false, index_type(), [])
    symbol = "__sev_string_" + string(output.id)
    attributes = [
        MlirNamedAttribute("sym_name", string_attribute_value(symbol)),
        MlirNamedAttribute("sym_visibility", string_attribute_value("private")),
        MlirNamedAttribute("type", type_attribute(storage_type)),
        MlirNamedAttribute("initial_value", dense),
        MlirNamedAttribute("constant", constant),
    ]
    global = MlirOperation(operation_name("memref", "global"), [], [], attributes, [], [], [], [], false)
    builder.program.operations.append(global)
    storage = builder_new_value(builder, storage_type)
    builder_create_operation(builder, operation_name("memref", "get_global"), [], [storage], [MlirNamedAttribute("name", symbol_attribute(symbol))])
    # This operation exposes read-only constant storage. Allocation belongs to
    # array's source implementation and the memory library, never this emitter.
    builder_create_operation(builder, operation_name("memref", "cast"), [storage], [output])
