def callable_mlir_type(id: model_syntax_symbol_symbol.TypeId, records: borrow list[model_syntax_function_function.RecordDeclaration] = []) -> MlirType:
    for record in borrow records:
        if record.type_id.index != id.index:
            continue
        fields: list[MlirType] = []
        for field in borrow record.fields:
            fields.append(callable_storage_type(callable_mlir_type(field.type_id, records)))
        binding ?= model_syntax_function_function.record_mlir_binding(record)
        if binding != None:
            parameters = record.mlir_parameters[:]
            for argument in record.mlir_arguments:
                parameters.append(MlirTypeParameter(argument[0], type_printer.type_text(callable_mlir_type(argument[1], records))))
            element: MlirScalarType | None = None
            if record.mlir_element.index != 0:
                element = callable_mlir_type(record.mlir_element, records).scalar
            return declared_mlir_type(binding, record.mlir_shape, fields, element, parameters)
        throw Error("record has no MLIR binding")
    known ?= scalar.scalar_type(id)
    if known != None:
        element ?= scalar.scalar_type(known.element)
        if element != None:
            return declared_mlir_type(known.mlir, [-1], element=callable_mlir_type(element.id, records).scalar)
        dimensions: list[int] = []
        if known.mlir.dimensions > 0:
            for index in range(known.mlir.dimensions):
                dimensions.append(-1)
        return declared_mlir_type(known.mlir, dimensions)
    throw Error("type has no declaration-owned MLIR binding")



def callable_mlir_results(id: model_syntax_symbol_symbol.TypeId, records: borrow list[model_syntax_function_function.RecordDeclaration] = []) -> list[MlirType]:
    if id.index == 2:
        return []
    results: list[MlirType] = []
    for field in storage_types.value_fields(id, records):
        results.append(callable_mlir_type(field, records))
    return results


def callable_mlir_value(module: borrow MirContext, id: model_syntax_symbol_symbol.ValueId) -> MlirValue:
    return MlirValue(int(id.index), callable_mlir_type(module.callable.values[id.index].type_id, module.analysis.records))


def callable_function_symbol(id: model_syntax_symbol_symbol.FunctionId) -> string:
    return "__sev_scalar_" + string(id.value)


def callable_operation_attributes(function: borrow model_syntax_function_function.FunctionDeclaration) -> list[MlirNamedAttribute]:
    attributes: list[MlirNamedAttribute] = []
    for decorator in borrow function.decorators:
        if decorator.name != "mlir":
            continue
        for argument in borrow decorator.arguments:
            name ?= argument.name
            if name == None or name == "" or name == "operand_segments" or name == "lowering" or name == "libraries":
                continue
            if name != None:
                match argument.value:
                    case String:
                        attribute := string_attribute_value(value)
                        if name == "callee":
                            attribute = symbol_attribute(value)
                        elif value.starts_with("#"):
                            attribute = MlirAttributeValue(DialectAttributeKind, value, 0, false, index_type(), [])
                        attributes.append(MlirNamedAttribute(name, attribute))
                    case _:
                        throw Error("MLIR operation attributes require string literals")
    return attributes


def callable_mlir_block(builder: MlirOpBuilder, module: borrow MirContext, block: borrow model_syntax_block_block.Block, location: MlirLocation | None = None):
    cursor := 0
    for operation in borrow block.operations:
        cursor += 1
        match operation:
            case DebugOwnership:
                current ?= location
                if current != None:
                    debug.debug_ownership(builder, module.analysis, name, mode, span, current.scope)
            case DebugLocation:
                current ?= location
                if current != None:
                    location = debug.debug_location(module.analysis.debug_files, span, current.scope)
            case DebugValue:
                current ?= location
                if current != None:
                    debug.debug_value(builder, module.analysis, name, callable_mlir_value(module, value), declared_type if declared_type.index != 0 else module.callable.values[value.index].type_id, span, argument, current.scope, address)
            case Coverage:
                key ?= point.key
                if key != None:
                    values: list[MlirValue] = []
                    for number in key.split(","):
                        value = builder_new_value(builder, integer_type(64))
                        builder_constant(builder, value, integer_attribute(int(number), value.type_id))
                        values.append(value)
                    if len(values) == 2:
                        condition ?= point.condition
                        if condition == None:
                            throw Error("coverage decision requires a condition value")
                        if condition != None:
                            values.append(callable_mlir_value(module, condition))
                    quality_call(builder, "__sev_quality_decision" if len(values) == 3 else "__sev_quality_hit", values)
            case TypeLayout:
                # GEP offsets are evaluated by the selected LLVM target layout.
                # {i8, T}'s second field offset is T's ABI alignment.
                measured := callable_storage_type(callable_mlir_type(subject, module.analysis.records))
                indices := [integer_attribute(1, integer_type(32))]
                if alignment:
                    measured = struct_type([integer_type(8), measured])
                    indices = [integer_attribute(0, integer_type(32)), integer_attribute(1, integer_type(32))]
                base = builder_new_value(builder, pointer_type())
                offset = builder_new_value(builder, pointer_type())
                builder_create_operation(builder, operation_name("llvm", "mlir.zero"), [], [base])
                positions = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], indices)
                builder_create_operation(builder, operation_name("llvm", "getelementptr"), [base], [offset], [MlirNamedAttribute("rawConstantIndices", positions), MlirNamedAttribute("elem_type", type_attribute(measured))])
                builder_create_operation(builder, operation_name("llvm", "ptrtoint"), [offset], [callable_mlir_value(module, result)])
            case IsVariant:
                input = callable_mlir_value(module, value)
                tag := input
                if module.callable.values[value.index].type_id.index != 64:
                    tag = builder_new_value(builder, integer_type(64))
                    positions = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(64), [], [integer_attribute(0, integer_type(64))])
                    builder_create_operation(builder, operation_name("llvm", "extractvalue"), [input], [tag], [MlirNamedAttribute("position", positions)])
                expected = builder_new_value(builder, integer_type(64))
                builder_constant(builder, expected, integer_attribute(variant, expected.type_id))
                builder_binary(builder, callable_mlir_value(module, result), operation_name("arith", "cmpi"), tag, expected, [MlirNamedAttribute("predicate", integer_attribute(0, integer_type(64)))])
            case Allocate:
                callable_allocate(builder, callable_mlir_type(type_id, module.analysis.records), callable_mlir_value(module, result))
            case Alias:
                builder_create_operation(builder, operation_name("memref", "cast"), [callable_mlir_value(module, value)], [callable_mlir_value(module, result)])
            case Load:
                output = callable_mlir_value(module, result)
                callable_load(builder, callable_mlir_value(module, address), output)
            case Store:
                callable_store(builder, callable_mlir_value(module, address), callable_mlir_value(module, value))
            case FieldAddress:
                output = callable_mlir_value(module, result)
                indices = [integer_attribute(0, integer_type(32)), integer_attribute(index, integer_type(32))]
                offsets = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], indices)
                attributes = [MlirNamedAttribute("rawConstantIndices", offsets), MlirNamedAttribute("elem_type", type_attribute(callable_mlir_type(owner, module.analysis.records)))]
                builder_create_operation(builder, operation_name("llvm", "getelementptr"), [callable_mlir_value(module, object)], [output], attributes)
            case Constant:
                output = callable_mlir_value(module, result)
                location = source.Span(0, 0, 0)
                boolean = value.read[bool](location)
                integer = value.read[int](location)
                decimal = value.read[float](location)
                text = value.read[string](location)
                character = value.read[char](location)
                if boolean is bool:
                    builder_constant(builder, output, boolean_attribute(boolean))
                elif integer is int:
                    builder_constant(builder, output, MlirAttributeValue(IntegerLiteralAttributeKind, string(integer), 0, false, output.type_id, []))
                elif decimal is float:
                    builder_constant(builder, output, MlirAttributeValue(FloatLiteralAttributeKind, string(decimal), 0, false, output.type_id, []))
                elif text is string:
                    string_literal(builder, text, output)
                elif character is char:
                    builder_constant(builder, output, integer_attribute(int(character), output.type_id))
                elif value.read[None](location) is None:
                    if type_kind_name(output.type_id.kind) == "memref":
                        size = builder_new_value(builder, index_type())
                        builder_constant(builder, size, integer_attribute(0, size.type_id))
                        sizes = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], [integer_attribute(1, integer_type(32)), integer_attribute(0, integer_type(32))])
                        builder_create_operation(builder, operation_name("memref", "alloc"), [size], [output], [MlirNamedAttribute("operandSegmentSizes", sizes)])
                    else:
                        builder_create_operation(builder, operation_name("llvm", "mlir.zero"), [], [output])
                elif value.read[absent](location) is absent:
                    builder_create_operation(builder, operation_name("llvm", "mlir.zero"), [], [output])
                else:
                    throw Error("constant requires type-owned lowering before scalar emission")
            case Unary:
                input = callable_mlir_value(module, operand)
                output = callable_mlir_value(module, result)
                selected ?= operator.scalar_operation
                if selected != None:
                    if selected.direct:
                        builder_create_operation(builder, operation_name("arith", selected.mnemonic), [input], [output])
                    else:
                        identity = builder_new_value(builder, input.type_id)
                        if scalar.scalar_representation(module.callable.values[operand.index].type_id) == "float":
                            builder_constant(builder, identity, MlirAttributeValue(FloatLiteralAttributeKind, string(selected.identity) + ".0", 0, false, input.type_id, []))
                        else:
                            builder_constant(builder, identity, integer_attribute(selected.identity, input.type_id))
                        builder_binary(builder, output, operation_name("arith", selected.mnemonic), identity, input)
                else:
                    throw Error("scalar MIR has an unregistered unary operation")
            case Binary:
                lhs = callable_mlir_value(module, left)
                rhs = callable_mlir_value(module, right)
                output = callable_mlir_value(module, result)
                selected ?= operator.scalar_operation
                numeric ?= scalar.scalar_type(module.callable.values[left.index].type_id)
                numeric_right ?= scalar.scalar_type(module.callable.values[right.index].type_id)
                handled := false
                if numeric != None:
                    if numeric_right != None:
                        if not numeric.boolean and not numeric_right.boolean:
                            handled = numeric_comparison.emit(builder, operator.symbol, lhs, rhs, output)
                if not handled:
                    if selected != None:
                        attributes: list[MlirNamedAttribute] = []
                        if selected.predicate >= 0:
                            attributes.append(MlirNamedAttribute("predicate", integer_attribute(selected.predicate, integer_type(64))))
                        builder_binary(builder, output, operation_name("arith", selected.mnemonic), lhs, rhs, attributes)
                    else:
                        throw Error("scalar MIR has an unregistered binary operation")
            case CallFields:
                inputs: list[MlirValue] = []
                returned: list[MlirValue] = []
                for argument in arguments:
                    inputs.append(callable_mlir_value(module, argument))
                for result in outputs:
                    returned.append(callable_mlir_value(module, result))
                builder_call(builder, callable_function_symbol(function), inputs, returned)
            case Call:
                inputs: list[MlirValue] = []
                for argument in arguments:
                    inputs.append(callable_mlir_value(module, argument))
                outputs: list[MlirValue] = []
                if module.callable.values[result.index].type_id.index != 2:
                    outputs.append(callable_mlir_value(module, result))
                found := false
                for callable_source in borrow callable_declarations(module.analysis):
                    if callable_source.id.value == function.value:
                        native_operation = boundary.scalar_boundary(callable_source, "mlir")
                        symbol = boundary.scalar_boundary(callable_source, "c")
                        if native_operation != "":
                            parts = native_operation.split(".")
                            attributes = callable_operation_attributes(callable_source)
                            segments = boundary.scalar_operand_segments(callable_source)
                            if len(segments) != 0:
                                sizes: list[MlirAttributeValue] = []
                                for segment in segments:
                                    sizes.append(integer_attribute(segment, integer_type(32)))
                                segment_attribute = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], sizes)
                                attributes.append(MlirNamedAttribute("operandSegmentSizes", segment_attribute))
                            if not callable_buffer_operation(builder, module, callable_source, native_operation, inputs, outputs):
                                builder_create_operation(builder, operation_name(parts[0], parts[1]), inputs, outputs, attributes)
                        elif symbol != "":
                            segments = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], [integer_attribute(int(len(inputs)), integer_type(32)), integer_attribute(0, integer_type(32))])
                            bundles = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], [])
                            builder_create_operation(builder, operation_name("llvm", "call"), inputs, outputs, [MlirNamedAttribute("callee", symbol_attribute(symbol)), MlirNamedAttribute("operandSegmentSizes", segments), MlirNamedAttribute("op_bundle_sizes", bundles)])
                        else:
                            builder_call(builder, callable_function_symbol(function), inputs, outputs)
                        found = true
                if not found:
                    throw Error("call has no resolved function declaration")
            case Assert:
                builder_assert(builder, callable_mlir_value(module, condition), "assertion failed")
            case _:
                throw Error("unsupported scalar MIR operation")
        debug.debug_annotate(builder, location)


def callable_external(builder: MlirOpBuilder, symbol: string, parameters: list[MlirValue], results: list[MlirType]) -> MlirFunctionHandle:
    index := 0
    for function in builder.program.functions:
        if function.name == symbol:
            if not function.declaration or len(function.arguments) != len(parameters) or len(function.result_types) != len(results):
                throw Error("conflicting external declaration: " + symbol)
            position := 0
            for parameter in parameters:
                if not same_type(parameter.type_id, function.arguments[position].type_id):
                    throw Error("conflicting external parameter: " + symbol)
                position += 1
            position = 0
            for result in results:
                if not same_type(result, function.result_types[position]):
                    throw Error("conflicting external result: " + symbol)
                position += 1
            return MlirFunctionHandle(index, MlirFunctionName(symbol), MlirBlockHandle(-1, -1), function.arguments, true)
        index += 1
    # Share the LLVM declaration with memref's allocation/deallocation lowering.
    # A func.func declaration of free would otherwise be renamed to free_0 when
    # the buffer pipeline inserts llvm.func @free, leaving an unresolved symbol.
    handle = builder_create_function(builder, symbol, private_visibility(), parameters, results, true)
    program := builder.program
    function := program.functions[handle.function]
    function.native = true
    program.functions[handle.function] = function
    builder.program = program
    return handle


def validate_external_contracts(module: borrow MirAnalysis):
    # Check declarations even when they have no live calls. Validation must
    # not make an otherwise unused provider an emitted dependency.
    declarations: list[model_syntax_function_function.FunctionDeclaration] = []
    for function in borrow callable_declarations(module):
        symbol = boundary.scalar_boundary(function, "c")
        if symbol == "":
            continue
        for previous in borrow declarations:
            if boundary.scalar_boundary(previous, "c") != symbol:
                continue
            if len(previous.parameter_types) != len(function.parameter_types):
                throw Error("conflicting external declaration: " + symbol)
            index := 0
            for parameter in function.parameter_types:
                if not same_type(callable_mlir_type(parameter, module.records), callable_mlir_type(previous.parameter_types[index], module.records)):
                    throw Error("conflicting external parameter: " + symbol)
                index += 1
            results = callable_mlir_results(function.result_type, module.records)
            expected = callable_mlir_results(previous.result_type, module.records)
            if len(results) != len(expected):
                throw Error("conflicting external declaration: " + symbol)
            index = 0
            for result in results:
                if not same_type(result, expected[index]):
                    throw Error("conflicting external result: " + symbol)
                index += 1
        declarations.append(function)


def lower_callables(analysis: borrow MirAnalysis, library: bool = false, export_names: list[string] = [], export_symbols: list[string] = [], selected: list[int] = [], partitioned: bool = false) -> MlirProgram:
    if len(export_names) != len(export_symbols):
        throw Error("export names and symbols must have the same length")
    # Realization ValueIds are local to functions. Reserve their range before
    # generating temporaries so a generated value cannot shadow a MIR value.
    value_count := 0
    for realization in analysis.callables:
        if realization.key in analysis.selected:
            value_count = max(value_count, int(len(realization.values)))
    builder = MlirOpBuilder(value_count)
    contexts: list[MirContext] = []
    handles: list[MlirFunctionHandle] = []
    validate_external_contracts(analysis)
    for realization in analysis.callables:
        if realization.key not in analysis.selected:
            continue
        module = MirContext(analysis, realization)
        require_registered(module)
        function = realization.declaration
        if boundary.scalar_boundary(function, "mlir") != "":
            continue
        contexts.append(module)
        parameters: list[MlirValue] = []
        for value in function.values:
            parameters.append(callable_mlir_value(module, value))
        results = callable_mlir_results(function.result_type, analysis.records)
        symbol = boundary.scalar_boundary(function, "c")
        if symbol != "":
            handles.append(callable_external(builder, symbol, parameters, results))
        elif partitioned and int(function.id.value) not in selected:
            handles.append(callable_external(builder, callable_function_symbol(function.id), parameters, results))
        else:
            realization.require_ready()
            handles.append(builder_create_function_at(builder, callable_function_symbol(function.id), public_visibility() if partitioned else private_visibility(), parameters, results, false, debug.debug_function(analysis, function)))
    for index in range(len(contexts)):
        module = contexts[index]
        handle = handles[index]
        if handle.declaration:
            continue
        body ?= module.callable.body
        if body == None:
            throw Error("defined callable has no verified CFG")
        if body != None:
            module.callable.require_ready()
            callable_cfg(builder, module, body, handle.entry, builder.program.functions[handle.function].location)
    if library:
        for export_index in range(len(export_names)):
            matches = [realization for realization in analysis.callables if realization.key in analysis.selected and realization.declaration.name == export_names[export_index]]
            if len(matches) != 1:
                throw Error("export must identify exactly one selected callable: " + export_names[export_index])
            function = matches[0].declaration
            parameters: list[MlirValue] = []
            for type_id in function.parameter_types:
                parameters.append(builder_new_value(builder, callable_mlir_type(type_id, analysis.records)))
            results = callable_mlir_results(function.result_type, analysis.records)
            wrapper = builder_create_function(builder, export_symbols[export_index], public_visibility(), parameters, results)
            builder_set_insertion_point(builder, wrapper.entry)
            values: list[MlirValue] = []
            for result in results:
                values.append(builder_new_value(builder, result))
            symbol = boundary.scalar_boundary(function, "c")
            if boundary.scalar_boundary(function, "mlir") != "":
                throw Error("an intrinsic requires an ordinary callable wrapper for export")
            builder_call(builder, symbol if symbol != "" else callable_function_symbol(function.id), parameters, values)
            builder_return(builder, values)
        validate(builder.program)
        return builder.program
    entry = builder_create_function(builder, "main", public_visibility(), [], [integer_type(32)])
    builder_set_insertion_point(builder, entry.entry)
    for initializer in analysis.initializers:
        function = selected_entry(analysis, initializer)
        if function.result_type.index != 2:
            throw Error("initializer must return unit")
        builder_call(builder, callable_function_symbol(initializer), [], [])
    for test in analysis.tests:
        function ?= test.function
        if function != None:
            declaration = selected_entry(analysis, function)
            if declaration.result_type.index != 2:
                throw Error("test callable must return unit")
            if len(analysis.quality.files) > 0:
                test_id = builder_new_value(builder, integer_type(64))
                builder_constant(builder, test_id, integer_attribute(int(function.value), test_id.type_id))
                quality_call(builder, "__sev_quality_test_begin", [test_id])
            builder_call(builder, callable_function_symbol(function), [], [])
            if len(analysis.quality.files) > 0:
                test_id = builder_new_value(builder, integer_type(64))
                builder_constant(builder, test_id, integer_attribute(int(function.value), test_id.type_id))
                quality_call(builder, "__sev_quality_test_end", [test_id])
    outputs: list[MlirValue] = []
    main ?= analysis.entry
    if main != None:
        function = selected_entry(analysis, main)
        if function.result_type.index != 2:
            result = callable_mlir_type(function.result_type, analysis.records)
            if not same_type(result, integer_type(32)):
                throw Error("executable entry must return unit or i32")
            outputs.append(builder_new_value(builder, result))
        builder_call(builder, callable_function_symbol(main), [], outputs)
    if len(outputs) == 0:
        status = builder_new_value(builder, integer_type(32))
        builder_constant(builder, status, integer_attribute(0, status.type_id))
        outputs.append(status)
    builder_return(builder, outputs)
    validate(builder.program)
    return builder.program


def selected_entry(analysis: borrow MirAnalysis, identity: model_syntax_symbol_symbol.FunctionId) -> model_syntax_function_function.FunctionDeclaration:
    context = callable_context(analysis, identity)
    if context.callable.key not in analysis.selected:
        throw Error("execution entry was not selected during MIR reachability")
    context.callable.require_ready()
    function = context.callable.declaration
    if len(function.parameter_types) != 0:
        throw Error("execution entry requires an argument adapter")
    return function


def quality_call(builder: MlirOpBuilder, symbol: string, values: list[MlirValue]):
    parameters: list[MlirValue] = []
    for value in values:
        parameters.append(builder_new_value(builder, value.type_id))
    callable_external(builder, symbol, parameters, [])
    segments = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], [integer_attribute(int(len(values)), integer_type(32)), integer_attribute(0, integer_type(32))])
    bundles = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], [])
    builder_create_operation(builder, operation_name("llvm", "call"), values, [], [MlirNamedAttribute("callee", symbol_attribute(symbol)), MlirNamedAttribute("operandSegmentSizes", segments), MlirNamedAttribute("op_bundle_sizes", bundles)])


def callable_storage_type(value: MlirType) -> MlirType:
    binding ?= value.kind.storage
    if binding == None:
        return value
    if binding != None:
        return declared_mlir_type(binding, value.dimensions, value.elements, parameters=value.parameters)
    return value


def callable_allocate(builder: MlirOpBuilder, value_type: MlirType, address: MlirValue):
    count = builder_new_value(builder, integer_type(64))
    builder_constant(builder, count, integer_attribute(1, count.type_id))
    builder_create_operation(builder, operation_name("llvm", "alloca"), [count], [address], [MlirNamedAttribute("elem_type", type_attribute(callable_storage_type(value_type)))])


def callable_store(builder: MlirOpBuilder, address: MlirValue, value: MlirValue):
    stored := value
    storage = callable_storage_type(value.type_id)
    if not same_type(storage, value.type_id):
        stored = builder_new_value(builder, storage)
        builder_create_operation(builder, operation_name("builtin", "unrealized_conversion_cast"), [value], [stored])
    builder_create_operation(builder, operation_name("llvm", "store"), [stored, address])


def callable_load(builder: MlirOpBuilder, address: MlirValue, output: MlirValue):
    storage = callable_storage_type(output.type_id)
    loaded := output
    if not same_type(storage, output.type_id):
        loaded = builder_new_value(builder, storage)
    builder_create_operation(builder, operation_name("llvm", "load"), [address], [loaded])
    if loaded.id != output.id:
        builder_create_operation(builder, operation_name("builtin", "unrealized_conversion_cast"), [loaded], [output])



def callable_cfg(builder: MlirOpBuilder, module: borrow MirContext, body: borrow model_mir_cfg_cfg.CfgBody, entry: MlirBlockHandle, location: MlirLocation | None = None):
    handles = [entry]
    for block in body.blocks[1:]:
        parameters: list[MlirValue] = []
        for parameter in block.parameters:
            parameters.append(callable_mlir_value(module, parameter))
        handles.append(builder_create_block(builder, entry.region, parameters))
    for block in borrow body.blocks:
        builder_set_insertion_point(builder, handles[block.cfg_index])
        callable_mlir_block(builder, module, block, location)
        terminal ?= block.terminator
        if terminal != None:
            match terminal.exit:
                case Jump:
                    inputs: list[MlirValue] = []
                    for argument in edge.arguments:
                        inputs.append(callable_mlir_value(module, argument))
                    state = operation_state(operation_definition("cf", "br", true), operands=inputs, successors=[handles[edge.target].block])
                    builder_create(builder, state)
                case Conditional:
                    inputs = [callable_mlir_value(module, condition)]
                    for argument in taken.arguments:
                        inputs.append(callable_mlir_value(module, argument))
                    for argument in otherwise.arguments:
                        inputs.append(callable_mlir_value(module, argument))
                    sizes = [integer_attribute(1, integer_type(32)), integer_attribute(int(len(taken.arguments)), integer_type(32)), integer_attribute(int(len(otherwise.arguments)), integer_type(32))]
                    segments = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], sizes)
                    state = operation_state(operation_definition("cf", "cond_br", true), operands=inputs, attributes=[MlirNamedAttribute("operandSegmentSizes", segments)], successors=[handles[taken.target].block, handles[otherwise.target].block])
                    builder_create(builder, state)
                case Raise:
                    if body.return_type.index == module.callable.values[value.index].type_id.index:
                        builder_return(builder, [callable_mlir_value(module, value)])
                    else:
                        failed = builder_new_value(builder, integer_type(1))
                        builder_constant(builder, failed, boolean_attribute(false))
                        builder_assert(builder, failed, "unhandled typed error")
                        callable_unreachable(builder, module, body)
                case FinishFields:
                    outputs: list[MlirValue] = []
                    for value in values:
                        outputs.append(callable_mlir_value(module, value))
                    builder_return(builder, outputs)
                case Finish:
                    outputs: list[MlirValue] = []
                    returned ?= value
                    if returned != None:
                        outputs.append(callable_mlir_value(module, returned))
                    builder_return(builder, outputs)
                case Dead:
                    callable_unreachable(builder, module, body)
            current ?= location
            if current != None:
                debug.debug_annotate(builder, debug.debug_location(module.analysis.debug_files, terminal.span, current.scope))


# Preserve FunctionOpInterface exits until ownership has run. The assertion
# prevents execution of the placeholder result; LLVM conversion happens later.
def callable_unreachable(builder: MlirOpBuilder, module: borrow MirContext, body: borrow model_mir_cfg_cfg.CfgBody):
    failed = builder_new_value(builder, integer_type(1))
    builder_constant(builder, failed, boolean_attribute(false))
    builder_assert(builder, failed, "unreachable control flow")
    values: list[MlirValue] = []
    for type_id in callable_mlir_results(body.return_type, module.analysis.records):
        value = builder_new_value(builder, type_id)
        builder_create_operation(builder, operation_name("ub", "poison"), [], [value])
        values.append(value)
    builder_return(builder, values)


# Rank-one buffers of copyable aggregate values use byte storage. LLVM computes
# the ABI stride, including padding; ownership remains visible as a memref.
def callable_buffer_stride(builder: MlirOpBuilder, element: MlirType) -> MlirValue:
    base = builder_new_value(builder, pointer_type())
    builder_create_operation(builder, operation_name("llvm", "mlir.zero"), [], [base])
    end = builder_new_value(builder, pointer_type())
    offsets = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], [integer_attribute(1, integer_type(32))])
    builder_create_operation(builder, operation_name("llvm", "getelementptr"), [base], [end], [MlirNamedAttribute("rawConstantIndices", offsets), MlirNamedAttribute("elem_type", type_attribute(element))])
    bytes = builder_new_value(builder, integer_type(64))
    builder_create_operation(builder, operation_name("llvm", "ptrtoint"), [end], [bytes])
    one = builder_new_value(builder, integer_type(64))
    builder_constant(builder, one, integer_attribute(1, one.type_id))
    nonzero = builder_new_value(builder, integer_type(64))
    builder_binary(builder, nonzero, operation_name("arith", "maxui"), bytes, one)
    stride = builder_new_value(builder, index_type())
    builder_create_operation(builder, operation_name("arith", "index_cast"), [nonzero], [stride])
    return stride


def callable_buffer_address(builder: MlirOpBuilder, buffer: MlirValue, position: MlirValue, stride: MlirValue) -> MlirValue:
    base = builder_new_value(builder, index_type())
    builder_create_operation(builder, operation_name("memref", "extract_aligned_pointer_as_index"), [buffer], [base])
    offset = builder_new_value(builder, index_type())
    builder_binary(builder, offset, operation_name("arith", "muli"), position, stride)
    address = builder_new_value(builder, index_type())
    builder_binary(builder, address, operation_name("arith", "addi"), base, offset)
    integer = builder_new_value(builder, integer_type(64))
    builder_create_operation(builder, operation_name("arith", "index_cast"), [address], [integer])
    pointer = builder_new_value(builder, pointer_type())
    builder_create_operation(builder, operation_name("llvm", "inttoptr"), [integer], [pointer])
    return pointer


def callable_buffer_operation(builder: MlirOpBuilder, module: borrow MirContext, function: borrow model_syntax_function_function.FunctionDeclaration, operation: string, inputs: list[MlirValue], outputs: list[MlirValue]) -> bool:
    if operation not in ["memref.alloc", "memref.load", "memref.store", "memref.dim"]:
        return false
    buffer_type := function.result_type
    if operation == "memref.load" or operation == "memref.dim":
        buffer_type = function.parameter_types[0]
    elif operation == "memref.store":
        buffer_type = function.parameter_types[1]
    for record in borrow module.analysis.records:
        if record.type_id.index != buffer_type.index or record.storage_element.index == 0:
            continue
        element = callable_mlir_type(record.storage_element, module.analysis.records)
        stride = callable_buffer_stride(builder, element)
        if operation == "memref.alloc":
            bytes = builder_new_value(builder, index_type())
            builder_binary(builder, bytes, operation_name("arith", "muli"), inputs[0], stride)
            restored = builder_new_value(builder, index_type())
            builder_binary(builder, restored, operation_name("arith", "divui"), bytes, stride)
            valid = builder_new_value(builder, integer_type(1))
            builder_binary(builder, valid, operation_name("arith", "cmpi"), restored, inputs[0], [MlirNamedAttribute("predicate", integer_attribute(0, integer_type(64)))])
            builder_assert(builder, valid, "buffer allocation size overflow")
            segments = MlirAttributeValue(DenseIntegerArrayAttributeKind, "", 0, false, integer_type(32), [], [integer_attribute(1, integer_type(32)), integer_attribute(0, integer_type(32))])
            builder_create_operation(builder, operation_name("memref", "alloc"), [bytes], outputs, [MlirNamedAttribute("operandSegmentSizes", segments)])
        elif operation == "memref.dim":
            bytes = builder_new_value(builder, index_type())
            builder_create_operation(builder, operation_name("memref", "dim"), inputs, [bytes])
            builder_binary(builder, outputs[0], operation_name("arith", "divui"), bytes, stride)
        elif operation == "memref.load":
            address = callable_buffer_address(builder, inputs[0], inputs[1], stride)
            builder_create_operation(builder, operation_name("llvm", "load"), [address], outputs)
        else:
            address = callable_buffer_address(builder, inputs[1], inputs[2], stride)
            builder_create_operation(builder, operation_name("llvm", "store"), [inputs[0], address])
        return true
    return false
