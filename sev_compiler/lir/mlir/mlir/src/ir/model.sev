import * from "package:primitives/mlir.sev"
class MlirScalarType:
    kind: string
    bits: u16
    signed: bool
    address_space: int
    spelling: string = ""


def known_dimension(value: int) -> int:
    assert(value >= 0, "known MLIR dimensions cannot be negative")
    return value


def dynamic_dimension() -> int:
    return -1


class MlirType:
    kind: MlirTypeBinding
    scalar: MlirScalarType
    dimensions: list[int]
    elements: list[MlirType] = []
    parameters: list[MlirTypeParameter] = []


def integer_type(bits: u16, signed: bool = true) -> MlirType:
    return MlirType(scalar_mlir("i" + string(bits), "integer", bits, signed), MlirScalarType("integer", bits, signed, 0, "i" + string(bits)), [])


def float_type(bits: u16) -> MlirType:
    return MlirType(scalar_mlir("f" + string(bits), "ieee_float", bits, true), MlirScalarType("ieee_float", bits, true, 0, "f" + string(bits)), [])


def float8_type(e5m2: bool) -> MlirType:
    return MlirType(scalar_mlir("f8E5M2" if e5m2 else "f8E4M3FN", "f8e5m2" if e5m2 else "f8e4m3fn", 8, true), MlirScalarType("f8e5m2" if e5m2 else "f8e4m3fn", 8, true, 0, "f8E5M2" if e5m2 else "f8E4M3FN"), [])


def bf16_type() -> MlirType:
    return MlirType(scalar_mlir("bf16", "brain_float", 16, true), bf16_scalar_type(), [])


def bf16_scalar_type() -> MlirScalarType:
    return MlirScalarType("brain_float", 16, true, 0, "bf16")


def index_type() -> MlirType:
    return MlirType(index_mlir(), MlirScalarType("index", 0, false, 0, "index"), [])


def pointer_type(address_space: int = 0) -> MlirType:
    return MlirType(scalar_mlir("!llvm.ptr" if address_space == 0 else "!llvm.ptr<" + string(address_space) + ">", "pointer"), MlirScalarType("pointer", 0, false, address_space, "!llvm.ptr" if address_space == 0 else "!llvm.ptr<" + string(address_space) + ">"), [])


def tensor_type(element: MlirScalarType, dimensions: list[int]) -> MlirType:
    return MlirType(tensor_mlir(), element, dimensions)


def unranked_tensor_type(element: MlirScalarType) -> MlirType:
    return MlirType(unranked_tensor_mlir(), element, [])


def memref_type(element: MlirScalarType, dimensions: list[int]) -> MlirType:
    return MlirType(memref_mlir(), element, dimensions)


def unranked_memref_type(element: MlirScalarType) -> MlirType:
    return MlirType(unranked_memref_mlir(), element, [])


class MlirLocation:
    file: string
    line: u32
    column: u32
    scope: string = ""


def file_line_column(file: string, line: u32, column: u32) -> MlirLocation:
    assert(file != "", "an MLIR source location requires a file")
    assert(line > 0 and column > 0, "MLIR source locations are one-based")
    return MlirLocation(file, line, column)


class MlirValue:
    id: int
    type_id: MlirType


# MLIR operation identity is intentionally open. Adding a dialect operation is
# data supplied to the builder, never a new compiler enum variant.
class MlirOperationName:
    dialect: string
    mnemonic: string

    def text() -> string:
        return dialect + "." + mnemonic


def operation_name(dialect: string, mnemonic: string) -> MlirOperationName:
    return MlirOperationName(dialect, mnemonic)


def operation_name_text(name: MlirOperationName) -> string:
    return name.dialect + "." + name.mnemonic


enum MlirAttributeKind:
    DialectAttributeKind
    DebugAttributeKind
    UnitAttributeKind
    DenseIntegerAttributeKind
    DenseIntegerArrayAttributeKind
    IntegerAttributeKind
    IntegerLiteralAttributeKind
    FloatAttributeKind
    FloatLiteralAttributeKind
    StringAttributeKind
    BooleanAttributeKind
    TypeAttributeKind
    StringArrayAttributeKind
    ArrayAttributeKind
    SymbolAttributeKind
    AffineMapAttributeKind


enum MlirAffineExpressionKind:
    AffineDimension
    AffineSymbol
    AffineConstant
    AffineAdd
    AffineMultiply
    AffineModulo
    AffineFloorDivide
    AffineCeilDivide


def affine_expression_kind_name(kind: MlirAffineExpressionKind) -> string:
    match kind:
        case AffineDimension:
            return "dimension"
        case AffineSymbol:
            return "symbol"
        case AffineConstant:
            return "constant"
        case AffineAdd:
            return "add"
        case AffineMultiply:
            return "multiply"
        case AffineModulo:
            return "modulo"
        case AffineFloorDivide:
            return "floor_divide"
        case AffineCeilDivide:
            return "ceil_divide"


class MlirAffineExpression:
    kind: MlirAffineExpressionKind
    position: int = 0
    constant: int = 0
    operands: list[MlirAffineExpression] = []


def affine_dimension(position: int) -> MlirAffineExpression:
    return MlirAffineExpression(AffineDimension, position, 0, [])


def affine_symbol(position: int) -> MlirAffineExpression:
    return MlirAffineExpression(AffineSymbol, position, 0, [])


def affine_constant(value: int) -> MlirAffineExpression:
    return MlirAffineExpression(AffineConstant, 0, value, [])


def affine_binary(kind: MlirAffineExpressionKind, left: MlirAffineExpression, right: MlirAffineExpression) -> MlirAffineExpression:
    return MlirAffineExpression(kind, 0, 0, [left, right])


def affine_add(left: MlirAffineExpression, right: MlirAffineExpression) -> MlirAffineExpression:
    return affine_binary(AffineAdd, left, right)


def affine_multiply(left: MlirAffineExpression, right: MlirAffineExpression) -> MlirAffineExpression:
    return affine_binary(AffineMultiply, left, right)


def affine_modulo(left: MlirAffineExpression, right: MlirAffineExpression) -> MlirAffineExpression:
    return affine_binary(AffineModulo, left, right)


def affine_floor_divide(left: MlirAffineExpression, right: MlirAffineExpression) -> MlirAffineExpression:
    return affine_binary(AffineFloorDivide, left, right)


def affine_ceil_divide(left: MlirAffineExpression, right: MlirAffineExpression) -> MlirAffineExpression:
    return affine_binary(AffineCeilDivide, left, right)


class MlirAffineMap:
    dimensions: int
    symbols: int
    results: list[MlirAffineExpression]


class MlirAttributeValue:
    kind: MlirAttributeKind
    text: string
    integer: int
    enabled: bool
    type_id: MlirType
    strings: list[string]
    elements: list[MlirAttributeValue] = []
    symbol: string = ""
    affine_maps: list[MlirAffineMap] = []
    floating: f64 = 0.0


def integer_attribute(value: int, type_id: MlirType) -> MlirAttributeValue:
    return MlirAttributeValue(IntegerAttributeKind, "", value, false, type_id, [], [], "", [], 0.0)


def float_attribute(value: f64, type_id: MlirType) -> MlirAttributeValue:
    return MlirAttributeValue(FloatAttributeKind, "", 0, false, type_id, [], [], "", [], value)


def string_attribute_value(value: string) -> MlirAttributeValue:
    return MlirAttributeValue(StringAttributeKind, value, 0, false, index_type(), [], [], "", [], 0.0)


def boolean_attribute(value: bool) -> MlirAttributeValue:
    return MlirAttributeValue(BooleanAttributeKind, "", 0, value, index_type(), [], [], "", [], 0.0)


def type_attribute(type_id: MlirType) -> MlirAttributeValue:
    return MlirAttributeValue(TypeAttributeKind, "", 0, false, type_id, [], [], "", [], 0.0)


def string_array_attribute(values: list[string]) -> MlirAttributeValue:
    return MlirAttributeValue(StringArrayAttributeKind, "", 0, false, index_type(), values, [], "", [], 0.0)


def array_attribute(values: list[MlirAttributeValue]) -> MlirAttributeValue:
    return MlirAttributeValue(ArrayAttributeKind, "", 0, false, index_type(), [], values, "", [], 0.0)


def symbol_attribute(value: string) -> MlirAttributeValue:
    assert(value != "", "an MLIR symbol reference cannot be empty")
    return MlirAttributeValue(SymbolAttributeKind, "", 0, false, index_type(), [], [], value, [], 0.0)


def affine_map_attribute(value: MlirAffineMap) -> MlirAttributeValue:
    return MlirAttributeValue(AffineMapAttributeKind, "", 0, false, index_type(), [], [], "", [value], 0.0)


def attribute_kind_name(kind: MlirAttributeKind) -> string:
    match kind:
        case DialectAttributeKind:
            return "dialect"
        case DebugAttributeKind:
            return "debug"
        case UnitAttributeKind:
            return "unit"
        case DenseIntegerAttributeKind:
            return "dense_integer"
        case DenseIntegerArrayAttributeKind:
            return "dense_integer_array"
        case IntegerAttributeKind:
            return "integer"
        case IntegerLiteralAttributeKind:
            return "integer_literal"
        case FloatAttributeKind:
            return "float"
        case FloatLiteralAttributeKind:
            return "float_literal"
        case StringAttributeKind:
            return "string"
        case BooleanAttributeKind:
            return "boolean"
        case TypeAttributeKind:
            return "type"
        case StringArrayAttributeKind:
            return "string_array"
        case ArrayAttributeKind:
            return "array"
        case SymbolAttributeKind:
            return "symbol"
        case AffineMapAttributeKind:
            return "affine_map"


class MlirNamedAttribute:
    name: string
    value: MlirAttributeValue


# Properties are deliberately distinct from discardable attributes. `A` is
# Severian's Argument category, so this API spells Attribute and Property out.
class MlirNamedProperty:
    name: string
    value: MlirAttributeValue


class MlirOperationDefinition:
    # An operation definition is open data. Dialect libraries create these;
    # neither the compiler nor the builder owns an operation-name registry.
    name: MlirOperationName
    terminator: bool = false


def operation_definition(dialect: string, mnemonic: string, terminator: bool = false) -> MlirOperationDefinition:
    return MlirOperationDefinition(operation_name(dialect, mnemonic), terminator)


# This is the universal source-owned construction boundary. It mirrors MLIR's
# OperationState while retaining expected result types so the source object
# graph remains typed even when native MLIR performs result inference.
class MlirOperationState:
    definition: MlirOperationDefinition
    operands: list[MlirValue] = []
    result_types: list[MlirType] = []
    attributes: list[MlirNamedAttribute] = []
    properties: list[MlirNamedProperty] = []
    successors: list[int] = []
    regions: list[int] = []
    region_requires_terminator: list[bool] = []
    location: MlirLocation | None = None
    infer_results: bool = false


def operation_state(
    definition: MlirOperationDefinition,
    operands: list[MlirValue] = [],
    result_types: list[MlirType] = [],
    attributes: list[MlirNamedAttribute] = [],
    properties: list[MlirNamedProperty] = [],
    successors: list[int] = [],
    regions: list[int] = [],
    region_requires_terminator: list[bool] = [],
    location: MlirLocation | None = None,
    infer_results: bool = false,
) -> MlirOperationState:
    return MlirOperationState(definition, operands, result_types, attributes, properties, successors, regions, region_requires_terminator, location, infer_results)


class MlirOperation:
    name: MlirOperationName
    operands: list[MlirValue]
    results: list[MlirValue]
    attributes: list[MlirNamedAttribute]
    properties: list[MlirNamedProperty]
    successors: list[int]
    regions: list[int]
    region_requires_terminator: list[bool]
    terminator: bool
    location: MlirLocation | None = None
    infer_results: bool = false


class MlirBlock:
    id: int
    arguments: list[MlirValue]
    operations: list[MlirOperation]


class MlirRegion:
    id: int
    blocks: list[MlirBlock]


enum MlirVisibility:
    PublicVisibility
    PrivateVisibility


def public_visibility() -> MlirVisibility:
    return PublicVisibility


def private_visibility() -> MlirVisibility:
    return PrivateVisibility


class MlirFunctionOp:
    name: string
    visibility: MlirVisibility
    arguments: list[MlirValue]
    result_types: list[MlirType]
    body_region: int
    declaration: bool
    location: MlirLocation | None = None
    native: bool = false


class MlirFunctionName:
    value: string


def explicit_mlir_function_name(value: string) -> MlirFunctionName:
    assert(value != "", "an explicit MLIR function name cannot be empty")
    return MlirFunctionName(value)


class MlirFunctionIdentity:
    package: string
    module: string
    callable: string
    specialization: list[string]
    ordinal: int = 0


def mlir_identity_component(value: string) -> string:
    # Length prefixes make the identity unambiguous even when a source name
    # contains the separator used between components.
    return string(len(value)) + ":" + value


def mlir_function_identity_text(identity: MlirFunctionIdentity) -> string:
    encoded := mlir_identity_component(identity.package)
    encoded += "|" + mlir_identity_component(identity.module)
    encoded += "|" + mlir_identity_component(identity.callable)
    encoded += "|" + string(identity.ordinal)
    for argument in identity.specialization:
        encoded += "|" + mlir_identity_component(argument)
    return encoded


def generated_mlir_function_name(identity: MlirFunctionIdentity) -> MlirFunctionName:
    # The naming policy lives in Severian. The compiler carries the resulting
    # symbol as ordinary Y/F identity and never searches for this prefix.
    return MlirFunctionName("__sev_mlir|" + mlir_function_identity_text(identity))


def select_mlir_function_name(identity: MlirFunctionIdentity, mlir_function_name: MlirFunctionName | None = None) -> MlirFunctionName:
    selected ?= mlir_function_name
    if selected != None:
        assert(selected.value != "", "an explicit MLIR function name cannot be empty")
        return selected
    return generated_mlir_function_name(identity)


class MlirProgram:
    functions: list[MlirFunctionOp]
    regions: list[MlirRegion]
    next_value: int
    next_region: int
    next_block: int
    operations: list[MlirOperation] = []
    attributes: list[MlirNamedAttribute] = []


def empty_program(first_generated_value: int = 0) -> MlirProgram:
    return MlirProgram([], [], first_generated_value, 0, 0)


def scalar_kind_name(kind: string) -> string:
    return kind



def type_kind_name(kind: MlirTypeBinding) -> string:
    return kind.category



def dimension_text(dimension: int) -> string:
    if dimension < 0:
        return "?"
    return string(dimension)


def visibility_name(visibility: MlirVisibility) -> string:
    match visibility:
        case PublicVisibility:
            return "public"
        case PrivateVisibility:
            return "private"


def same_scalar_type(left: MlirScalarType, right: MlirScalarType) -> bool:
    return scalar_kind_name(left.kind) == scalar_kind_name(right.kind) and left.bits == right.bits and left.signed == right.signed and left.address_space == right.address_space


def dimension_identity(dimension: int) -> string:
    if dimension < 0:
        return "dynamic"
    return "known:" + string(dimension)


def same_type(left: MlirType, right: MlirType) -> bool:
    if left.kind.spelling != right.kind.spelling or type_kind_name(left.kind) != type_kind_name(right.kind):
        return false
    if len(left.parameters) != len(right.parameters):
        return false
    for parameter in left.parameters:
        found := false
        for other in right.parameters:
            if parameter.name == other.name and parameter.value == other.value:
                found = true
        if not found:
            return false
    if len(left.elements) != len(right.elements):
        return false
    element := 0
    for member in left.elements:
        if not same_type(member, right.elements[element]):
            return false
        element += 1
    if not same_scalar_type(left.scalar, right.scalar):
        return false
    if len(left.dimensions) != len(right.dimensions):
        return false
    index := 0
    while index < int(len(left.dimensions)):
        if dimension_identity(left.dimensions[index]) != dimension_identity(right.dimensions[index]):
            return false
        index += 1
    return true


def is_integer(type_id: MlirType) -> bool:
    return type_kind_name(type_id.kind) == "scalar" and scalar_kind_name(type_id.scalar.kind) == "integer"


def is_float(type_id: MlirType) -> bool:
    if type_kind_name(type_id.kind) != "scalar":
        return false
    kind = scalar_kind_name(type_id.scalar.kind)
    return kind in ["ieee_float", "brain_float", "f8e4m3fn", "f8e5m2"]


def is_boolean(type_id: MlirType) -> bool:
    return is_integer(type_id) and type_id.scalar.bits == 1


def struct_type(elements: list[MlirType]) -> MlirType:
    return MlirType(struct_mlir(), MlirScalarType("integer", 8, false, 0), [], elements)


def array_type(size: int, element: MlirType) -> MlirType:
    return MlirType(array_mlir(), MlirScalarType("integer", 8, false, 0), [size], [element])

# Reassignments and ownership transitions retain one debugger variable identity.
class MlirDebugVariable:
    scope: string
    name: string
    attribute: string


def declared_mlir_type(binding: MlirTypeBinding, dimensions: list[int] = [], elements: list[MlirType] = [], element: MlirScalarType | None = None, parameters: list[MlirTypeParameter] = []) -> MlirType:
    if not binding.value:
        throw Error("declaration has no MLIR SSA value")
    scalar = MlirScalarType(binding.scalar, binding.bits, binding.signed, 0, binding.spelling)
    supplied ?= element
    if supplied != None:
        scalar = supplied
    return MlirType(binding, scalar, dimensions, elements, parameters)
