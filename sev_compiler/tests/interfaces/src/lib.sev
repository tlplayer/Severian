import universal
import source
import lexer
import * from "package:interface/src/semantic_payload.sev" as payload
import * from "package:semantic/src/callable.sev" as semantic


def generic_module() -> universal.Module:
    span = source.Span(source.SourceId(0), 0, 1)
    parameter = universal.FunctionParameter("value", universal.named_type("T", [], span), None, span)
    body = universal.Block([universal.Return(universal.Expression(universal.Name("value"), span), span)])
    function = universal.FunctionDeclaration(name="identity", type_parameters=["T"], parameters=[parameter], result=universal.named_type("T", [], span), body=body, span=span)
    function.semantic_key = universal.callable_key(function, "package:identity")
    function.definition = universal.definition_from_key(function.semantic_key)
    return universal.Module([universal.Function(function)])


test "generic interfaces specialize decoded bodies without producer files":
    original = generic_module()
    files = [source.virtual_source("producer.sev", "x")]
    encoded = payload.encode(original, lexer.SyntaxRegistry([]), files, ["identity"])
    consumer = [source.virtual_source("consumer.sev", "y")]
    decoded = payload.decode(encoded, "library.sevi", consumer)
    imported = payload.imported(decoded, "library.")
    match imported.items[0]:
        case Function:
            assert(declaration.name == "library.identity")
            assert(declaration.type_parameters == ["T"])
            span ?= declaration.span
            assert(span != None)
            if span != None:
                assert(span.source.index == 1)
            state = semantic.CallableAnalysis(generics=[declaration])
            instantiated = semantic.callable_specialize_generic(state, declaration, [universal.TypeId(64)])
            assert(instantiated.parameter_types[0].index == 64)
            assert(instantiated.result_type.index == 64)
            assert(instantiated.body != None)
        case _:
            assert(false)


test "semantic interface rejects trailing data and incompatible schemas":
    encoded = payload.encode(generic_module(), lexer.SyntaxRegistry([]), [source.virtual_source("producer.sev", "x")], ["identity"])
    rejected := false
    try:
        payload.decode(encoded + "\nextra", "library.sevi", [])
    catch failure: Error:
        rejected = true
    assert(rejected)
    rejected = false
    try:
        payload.decode("unsupported\nschema", "library.sevi", [])
    catch failure: Error:
        rejected = true
    assert(rejected)


test "semantic interface rejects missing exported declarations":
    rejected := false
    try:
        payload.encode(generic_module(), lexer.SyntaxRegistry([]), [source.virtual_source("producer.sev", "x")], ["missing"])
    catch failure: Error:
        rejected = true
    assert(rejected)


test "grammar descriptors retain package identity across interface relocation":
    span = source.Span(source.SourceId(0), 0, 1)
    descriptor = lexer.OperatorDescriptor("LocalGrammar", [], [], span, grammar=true, semantic_owner="package:grammar")
    registry = lexer.SyntaxRegistry([], [descriptor])
    encoded = payload.encode(generic_module(), registry, [source.virtual_source("grammar.sev", "x")], ["identity"])
    files = [source.virtual_source("consumer.sev", "y")]
    decoded = payload.decode(encoded, "grammar.sevi", files)
    active = lexer.SyntaxRegistry([])
    payload.register_grammar(decoded, active)
    payload.register_grammar(decoded, active)
    assert(len(active.descriptors) == 1)
    assert(active.descriptors[0].semantic_owner == "package:grammar")
    assert(active.descriptors[0].span.source.index == 1)
