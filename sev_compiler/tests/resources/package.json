{
  "package": {
    "name": "compiler-resource-tests",
    "version": "0.1.0",
    "edition": "2026"
  },
  "bin": [
    {
      "name": "limits",
      "path": "src/limits.sev"
    },
    {
      "name": "compilation",
      "path": "src/compilation.sev"
    }
  ],
  "dependencies": {
    "environment": {
        "path": "../../../library/system/environment"
    },
    "process": {
      "path": "../../../library/system/process"
    },
    "package": {
      "path": "../../../library/package"
    },
    "source": {
      "path": "../../frontend/source",
      "package": "sev-compiler-source"
    },
    "lexer": {
      "package": "sev-compiler-lexer",
      "path": "../../frontend/lexer"
    }
  },
  "test": {
    "memory-max": "3GB",
    "timeout-seconds": 60
  }
}
