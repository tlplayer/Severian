import * from "../../../universal/graph/model.sev" as universal
import * from "../../../universal/graph/verify.sev" as graph_verify
import * from "../../../universal/graph/queries.sev" as graph_queries
import source
import * from "../../../universal/id/semantic.sev" as semantic_identity


def definition(value: int) -> universal.DefId:
    return universal.DefId(0, 0, universal.DeclarationId(u128(value)))


test "recursive dependencies form a component after their prerequisites":
    graph = universal.DefinitionGraph()
    left = universal.add_definition(graph, definition(1), universal.DefinitionKind.Callable, "left", None)
    right = universal.add_definition(graph, definition(2), universal.DefinitionKind.Callable, "right", None)
    leaf = universal.add_definition(graph, definition(3), universal.DefinitionKind.Callable, "leaf", None)
    universal.add_dependency(graph, left, right, universal.DependencyKind.Invocation)
    universal.add_dependency(graph, right, left, universal.DependencyKind.Invocation)
    universal.add_dependency(graph, right, leaf, universal.DependencyKind.Invocation)
    graph_verify.freeze_definitions(graph)
    components = graph_queries.dependency_components(graph)
    assert(len(components) == 2)
    assert(len(components[0].members) == 1)
    assert(components[0].members[0].index == leaf.index)
    assert(len(components[1].members) == 2)
    rejected := false
    try:
        universal.add_dependency(graph, left, leaf, universal.DependencyKind.Invocation)
    catch failure: Error:
        rejected = true
    assert(rejected)


test "an alias shares an identity but a conflicting declaration rejects":
    graph = universal.DefinitionGraph()
    origin = source.Span(source.SourceId(1), 2, 8)
    universal.add_definition(graph, definition(1), universal.DefinitionKind.TraitDefinition, "first", origin)
    universal.add_definition(graph, definition(1), universal.DefinitionKind.TraitDefinition, "second", origin, alias=true)
    assert(len(graph.nodes) == 1)
    assert(len(graph.nodes[0].names) == 2)
    rejected := false
    try:
        universal.add_definition(graph, definition(1), universal.DefinitionKind.TraitDefinition, "unrelated", source.Span(source.SourceId(2), 2, 8), alias=true)
    catch failure: Error:
        rejected = true
    assert(rejected)


test "inheritance cycles and wrong endpoint kinds reject":
    graph = universal.DefinitionGraph()
    left = universal.add_definition(graph, definition(1), universal.DefinitionKind.TraitDefinition, "left", None)
    right = universal.add_definition(graph, definition(2), universal.DefinitionKind.TraitDefinition, "right", None)
    universal.add_dependency(graph, left, right, universal.DependencyKind.Inheritance)
    universal.add_dependency(graph, right, left, universal.DependencyKind.Inheritance)
    rejected := false
    try:
        graph_verify.freeze_definitions(graph)
    catch failure: Error:
        rejected = true
    assert(rejected)
    graph.dependencies.clear()
    universal.add_dependency(graph, left, right, universal.DependencyKind.Invocation)
    rejected = false
    try:
        graph_verify.freeze_definitions(graph)
    catch failure: Error:
        rejected = true
    assert(rejected)


test "deserialized dangling edges fail verification":
    graph = universal.DefinitionGraph()
    owner = universal.add_definition(graph, definition(1), universal.DefinitionKind.Callable, "owner", None)
    graph.dependencies.append(universal.DefinitionDependency(owner, universal.DefinitionIndex(100), universal.DependencyKind.Invocation))
    rejected := false
    try:
        graph_verify.freeze_definitions(graph)
    catch failure: Error:
        rejected = true
    assert(rejected)


test "source coordinates convert Unicode scalars to UTF8 bytes":
    file = source.virtual_source("unicode.sev", "π😀x")
    assert(source.utf8_offset(file, 0) == 0)
    assert(source.utf8_offset(file, 1) == 2)
    assert(source.utf8_offset(file, 2) == 6)
    assert(source.utf8_offset(file, 3) == 7)


test "persistent declaration IDs do not depend on discovery order":
    owner = semantic_identity.semantic_key(["library", "1", "module", "analysis"])
    first = semantic_identity.named_definition(owner, "trait", "First")
    second = semantic_identity.named_definition(owner, "trait", "Second")
    second_again = semantic_identity.named_definition(owner, "trait", "Second")
    first_again = semantic_identity.named_definition(owner, "trait", "First")
    assert(semantic_identity.same_definition(first, first_again))
    assert(semantic_identity.same_definition(second, second_again))
    assert(not semantic_identity.same_definition(first, second))


test "semantic key fields cannot collide through separators":
    left = semantic_identity.semantic_key(["a:b", "c"])
    right = semantic_identity.semantic_key(["a", "b:c"])
    assert(left != right)
    assert(not semantic_identity.same_definition(semantic_identity.definition_from_key(left), semantic_identity.definition_from_key(right)))


test "moving a callable within its semantic owner preserves its definition":
    left_span = source.Span(source.SourceId(1), 10, 20)
    right_span = source.Span(source.SourceId(9), 100, 200)
    first = semantic_identity.FunctionDeclaration(name="answer", span=left_span)
    moved = semantic_identity.FunctionDeclaration(name="import_alias.answer", span=right_span, lookup="import_alias.")
    owner = semantic_identity.semantic_key(["package", "frontend", "analysis"])
    first_key = semantic_identity.callable_key(first, owner)
    moved_key = semantic_identity.callable_key(moved, owner)
    assert(first_key == moved_key)
    assert(semantic_identity.same_definition(semantic_identity.definition_from_key(first_key), semantic_identity.definition_from_key(moved_key)))
