import mir
import target
import universal

enum LoweringError:
    NotPrimitive(type_id: universal.TypeId)
    UnknownValue(value: universal.ValueId)
    NonExhaustiveMatch(type_id: universal.TypeId)
    UnsupportedStringOperation(operator: universal.BinaryOperator)
    OwnedStringEscapes(value: universal.ValueId)


def lower_constant(value: universal.LiteralValue) -> universal.Constant:
    match value:
        case IntegerValue:
            return universal.IntegerValue(spelling)
        case FloatValue:
            return universal.FloatValue(spelling)
        case BooleanValue:
            return universal.BooleanValue(value)
        case CharacterValue:
            return universal.IntegerValue(string(int(value)))
        case StringValue:
            return universal.StringValue(value)
        case BytesValue:
            return universal.BytesValue(value)
        case NoneValue:
            return universal.NoneValue
        case UnitValue:
            return universal.Unit


def lower_unary(operator: universal.UnaryOperator) -> universal.UnaryOperation:
    if operator == universal.Positive:
        return universal.Positive
    if operator == universal.Negative:
        return universal.Negative
    return universal.Not


def lower_binary(operator: universal.BinaryOperator) -> universal.BinaryOperation:
    if operator == universal.Add:
        return universal.Add
    if operator == universal.Subtract:
        return universal.Subtract
    if operator == universal.Multiply:
        return universal.Multiply
    if operator == universal.Divide:
        return universal.Divide
    if operator == universal.Remainder:
        return universal.Remainder
    if operator == universal.Power:
        return universal.Power
    if operator == universal.Equal:
        return universal.Equal
    if operator == universal.NotEqual:
        return universal.NotEqual
    if operator == universal.Less:
        return universal.Less
    if operator == universal.LessEqual:
        return universal.LessEqual
    if operator == universal.Greater:
        return universal.Greater
    if operator == universal.GreaterEqual:
        return universal.GreaterEqual
    if operator == universal.Contains:
        return universal.Contains
    if operator == universal.And:
        return universal.And
    return universal.Or


def lower_type(id: universal.TypeId, types: universal.TypeContext, target_spec: target.TargetSpec) -> universal.LoweredType | LoweringError:
    definition = types.definition(id)
    if definition == None:
        return error(NotPrimitive(id))
    match definition.kind:
        case Primitive:
            match definition.representation:
                case Integer:
                    match bits:
                        case Fixed:
                            return universal.Integer(bits, signed)
                        case Machine:
                            return universal.Integer(target_spec.machine_integer_bits(), signed)
                case PointerInteger:
                    return universal.Integer(target_spec.pointer_bits(), signed)
                case Float:
                    match format:
                        case Ieee:
                            return universal.Float(universal.Ieee(bits))
                        case BrainFloat16:
                            return universal.Float(universal.BrainFloat16)
                        case Machine:
                            return universal.Float(universal.Ieee(target_spec.machine_float_bits()))
                case Boolean:
                    return universal.Boolean
                case Character:
                    return universal.Integer(32, false)
                case String:
                    return universal.String
                case Bytes:
                    return universal.Bytes
                case NoneValue:
                    return universal.NoneValue
                case Unit:
                    return universal.Unit
                case Arguments:
                    return universal.Arguments
    return error(NotPrimitive(id))


def lower_block(block: universal.Block, module: universal.Module, types: universal.TypeContext, target_spec: target.TargetSpec) -> universal.Block | LoweringError:
    operations: list[universal.LoweredOperation] = []
    for operation in block.operations:
        match operation:
            case Coverage:
                operations.append(universal.LoweredCoverage(point.key if point.key != None else string(point.span_start)))
            case Constant:
                operations.append(universal.ConstantValue(lower_constant(value), universal.ValueId(result.index)))
            case Unary:
                operations.append(universal.LoweredUnary(lower_unary(operator), universal.ValueId(operand.index), universal.ValueId(result.index)))
            case Binary:
                operations.append(universal.LoweredBinary(lower_binary(operator), universal.ValueId(left.index), universal.ValueId(right.index), universal.ValueId(result.index)))
            case Call:
                arguments_lir: list[universal.ValueId] = []
                for argument in arguments:
                    arguments_lir.append(universal.ValueId(argument.index))
                operations.append(universal.LoweredCall(universal.FunctionId(function.value), arguments_lir, universal.ValueId(result.index)))
            case Return:
                operations.append(universal.LoweredReturn(universal.ValueId(value.index) if value != None else None))
            case Assert:
                location: universal.AssertionLocation | None = None
                if origin.location != None:
                    location = universal.AssertionLocation(origin.location.file, origin.location.line, origin.location.column, origin.location.expression)
                operations.append(universal.LoweredAssert(universal.ValueId(condition.index), universal.ValueId(message.index) if message != None else None, location))
            case If:
                operations.append(universal.LoweredIf(universal.ValueId(condition.index), lower_block(then_block, module, types, target_spec), lower_block(else_block, module, types, target_spec)))
            case Match:
                selected: universal.MatchArm | None = None
                subject_type = module.values[subject.index].type_id
                for arm in arms:
                    if arm.type_id == subject_type or arm.type_id == None:
                        selected = arm
                        break
                if selected == None:
                    return error(NonExhaustiveMatch(subject_type))
                nested = lower_block(selected.body, module, types, target_spec)
                for nested_operation in nested.lowered_operations:
                    operations.append(nested_operation)
            case CompiledRegionCall:
                inputs_lir: list[universal.ValueId] = []
                outputs_lir: list[universal.ValueId] = []
                for input in inputs:
                    inputs_lir.append(universal.ValueId(input.index))
                for output in outputs:
                    outputs_lir.append(universal.ValueId(output.index))
                operations.append(universal.ArtifactCall(artifact_id, inputs_lir, outputs_lir))
    block.lowered_operations = operations
    return block


def lower(module: universal.Module, types: universal.TypeContext, target_spec: target.TargetSpec) -> universal.Module | LoweringError:
    for value in module.values:
        value.lowered_type = lower_type(value.type_id, types, target_spec)
    lower_block(module.initializer, module, types, target_spec)
    for function in module.functions:
        if function.body != None:
            lower_block(function.body, module, types, target_spec)
        function.lowered_result = lower_type(function.result_type, types, target_spec)
        function.linkage = universal.Internal
        match function.call_type:
            case External:
                function.linkage = universal.External(call.symbol.value)
    return module
