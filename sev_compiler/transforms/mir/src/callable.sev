import universal
import source
import diagnostics
import * from "cfg.sev" as cfg
import * from "ownership.sev" as ownership
import * from "aggregate.sev" as aggregate
import * from "../../../universal/type/storage.sev" as storage_types
import * from "../../../universal/declaration/scalar.sev" as boundary


class CallableMirScope:
    bindings: list[universal.ValueId] = []
    loops: list[tuple[int, int]] = []
    update_operands: list[universal.ValueId] = []
    return_target: int = -1
    inline_functions: list[int] = []
    aggregates: aggregate.AggregateStorage = aggregate.AggregateStorage()
    borrowed_records: list[int] = []


def mir_value(module: universal.Module, type_id: universal.TypeId) -> universal.ValueId | diagnostics.Diagnostic:
    id = universal.ValueId(u32(len(module.values)))
    module.values.append(universal.Value(id, type_id))
    return id


def mir_expression(module: universal.Module, context: cfg.ExecutionContext, scope: CallableMirScope, expression: universal.Expression) -> universal.ValueId | diagnostics.Diagnostic:
    match expression.kind:
        case Ownership:
            return mir_expression(module, context, scope, value)
        case AddressOf:
            return callable_mir_place(module, context, scope, value)
        case TypeLayout:
            result = mir_value(module, universal.TypeId(64))
            cfg.append(context, universal.Operation.TypeLayout(subject, alignment, result))
            return result
        case BlockValue:
            local = CallableMirScope(scope.bindings[:], scope.loops, scope.update_operands, scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records)
            mir_block(module, context, body, local)
            return mir_expression(module, context, local, value)
        case Evaluate:
            evaluated = mir_expression(module, context, scope, value)
            return mir_expression(module, context, CallableMirScope(scope.bindings, scope.loops, [evaluated], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records), body)
        case UpdateOperand:
            return scope.update_operands[index]
        case ListValue:
            elements_values: list[universal.ValueId] = []
            for element in elements:
                elements_values.append(mir_expression(module, context, scope, element))
            count = mir_value(module, universal.TypeId(64))
            cfg.append(context, universal.Operation.Constant(universal.IntegerValue(string(len(elements))), count))
            exemplar := count
            if len(elements_values) != 0:
                exemplar = elements_values[0]
            else:
                exemplar = mir_value(module, storage_types.buffer_element(expression.type_id, module.records))
                cfg.append(context, universal.Operation.Constant(universal.NoneValue(), exemplar))
            local := CallableMirScope(scope.bindings, scope.loops, [count, exemplar], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records)
            result = mir_expression(module, context, local, construction)
            position := 0
            for value in elements_values:
                index = mir_value(module, universal.TypeId(64))
                cfg.append(context, universal.Operation.Constant(universal.IntegerValue(string(position)), index))
                local = CallableMirScope(scope.bindings, scope.loops, [result, index, value], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records)
                mir_expression(module, context, local, storage)
                position += 1
            return result
        case IndexReference:
            receiver = mir_expression(module, context, scope, object)
            offset = mir_expression(module, context, scope, index)
            return mir_expression(module, context, CallableMirScope(scope.bindings, scope.loops, [receiver, offset], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records), access)
        case OutcomeValue:
            payload = mir_expression(module, context, scope, value)
            if storage_types.owned_record(expression.type_id, module.records):
                handle = aggregate.allocate(module, context, scope.aggregates, expression.type_id)
                aggregate.initialize(module, context, scope.aggregates, handle, expression.type_id)
                members = aggregate.fields(scope.aggregates, handle)
                tag = mir_value(module, universal.TypeId(64))
                cfg.append(context, universal.Operation.Constant(universal.IntegerValue(string(variant)), tag))
                cfg.append(context, universal.Operation.Store(members[0], tag))
                aggregate.store(module, context, scope.aggregates, members[variant + 1], payload)
                return handle
            address = mir_value(module, universal.TypeId(5))
            cfg.append(context, universal.Operation.Allocate(expression.type_id, address))
            empty = mir_value(module, expression.type_id)
            cfg.append(context, universal.Operation.Constant(universal.NoneValue(), empty))
            cfg.append(context, universal.Operation.Store(address, empty))
            tag = mir_value(module, universal.TypeId(64))
            cfg.append(context, universal.Operation.Constant(universal.IntegerValue(string(variant)), tag))
            tag_address = mir_value(module, universal.TypeId(5))
            cfg.append(context, universal.Operation.FieldAddress(address, expression.type_id, 0, tag_address))
            cfg.append(context, universal.Operation.Store(tag_address, tag))
            payload_address = mir_value(module, universal.TypeId(5))
            cfg.append(context, universal.Operation.FieldAddress(address, expression.type_id, variant + 1, payload_address))
            cfg.append(context, universal.Operation.Store(payload_address, payload))
            result = mir_value(module, expression.type_id)
            cfg.append(context, universal.Operation.Load(address, result))
            return result
        case OutcomeTest:
            input = mir_expression(module, context, scope, value)
            return aggregate.test_variant(module, context, scope.aggregates, input, variant)
        case OutcomeUnwrap:
            origin = cfg.origin(module, "Outcome", expression.span)
            syntax = universal.OperatorSyntax("", universal.Fixity.Prefix, 0, universal.Associativity.None, definition=origin.grammar)
            evaluated = execute_grammar(module, context, scope, syntax, [value], [], expression.span, expression.type_id)
            return semantic_runtime(evaluated, expression.span)
        case LiteralValue:
            result = mir_value(module, expression.type_id)
            cfg.append(context, universal.Operation.Constant(value, result))
            return result
        case BindingReference:
            address = callable_mir_place(module, context, scope, expression)
            return aggregate.load(module, context, address, expression.type_id)
        case FieldReference:
            address = callable_mir_place(module, context, scope, expression)
            return aggregate.load(module, context, address, expression.type_id)
        case RecordValue:
            if storage_types.owned_record(expression.type_id, module.records):
                handle = aggregate.allocate(module, context, scope.aggregates, expression.type_id)
                members = aggregate.fields(scope.aggregates, handle)
                for argument in fields:
                    value = mir_expression(module, context, scope, argument.value)
                    for record in module.records:
                        if record.type_id.index == expression.type_id.index:
                            index := 0
                            for field in record.fields:
                                if argument.name == field.name:
                                    aggregate.store(module, context, scope.aggregates, members[index], value)
                                index += 1
                return handle
            address = mir_value(module, universal.TypeId(5))
            cfg.append(context, universal.Operation.Allocate(expression.type_id, address))
            for argument in fields:
                value = mir_expression(module, context, scope, argument.value)
                for record in module.records:
                    if record.type_id.index == expression.type_id.index:
                        index := 0
                        for field in record.fields:
                            if argument.name == field.name:
                                target = mir_value(module, universal.TypeId(5))
                                cfg.append(context, universal.Operation.FieldAddress(address, expression.type_id, index, target))
                                cfg.append(context, universal.Operation.Store(target, value))
                            index += 1
            result = mir_value(module, expression.type_id)
            cfg.append(context, universal.Operation.Load(address, result))
            return result
        case TypeName:
            mir_expression(module, context, scope, value)
            result = mir_value(module, expression.type_id)
            cfg.append(context, universal.Operation.Constant(universal.StringValue(name), result))
            return result
        case Unary:
            input = mir_expression(module, context, scope, operand)
            if operator.symbol == "+":
                return input
            result = mir_value(module, expression.type_id)
            cfg.append(context, universal.Operation.Unary(operator, input, result))
            return result
        case Binary:
            lhs = mir_expression(module, context, scope, left)
            rhs = mir_expression(module, context, scope, right)
            result = mir_value(module, expression.type_id)
            cfg.append(context, universal.Operation.Binary(operator, lhs, rhs, result))
            return result
        case Conditional:
            origin = cfg.origin(module, "Conditional", expression.span)
            syntax = universal.OperatorSyntax("", universal.Fixity.Prefix, 0, universal.Associativity.None, definition=origin.grammar)
            evaluated = execute_grammar(module, context, scope, syntax, [condition, then_value, else_value], [], expression.span)
            result = semantic_runtime(evaluated, expression.span)
            if module.values[result.index].type_id.index != expression.type_id.index:
                return error(diagnostics.Diagnostic("E000231", "grammar result type mismatch", expression.span))
            return result
        case ResolvedCall:
            match callee:
                case Direct:
                    native := false
                    for declaration in module.functions:
                        if declaration.id.value == function.declaration.value:
                            native = boundary.scalar_boundary(declaration, "mlir") != ""
                            if aggregate.signature(declaration, module.records) or callable_exclusive_signature(declaration) or (declaration.extension and storage_types.buffer_element(declaration.parameter_types[0], module.records).index != 0):
                                return callable_inline_receiver(module, context, scope, declaration, arguments, expression.span)
                    evaluated: list[universal.ValueId] = []
                    for argument in arguments:
                        if storage_types.indirect_value(argument.value.type_id, module.records) and not native:
                            evaluated.append(callable_mir_place(module, context, scope, argument.value))
                        else:
                            evaluated.append(mir_expression(module, context, scope, argument.value))
                    inputs: list[universal.ValueId] = []
                    for declaration in module.functions:
                        if declaration.id.value == function.declaration.value:
                            parameter_index := 0
                            for parameter in declaration.parameters:
                                argument_index := 0
                                for argument in arguments:
                                    if argument.name == parameter.name or (argument.name == None and parameter_index == argument_index):
                                        inputs.append(evaluated[argument_index])
                                    argument_index += 1
                                parameter_index += 1
                    result = mir_value(module, expression.type_id)
                    cfg.append(context, universal.Operation.Call(universal.FunctionId(function.declaration.value), inputs, result))
                    return result
                case _:
                    pass
        case _:
            pass
    return error(diagnostics.Diagnostic("E000230", "semantic analysis admitted an unresolved expression", expression.span))


# A source extension borrows its receiver's binding. Inline buffer receivers
# before SSA promotion so descriptor replacement and all allocation aliases
# remain visible to the existing ownership pipeline, including loop backedges.
def callable_exclusive_parameter(parameter: universal.FunctionParameter) -> bool:
    for modifier in parameter.modifiers:
        if modifier.name == "borrow mut":
            return true
    return false


def callable_exclusive_signature(function: universal.FunctionDeclaration) -> bool:
    for parameter in function.parameters:
        if callable_exclusive_parameter(parameter):
            return true
    return false


def callable_inline_receiver(module: universal.Module, context: cfg.ExecutionContext, scope: CallableMirScope, function: universal.FunctionDeclaration, arguments: list[universal.CallArgument], span: source.Span) -> universal.ValueId | diagnostics.Diagnostic:
    identity = int(function.id.value)
    if identity in scope.inline_functions:
        if aggregate.signature(function, module.records):
            return error(diagnostics.Diagnostic("E000230", "recursive owned aggregate calls require a reference ABI", span))
        return error(diagnostics.Diagnostic("E000230", "recursive buffer receiver methods require a reference ABI", span))
    if boundary.scalar_boundary(function, "mlir") != "" or function.body == None:
        return error(diagnostics.Diagnostic("E000230", "owned aggregate boundaries require an ownership ABI", span))
    continuation = cfg.block(context)
    result := mir_value(module, function.result_type)
    if function.result_type.index != 2:
        result = aggregate.parameter(module, context, scope.aggregates, function.result_type, continuation)
    local = CallableMirScope(return_target=continuation, inline_functions=scope.inline_functions[:], aggregates=scope.aggregates)
    local.inline_functions.append(identity)
    # Arguments have been bound to parameters by semantic analysis. Evaluate
    # each once before entering the callee, including aliased value arguments.
    evaluated: list[universal.ValueId] = []
    for argument in arguments:
        receiver := function.extension and storage_types.buffer_element(function.parameter_types[0], module.records).index != 0 and argument.name == function.parameters[0].name
        for parameter in function.parameters:
            if argument.name == parameter.name and callable_exclusive_parameter(parameter):
                receiver = true
        if receiver or storage_types.indirect_value(argument.value.type_id, module.records):
            evaluated.append(callable_mir_place(module, context, scope, argument.value))
        else:
            evaluated.append(mir_expression(module, context, scope, argument.value))
    index := 0
    for parameter in function.parameters:
        argument_index := 0
        for argument in arguments:
            if argument.name == parameter.name:
                receiver = (function.extension and index == 0 and storage_types.buffer_element(parameter.type_id, module.records).index != 0) or (callable_exclusive_parameter(parameter) and not storage_types.indirect_value(parameter.type_id, module.records))
                if receiver or storage_types.owned_record(parameter.type_id, module.records):
                    local.bindings.append(evaluated[argument_index])
                    if storage_types.owned_record(parameter.type_id, module.records):
                        local.borrowed_records.append(index)
                else:
                    type_id = universal.TypeId(5) if storage_types.indirect_value(parameter.type_id, module.records) else parameter.type_id
                    cell = mir_value(module, universal.TypeId(5))
                    cfg.append(context, universal.Operation.Allocate(type_id, cell))
                    cfg.append(context, universal.Operation.Store(cell, evaluated[argument_index]))
                    local.bindings.append(cell)
            argument_index += 1
        index += 1
    body ?= function.body
    if body == None:
        return error(diagnostics.Diagnostic("E000230", "receiver borrowing requires a source body", span))
    if body != None:
        mir_block(module, context, body, local)
    origin = cfg.origin(module, "Return", span)
    if cfg.open(context):
        if function.result_type.index == 2:
            cfg.fallthrough(context, continuation, origin)
        else:
            cfg.terminate(context, universal.CfgExit.Dead, origin)
    cfg.at(context, continuation)
    return result


def mir_block(module: universal.Module, context: cfg.ExecutionContext, block: universal.Block, scope: CallableMirScope) -> bool | diagnostics.Diagnostic:
    for statement in block.statements:
        if not cfg.open(context):
            return true
        match statement:
            case BindingStatement:
                match binding.value.kind:
                    case Ownership:
                        if mode == "borrow mut" and not binding.update:
                            scope.bindings.append(callable_mir_place(module, context, scope, value))
                            continue
                    case _:
                        pass
                value := mir_expression(module, context, scope, binding.value)
                if storage_types.owned_record(binding.type_id, module.records):
                    if binding.update:
                        if int(binding.id.index) in scope.borrowed_records:
                            return error(diagnostics.Diagnostic("E000230", "owned aggregate parameter rebinding requires a reference ABI", binding.span))
                        aggregate.store(module, context, scope.aggregates, scope.bindings[binding.id.index], value)
                    else:
                        destination = aggregate.allocate(module, context, scope.aggregates, binding.type_id)
                        aggregate.store(module, context, scope.aggregates, destination, value)
                        scope.bindings.append(destination)
                    continue
                if storage_types.indirect_value(binding.type_id, module.records):
                    address = mir_value(module, universal.TypeId(5))
                    cfg.append(context, universal.Operation.Allocate(binding.type_id, address))
                    cfg.append(context, universal.Operation.Store(address, value))
                    value = address
                if binding.update:
                    cfg.append(context, universal.Operation.Store(scope.bindings[binding.id.index], value))
                else:
                    cell = mir_value(module, universal.TypeId(5))
                    stored_type = universal.TypeId(5) if storage_types.indirect_value(binding.type_id, module.records) else binding.type_id
                    cfg.append(context, universal.Operation.Allocate(stored_type, cell))
                    cfg.append(context, universal.Operation.Store(cell, value))
                    scope.bindings.append(cell)
            case ExpressionStatement:
                mir_expression(module, context, scope, expression)
            case Assert:
                value = mir_expression(module, context, scope, condition)
                origin = universal.AssertionOrigin(span.start, condition_span.start, condition_span.end, None)
                cfg.append(context, universal.Operation.Assert(value, None, origin))
            case GrammarApply:
                execute_grammar(module, context, scope, syntax, operands, bodies, span)
            case _:
                return error(diagnostics.Diagnostic("E000230", "semantic analysis admitted an unsupported statement", None))

    return true

def required_calls(body: universal.CfgBody, required: list[string]):
    for block in body.blocks:
        for operation in block.operations:
            match operation:
                case Call:
                    identity = string(function.value)
                    if identity not in required:
                        required.append(identity)
                case _:
                    pass


def build_callables(module: universal.Module, library_sources: list[int] = []) -> universal.Module | diagnostics.Diagnostic:
    scope = CallableMirScope()
    context := cfg.ExecutionContext(universal.empty_cfg(universal.TypeId(2)))
    mir_block(module, context, module.initializer, scope)
    cfg.finish(module, context, source.Span(source.SourceId(0), 0, 0))
    ownership.analyze_ownership(module, context.body, [])
    module.cfg_bodies.append(context.body)
    module.globals = scope.bindings
    functions: list[universal.FunctionDeclaration] = []
    required: list[string] = []
    required_calls(context.body, required)
    # All application declarations remain roots, including library exports and
    # unused functions that still need lowering diagnostics. Only prelude bodies
    # are demand driven. Scan lowered calls so inlined ownership operations,
    # recursive calls and source grammar-generated calls use the same graph.
    for function in module.functions:
        identity = string(function.id.value)
        # External declarations are ABI contracts even when no call is live.
        # Keep them so conflicting native signatures cannot disappear in DCE.
        if boundary.scalar_boundary(function, "c") != "" and identity not in required:
            required.append(identity)
        origin ?= function.span
        if origin != None:
            if int(origin.source.index) not in library_sources and identity not in required:
                required.append(identity)
        else:
            if identity not in required:
                required.append(identity)
    cursor := 0
    while cursor < len(required):
        identity = required[cursor]
        cursor += 1
        selected := -1
        index := 0
        for candidate in module.functions:
            if string(candidate.id.value) == identity:
                selected = index
                break
            index += 1
        if selected == -1:
            return error(diagnostics.Diagnostic("E000230", "call graph refers to an unknown function", None))
        function = module.functions[selected]
        if aggregate.signature(function, module.records) or callable_exclusive_signature(function):
            if function.body == None or boundary.scalar_boundary(function, "mlir") != "":
                return error(diagnostics.Diagnostic("E000230", "owned aggregate boundaries require an ownership ABI", function.span))
            continue
        local = CallableMirScope()
        context = cfg.ExecutionContext(universal.empty_cfg(function.result_type))
        for type_id in function.parameter_types:
            stored_type = universal.TypeId(5) if storage_types.indirect_value(type_id, module.records) and boundary.scalar_boundary(function, "mlir") == "" else type_id
            parameter_value = mir_value(module, stored_type)
            function.values.append(parameter_value)
            cell = mir_value(module, universal.TypeId(5))
            cfg.append(context, universal.Operation.Allocate(stored_type, cell))
            cfg.append(context, universal.Operation.Store(cell, parameter_value))
            local.bindings.append(cell)
        body ?= function.body
        if body != None:
            mir_block(module, context, body, local)
            span := source.Span(source.SourceId(0), 0, 0)
            declared ?= function.span
            if declared != None:
                span = declared
            cfg.finish(module, context, span, function.values)
            ownership.analyze_ownership(module, context.body, function.values)
            required_calls(context.body, required)
            function.cfg_index = int(len(module.cfg_bodies))
            module.cfg_bodies.append(context.body)
        functions.append(function)
    module.functions = functions
    return module


def callable_mir_place(module: universal.Module, context: cfg.ExecutionContext, scope: CallableMirScope, expression: universal.Expression) -> universal.ValueId | diagnostics.Diagnostic:
    match expression.kind:
        case Ownership:
            return callable_mir_place(module, context, scope, value)
        case BindingReference:
            if storage_types.owned_record(expression.type_id, module.records):
                return scope.bindings[binding.index]
            if storage_types.indirect_value(expression.type_id, module.records):
                address = mir_value(module, universal.TypeId(5))
                cfg.append(context, universal.Operation.Load(scope.bindings[binding.index], address))
                return address
            return scope.bindings[binding.index]
        case FieldReference:
            base = callable_mir_place(module, context, scope, object)
            if storage_types.owned_record(object.type_id, module.records):
                return aggregate.fields(scope.aggregates, base)[index]
            result = mir_value(module, universal.TypeId(5))
            cfg.append(context, universal.Operation.FieldAddress(base, object.type_id, index, result))
            return result
        case _:
            value = mir_expression(module, context, scope, expression)
            if storage_types.owned_record(expression.type_id, module.records):
                return value
            address = mir_value(module, universal.TypeId(5))
            cfg.append(context, universal.Operation.Allocate(expression.type_id, address))
            cfg.append(context, universal.Operation.Store(address, value))
            return address



enum SemanticValue:
    SourceOperand(operand: universal.LazyOperand)
    RuntimeValue(value: universal.ValueId)
    IndexedHandle(receiver: universal.ValueId, index: universal.ValueId, access: universal.Expression, storage: universal.Expression | None)
    PlaceHandle(address: universal.ValueId, type_id: universal.TypeId)
    BlockHandle(block: int)
    Nothing


class SemanticFrame:
    context: cfg.ExecutionContext
    origin: universal.CfgTerminator
    result_type: universal.TypeId = universal.TypeId(0)
    names: list[string] = []
    values: list[SemanticValue] = []


def semantic_value(frame: SemanticFrame, name: string, span: source.Span) -> SemanticValue | diagnostics.Diagnostic:
    index := 0
    for candidate in frame.names:
        if candidate == name:
            return frame.values[index]
        index += 1
    return error(diagnostics.Diagnostic("E000231", "unknown compiler context value " + name, span))


def semantic_block(value: SemanticValue, span: source.Span) -> int | diagnostics.Diagnostic:
    match value:
        case BlockHandle:
            return block
        case _:
            return error(diagnostics.Diagnostic("E000231", "CFG operation requires a block handle", span))


def semantic_runtime(value: SemanticValue, span: source.Span) -> universal.ValueId | diagnostics.Diagnostic:
    match value:
        case RuntimeValue:
            return value
        case _:
            return error(diagnostics.Diagnostic("E000231", "CFG operation requires a lowered runtime value", span))


def semantic_path(expression: universal.Expression) -> string:
    match expression.kind:
        case Name:
            return name
        case Member:
            return semantic_path(object) + "." + name
        case _:
            return ""


def semantic_eval(module: universal.Module, scope: CallableMirScope, frame: SemanticFrame, expression: universal.Expression) -> SemanticValue | diagnostics.Diagnostic:
    match expression.kind:
        case Name:
            return semantic_value(frame, name, expression.span)
        case Call:
            name = semantic_path(callee)
            inputs: list[SemanticValue] = []
            for argument in arguments:
                inputs.append(semantic_eval(module, scope, frame, argument.value))
            if name == "place" and len(inputs) == 1:
                match inputs[0]:
                    case SourceOperand:
                        match operand:
                            case ExpressionBody:
                                match expression.kind:
                                    case BindingReference:
                                        if storage_types.owned_record(expression.type_id, module.records) and int(binding.index) in scope.borrowed_records:
                                            return error(diagnostics.Diagnostic("E000230", "owned aggregate parameter rebinding requires a reference ABI", expression.span))
                                    case IndexReference:
                                        receiver = mir_expression(module, frame.context, scope, object)
                                        offset = mir_expression(module, frame.context, scope, index)
                                        return IndexedHandle(receiver, offset, access, storage)
                                    case _:
                                        pass
                                address = callable_mir_place(module, frame.context, scope, expression)
                                return PlaceHandle(address, expression.type_id)
                            case _:
                                pass
                    case _:
                        pass
                return error(diagnostics.Diagnostic("E000231", "place requires a resolved destination", expression.span))
            if name == "load" and len(inputs) == 1:
                match inputs[0]:
                    case IndexedHandle:
                        local = CallableMirScope(scope.bindings, scope.loops, [receiver, index], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records)
                        return RuntimeValue(mir_expression(module, frame.context, local, access))
                    case PlaceHandle:
                        return RuntimeValue(aggregate.load(module, frame.context, address, type_id))
                    case _:
                        return error(diagnostics.Diagnostic("E000231", "load requires a place", expression.span))
            if name == "store" and len(inputs) == 2:
                value = semantic_runtime(inputs[1], expression.span)
                match inputs[0]:
                    case IndexedHandle:
                        implementation ?= storage
                        if implementation != None:
                            local = CallableMirScope(scope.bindings, scope.loops, [receiver, index, value], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records)
                            mir_expression(module, frame.context, local, implementation)
                            return Nothing
                        return error(diagnostics.Diagnostic("E000231", "indexed storage is not writable", expression.span))
                    case PlaceHandle:
                        if module.values[value.index].type_id.index != type_id.index:
                            return error(diagnostics.Diagnostic("E000231", "place store type mismatch", expression.span))
                        aggregate.store(module, frame.context, scope.aggregates, address, value)
                        return Nothing
                    case _:
                        return error(diagnostics.Diagnostic("E000231", "store requires a place", expression.span))
            if name == "apply" and len(inputs) == 3:
                previous = semantic_runtime(inputs[1], expression.span)
                right = semantic_runtime(inputs[2], expression.span)
                match inputs[0]:
                    case SourceOperand:
                        match operand:
                            case ExpressionBody:
                                local = CallableMirScope(scope.bindings, scope.loops, [previous, right], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records)
                                return RuntimeValue(mir_expression(module, frame.context, local, expression))
                            case _:
                                pass
                    case _:
                        pass
                return error(diagnostics.Diagnostic("E000231", "apply requires a resolved update", expression.span))
            if name == "cfg.block" and len(inputs) == 0:
                return BlockHandle(cfg.block(frame.context))
            if name == "cfg.begin_loop" and len(inputs) == 2:
                scope.loops.append((semantic_block(inputs[0], expression.span), semantic_block(inputs[1], expression.span)))
                return Nothing
            if name == "cfg.end_loop" and len(inputs) == 0:
                if len(scope.loops) == 0:
                    return error(diagnostics.Diagnostic("E000231", "compiler context has no active loop", expression.span))
                scope.loops.pop()
                return Nothing
            if name in ["cfg.loop_header", "cfg.loop_exit"] and len(inputs) == 0:
                if len(scope.loops) == 0:
                    return error(diagnostics.Diagnostic("E000231", "compiler context has no active loop", expression.span))
                return BlockHandle(scope.loops[-1][0] if name == "cfg.loop_header" else scope.loops[-1][1])
            if name == "cfg.at" and len(inputs) == 1:
                cfg.at(frame.context, semantic_block(inputs[0], expression.span))
                return Nothing
            if name == "cfg.fallthrough" and len(inputs) == 1:
                cfg.fallthrough(frame.context, semantic_block(inputs[0], expression.span), frame.origin)
                return Nothing
            if name == "cfg.parameter" and len(inputs) == 2:
                target = semantic_block(inputs[0], expression.span)
                exemplar = semantic_runtime(inputs[1], expression.span)
                parameter = aggregate.parameter(module, frame.context, scope.aggregates, module.values[exemplar.index].type_id, target)
                return RuntimeValue(parameter)
            if name == "cfg.goto" and len(inputs) >= 1:
                edge_arguments: list[universal.ValueId] = []
                for input in inputs[1:]:
                    for value in aggregate.values(module, frame.context, scope.aggregates, semantic_runtime(input, expression.span)):
                        edge_arguments.append(value)
                cfg.terminate(frame.context, universal.CfgExit.Jump(universal.CfgEdge(semantic_block(inputs[0], expression.span), edge_arguments)), frame.origin)
                return Nothing
            if name == "cfg.branch" and len(inputs) == 3:
                condition = semantic_runtime(inputs[0], expression.span)
                if module.values[condition.index].type_id.index != 1:
                    return error(diagnostics.Diagnostic("E000231", "CFG branch condition requires bool", expression.span))
                taken = universal.CfgEdge(semantic_block(inputs[1], expression.span))
                otherwise = universal.CfgEdge(semantic_block(inputs[2], expression.span))
                cfg.terminate(frame.context, universal.CfgExit.Conditional(condition, taken, otherwise), frame.origin)
                return Nothing
            if name == "cfg.throw" and len(inputs) == 1:
                raised = semantic_runtime(inputs[0], expression.span)
                if scope.return_target >= 0 and len(frame.context.body.blocks[scope.return_target].parameters) != 0:
                    cfg.terminate(frame.context, universal.CfgExit.Jump(universal.CfgEdge(scope.return_target, aggregate.values(module, frame.context, scope.aggregates, raised))), frame.origin)
                elif storage_types.owned_record(module.values[raised.index].type_id, module.records):
                    # An unhandled outcome has no return boundary. Terminate
                    # here without letting its lowering-only handle escape.
                    failed = mir_value(module, universal.TypeId(1))
                    cfg.append(frame.context, universal.Operation.Constant(universal.BooleanValue(false), failed))
                    cfg.append(frame.context, universal.Operation.Assert(failed, None, universal.AssertionOrigin(0, 0, 0, None)))
                    # Keep one return form for the ownership pass. The assert
                    # always traps, so this continuation cannot execute.
                    if scope.return_target >= 0:
                        cfg.terminate(frame.context, universal.CfgExit.Jump(universal.CfgEdge(scope.return_target, [])), frame.origin)
                    elif frame.context.body.return_type.index == 2:
                        cfg.terminate(frame.context, universal.CfgExit.Finish(None), frame.origin)
                    else:
                        return error(diagnostics.Diagnostic("E000230", "CFG error outcome does not match function boundary", expression.span))
                else:
                    cfg.terminate(frame.context, universal.CfgExit.Raise(raised), frame.origin)
                return Nothing
            if name in ["outcome.success", "outcome.payload"] and len(inputs) == 1:
                input = semantic_runtime(inputs[0], expression.span)
                type_id = module.values[input.index].type_id
                for record in module.records:
                    if record.type_id.index == type_id.index:
                        index := 0
                        for variant in universal.outcome_variants(record):
                            if variant.index == frame.result_type.index:
                                if name == "outcome.success":
                                    return RuntimeValue(aggregate.test_variant(module, frame.context, scope.aggregates, input, index))
                                if storage_types.owned_record(type_id, module.records):
                                    field = aggregate.fields(scope.aggregates, input)[index + 1]
                                    return RuntimeValue(aggregate.load(module, frame.context, field, variant))
                                address = mir_value(module, universal.TypeId(5))
                                cfg.append(frame.context, universal.Operation.Allocate(type_id, address))
                                cfg.append(frame.context, universal.Operation.Store(address, input))
                                field = mir_value(module, universal.TypeId(5))
                                cfg.append(frame.context, universal.Operation.FieldAddress(address, type_id, index + 1, field))
                                result = mir_value(module, variant)
                                cfg.append(frame.context, universal.Operation.Load(field, result))
                                return RuntimeValue(result)
                            index += 1
                return error(diagnostics.Diagnostic("E000231", "outcome operation requires a declared variant", expression.span))
            if name == "cfg.return" and len(inputs) <= 1:
                returned: universal.ValueId | None := None
                inline_arguments: list[universal.ValueId] = []
                if len(inputs) == 1:
                    match inputs[0]:
                        case RuntimeValue:
                            returned = value
                            for returned_field in aggregate.values(module, frame.context, scope.aggregates, value):
                                inline_arguments.append(returned_field)
                        case Nothing:
                            pass
                        case _:
                            return error(diagnostics.Diagnostic("E000231", "CFG return requires a lowered value", expression.span))
                if scope.return_target >= 0:
                    cfg.terminate(frame.context, universal.CfgExit.Jump(universal.CfgEdge(scope.return_target, inline_arguments)), frame.origin)
                else:
                    cfg.terminate(frame.context, universal.CfgExit.Finish(returned), frame.origin)
                return Nothing
            if name == "lower" and len(inputs) == 1:
                match inputs[0]:
                    case SourceOperand:
                        match operand:
                            case ExpressionBody:
                                return RuntimeValue(mir_expression(module, frame.context, scope, expression))
                            case StatementBody:
                                if not cfg.open(frame.context):
                                    return error(diagnostics.Diagnostic("E000230", "body lowering after CFG terminator", frame.origin.span))
                                mir_block(module, frame.context, body, CallableMirScope(scope.bindings[:], scope.loops, return_target=scope.return_target, inline_functions=scope.inline_functions, aggregates=scope.aggregates, borrowed_records=scope.borrowed_records))
                                return Nothing
                    case Nothing:
                        return Nothing
                    case _:
                        return error(diagnostics.Diagnostic("E000231", "lower requires a source operand", expression.span))
            return error(diagnostics.Diagnostic("E000231", "invalid compiler context call " + name, expression.span))
        case _:
            return error(diagnostics.Diagnostic("E000231", "invalid compiler context expression", expression.span))


def execute_grammar(module: universal.Module, context: cfg.ExecutionContext, scope: CallableMirScope, syntax: universal.OperatorSyntax, operands: list[universal.Expression], bodies: list[universal.Block], span: source.Span, result_type: universal.TypeId = universal.TypeId(0)) -> SemanticValue | diagnostics.Diagnostic:
    for definition in module.traits:
        if definition.grammar and definition.definition.module == syntax.definition.module and definition.definition.declaration.value == syntax.definition.declaration.value:
            capable := false
            for property in definition.properties:
                if property.name == "control_flow":
                    supplied ?= property.default
                    if supplied != None:
                        match supplied.kind:
                            case Name:
                                capable = name in ["Branch", "Loop", "Return", "Error", "Mutation"]
                            case Member:
                                capable = name in ["Branch", "Loop", "Return", "Error", "Mutation"]
                            case _:
                                pass
            if not capable:
                return error(diagnostics.Diagnostic("E000231", "compiler context requires a control-flow grammar capability", span))
            for method in definition.methods:
                if method.name == "semantic":
                    program ?= method.body
                    if program != None:
                        frame = SemanticFrame(context, universal.CfgTerminator(universal.CfgExit.Dead, definition.definition, span), result_type)
                        for operand in operands:
                            frame.values.append(SourceOperand(universal.LazyOperand.ExpressionBody(operand)))
                        for body in bodies:
                            frame.values.append(SourceOperand(universal.LazyOperand.StatementBody(body)))
                        if len(frame.values) > len(method.parameters):
                            return error(diagnostics.Diagnostic("E000231", "grammar semantic operand count mismatch", span))
                        parameter_index := 0
                        for parameter in method.parameters:
                            required = "Ex" if parameter_index < len(operands) or len(bodies) == 0 else "B"
                            valid := false
                            optional := false
                            annotations := [parameter.annotation]
                            match parameter.annotation.kind:
                                case Union:
                                    annotations = members
                                case _:
                                    pass
                            for annotation in annotations:
                                name ?= universal.simple_type_name(annotation)
                                if name == required:
                                    valid = true
                                if name == "absent":
                                    optional = true
                            if not valid:
                                return error(diagnostics.Diagnostic("E000231", "compiler semantic parameter requires " + required, parameter.span))
                            if parameter_index >= len(frame.values):
                                if not optional:
                                    return error(diagnostics.Diagnostic("E000231", "grammar semantic operand count mismatch", span))
                                frame.values.append(Nothing)
                            frame.names.append(parameter.name)
                            parameter_index += 1
                        for statement in program.statements:
                            match statement:
                                case BindingStatement:
                                    if binding.name in frame.names:
                                        return error(diagnostics.Diagnostic("E000231", "compiler context binding already exists", binding.span))
                                    value = semantic_eval(module, scope, frame, binding.value)
                                    frame.names.append(binding.name)
                                    frame.values.append(value)
                                case ExpressionStatement:
                                    semantic_eval(module, scope, frame, expression)
                                case Return:
                                    returned ?= value
                                    if returned != None:
                                        return semantic_eval(module, scope, frame, returned)
                                    return Nothing
                                case _:
                                    return error(diagnostics.Diagnostic("E000231", "unsupported semantic context statement", span))
                        return Nothing
            return error(diagnostics.Diagnostic("E000231", "grammar requires a semantic body", span))
    return error(diagnostics.Diagnostic("E000231", "unresolved grammar capability", span))
