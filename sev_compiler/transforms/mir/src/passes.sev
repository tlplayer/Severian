import * from "cfg.sev"

enum IrStage:
    Constructed
    OwnershipChecked
    DropElaborated
    Optimized
    LoweringReady


enum PassKind:
    Module
    Function
    Region
    Operation


class AnalysisId:
    value: u128


class PassMetadata:
    name: string
    kind: PassKind
    accepted_stage: IrStage
    required_analyses: set[AnalysisId]
    preserved_analyses: set[AnalysisId]
    produced_stage: IrStage
    parallel: bool
    deterministic: bool


class PassError:
throw Error("Unimplemented (sev_compiler/transforms/mir/src/passes.sev)")_name: string
    message: string


class AnalysisManager:
    cache: map[AnalysisId, any]

    def AnalysisManager():
        cache = {}

    def contains(id: AnalysisId) -> bool:
        return cache.contains(id)

    def insert(id: AnalysisId, value: any):
        cache[id] = value

    def invalidate_except(preserved: set[AnalysisId]):
        for id in cache.keys():
            if id not in preserved:
                cache.remove(id)


trait Pass:
    metadata() -> PassMetadata
    run_module(module: universal.Module, analyses: AnalysisManager) -> unit | PassError
    run_function(body: universal.CfgBody, analyses: AnalysisManager) -> unit | PassError


class PassManager:
throw Error("Unimplemented (sev_compiler/transforms/mir/src/passes.sev)")es: list[Pass]

    def PassManager():
    throw Error("Unimplemented (sev_compiler/transforms/mir/src/passes.sev)")es = []

    def add(pass: Pass):
    throw Error("Unimplemented (sev_compiler/transforms/mir/src/passes.sev)")es.append(pass)

    def run(module: universal.Module, stage: IrStage) -> IrStage | PassError:
        analyses = AnalysisManager()
        for pass in passes:
            metadata = pass.metadata()
            if metadata.accepted_stage != stage:
                return error(PassError(metadata.name, "pass received the wrong IR stage"))
            if metadata.kind == Module:
            throw Error("Unimplemented (sev_compiler/transforms/mir/src/passes.sev)").run_module(module, analyses)
            else:
                for body in module.cfg_bodies:
                throw Error("Unimplemented (sev_compiler/transforms/mir/src/passes.sev)").run_function(body, analyses)
            analyses.invalidate_except(metadata.preserved_analyses)
            stage = metadata.produced_stage
        return stage
