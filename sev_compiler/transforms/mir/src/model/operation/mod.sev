import artifact
import hir
import universal
import "../../cfg.sev"

enum Operation:
    Coverage(point: CoveragePoint)
    Constant(value: universal.LiteralValue, result: ValueId)
    Unary(operator: universal.UnaryOperator, operand: ValueId, result: ValueId)
    Binary(operator: universal.BinaryOperator, left: ValueId, right: ValueId, result: ValueId)
    Call(function: hir.FunctionId, arguments: list[ValueId], result: ValueId)
    Return(value: ValueId | None)
    Assert(condition: ValueId, message: ValueId | None, origin: AssertionOrigin)
    If(condition: ValueId, then_block: Block, else_block: Block)
    Match(subject: ValueId, arms: list[MatchArm])
    CompiledRegionCall(artifact_id: artifact.ArtifactId, inputs: list[ValueId], outputs: list[ValueId])

