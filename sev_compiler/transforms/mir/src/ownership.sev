import universal
import diagnostics
import "cfg.sev" as cfg


class ValueAlias:
    source: universal.ValueId
    target: universal.ValueId


class OwnershipReport:
    storage: list[universal.ValueId] = []
    aliases: list[ValueAlias] = []


# The callable frontend currently admits stack storage and SSA string buffers.
# Record their aliases on the executable graph; buffer deallocation consumes
# these same SSA edges in MLIR. General resource loans and cleanup are not yet
# admitted by this frontend and must not use the former linear statement walk.
def analyze_ownership(module: universal.Module, body: universal.CfgBody, parameters: list[universal.ValueId]) -> OwnershipReport | diagnostics.Diagnostic:
    cfg.verify_availability(body, parameters)
    report = OwnershipReport()
    for block in body.blocks:
        for operation in block.operations:
            match operation:
                case Allocate:
                    report.storage.append(result)
                case Alias:
                    report.aliases.append(ValueAlias(value, result))
                case _:
                    pass
        terminal ?= block.terminator
        if terminal != None:
            for edge in cfg.successors(terminal.exit):
                index := 0
                for argument in edge.arguments:
                    report.aliases.append(ValueAlias(argument, body.blocks[edge.target].parameters[index]))
                    index += 1
    return report
