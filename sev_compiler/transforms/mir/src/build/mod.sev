import universal
import "../cfg.sev"
import "../model/operation/mod.sev"
import "../model/value/mod.sev"

class Builder:
    module: universal.Module
    bindings: map[universal.BindingId, universal.ValueId]
    function_ids: map[universal.DefId, universal.FunctionId]

    def value(type_id: universal.TypeId) -> universal.ValueId:
        id = universal.ValueId(u32(len(module.values)))
        module.values.append(universal.Value(id, type_id))
        return id

    def expression(expression: universal.Expression, block: universal.Block) -> universal.ValueId:
        match expression.kind:
            case LiteralValue:
                result = value(expression.type_id)
                block.operations.append(Constant(value, result))
                return result
            case BindingReference:
                return bindings[binding]
            case Convert:
                return self.expression(operand, block)
            case Unary:
                operand_value = self.expression(operand, block)
                result = value(expression.type_id)
                block.operations.append(Unary(operator, operand_value, result))
                return result
            case Binary:
                left_value = self.expression(left, block)
                right_value = self.expression(right, block)
                result = value(expression.type_id)
                block.operations.append(Binary(operator, left_value, right_value, result))
                return result
            case ResolvedCall:
                arguments_values: list[universal.ValueId] = []
                for argument in arguments:
                    arguments_values.append(self.expression(argument.value, block))
                result = value(expression.type_id)
                match callee:
                    case Direct:
                        block.operations.append(Call(function_ids[function], arguments_values, result))
                return result
            case FunctionReference:
                return value(expression.type_id)

    def binding(binding: universal.Binding, block: universal.Block):
        result = expression(binding.value, block)
        bindings[binding.id] = result
        module.binding_values.append((binding.id, result))

    def statement(statement: universal.Statement, hir_module: universal.Module, block: universal.Block):
        match statement:
            case BindingStatement:
                self.binding(binding, block)
            case ExpressionStatement:
                self.expression(expression, block)
            case Return:
                result: universal.ValueId | None = None
                if value != None:
                    result = self.expression(value, block)
                block.operations.append(Return(result))
            case Assert:
                condition_value = self.expression(condition, block)
                message_value: universal.ValueId | None = None
                if message != None:
                    message_value = self.expression(message, block)
                origin = universal.AssertionOrigin(span.start, condition_span.start, condition_span.end, None)
                block.operations.append(Assert(condition_value, message_value, origin))
            case If:
                condition_value = self.expression(condition, block)
                then_mir = universal.empty_block()
                else_mir = universal.empty_block()
                for nested in then_block.statements:
                    statement(nested, hir_module, then_mir)
                for nested in else_block.statements:
                    statement(nested, hir_module, else_mir)
                block.operations.append(If(condition_value, then_mir, else_mir))
            case Match:
                subject_value = self.expression(subject, block)
                mir_arms: list[universal.MatchArm] = []
                for arm in arms:
                    arm_body = universal.empty_block()
                    for nested in arm.body.statements:
                        statement(nested, hir_module, arm_body)
                    mir_arms.append(universal.MatchArm(arm_body, type_id = arm.type_id))
                block.operations.append(Match(subject_value, mir_arms))


def cfg_from_hir(body: universal.Block, hir_module: universal.Module, result_type: universal.TypeId, parameters: list[universal.FunctionParameter]) -> universal.CfgBody:
    cfg = universal.CfgBody(universal.BlockId(0), [universal.BasicBlock(universal.BlockId(0), [], [], Unreachable)], [], result_type)
    bindings: map[universal.BindingId, universal.Place] = {}
    for parameter in parameters:
        local = universal.LocalId(u32(len(cfg.locals)))
        cfg.locals.append(universal.LocalDecl(local, parameter.type_id, false, true))
        cfg.blocks[0].parameters.append(local)
        bindings[parameter.binding] = universal.local_place(local)
    for statement in body.statements:
        match statement:
            case Return:
                if value == None:
                    cfg.blocks[0].terminator = universal.Terminator.Return(None)
                else:
                    local = universal.LocalId(u32(len(cfg.locals)))
                    cfg.locals.append(universal.LocalDecl(local, value.type_id, false, false))
                    cfg.blocks[0].statements.append(StorageLive(local))
                    cfg.blocks[0].terminator = universal.Terminator.Return(Move(universal.local_place(local)))
            case BindingStatement:
                local = universal.LocalId(u32(len(cfg.locals)))
                cfg.locals.append(universal.LocalDecl(local, binding.type_id, true, false))
                cfg.blocks[0].statements.append(StorageLive(local))
                bindings[binding.id] = universal.local_place(local)
    if cfg.blocks[0].terminator == Unreachable:
        cfg.blocks[0].terminator = universal.Terminator.Return(None)
    return cfg


def build(program: universal.Program) -> universal.Module:
    function_ids: map[universal.DefId, universal.FunctionId] = {}
    for hir_module in program.modules:
        for function in hir_module.functions:
            function_ids[function.definition] = function.id
    for hir_module in program.modules:
        builder = Builder(hir_module, {}, function_ids)
        hir_module.values = []
        hir_module.binding_values = []
        for function in hir_module.functions:
            parameters: list[universal.ValueId] = []
            for parameter in function.parameters:
                parameters.append(builder.value(parameter.type_id))
            function.values = parameters
            if function.body != None:
                function.cfg = cfg_from_hir(function.body, hir_module, function.result_type, function.parameters)

        for statement in hir_module.initializer.statements:
            builder.statement(statement, hir_module, hir_module.initializer)
        hir_module.globals = []
        for pair in hir_module.binding_values:
            hir_module.globals.append(pair[1])
        hir_module.initializer_cfg = cfg_from_hir(hir_module.initializer, hir_module, universal.TypeId(0), [])

        global_bindings = builder.bindings.copy()
        index = 0
        for function in hir_module.functions:
            if function.body != None:
                builder.bindings = global_bindings.copy()
                for statement in function.body.statements:
                    builder.statement(statement, hir_module, function.body)
            index += 1
    return program.modules[-1]
