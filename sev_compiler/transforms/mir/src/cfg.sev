import * from "../../../frontend/ownership/src/cfg.sev" as ownership_cfg
import * from "../../../universal/cfg/availability.sev" as availability
import * from "../../../universal/cfg/dominance.sev" as graph
import * from "../../../universal/cfg/cfg.sev"
import universal
import * from "../../../universal/type/storage.sev" as storage_types
import source
import diagnostics


def origin(module: universal.Module, name: string, span: source.Span) -> universal.CfgTerminator:
    for definition in module.traits:
        if definition.grammar and definition.name == name:
            return universal.CfgTerminator(universal.CfgExit.Dead, definition.definition, span)
    throw Error("missing source grammar contract " + name)


def successors(exit: universal.CfgExit) -> list[universal.CfgEdge]:
    match exit:
        case Jump:
            return [edge]
        case Conditional:
            return [taken, otherwise]
        case _:
            return []


def finish(module: universal.Module, context: ExecutionContext, span: source.Span, parameters: list[universal.ValueId] = []) -> bool | diagnostics.Diagnostic:
    origin = origin(module, "Return", span)
    if open(context):
        terminate(context, universal.CfgExit.Finish(None) if context.body.return_type.index == 2 else universal.CfgExit.Dead, origin)
    verify(module, context.body)
    prune_unreachable(context.body)
    verify_availability(context.body, parameters)
    promote_storage(module, context.body)
    return verify(module, context.body)


def verify(module: universal.Module, body: universal.CfgBody) -> bool | diagnostics.Diagnostic:
    if body.entry < 0 or body.entry >= len(body.blocks):
        return error(diagnostics.Diagnostic("E000230", "CFG entry block does not exist", None))
    block_index := 0
    for selected in body.blocks:
        if selected.id != block_index:
            return error(diagnostics.Diagnostic("E000230", "CFG block identity mismatch", None))
        block_index += 1
        terminator ?= selected.terminator
        if terminator == None:
            return error(diagnostics.Diagnostic("E000230", "CFG block requires exactly one terminator", None))
        if terminator != None:
            resolved := false
            for definition in module.traits:
                if definition.grammar and definition.definition.module == terminator.grammar.module and definition.definition.declaration.value == terminator.grammar.declaration.value:
                    resolved = true
            if not resolved:
                return error(diagnostics.Diagnostic("E000230", "CFG edge requires resolved grammar provenance", terminator.span))
            match terminator.exit:
                case Conditional:
                    if module.values[condition.index].type_id.index != 1:
                        return error(diagnostics.Diagnostic("E000230", "CFG branch requires bool", terminator.span))
                case Raise:
                    type_id = module.values[value.index].type_id
                    valid := false
                    for record in module.records:
                        if record.type_id.index == type_id.index and len(universal.outcome_variants(record)) != 0:
                            valid = true
                    if not valid:
                        return error(diagnostics.Diagnostic("E000230", "CFG raise requires a typed outcome", terminator.span))
                    if body.return_type.index != 2 and body.return_type.index != type_id.index:
                        return error(diagnostics.Diagnostic("E000230", "CFG error outcome does not match function boundary", terminator.span))
                case FinishFields:
                    expected = storage_types.value_fields(body.return_type, module.records)
                    if len(values) != len(expected):
                        return error(diagnostics.Diagnostic("E000230", "CFG return field count mismatch", terminator.span))
                    position := 0
                    for returned in values:
                        if module.values[returned.index].type_id.index != expected[position].index:
                            return error(diagnostics.Diagnostic("E000230", "CFG return field type mismatch", terminator.span))
                        position += 1
                case Finish:
                    returned ?= value
                    if returned != None:
                        if module.values[returned.index].type_id.index != body.return_type.index:
                            return error(diagnostics.Diagnostic("E000230", "CFG return type mismatch", terminator.span))
                    elif body.return_type.index != 2:
                        return error(diagnostics.Diagnostic("E000230", "CFG return requires a value", terminator.span))
                case _:
                    pass
            for edge in successors(terminator.exit):
                if edge.target < 0 or edge.target >= len(body.blocks):
                    return error(diagnostics.Diagnostic("E000230", "CFG successor does not exist", terminator.span))
                parameters = body.blocks[edge.target].parameters
                if len(parameters) != len(edge.arguments):
                    return error(diagnostics.Diagnostic("E000230", "CFG successor argument count mismatch", terminator.span))
                index := 0
                for argument in edge.arguments:
                    if module.values[argument.index].type_id.index != module.values[parameters[index].index].type_id.index:
                        return error(diagnostics.Diagnostic("E000230", "CFG successor argument type mismatch", terminator.span))
                    index += 1
    return true



def value(module: universal.Module, type_id: universal.TypeId) -> universal.ValueId:
    id = universal.ValueId(u32(len(module.values)))
    module.values.append(universal.Value(id, type_id))
    return id


def simplify_storage(module: universal.Module, body: universal.CfgBody):
    slots: list[universal.ValueId] = []
    counts: list[int] = []
    initialized: list[universal.ValueId] = []
    definitions: list[int] = []
    positions: list[int] = []
    direct: list[bool] = []
    for block in body.blocks:
        for operation in block.operations:
            match operation:
                case Allocate:
                    if type_id.index == 3 or storage_types.buffer_element(type_id, module.records).index != 0:
                        slots.append(result)
                        counts.append(0)
                        initialized.append(result)
                        definitions.append(-1)
                        positions.append(-1)
                        direct.append(true)
                case _:
                    pass
    for block in body.blocks:
        position := 0
        for operation in block.operations:
            match operation:
                case Store:
                    index := 0
                    for slot in slots:
                        if slot.index == address.index:
                            counts[index] += 1
                            initialized[index] = value
                            definitions[index] = block.id
                            positions[index] = position
                        index += 1
                case _:
                    pass
            position += 1
    parents = dominators(body)
    for block in body.blocks:
        position := 0
        for operation in block.operations:
            match operation:
                case Load:
                    index := 0
                    for slot in slots:
                        if slot.index == address.index:
                            if counts[index] != 1 or not graph.contains(parents, definitions[index], block.id):
                                direct[index] = false
                            elif definitions[index] == block.id and positions[index] >= position:
                                direct[index] = false
                        index += 1
                case Store:
                    pass
                case _:
                    for input in operation_inputs(operation):
                        index := 0
                        for slot in slots:
                            if slot.index == input.index:
                                direct[index] = false
                            index += 1
            position += 1
    for block in body.blocks:
        body.blocks[block.id] = simplify_storage_block(block, slots, initialized, direct)


def simplify_storage_block(block: universal.BasicBlock, slots: list[universal.ValueId], initialized: list[universal.ValueId], direct: list[bool]) -> universal.BasicBlock:
    operations: list[universal.Operation] = []
    for operation in block.operations:
        retained := true
        match operation:
            case Allocate:
                index := 0
                for slot in slots:
                    if slot.index == result.index and direct[index]:
                        retained = false
                    index += 1
            case Store:
                index := 0
                for slot in slots:
                    if slot.index == address.index and direct[index]:
                        retained = false
                    index += 1
            case Load:
                index := 0
                for slot in slots:
                    if slot.index == address.index and direct[index]:
                        operations.append(universal.Operation.Alias(initialized[index], result))
                        retained = false
                    index += 1
            case _:
                pass
        if retained:
            operations.append(operation)
    block.operations = operations
    return block


def promote_storage(module: universal.Module, body: universal.CfgBody):
    simplify_storage(module, body)
    slots: list[universal.ValueId] = []
    initial: list[universal.ValueId] = []
    prefix: list[universal.Operation] = []
    for selected in body.blocks:
        for operation in selected.operations:
            match operation:
                case Allocate:
                    if type_id.index == 3 or storage_types.buffer_element(type_id, module.records).index != 0:
                        slots.append(result)
                        empty = value(module, type_id)
                        initial.append(empty)
                        prefix.append(universal.Operation.Constant(universal.StringValue("") if type_id.index == 3 else universal.NoneValue(), empty))
                    else:
                        prefix.append(operation)
                case _:
                    pass
    for selected in body.blocks:
        body.blocks[selected.id] = promote_storage_block(module, selected, body.entry, slots, initial, prefix)


def promote_storage_block(module: universal.Module, selected: universal.BasicBlock, entry: int, slots: list[universal.ValueId], initial: list[universal.ValueId], prefix: list[universal.Operation]) -> universal.BasicBlock:
    current := initial[:]
    if selected.id != entry:
        current = []
        for slot in slots:
            parameter = value(module, module.values[initial[len(current)].index].type_id)
            selected.parameters.append(parameter)
            current.append(parameter)
    operations: list[universal.Operation] := []
    if selected.id == entry:
        operations = prefix[:]
    for operation in selected.operations:
        retained := true
        match operation:
            case Allocate:
                retained = false
            case Load:
                index := 0
                for slot in slots:
                    if slot.index == address.index:
                        operations.append(universal.Operation.Alias(current[index], result))
                        retained = false
                    index += 1
            case Store:
                index := 0
                for slot in slots:
                    if slot.index == address.index:
                        current[index] = value
                        retained = false
                    index += 1
            case _:
                pass
        if retained:
            operations.append(operation)
    selected.operations = operations
    terminal ?= selected.terminator
    if terminal != None:
        for edge in successors(terminal.exit):
            for item in current:
                edge.arguments.append(item)
    return selected


def operation_inputs(operation: universal.Operation) -> list[universal.ValueId]:
    return ownership_cfg.operation_inputs(operation)


def operation_results(operation: universal.Operation) -> list[universal.ValueId]:
    return ownership_cfg.operation_results(operation)


def reachable_blocks(body: universal.CfgBody) -> list[int]:
    return ownership_cfg.reachable_blocks(body)


def dominators(body: universal.CfgBody) -> list[int]:
    return ownership_cfg.dominators(body)


def verify_inputs(values: list[universal.ValueId], available: list[int], span: source.Span) -> bool | diagnostics.Diagnostic:
    return ownership_cfg.verify_inputs(values, available, span)


def verify_ssa_inputs(values: list[universal.ValueId], definitions: availability.Definitions, parents: list[int], block: int, position: int, span: source.Span) -> bool | diagnostics.Diagnostic:
    return ownership_cfg.verify_ssa_inputs(values, definitions, parents, block, position, span)


def verify_availability(body: universal.CfgBody, parameters: list[universal.ValueId]) -> bool | diagnostics.Diagnostic:
    return ownership_cfg.verify_availability(body, parameters)


def prune_unreachable(body: universal.CfgBody):
    constants: list[int] = []
    booleans: list[bool] = []
    for block in body.blocks:
        for operation in block.operations:
            match operation:
                case Constant:
                    match value:
                        case BooleanValue:
                            constants.append(int(result.index))
                            booleans.append(value)
                        case _:
                            pass
                case _:
                    pass
    for block in body.blocks:
        terminal ?= block.terminator
        if terminal != None:
            match terminal.exit:
                case Conditional:
                    index := 0
                    for constant in constants:
                        if constant == int(condition.index):
                            edge = taken if booleans[index] else otherwise
                            block.terminator = universal.CfgTerminator(universal.CfgExit.Jump(edge), terminal.grammar, terminal.span)
                            body.blocks[block.id] = block
                        index += 1
                case _:
                    pass
    reachable = [body.entry]
    cursor := 0
    while cursor < len(reachable):
        terminal ?= body.blocks[reachable[cursor]].terminator
        if terminal != None:
            for edge in successors(terminal.exit):
                if edge.target not in reachable:
                    reachable.append(edge.target)
        cursor += 1
    mapping: list[int] = []
    next := 0
    for block in body.blocks:
        mapping.append(next if block.id in reachable else -1)
        if block.id in reachable:
            next += 1
    retained: list[universal.BasicBlock] = []
    for block in body.blocks:
        if block.id not in reachable:
            continue
        terminal ?= block.terminator
        if terminal != None:
            exit := terminal.exit
            match terminal.exit:
                case Jump:
                    exit = universal.CfgExit.Jump(universal.CfgEdge(mapping[edge.target], edge.arguments))
                case Conditional:
                    left = universal.CfgEdge(mapping[taken.target], taken.arguments)
                    right = universal.CfgEdge(mapping[otherwise.target], otherwise.arguments)
                    exit = universal.CfgExit.Conditional(condition, left, right)
                case _:
                    pass
            block.terminator = universal.CfgTerminator(exit, terminal.grammar, terminal.span)
        block.id = mapping[block.id]
        retained.append(block)
    body.entry = mapping[body.entry]
    body.blocks.clear()
    for block in retained:
        body.blocks.append(block)
