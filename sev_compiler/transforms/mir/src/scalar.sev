import universal


def scalar_value(module: universal.Module, type_id: universal.TypeId) -> universal.ValueId:
    id = universal.ValueId(u32(len(module.values)))
    module.values.append(universal.Value(id, type_id))
    return id


def scalar_mir_expression(module: universal.Module, expression: universal.Expression) -> universal.ValueId:
    match expression.kind:
        case LiteralValue:
            result = scalar_value(module, expression.type_id)
            module.initializer.operations.append(universal.Operation.Constant(value, result))
            return result
        case BindingReference:
            return module.globals[binding.index]
        case Unary:
            input = scalar_mir_expression(module, operand)
            result = scalar_value(module, expression.type_id)
            module.initializer.operations.append(universal.Operation.Unary(operator, input, result))
            return result
        case Binary:
            lhs = scalar_mir_expression(module, left)
            rhs = scalar_mir_expression(module, right)
            result = scalar_value(module, expression.type_id)
            module.initializer.operations.append(universal.Operation.Binary(operator, lhs, rhs, result))
            return result
        case _:
            throw Error("scalar semantic analysis admitted an unresolved expression")


def build_scalar(module: universal.Module) -> universal.Module:
    for statement in module.initializer.statements:
        match statement:
            case BindingStatement:
                value = scalar_mir_expression(module, binding.value)
                module.globals.append(value)
            case Assert:
                value = scalar_mir_expression(module, condition)
                origin = universal.AssertionOrigin(span.start, condition_span.start, condition_span.end, None)
                module.initializer.operations.append(universal.Operation.Assert(value, None, origin))
            case _:
                throw Error("scalar semantic analysis admitted an unsupported statement")
    return module
