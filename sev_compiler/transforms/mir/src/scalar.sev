import universal


class ScalarMirScope:
    bindings: list[universal.ValueId] = []


def scalar_value(module: universal.Module, type_id: universal.TypeId) -> universal.ValueId:
    id = universal.ValueId(u32(len(module.values)))
    module.values.append(universal.Value(id, type_id))
    return id


def scalar_mir_expression(module: universal.Module, block: universal.Block, scope: ScalarMirScope, expression: universal.Expression) -> universal.ValueId:
    match expression.kind:
        case LiteralValue:
            result = scalar_value(module, expression.type_id)
            block.operations.append(universal.Operation.Constant(value, result))
            return result
        case BindingReference:
            return scope.bindings[binding.index]
        case TypeName:
            scalar_mir_expression(module, block, scope, value)
            result = scalar_value(module, expression.type_id)
            block.operations.append(universal.Operation.Constant(universal.StringValue(name), result))
            return result
        case Unary:
            input = scalar_mir_expression(module, block, scope, operand)
            if operator.symbol == "+":
                return input
            result = scalar_value(module, expression.type_id)
            block.operations.append(universal.Operation.Unary(operator, input, result))
            return result
        case Binary:
            lhs = scalar_mir_expression(module, block, scope, left)
            rhs = scalar_mir_expression(module, block, scope, right)
            result = scalar_value(module, expression.type_id)
            block.operations.append(universal.Operation.Binary(operator, lhs, rhs, result))
            return result
        case Conditional:
            test = scalar_mir_expression(module, block, scope, condition)
            then_block = universal.empty_block()
            then_result = scalar_mir_expression(module, then_block, scope, then_value)
            then_block.operations.append(universal.Operation.Return(then_result))
            else_block = universal.empty_block()
            else_result = scalar_mir_expression(module, else_block, scope, else_value)
            else_block.operations.append(universal.Operation.Return(else_result))
            result = scalar_value(module, expression.type_id)
            block.operations.append(universal.Operation.Choose(test, then_block, else_block, result))
            return result
        case ResolvedCall:
            match callee:
                case Direct:
                    evaluated: list[universal.ValueId] = []
                    for argument in arguments:
                        evaluated.append(scalar_mir_expression(module, block, scope, argument.value))
                    inputs: list[universal.ValueId] = []
                    for declaration in module.functions:
                        if declaration.id.value == function.declaration.value:
                            parameter_index := 0
                            for parameter in declaration.parameters:
                                argument_index := 0
                                for argument in arguments:
                                    if argument.name == parameter.name or (argument.name == None and parameter_index == argument_index):
                                        inputs.append(evaluated[argument_index])
                                    argument_index += 1
                                parameter_index += 1
                    result = scalar_value(module, expression.type_id)
                    block.operations.append(universal.Operation.Call(universal.FunctionId(function.declaration.value), inputs, result))
                    return result
                case _:
                    pass
        case _:
            pass
    throw Error("scalar semantic analysis admitted an unresolved expression")


def scalar_mir_block(module: universal.Module, block: universal.Block, scope: ScalarMirScope) -> universal.Block:
    for statement in block.statements:
        match statement:
            case BindingStatement:
                value = scalar_mir_expression(module, block, scope, binding.value)
                if binding.update:
                    scope.bindings[binding.id.index] = value
                else:
                    scope.bindings.append(value)
            case ExpressionStatement:
                scalar_mir_expression(module, block, scope, expression)
            case Assert:
                value = scalar_mir_expression(module, block, scope, condition)
                origin = universal.AssertionOrigin(span.start, condition_span.start, condition_span.end, None)
                block.operations.append(universal.Operation.Assert(value, None, origin))
            case Return:
                returned: universal.ValueId | None := None
                expression_value ?= value
                if expression_value != None:
                    returned = scalar_mir_expression(module, block, scope, expression_value)
                block.operations.append(universal.Operation.Return(returned))
            case If:
                value = scalar_mir_expression(module, block, scope, condition)
                then_mir = scalar_mir_block(module, then_block, ScalarMirScope(scope.bindings[:]))
                else_mir = scalar_mir_block(module, else_block, ScalarMirScope(scope.bindings[:]))
                block.operations.append(universal.Operation.If(value, then_mir, else_mir))
            case _:
                throw Error("scalar semantic analysis admitted an unsupported statement")
    return block


def build_scalar(module: universal.Module) -> universal.Module:
    scope = ScalarMirScope()
    module.initializer = scalar_mir_block(module, module.initializer, scope)
    module.globals = scope.bindings
    functions: list[universal.FunctionDeclaration] = []
    for function in module.functions:
        local = ScalarMirScope()
        for type_id in function.parameter_types:
            parameter_value = scalar_value(module, type_id)
            local.bindings.append(parameter_value)
            function.values.append(parameter_value)
        body ?= function.body
        if body != None:
            function.body = scalar_mir_block(module, body, local)
        functions.append(function)
    module.functions = functions
    return module
