import artifact
import universal


enum Operation:
    Coverage(key: string)
    ConstantValue(value: universal.Constant, result: universal.ValueId)
    Unary(operator: universal.UnaryOperation, operand: universal.ValueId, result: universal.ValueId)
    Binary(operator: universal.BinaryOperation, left: universal.ValueId, right: universal.ValueId, result: universal.ValueId)
    Call(function: universal.FunctionId, arguments: list[universal.ValueId], result: universal.ValueId)
    RuntimeCall(symbol: string, arguments: list[universal.ValueId], result: universal.ValueId | None)
    Return(value: universal.ValueId | None)
    Assert(condition: universal.ValueId, message: universal.ValueId | None, location: universal.AssertionLocation | None)
    If(condition: universal.ValueId, then_block: Block, else_block: Block)
    ArtifactCall(artifact_id: artifact.ArtifactId, inputs: list[universal.ValueId], outputs: list[universal.ValueId])


class Block:
    operations: list[Operation]


class Function:
    id: universal.FunctionId
    name: string
    parameters: list[universal.ValueId]
    result: universal.LoweredType
    body: Block | None
    linkage: universal.FunctionLinkage


class Module:
    values: list[universal.Value]
    globals: list[universal.ValueId]
    initializer: Block
    functions: list[Function]
    entry: universal.FunctionId | None


def empty_module() -> Module:
    return Module([], [], Block([]), [], None)
