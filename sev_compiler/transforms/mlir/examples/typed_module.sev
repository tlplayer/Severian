# This scenario needs the typed model, builder, and validator. The validator's
# imports provide that slice without also compiling the independent text view.
import "../src/ir/validate.sev"


# This is executable compiler-source corpus, not documentation pseudocode.
# It constructs a module as objects, validates those objects, and leaves text
# printing as an optional final inspection step.
test "construct a typed add module without assembling MLIR text":
    builder = MlirOpBuilder(0)
    left = builder_value(builder, 0, integer_type(32))
    right = builder_value(builder, 1, integer_type(32))
    function = builder_create_function(
        builder,
        "add",
        public_visibility(),
        [left, right],
        [integer_type(32)],
    )
    builder_set_insertion_point(builder, function.entry)
    result = builder_new_value(builder, integer_type(32))
    builder_binary(builder, result, operation_name("arith", "addi"), left, right)
    builder_return(builder, [result])

    validate(builder.program)
    operation = builder.program.regions[0].blocks[0].operations[0]
    assert(operation.name.dialect == "arith", "dialect identity must remain data")
    assert(operation.name.mnemonic == "addi", "operation identity must remain data")
    assert(operation.results[0].type_id.scalar.bits == 32, "result type must remain typed data")


test "rank and dynamic dimensions are independent values":
    shape: list[int] = [known_dimension(4), dynamic_dimension(), known_dimension(128)]
    tensor = tensor_type(bf16_scalar_type(), shape)
    assert(len(tensor.dimensions) == 3, "rank is the number of dimension records")
    assert(tensor.dimensions[0] == 4, "known dimensions remain concrete")
    assert(tensor.dimensions[1] < 0, "dynamic size does not mean unknown rank")
