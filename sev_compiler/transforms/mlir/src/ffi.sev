@c(repr = "pointer")
type NativeMlirContext

@c(repr = "pointer")
type NativeMlirModule

@c(repr = "pointer")
type NativeMlirOperation

@c(repr = "pointer")
type NativeMlirBlock

@c(repr = "pointer")
type NativeMlirRegion

@c(repr = "pointer")
type NativeMlirType

@c(repr = "pointer")
type NativeMlirAttribute

@c(symbol = "mlirContextCreate")
def native_context_create() -> NativeMlirContext

@c(symbol = "mlirContextDestroy")
def native_context_destroy(context: NativeMlirContext)

@c(symbol = "mlirModuleCreateParse")
def native_module_parse(context: NativeMlirContext, text: borrowed[string]) -> NativeMlirModule

@c(symbol = "mlirModuleDestroy")
def native_module_destroy(module: NativeMlirModule)

@c(symbol = "mlirModuleGetOperation")
def native_module_operation(module: NativeMlirModule) -> NativeMlirOperation

@c(symbol = "mlirOperationVerify")
def native_operation_verify(operation: NativeMlirOperation) -> bool
