import * from "../../../../universal/cfg/availability.sev" as availability
import * from "../../../../universal/cfg/dominance.sev" as graph
import * from "builder.sev"
import * from "model.sev"


enum MlirVerificationError:
    DuplicateFunction(name: string)
    DuplicateValue(value: int)
    DuplicateBlock(block: int)
    DuplicateRegionOwnership(region: int)
    UnownedRegion(region: int)
    MissingRegion(region: int)
    MissingBlock(region: int)
    UndefinedValue(value: int)
    InvalidOperationName(name: string)
    DuplicateAttribute(operation: string, attribute: string)
    DuplicateProperty(operation: string, property: string)
    AttributePropertyCollision(operation: string, name: string)
    MissingSuccessor(operation: string, block: int)
    InvalidRegionContract(operation: string)
    ReturnSignatureMismatch(function: string)
    OperationAfterTerminator(block: int)
    MissingTerminator(region: int)
    WrongTerminator(region: int, expected: string, actual: string)
    InvalidType(description: string)
    InvalidAttribute(description: string)
    InvalidLocation(file: string, line: u32, column: u32)


def validate_location(location: MlirLocation) -> bool | MlirVerificationError:
    if location.file == "" or location.line == 0 or location.column == 0:
        return error(InvalidLocation(location.file, location.line, location.column))
    return true


def validate_type(type_id: MlirType) -> bool | MlirVerificationError:
    for element in type_id.elements:
        validate_type(element)
    kind = type_kind_name(type_id.kind)
    scalar = scalar_kind_name(type_id.scalar.kind)
    if kind == "scalar" and scalar == "integer" and type_id.scalar.bits == 0:
        return error(InvalidType("integer width must be non-zero"))
    if kind == "scalar" and scalar == "ieee_float" and type_id.scalar.bits != 16 and type_id.scalar.bits != 32 and type_id.scalar.bits != 64:
        return error(InvalidType("native IEEE floating width must be 16, 32, or 64"))
    if (kind == "unranked_tensor" or kind == "unranked_memref") and len(type_id.dimensions) != 0:
        return error(InvalidType("unranked types cannot carry ranked dimensions"))
    for dimension in type_id.dimensions:
        if dimension < -1:
            return error(InvalidType("dynamic dimensions use exactly -1"))
    return true


def validate_affine_expression(expression: MlirAffineExpression, dimensions: int, symbols: int) -> bool | MlirVerificationError:
    kind = affine_expression_kind_name(expression.kind)
    if kind == "dimension":
        if expression.position < 0 or expression.position >= dimensions:
            return error(InvalidAttribute("affine dimension is out of range"))
        return true
    if kind == "symbol":
        if expression.position < 0 or expression.position >= symbols:
            return error(InvalidAttribute("affine symbol is out of range"))
        return true
    if kind == "constant":
        return true
    if len(expression.operands) != 2:
        return error(InvalidAttribute("binary affine expressions require two operands"))
    validate_affine_expression(expression.operands[0], dimensions, symbols)
    validate_affine_expression(expression.operands[1], dimensions, symbols)
    return true


def validate_attribute(value: MlirAttributeValue) -> bool | MlirVerificationError:
    kind = attribute_kind_name(value.kind)
    if kind == "dense_integer_array":
        validate_type(value.type_id)
        if not is_integer(value.type_id):
            return error(InvalidAttribute("dense integer arrays require an integer element type"))
        for element in value.elements:
            if attribute_kind_name(element.kind) != "integer" or not same_type(element.type_id, value.type_id):
                return error(InvalidAttribute("dense integer array element type mismatch"))
        return true
    if kind == "dense_integer":
        validate_type(value.type_id)
        if type_kind_name(value.type_id.kind) != "tensor" or len(value.type_id.dimensions) != 1:
            return error(InvalidAttribute("dense integer data requires a ranked vector tensor"))
        if value.type_id.dimensions[0] != int(len(value.elements)):
            return error(InvalidAttribute("dense integer element count does not match its type"))
        for element in value.elements:
            if attribute_kind_name(element.kind) != "integer":
                return error(InvalidAttribute("dense integer data contains a non-integer"))
        return true
    if kind == "float_literal":
        if not is_float(value.type_id) or value.text == "":
            return error(InvalidAttribute("floating literal requires a float type and spelling"))
    if kind == "integer_literal":
        if (not is_integer(value.type_id) and scalar_kind_name(value.type_id.scalar.kind) != "index") or value.text == "":
            return error(InvalidAttribute("integer literal requires an integer type and spelling"))
        spelling := value.text
        if spelling.starts_with("-") or spelling.starts_with("+"):
            spelling = spelling[1:]
        if spelling == "":
            return error(InvalidAttribute("integer literal requires digits"))
        for digit in spelling.bytes():
            if digit < 48 or digit > 57:
                return error(InvalidAttribute("integer literal requires decimal digits"))
    if kind == "integer" or kind == "integer_literal" or kind == "float" or kind == "float_literal" or kind == "type":
        validate_type(value.type_id)
    if kind == "symbol" and value.symbol == "":
        return error(InvalidAttribute("symbol references cannot be empty"))
    if kind == "array":
        for element in value.elements:
            validate_attribute(element)
    if kind == "affine_map":
        if len(value.affine_maps) != 1:
            return error(InvalidAttribute("affine-map attributes require exactly one map"))
        map = value.affine_maps[0]
        if map.dimensions < 0 or map.symbols < 0:
            return error(InvalidAttribute("affine-map arity cannot be negative"))
        for result in map.results:
            validate_affine_expression(result, map.dimensions, map.symbols)
    return true


def copy_values(values: list[int]) -> list[int]:
    copied: list[int] = []
    for value in values:
        copied.append(value)
    return copied


def region_index(program: borrow MlirProgram, id: int) -> int:
    index := 0
    for region in borrow program.regions:
        if region.id == id:
            return index
        index += 1
    return -1


def validate_operation_signature(program: borrow MlirProgram, operation: borrow MlirOperation) -> bool | MlirVerificationError:
    name = operation_name_text(operation.name)
    dialect = operation.name.dialect
    mnemonic = operation.name.mnemonic
    if dialect == "" or mnemonic == "":
        return error(InvalidOperationName(name))
    location ?= operation.location
    if location != None:
        validate_location(location)
    for operand in borrow operation.operands:
        validate_type(operand.type_id)
    for result in borrow operation.results:
        validate_type(result.type_id)
    attribute_names: list[string] = []
    for attribute in operation.attributes:
        if attribute.name == "" or attribute.name in attribute_names:
            return error(DuplicateAttribute(name, attribute.name))
        attribute_names.append(attribute.name)
        validate_attribute(attribute.value)
    property_names: list[string] = []
    for property in operation.properties:
        if property.name == "" or property.name in property_names:
            return error(DuplicateProperty(name, property.name))
        if property.name in attribute_names:
            return error(AttributePropertyCollision(name, property.name))
        property_names.append(property.name)
        validate_attribute(property.value)
    if len(operation.region_requires_terminator) != len(operation.regions):
        return error(InvalidRegionContract(name))
    for successor in operation.successors:
        found := false
        for region in borrow program.regions:
            for block in borrow region.blocks:
                if block.id == successor:
                    found = true
        if not found:
            return error(MissingSuccessor(name, successor))
    return true


def validate_operation(program: borrow MlirProgram, operation: borrow MlirOperation, defined: list[int], owned_regions: list[int]) -> bool | MlirVerificationError:
    for operand in borrow operation.operands:
        if operand.id not in defined:
            return error(UndefinedValue(operand.id))
    validate_operation_signature(program, operation)
    region_index := 0
    for region in operation.regions:
        if region in owned_regions:
            return error(DuplicateRegionOwnership(region))
        owned_regions.append(region)
        validate_region(program, region, copy_values(defined), operation.region_requires_terminator[region_index], owned_regions)
        region_index += 1
    return true


def validate_flat_region(program: borrow MlirProgram, region: borrow MlirRegion, inherited: list[int], requires_terminator: bool, owned_regions: list[int]) -> bool | MlirVerificationError:
    parents = region_dominators(region)
    count := int(len(inherited))
    for block in borrow region.blocks:
        count += int(len(block.arguments))
        for operation in borrow block.operations:
            count += int(len(operation.results))
    definitions = availability.create(count)
    for value in inherited:
        availability.add(definitions, value, -2, -1)
    block_index := 0
    for block in borrow region.blocks:
        for argument in block.arguments:
            if not availability.add(definitions, argument.id, block_index, -1):
                return error(DuplicateValue(argument.id))
        position := 0
        for operation in borrow block.operations:
            for result in borrow operation.results:
                if not availability.add(definitions, result.id, block_index, position):
                    return error(DuplicateValue(result.id))
            position += 1
        block_index += 1
    block_index = 0
    for block in borrow region.blocks:
        terminated := false
        position := 0
        for operation in borrow block.operations:
            if terminated:
                return error(OperationAfterTerminator(block.id))
            known: list[int] = []
            for operand in borrow operation.operands:
                if not availability.usable(definitions, parents, operand.id, block_index, position):
                    return error(UndefinedValue(operand.id))
                known.append(operand.id)
            validate_operation(program, operation, known, owned_regions)
            terminated = operation.terminator
            position += 1
        if requires_terminator and not terminated:
            return error(MissingTerminator(region.id))
        block_index += 1
    return true


def validate_region(program: borrow MlirProgram, region_id: int, inherited: list[int], requires_terminator: bool, owned_regions: list[int]) -> bool | MlirVerificationError:
    index = region_index(program, region_id)
    if index < 0:
        return error(MissingRegion(region_id))
    region = program.regions[index]
    if len(region.blocks) == 0:
        return error(MissingBlock(region_id))
    flat := true
    for block in borrow region.blocks:
        for operation in borrow block.operations:
            if len(operation.regions) != 0:
                flat = false
    if flat:
        return validate_flat_region(program, region, inherited, requires_terminator, owned_regions)
    dominators = region_dominators(region)
    block_index := 0
    for block in borrow region.blocks:
        defined = copy_values(inherited)
        predecessor := dominators[block_index]
        while predecessor >= 0 and predecessor != block_index:
            for argument in region.blocks[predecessor].arguments:
                defined.append(argument.id)
            for operation in region.blocks[predecessor].operations:
                for result in borrow operation.results:
                    defined.append(result.id)
            parent = dominators[predecessor]
            if parent == predecessor:
                break
            predecessor = parent
        block_index += 1
        for argument in block.arguments:
            if argument.id in defined:
                return error(DuplicateValue(argument.id))
            defined.append(argument.id)
        terminated := false
        for operation in borrow block.operations:
            if terminated:
                return error(OperationAfterTerminator(block.id))
            validate_operation(program, operation, defined, owned_regions)
            if operation.terminator:
                terminated = true
            for result in borrow operation.results:
                if result.id in defined:
                    return error(DuplicateValue(result.id))
                defined.append(result.id)
        if requires_terminator and not terminated:
            return error(MissingTerminator(region_id))
    return true


def validate(program: borrow MlirProgram) -> bool | MlirVerificationError:
    names: list[string] = []
    blocks: list[int] = []
    for region in borrow program.regions:
        for block in borrow region.blocks:
            if block.id in blocks:
                return error(DuplicateBlock(block.id))
            blocks.append(block.id)
    for function in borrow program.functions:
        if function.name in names:
            return error(DuplicateFunction(function.name))
        names.append(function.name)
    owned_regions: list[int] = []
    for operation in borrow program.operations:
        validate_operation(program, operation, [], owned_regions)
    for function in borrow program.functions:
        location ?= function.location
        if location != None:
            validate_location(location)
        for argument in function.arguments:
            validate_type(argument.type_id)
        for result in function.result_types:
            validate_type(result)
        if not function.declaration:
            if function.body_region in owned_regions:
                return error(DuplicateRegionOwnership(function.body_region))
            owned_regions.append(function.body_region)
            validate_region(program, function.body_region, [], true, owned_regions)
            region = program.regions[region_index(program, function.body_region)]
            entry = region.blocks[0]
            if len(entry.arguments) != len(function.arguments):
                return error(ReturnSignatureMismatch(function.name))
            for block in borrow region.blocks:
                final_operation = block.operations[int(len(block.operations)) - 1]
                if operation_name_text(final_operation.name) != "func.return":
                    continue
                if len(final_operation.operands) != len(function.result_types):
                    return error(ReturnSignatureMismatch(function.name))
                index := 0
                while index < int(len(final_operation.operands)):
                    if not same_type(final_operation.operands[index].type_id, function.result_types[index]):
                        return error(ReturnSignatureMismatch(function.name))
                    index += 1
    for region in borrow program.regions:
        if region.id not in owned_regions:
            return error(UnownedRegion(region.id))
    return true


def program_is_valid(program: borrow MlirProgram) -> bool:
    outcome ?= validate(program)
    return outcome is bool



def region_dominators(region: borrow MlirRegion) -> list[int]:
    sources: list[int] = []
    targets: list[int] = []
    predecessor := 0
    for block in borrow region.blocks:
        if len(block.operations) != 0:
            for successor in block.operations[-1].successors:
                index := 0
                for candidate in borrow region.blocks:
                    if candidate.id == successor:
                        sources.append(predecessor)
                        targets.append(index)
                        break
                    index += 1
        predecessor += 1
    return graph.tree(int(len(region.blocks)), 0, sources, targets)
