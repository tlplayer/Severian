import "builder.sev"
import "model.sev"


enum MlirVerificationError:
    DuplicateFunction(name: string)
    DuplicateValue(value: int)
    DuplicateBlock(block: int)
    DuplicateRegionOwnership(region: int)
    UnownedRegion(region: int)
    MissingRegion(region: int)
    MissingBlock(region: int)
    UndefinedValue(value: int)
    InvalidOperationName(name: string)
    MissingAttribute(operation: string, attribute: string)
    InvalidArity(operation: string)
    TypeMismatch(operation: string)
    InvalidCondition(operation: string)
    UnknownCallee(callee: string)
    CallSignatureMismatch(callee: string)
    ReturnSignatureMismatch(function: string)
    OperationAfterTerminator(block: int)
    MissingTerminator(region: int)
    WrongTerminator(region: int, expected: string, actual: string)
    InvalidType(description: string)
    InvalidAttribute(description: string)
    InvalidLocation(file: string, line: u32, column: u32)


def validate_location(location: MlirLocation) -> bool | MlirVerificationError:
    if location.file == "" or location.line == 0 or location.column == 0:
        return error(InvalidLocation(location.file, location.line, location.column))
    return true


def validate_type(type_id: MlirType) -> bool | MlirVerificationError:
    kind = type_kind_name(type_id.kind)
    scalar = scalar_kind_name(type_id.scalar.kind)
    if kind == "scalar" and scalar == "integer" and type_id.scalar.bits == 0:
        return error(InvalidType("integer width must be non-zero"))
    if kind == "scalar" and scalar == "ieee_float" and type_id.scalar.bits != 16 and type_id.scalar.bits != 32 and type_id.scalar.bits != 64:
        return error(InvalidType("native IEEE floating width must be 16, 32, or 64"))
    if (kind == "unranked_tensor" or kind == "unranked_memref") and len(type_id.dimensions) != 0:
        return error(InvalidType("unranked types cannot carry ranked dimensions"))
    for dimension in type_id.dimensions:
        if dimension < -1:
            return error(InvalidType("dynamic dimensions use exactly -1"))
    return true


def validate_affine_expression(expression: MlirAffineExpression, dimensions: int, symbols: int) -> bool | MlirVerificationError:
    kind = affine_expression_kind_name(expression.kind)
    if kind == "dimension":
        if expression.position < 0 or expression.position >= dimensions:
            return error(InvalidAttribute("affine dimension is out of range"))
        return true
    if kind == "symbol":
        if expression.position < 0 or expression.position >= symbols:
            return error(InvalidAttribute("affine symbol is out of range"))
        return true
    if kind == "constant":
        return true
    if len(expression.operands) != 2:
        return error(InvalidAttribute("binary affine expressions require two operands"))
    validate_affine_expression(expression.operands[0], dimensions, symbols)
    validate_affine_expression(expression.operands[1], dimensions, symbols)
    return true


def validate_attribute(value: MlirAttributeValue) -> bool | MlirVerificationError:
    kind = attribute_kind_name(value.kind)
    if kind == "integer" or kind == "float" or kind == "type":
        validate_type(value.type_id)
    if kind == "symbol" and value.symbol == "":
        return error(InvalidAttribute("symbol references cannot be empty"))
    if kind == "array":
        for element in value.elements:
            validate_attribute(element)
    if kind == "affine_map":
        if len(value.affine_maps) != 1:
            return error(InvalidAttribute("affine-map attributes require exactly one map"))
        map = value.affine_maps[0]
        if map.dimensions < 0 or map.symbols < 0:
            return error(InvalidAttribute("affine-map arity cannot be negative"))
        for result in map.results:
            validate_affine_expression(result, map.dimensions, map.symbols)
    return true


def has_string_attribute(operation: MlirOperation, name: string) -> bool:
    for attribute in operation.attributes:
        if attribute.name == name and attribute_kind_name(attribute.value.kind) == "string":
            return true
    return false


def has_attribute(operation: MlirOperation, name: string) -> bool:
    for attribute in operation.attributes:
        if attribute.name == name:
            return true
    return false


def required_string_attribute(operation: MlirOperation, name: string) -> string:
    for attribute in operation.attributes:
        if attribute.name == name and attribute_kind_name(attribute.value.kind) == "string":
            return attribute.value.text
    assert(false, "validated MLIR operation is missing a string attribute")
    return ""


def copy_values(values: list[int]) -> list[int]:
    copied: list[int] = []
    for value in values:
        copied.append(value)
    return copied


def region_index(program: MlirProgram, id: int) -> int:
    index := 0
    for region in program.regions:
        if region.id == id:
            return index
        index += 1
    return -1


def function_index_by_name(program: MlirProgram, name: string) -> int:
    index := 0
    for function in program.functions:
        if function.name == name:
            return index
        index += 1
    return -1


def validate_operation_signature(program: MlirProgram, operation: MlirOperation) -> bool | MlirVerificationError:
    name = operation_name_text(operation.name)
    dialect = operation.name.dialect
    mnemonic = operation.name.mnemonic
    if dialect == "" or mnemonic == "":
        return error(InvalidOperationName(name))
    if operation.location != None:
        validate_location(operation.location)
    for operand in operation.operands:
        validate_type(operand.type_id)
    for result in operation.results:
        validate_type(result.type_id)
    for attribute in operation.attributes:
        validate_attribute(attribute.value)
    if name == "arith.constant":
        if len(operation.operands) != 0 or len(operation.results) != 1:
            return error(InvalidArity(name))
        if not has_attribute(operation, "value"):
            return error(MissingAttribute(name, "value"))
    if name == "arith.addi" or name == "arith.addf" or name == "arith.subi" or name == "arith.subf" or name == "arith.muli" or name == "arith.mulf" or name == "arith.divsi" or name == "arith.divui" or name == "arith.divf" or name == "arith.remsi" or name == "arith.remui" or name == "arith.andi" or name == "arith.ori" or name == "arith.xori":
        if len(operation.operands) != 2 or len(operation.results) != 1:
            return error(InvalidArity(name))
        if not same_type(operation.operands[0].type_id, operation.operands[1].type_id) or not same_type(operation.operands[0].type_id, operation.results[0].type_id):
            return error(TypeMismatch(name))
    if name == "arith.cmpi" or name == "arith.cmpf":
        if len(operation.operands) != 2 or len(operation.results) != 1:
            return error(InvalidArity(name))
        if not same_type(operation.operands[0].type_id, operation.operands[1].type_id) or not is_boolean(operation.results[0].type_id):
            return error(TypeMismatch(name))
        if not has_string_attribute(operation, "predicate"):
            return error(MissingAttribute(name, "predicate"))
    if name == "func.call":
        if not has_string_attribute(operation, "callee"):
            return error(MissingAttribute(name, "callee"))
        callee = required_string_attribute(operation, "callee")
        function_index = function_index_by_name(program, callee)
        if function_index < 0:
            return error(UnknownCallee(callee))
        function = program.functions[function_index]
        if len(function.arguments) != len(operation.operands) or len(function.result_types) != len(operation.results):
            return error(CallSignatureMismatch(callee))
        index := 0
        while index < int(len(operation.operands)):
            if not same_type(function.arguments[index].type_id, operation.operands[index].type_id):
                return error(CallSignatureMismatch(callee))
            index += 1
        index = 0
        while index < int(len(operation.results)):
            if not same_type(function.result_types[index], operation.results[index].type_id):
                return error(CallSignatureMismatch(callee))
            index += 1
    if name == "func.return" or name == "scf.yield":
        if len(operation.results) != 0 or not operation.terminator:
            return error(InvalidArity(name))
    if name == "cf.assert":
        if len(operation.operands) != 1 or not is_boolean(operation.operands[0].type_id):
            return error(InvalidCondition(name))
        if not has_string_attribute(operation, "msg"):
            return error(MissingAttribute(name, "msg"))
    if name == "scf.if":
        if len(operation.operands) != 1 or not is_boolean(operation.operands[0].type_id):
            return error(InvalidCondition(name))
        if len(operation.regions) != 2:
            return error(InvalidArity(name))
    return true


def validate_operation(program: MlirProgram, operation: MlirOperation, defined: list[int], owned_regions: list[int]) -> bool | MlirVerificationError:
    for operand in operation.operands:
        if operand.id not in defined:
            return error(UndefinedValue(operand.id))
    validate_operation_signature(program, operation)
    expected = "scf.yield" if operation_name_text(operation.name) == "scf.if" else ""
    for region in operation.regions:
        if region in owned_regions:
            return error(DuplicateRegionOwnership(region))
        owned_regions.append(region)
        validate_region(program, region, copy_values(defined), expected, owned_regions)
    return true


def validate_region(program: MlirProgram, region_id: int, inherited: list[int], expected_terminator: string, owned_regions: list[int]) -> bool | MlirVerificationError:
    index = region_index(program, region_id)
    if index < 0:
        return error(MissingRegion(region_id))
    region = program.regions[index]
    if len(region.blocks) == 0:
        return error(MissingBlock(region_id))
    for block in region.blocks:
        defined = copy_values(inherited)
        for argument in block.arguments:
            if argument.id in defined:
                return error(DuplicateValue(argument.id))
            defined.append(argument.id)
        terminated := false
        actual_terminator := ""
        for operation in block.operations:
            if terminated:
                return error(OperationAfterTerminator(block.id))
            validate_operation(program, operation, defined, owned_regions)
            if operation.terminator:
                terminated = true
                actual_terminator = operation_name_text(operation.name)
            for result in operation.results:
                if result.id in defined:
                    return error(DuplicateValue(result.id))
                defined.append(result.id)
        if expected_terminator != "":
            if not terminated:
                return error(MissingTerminator(region_id))
            if actual_terminator != expected_terminator:
                return error(WrongTerminator(region_id, expected_terminator, actual_terminator))
    return true


def validate(program: MlirProgram) -> bool | MlirVerificationError:
    names: list[string] = []
    blocks: list[int] = []
    for region in program.regions:
        for block in region.blocks:
            if block.id in blocks:
                return error(DuplicateBlock(block.id))
            blocks.append(block.id)
    for function in program.functions:
        if function.name in names:
            return error(DuplicateFunction(function.name))
        names.append(function.name)
    owned_regions: list[int] = []
    for function in program.functions:
        if function.location != None:
            validate_location(function.location)
        for argument in function.arguments:
            validate_type(argument.type_id)
        for result in function.result_types:
            validate_type(result)
        if not function.declaration:
            if function.body_region in owned_regions:
                return error(DuplicateRegionOwnership(function.body_region))
            owned_regions.append(function.body_region)
            validate_region(program, function.body_region, [], "func.return", owned_regions)
            region = program.regions[region_index(program, function.body_region)]
            entry = region.blocks[0]
            if len(entry.arguments) != len(function.arguments):
                return error(ReturnSignatureMismatch(function.name))
            final_operation = entry.operations[int(len(entry.operations)) - 1]
            if len(final_operation.operands) != len(function.result_types):
                return error(ReturnSignatureMismatch(function.name))
            index := 0
            while index < int(len(final_operation.operands)):
                if not same_type(final_operation.operands[index].type_id, function.result_types[index]):
                    return error(ReturnSignatureMismatch(function.name))
                index += 1
    for region in program.regions:
        if region.id not in owned_regions:
            return error(UnownedRegion(region.id))
    return true


def program_is_valid(program: MlirProgram) -> bool:
    outcome ?= validate(program)
    return outcome is bool
