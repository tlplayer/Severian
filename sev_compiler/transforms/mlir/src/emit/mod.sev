import artifact
import target
import universal
import "../ir/lib.sev"


def lowered_type(type_id: universal.LoweredType) -> MlirType | MlirError:
    match type_id:
        case Integer: return integer_type(bits, signed)
        case Float:
            match format:
                case Ieee: return float_type(bits)
                case BrainFloat16: return bf16_type()
        case Boolean: return integer_type(1, false)
        case String: return pointer_type()
        case Bytes: return pointer_type()
        case NoneValue: return integer_type(1, false)
        case Unit: return error(UnsupportedType(type_id))
        case Arguments: return pointer_type()


def value_type(module: universal.Module, value: universal.ValueId) -> universal.LoweredType | MlirError:
    if value.index >= len(module.values):
        return error(InvalidValue(value))
    return module.values[value.index].lowered_type


def mlir_value(builder: MlirOpBuilder, module: universal.Module, value: universal.ValueId) -> MlirValue | MlirError:
    return builder_value(builder, value.index, lowered_type(value_type(module, value)))


def function_identity(module: universal.Module, function: universal.FunctionDeclaration) -> MlirFunctionIdentity:
    specialization: list[string] = []
    for type_id in function.parameter_types:
        specialization.append(string(type_id.index))
    specialization.append("result=" + string(function.result_type.index))
    return MlirFunctionIdentity(
        string(module.package.index),
        string(module.id.value),
        function.name + "@" + string(function.id.value),
        specialization,
        0,
    )


def function_symbol(module: universal.Module, function: universal.FunctionDeclaration) -> string:
    match function.linkage:
        case External: return symbol
        case Internal: return generated_mlir_function_name(function_identity(module, function)).value


def function_results(result: universal.LoweredType) -> list[MlirType] | MlirError:
    match result:
        case Unit: return []
        case _: return [lowered_type(result)]


def constant_attribute(value: universal.Constant, type_id: universal.LoweredType, lowered: MlirType) -> MlirAttributeValue | MlirError:
    match value:
        case Integer: return integer_attribute(int(value), lowered)
        case Float: return float_attribute(f64(value), lowered)
        case Boolean: return boolean_attribute(value)
        case NoneValue: return boolean_attribute(false)
        case Unit: return error(UnsupportedType(type_id))
        case _: return error(UnsupportedOperation("aggregate constants require typed global operations"))


def function_index(program: MlirProgram, name: string) -> int | None:
    index := 0
    for function in program.functions:
        if function.name == name:
            return index
        index += 1
    return None


def ensure_declaration(builder: MlirOpBuilder, name: string, arguments: list[MlirValue], results: list[MlirValue]) -> unit | MlirBuilderError:
    known = function_index(builder.program, name)
    if known != None:
        return unit
    result_types: list[MlirType] = []
    for result in results:
        result_types.append(result.type_id)
    builder_create_function(builder, name, private_visibility(), arguments, result_types, true)
    return unit


def comparison_predicate(operator: universal.BinaryOperation, signed: bool, floating: bool = false) -> string | MlirError:
    match operator:
        case Equal: return "oeq" if floating else "eq"
        case NotEqual: return "une" if floating else "ne"
        case Less: return "olt" if floating else ("slt" if signed else "ult")
        case LessEqual: return "ole" if floating else ("sle" if signed else "ule")
        case Greater: return "ogt" if floating else ("sgt" if signed else "ugt")
        case GreaterEqual: return "oge" if floating else ("sge" if signed else "uge")
        case _: return error(UnsupportedOperation("operator is not a comparison"))


def binary_operation_name(operator: universal.BinaryOperation, type_id: MlirType) -> MlirOperationName | MlirError:
    floating = is_float(type_id)
    signed = type_id.scalar.signed
    match operator:
        case Add: return operation_name("arith", "addf" if floating else "addi")
        case Subtract: return operation_name("arith", "subf" if floating else "subi")
        case Multiply: return operation_name("arith", "mulf" if floating else "muli")
        case Divide:
            if floating:
                return operation_name("arith", "divf")
            return operation_name("arith", "divsi" if signed else "divui")
        case Remainder: return operation_name("arith", "remsi" if signed else "remui")
        case And: return operation_name("arith", "andi")
        case Or: return operation_name("arith", "ori")
        case Equal: return operation_name("arith", "cmpf" if floating else "cmpi")
        case NotEqual: return operation_name("arith", "cmpf" if floating else "cmpi")
        case Less: return operation_name("arith", "cmpf" if floating else "cmpi")
        case LessEqual: return operation_name("arith", "cmpf" if floating else "cmpi")
        case Greater: return operation_name("arith", "cmpf" if floating else "cmpi")
        case GreaterEqual: return operation_name("arith", "cmpf" if floating else "cmpi")
        case Power: return error(UnsupportedOperation("power requires math.pow lowering"))
        case Contains: return error(UnsupportedOperation("containment requires a collection operation"))


def binary_attributes(operator: universal.BinaryOperation, type_id: MlirType) -> list[MlirNamedAttribute] | MlirError:
    name = operation_name_text(binary_operation_name(operator, type_id))
    if name == "arith.cmpi" or name == "arith.cmpf":
        predicate = comparison_predicate(operator, type_id.scalar.signed, is_float(type_id))
        return [MlirNamedAttribute("predicate", string_attribute_value(predicate))]
    return []


def lower_unary(builder: MlirOpBuilder, module: universal.Module, operator: universal.UnaryOperation, operand_id: universal.ValueId, result_id: universal.ValueId) -> unit | MlirError | MlirBuilderError:
    operand = mlir_value(builder, module, operand_id)
    result = mlir_value(builder, module, result_id)
    if operator == universal.Not:
        one = builder_new_value(builder, integer_type(1, false))
        builder_constant(builder, one, boolean_attribute(true))
        builder_binary(builder, result, operation_name("arith", "xori"), operand, one)
        return unit
    zero = builder_new_value(builder, operand.type_id)
    if is_float(operand.type_id):
        builder_constant(builder, zero, float_attribute(0.0, operand.type_id))
    else:
        builder_constant(builder, zero, integer_attribute(0, operand.type_id))
    if operator == universal.Positive:
        builder_binary(builder, result, operation_name("arith", "addf" if is_float(operand.type_id) else "addi"), operand, zero)
    else:
        builder_binary(builder, result, operation_name("arith", "subf" if is_float(operand.type_id) else "subi"), zero, operand)
    return unit


def lower_block(builder: MlirOpBuilder, module: universal.Module, block: universal.Block) -> unit | MlirError | MlirBuilderError:
    for operation in block.lowered_operations:
        match operation:
            case LoweredCoverage:
                ensure_declaration(builder, "__sev_coverage_hit", [], [])
                builder_call(builder, "__sev_coverage_hit", [], [])
            case ConstantValue:
                result_value = mlir_value(builder, module, result)
                builder_constant(builder, result_value, constant_attribute(value, value_type(module, result), result_value.type_id))
            case LoweredUnary:
                lower_unary(builder, module, operator, operand, result)
            case LoweredBinary:
                left_value = mlir_value(builder, module, left)
                right_value = mlir_value(builder, module, right)
                result_value = mlir_value(builder, module, result)
                builder_binary(builder, result_value, binary_operation_name(operator, left_value.type_id), left_value, right_value, binary_attributes(operator, left_value.type_id))
            case LoweredCall:
                arguments_values: list[MlirValue] = []
                for argument in arguments:
                    arguments_values.append(mlir_value(builder, module, argument))
                result_values: list[MlirValue] = []
                match value_type(module, result):
                    case Unit:
                        pass
                    case _:
                        result_values.append(mlir_value(builder, module, result))
                target_name := ""
                for function_declaration in module.functions:
                    if function_declaration.id == function:
                        target_name = function_symbol(module, function_declaration)
                if target_name == "":
                    return error(UnsupportedOperation("call references an unknown function"))
                builder_call(builder, target_name, arguments_values, result_values)
            case RuntimeCall:
                arguments_values: list[MlirValue] = []
                for argument in arguments:
                    arguments_values.append(mlir_value(builder, module, argument))
                result_values: list[MlirValue] = []
                if result != None:
                    result_values.append(mlir_value(builder, module, result))
                ensure_declaration(builder, symbol, arguments_values, result_values)
                builder_call(builder, symbol, arguments_values, result_values)
            case LoweredReturn:
                values: list[MlirValue] = []
                if value != None:
                    values.append(mlir_value(builder, module, value))
                builder_return(builder, values)
            case LoweredAssert:
                builder_assert(builder, mlir_value(builder, module, condition), "assertion failed")
            case LoweredIf:
                saved = builder.insertion[0]
                then_region = builder_create_region(builder)
                then_entry = builder_create_block(builder, then_region)
                builder_set_insertion_point(builder, then_entry)
                lower_block(builder, module, then_block)
                builder_yield(builder)
                else_region = builder_create_region(builder)
                else_entry = builder_create_block(builder, else_region)
                builder_set_insertion_point(builder, else_entry)
                lower_block(builder, module, else_block)
                builder_yield(builder)
                builder_set_insertion_point(builder, saved)
                builder_if(builder, mlir_value(builder, module, condition), then_region, else_region)
            case ArtifactCall:
                arguments_values: list[MlirValue] = []
                for input in inputs:
                    arguments_values.append(mlir_value(builder, module, input))
                result_values: list[MlirValue] = []
                for output in outputs:
                    result_values.append(mlir_value(builder, module, output))
                name = "__sev_artifact_" + string(artifact_id.index)
                ensure_declaration(builder, name, arguments_values, result_values)
                builder_call(builder, name, arguments_values, result_values)
    return unit


def create_function(builder: MlirOpBuilder, module: universal.Module, function: universal.FunctionDeclaration) -> MlirFunctionHandle | MlirError | MlirBuilderError:
    arguments: list[MlirValue] = []
    for parameter in function.values:
        arguments.append(mlir_value(builder, module, parameter))
    declaration = function.body == None
    match function.linkage:
        case External:
            return builder_create_function(builder, symbol, private_visibility(), arguments, function_results(function.lowered_result), declaration)
        case Internal:
            return builder_create_generated_function(
                builder,
                function_identity(module, function),
                private_visibility(),
                arguments,
                function_results(function.lowered_result),
                declaration,
            )


def lower(module: universal.Module) -> MlirProgram | MlirError | MlirBuilderError | MlirVerificationError:
    builder = MlirOpBuilder(int(len(module.values)))
    handles: list[MlirFunctionHandle] = []
    for function in module.functions:
        handles.append(create_function(builder, module, function))
    index := 0
    for function in module.functions:
        if function.body != None:
            builder_set_insertion_point(builder, handles[index].entry)
            lower_block(builder, module, function.body)
        index += 1

    main = builder_create_function(builder, "main", public_visibility(), [], [integer_type(32)], false)
    builder_set_insertion_point(builder, main.entry)
    lower_block(builder, module, module.initializer)
    if module.entry != None:
        entry_name := ""
        for function in module.functions:
            if function.id == module.entry:
                entry_name = function_symbol(module, function)
        if entry_name == "":
            return error(UnsupportedOperation("entry references an unknown function"))
        builder_call(builder, entry_name, [], [])
    exit_value = builder_new_value(builder, integer_type(32))
    builder_constant(builder, exit_value, integer_attribute(0, exit_value.type_id))
    builder_return(builder, [exit_value])
    validate(builder.program)
    return builder.program


def render(module: universal.Module) -> string | MlirError | MlirBuilderError | MlirVerificationError:
    return print_program(lower(module))
