import "ffi.sev" as native
import "ir/lib.sev"


enum MlirMaterializationError:
    MissingNativeType(key: string)
    MissingNativeValue(value: int)
    MissingNativeRegion(region: int)
    MissingNativeBlock(block: int)
    MissingNativeFunction(name: string)
    NativeConstructionFailed
    NativeVerificationFailed


class NativeMlirTables:
    # The type key is used only for interning inside this walker. It never
    # crosses the native boundary and is not an MLIR serialization format.
    types: map[string, native.NativeMlirType]
    values: map[int, native.NativeMlirValue]
    regions: map[int, native.NativeMlirRegion]
    detached_blocks: map[int, native.NativeMlirDetachedBlock]
    blocks: map[int, native.NativeMlirBlock]
    functions: map[string, native.NativeMlirOperation]
    function_types: map[string, native.NativeMlirType]
    populated_regions: map[int, bool]

    def NativeMlirTables():
        types := {}
        values := {}
        regions := {}
        detached_blocks := {}
        blocks := {}
        functions := {}
        function_types := {}
        populated_regions := {}


class NativeMlirModule:
    session: native.NativeMlirSession
    verified: bool


def destroy_native_module(module: NativeMlirModule):
    native.native_session_destroy(module.session)


def materialization_type_key(type_id: MlirType) -> string:
    scalar = scalar_kind_name(type_id.scalar.kind) + ":" + string(type_id.scalar.bits) + ":" + string(type_id.scalar.signed) + ":" + string(type_id.scalar.address_space)
    dimensions: list[string] = []
    for dimension in type_id.dimensions:
        dimensions.append(string(dimension))
    return type_kind_name(type_id.kind) + ":" + scalar + ":[" + dimensions.join(",") + "]"


def native_scalar_type(session: native.NativeMlirSession, scalar: MlirScalarType) -> native.NativeMlirType:
    kind = scalar_kind_name(scalar.kind)
    if kind == "integer":
        # Severian signedness selects arithmetic semantics. MLIR arithmetic
        # scalar types remain signless; no source-name specialization occurs.
        return native.native_type_integer(session, u32(scalar.bits), -1)
    if kind == "ieee_float":
        return native.native_type_float(session, u32(scalar.bits), false)
    if kind == "brain_float":
        return native.native_type_float(session, u32(scalar.bits), true)
    if kind == "index":
        return native.native_type_index(session)
    return native.native_type_pointer(session, u32(scalar.address_space))


def intern_type(session: native.NativeMlirSession, tables: NativeMlirTables, type_id: MlirType) -> native.NativeMlirType:
    key = materialization_type_key(type_id)
    found = tables.types.get(key)
    if found != None:
        return found
    kind = type_kind_name(type_id.kind)
    if kind == "scalar":
        result = native_scalar_type(session, type_id.scalar)
        tables.types[key] = result
        return result
    element = native_scalar_type(session, type_id.scalar)
    draft_kind := 0
    if kind == "unranked_tensor":
        draft_kind = 1
    if kind == "memref":
        draft_kind = 2
    if kind == "unranked_memref":
        draft_kind = 3
    draft = native.native_type_draft(session, draft_kind, element)
    if kind == "tensor" or kind == "memref":
        for dimension in type_id.dimensions:
            native.native_type_draft_dimension(draft, i64(dimension))
    result = native.native_type_draft_finish(session, draft)
    tables.types[key] = result
    return result


def intern_attribute_types(session: native.NativeMlirSession, tables: NativeMlirTables, value: MlirAttributeValue):
    kind = attribute_kind_name(value.kind)
    if kind == "integer" or kind == "float" or kind == "type":
        intern_type(session, tables, value.type_id)
    if kind == "array":
        for element in value.elements:
            intern_attribute_types(session, tables, element)


def intern_program_types(session: native.NativeMlirSession, tables: NativeMlirTables, program: MlirProgram):
    for function in program.functions:
        for argument in function.arguments:
            intern_type(session, tables, argument.type_id)
        for result in function.result_types:
            intern_type(session, tables, result)
    for region in program.regions:
        for block in region.blocks:
            for argument in block.arguments:
                intern_type(session, tables, argument.type_id)
            for operation in block.operations:
                for operand in operation.operands:
                    intern_type(session, tables, operand.type_id)
                for result in operation.results:
                    intern_type(session, tables, result.type_id)
                for attribute in operation.attributes:
                    intern_attribute_types(session, tables, attribute.value)


def declare_function_types(session: native.NativeMlirSession, tables: NativeMlirTables, program: MlirProgram):
    for function in program.functions:
        draft = native.native_type_draft(session, 4, native.native_type_index(session))
        for argument in function.arguments:
            native.native_type_draft_input(draft, intern_type(session, tables, argument.type_id))
        for result in function.result_types:
            native.native_type_draft_result(draft, intern_type(session, tables, result))
        tables.function_types[function.name] = native.native_type_draft_finish(session, draft)


def create_regions_and_blocks(session: native.NativeMlirSession, tables: NativeMlirTables, program: MlirProgram):
    for region in program.regions:
        tables.regions[region.id] = native.native_region(session)
        for block in region.blocks:
            tables.detached_blocks[block.id] = native.native_block(session)


def create_block_arguments(session: native.NativeMlirSession, tables: NativeMlirTables, program: MlirProgram) -> unit | MlirMaterializationError:
    unknown = native.native_location_unknown(session)
    for region in program.regions:
        native_region = tables.regions.get(region.id)
        if native_region == None:
            return error(MissingNativeRegion(region.id))
        for block in region.blocks:
            detached = tables.detached_blocks.get(block.id)
            if detached == None:
                return error(MissingNativeBlock(block.id))
            for argument in block.arguments:
                type_id = tables.types.get(materialization_type_key(argument.type_id))
                if type_id == None:
                    return error(MissingNativeType(materialization_type_key(argument.type_id)))
                tables.values[argument.id] = native.native_block_argument(session, detached, type_id, unknown)
            tables.blocks[block.id] = native.native_region_append_block(session, native_region, detached)
    return unit


def materialize_location(session: native.NativeMlirSession, location: MlirLocation | None) -> native.NativeMlirLocation:
    if location == None:
        return native.native_location_unknown(session)
    return native.native_location(session, location.file, location.line, location.column)


def materialize_affine_expression(session: native.NativeMlirSession, expression: MlirAffineExpression) -> native.NativeMlirAffineExpression:
    kind = affine_expression_kind_name(expression.kind)
    if kind == "dimension":
        return native.native_affine_dimension(session, usize(expression.position))
    if kind == "symbol":
        return native.native_affine_symbol(session, usize(expression.position))
    if kind == "constant":
        return native.native_affine_constant(session, i64(expression.constant))
    left = materialize_affine_expression(session, expression.operands[0])
    right = materialize_affine_expression(session, expression.operands[1])
    binary_kind := 0
    if kind == "multiply":
        binary_kind = 1
    if kind == "modulo":
        binary_kind = 2
    if kind == "floor_divide":
        binary_kind = 3
    if kind == "ceil_divide":
        binary_kind = 4
    return native.native_affine_binary(session, binary_kind, left, right)


def materialize_attribute(session: native.NativeMlirSession, tables: NativeMlirTables, value: MlirAttributeValue) -> native.NativeMlirAttribute | MlirMaterializationError:
    kind = attribute_kind_name(value.kind)
    if kind == "string":
        return native.native_attribute_string(session, value.text)
    if kind == "symbol":
        return native.native_attribute_symbol(session, value.symbol)
    if kind == "boolean":
        return native.native_attribute_boolean(session, value.enabled)
    if kind == "integer" or kind == "float" or kind == "type":
        type_id = tables.types.get(materialization_type_key(value.type_id))
        if type_id == None:
            return error(MissingNativeType(materialization_type_key(value.type_id)))
        if kind == "integer":
            return native.native_attribute_integer(session, type_id, i64(value.integer))
        if kind == "float":
            return native.native_attribute_float(session, type_id, value.floating)
        return native.native_attribute_type(session, type_id)
    if kind == "array" or kind == "string_array":
        draft = native.native_array_draft(session)
        if kind == "array":
            for element in value.elements:
                native.native_array_draft_push(draft, materialize_attribute(session, tables, element))
        else:
            for element in value.strings:
                native.native_array_draft_push(draft, native.native_attribute_string(session, element))
        return native.native_array_draft_finish(session, draft)
    map = value.affine_maps[0]
    draft = native.native_affine_map_draft(session, usize(map.dimensions), usize(map.symbols))
    for result in map.results:
        native.native_affine_map_draft_push(draft, materialize_affine_expression(session, result))
    return native.native_affine_map_draft_finish(session, draft)


def selected_region(program: MlirProgram, id: int) -> MlirRegion | MlirMaterializationError:
    for region in program.regions:
        if region.id == id:
            return region
    return error(MissingNativeRegion(id))


def materialize_region_operations(session: native.NativeMlirSession, tables: NativeMlirTables, program: MlirProgram, region_id: int) -> unit | MlirMaterializationError:
    if tables.populated_regions.get(region_id) != None:
        return unit
    region = selected_region(program, region_id)
    for block in region.blocks:
        native_block = tables.blocks.get(block.id)
        if native_block == None:
            return error(MissingNativeBlock(block.id))
        for operation in block.operations:
            for nested_region in operation.regions:
                materialize_region_operations(session, tables, program, nested_region)
            draft = native.native_operation_draft(session, operation.name.dialect, operation.name.mnemonic, materialize_location(session, operation.location))
            for result in operation.results:
                type_id = tables.types.get(materialization_type_key(result.type_id))
                if type_id == None:
                    return error(MissingNativeType(materialization_type_key(result.type_id)))
                native.native_operation_draft_result(draft, type_id)
            for operand in operation.operands:
                value = tables.values.get(operand.id)
                if value == None:
                    return error(MissingNativeValue(operand.id))
                native.native_operation_draft_operand(draft, value)
            for attribute in operation.attributes:
                native.native_operation_draft_attribute(draft, attribute.name, materialize_attribute(session, tables, attribute.value))
            for property in operation.properties:
                native.native_operation_state_property(draft, property.name, materialize_attribute(session, tables, property.value))
            for successor in operation.successors:
                target = tables.blocks.get(successor)
                if target == None:
                    return error(MissingNativeBlock(successor))
                native.native_operation_state_successor(draft, target)
            for nested_region in operation.regions:
                owned = tables.regions.get(nested_region)
                if owned == None:
                    return error(MissingNativeRegion(nested_region))
                native.native_operation_draft_region(draft, owned)
            if operation.infer_results:
                native.native_operation_state_infer_results(draft)
            materialized = native.native_operation_draft_finish(session, draft)
            result_index := 0
            for result in operation.results:
                tables.values[result.id] = native.native_operation_result(session, materialized, usize(result_index))
                result_index += 1
            native.native_block_append_operation(session, native_block, materialized)
    tables.populated_regions[region_id] = true
    return unit


def create_function_operation(session: native.NativeMlirSession, tables: NativeMlirTables, function: MlirFunctionOp) -> native.NativeMlirOperation | MlirMaterializationError:
    signature = tables.function_types.get(function.name)
    if signature == None:
        return error(MissingNativeFunction(function.name))
    draft = native.native_operation_draft(session, "func", "func", materialize_location(session, function.location))
    native.native_operation_draft_attribute(draft, "sym_name", native.native_attribute_string(session, function.name))
    native.native_operation_draft_attribute(draft, "function_type", native.native_attribute_type(session, signature))
    if visibility_name(function.visibility) == "private":
        native.native_operation_draft_attribute(draft, "sym_visibility", native.native_attribute_string(session, "private"))
    if not function.declaration:
        body = tables.regions.get(function.body_region)
        if body == None:
            return error(MissingNativeRegion(function.body_region))
        native.native_operation_draft_region(draft, body)
    return native.native_operation_draft_finish(session, draft)


def materialize(program: MlirProgram) -> NativeMlirModule | MlirVerificationError | MlirMaterializationError:
    # Pass 1: the native provider never receives an invalid compiler graph.
    validate(program)

    # Pass 2: creating the session creates an empty live ModuleOp.
    session = native.native_session_create()
    tables = NativeMlirTables()

    # Passes 3-6: intern types, declare signatures, then establish native
    # regions, blocks, block arguments, and the initial SSA value table.
    intern_program_types(session, tables, program)
    declare_function_types(session, tables, program)
    create_regions_and_blocks(session, tables, program)
    create_block_arguments(session, tables, program)

    # Passes 7-9: walk operations in dominance order. Nested regions are fully
    # populated before ownership is transferred; results enter the SSA table
    # before the following operation is visited.
    for function in program.functions:
        if not function.declaration:
            materialize_region_operations(session, tables, program, function.body_region)
        tables.functions[function.name] = create_function_operation(session, tables, function)

    # Pass 10: preserve source declaration order in the native symbol table.
    for function in program.functions:
        operation = tables.functions.get(function.name)
        if operation == None:
            return error(MissingNativeFunction(function.name))
        native.native_module_append_operation(session, operation)

    if not native.native_session_ok(session):
        native.native_session_destroy(session)
        return error(NativeConstructionFailed)

    # Pass 11: upstream MLIR verifies the live object graph.
    if not native.native_session_verify(session):
        native.native_session_destroy(session)
        return error(NativeVerificationFailed)
    return NativeMlirModule(session, true)
