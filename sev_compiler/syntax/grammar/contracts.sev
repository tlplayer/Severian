trait Outcome: G
    control_flow: ControlFlow = Error

    def semantic(value: Ex):
        result = lower(value)
        valid = outcome.success(result)
        taken = cfg.block()
        failed = cfg.block()
        cfg.branch(valid, taken, failed)
        cfg.at(failed)
        cfg.throw(result)
        cfg.at(taken)
        payload = outcome.payload(result)
        return payload


trait Throws: G
    control_flow: ControlFlow = Error

    def semantic(value: Ex, expected: Ex, failure: B):
        caught = cfg.block()
        cfg.catch(caught, expected)
        lower(value)
        cfg.end_catch()
        lower(failure)
        cfg.fallthrough(caught)
        cfg.at(caught)


trait List: G
    construction: string = "list_create"


trait Index: G
    access: string = "element_at"
    storage: string = "element_set"


trait Iteration: G
    start: string = "iteration_start"
    condition: string = "iteration_more"
    access: string = "element_at"
    advance: string = "iteration_next"
