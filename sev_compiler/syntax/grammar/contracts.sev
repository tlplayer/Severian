    precedence: int = 10
    associativity: Associativity = Associativity.Right
    operations: dict[T, ScalarOperation] = {
        i8 | i16 | i32 | int | u8 | u16 | u32 | u64 | index: ScalarOperation("subi"),
        f32 | f64: ScalarOperation("negf", direct=true),
    }


trait Not: G
    symbol: Y = NotKeyword()
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    associativity: Associativity = Associativity.Right
    operations: dict[T, ScalarOperation] = {
        bool: ScalarOperation("xori", identity=1),
    }


trait Bang: G
