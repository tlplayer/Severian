trait Positive: G
    symbol: Y = PlusSymbol()
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    associativity: Associativity = Associativity.Right
    operations: dict[T, ScalarOperation] = {
        i8 | i16 | i32 | int | u8 | u16 | u32 | u64 | index: ScalarOperation("addi"),
        f32 | f64: ScalarOperation("addf"),
    }


trait Negative: G
    symbol: Y = MinusSymbol()
