class BlockLayout:
    id: SourceBlockID
    owner: DefinitionID
    span: Span | None
    parent: SourceBlockID | None = None
    introduced_by: SentenceID | None = None
    children: list[SourceBlockID] = []

'''
Source ancestry and compiler call paths are distinct from runtime stack
frames.
'''
class CallableOrigin:
    definition_id: DefinitionID
    name: string
    span: Span | None

class OperationOrigin:
    span: Span | None = None
    block: SourceBlockID | None = None
    callable: DefinitionID | None = None
    path: list[CallableOrigin] = []

import B,
    BlockContext,
    BlockSentence,
    BlockTerm,
    BlockTermRole,
    SentenceID,
    SourceBlockID from "../generic/block.sev"

class BlockSyntax:
    name: string
    prefix: list[string]
    name_position: int = -1
    bodyless: bool = false
    follows: list[string] = []
    parents: list[string] = []

class Block: B
    statements: list[Statement] = []
    operations: list[Operation] = []
    lowered_operations: list[LoweredOperation] = []
    span: source.Span | None = None
    layout: BlockLayout | None = None
    grammars: list[BlockSentence] = []
    subblocks: list[SourceBlockID] = []
    id: SourceBlockID = SourceBlockID(0)
    parent: SourceBlockID | None = None
    syntax_name: string = ""
    name: string = ""
    header: BlockSentence | None = None
    previous: SourceBlockID | None = None
    chain: SourceBlockID | None = None

    '''
    Executable realizations use the same block contract. CFG compaction may
    change cfg_index; source id, layout and containment must remain stable.
    '''
    cfg_index: int = -1
    parameters: list[ValueID] = []
    terminator: CfgTerminator | None = None
    origins: list[OperationOrigin] = []
    origin: OperationOrigin = OperationOrigin()
    context: BlockContext = BlockContext()

    # Ordered indices into BlockGraph.nodes; the same block survives HIR/MIR.
    contents: list[int] = []
    implementation: B | None = None

    # Internal execution regions travel with their owning compilation block.
    partition_owner: SourceBlockID | None = None

class BlockFile:
    path: string
    source: u32
    blocks: list[Block]
    next_grammar: u32 = 0

def global_source_block(file: source.SourceFile) -> Block:
    return Block(
        span = source.Span(file.source_id, 0, u32(len(file.characters))),
        syntax_name = "global",
        name = file.path,
    )

# Discovery consumes these contracts; spelling and containment rules live here.
def resolve_block_syntax(
    header: BlockSentence,
    syntaxes: list[BlockSyntax],
) -> BlockSyntax | None:
    selected: BlockSyntax | None := None
    for syntax in syntaxes:
        if len(syntax.prefix) == 0 or len(syntax.prefix) > len(header.terms):
            continue
        matches := true
        for index in range(int(len(syntax.prefix))):
            if header.terms[index].spelling != syntax.prefix[index]
                or header.terms[index].role == BlockTermRole.Opaque:
                matches = false
        if syntax.name_position >= 0:
            if syntax.name_position >= len(header.terms):
                matches = false
            elif header.terms[syntax.name_position].role != BlockTermRole.Name:
                matches = false
        if matches:
            if selected != None:
                throw Error("ambiguous block syntax")
            selected = syntax
    return selected

def declared_source_block(
    file: BlockFile,
    parent: SourceBlockID,
    header: BlockSentence,
    syntaxes: list[BlockSyntax],
) -> Block:
    id = SourceBlockID(u32(len(file.blocks)))
    block = Block(span = header.span, id = id, parent = parent, header = header)
    syntax ?= resolve_block_syntax(header, syntaxes)
    if syntax == None:
        return block
    owner = file.blocks[parent.index]
    if len(syntax.parents) > 0 and owner.syntax_name not in syntax.parents:
        throw Error("invalid enclosing block for " + syntax.name)
    block.syntax_name = syntax.name
    if syntax.name_position >= 0:
        block.name = header.terms[syntax.name_position].spelling
    if len(syntax.follows) > 0:
        if len(owner.subblocks) == 0 or len(owner.grammars) < 2:
            throw Error("missing preceding block for " + syntax.name)
        previous = file.blocks[owner.subblocks[-1].index]
        previous_header ?= previous.header
        if previous_header == None:
            throw Error("missing preceding block header for " + syntax.name)
        if previous.syntax_name not in syntax.follows
            or previous_header.id != owner.grammars[-2].id:
            throw Error("invalid preceding block for " + syntax.name)
        block.previous = previous.id
        block.chain = previous.chain if previous.chain != None else previous.id
    return block

'''
Bootstrap declarations, supplied as data to the structural parser. Packages
can supply additional BlockSyntax values without adding parser keyword cases.
'''
def standard_block_syntax() -> list[BlockSyntax]:
    return [
        BlockSyntax(
            name = "function",
            name_position = ["def"],
            bodyless = 1,
            bodyless = true,
        ),
        BlockSyntax(
            name = "operator",
            name_position = ["operator"],
            bodyless = true,
        ),
        BlockSyntax(
            name = "class",
            name_position = ["class"],
            bodyless = 1,
            bodyless = true,
        ),
        BlockSyntax(
            name = "trait",
            name_position = ["trait"],
            bodyless = 1,
            bodyless = true,
        ),
        BlockSyntax(
            name = "enum",
            name_position = ["enum"],
            bodyless = 1,
            bodyless = true,
        ),
        BlockSyntax(
            name = "extension",
            name_position = ["extend"],
            bodyless = 1,
            bodyless = true,
        ),
        BlockSyntax(name = "test", name_position = ["test"], bodyless = true),
        BlockSyntax("for", ["for"]),
        BlockSyntax("while", ["while"]),
        BlockSyntax("if", ["if"]),
        BlockSyntax(
            name = "elif",
            name_position = ["elif"],
            follows = ["if", "elif"],
        ),
        BlockSyntax(
            name = "else",
            name_position = ["else"],
            follows = ["if", "elif"],
        ),
        BlockSyntax("try", ["try"]),
        BlockSyntax(
            name = "catch",
            name_position = ["catch"],
            follows = ["try", "catch"],
        ),
        BlockSyntax("match", ["match"]),
        BlockSyntax("switch", ["switch"]),
        BlockSyntax(
            name = "case",
            name_position = ["case"],
            parents = ["match", "switch", "select"],
        ),
        BlockSyntax("with", ["with"]),
        BlockSyntax("unsafe", ["unsafe"]),
        BlockSyntax("accept", ["accept"]),
        BlockSyntax("reject", ["reject"]),
        BlockSyntax("select", ["select"]),
    ]

test "empty block construction uses field defaults":
    block = Block()
    assert:
        len(block.statements) == 0
        len(block.operations) == 0
        len(block.lowered_operations) == 0
        block.cfg_index == -1
        block.terminator == None
