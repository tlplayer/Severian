import Add, Associativity, AttachmentRole, BackendId, BinaryOperation, BinaryOperator, BitwiseAnd, BitwiseOr, BitwiseXor, BoundaryModifier, CallArgument, CallType, CallableAlternative, Callee, CanonicalRewrite, CfgBody, CfgStatement, CompileRoute, CompilerCapability, CompilerExpectation, CompilerTestCase, Constant, Constraint, ConstraintGraph, ConstraintId, ConstraintObligation, ConstraintRequirement, ConstraintStage, Constructor, Contains, Conversion, ConversionKind, Conversions, Decorator, DecoratorArgument, DecoratorValue, DialectId, DispatchCandidate, DispatchFamily, Divide, EffectSet, Effects, Equal, Evaluation, Expression, ExpressionConversion, ExpressionConversionKind, ExpressionKind, ExternalCall, FieldConstraint, Fixity, FloorDivide, FunctionDeclaration, FunctionLinkage, FunctionParameter, GenericConstraint, Greater, GreaterEqual, ImportDeclaration, ImportSubject, InferenceContext, IrContext, LazyOperand, LeftShift, Less, LessEqual, Lexeme, LexemeTerm, LiteralBinding, LiteralConstruction, LiteralSyntax, LiteralValue, LocalDecl, LogicalAnd, LogicalOr, LoweredFloatFormat, LoweredOperation, LoweredType, LoweringCapability, LoweringRequirements, MlirObject, MlirTypeBinding, MlirTypeParameter, MlirTypeProvider, MockFunction, Move, Multiply, Negative, Not, NotEqual, Operand, Operation, OperationDiagnostic, OperationId, OperationInterface, OperationRegistry, Operator, OperatorDeclaration, OperatorDomain, OperatorParameter, OperatorSignature, OperatorSyntax, Place, Positive, Power, Primitive, PrimitiveAlias, PrimitiveCategory, PrimitiveRepresentation, Projection, ProofResult, PropertyDeclaration, RecordDeclaration, RegisteredOperation, Remainder, ResolvedCallee, RightShift, RuntimeId, Rvalue, ScalarOperation, Signature, Size, SourceFile, SourceId, SourceMap, Span, Subtract, SwitchCase, TestCaseRow, TestDeclaration, TestExpectation, TestMode, TestModeArguments, TestStream, TokenKind, TokenTerm, TraitDeclaration, TraitRef, TyInterner, TypeAnnotation, TypeAnnotationKind, TypeConstraint, TypeDeclaration, TypeKind, TypePattern, TypeRef, UnaryOperation, UnaryOperator, UnifyError, WithAttachment, Y, allocate_effect, annotation_key, array_mlir, attribute_id, backend_id, byte_view_mlir, callable_key, cfg_blocks, control_flow, declared_mlir_binding, dialect_id, empty_cfg, free_effect, hashing, index_mlir, insert_type, io_effect, load, local_place, memref_mlir, named_operation, named_type, no_effects, operation_id, operator_syntax, outcome_variants, provider_id, ranked_memref_storage, read_effect, record_mlir_binding, resolve_expression, resolved_function, runtime_id, same_constructor, same_parameters, scalar_boundary, scalar_mlir, scalar_operand_segments, scalar_requirement_names, scalar_requirements, simple_type_name, source_id, span, struct_mlir, tensor_mlir, test_mode_name, throw_effect, type_children, union_variants, unranked_memref_mlir, unranked_tensor_mlir, utf8_offset, virtual_source, write_effect from "../function/lowering.sev"
import CfgEdge, CfgExit, CfgTerminator from "control_flow.sev"

class SourceBlockId:
    index: u32

class SentenceId:
    index: u32

enum BlockKind:
    Global
    Callable
    Class
    Trait
    Test
    Lexical
    Main
    If
    Else
    Match
    Case
    Switch
    For
    While
    With

class BlockLayout:
    id: SourceBlockId
    kind: BlockKind
    owner: DefId
    span: Span | None
    parent: SourceBlockId | None = None
    introduced_by: SentenceId | None = None
    children: list[SourceBlockId] = []

# Source ancestry and compiler call paths are distinct from runtime stack frames.
class CallableOrigin:
    definition: DefId
    name: string
    span: Span | None

class OperationOrigin:
    span: Span | None = None
    block: SourceBlockId | None = None
    callable: DefId | None = None
    path: list[CallableOrigin] = []


# B is the source structure shared by discovery and resolved block bodies.
# Sentence spans remain available before any expression or literal is resolved.
trait B:
    property span: source.Span | None
    property sentences: list[BlockSentence]
    property subblocks: list[SourceBlockId]


enum BlockTermRole:
    Name
    Symbol
    Opaque


class BlockTerm:
    spelling: string
    span: source.Span
    role: BlockTermRole


class BlockSentence:
    id: SentenceId
    span: source.Span
    terms: list[BlockTerm]


class BlockSyntax:
    name: string
    prefix: list[string]
    kind: BlockKind
    name_position: int = -1


class Block: B
    statements: list[Statement] = []
    operations: list[Operation] = []
    lowered_operations: list[LoweredOperation] = []
    span: source.Span | None = None
    layout: BlockLayout | None = None
    sentences: list[BlockSentence] = []
    subblocks: list[SourceBlockId] = []
    id: SourceBlockId = SourceBlockId(0)
    parent: SourceBlockId | None = None
    kind: BlockKind = BlockKind.Lexical
    syntax_name: string = ""
    name: string = ""
    header: BlockSentence | None = None
    # Executable realizations use the same block contract. CFG compaction may
    # change cfg_index; source id, layout and containment must remain stable.
    cfg_index: int = -1
    parameters: list[ValueId] = []
    terminator: CfgTerminator | None = None
    origins: list[OperationOrigin] = []
    origin: OperationOrigin = OperationOrigin()


class BlockFile:
    path: string
    source: source.SourceId
    blocks: list[Block]
    next_sentence: u32 = 0


# Bootstrap declarations, supplied as data to the structural parser. Packages
# can supply additional BlockSyntax values without adding parser keyword cases.
def standard_block_syntax() -> list[BlockSyntax]:
    return [
        BlockSyntax("function", ["def"], BlockKind.Callable, 1),
        BlockSyntax("operator", ["operator"], BlockKind.Callable, 1),
        BlockSyntax("class", ["class"], BlockKind.Class, 1),
        BlockSyntax("trait", ["trait"], BlockKind.Trait, 1),
        BlockSyntax("enum", ["enum"], BlockKind.Class, 1),
        BlockSyntax("extension", ["extend"], BlockKind.Class, 1),
        BlockSyntax("test", ["test"], BlockKind.Test),
        BlockSyntax("for", ["for"], BlockKind.For),
        BlockSyntax("while", ["while"], BlockKind.While),
        BlockSyntax("if", ["if"], BlockKind.If),
        BlockSyntax("elif", ["elif"], BlockKind.If),
        BlockSyntax("else", ["else"], BlockKind.Else),
        BlockSyntax("match", ["match"], BlockKind.Match),
        BlockSyntax("switch", ["switch"], BlockKind.Switch),
        BlockSyntax("case", ["case"], BlockKind.Case),
        BlockSyntax("with", ["with"], BlockKind.With),
    ]


test "empty block construction uses field defaults":
    block = Block()
    assert(len(block.statements) == 0)
    assert(len(block.operations) == 0)
    assert(len(block.lowered_operations) == 0)
    assert(block.kind == BlockKind.Lexical)
    assert(block.cfg_index == -1)
    assert(block.terminator == None)
