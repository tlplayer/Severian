import Y from "../generic/symbol.sev"
import B, BlockContext, BlockSentence, SourceBlockId from "../generic/block.sev"
import source
import match from "match.sev"
import Expression from "../function/function.sev"
import Symbol from "../symbol/symbol.sev"
import TypeAnnotation from "../type/annotation.sev"

# Case blocks share the match scope as parent and each own their captured names.
class case: Y + B
    context: BlockContext = BlockContext()
    span: source.Span | None = None
    sentences: list[BlockSentence] = []
    subblocks: list[SourceBlockId] = []
    parent: match
    previous: case | None = None
    body: B
    pattern: Expression | None = None
    binding: Symbol | None = None
    annotation: TypeAnnotation | None = None

    sentence case["case", pattern: Expression, ":"]() -> B with self.previous == None or self.previous.parent == self.parent:
        self.pattern = pattern
        return self

    sentence typed_case["case", binding: Symbol, ":", annotation: TypeAnnotation, ":"]() -> B with self.previous == None or self.previous.parent == self.parent:
        self.binding = binding
        self.annotation = annotation
        return self
