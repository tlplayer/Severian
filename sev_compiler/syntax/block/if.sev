import Y from "../generic/symbol.sev"
import B, ExecutableBlock, BlockLowering, BlockContext, BlockSentence, SourceBlockId from "../generic/block.sev"
import source
import ValueId from "../symbol/symbol.sev"
import Block from "block.sev"


import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "../keywords/keyword.sev"


def recognize_if(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "if")


class IfKeyword: Y
    token_forms: list[TokenForm] = [TokenForm("IF", "if", recognize=recognize_if)]


# The grammar belongs to the implementing block, including its CFG behavior.
class if: Y + B + ExecutableBlock
    context: BlockContext = BlockContext()
    span: source.Span | None = None
    grammars: list[BlockSentence] = []
    subblocks: list[SourceBlockId] = []
    parent: B
    body: B

    conditions: list[bool] = []

    grammar if["if", conditions...: bool, ":"]() -> B:
        self.conditions = conditions
        return self

    def lower(cfg: BlockLowering):
        exit = cfg.block()
        for condition in self.conditions:
            taken = cfg.block()
            cfg.branch(cfg.condition(condition), taken, exit)
            cfg.at(taken)
        cfg.body(self.body)
        cfg.fallthrough(exit)
        cfg.at(exit)


class RecordingBlockLowering: BlockLowering
    next: int = 0
    branches: list[ValueId] = []
    destinations: list[int] = []
    bodies: int = 0
    exit: int = -1

    def block() -> int:
        result = self.next
        self.next += 1
        return result

    def condition(value: bool) -> ValueId:
        return ValueId(1 if value else 0)

    def body(value: B):
        self.bodies += 1

    def branch(value: ValueId, taken: int, otherwise: int):
        self.branches.append(value)
        self.destinations.append(taken)
        self.destinations.append(otherwise)

    def at(block: int):
        self.exit = block

    def fallthrough(block: int):
        self.destinations.append(block)


test "if owns conditional CFG lowering through explicit context":
    body = Block()
    branch = if(parent=body, body=body, conditions=[true, false])
    cfg = RecordingBlockLowering()
    branch.lower(cfg)
    assert(cfg.next == 3)
    assert(cfg.branches == [ValueId(1), ValueId(0)])
    assert(cfg.destinations == [1, 0, 2, 0, 0])
    assert(cfg.bodies == 1 and cfg.exit == 0)


import Expression, ExpressionKind from "../function/function.sev"
import LiteralValue, LiteralValueOf from "../grammar/resolution.sev"


# Shared by source branch construction and its semantic realization. Repeated
# conditions are a short-circuit conjunction, including the empty conjunction.
def branch_condition(conditions: list[Expression], span: source.Span) -> Expression:
    result := Expression(ExpressionKind.LiteralValue(LiteralValueOf[bool](true)), span)
    index := int(len(conditions)) - 1
    if index >= 0:
        result = conditions[index]
        index -= 1
    while index >= 0:
        rejected = Expression(ExpressionKind.LiteralValue(LiteralValueOf[bool](false)), span)
        result = Expression(ExpressionKind.Conditional(conditions[index], result, rejected), span)
        index -= 1
    return result


test "declared branch conditions preserve order and short circuit":
    span = source.Span(0, 0, 10)
    first = Expression(ExpressionKind.Name("first"), span)
    second = Expression(ExpressionKind.Name("second"), span)
    result = branch_condition([first, second], span)
    match result.kind:
        case Conditional:
            assert(condition == first)
            assert(then_value == second)
            match else_value.kind:
                case LiteralValue:
                    assert(value.read[bool](span) == false)
                case _:
                    assert(false)
        case _:
            assert(false)
