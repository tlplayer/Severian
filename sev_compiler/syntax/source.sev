import source
import ABIID,
    ArtifactID,
    AttrValue,
    AttributeID,
    BindingID,
    BlockID,
    CompiledRegionID,
    CompilerID,
    DeclarationID,
    DefinitionID,
    FFIID,
    FunctionID,
    GenericParamID,
    HIRID,
    IndexedID,
    InferVarID,
    InterfaceID,
    LocalID,
    ModuleID,
    NamedID,
    OpID,
    PackageID,
    PrimitiveID,
    ProviderID,
    RegionID,
    ScopeID,
    StableID,
    Substitution,
    Symbol,
    SymbolID,
    SymbolKind,
    SymbolName,
    TypeBinding,
    TypeConstructorBinding,
    TypeID,
    ValueID,
    VariantID,
    definition_from_key,
    named_definition,
    same_definition,
    semantic_digest,
    semantic_key from "symbol/symbol.sev"
import Eof,
    SourceFile,
    SourceMap,
    Span,
    load,
    Span,
    utf8_offset,
    virtual_source from "../frontend/source/source.sev"
Span as span

class AssertionOrigin:
    statement_start: u32
    condition_start: u32
    condition_end: u32
    location: AssertionLocation | None

enum CoverageKind:
    Line
    Branch

class CoveragePoint:
    span_start: u32
    kind: CoverageKind
    ordinal: u32
    key: string | None
    file: string | None
    line: u32 | None
    condition: ValueID | None = None

class AssertionLocation:
    file: string
    line: u32
    column: u32
    expression: string

class QualityRegion:
    id: int
    kind: string
    span: source.Span
    file: string
    line: int
    column: int
