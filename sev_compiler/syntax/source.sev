import source
import AbiId, ArtifactId, AttrValue, AttributeId, BindingId, BlockId, CompiledRegionId, CompilerId, DeclarationId, DefId, FfiId, FunctionId, GenericParamId, HirId, IndexedId, InferVarId, InterfaceId, LocalId, ModuleId, NamedId, OpId, PackageId, PrimitiveId, ProviderId, RegionId, ScopeId, StableId, Substitution, Symbol, SymbolId, SymbolKind, SymbolName, TypeBinding, TypeConstructorBinding, TypeId, ValueId, VariantId, definition_from_key, named_definition, same_definition, semantic_digest, semantic_key from "symbol/symbol.sev"
import SourceFile, SourceId, SourceMap, Span, load, source_id, span, utf8_offset, virtual_source from "../frontend/source/source.sev"



class AssertionOrigin:
    statement_start: u32
    condition_start: u32
    condition_end: u32
    location: AssertionLocation | None


enum CoverageKind:
    Line
    Branch


class CoveragePoint:
    span_start: u32
    kind: CoverageKind
    ordinal: u32
    key: string | None
    file: string | None
    line: u32 | None
    condition: ValueId | None = None

class AssertionLocation:
    file: string
    line: u32
    column: u32
    expression: string


class QualityRegion:
    id: int
    kind: string
    span: source.Span
    file: string
    line: int
    column: int

