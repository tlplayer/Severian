import ConstraintGraph, ConstraintStage, DispatchFamily, ProofResult from "model.sev"
import DefId, constraint_schedule from "graph.sev"
import ConstraintId, ConstraintRequirement, DispatchCandidate from "model.sev"
import Expression, ExpressionKind, LiteralValue from "../function/function.sev"
import DeclarationId, Span from "../source.sev"


# Structural discovery can narrow a family before every capture is resolved.
# Return original candidate indices so declaration identity and order survive.
def admissible_dispatch_candidates(family: DispatchFamily, graph: ConstraintGraph) -> list[int] | Error:
    constraint_schedule(graph)
    candidates: list[int] = []
    index := 0
    for candidate in family.candidates:
        rejected := false
        for requirement in candidate.requirements:
            if requirement.index >= len(graph.requirements):
                throw Error("dispatch references an unknown constraint")
            if graph.requirements[requirement.index].result == ProofResult.Refuted:
                rejected = true
        if not rejected:
            candidates.append(index)
        index += 1
    return candidates


# Unknown candidates remain live; they never become false because a budget ran out.
def select_dispatch(family: DispatchFamily, graph: ConstraintGraph, evaluate: ((Expression) -> ProofResult) | None = None) -> DefId | Error:
    evaluator ?= evaluate
    if evaluator != None:
        return select_dispatch(family, evaluate_dispatch_constraints(family, graph, evaluator))
    selected := -1
    unknown := false
    for index in admissible_dispatch_candidates(family, graph):
        candidate = family.candidates[index]
        unresolved := false
        for requirement in candidate.requirements:
            result = graph.requirements[requirement.index].result
            unresolved = unresolved or result == ProofResult.Unknown
        if unresolved:
            unknown = true
        elif selected >= 0:
            throw Error("ambiguous dispatch: multiple implementations match")
        else:
            selected = index
    if unknown:
        throw Error("dispatch requires runtime predicate evaluation")
    if selected < 0:
        throw Error("no implementation matches dispatch constraints")
    return family.candidates[selected].definition


# Evaluation facts belong to this invocation; never cache runtime value facts in
# the declaration graph. Prerequisites dominate evaluation, including callbacks
# whose reads are only safe after a preceding guard succeeds.
def evaluate_dispatch_constraints(family: DispatchFamily, graph: ConstraintGraph, evaluate: (Expression) -> ProofResult) -> ConstraintGraph | Error:
    schedule = constraint_schedule(graph)
    live = admissible_dispatch_candidates(family, graph)
    needed: list[int] = []
    for index in live:
        for requirement in family.candidates[index].requirements:
            if int(requirement.index) not in needed:
                needed.append(int(requirement.index))
    cursor := 0
    while cursor < len(needed):
        for prerequisite in graph.requirements[needed[cursor]].prerequisites:
            if int(prerequisite.index) not in needed:
                needed.append(int(prerequisite.index))
        cursor += 1
    resolved = ConstraintGraph()
    for requirement in graph.requirements:
        resolved.requirements.append(ConstraintRequirement(
            requirement.id, requirement.condition,
            prerequisites=requirement.prerequisites[:], stage=requirement.stage,
            result=requirement.result, reorderable=requirement.reorderable,
            cost=requirement.cost, value_versions=requirement.value_versions[:],
        ))
    for id in schedule:
        if int(id.index) not in needed:
            continue
        # A failed earlier requirement eliminates the whole candidate. Do not
        # evaluate its remaining conditions unless a live candidate needs them.
        pending: list[int] = []
        for index in admissible_dispatch_candidates(family, resolved):
            for constraint in family.candidates[index].requirements:
                if int(constraint.index) not in pending:
                    pending.append(int(constraint.index))
        cursor = 0
        while cursor < len(pending):
            for prerequisite in resolved.requirements[pending[cursor]].prerequisites:
                if int(prerequisite.index) not in pending:
                    pending.append(int(prerequisite.index))
            cursor += 1
        if int(id.index) not in pending:
            continue
        requirement = resolved.requirements[id.index]
        ready := true
        blocked := false
        for prerequisite in requirement.prerequisites:
            result = resolved.requirements[prerequisite.index].result
            ready = ready and result == ProofResult.Proven
            blocked = blocked or result == ProofResult.Refuted
        if blocked:
            resolved.requirements[id.index].result = ProofResult.Refuted
        elif not ready:
            resolved.requirements[id.index].result = ProofResult.Unknown
        elif requirement.result == ProofResult.Unknown:
            if requirement.stage != ConstraintStage.Runtime:
                throw Error("dispatch constraint requires a proof before runtime")
            resolved.requirements[id.index].result = evaluate(requirement.condition)
    return resolved


test "progressive dispatch retains unknown candidates and excludes refuted ones":
    location = Span(0, 0, 1)
    condition = Expression(ExpressionKind.LiteralValue(LiteralValue.BooleanValue(true)), location)
    graph = ConstraintGraph([
        ConstraintRequirement(ConstraintId(0), condition, result=ProofResult.Unknown),
        ConstraintRequirement(ConstraintId(1), condition, result=ProofResult.Refuted),
        ConstraintRequirement(ConstraintId(2), condition, result=ProofResult.Proven),
    ])
    first = DefId(0, 0, DeclarationId(1))
    second = DefId(0, 0, DeclarationId(2))
    family = DispatchFamily("parse", [
        DispatchCandidate(first, [ConstraintId(0)]),
        DispatchCandidate(second, [ConstraintId(1), ConstraintId(0)]),
    ])
    candidates = admissible_dispatch_candidates(family, graph)
    assert(len(candidates) == 1 and candidates[0] == 0)
    unresolved ?= select_dispatch(family, graph)
    assert(unresolved is Error)
    graph.requirements[0].result = ProofResult.Proven
    assert(select_dispatch(family, graph) == first)
    family.candidates.append(DispatchCandidate(second, [ConstraintId(2)]))
    ambiguous ?= select_dispatch(family, graph)
    assert(ambiguous is Error)
