# Registration retains the owner's arrangement, recognition, and type contract.
class RegisteredGrammar:
    syntax: Y
    result: type | None
    recognize: ((Window) -> LexicalMatch | None | Diagnostic) | None
    sequence: list[SentenceField] = []
    match_tokens: GrammarMatcher | None = None
    token_form: bool = false
    capture_types: list[type] = []
    repetitions: list[int] = []
    accepts: ((list[CapturedGrammar], GrammarContext) -> ProofResult | Diagnostic) | None = None
    construct: ((list[CapturedGrammar], GrammarContext) -> LiteralValue | Diagnostic) | None = None
    declaration: GrammarDeclarationContract | None = None
    match_context: ((list[TokenTerm], GrammarContext) -> GrammarMatch | None | Diagnostic) | None = None

    def has_parser_adapter() -> bool:
        return self.match_tokens != None or self.construct != None or self.match_context != None


# Discovery constructs declaration metadata on demand, after imports resolve.
# The compiler appends declaration-generated entries to this return value.
def registered_grammars() -> list[(Y, RegisteredGrammar)]:
    entries: list[(Y, RegisteredGrammar)] = [
        (ForKeyword(), RegisteredGrammar(ForKeyword(), None, None, token_form=true)),
        (ThrowKeyword(), RegisteredGrammar(ThrowKeyword(), None, None, token_form=true)),
        (NotKeyword(), RegisteredGrammar(NotKeyword(), None, None, token_form=true)),
        (CopyKeyword(), RegisteredGrammar(CopyKeyword(), None, None, token_form=true)),
        (MoveKeyword(), RegisteredGrammar(MoveKeyword(), None, None, token_form=true)),
        (InKeyword(), RegisteredGrammar(InKeyword(), None, None, token_form=true)),
        (AndKeyword(), RegisteredGrammar(AndKeyword(), None, None, token_form=true)),
        (OrKeyword(), RegisteredGrammar(OrKeyword(), None, None, token_form=true)),
        (IfKeyword(), RegisteredGrammar(IfKeyword(), None, None, token_form=true)),
        (WhileKeyword(), RegisteredGrammar(WhileKeyword(), None, None, token_form=true)),
        (IsKeyword(), RegisteredGrammar(IsKeyword(), None, None, token_form=true)),
        (EnumKeyword(), RegisteredGrammar(EnumKeyword(), None, None, token_form=true)),
        (Equal(), RegisteredGrammar(Equal(), None, None, token_form=true)),
        (ColonEqual(), RegisteredGrammar(ColonEqual(), None, None, token_form=true)),
        (QuestionEqual(), RegisteredGrammar(QuestionEqual(), None, None, token_form=true)),
        (Equality(), RegisteredGrammar(Equality(), None, None, token_form=true)),
        (NotEqual(), RegisteredGrammar(NotEqual(), None, None, token_form=true)),
        (Less(), RegisteredGrammar(Less(), None, None, token_form=true)),
        (LessEqual(), RegisteredGrammar(LessEqual(), None, None, token_form=true)),
        (Greater(), RegisteredGrammar(Greater(), None, None, token_form=true)),
        (GreaterEqual(), RegisteredGrammar(GreaterEqual(), None, None, token_form=true)),
        (Plus(), RegisteredGrammar(Plus(), None, None, token_form=true)),
        (Minus(), RegisteredGrammar(Minus(), None, None, token_form=true)),
        (Star(), RegisteredGrammar(Star(), None, None, token_form=true)),
        (Slash(), RegisteredGrammar(Slash(), None, None, token_form=true)),
        (FloorDivide(), RegisteredGrammar(FloorDivide(), None, None, token_form=true)),
        (Percent(), RegisteredGrammar(Percent(), None, None, token_form=true)),
        (Power(), RegisteredGrammar(Power(), None, None, token_form=true)),
        (PlusEqual(), RegisteredGrammar(PlusEqual(), None, None, token_form=true)),
        (MinusEqual(), RegisteredGrammar(MinusEqual(), None, None, token_form=true)),
        (StarEqual(), RegisteredGrammar(StarEqual(), None, None, token_form=true)),
        (SlashEqual(), RegisteredGrammar(SlashEqual(), None, None, token_form=true)),
        (FloorDivideEqual(), RegisteredGrammar(FloorDivideEqual(), None, None, token_form=true)),
        (PercentEqual(), RegisteredGrammar(PercentEqual(), None, None, token_form=true)),
        (Ampersand(), RegisteredGrammar(Ampersand(), None, None, token_form=true)),
        (Pipe(), RegisteredGrammar(Pipe(), None, None, token_form=true)),
        (Caret(), RegisteredGrammar(Caret(), None, None, token_form=true)),
        (Bang(), RegisteredGrammar(Bang(), None, None, token_form=true)),
        (LeftShift(), RegisteredGrammar(LeftShift(), None, None, token_form=true)),
        (RightShift(), RegisteredGrammar(RightShift(), None, None, token_form=true)),
        (AmpersandEqual(), RegisteredGrammar(AmpersandEqual(), None, None, token_form=true)),
        (PipeEqual(), RegisteredGrammar(PipeEqual(), None, None, token_form=true)),
        (CaretEqual(), RegisteredGrammar(CaretEqual(), None, None, token_form=true)),
        (LeftShiftEqual(), RegisteredGrammar(LeftShiftEqual(), None, None, token_form=true)),
        (RightShiftEqual(), RegisteredGrammar(RightShiftEqual(), None, None, token_form=true)),
        (Arrow(), RegisteredGrammar(Arrow(), None, None, token_form=true)),
        (ApproxArrow(), RegisteredGrammar(ApproxArrow(), None, None, token_form=true)),
        (Conversion(), RegisteredGrammar(Conversion(), None, None, token_form=true)),
        (LeftParen(), RegisteredGrammar(LeftParen(), None, None, token_form=true)),
        (RightParen(), RegisteredGrammar(RightParen(), None, None, token_form=true)),
        (LeftBracket(), RegisteredGrammar(LeftBracket(), None, None, token_form=true)),
        (RightBracket(), RegisteredGrammar(RightBracket(), None, None, token_form=true)),
        (LeftBrace(), RegisteredGrammar(LeftBrace(), None, None, token_form=true)),
        (RightBrace(), RegisteredGrammar(RightBrace(), None, None, token_form=true)),
        (Colon(), RegisteredGrammar(Colon(), None, None, token_form=true)),
        (Comma(), RegisteredGrammar(Comma(), None, None, token_form=true)),
        (Dot(), RegisteredGrammar(Dot(), None, None, token_form=true)),
        (Range(), RegisteredGrammar(Range(), None, None, token_form=true)),
        (Ellipsis(), RegisteredGrammar(Ellipsis(), None, None, token_form=true)),
        (At(), RegisteredGrammar(At(), None, None, token_form=true)),
        (StringSymbol(), RegisteredGrammar(StringSymbol(), None, None, token_form=true)),
        (Character(), RegisteredGrammar(Character(), None, None, token_form=true)),
        (BlockString(), RegisteredGrammar(BlockString(), None, None, token_form=true)),
        (FormattedString(), RegisteredGrammar(FormattedString(), None, None, token_form=true)),
        (FormattedBlockString(), RegisteredGrammar(FormattedBlockString(), None, None, token_form=true)),
        (Comment(), RegisteredGrammar(Comment(), None, None, token_form=true)),
        (Indent(), RegisteredGrammar(Indent(), None, None, token_form=true)),
        (Space(), RegisteredGrammar(Space(), None, None, token_form=true)),
        (Newline(), RegisteredGrammar(Newline(), None, None, token_form=true)),
        (EndOfFile(), RegisteredGrammar(EndOfFile(), None, None, token_form=true)),
        (Identifier(), RegisteredGrammar(Identifier(), None, None, token_form=true)),
    ]
    for owner in prelude_token_owners():
        entries.append((owner, RegisteredGrammar(owner, None, None, token_form=true)))
    return entries



@compiler_grammar_registry
def registry(result: type | None = None) -> list[(Y, RegisteredGrammar)]:
    entries: list[(Y, RegisteredGrammar)] = []
    for label, sequence in registered_grammars():
        # Optional exact lookup is retained for legacy adapters. Discovery uses
        # registry() and reads declaration.result; matching owns applicability.
        if result == None or sequence.result == result:
            entries.append((label, sequence))
    return entries


def grammar_declaration(definition: DefinitionID) -> GrammarDeclarationContract | None:
    for label, grammar in registry():
        declaration = grammar.declaration
        if declaration != None and declaration.callable.definition == definition:
            return declaration
    return None


import SyntaxDeclaration from "generic/declaration.sev"
import syntax_prelude, prelude_token_owners from "prelude.sev"


def recognition_order() -> list[SyntaxDeclaration]:
    return syntax_prelude()



import F from "generic/terms.sev"
import B from "generic/block.sev"


def registry_test_no_match(input: Window) -> LexicalMatch | None | Diagnostic:
    return None


test "registry exposes all grammars and filters by the requested type contract":
    function_label = SyntaxDeclaration("registry-test.sev", "function")
    block_label = SyntaxDeclaration("registry-test.sev", "block")
    function_sequence = RegisteredGrammar(function_label, F, registry_test_no_match, [SentenceField.Literal("call")])
    block_sequence = RegisteredGrammar(block_label, B, registry_test_no_match, [SentenceField.Literal("block")])

    declared = [(function_label, function_sequence), (block_label, block_sequence)]
    mock(registered_grammars() -> declared)

    grammars = registry()
    assert(len(grammars) == 2)
    label, sequence = grammars[0]
    assert(label == function_label)
    assert(sequence.sequence == [SentenceField.Literal("call")])
    assert(len(registry(F)) == 1)
    assert(len(registry(B)) == 1)
    for label, sequence in registry(F):
        assert(sequence.result == F)
    for label, sequence in registry(B):
        assert(sequence.result == B)
    grammars.append((block_label, block_sequence))
    assert(len(registry()) == 2)
