        (Bang(), RegisteredGrammar(Bang(), None, None, token_form=true)),
        (LeftShift(), RegisteredGrammar(LeftShift(), None, None, token_form=true)),
        (RightShift(), RegisteredGrammar(RightShift(), None, None, token_form=true)),
        (AmpersandEqual(), RegisteredGrammar(AmpersandEqual(), None, None, token_form=true)),
