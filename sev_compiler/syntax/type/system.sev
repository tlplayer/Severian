import DeclarationID,
    DefinitionID,
    GenericParamID,
    InferVarID,
    PrimitiveID,
    RegionID,
    Substitution,
    SymbolKind,
    TypeID from "../symbol/symbol.sev"

'''
Structural types and inference ported from
rust_compiler/universal/src/type_system.rs.
Type identity never depends on a printed name or the category of a source
family.
'''
class Signature:
    parameters: list[TypeID]
    result: TypeID

enum TypeKind:
    Primitive(Primitive: PrimitiveID)
    Nominal(definition: DefinitionID, substitution: Substitution)
    Parameter(Parameter: GenericParamID)
    Infer(variable: InferVarID)
    Function(Signature: Signature)
    Tuple(elements: list[TypeID])
    Union(members: list[TypeID])
    Reference(target: TypeID, mutable: bool, lifetime: RegionID)
    Resource(definition: DefinitionID, substitution: Substitution)

class TyInterner:
    kinds: list[TypeKind] = []
    next_infer: u32 = 0

    def intern(kind: TypeKind) -> TypeID:
        index := 0
        for known in kinds:
            if known == kind:
                return TypeID(u32(index))
            index += 1
        result = TypeID(u32(len(kinds)))
        kinds.append(kind)
        return result

    def kind(type: TypeID) -> TypeKind:
        if type.index >= len(kinds):
            throw Error("unknown structural type identity")
        return kinds[type.index]

    def parameter(parameter: GenericParamID) -> TypeID:
        return intern(TypeKind.Parameter(parameter))

    def fresh_infer() -> TypeID:
        variable = InferVarID(next_infer)
        next_infer += 1
        return intern(TypeKind.Infer(variable))

    def union(members: list[TypeID]) -> TypeID:
        canonical: list[TypeID] = []
        for member in members:
            match kind(member):
                case Union:
                    for nested in members:
                        insert_type(canonical, nested)
                case Primitive
                    | Nominal
                    | Parameter
                    | Infer
                    | Function
                    | Tuple
                    | Reference
                    | Resource:
                    insert_type(canonical, member)

        if len(canonical) == 1:
            return canonical[0]
        return intern(TypeKind.Union(canonical))

    def substitute(type: TypeID, arguments: Substitution) -> TypeID:
        match kind(type):
            case Parameter:
                replacement ?= arguments.get(parameter)
                if replacement != None:
                    return replacement
                return type
            case Nominal:
                return intern(
                    TypeKind.Nominal(
                        definition,
                        substitute_arguments(substitution, arguments),
                    ),
                )
            case Resource:
                return intern(
                    TypeKind.Resource(
                        definition,
                        substitute_arguments(substitution, arguments),
                    ),
                )
            case Function:
                return intern(
                    TypeKind.Function(
                        Signature(
                            substitute_types(Signature.parameters, arguments),
                            substitute(Signature.result, arguments),
                        ),
                    ),
                )
            case Tuple:
                return intern(
                    TypeKind.Tuple(substitute_types(elements, arguments)),
                )
            case Union:
                return union(substitute_types(members, arguments))
            case Reference:
                return intern(
                    TypeKind.Reference(
                        substitute(target, arguments),
                        mutable,
                        lifetime,
                    ),
                )
            case Primitive | Infer:
                return type

    def substitute_types(
        types: list[TypeID],
        arguments: Substitution,
    ) -> list[TypeID]:
        result: list[TypeID] = []
        for type in types:
            result.append(substitute(type, arguments))
        return result

    def substitute_arguments(
        original: Substitution,
        arguments: Substitution,
    ) -> Substitution:
        result = Substitution()
        for binding in original.arguments:
            result.bind(
                binding.parameter,
                substitute(binding.type_id, arguments),
            )
        return result

def insert_type(types: list[TypeID], type: TypeID):
    index := 0
    while index < len(types):
        if types[index].index == type.index:
            return
        if types[index].index > type.index:
            break
        index += 1
    types.insert(index, type)

class TraitRef:
    trait_id: DefinitionID
    self_type: TypeID
    substitution: Substitution

enum Constraint:
    Equal(left: TypeID, right: TypeID)
    Implements(trait: TraitRef)

class UnifyError: Error
    message: string
    left: TypeID
    right: TypeID

class InferenceContext:
    variables: list[InferVarID] = []
    types: list[TypeID] = []
    constraints: list[Constraint] = []

    def resolve(interner: TyInterner, type: TypeID) -> TypeID:
        variable = inference_variable(interner.kind(type))
        if variable != None:
            index := 0
            for known in variables:
                if known.index == variable.index:
                    return resolve(interner, types[index])
                index += 1
        return type

    def constrain_equal(
        interner: TyInterner,
        left: TypeID,
        right: TypeID,
    ) -> absent | UnifyError:
        constraints.append(Constraint.Equal(left, right))
        unify(interner, left, right)

    def bind(
        interner: TyInterner,
        variable: InferVarID,
        type: TypeID,
    ) -> absent | UnifyError:
        if occurs(interner, variable, type):
            throw UnifyError("recursive inference binding", type, type)
        variables.append(variable)
        types.append(type)

    def occurs(interner: TyInterner, needle: InferVarID, type: TypeID) -> bool:
        resolved = resolve(interner, type)
        variable = inference_variable(interner.kind(resolved))
        if variable != None:
            return variable.index == needle.index
        for child in type_children(interner.kind(resolved)):
            if occurs(interner, needle, child):
                return true
        return false

    def unify(
        interner: TyInterner,
        left: TypeID,
        right: TypeID,
    ) -> absent | UnifyError:
        lhs = resolve(interner, left)
        rhs = resolve(interner, right)
        if lhs.index == rhs.index:
            return
        left_variable = inference_variable(interner.kind(lhs))
        if left_variable != None:
            bind(interner, left_variable, rhs)
            return
        right_variable = inference_variable(interner.kind(rhs))
        if right_variable != None:
            bind(interner, right_variable, lhs)
            return
        if not same_constructor(interner.kind(lhs), interner.kind(rhs)):
            throw UnifyError("structural type mismatch", lhs, rhs)
        left_children = type_children(interner.kind(lhs))
        right_children = type_children(interner.kind(rhs))
        if len(left_children) != len(right_children):
            throw UnifyError("generic arity mismatch", lhs, rhs)
        index := 0
        for child in left_children:
            unify(interner, child, right_children[index])
            index += 1

def inference_variable(kind: TypeKind) -> InferVarID | None:
    match kind:
        case Infer:
            return variable
        case Primitive
            | Nominal
            | Parameter
            | Function
            | Tuple
            | Union
            | Reference
            | Resource:
            return None

def type_children(kind: TypeKind) -> list[TypeID]:
    result: list[TypeID] := []
    match kind:
        case Nominal:
            for binding in substitution.arguments:
                result.append(binding.type_id)
        case Resource:
            for binding in substitution.arguments:
                result.append(binding.type_id)
        case Tuple:
            return elements
        case Union:
            return members
        case Function:
            result = Signature.parameters[:]
            result.append(Signature.result)
        case Reference:
            result.append(target)
        case Primitive | Parameter | Infer:
            return []
    return result

def same_constructor(left: TypeKind, right: TypeKind) -> bool:
    match left:
        case Nominal:
            left_definition = definition
            left_arguments = substitution
            match right:
                case Nominal:
                    return left_definition == definition and same_parameters(
                        left_arguments,
                        substitution,
                    )
                case Primitive
                    | Parameter
                    | Infer
                    | Function
                    | Tuple
                    | Union
                    | Reference
                    | Resource:
                    return false

        case Resource:
            left_definition = definition
            left_arguments = substitution
            match right:
                case Resource:
                    return left_definition == definition and same_parameters(
                        left_arguments,
                        substitution,
                    )
                case Primitive
                    | Nominal
                    | Parameter
                    | Infer
                    | Function
                    | Tuple
                    | Union
                    | Reference:
                    return false

        case Function:
            match right:
                case Function:
                    return true
                case Primitive
                    | Nominal
                    | Parameter
                    | Infer
                    | Tuple
                    | Union
                    | Reference
                    | Resource:
                    return false

        case Tuple:
            match right:
                case Tuple:
                    return true
                case Primitive
                    | Nominal
                    | Parameter
                    | Infer
                    | Function
                    | Union
                    | Reference
                    | Resource:
                    return false

        case Union:
            match right:
                case Union:
                    return true
                case Primitive
                    | Nominal
                    | Parameter
                    | Infer
                    | Function
                    | Tuple
                    | Reference
                    | Resource:
                    return false

        case Reference:
            left_mutable = mutable
            left_lifetime = lifetime
            match right:
                case Reference:
                    return
                        left_mutable
                        == mutable
                        and left_lifetime.index
                        == lifetime.index
                case Primitive
                    | Nominal
                    | Parameter
                    | Infer
                    | Function
                    | Tuple
                    | Union
                    | Resource:
                    return false

        case Primitive | Parameter | Infer:
            return left == right

def same_parameters(left: Substitution, right: Substitution) -> bool:
    if len(left.arguments) != len(right.arguments):
        return false
    index := 0
    for binding in left.arguments:
        if binding.parameter.index != right.arguments[index].parameter.index:
            return false
        index += 1
    return true

test "substitution is structural and preserves its template":
    types = TyInterner()
    parameter = types.parameter(GenericParamID(0))
    concrete = types.intern(TypeKind.Primitive(PrimitiveID(DeclarationID(1))))
    template = types.intern(
        TypeKind.Function(Signature([parameter], parameter)),
    )
    arguments = Substitution()
    arguments.bind(GenericParamID(0), concrete)
    result = types.substitute(template, arguments)
    expected = types.intern(TypeKind.Function(Signature([concrete], concrete)))
    assert(result.index == expected.index)
    assert(types.substitute(template, Substitution()).index == template.index)

test "unification follows nested types and rejects recursive bindings":
    types = TyInterner()
    variable = types.fresh_infer()
    concrete = types.intern(TypeKind.Primitive(PrimitiveID(DeclarationID(1))))
    inferred = types.intern(TypeKind.Tuple([variable, concrete]))
    expected = types.intern(TypeKind.Tuple([concrete, concrete]))
    context = InferenceContext()
    context.unify(types, inferred, expected)
    assert(context.resolve(types, variable).index == concrete.index)
    recursive = types.fresh_infer()
    tuple = types.intern(TypeKind.Tuple([recursive]))
    failure ?= context.unify(types, recursive, tuple)
    assert(failure is UnifyError)

test "union interning flattens and canonicalizes members":
    types = TyInterner()
    first = types.intern(TypeKind.Primitive(PrimitiveID(DeclarationID(1))))
    second = types.intern(TypeKind.Primitive(PrimitiveID(DeclarationID(2))))
    pair = types.union([second, first, first])
    assert:
        types.union([first, second]).index == pair.index
        types.union([pair, first]).index == pair.index
        types.union([first, first]).index == first.index
