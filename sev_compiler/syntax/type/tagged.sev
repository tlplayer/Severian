import * from "../function/function.sev" as model_syntax_function_function
import * from "../symbol/symbol.sev" as model_syntax_symbol_symbol
import * from "annotation.sev" as model_syntax_type_annotation
import diagnostics
import source


class VariantSelection:
    record: int = -1
    variant: int = -1


# Tagged types use the same tagged aggregate storage as declared outcomes. Their
# nominal type stays distinct, so success propagation does not unwrap them.
def layouts(records: list[model_syntax_function_function.RecordDeclaration], first: int = 0) -> unit | diagnostics.Diagnostic:
    count = len(records)
    cursor := first
    while cursor < count:
        record := records[cursor]
        if record.representation == "TaggedAggregate":
            fields = [model_syntax_function_function.FunctionParameter("$tag", model_syntax_type_annotation.named_type("int", [], record.span), absent, record.span)]
            names: list[string] = []
            index := 0
            for variant in record.alternatives:
                if variant.name in names:
                    return error(diagnostics.diagnostic_at("E000206", "duplicate tagged variant " + variant.name, variant.span))
                names.append(variant.name)
                payload_name = record.name + "." + variant.name
                payload = model_syntax_function_function.RecordDeclaration(payload_name, variant.fields, [], variant.span, type_id=model_syntax_symbol_symbol.TypeId(u32(1000 + len(records))), lookup=record.lookup)
                records.append(payload)
                fields.append(model_syntax_function_function.FunctionParameter("$variant" + string(index), model_syntax_type_annotation.named_type(payload_name, [], variant.span), absent, variant.span))
                index += 1
            for variant in record.alternatives:
                seen: list[string] = []
                for destination in variant.transitions:
                    if destination not in names:
                        return error(diagnostics.diagnostic_at("E000213", "unknown transition destination " + destination, variant.span))
                    if destination in seen:
                        return error(diagnostics.diagnostic_at("E000213", "duplicate transition destination " + destination, variant.span))
                    seen.append(destination)
            record.fields = fields
            records[cursor] = record
        cursor += 1


def select(records: list[model_syntax_function_function.RecordDeclaration], namespace: string, path: string, expected: model_syntax_symbol_symbol.TypeId, span: source.Span) -> VariantSelection | diagnostics.Diagnostic:
    result := VariantSelection()
    ordinal := 0
    for record in records:
        if expected.index != 0 and expected.index != record.type_id.index:
            ordinal += 1
            continue
        index := 0
        components = record.name.split(".")
        module_name = components[:int(len(components)) - 1].join(".")
        for variant in record.alternatives:
            qualified = record.name + "." + variant.name
            exported = module_name + "." + variant.name
            visible = record.name == namespace + record.name.split(".")[-1] or record.lookup == ""
            module_variant = module_name != "" and (path == exported or namespace + path == exported)
            if path == qualified or namespace + path == qualified or module_variant or (path == variant.name and visible):
                if result.record != -1:
                    return error(diagnostics.diagnostic_at("E000206", "ambiguous tagged variant " + path, span))
                result = VariantSelection(ordinal, index)
            index += 1
        ordinal += 1
    return result


def path(expression: model_syntax_function_function.Expression) -> string:
    match expression.kind:
        case Name:
            return name
        case Member:
            return path(object) + "." + name
        case _:
            return ""
