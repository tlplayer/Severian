import Span, span from "../source.sev"

class TypeAnnotation:
    kind: TypeAnnotationKind
    span: Span
    binding: string = ""


enum TypeAnnotationKind:
    Named(name: string, arguments: list[TypeAnnotation])
    Union(members: list[TypeAnnotation])
    Function(parameters: list[TypeAnnotation], result: TypeAnnotation)
    DimensionConstant(value: u64)
    DimensionRuntime(index: u32)
    ShapeSpread(parameter: string)


def named_type(name: string, arguments: list[TypeAnnotation], span: Span) -> TypeAnnotation:
    return TypeAnnotation(Named(name, arguments), span)


def simple_type_name(annotation: TypeAnnotation) -> string | None:
    match annotation.kind:
        case Named:
            if len(arguments) == 0:
                return name
        case Union:
            return None
        case Function:
            return None
        case DimensionConstant:
            return None
        case DimensionRuntime:
            return None
        case ShapeSpread:
            return None
    return None
