import Y from "../generic/symbol.sev"
import TypeID, RegionID, GenericParamID from "../symbol/symbol.sev"
import TypeKind, Signature from "system.sev"

class GenericType: Y
    parameter: GenericParamID | None = None

    def structural_kind() -> TypeKind | Error:
        parameter ?= self.parameter
        if parameter == None:
            throw Error("generic type requires a resolved parameter identity")
        return TypeKind.Parameter(parameter)
