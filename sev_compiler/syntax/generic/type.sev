
enum ConversionKind:
    Identity
    Promote
    Checked
    Lossy


class TypeRef:
    name: string


class Constructor:
    source: TypeRef
    kind: ConversionKind


trait Conversion:
    constructors: list[Constructor]

enum Size:
    Fixed(bytes: u64)
    Pointer
    Dynamic

trait Type: Conversion
    token_kind: string = "Identifier"
    name: string
    size: Size
    alignment: Size


Type as T
