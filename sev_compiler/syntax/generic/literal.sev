import LiteralValue from "../grammar/resolution.sev"


# Legacy atomic spelling metadata. Type-owned grammars perform recognition and
# construction; an optional concrete result retains its own type.
class LiteralSyntax:
    token_kind: string
    token: string | None = None
    value: LiteralValue | None = None
    spellings: list[string] = []


trait Literal:
    default_literal: bool
    literal_family: string
    literal_syntaxes: list[LiteralSyntax]

Literal as L
