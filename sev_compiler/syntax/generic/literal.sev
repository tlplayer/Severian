import LiteralValue from "../literal/value.sev"


# One-token construction sentences. None captures the spelling recognized by
# the type's lexical rule; a concrete token declares an exact source spelling.
class LiteralSyntax:
    token_kind: string
    token: string | None = None
    value: LiteralValue | None = None
    spellings: list[string] = []


trait Literal:
    default_literal: bool
    literal_family: string
    literal_syntaxes: list[LiteralSyntax]

Literal as L
