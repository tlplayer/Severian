    DeclarationID,
    DefinitionID,
    FFIID,
    FunctionID,
    GenericParamID,
    HIRID,
    IndexedID,
    InferVarID,
    InterfaceID,
    LocalID,
    ModuleID,
    NamedID,
    OpID,
    PackageID,
    PrimitiveID,
    ProviderID,
    QualityRegion,
    RegionID,
    ScopeID,
    SourceFile,
    SourceMap,
    Span,
    StableID,
    Substitution,
    Symbol,
    SymbolID,
    SymbolKind,
    SymbolName,
    TypeBinding,
    TypeConstructorBinding,
