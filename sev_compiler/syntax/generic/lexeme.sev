import AbiId, ArtifactId, AssertionLocation, AssertionOrigin, AttrValue, AttributeId, BindingId, BlockId, CompiledRegionId, CompilerId, CoverageKind, CoveragePoint, DeclarationId, DefId, FfiId, FunctionId, GenericParamId, HirId, IndexedId, InferVarId, InterfaceId, LocalId, ModuleId, NamedId, OpId, PackageId, PrimitiveId, ProviderId, QualityRegion, RegionId, ScopeId, SourceFile, SourceMap, Span, StableId, Substitution, Symbol, SymbolId, SymbolKind, SymbolName, TypeBinding, TypeConstructorBinding, TypeId, ValueId, VariantId, definition_from_key, load, named_definition, same_definition, semantic_digest, semantic_key, span, utf8_offset, virtual_source from "../source.sev"


# Lx describes matched source, independently of its token classification.
trait LexemeTerm:
    text: string
    span: Span


class Lexeme: LexemeTerm
    text: string
    span: Span
