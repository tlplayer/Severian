import source
import DefId, ScopeId, ValueId from "../symbol/symbol.sev"
import Capture from "../sentence/sentence.sev"
import Expression, FunctionParameter, FunctionDeclaration, RecordDeclaration from "../function/function.sev"
import TypeAnnotation from "../type/annotation.sev"

class SourceBlockId:
    index: u32

class SentenceId:
    index: u32

enum BlockTermRole:
    Name
    Symbol
    Opaque


class BlockTerm:
    spelling: string
    span: source.Span
    role: BlockTermRole


class BlockSentence:
    id: SentenceId
    span: source.Span
    terms: list[BlockTerm]


# Populated by resolution, not guessed from a block's spelling or CFG index.
class BlockContext:
    identity: SourceBlockId | None = None
    provider: DefId | None = None
    constructor: DefId | None = None
    scope: ScopeId | None = None
    parent: SourceBlockId | None = None
    captures: list[Capture] = []
    values: list[BlockCaptureValue] = []
    fields: list[BlockFieldValue] = []
    candidates: list[BlockProviderCandidate] = []
    requires_provider: bool = false

    def require_resolved():
        if self.identity == None or self.provider == None or self.constructor == None or self.scope == None:
            throw Error("block resolution requires identity, provider, constructor and scope")


class BlockCaptureValue:
    name: string
    annotation: TypeAnnotation
    spans: list[source.Span] = []
    expressions: list[Expression] = []
    types: list[TypeAnnotation] = []
    parameters: list[FunctionParameter] = []
    symbols: list[string] = []
    variadic: bool = false


class BlockProviderCandidate:
    owner: RecordDeclaration
    constructor: FunctionDeclaration
    captures: list[BlockCaptureValue]


class BlockFieldValue:
    name: string
    value: BlockCaptureValue


# Provider lowering uses explicit compiler context instead of free cfg/lower
# names. Implementations supply behavior; the compiler supplies these operations.
trait BlockLowering:
    def block() -> int
    def condition(value: bool) -> ValueId
    def body(value: B)
    def branch(value: ValueId, taken: int, otherwise: int)
    def at(block: int)
    def fallthrough(block: int)


# B is the source structure shared by discovery and resolved block bodies.
# Sentence spans remain available before any expression or literal is resolved.
trait B:
    context: BlockContext
    span: source.Span | None
    sentences: list[BlockSentence]
    subblocks: list[SourceBlockId]


trait ExecutableBlock: B
    def lower(cfg: BlockLowering)
