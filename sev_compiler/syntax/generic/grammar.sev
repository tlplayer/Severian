import Y from "symbol.sev"
import source
import Block, DeclarationId, DefId, FunctionParameter, TypeAnnotation, span from "../function/function.sev"
import ScalarOperation,Associativity, OperatorSyntax from "../function/syntax.sev"

enum GrammarPrimitive:
    LowerExpression
    LowerBody
    ApplyOperator
    NewBlock
    NewMerge
    AtBlock
    BranchBlocks
    JumpBlock
    FallthroughBlock
    ReturnValue
    UnreachablePath
    BeginLoop
    EndLoop
    LoopHeader
    LoopExit
    BlockParameter
    BooleanConstant
    FinishGrammar


enum GrammarSlotKind:
    SourceExpression
    SourceBody
    RuntimeValue
    BlockHandle
    NoValue


class GrammarInstruction:
    primitive: GrammarPrimitive
    arguments: list[int]
    result: int
    span: source.Span
    boolean: bool = false


class GrammarDeclaration:
    name: string
    parameters: list[FunctionParameter]
    body: Block
    span: source.Span
    syntax: OperatorSyntax | None = None
    definition: DefId = DefId(0, 0, DeclarationId(0))
    program: list[GrammarInstruction] = []
    slots: list[GrammarSlotKind] = []
    protocols: list[string] = []
    lookup: string = ""
    result: TypeAnnotation | None = None


# Source grammar contracts loaded into the shared declaration environment.
trait G:
    symbol: Y
    arity: int | absent
    precedence: int | absent
    associativity: Associativity | absent
    left: Operand | absent
    right: Operand | absent
    result: T | absent
    evaluation: Evaluation
    effects: Effects
    conversions: Conversions
    overflow: Overflow | absent
    underflow: Underflow | absent
    control_flow: ControlFlow | absent
    short_circuit: bool | absent
    const: bool
    foldable: bool
    operations: {T: ScalarOperation}

    def valid(left: Ex, right: Ex) -> bool
    def semantic(left: Ex, right: Ex) -> X


