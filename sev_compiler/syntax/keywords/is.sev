import G from "../generic/grammar.sev"
import Associativity, Fixity from "../function/syntax.sev"
import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "keyword.sev"


def recognize_is(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "is")


class IsKeyword: Y
    token_forms: list[TokenForm] = [TokenForm("IS", "is", recognize=recognize_is)]


trait Is: G
    symbol: Y = IsKeyword()
    fixity: Fixity = Fixity.Infix
    precedence: int = 3
    associativity: Associativity = Associativity.None
