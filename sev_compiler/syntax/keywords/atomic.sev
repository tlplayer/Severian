import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "../keywords/keyword.sev"


def recognize_atomic(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "atomic")


class AtomicSyntax: Y
    token_forms: list[TokenForm] = [TokenForm("ATOMIC", "atomic", recognize=recognize_atomic)]
