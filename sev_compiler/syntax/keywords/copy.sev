import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "keyword.sev"


def recognize_copy(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "copy")


class CopyKeyword: Y
    token_forms: list[TokenForm] = [TokenForm("COPY", "copy", recognize=recognize_copy)]
