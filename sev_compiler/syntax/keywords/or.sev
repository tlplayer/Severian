import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "keyword.sev"


def recognize_or(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "or")


class OrKeyword: Y
    token_forms: list[TokenForm] = [TokenForm("OR", "or", recognize=recognize_or)]
