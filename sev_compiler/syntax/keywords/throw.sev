import Expression from "../function/function.sev"
import G from "../generic/grammar.sev"
import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "keyword.sev"


def recognize_throw(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "throw")


class ThrowKeyword: Y
    token_forms: list[TokenForm] = [TokenForm("THROW", "throw", recognize=recognize_throw)]


trait Throw: G
    symbol: Y = ThrowKeyword()
    control_flow: ControlFlow = Error

    def semantic(value: Expression):
        result = lower(value)
        cfg.throw(result)
