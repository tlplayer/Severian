import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "keyword.sev"


def recognize_in(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "in")


class InKeyword: Y
    token_forms: list[TokenForm] = [TokenForm("IN", "in", recognize=recognize_in)]
