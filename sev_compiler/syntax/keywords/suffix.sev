import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "../keywords/keyword.sev"
import Expression from "../function/function.sev"
import AttachmentRole, WithAttachment from "../constraint/model.sev"

def recognize_suffix(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "suffix")


class SuffixSyntax: Y
    token_forms: list[TokenForm] = [TokenForm("SUFFIX", "suffix", recognize=recognize_suffix)]

    grammar attachment["suffix", condition: Expression]() -> WithAttachment:
        return WithAttachment(AttachmentRole.Exit, condition)
