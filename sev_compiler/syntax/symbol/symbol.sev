import Y from "../generic/symbol.sev"

class SymbolName:
    value: string

enum SymbolKind:
    Function
    Data
    ThreadLocal

trait IndexedID:
    index: u32

trait StableID:
    value: u128

trait NamedID:
    value: string

class HIRID: IndexedID
    index: u32

class BindingID: IndexedID
    index: u32

class VariantID: IndexedID
    index: u32

class ValueID: IndexedID
    index: u32

class TypeID: IndexedID
    index: u32

class GenericParamID: IndexedID
    index: u32

class InferVarID: IndexedID
    index: u32

class RegionID: IndexedID
    index: u32

class DeclarationID: StableID
    value: u128

class PrimitiveID:
    declaration: DeclarationID

class CompilerID: StableID
    value: u128

class DefinitionID:
    package: u128
    module: u128
    declaration: DeclarationID

class TypeBinding:
    parameter: GenericParamID
    type_id: TypeID

class TypeConstructorBinding:
    parameter: GenericParamID
    definition: DefinitionID

class Substitution:
    arguments: list[TypeBinding] = []

    def get(parameter: GenericParamID) -> TypeID | None:
        for binding in arguments:
            if binding.parameter.index == parameter.index:
                return binding.type_id
        return None

    def bind(parameter: GenericParamID, type: TypeID):
        for binding in arguments:
            if binding.parameter.index == parameter.index:
                if binding.type_id.index != type.index:
                    throw Error("conflicting generic type binding")
                return
        position := 0
        while position < len(arguments)
            and arguments[position].parameter.index < parameter.index:
            position += 1
        arguments.insert(position, TypeBinding(parameter, type))

class OpID:
    dialect: u128
    operation: u128

class AttributeID: StableID
    value: u128

enum AttrValue:
    Integer(value: i128)
    Boolean(value: bool)
    String(value: string)
    Type(value: TypeID)
    Types(value: list[TypeID])

class BlockID: IndexedID
    index: u32

class LocalID: IndexedID
    index: u32

class ScopeID:
    module: ModuleID

class PackageID: IndexedID
    index: u32

class CompiledRegionID: IndexedID
    index: u32

class ArtifactID: IndexedID
    index: u32

class FunctionID: StableID
    value: u128

class ModuleID: StableID
    value: u128

class ProviderID: StableID
    value: u128

class InterfaceID: NamedID
    value: string

class FFIID: NamedID
    value: string

class ABIID: NamedID
    value: string

class SymbolID: NamedID
    value: string

class Symbol: Y
    name: SymbolName
    kind: SymbolKind
    id: SymbolID | None = None

'''
Versioned, deterministic digest. Both accumulators stay below 2**61 before
multiplication, so the calculation cannot overflow its u128 intermediates.
Full semantic keys remain alongside IDs for collision diagnostics.
'''
def semantic_digest(key: string) -> u128:
    first: u128 := 1469598103934665603
    second: u128 := 1099511628211
    modulus: u128 = 2305843009213693951
    for byte in key.bytes():
        first = (first * 257 + u128(byte) + 1) % modulus
        second = (second * 263 + u128(byte) + 1) % modulus
    return first * 2305843009213693952 + second

def definition_from_key(key: string) -> DefinitionID:
    return DefinitionID(
        2,
        semantic_digest("definition-owner-2:" + key),
        DeclarationID(semantic_digest(key)),
    )

def same_definition(left: DefinitionID, right: DefinitionID) -> bool:
    return
        left.package
        == right.package
        and left.module
        == right.module
        and left.declaration.value
        == right.declaration.value

def named_definition(owner: string, kind: string, name: string) -> DefinitionID:
    return definition_from_key(semantic_key([owner, kind, name]))

# Keys are explicit strings, not runtime hash() values or source coordinates.
def semantic_key(parts: list[string]) -> string:
    encoded: list[string] = []
    for part in parts:
        encoded.append("""{len(part)}:{part}""")
    return "semantic-2:" + encoded.join("")
