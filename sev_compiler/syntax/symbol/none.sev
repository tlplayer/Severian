import LiteralValue, LiteralValueOf from "../grammar/resolution.sev"
import scalar_mlir from "../primitive/mlir.sev"
import Constructor,
    DeclarationID,
    LiteralSyntax,
    MLIRTypeBinding,
    Primitive,
    PrimitiveCategory,
    PrimitiveID,
    PrimitiveRepresentation,
    Size,
    TypeID from "../primitive/contract.sev"

class NoneValuePrimitive: Primitive
    grammar literal["None"]() -> None:
        return None

    mlir: MLIRTypeBinding = scalar_mlir("!llvm.ptr", "pointer")
    identity: PrimitiveID = PrimitiveID(DeclarationID(6))
    id: TypeID = TypeID(6)
    name: string = "None"
    size: Size = Size.Pointer
    alignment: Size = Size.Pointer
    constructors: list[Constructor] = []
    category: PrimitiveCategory = PrimitiveCategory.Absence
    representation: PrimitiveRepresentation =
        PrimitiveRepresentation.PointerBits(64)
    token_kind: string = "Identifier"
    literal_family: string = ""
    literal_syntaxes: list[LiteralSyntax] = [
        LiteralSyntax("Identifier", "None", LiteralValueOf[None](None)),
    ]
    default_literal: bool = true

def none_type_id() -> TypeID:
    return NoneValuePrimitive().id
