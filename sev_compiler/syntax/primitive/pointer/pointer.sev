trait Pointer[T]: Primitive
    operator store(self, value: T)
    operator[](self) -> T
    operator +(self, bytes: int) -> self

    operator address(self) -> u64

class pointer[T]: Pointer
    identity: PrimitiveID = PointerPrimitive().identity
    mlir: MLIRTypeBinding = PointerPrimitive().mlir
    id: TypeID = PointerPrimitive().id
    token_kind: string = PointerPrimitive().token_kind
    literal_family: string = PointerPrimitive().literal_family
    literal_syntaxes: list[LiteralSyntax] = PointerPrimitive().literal_syntaxes

    # The address uses the same c pointer contract as memory and @c.
    __address: pointer
