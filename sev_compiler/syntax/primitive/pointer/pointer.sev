import * from "../declarations.sev"
import * from "../../../../library/core/memory/src/raw_intrinsics.sev"

trait Pointer[T]: Primitive:
    operator store(self, value: T)
    operator [](self) -> T
    operator +(self, bytes: int) -> self

    operator address(self) -> u64


class pointer[T]: Pointer:
    identity: PrimitiveId = PointerPrimitive().identity
    mlir: MlirTypeBinding = PointerPrimitive().mlir
    id: TypeId = PointerPrimitive().id
    literal: LiteralSyntax | None = PointerPrimitive().literal
    literal_family: string = PointerPrimitive().literal_family
    literal_bindings: list[LiteralBinding] = PointerPrimitive().literal_bindings
    # The address uses the same native pointer contract as memory and @c.
    __address: pointer

    
