import "../../../../library/core/storage/src/buffer.sev" as storage

# Typed rank-one arrays use the shared storage/memory allocation boundary.
# char[T] is an ordinary element type here, with the same loans and ownership
# as every other typed array. There is no character-specific allocator.
def allocate[T](count: int) -> array[T]:
    return storage.allocate[T](count)


def copy[T](value: view array[T]) -> array[T]:
    return storage.copy(value)


@mlir("arith.index_cast")
def _index(value: int) -> index

@mlir("arith.index_cast")
def _size(value: index) -> int

@mlir("memref.dim")
def __dimension[T](value: view array[T], axis: index) -> index

@mlir("memref.load")
def _load[T](value: view array[T], position: index) -> T

@mlir("memref.store")
def _store[T](item: T, value: borrow array[T], position: index)


def length[T](value: view array[T]) -> int:
    return _size(__dimension(value, _index(0)))


def read[T](value: view array[T], position: int) -> T:
    assert(position >= 0 and position < length(value))
    return _load(value, _index(position))


def write[T](value: borrow array[T], position: int, item: T):
    assert(position >= 0 and position < length(value))
    _store(item, value, _index(position))
