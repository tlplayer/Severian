import LiteralValue, LiteralValueOf from "../../grammar/resolution.sev"
import scalar_mlir from "../mlir.sev"
import Constructor,
    DeclarationID,
    LiteralSyntax,
    MLIRTypeBinding,
    Primitive,
    PrimitiveCategory,
    PrimitiveID,
    PrimitiveRepresentation,
    Size,
    TypeID from "../contract.sev"

class BoolPrimitive: Primitive
    mlir: MLIRTypeBinding = scalar_mlir("i1", "integer", 1)
    identity: PrimitiveID = PrimitiveID(DeclarationID(1))
    id: TypeID = TypeID(1)
    name: string = "bool"
    size: Size = Size.Fixed(1)
    alignment: Size = Size.Fixed(1)
    constructors: list[Constructor] = []
    category: PrimitiveCategory = PrimitiveCategory.Boolean
    representation: PrimitiveRepresentation = PrimitiveRepresentation.BooleanBit
    token_kind: string = "Identifier"
    literal_family: string = ""
    literal_syntaxes: list[LiteralSyntax] = [
        LiteralSyntax("Identifier", "true", LiteralValueOf[bool](true)),
        LiteralSyntax("Identifier", "false", LiteralValueOf[bool](false)),
    ]
    default_literal: bool = true

def bool_type_id() -> TypeID:
    return BoolPrimitive().id
