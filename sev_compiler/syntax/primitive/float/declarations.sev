import scalar_mlir from "../mlir.sev"
import Constructor, DeclarationId, LiteralSyntax, MlirTypeBinding, Primitive, PrimitiveCategory, PrimitiveId, PrimitiveRepresentation, Size, TypeId from "../contract.sev"


class F32Primitive: Primitive
    mlir: MlirTypeBinding = scalar_mlir("f32", "ieee_float", 32, true)
    identity: PrimitiveId = PrimitiveId(DeclarationId(163))
    id: TypeId = TypeId(163)
    name: string = "f32"
    size: Size = Size.Fixed(4)
    alignment: Size = Size.Fixed(4)
    constructors: list[Constructor] = []
    category: PrimitiveCategory = PrimitiveCategory.Float
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IeeeFloatBits(32)
    token_kind: string = "Float"
    literal_family: string = "float"
    literal_syntaxes: list[LiteralSyntax] = [LiteralSyntax("Float")]
    default_literal: bool = false


def f32_type_id() -> TypeId:
    return F32Primitive().id


