import decode_four, decode_three, decode_two, valid, width from "encoding.sev"

@mlir("arith.extui")
def codepoint(value: char) -> int


@mlir("arith.trunci")
def __scalar(value: int) -> char


def from_codepoint(value: int) -> char:
    assert(valid(value))
    return __scalar(value)


test "character literals preserve Unicode scalars and escapes":
    assert(codepoint('a') == 97)
    assert(codepoint('λ') == 955)
    assert(codepoint('中') == 20013)
    assert(codepoint('😀') == 128512)
    assert(codepoint('\n') == 10)

def literal_value(spelling: string, delimiter: string) -> string | None:
    width = len(delimiter)
    length = len(spelling)
    if width == 0 or length < width * 2:
        return None
    if not spelling.starts_with(delimiter) or not spelling.ends_with(delimiter):
        return None
    end = length - width
    offset := width
    value := ""
    while offset < end:
        if spelling[offset:offset + width] == delimiter:
            return None
        current = spelling[offset]
        if width == 1 and (current == '\n' or current == '\r'):
            return None
        if current != '\\':
            value += string(current)
            offset += 1
            continue
        offset += 1
        if offset == end:
            return None
        escaped = spelling[offset]
        if escaped == 'n':
            value += "\n"
        elif escaped == 'r':
            value += "\r"
        elif escaped == 't':
            value += "\t"
        elif escaped == '0':
            value += "\0"
        elif escaped == '\\' or escaped == '\'' or escaped == '"':
            value += string(escaped)
        elif escaped == 'x' or escaped == 'u' or escaped == 'U':
            count := 2 if escaped == 'x' else (4 if escaped == 'u' else 8)
            start := offset + 1
            braced = escaped == 'u' and start < end and spelling[start] == '{'
            if braced:
                start += 1
                stop := start
                while stop < end and spelling[stop] != '}':
                    stop += 1
                count = stop - start
                if stop == end or count == 0 or count > 6:
                    return None
            if start + count > end:
                return None
            scalar: u32 := 0
            for digit in spelling[start:start + count]:
            number: u32 := 0
                if digit >= '0' and digit <= '9':
                    number = u32(digit) - u32('0')
                elif digit >= 'a' and digit <= 'f':
                    number = u32(digit) - u32('a') + 10
                elif digit >= 'A' and digit <= 'F':
                    number = u32(digit) - u32('A') + 10
                else:
                    return None
                scalar = scalar * 16 + number
            if scalar > 0x10ffff or (scalar >= 0xd800 and scalar <= 0xdfff):
                return None
            value += string(char(scalar))
            offset = start + count
            if braced:
                offset += 1
            continue
        else:
            return None
        offset += 1
    return value


test "literal decoding shares Unicode and escape validation":
    assert(literal_value("'λ'", "'") == "λ")
    assert(literal_value("'\\u{1f600}'", "'") == "😀")
    assert(literal_value("'\\n'", "'") == "\n")
    assert(literal_value("'\\uD800'", "'") == None)
    assert(literal_value("'\\U00110000'", "'") == None)
    assert(literal_value("'\\u{}'", "'") == None)
    assert(literal_value("'\\q'", "'") == None)
    assert(literal_value("'x", "'") == None)
