'''
Unicode scalar arithmetic shared by literal decoding and the compiled string
implementation. This module requires only integer and Boolean primitives.
'''
def valid(value: int) -> bool:
    if value < 0:
        return false
    if value > 1114111:
        return false
    if value < 55296:
        return true
    return value > 57343

test "Unicode scalars exclude surrogates and out-of-range values":
    assert:
        valid(0)
        valid(1114111)
        not valid(-1)
        not valid(1114112)
        not valid(55296)
        not valid(57343)

def width(value: int) -> int:
    assert(valid(value))
    if value <= 127:
        return 1
    if value <= 2047:
        return 2
    if value <= 65535:
        return 3
    return 4

test "UTF-8 widths change at scalar boundaries":
    assert:
        width(127) == 1
        width(128) == 2
        width(2047) == 2
        width(2048) == 3
        width(65535) == 3
        width(65536) == 4
        width(1114111) == 4

def decode_two(first: int, second: int) -> int:
    assert(first >= 194 and first <= 223)
    assert(second >= 128 and second <= 191)
    return (first - 192) * 64 + second - 128

def decode_three(first: int, second: int, third: int) -> int:
    assert(first >= 224 and first <= 239)
    assert(second >= 128 and second <= 191)
    assert(third >= 128 and third <= 191)
    decoded = (first - 224) * 4096 + (second - 128) * 64 + third - 128
    assert(decoded >= 2048 and valid(decoded))
    return decoded

def decode_four(first: int, second: int, third: int, fourth: int) -> int:
    assert(first >= 240 and first <= 244)
    assert(second >= 128 and second <= 191)
    assert(third >= 128 and third <= 191)
    assert(fourth >= 128 and fourth <= 191)
    decoded = (
        first
        -240
    ) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128
    assert(decoded >= 65536 and valid(decoded))
    return decoded

test "UTF-8 decoding checks scalar encoding boundaries":
    assert:
        decode_two(194, 128) == 128
        decode_two(223, 191) == 2047
        decode_three(224, 160, 128) == 2048
        decode_three(237, 159, 191) == 55295
        decode_three(238, 128, 128) == 57344
        decode_three(239, 191, 191) == 65535
        decode_four(
            first = 240,
            second = 144,
            third = 128,
            fourth = 128,
        ) == 65536
        decode_four(
            first = 244,
            second = 143,
            third = 191,
            fourth = 191,
        ) == 1114111

def literal_codepoint(value: string) -> u32:
    bytes = value.bytes()
    if len(bytes) == 1:
        return u32(bytes[0])
    if len(bytes) == 2:
        return u32(decode_two(int(bytes[0]), int(bytes[1])))
    if len(bytes) == 3:
        return u32(decode_three(int(bytes[0]), int(bytes[1]), int(bytes[2])))
    return u32(
        decode_four(
            first = int(bytes[0]),
            second = int(bytes[1]),
            third = int(bytes[2]),
            fourth = int(bytes[3]),
        ),
    )
