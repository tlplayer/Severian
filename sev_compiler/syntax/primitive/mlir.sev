import MLIRTypeBinding,
    MLIRTypeParameter,
    MLIRTypeProvider from "../type/mlir.sev"

'''
Built-in constructors are declaration data. New dialect types provide their
own binding, without extending lowering or the MLIR text printer.
'''
def scalar_mlir(
    spelling: string,
    scalar: string,
    bits: u16 = 0,
    signed: bool = false,
) -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = spelling,
        category = "scalar",
        scalar = scalar,
        bits = bits,
        signed = signed,
        dimensions = 0,
        elements = 0,
    )

def tensor_mlir() -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = "tensor<{shape}{element}>",
        category = "tensor",
        elements = 0,
    )

def unranked_tensor_mlir() -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = "tensor<*x{element}>",
        category = "unranked_tensor",
        dimensions = 0,
        elements = 0,
        ranked = false,
    )

def memref_mlir() -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = "memref<{shape}{element}>",
        category = "memref",
        elements = 0,
        storage = ranked_memref_storage(),
    )

def unranked_memref_mlir() -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = "memref<*x{element}>",
        category = "unranked_memref",
        dimensions = 0,
        elements = 0,
        ranked = false,
        storage = MLIRTypeBinding("!llvm.struct<(i64, !llvm.ptr)>", "struct"),
    )

def struct_mlir() -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = "!llvm.struct<({elements})>",
        category = "struct",
        dimensions = 0,
    )

def array_mlir() -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = "!llvm.array<{dimension0} x {element0}>",
        category = "array",
        dimensions = 1,
        elements = 1,
    )

'''
Hosted primitive declarations own the current index/storage ABI. Alternate
targets may supply bindings with a different index width.
'''
def index_mlir(bits: u16 = 64) -> MLIRTypeBinding:
    binding = scalar_mlir("index", "index")
    binding.storage = scalar_mlir(
        spelling = "i" + string(bits),
        scalar = "integer",
        bits = bits,
        signed = true,
    )
    return binding

def ranked_memref_storage(bits: u16 = 64) -> MLIRTypeBinding:
    index = "i" + string(bits)
    return MLIRTypeBinding(
        """\
!llvm.struct<(!llvm.ptr, !llvm.ptr, {index}, !llvm.array<{{rank}} x {index}>, !\
llvm.array<{{rank}} x {index}>)>\
""",
        "struct",
    )

def byte_view_mlir() -> MLIRTypeBinding:
    return MLIRTypeBinding(
        spelling = "memref<?xi8>",
        category = "memref",
        dimensions = 1,
        elements = 0,
        storage = ranked_memref_storage(),
    )
