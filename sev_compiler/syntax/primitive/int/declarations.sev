import index_mlir, scalar_mlir from "../mlir.sev"
import Constructor,
    DeclarationID,
    LiteralSyntax,
    MLIRTypeBinding,
    Primitive,
    PrimitiveCategory,
    PrimitiveID,
    PrimitiveRepresentation,
    Size,
    TypeID from "../contract.sev"

class IndexPrimitive: Primitive
    mlir: MLIRTypeBinding = index_mlir()
    identity: PrimitiveID = PrimitiveID(DeclarationID(4))
    id: TypeID = TypeID(4)
    name: string = "index"
    size: Size = Size.Pointer
    alignment: Size = Size.Pointer
    constructors: list[Constructor] = []
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation =
        PrimitiveRepresentation.IntegerBits(64, true)
    token_kind: string = "Integer"
    literal_family: string = "int"
    literal_syntaxes: list[LiteralSyntax] = [LiteralSyntax("Integer")]
    default_literal: bool = false

def index_type_id() -> TypeID:
    return IndexPrimitive().id

class U8Primitive: Primitive
    mlir: MLIRTypeBinding = scalar_mlir(
        spelling = "i8",
        scalar = "integer",
        bits = 8,
        signed = false,
    )
    identity: PrimitiveID = PrimitiveID(DeclarationID(108))
    id: TypeID = TypeID(108)
    name: string = "u8"
    size: Size = Size.Fixed(1)
    alignment: Size = Size.Fixed(1)
    constructors: list[Constructor] = []
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation =
        PrimitiveRepresentation.IntegerBits(8, false)
    token_kind: string = "Integer"
    literal_family: string = "int"
    literal_syntaxes: list[LiteralSyntax] = [LiteralSyntax("Integer")]
    default_literal: bool = false

def u8_type_id() -> TypeID:
    return U8Primitive().id

