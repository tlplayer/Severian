import Lexeme, LexemeTerm, TokenTerm from "../generic/token.sev"

enum PrimitiveCategory:
    Boolean
    Integer
    Float
    Char
    String
    Bytes
    Absence
    Unit
    Pointer

enum PrimitiveRepresentation:
    BooleanBit
    IntegerBits(bits: u16, signed: bool)
    IeeeFloatBits(bits: u16)
    BrainFloatBits(bits: u16)
    FloatBits(
        bits: u16,
        exponent_bits: u16,
        fraction_bits: u16,
        supports_infinity: bool,
    )
    PointerBits(bits: u16)
    RecordAggregate
    TaggedAggregate

import L, Literal, LiteralSyntax from "../generic/literal.sev"
import Y from "../generic/symbol.sev"
import Type from "../generic/type.sev"

'''
Identity and literal behavior are required parts of the primitive contract.
TypeId is a compilation handle; identity is the declaration's stable identity.
'''
trait Primitive: Type + Y + L + MLIRTypeProvider
    identity: PrimitiveID
    id: TypeID
    category: PrimitiveCategory
    representation: PrimitiveRepresentation

trait PrimitiveAlias[T]: Primitive

class LiteralConstruction:
    primitive: PrimitiveID
    type_id: TypeID
    family: string
    syntax: LiteralSyntax
    value: LiteralValue
    spelling: string
    span: Span
