class PrimitiveDescriptor: Primitive
    identity: PrimitiveID
    id: TypeID
    name: string
    size: Size
    alignment: Size
    constructors: list[Constructor]
    category: PrimitiveCategory
    representation: PrimitiveRepresentation
    default_literal: bool
    literal_family: string = ""
    literal_syntaxes: list[LiteralSyntax] = []
    mlir: MLIRTypeBinding = MLIRTypeBinding(spelling = "", value = false)
    token_kind: string = "Identifier"

def describe_primitive[T: Primitive](value: T) -> PrimitiveDescriptor:
    return PrimitiveDescriptor(
        identity = value.identity,
        id = value.id,
        name = value.name,
        size = value.size,
        alignment = value.alignment,
        constructors = value.constructors,
        category = value.category,
        representation = value.representation,
        default_literal = value.default_literal,
        literal_family = value.literal_family,
        literal_syntaxes = value.literal_syntaxes,
        mlir = value.mlir,
        token_kind = value.token_kind,
    )

primitive_catalog: list[PrimitiveDescriptor] = []

def primitive_descriptors() -> list[PrimitiveDescriptor]:
    if len(primitive_catalog) == 0:
        primitive_catalog.append(describe_primitive(BoolPrimitive()))
        primitive_catalog.append(describe_primitive(Byte()))
        primitive_catalog.append(describe_primitive(StringPrimitive()))
        primitive_catalog.append(describe_primitive(IndexPrimitive()))
        primitive_catalog.append(describe_primitive(PointerPrimitive()))
        primitive_catalog.append(describe_primitive(NoneValuePrimitive()))
        primitive_catalog.append(describe_primitive(AbsentPrimitive()))
        primitive_catalog.append(describe_primitive(F32Primitive()))
        primitive_catalog.append(describe_primitive(F64Primitive()))
        primitive_catalog.append(describe_primitive(U8Primitive()))
        primitive_catalog.append(describe_primitive(U16Primitive()))
        primitive_catalog.append(describe_primitive(U32Primitive()))
        primitive_catalog.append(describe_primitive(U64Primitive()))
        primitive_catalog.append(describe_primitive(CharPrimitive()))
        primitive_catalog.append(describe_primitive(I8Primitive()))
        primitive_catalog.append(describe_primitive(I16Primitive()))
        primitive_catalog.append(describe_primitive(I32Primitive()))
        primitive_catalog.append(describe_primitive(I64Primitive()))
        primitive_catalog.append(describe_primitive(I128Primitive()))
        primitive_catalog.append(describe_primitive(U128Primitive()))
        primitive_catalog.append(describe_primitive(F16Primitive()))
        primitive_catalog.append(describe_primitive(F128Primitive()))
        primitive_catalog.append(describe_primitive(F8E4M3FnPrimitive()))
        primitive_catalog.append(describe_primitive(F8E5M2Primitive()))
        primitive_catalog.append(describe_primitive(Bf16Primitive()))
    return primitive_catalog

def primitive_descriptor(id: TypeID) -> PrimitiveDescriptor | None:
    for descriptor in primitive_descriptors():
        if descriptor.id.index == id.index:
            return descriptor
    return None

'''
Compatibility projection for existing scalar lowering consumers. It contains
no independent identity, representation or literal-default decisions.
'''
class ScalarType:
    id: TypeID
    name: string
    bits: u16
    boolean: bool
    representation: string = "integer"
    signed: bool = true
    mlir: MLIRTypeBinding = MLIRTypeBinding(spelling = "", value = false)
    element: TypeID = TypeID(0)

def scalar_from_primitive(value: PrimitiveDescriptor) -> ScalarType:
    result = ScalarType(
        id = value.id,
        name = value.name,
        bits = 0,
        boolean = value.category == PrimitiveCategory.Boolean,
    )
    match value.representation:
        case BooleanBit:
            result.bits = 1
        case IntegerBits:
            result.bits = bits
            result.signed = signed
        case IeeeFloatBits:
            result.bits = bits
            result.representation = "float"
        case BrainFloatBits:
            result.bits = bits
            result.representation = "float"
        case FloatBits:
            result.bits = bits
            result.representation = "float"
        case PointerBits:
            result.bits = bits
            result.representation = "pointer"
        case RecordAggregate:
            if value.category == PrimitiveCategory.String:
                result.bits = 8
                result.representation = "utf8"
        case TaggedAggregate:
            result.representation = "aggregate"
    if value.id.index == index_type_id().index:
        result.representation = "index"
    result.mlir = value.mlir
    return result

def scalar_identities() -> list[int]:
    result: list[int] = []
    for descriptor in primitive_descriptors():
        result.append(int(descriptor.id.index))
    return result

def scalar_types() -> list[ScalarType]:
    result: list[ScalarType] = []
    for descriptor in primitive_descriptors():
        result.append(scalar_from_primitive(descriptor))
    return result

@record_calls
def make_scalar_descriptor(id: TypeID, name: string = "") -> ScalarType | None:
    for descriptor in primitive_descriptors():
        if (id.index == 0 or descriptor.id.index == id.index)
            and (name == "" or descriptor.name == name):
            return scalar_from_primitive(descriptor)
    return None

class ScalarSlot:
    value: ScalarType | None

scalar_catalog: list[ScalarSlot] = []

'''
Legacy buffer handles remain an archive ABI adapter until structural buffer
identities are migrated. No caller may infer primitive facts from this offset.
'''
def initialize_scalar_catalog():
    for index in range(1000):
        scalar_catalog.append(ScalarSlot(None))
    for primitive in primitive_descriptors():
        descriptor = scalar_from_primitive(primitive)
        identity = int(descriptor.id.index)
        if identity >= 800
            or scalar_catalog[identity].value != None
            or scalar_catalog[identity + 200].value != None:
            throw Error("duplicate or out-of-range primitive identity")
        scalar_catalog[identity] = ScalarSlot(descriptor)
        scalar_catalog[identity + 200] = ScalarSlot(
            ScalarType(
                id = TypeID(u32(identity + 200)),
                name = "$buffer$" + descriptor.name,
                bits = descriptor.bits,
                boolean = false,
                representation = "buffer",
                mlir = memref_mlir(),
                element = descriptor.id,
            ),
        )

def scalar_descriptor(id: TypeID, name: string = "") -> ScalarType | None:
    if len(scalar_catalog) == 0:
        initialize_scalar_catalog()
    if name != "":
        return make_scalar_descriptor(id, name)
    if id.index < len(scalar_catalog):
        selected ?= scalar_catalog[id.index].value
        if selected != None:
            if selected.representation != "buffer":
                return selected
    return None

def scalar_type(id: TypeID) -> ScalarType | None:
    if len(scalar_catalog) == 0:
        initialize_scalar_catalog()
    if id.index < len(scalar_catalog):
        return scalar_catalog[id.index].value
    return None

def scalar_type_name(name: string) -> TypeID | None:
    if name == "usize":
        return u64_type_id()
    if name == "isize" or name == "int":
        return i64_type_id()
    if name == "float":
        return f64_type_id()
    buffer = name.starts_with("$buffer$")
    spelling = name[8:] if buffer else name
    known ?= scalar_descriptor(TypeID(0), spelling)
    if known != None:
        return TypeID(known.id.index + 200) if buffer else known.id
    return None

def scalar_representation(id: TypeID) -> string:
    known ?= scalar_type(id)
    if known != None:
        return known.representation
    return "unknown"

def integer_minimum(type: ScalarType) -> string:
    if not type.signed:
        return "0"
    if type.bits == 128:
        return "-170141183460469231731687303715884105728"
    if type.bits == 64:
        return "-9223372036854775808"
    return "-" + string(1 <<(int(type.bits) - 1))

def integer_maximum(type: ScalarType) -> string:
    if type.bits == 128:
        return
            "170141183460469231731687303715884105727"
            if type.signed else "340282366920938463463374607431768211455"
    if type.bits == 64:
        return "9223372036854775807" if type.signed else "18446744073709551615"
    return string((1 <<(int(type.bits) - (1 if type.signed else 0))) - 1)

test "primitive descriptor preserves custom token kinds without an enum":
    primitive = I64Primitive()
    primitive.token_kind = "WholeNumber"
    descriptor = describe_primitive(primitive)
    assert(descriptor.token_kind == "WholeNumber")
    assert(describe_primitive(PointerPrimitive()).token_kind == "Identifier")

test "byte has a distinct primitive identity and storage unit family":
    descriptor ?= primitive_descriptor(Byte().id)
    assert:
        descriptor != None
        descriptor.name == "byte"
        descriptor.category == PrimitiveCategory.Bytes
        descriptor.literal_family == "byte"
        descriptor.id != i64_type_id()
    identities: list[u32] = []
    for primitive in primitive_descriptors():
        assert(primitive.id.index not in identities)
        identities.append(primitive.id.index)
