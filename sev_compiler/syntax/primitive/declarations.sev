test "primitive declarations own their lexical categories":
    assert(I64Primitive().token_kind == "Integer")
    assert(F64Primitive().token_kind == "Float")
    assert(StringPrimitive().token_kind == "String")
    assert(CharPrimitive().token_kind == "Character")
    assert(PointerPrimitive().token_kind == "Identifier")
