enum ErrorType:
    E {0} # Error: execution cannot proceed normally
    C {1} # Compiler: Could not compile the application
    U {2} # User error ie the format/input is bad and caused this
    W {3} # Warning: valid but suspicious/problematic
    N {4} # Note: supporting context
    H {5} # Help: suggested action
    L {6} # Lint: The format/code quality is diminished from this

enum ErrorPersistence:
    Transient # After a time this might succeed again
    Permanent # This will not succeed even after waiting
    Panic # This cannot recover or succeed


trait Error:
    type: ErrorType
    persistence: ErrorPersistence
    category: int {0 <= category <= 999}
    code: int {0 <= code <= 999}
    note: string {10 <= len(note) <= 200}
    help: string {10 <= len(help) <= 200}
    prefix: string | absent


def Error(message: string) -> MessageError:
    return MessageError(message)


