enum ErrorType:

    # Error: execution cannot proceed normally
    E {0}

    # Compiler: Could not compile the application
    C {1}

    # User error ie the format/input is bad and caused this
    U {2}

    # Warning: valid but suspicious/problematic
    W {3}

    # Note: supporting context
    N {4}

    # Help: suggested action
    H {5}

    # Lint: The format/code quality is diminished from this
    L {6}

enum ErrorPersistence:

    # After a time this might succeed again
    Transient

    # This will not succeed even after waiting
    Permanent

    # This cannot recover or succeed
    Panic

trait Error:
    type: ErrorType
    persistence: ErrorPersistence
    category: int {0 <= category <= 999}
    code: int {0 <= code <= 999}
    note: string {10 <= len(note) <= 200}
    help: string {10 <= len(help) <= 200}
    prefix: string | absent

class MessageError: Error
    note: string
    type: ErrorType = ErrorType.E
    persistence: ErrorPersistence = ErrorPersistence.Permanent
    category: int = 0
    code: int = 0
    help: string = "Inspect the operation that reported this error."
    prefix: string | absent = absent
