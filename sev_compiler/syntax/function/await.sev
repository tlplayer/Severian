import Expression from "function.sev"
import Y from "../generic/symbol.sev"
import TokenForm from "../generic/token.sev"
import SourceFile from "../source.sev"
import recognize_keyword from "../keywords/keyword.sev"


def recognize_await(source: SourceFile, start: u32) -> u32 | None:
    return recognize_keyword(source, start, "await")


class AwaitSyntax: Y
    token_forms: list[TokenForm] = [TokenForm("AWAIT", "await", recognize=recognize_await)]
    task: Expression | None = None

    grammar call["await", task: Expression]() -> AwaitSyntax:
        return AwaitSyntax(task=task)
