# Callable identity, parameters, bodies, and expression use share one model.
class CompilerCapability:
    name: string

enum CompileRoute:
    Standard
    Compiler(compiler: CompilerID)

class BoundaryModifier:
    name: string

class FieldConstraint:
    condition: Expression
    failure: Expression | None = None

class MockFunction:
    original: string
    replacement: string

class FunctionParameter:
    name: string
    annotation: TypeAnnotation
    default: Expression | absent
    span: source.Span
    binding: BindingID = BindingID(0)
    type_id: TypeID = TypeID(0)
    modifiers: list[BoundaryModifier] = []
    variadic: bool = false
    keyword_only: bool = false
    pack: string = ""
    field_constraints: list[FieldConstraint] = []

class ExternalCall:
    interface: InterfaceID
    symbol: SymbolID
    provider: ProviderID | None
    ffi: FFIID
    abi: ABIID

enum CallType:
    Severian
    External(call: ExternalCall)

enum FunctionLinkage:
    Internal
    External(symbol: string)

class FunctionDeclaration:
    decorators: list[Decorator] = []
    name: string = ""
    type_parameters: list[string] = []
    constraints: list[GenericConstraint] = []
    parameters: list[FunctionParameter] = []
    result: TypeAnnotation | None = None
    body: Block | None = None
    span: source.Span | None = None
    id: FunctionID = FunctionID(0)
    definition: DefinitionID = DefinitionID(0, 0, DeclarationID(0))
    generic_parameters: list[GenericParamID] = []
    parameter_types: list[TypeID] = []
    result_type: TypeID = TypeID(0)
    compile_route: CompileRoute = Standard
    call_type: CallType = Severian
    values: list[ValueID] = []
    lowered_result: LoweredType = Unit
    linkage: FunctionLinkage = Internal
    binary_requirements: map[GenericParamID, list[BinaryOperator]] =
    {
    }
    capability_requirements: map[GenericParamID, list[CompilerCapability]] =
    {
    }
    constrained: bool = false
    constraints_supported: bool = true
    lookup: string | None = None
    operator_syntax: OperatorSyntax | None = None
    owner_type: TypeID = TypeID(0)
    extension: bool = false
    template: DefinitionID | None = None
    type_arguments: list[TypeBinding] = []
    pack_specialization: bool = false
    constructor: bool = false
    result_mode: string = ""
    result_origin: int = -1
    prelude: bool = false
    type_defaults: list[TypeAnnotation] = []
    mock_functions: list[MockFunction] = []
    attachments: list[WithAttachment] = []
    semantic_key: string = ""
    dispatch_candidates: list[string] = []
    dispatch_predicates: list[Expression] = []

    '''
    Artifact location only; declaration identity remains
    definition/semantic_key.
    '''
    lazy_body: string = ""
    grammar: Grammar | None = None

def resolved_function(
    generic_parameters: list[GenericParamID],
    constrained: bool,
    constraints_supported: bool,
    binary_requirements: map[GenericParamID, list[BinaryOperator]],
    capability_requirements: map[GenericParamID, list[CompilerCapability]],
    parameter_types: list[TypeID],
    result_type: TypeID,
) -> FunctionDeclaration:
    function = FunctionDeclaration()
    function.generic_parameters = generic_parameters
    function.constrained = constrained
    function.constraints_supported = constraints_supported
    function.binary_requirements = binary_requirements
    function.capability_requirements = capability_requirements
    function.parameter_types = parameter_types
    function.result_type = result_type
    return function

class CallableAlternative:
    name: string
    fields: list[FunctionParameter]
    span: source.Span
    transitions: list[string] = []

class RecordDeclaration:
    name: string
    fields: list[FunctionParameter]
    methods: list[FunctionDeclaration]
    span: source.Span
    type_id: TypeID = TypeID(0)
    lookup: string = ""
    traits: list[TypeAnnotation] = []
    definition: DefinitionID = DefinitionID(0, 0, DeclarationID(0))
    operators: list[OperatorDeclaration] = []
    type_parameters: list[string] = []
    constraints: list[GenericConstraint] = []
    extension: bool = false
    type_pack: string = ""
    type_defaults: list[TypeAnnotation] = []
    alternatives: list[CallableAlternative] = []
    representation: string = ""
    declaration_grammar: DefinitionID = DefinitionID(0, 0, DeclarationID(0))
    storage_element: TypeID = TypeID(0)
    source_name: string = ""
    extension_target: TypeAnnotation | None = None
    decorators: list[Decorator] = []
    grammars: list[FunctionDeclaration] = []
    mlir: MLIRTypeBinding | None = None
    mlir_parameters: list[MLIRTypeParameter] = []
    mlir_arguments: list[tuple[string, TypeID]] = []
    mlir_shape: list[int] = []
    mlir_element: TypeID = TypeID(0)

def union_variants(record: RecordDeclaration) -> list[TypeID]:
    variants: list[TypeID] = []
    if record.name.starts_with("$union$"):
        for field in record.fields[1:]:
            variants.append(field.type_id)
    return variants

def outcome_variants(record: RecordDeclaration) -> list[TypeID]:
    variants: list[TypeID] = []
    if record.name.starts_with("$outcome$"):
        for field in record.fields[1:]:
            variants.append(field.type_id)
    return variants

class Expression:
    kind: ExpressionKind
    span: source.Span
    id: HIRID = HIRID(0)
    type_id: TypeID = TypeID(0)
    grammar: DefinitionID | None = None
    loan_root: int = -1
    loan_mode: string = ""
    literal: LiteralConstruction | None = None

class CallArgument:
    name: string | absent
    value: Expression
    span: source.Span
    spread: bool = false

enum ResolvedCallee:
    Direct(function: DefinitionID, substitution: Substitution)
    FunctionValue(expression: Expression)
    Method(
        implementation: DefinitionID,
        receiver: Expression,
        substitution: Substitution,
    )
    Constructor(type_definition: DefinitionID, variant: VariantID | None)
    Intrinsic(operation: OpID)

enum ExpressionKind:
    MockValue(
        calls: list[Expression],
        results: list[Expression],
        fallback: Expression,
    )
    Lambda(parameters: list[string], body: Expression)
    Ownership(mode: string, value: Expression)
    AddressOf(value: Expression)
    TypeLayout(subject: TypeID, alignment: bool)
    SourceSymbol(spelling: string, definition: DefinitionID)
    CompilerTerm(name: string, arguments: list[TypeAnnotation])
    TypeApplication(target: Expression, arguments: list[TypeAnnotation])
    LiteralValue(value: LiteralValue)
    Name(name: string)
    Member(object: Expression, name: string)
    Call(callee: Expression, arguments: list[CallArgument])
    ListLiteral(elements: list[Expression])
    MatchExpression(subject: Expression, arms: list[MatchArm])
    BlockValue(body: Block, value: Expression)
    Evaluate(value: Expression, body: Expression)
    Fallback(value: Expression, alternative: Expression)
    ThrowValue(value: Expression)
    ErrorExpectation(value: Expression | None, comparison: Expression | None)
    MapLiteral(keys: list[Expression], values: list[Expression])
    Subscript(object: Expression, index: Expression)
    Slice(
        object: Expression,
        start: Expression | None,
        stop: Expression | None,
        step: Expression | None,
    )
    ListValue(
        elements: list[Expression],
        construction: Expression,
        storage: Expression,
    )
    IndexReference(
        object: Expression,
        index: Expression,
        access: Expression,
        storage: Expression | None,
    )
    OutcomeValue(value: Expression, variant: int)
    OutcomeTest(value: Expression, variant: int)
    OutcomeUnwrap(value: Expression)
    UpdateOperand(index: int)
    BindingReference(binding: BindingID)
    FunctionReference(definition: DefinitionID)
    ResolvedCall(callee: ResolvedCallee, arguments: list[CallArgument])
    Convert(operand: Expression, conversion: ExpressionConversion)
    Unary(operator: OperatorSyntax, operand: Expression)
    Binary(operator: OperatorSyntax, left: Expression, right: Expression)
    ComparisonChain(operands: list[Expression], operators: list[OperatorSyntax])
    Conditional(
        condition: Expression,
        then_value: Expression,
        else_value: Expression,
    )
    Stringify(value: Expression)
    TypeName(value: Expression, name: string)
    RecordValue(fields: list[CallArgument])
    FieldReference(object: Expression, index: int)
    RequiredMember(object: Expression, requirement: DefinitionID, name: string)

def resolve_expression(
    expression: Expression,
    id: HIRID,
    type_id: TypeID,
    kind: ExpressionKind,
) -> Expression:
    expression.id = id
    expression.type_id = type_id
    expression.kind = kind
    return expression

class ExpressionConversion:
    from_type: TypeID
    to_type: TypeID
    kind: ExpressionConversionKind

enum ExpressionConversionKind:
    NumericWidening
    UnionInjection
    Borrow
    User(function: DefinitionID)

enum Operation:
    DebugOwnership(name: string, mode: string, span: source.Span)
    DebugLocation(span: source.Span)
    DebugValue(
        name: string,
        value: ValueID,
        span: source.Span,
        argument: int,
        ownership: string,
        address: bool,
        declared_type: TypeID,
    )
    TypeLayout(subject: TypeID, alignment: bool, result: ValueID)
    Coverage(point: CoveragePoint)

    # Accepts a tagged aggregate or its decomposed integer tag.
    IsVariant(value: ValueID, variant: int, result: ValueID)
    Constant(value: LiteralValue, result: ValueID)
    Unary(operator: OperatorSyntax, operand: ValueID, result: ValueID)
    Binary(
        operator: OperatorSyntax,
        left: ValueID,
        right: ValueID,
        result: ValueID,
    )
    Call(function: FunctionID, arguments: list[ValueID], result: ValueID)
    CallFields(
        function: FunctionID,
        arguments: list[ValueID],
        outputs: list[ValueID],
    )
    Assert(condition: ValueID, message: ValueID | None, origin: AssertionOrigin)
    Allocate(type_id: TypeID, result: ValueID)
    Alias(value: ValueID, result: ValueID)
    Load(address: ValueID, result: ValueID)
    Store(address: ValueID, value: ValueID)
    FieldAddress(object: ValueID, owner: TypeID, index: int, result: ValueID)
    CompiledRegionCall(
        artifact_id: ArtifactID,
        inputs: list[ValueID],
        outputs: list[ValueID],
    )

'''
Functions use @mlir for operation identity; type declarations use it for a
type spelling. Both preserve the same parsed decorator/grammar data.
'''
def declared_mlir_binding(
    decorators: list[Decorator],
    owner: string,
) -> MLIRTypeBinding | None:
    selected: MLIRTypeBinding | None := None
    for decorator in decorators:
        if decorator.name != "mlir":
            continue
        if selected != None:
            throw Error("duplicate MLIR type annotation: " + owner)
        if len(decorator.arguments) != 1:
            throw Error("MLIR type annotation requires one spelling")
        match decorator.arguments[0].value:
            case String:
                if value == "":
                    throw Error("MLIR type annotation requires a spelling")
                selected = MLIRTypeBinding(value)
            case Name | Integer | Boolean:
                throw Error("MLIR type annotation requires a string")
    return selected

def record_mlir_binding(record: RecordDeclaration) -> MLIRTypeBinding | None:
    selected ?= declared_mlir_binding(record.decorators, record.name)
    if selected != None:
        return selected
    cached ?= record.mlir
    if cached != None:
        return cached
    return MLIRTypeBinding(
        spelling = "!llvm.struct<({elements})>",
        category = "struct",
        dimensions = 0,
    )

def annotation_key(
    annotation: TypeAnnotation,
    parameters: list[string] = [],
) -> string:
    generic_parameters = parameters
    match annotation.kind:
        case Named:
            index := 0
            for parameter in parameters:
                if name == parameter:
                    return semantic_key(["parameter", string(index)])
                index += 1
            parts = ["named", name]
            for argument in arguments:
                parts.append(annotation_key(argument, parameters))
            return semantic_key(parts)
        case Union:
            parts = ["union"]
            for member in members:
                parts.append(annotation_key(member, parameters))

            # The source order carries tagged-union ABI meaning.
            return semantic_key(parts)
        case Function:
            parts = ["function"]
            for parameter in parameters:
                parts.append(annotation_key(parameter, generic_parameters))
            parts.append(annotation_key(result, generic_parameters))
            return semantic_key(parts)
        case DimensionConstant:
            return semantic_key(["dimension", string(value)])
        case DimensionRuntime:
            return semantic_key(["runtime-dimension", string(index)])
        case ShapeSpread:
            return semantic_key(
                [
                    "shape-spread",
                    annotation_key(
                        named_type(parameter, [], annotation.span),
                        generic_parameters,
                    ),
                ],
            )

def callable_key(function: FunctionDeclaration, owner: string) -> string:
    name := function.name
    namespace ?= function.lookup
    if namespace != None:
        if namespace != "" and name.starts_with(namespace):
            name = name[len(namespace):]
    parts = [owner, "callable", name, string(len(function.type_parameters))]
    for parameter in function.parameters:
        parts.append(
            annotation_key(parameter.annotation, function.type_parameters),
        )
        parts.append("pack" if parameter.variadic else "single")
        parts.append(parameter.name if parameter.keyword_only else "")
        for modifier in parameter.modifiers:
            parts.append(modifier.name)
    return semantic_key(parts)

test "annotation keys retain function and dimension structure":
    location = Span(0, 0, 1)
    first = named_type("T", [], location)
    second = named_type("U", [], location)
    left = TypeAnnotation(TypeAnnotationKind.Function([first], first), location)
    right = TypeAnnotation(
        TypeAnnotationKind.Function([second], second),
        location,
    )
    assert(annotation_key(left, ["T"]) == annotation_key(right, ["U"]))
    constant = TypeAnnotation(TypeAnnotationKind.DimensionConstant(3), location)
    runtime = TypeAnnotation(TypeAnnotationKind.DimensionRuntime(3), location)
    assert(annotation_key(constant) != annotation_key(runtime))
    spread = TypeAnnotation(TypeAnnotationKind.ShapeSpread("T"), location)
    renamed = TypeAnnotation(TypeAnnotationKind.ShapeSpread("U"), location)
    assert(annotation_key(spread, ["T"]) == annotation_key(renamed, ["U"]))
