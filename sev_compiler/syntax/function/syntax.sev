import source
import * from "../symbol/symbol.sev"
import * from "../type/annotation.sev"
import * from "function.sev"
import * from "../sentence/sentence.sev"
import * from "lowering.sev"

# Source declaration and operator forms select callable implementations.
# The descriptor imports below retain pre-existing missing dependencies;
# regrouping does not synthesize replacement operator definitions.

enum ImportSubject:
    Name(name: string)
    Locator(locator: string)


class ImportDeclaration:
    subject: ImportSubject
    source_name: string | None
    alias: string | None
    span: source.Span
    resolved_module: ModuleId | None = None


enum DecoratorValue:
    Name(value: string)
    String(value: string)
    Integer(value: string)
    Boolean(value: bool)


class DecoratorArgument:
    name: string | None
    value: DecoratorValue
    span: source.Span


class Decorator:
    name: string
    arguments: list[DecoratorArgument]
    span: source.Span


enum GenericConstraint:
    Parameter(parameter: string, bound: TypeAnnotation, span: source.Span)
    Predicate(expression: Expression)


class TypeDeclaration:
    decorators: list[Decorator]
    name: string
    type_parameters: list[string]
    constraints: list[GenericConstraint]
    definition: TypeAnnotation | None
    span: source.Span
    id: TypeId = TypeId(0)
    interface: InterfaceId | None = None
    lookup: string = ""

    type_defaults: list[TypeAnnotation] = []

class PropertyDeclaration:
    name: string
    annotation: TypeAnnotation
    default: Expression | None
    span: source.Span
    definition: DefId = DefId(0, 0, DeclarationId(0))


class OperatorParameter:
    name: string
    annotation: TypeAnnotation
    span: source.Span
    mode: string = ""


class OperatorDeclaration:
    syntax: OperatorSyntax
    parameters: list[OperatorParameter]
    result: TypeAnnotation
    span: source.Span
    type_parameters: list[string] = []
    constraints: list[GenericConstraint] = []
    body: Block | None = None
    receiver: bool = true
    definition: DefId = DefId(0, 0, DeclarationId(0))
    grammar_parameter: string | absent = absent
    result_mode: string = ""


class TraitDeclaration:
    decorators: list[Decorator]
    name: string
    type_parameters: list[string]
    constraints: list[GenericConstraint]
    bases: list[TypeAnnotation]
    properties: list[PropertyDeclaration]
    operators: list[OperatorDeclaration]
    span: source.Span
    methods: list[FunctionDeclaration] = []
    definition: DefId = DefId(0, 0, DeclarationId(0))
    lookup: string = ""
    compiler_descriptor: bool = false
    grammar: bool = false
    scalar_operations: list[ScalarOperation] = []
    scalar_syntax: OperatorSyntax | None = None
    arguments: list[TypeAnnotation] = []
    type_defaults: list[TypeAnnotation] = []
    source_name: string = ""


enum CompilerExpectation:
    Accept
    Reject


class CompilerTestCase:
    expectation: CompilerExpectation
    diagnostic_name: string | None
    body: Block
    span: source.Span
    declarations: list[Item] = []
    parse_error: string = ""


enum TestMode:
    Property
    Benchmark
    Chaos
    Profile
    Compiler
    Integration


enum TestStream:
    Stdout
    Stderr


enum TestExpectation:
    Contains(stream: TestStream, value: string)
    Equals(stream: TestStream, value: string)


class TestCaseRow:
    values: list[Expression]


class TestModeArguments:
    name: string
    values: list[Expression]


class TestDeclaration:
    name: string | None
    source_modes: list[string]
    body: Block
    compiler_cases: list[CompilerTestCase]
    span: source.Span
    modes: list[TestMode] = []
    function: FunctionId | None = None
    expectations: list[TestExpectation] = []
    lookup: string = ""
    case_names: list[string] = []
    case_rows: list[TestCaseRow] = []
    mode_arguments: list[TestModeArguments] = []
    contracts: list[Expression] = []


def test_mode_name(mode: TestMode) -> string:
    match mode:
        case Property:
            return "property"
        case Benchmark:
            return "bench"
        case Chaos:
            return "chaos"
        case Profile:
            return "profile"
        case Compiler:
            return "compiler"
        case Integration:
            return "integ"


enum TypePattern:
    # Must be this exact type.
    Exact(type_id: TypeId)

    # Result or operand must match the left operand type.
    SameAsLeft

    # Result or operand must match the right operand type.
    SameAsRight


enum TypeConstraint:
    # Operand must already resolve to this type.
    Known(type_id: TypeId)

    # Operand may begin as an unresolved literal of this kind.
    Literal(kind: LiteralKind)


class OperatorSignature:
    # The resolved Y tag is converted to the canonical registry OpId. The
    # signature never re-enumerates individual operators.
    kind: Operator

    left: TypePattern

    right: TypePattern

    result: TypePattern



enum OperatorDomain:
    ValueOperator
    GrammarOperator


enum Fixity:
    Prefix
    Infix
    Postfix


enum Associativity:
    Left
    Right
    None


# Parsed operators carry syntax data. Trait implementations describe source
# operators; AST storage does not require an erased runtime trait object.
class OperatorSyntax:
    symbol: string
    fixity: Fixity
    precedence: u8
    associativity: Associativity
    domain: OperatorDomain = ValueOperator
    definition: DefId = DefId(0, 0, DeclarationId(0))
    grammar_name: string = ""
    grammar_form: string = ""
    scalar_operation: ScalarOperation | None = None
    closing: string = ""
    separator: string = ""
    grouping: bool = false
    declaration_members: string = ""
    constructor: string = ""
    representation: string = ""



# Y is the compiler-term kind for an interned, resolved symbol. Operator tags
# are symbols, not strings and not Rust enum variants.
trait Y:
#Unimplemented???

trait Operator:
    Y
    property symbol: string
    property fixity: Fixity
    property precedence: u8
    property associativity: Associativity


trait UnaryOperator:
    Operator


trait BinaryOperator:
    Operator


def operator_syntax[T: Operator](operator: T) -> OperatorSyntax:
    return OperatorSyntax(operator.symbol, operator.fixity, operator.precedence, operator.associativity)


class Positive: UnaryOperator
    symbol: string = "+"
    fixity: Fixity = Fixity.Prefix
    precedence: u8 = 10
    associativity: Associativity = Associativity.Right


class Negative: UnaryOperator
    symbol: string = "-"
    fixity: Fixity = Fixity.Prefix
    precedence: u8 = 10
    associativity: Associativity = Associativity.Right


class Not: UnaryOperator
    symbol: string = "not"
    fixity: Fixity = Fixity.Prefix
    precedence: u8 = 10
    associativity: Associativity = Associativity.Right


class Move: UnaryOperator
    symbol: string = "move"
    fixity: Fixity = Fixity.Prefix
    precedence: u8 = 10
    associativity: Associativity = Associativity.Right


class BitwiseOr: BinaryOperator
    symbol: string = "|"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 4
    associativity: Associativity = Associativity.Left


class BitwiseAnd: BinaryOperator
    symbol: string = "&"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 6
    associativity: Associativity = Associativity.Left


class BitwiseXor: BinaryOperator
    symbol: string = "^"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 5
    associativity: Associativity = Associativity.Left


class LeftShift: BinaryOperator
    symbol: string = "<<"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 7
    associativity: Associativity = Associativity.Left


class RightShift: BinaryOperator
    symbol: string = ">>"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 7
    associativity: Associativity = Associativity.Left


class Add: BinaryOperator
    symbol: string = "+"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 7
    associativity: Associativity = Associativity.Left


class Subtract: BinaryOperator
    symbol: string = "-"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 7
    associativity: Associativity = Associativity.Left


class Multiply: BinaryOperator
    symbol: string = "*"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 8
    associativity: Associativity = Associativity.Left


class Divide: BinaryOperator
    symbol: string = "/"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 8
    associativity: Associativity = Associativity.Left


class FloorDivide: BinaryOperator
    symbol: string = "//"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 8
    associativity: Associativity = Associativity.Left


class Remainder: BinaryOperator
    symbol: string = "%"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 8
    associativity: Associativity = Associativity.Left


class Power: BinaryOperator
    symbol: string = "**"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 9
    associativity: Associativity = Associativity.Right


class Equal: BinaryOperator
    symbol: string = "=="
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 3
    associativity: Associativity = Associativity.None


class NotEqual: BinaryOperator
    symbol: string = "!="
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 3
    associativity: Associativity = Associativity.None


class Less: BinaryOperator
    symbol: string = "<"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 3
    associativity: Associativity = Associativity.None


class LessEqual: BinaryOperator
    symbol: string = "<="
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 3
    associativity: Associativity = Associativity.None


class Greater: BinaryOperator
    symbol: string = ">"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 3
    associativity: Associativity = Associativity.None


class GreaterEqual: BinaryOperator
    symbol: string = ">="
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 3
    associativity: Associativity = Associativity.None


class Contains: BinaryOperator
    symbol: string = "in"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 3
    associativity: Associativity = Associativity.None


class LogicalAnd: BinaryOperator
    symbol: string = "and"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 2
    associativity: Associativity = Associativity.Left


class LogicalOr: BinaryOperator
    symbol: string = "or"
    fixity: Fixity = Fixity.Infix
    precedence: u8 = 1
    associativity: Associativity = Associativity.Left



# A grammar's operations: {T: ScalarOperation} map supplies these descriptors.
# Symbol, fixity and operand type come from that declaration and its map key.
class ScalarOperation:
    mnemonic: string
    predicate: int = -1
    identity: int = 0
    direct: bool = false
    operand_type: TypeId = TypeId(0)
