# Operations, registry contracts, and callable lowering metadata.
enum LoweredOperation:
    LoweredCoverage(key: string)
    ConstantValue(value: Constant, result: ValueID)
    LoweredUnary(operator: UnaryOperation, operand: ValueID, result: ValueID)
    LoweredBinary(
        operator: BinaryOperation,
        left: ValueID,
        right: ValueID,
        result: ValueID,
    )
    LoweredCall(function: FunctionID, arguments: list[ValueID], result: ValueID)
    RuntimeCall(
        symbol: string,
        arguments: list[ValueID],
        result: ValueID | None,
    )
    LoweredReturn(value: ValueID | None)
    LoweredAssert(
        condition: ValueID,
        message: ValueID | None,
        location: AssertionLocation | None,
    )
    LoweredIf(condition: ValueID, then_block: Block, else_block: Block)
    ArtifactCall(
        artifact_id: ArtifactID,
        inputs: list[ValueID],
        outputs: list[ValueID],
    )

'''
Source annotations describe the implementation of an F. The scalar compiler
recognizes these two boundary forms, never library helper/function names.
'''
def scalar_boundary(function: FunctionDeclaration, name: string) -> string:
    for decorator in function.decorators:
        if decorator.name == name:
            for argument in decorator.arguments:
                if argument.name == ""
                    or (name == "c" and argument.name == "symbol"):
                    match argument.value:
                        case String:
                            return value
                        case Name | Integer | Boolean:
                            throw Error(
                                "scalar boundary requires a string literal",
                            )
    return ""

def scalar_operand_segments(function: FunctionDeclaration) -> list[int]:
    for decorator in function.decorators:
        if decorator.name == "mlir":
            for argument in decorator.arguments:
                if argument.name == "operand_segments":
                    match argument.value:
                        case String:
                            segments: list[int] = []
                            for part in value.split(","):
                                if part == "":
                                    throw Error(
                                        "invalid MLIR operand segment size",
                                    )
                                for character in part.characters():
                                    if character < "0" or character > "9":
                                        throw Error(
                                            "invalid MLIR operand segment size",
                                        )
                                size = int(part)
                                if size < 0 or size > 2147483647:
                                    throw Error(
                                        "invalid MLIR operand segment size",
                                    )
                                segments.append(size)
                            return segments
                        case Name | Integer | Boolean:
                            throw Error(
                                "MLIR operand segments require a string litera"
                                "l",
                            )
    return []

'''
Lowering dependencies belong to the declaration that introduces an operation.
The
driver collects these from reachable F; the backend never inspects IR text.
'''
class LoweringRequirements:
    passes: list[string] = []
    libraries: list[string] = []
    quality: bool = false

def scalar_requirement_names(text: string) -> list[string]:
    result: list[string] = []
    for part in text.split(","):
        name = part.strip()
        if name == "":
            throw Error("empty lowering requirement")
        for character in name.characters():
            if not (
                (character >= "a" and character <= "z")
                or (character >= "A" and character <= "Z")
                or (character >= "0" and character <= "9")
                or character in ["_", "-", "."]
            ):
                throw Error("invalid lowering requirement: " + name)
        if name.starts_with("-"):
            throw Error("invalid lowering requirement: " + name)
        if name not in result:
            result.append(name)
    return result

def scalar_requirements(
    function: borrow FunctionDeclaration,
    requirements: LoweringRequirements,
):
    for decorator in borrow function.decorators:
        if decorator.name not in ["mlir", "c"]:
            continue
        for argument in borrow decorator.arguments:
            key ?= argument.name
            if key == None:
                continue
            if key != None and key != "lowering" and key != "libraries":
                continue
            match argument.value:
                case String:
                    for name in scalar_requirement_names(value):
                        if key == "lowering":
                            if decorator.name != "mlir":
                                throw Error(
                                    "C boundaries cannot request MLIR lowering"
                                    " passes",
                                )
                            if name not in requirements.passes:
                                requirements.passes.append(name)
                        elif name not in requirements.libraries:
                            requirements.libraries.append(name)
                case Name | Integer | Boolean:
                    throw Error("lowering requirements require string literals")

class DialectID: StableID
    value: u128

class OperationID: StableID
    value: u128

class BackendID: StableID
    value: u128

class RuntimeID: StableID
    value: u128

class EffectSet:
    bits: u16

    def contains(effect: EffectSet) -> bool:
        return bits & effect.bits == effect.bits

    def union(other: EffectSet) -> EffectSet:
        return EffectSet(bits | other.bits)

enum LoweringCapability:
    Standard
    Compiler(compiler: CompilerID)
    Backend(backend: BackendID)
    Runtime(runtime: RuntimeID)
    Provider(provider: ProviderID)

class RegisteredOperation:
    id: OpID
    operands: list[TypeID]
    results: list[TypeID]
    attributes: map[AttributeID, AttrValue]

class IrContext:
    types: TyInterner
    operations: OperationRegistry

class OperationDiagnostic:
    operation: OpID
    message: string

class CanonicalRewrite:
    replacement: OpID
    attributes: map[AttributeID, AttrValue]

trait OperationInterface:
    def infer_types(
        operands: list[TypeID],
        attributes: map[AttributeID, AttrValue],
    ) -> list[TypeID] | OperationDiagnostic
    def verify(
        operation: RegisteredOperation,
        context: IrContext,
    ) -> absent | OperationDiagnostic
    def effects(operation: RegisteredOperation) -> EffectSet
    def canonicalize(operation: RegisteredOperation) -> CanonicalRewrite | None
    def lowering_capabilities() -> list[LoweringCapability]

class OperationRegistry:
    interfaces: map[OpID, OperationInterface]

    def OperationRegistry():
        interfaces = {}

    def register(
        id: OpID,
        interface: OperationInterface,
    ) -> absent | OperationDiagnostic:
        if interfaces.contains(id):
            return error(
                OperationDiagnostic(
                    id,
                    "operation interface is already registered",
                ),
            )
        interfaces[id] = interface
        return absent

    def interface(id: OpID) -> OperationInterface | None:
        return interfaces.get(id)

def dialect_id(name: string) -> DialectID:
    return DialectID(hashing.hash(name))

def operation_id(name: string) -> OperationID:
    return OperationID(hashing.hash(name))

def attribute_id(name: string) -> AttributeID:
    return AttributeID(hashing.hash(name))

def backend_id(name: string) -> BackendID:
    return BackendID(hashing.hash(name))

def runtime_id(name: string) -> RuntimeID:
    return RuntimeID(hashing.hash(name))

def provider_id(name: string) -> ProviderID:
    return ProviderID(hashing.hash(name))

def named_operation(dialect: string, operation: string) -> OpID:
    return OpID(dialect_id(dialect).value, operation_id(operation).value)

def no_effects() -> EffectSet:
    return EffectSet(0)

def read_effect() -> EffectSet:
    return EffectSet(1)

def write_effect() -> EffectSet:
    return EffectSet(2)

def allocate_effect() -> EffectSet:
    return EffectSet(4)

def free_effect() -> EffectSet:
    return EffectSet(8)

def throw_effect() -> EffectSet:
    return EffectSet(16)

def io_effect() -> EffectSet:
    return EffectSet(32)

test "operation names have stable independent identities":
    first = named_operation("arith", "add")
    repeated = named_operation("arith", "add")
    different_operation = named_operation("arith", "sub")
    different_dialect = named_operation("tensor", "add")
    assert(first == repeated)
    assert(first != different_operation)
    assert(first != different_dialect)

test "effect sets compose without losing bits":
    effects = read_effect()
        .union(write_effect())
        .union(io_effect())
    assert(effects.contains(read_effect()))
    assert(effects.contains(write_effect()))
    assert(effects.contains(io_effect()))
    assert(not effects.contains(throw_effect()))

'''
Lowering retains the same open operation identity. These wrappers describe
arity only; adding an operation does not add a new lowered variant.
'''
class UnaryOperation:
    id: OpID

class BinaryOperation:
    id: OpID

# Keep compilation-unit identity across the compiler/backend boundary.
class MLIRObject:
    key: string
    text: string
    entry: bool = false
