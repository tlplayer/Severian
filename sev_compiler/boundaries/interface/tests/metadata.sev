import * from "../src/package_metadata.sev" as metadata
import package

test "binary metadata pads magic to eight bytes before section offsets":
    for magic in ["SEVPKGI", "SEVMIR"]:
        encoded = metadata.encode_sections(magic, ["schema", "payload"])
        for index in range(int(len(magic)), 8):
            assert(encoded[index] == 0)
        assert(package.number(encoded, 8, 4) == 1)
        assert(package.number(encoded, 12, 4) == 2)
        assert(package.number(encoded, 20, 8) == 56)
        assert(metadata.decode_section(encoded, magic, 2) == "payload")
        encoded[7] = u8(1)
        invalid ?= metadata.decode_section(encoded, magic, 2)
        assert(invalid is Error)
