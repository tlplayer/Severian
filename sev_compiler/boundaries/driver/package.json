        "path": "../../../library/system/file"
    },
    "os": {
        "path": "../../../library/system/os"
    },
    "path": {
        "path": "../../../library/system/path"
    },
    "process": {
        "path": "../../../library/system/process"
    },
    "time": {
      "path": "../../../library/core/time"
    },
    "package": {
      "path": "../../../library/package"
    },
    "abi": {
      "package": "sev-compiler-abi",
      "path": "../abi"
    },
    "backend": {
      "package": "sev-compiler-backend",
      "path": "../backend"
    },
    "compile": {
      "package": "sev-compiler-compile",
      "path": "../../compile"
