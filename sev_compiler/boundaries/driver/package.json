{
  "package": {
    "name": "sev-compiler-driver",
    "version": "0.1.0",
    "edition": "2026",
    "publish": false
  },
  "lib": {
    "name": "driver",
    "path": "src/lib.sev"
  },
  "bin": [
    {
      "name": "sev-bootstrap-driver",
