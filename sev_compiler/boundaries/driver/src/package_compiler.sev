import * from "../../../universal/declaration/scalar.sev" as boundary
import package
import source
import os
import path
import * from "pipeline/source.sev" as pipeline
import * from "../../backend/src/native_mlir.sev" as backend
import * from "pipeline/frontend_archive.sev" as frontend_archive
import * from "../../interface/src/package_metadata.sev" as metadata
import * from "pipeline/mir_archive.sev" as mir_archive
import * from "pipeline/package_interface.sev" as package_interface
import diagnostics
from diagnostics import Diagnostic


def compile_prelude_package(arguments: list[string]) -> unit | Error:
    if len(arguments) != 5:
        throw Error("invalid prelude compilation protocol arguments")
    project = package.open(arguments[2])
    resolution = package.resolve(project, package.Resolve("build", true, ""))
    entry = package.inside(project.root, package.library_target(project.manifest).path)
    files: list[source.SourceFile] = []
    subject = source.SourceFile(source.SourceId(0), project.root + "/__prelude_validation__.sev", "")
    output = arguments[3] + "/" + frontend_archive.schema() + "/frontend.txt"
    result ?= pipeline.compile_source(subject, false, arguments[4], files, resolution=resolution, prelude_entry=entry, archive_output=output)
    if result is Diagnostic:
        throw Error(diagnostics.render(result, files))

# Record the exact text read by the frontend and the native provider assets.
# Missing manifests/locks are recorded too, so adding one invalidates a build.
def record_inputs(files: list[source.SourceFile], resolution: package.Resolution, destination: string, sysroot: string, native: bool) -> unit | Error:
    records: list[string] = []
    recorded: list[string] = []
    for file in files:
        location = package.canonical(file.path)
        package.write_text(destination + ".source", file.text)
        records.append(package.toml_quote(location) + " = " + package.toml_quote(package.digest(location) if location.ends_with("/interface.bin") else package.digest(destination + ".source")))
        recorded.append(location)
    roots: list[string] = []
    for resolved in resolution.packages:
        if resolved.archive_path == "":
            roots.append(resolved.root)
    for file in files:
        compiled := false
        for resolved in resolution.packages:
            if file.path == resolved.interface_path:
                compiled = true
        if compiled:
            continue
        directory := path.dirname(package.canonical(file.path))
        while directory != "/":
            for name in ["package.json", "package.toml", "package.lock", "sev.lock"]:
                location = directory + "/" + name
                if location not in recorded:
                    records.append(package.toml_quote(location) + " = " + package.toml_quote(package.digest(location) if os.is_file(location) else "missing"))
                    recorded.append(location)
            if os.is_file(package.manifest_file(directory)):
                if directory not in roots:
                    roots.append(directory)
                break
            directory = path.dirname(directory)
    # Analysis and MLIR emission do not require a hosted C provider or the
    # native ownership pass configuration. Record these only when linking.
    if native:
        for resolved in resolution.packages:
            if resolved.archive_path != "":
                records.append(package.toml_quote(resolved.archive_path) + " = " + package.toml_quote(package.digest(resolved.archive_path)))
        for directory in roots:
            entries = package.parse_document(package.read_text(package.manifest_file(directory)))
            for entry in entries:
                if entry.table == "xxi.c" and entry.key == "sources":
                    for source in package.string_array(entry.value):
                        provider = package.inside(directory, source)
                        # Local headers and native sources share the provider directory.
                        for location in package.files(path.dirname(provider), true):
                            if location not in recorded:
                                records.append(package.toml_quote(location) + " = " + package.toml_quote(package.digest(location)))
                                recorded.append(location)
        # The physical buffer provider is linked even when no package declares a
        # native extension. Changing it must invalidate already-built artifacts.
        for name in ["memory.c", "memory.h"]:
            location = package.canonical(sysroot + "/library/core/memory/native/" + name)
            if location not in recorded:
                records.append(package.toml_quote(location) + " = " + package.toml_quote(package.digest(location)))
        quality_runtime = package.canonical(sysroot + "/sev_compiler/runtime/native/quality.c")
        records.append(package.toml_quote(quality_runtime) + " = " + package.toml_quote(package.digest(quality_runtime)))
        ownership_pipeline = package.canonical(sysroot + "/sev_compiler/frontend/ownership/mlir.pipeline")
        records.append(package.toml_quote(ownership_pipeline) + " = " + package.toml_quote(package.digest(ownership_pipeline)))
    package.write_text(destination + ".inputs", records.join("\n") + "\n")


# This private entry consumes the package library's immutable resolved graph.
# It performs one compilation unit and never discovers or resolves packages.
def compile_package_unit(arguments: list[string]) -> unit | Error:
    try:
        compile_package_unit_checked(arguments)
    catch failure: Error:
        if len(arguments) == 10:
            package.write_text(arguments[3] + ".diagnostic", failure.message)
        throw failure


def compile_package_unit_checked(arguments: list[string]) -> unit | Error:
    if len(arguments) != 10:
        throw Error("invalid compilation-unit protocol arguments")
    if arguments[8] != "host":
        throw Error("source compiler currently supports only the host platform")
    resolution = package.decode_resolution(package.read_text(arguments[6]))
    emit = arguments[4]
    files: list[source.SourceFile] = []
    interface: list[string] = []
    quality_maps: list[string] = []
    mir_outputs: list[list[u8]] = []
    requirements = boundary.LoweringRequirements()
    text = pipeline.compile_to_mlir(pipeline.load_input(arguments[2]), arguments[7] == "test", arguments[5], "mlir" if emit == "check" or emit == "sources" else emit, resolution, files, interface, quality_maps, requirements, mir_outputs)
    if emit == "library" and len(resolution.packages) > 0 and package.setting(resolution.packages[0].manifest.entries, "package", "export", "[]") != "[]" and interface[0] == "":
        throw Error("unsupported exported ABI: this compiler requires non-generic scalar functions")
    if len(quality_maps) > 0:
        package.write_text(arguments[3] + ".coverage.json", quality_maps[0])
    record_inputs(files, resolution, arguments[6], arguments[5], emit in ["", "library"])
    if emit == "check":
        return
    if emit == "sources":
        paths: list[string] = []
        for file in files:
            paths.append(file.path)
        package.write_text(arguments[3], paths.join("\n"))
        return
    if emit != "" and emit != "library":
        package.write_text(arguments[3], text)
    else:
        entries: list[package.Entry] := []
        if len(resolution.packages) > 0:
            entries = resolution.packages[0].manifest.entries
        profile = arguments[9]
        if profile not in ["dev", "release"]:
            throw Error("unsupported compiler profile: " + profile)
        table = "profile." + profile
        optimization = int(package.setting(entries, table, "opt-level", "3" if profile == "release" else "0"))
        if optimization < 0 or optimization > 3:
            throw Error("profile opt-level must be between 0 and 3")
        debug_symbols = package.setting(entries, table, "debug-symbols", "false" if profile == "release" else "true") == "true"
        strip = package.setting(entries, table, "strip", "true" if profile == "release" else "false") == "true"
        lto = package.setting(entries, table, "lto", "true" if profile == "release" else "false") == "true"
        sources: list[string] = []
        for file in files:
            sources.append(file.path)
        backend.emit_native(text, arguments[3], optimization, debug_symbols, strip, lto, package.native_arguments(resolution, sources), arguments[5], emit == "library", interface[1:] if emit == "library" else [], requirements, package.setting(entries, "build", "incremental", "true") != "false")
        if emit == "library":
            package.write_text(arguments[3] + ".interface.sev", interface[0])
            package.write_bytes(arguments[3] + ".interface.bin", metadata.encode_interface(interface[0]))
            package.write_bytes(arguments[3] + ".mir", mir_outputs[0])
            name = resolution.packages[0].identity.name.replace("-", "_")
            package.write_text(arguments[3] + ".h", package_interface.foreign_declarations(interface[0], false, name))
            package.write_text(arguments[3] + ".rs", package_interface.foreign_declarations(interface[0], true, name))
