import "../../../../transforms/mir/src/agent_ir.sev" as agent_ir
import source
import process
import package
import lexer
import parser
import universal
import diagnostics
from diagnostics import Diagnostic
import "../../../../frontend/semantic/src/callable.sev" as semantic
import "../../../../transforms/mir/src/callable.sev" as mir
import "../../../../transforms/mlir/src/emit/callable.sev" as mlir
import "../../../../transforms/mlir/src/ir/text.sev" as text
import "../../../../frontend/modules/src/source.sev"


def prelude_providers(file: source.SourceFile) -> list[universal.ImportDeclaration] | diagnostics.Diagnostic:
    input = parser.Parser(lexer.scan_bootstrap(file))
    result: list[universal.ImportDeclaration] = []
    parser.parser_separators(input)
    while not parser.parser_at_simple(input, lexer.TokenKind.Eof):
        if not parser.parser_at_identifier(input, "import"):
            return error(diagnostics.diagnostic("E000120", "prelude may only declare source imports"))
        result.append(parser.parser_import_declaration(input))
        parser.parser_separators(input)
    return result


def compile_to_mlir(input: source.SourceFile, include_tests: bool = false, sysroot: string = ".", emit: string = "mlir", resolution: package.Resolution = package.Resolution([], [], ""), files: list[source.SourceFile] = []) -> string:
    result ?= compile_source(input, include_tests, sysroot, files, emit, resolution)
    if result is string:
        return result
    if result is Diagnostic:
        throw Error(diagnostics.render(result, files))
    if result is Error:
        throw Error(result.message)
    throw Error("source compilation returned no MLIR")


def compile_source(input: source.SourceFile, include_tests: bool, sysroot: string, files: list[source.SourceFile], emit: string = "mlir", resolution: package.Resolution = package.Resolution([], [], "")) -> string | diagnostics.Diagnostic:
    registry = lexer.SyntaxRegistry([])
    working_directory = process.current_directory()
    if working_directory == "":
        return error(diagnostics.diagnostic("E000120", "could not resolve the current source directory"))
    root = normalized_path(sysroot if sysroot.starts_with("/") else working_directory + "/" + sysroot)
    subject_path = normalized_path(input.path if input.path.starts_with("/") else working_directory + "/" + input.path)
    subject_loaded := false
    initializer_namespace := ""
    parsed = universal.empty_module()
    prelude = registered_source(source.load(root + "/sev_compiler/universal/prelude.sev"), files)
    providers = prelude_providers(prelude)
    for declaration in providers:
        provider_locator := ""
        namespace := ""
        match declaration.subject:
            case Locator:
                provider_locator = locator
            case _:
                return error(diagnostics.diagnostic("E000120", "prelude providers require relative source imports"))
        supplied ?= declaration.alias
        if supplied != None:
            namespace = supplied + "."
        provider_path = normalized_path(parent_path(prelude.path) + "/" + provider_locator)
        is_subject = provider_path == subject_path
        if is_subject:
            initializer_namespace = namespace
        library = load_source_module(input if is_subject else source.load(provider_path), namespace, [], is_subject, files, registry)
        for item in library.items:
            parsed.items.append(item)
        subject_loaded = subject_loaded or is_subject
    # A test subject may itself be a prelude module. Give its declarations a
    # local scope so tests can exercise them without colliding with the prelude.
    # A direct provider keeps its original namespace and declaration identity.
    # Loading it again under a test namespace duplicates scalar extensions and
    # makes otherwise valid operator implementations ambiguous.
    if not subject_loaded:
        initializer_namespace = "__subject." if include_tests else ""
        application = load_source_module(input, initializer_namespace, [], true, files, registry, resolution)
        for item in application.items:
            parsed.items.append(item)
    typed = semantic.analyze_callables(parsed, include_tests, initializer_namespace)
    lowered = mir.build_callables(typed)
    if emit == "agent-ir":
        return agent_ir.emit(lowered, files)
    program = mlir.lower_callables(lowered)
    return text.print_program(program)
