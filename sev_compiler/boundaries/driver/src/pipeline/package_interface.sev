import package
import universal

# Version one uses the existing scalar C ABI. Unsupported contracts retain
# source fallback; never describe records, effects or generics as scalar ABI.
def interface_type(type_id: universal.TypeId) -> string:
    if type_id.index == 2:
        return "unit"
    if type_id.index == 32:
        return "i32"
    if type_id.index == 64:
        return "i64"
    if type_id.index == 532:
        return "u32"
    if type_id.index == 564:
        return "u64"
    if type_id.index == 163:
        return "f32"
    if type_id.index == 164:
        return "f64"
    return ""

def scalar_interface(module: borrow universal.Module, resolution: package.Resolution, names: list[string], symbols: list[string], libraries: list[string] = []) -> string:
    if len(resolution.packages) == 0:
        return ""
    for item in borrow module.items:
        match item:
            case BindingItem:
                if int(binding.span.source.index) not in module.prelude_sources:
                    return ""
            case ExpressionItem:
                if int(expression.span.source.index) not in module.prelude_sources:
                    return ""
            case _:
                throw Error("unimplemented")
    owner = resolution.packages[0]
    exports = package.string_array(package.setting(owner.manifest.entries, "package", "export", "[]"))
    lines: list[string] = []
    for name in exports:
        found := 0
        for function in borrow module.functions:
            if function.name != name:
                continue
            found += 1
            result = interface_type(function.result_type)
            if result == "" or len(function.type_parameters) != 0 or len(function.constraints) != 0 or function.result_mode != "" or len(function.decorators) != 0:
                return ""
            parameters: list[string] = []
            index := 0
            for parameter in borrow function.parameters:
                spelling = interface_type(function.parameter_types[index])
                if spelling in ["", "unit"] or parameter.default != None or parameter.variadic or parameter.keyword_only or len(parameter.modifiers) != 0:
                    return ""
                parameters.append(parameter.name + ": " + spelling)
                index += 1
            symbol = "__sev_pkg_" + owner.checksum.replace("sha256:", "") + "_" + name
            names.append(name)
            symbols.append(symbol)
            dependencies = ", libraries=" + package.toml_quote(libraries.join(",")) if len(libraries) > 0 else ""
            lines.append("@c(symbol=" + package.toml_quote(symbol) + dependencies + ")\ndef " + name + "(" + parameters.join(", ") + ") -> " + result)
        if found != 1:
            return ""
    return lines.join("\n\n")


# The same checked scalar contract drives both foreign declaration sets.
def foreign_type(spelling: string, rust: bool) -> string | Error:
    if spelling == "unit":
        return "()" if rust else "void"
    if spelling in ["i32", "i64", "u32", "u64"]:
        if rust:
            return spelling
        return ("uint" if spelling.starts_with("u") else "int") + spelling[1:] + "_t"
    if spelling == "f32":
        return "f32" if rust else "float"
    if spelling == "f64":
        return "f64" if rust else "double"
    throw Error("unsupported foreign ABI type: " + spelling)


def foreign_declarations(contract: string, rust: bool, name_prefix: string) -> string | Error:
    output := "#![no_std]\nunsafe extern \"C\" {\n" if rust else "#pragma once\n#include <stdint.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n"
    symbol := ""
    for line in contract.split("\n"):
        if line.starts_with("@c(symbol="):
            symbol = line.split("\"")[1]
        elif line.starts_with("def "):
            name = line[4:].split("(")[0]
            parameters = line.split("(")[1].split(")")[0]
            result = foreign_type(line.split(" -> ")[1], rust)
            declarations: list[string] = []
            if parameters != "":
                for parameter in parameters.split(", "):
                    parts = parameter.split(": ")
                    kind = foreign_type(parts[1], rust)
                    declarations.append(parts[0] + ": " + kind if rust else kind + " " + parts[0])
            if rust:
                output += "    #[link_name = " + package.toml_quote(symbol) + "]\n    pub fn " + name + "(" + declarations.join(", ") + ") -> " + result + ";\n"
            else:
                output += result + " " + symbol + "(" + (declarations.join(", ") if len(declarations) > 0 else "void") + ");\n#define " + name_prefix + "_" + name + " " + symbol + "\n"
    return output + ("}\n" if rust else "#ifdef __cplusplus\n}\n#endif\n")
