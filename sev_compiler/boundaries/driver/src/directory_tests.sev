import os
import package
import process
import environment
import source
import * from "pipeline/source.sev" as compiler
import * from "../../backend/src/native_mlir.sev" as backend

@c(symbol="exit")
def worker_exit(status: i32)


def run_source(input: string, sysroot: string, output: string, profile: string = "dev", platform: string = "host") -> int | Error:
    unit = package.BuildUnit(0, package.Target(input, "test", input), platform, profile, output, true)
    package.compile_unit(package.Compiler(process.executable(), sysroot), unit, package.Resolution([], [], ""), "", source_path=input)
    return backend.execute_native(output, [])


def collect(directory: string, sources: list[string]) -> unit | Error:
    for name in package.sorted_strings(os.list(directory)):
        if name in ["package.pkg", "errors"] or name.starts_with("."):
            continue
        location = directory + "/" + name
        # Do not follow links back into an ancestor or another source tree.
        if os.is_symlink(location):
            continue
        if os.is_dir(location):
            collect(location, sources)
        elif name.ends_with(".sev") and os.is_file(location):
            sources.append(location)


def run(directory: string, sysroot: string, output: string, profile: string, platform: string, filter: string, emit: string) -> int | Error:
    if emit != "":
        throw Error("directory tests do not support --emit; emit a selected source directly")
    sources: list[string] = []
    collect(directory, sources)
    selected: list[string] = []
    for source in sources:
        if filter == "" or source.contains(filter):
            selected.append(source)
    if len(selected) == 0:
        throw Error("no Severian test sources found in " + directory)
    stage = package.temporary(output if output != "" else "package.pkg/debug/tests", "run-")
    executable = process.executable()
    if executable == "":
        throw Error("could not find the native compiler executable")
    failed := 0
    for index in range(int(len(selected))):
        source = selected[index]
        print("testing " + source)
        arguments = [executable, "test", source, "--sysroot", sysroot, "-o", stage + "/bin/test-" + string(index)]
        if profile != "":
            arguments.append("--build-profile")
            arguments.append(profile)
        if platform != "":
            arguments.append("--target")
            arguments.append(platform)
        status := 1
        try:
            child = package.fork_compilation_unit()
            if child == 0:
                try:
                    timing_path = environment.get("SEVERIAN_TIMINGS", "")
                    if timing_path != "":
                        if not environment.set("SEVERIAN_TIMINGS", timing_path + ".unit-" + string(index)):
                            throw Error("could not select worker timing output")
                    status = run_source(source, sysroot, stage + "/bin/test-" + string(index), profile if profile != "" else "dev", platform if platform != "" else "host")
                catch failure: Error:
                    process.write_error("error: " + failure.message + "\n")
                worker_exit(i32(status))
            status = package.wait_compilation_unit(child)
        catch failure: Error:
            process.write_error("error: " + failure.message + "\n")
        print(("ok " if status == 0 else "FAILED ") + source)
        if status != 0:
            failed += 1
    print("Test files: " + string(int(len(selected)) - failed) + " passed; " + string(failed) + " failed; " + string(len(selected)) + " total")
    return 1 if failed > 0 else 0
