# Source-language counterpart of the host runtime boundary.
# Coverage persistence and owned string concatenation cross this ABI. The
# concrete allocation and process-environment bridges remain stage-0 work
# until Severian can declare and call the required C interfaces directly.

def coverage_hit(key: string):
    captured_key = key

def string_concat(left: string, right: string) -> string:
    return left + right

def print_int(value: int) -> int:
    print(value)
    return 0

def print_float(value: float) -> int:
    print(value)
    return 0

def print_bool(value: bool) -> int:
    print(value)
    return 0

def print_char(value: char) -> int:
    print(value)
    return 0

test:
    assert(string_concat("left", "right") == "leftright")
