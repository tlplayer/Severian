import environment
import file
import path
import process


# Hosted toolchain boundary, shared by the compiler command and native checks.
# Quote each argument before passing it through process.run's shell boundary.
def shell_argument(value: string) -> string:
    return "'" + value.replace("'", "'\"'\"'") + "'"


def run_tool(arguments: list[string]):
    command := ""
    for argument in arguments:
        command += shell_argument(argument) + " "
    if process.run(command) != 0:
        throw Error("native tool failed: " + arguments[0])


def emit_native(mlir: string, output: string):
    run_tool(["mkdir", "-p", path.dirname(output)])
    if file.write(output + ".mlir", mlir) != 0:
        throw Error("could not write MLIR artifact")
    opt = environment.get("SEVERIAN_MLIR_OPT", "mlir-opt-21")
    translate = environment.get("SEVERIAN_MLIR_TRANSLATE", "mlir-translate-21")
    clang = environment.get("SEVERIAN_CLANG", "clang-21")
    run_tool([opt, output + ".mlir", "--verify-each", "--buffer-deallocation-pipeline=private-function-dynamic-ownership", "--convert-bufferization-to-memref", "--convert-scf-to-cf", "--convert-arith-to-llvm", "--convert-cf-to-llvm", "--finalize-memref-to-llvm", "--convert-func-to-llvm", "--reconcile-unrealized-casts", "-o", output + ".llvm.mlir"])
    run_tool([translate, "--mlir-to-llvmir", output + ".llvm.mlir", "-o", output + ".ll"])
    run_tool([clang, output + ".ll", "-o", output])


def execute_native(executable: string, arguments: list[string]) -> int:
    command := "./" + executable if not executable.starts_with("/") else executable
    command = shell_argument(command)
    for argument in arguments:
        command += " " + shell_argument(argument)
    return process.run(command)
