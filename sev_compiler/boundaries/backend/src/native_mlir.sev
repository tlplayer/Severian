import * from "../../../universal/declaration/scalar.sev" as boundary
import environment
import file
import path
import process
import package


class HostedLayout:
    data_layout: string
    triple: string


def hosted_layout() -> HostedLayout:
    compiler = environment.get("SEVERIAN_CLANG", "clang-21")
    metadata = package.capture([compiler, "-S", "-emit-llvm", "-x", "c", "/dev/null", "-o", "-"])
    layout := ""
    triple := ""
    for line in metadata.split("\n"):
        if line.starts_with("target datalayout = "):
            layout = line.split("\"")[1]
        elif line.starts_with("target triple = "):
            triple = line.split("\"")[1]
    if layout == "" or triple == "":
        throw Error("native compiler did not report its target data layout")
    return HostedLayout(layout, triple)


# Native tools receive an argument vector through the process package.
def run_tool(arguments: list[string]):
    if process.run(arguments) != 0:
        throw Error("native tool failed: " + arguments[0])


def emit_native(mlir: string, output: string, optimization: int = 0, debug_symbols: bool = false, strip: bool = false, lto: bool = false, native_arguments: list[string] = [], sysroot: string = "", library: bool = false, exports: list[string] = [], requirements: boundary.LoweringRequirements = boundary.LoweringRequirements()):
    package.mkdir(path.dirname(output))
    intermediate = package.temporary("package.pkg/cache/native", "run-") + "/module"
    if file.write(intermediate + ".mlir", mlir) != 0:
        throw Error("could not write MLIR artifact")
    opt = environment.get("SEVERIAN_MLIR_OPT", "mlir-opt-21")
    translate = environment.get("SEVERIAN_MLIR_TRANSLATE", "mlir-translate-21")
    clang = environment.get("SEVERIAN_CLANG", "clang-21")
    # Both compilers consume the ownership library's standard MLIR pipeline.
    # Run it before lowering memrefs or aliases to opaque LLVM pointers.
    ownership_pipeline = package.read_text(sysroot + "/sev_compiler/frontend/ownership/mlir.pipeline").strip()
    run_tool([opt, intermediate + ".mlir", "--verify-each", "--mlir-print-debuginfo", "--mlir-print-op-generic", "--pass-pipeline=" + ownership_pipeline, "-o", intermediate + ".owned.mlir"])
    materialize_debug_values(intermediate + ".owned.mlir")
    lowering = [opt, intermediate + ".owned.mlir", "--verify-each", "--mlir-print-debuginfo", "--convert-scf-to-cf"]
    for name in requirements.passes:
        lowering.append("--" + name)
    for argument in ["--convert-arith-to-llvm", "--convert-func-to-llvm", "--convert-cf-to-llvm", "--finalize-memref-to-llvm=use-generic-functions", "--convert-ub-to-llvm", "--reconcile-unrealized-casts", "-o", intermediate + ".llvm.mlir"]:
        lowering.append(argument)
    run_tool(lowering)
    run_tool([translate, "--mlir-to-llvmir", intermediate + ".llvm.mlir", "-o", intermediate + ".ll"])
    if library:
        # Native providers remain explicit link inputs. This object owns only
        # this compilation unit; it deliberately contains no executable main.
        # Ownership lowering also generates helper definitions. Internalize
        # every non-exported definition after those passes have run.
        run_tool([environment.get("SEVERIAN_LLVM_OPT", "opt-21"), "--passes=internalize", "--internalize-public-api-list=" + exports.join(","), "-S", intermediate + ".ll", "-o", intermediate + ".internal.ll"])
        run_tool([clang, "-c", intermediate + ".internal.ll", "-o", output + ".o", "-O" + string(optimization), "-fPIC"])
        run_tool([environment.get("SEVERIAN_AR", "llvm-ar-21"), "rcsD", output, output + ".o"])
        package.copy_file(intermediate + ".mlir", output + ".mlir")
        return
    arguments = [clang, intermediate + ".ll", "-o", output, "-O" + string(optimization), "-lm"]
    arguments.append(sysroot + "/library/core/memory/native/memory.c")
    if requirements.quality:
        arguments.append(sysroot + "/sev_compiler/runtime/native/quality.c")
        arguments.append("-DSEV_QUALITY_TRACK_ALLOCATIONS")
    for argument in native_arguments:
        arguments.append(argument)
    if len(requirements.libraries) > 0:
        # Libraries are resolved against the selected toolchain, with an
        # explicit search path override for other native dependencies.
        toolchain = package.canonical(package.capture(["which", opt]).strip())
        search = environment.get("SEVERIAN_NATIVE_LIBRARY_PATH", path.dirname(path.dirname(toolchain)) + "/lib")
        for directory in search.split(":"):
            if directory != "":
                arguments.append("-L" + directory)
                arguments.append("-Wl,-rpath," + directory)
        for name in requirements.libraries:
            arguments.append("-l" + name)
    if debug_symbols:
        arguments.append("-g")
    if strip:
        arguments.append("-s")
    if lto:
        arguments.append("-flto")
        arguments.append("-fuse-ld=lld")
    run_tool(arguments)

def materialize_debug_values(location: string):
    lines: list[string] = []
    for raw in package.read_text(location).split("\n"):
        line := raw
        # Omit only the default arithmetic property, never text in a source
        # filename or string attribute. Non-default math flags remain intact.
        parts = raw.split(" = ")
        if len(parts) > 1 and parts[1].starts_with("\"arith."):
            line = line.replace("fastmath = #arith.fastmath<none>, ", "").replace(" <{fastmath = #arith.fastmath<none>}>", "")
        if line.contains("\"func.call\"") and (line.contains("sev.debug.variable") or line.contains("sev.debug.declaration")):
            declaration = line.contains("sev.debug.declaration")
            if not line.contains("@__sev_debug_") or not line.contains(" <{") or not line.contains("}>"):
                throw Error("malformed debug metadata carrier")
            prefix = line.split(" <{")[0]
            suffix = line.split("}>")[1:].join("}>")
            operation = "\"llvm.intr.dbg.declare\"" if declaration else "\"llvm.intr.dbg.value\""
            line = prefix.replace("\"func.call\"", operation) + suffix.replace("sev.debug.declaration" if declaration else "sev.debug.variable", "varInfo")
        lines.append(line)
    package.write_text(location, lines.join("\n"))


def execute_native(executable: string, arguments: list[string]) -> int:
    command = ["./" + executable if not executable.starts_with("/") else executable]
    for argument in arguments:
        command.append(argument)
    return process.run(command)
