import io
import file

class SourceId:
    index: u32


class Span:
    source: SourceId
    start: u32
    end: u32

    def length() -> u32:
        return end - start

    def contains(offset: u32) -> bool:
        return start <= offset and offset < end


class SourceFile:
    id: SourceId
    path: string
    text: string


class SourceMap:
    files: list[SourceFile]

    def SourceMap():
        files = []

    def add_virtual(name: string, text: string) -> SourceId:
        id = SourceId(u32(len(files)))
        files.append(SourceFile(id, name, text))
        return id

    def load(path: string) -> SourceId | io.IOError:
        text = file.read(path)
        return add_virtual(path, text)

    def get(id: SourceId) -> SourceFile:
        return files[id.index]


def source_id(index: u32) -> SourceId:
    return SourceId(index)


def span(source: SourceId, start: u32, end: u32) -> Span:
    assert(start <= end, "source span must be ordered")
    return Span(source, start, end)


def virtual_source(name: string, text: string) -> SourceFile:
    return SourceFile(SourceId(0), name, text)


def load(path: string) -> SourceFile | io.IOError:
    text = file.read(path)
    return SourceFile(SourceId(0), path, text)
