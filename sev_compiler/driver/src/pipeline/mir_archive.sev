import * from "../../package.pkg/build/mir_archive.sev" as codec
import * from "package:interface/src/package_metadata.sev" as metadata
import universal
import * from "package:interface/src/semantic_graph.sev" as semantic_interface
import package


def encode(module: universal.Module) -> list[u8]:
    tokens: list[string] = []
    codec.put_universal_Module(tokens, module)
    return metadata.encode_sections("SEVMIR", [codec.schema(), tokens.join("\n")])


def decode(location: string) -> universal.Module | Error:
    bytes = package.read_bytes(location)
    magic = "SEVMIR"
    if metadata.decode_section(bytes, magic, 1) != codec.schema():
        throw Error("incompatible Severian MIR schema")
    input = codec.ArchiveInput(metadata.decode_section(bytes, magic, 2).split("\n"))
    module = codec.get_universal_Module(input)
    if input.cursor != int(len(input.lines)):
        throw Error("unindexed Severian MIR data")
    semantic_interface.validate_semantic_module(module)
    return module
