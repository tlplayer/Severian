import "../../../../hir/module/module.sev" as model_hir_module_module
import "../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import package
import lexer
import source
import os
import path
import "frontend_archive.sev" as archive
import "package:semantic/semantic/src/callable.sev" as semantic
import "package:semantic/semantic/src/lazy_bodies.sev" as lazy_bodies


class Prelude:
    module: model_hir_module_module.Module
    registry: lexer.SyntaxRegistry
    files: list[source.SourceFile]
    prepared: list[semantic.PreludeAnalysis]


class PreludeResult:
    value: Prelude | None


def validate_names(excluded: list[string], available: list[string]) -> unit | Error:
    for name in excluded:
        if name not in available:
            throw Error("unknown prelude exclusion: " + name)


def write(destination: string, module: model_hir_module_module.Module, registry: lexer.SyntaxRegistry, files: list[source.SourceFile], resolution: package.Resolution, sysroot: string) -> unit | Error:
    root = resolution.packages[0].root
    portable: list[source.SourceFile] = []
    for file in files:
        portable.append(source.SourceFile(file.id, package.portable_path(file.path, resolution, root, sysroot), file.text))
    discovered: list[string] = []
    for location in registry.discovered:
        discovered.append(package.portable_path(location, resolution, root, sysroot))
    lexical: list[string] = []
    for location in registry.lexical_discovered:
        lexical.append(package.portable_path(location, resolution, root, sysroot))
    syntax = lexer.SyntaxRegistry(registry.operators, registry.descriptors, discovered, registry.rules, lexical)
    output = [archive.schema()]
    archive.put_model_hir_module_module_Module(output, module)
    archive.put_lexer_SyntaxRegistry(output, syntax)
    archive.put_list_source_SourceFile(output, portable)
    package.write_text(destination, output.join("\n") + "\n")
    snapshot: list[string] = []
    archive.put_model_hir_module_module_Module(snapshot, module)
    indexed = archive.get_model_hir_module_module_Module(archive.ArchiveInput(snapshot))
    directory = destination + ".bodies"
    package.mkdir(directory)
    items: list[model_hir_module_module.Item] = []
    slot := 0
    for item in indexed.items:
        match item:
            case Function:
                # Expression macros are needed during expansion; their bodies
                # remain part of the grammar metadata in the index.
                result ?= declaration.result
                expression_macro := false
                if result != None:
                    expression_macro = model_syntax_type_annotation.simple_type_name(result) == "Ex"
                if not expression_macro and len(declaration.attachments) == 0:
                    declaration = lazy_bodies.store(declaration, directory, slot)
                    slot += 1
                items.append(model_hir_module_module.Function(declaration))
            case _:
                items.append(item)
    indexed.items = items
    locations: list[source.SourceFile] = []
    for file in portable:
        locations.append(source.SourceFile(file.id, file.path, ""))
    index = ["indexed-prelude-1", archive.schema()]
    archive.put_model_hir_module_module_Module(index, indexed)
    archive.put_lexer_SyntaxRegistry(index, syntax)
    archive.put_list_source_SourceFile(index, locations)
    package.write_text(destination + ".index", index.join("\n"))



def finish(destination: string, prepared: list[semantic.PreludeAnalysis]) -> unit | Error:
    output: list[string] = []
    archive.put_list_semantic_PreludeAnalysis(output, prepared)
    package.write_text(destination, package.read_text(destination) + output.join("\n") + "\n")


def read(sysroot: string) -> PreludeResult | Error:
    # The toolchain requests latest on every invocation. Unit cache keys include
    # registry discovery, while release manifests pin transitive dependencies.
    if len(package.versions("sev-prelude")) == 0:
        return PreludeResult(None)
    project = package.open(package.fetch(package.reference("sev-prelude@latest")))
    location = path.dirname(project.root) + "/package.pkgi/prelude/" + archive.schema() + "/frontend.txt"
    if not os.is_file(location):
        throw Error("latest sev-prelude has no compatible frontend artifact; republish it with this compiler")
    resolution = package.resolve(project, package.Resolve("build", true, ""))
    if os.is_file(location + ".index"):
        return read_index(location, resolution, project.root, sysroot)
    input = archive.ArchiveInput(package.read_text(location).split("\n"))
    if archive.take(input) != archive.schema():
        throw Error("incompatible prelude frontend archive")
    module = archive.get_model_hir_module_module_Module(input)
    registry = archive.get_lexer_SyntaxRegistry(input)
    files = archive.get_list_source_SourceFile(input)
    prepared = archive.get_list_semantic_PreludeAnalysis(input)
    if input.cursor != int(len(input.lines)) - 1 or input.lines[-1] != "":
        throw Error("trailing frontend archive data")
    for index in range(int(len(files))):
        file = files[index]
        file.path = package.relocated_path(file.path, resolution, project.root, sysroot)
        files[index] = file
    for index in range(int(len(registry.discovered))):
        registry.discovered[index] = package.relocated_path(registry.discovered[index], resolution, project.root, sysroot)
    for index in range(int(len(registry.lexical_discovered))):
        registry.lexical_discovered[index] = package.relocated_path(registry.lexical_discovered[index], resolution, project.root, sysroot)
    return PreludeResult(Prelude(module, registry, files, prepared))


# The index contains the complete candidate set, but no ordinary function
# bodies, prepared semantic graph, or original source text.
def read_index(location: string, resolution: package.Resolution, root: string, sysroot: string) -> PreludeResult | Error:
    input = archive.ArchiveInput(package.read_text(location + ".index").split("\n"))
    if archive.take(input) != "indexed-prelude-1" or archive.take(input) != archive.schema():
        throw Error("incompatible indexed prelude")
    module = archive.get_model_hir_module_module_Module(input)
    registry = archive.get_lexer_SyntaxRegistry(input)
    files = archive.get_list_source_SourceFile(input)
    if input.cursor != len(input.lines):
        throw Error("trailing indexed prelude data")
    items: list[model_hir_module_module.Item] = []
    for item in module.items:
        match item:
            case Function:
                if declaration.lazy_body != "":
                    name = declaration.lazy_body
                    if not name.starts_with("body-") or not name.ends_with(".txt") or name.contains("/") or name.contains("..") or name.contains("\\"):
                        throw Error("invalid indexed prelude body location")
                    declaration.lazy_body = location + ".bodies/" + name
                items.append(model_hir_module_module.Function(declaration))
            case _:
                items.append(item)
    module.items = items
    index := 0
    for file in files:
        file.path = package.relocated_path(file.path, resolution, root, sysroot)
        files[index] = file
        index += 1
    for index in range(int(len(registry.discovered))):
        registry.discovered[index] = package.relocated_path(registry.discovered[index], resolution, root, sysroot)
    for index in range(int(len(registry.lexical_discovered))):
        registry.lexical_discovered[index] = package.relocated_path(registry.lexical_discovered[index], resolution, root, sysroot)
    return PreludeResult(Prelude(module, registry, files, []))
