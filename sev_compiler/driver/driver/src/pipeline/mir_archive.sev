import "../../../../hir/module/module.sev" as model_hir_module_module
import "../../../package.pkg/build/mir_archive.sev" as codec
import "package:interface/interface/src/package_metadata.sev" as metadata
import "package:interface/interface/src/semantic_graph.sev" as semantic_interface
import package


def encode(module: model_hir_module_module.Module) -> list[u8]:
    tokens: list[string] = []
    codec.put_model_hir_module_module_Module(tokens, module)
    return metadata.encode_sections("SEVMIR", [codec.schema(), tokens.join("\n")])


def decode(location: string) -> model_hir_module_module.Module | Error:
    bytes = package.read_bytes(location)
    magic = "SEVMIR"
    if metadata.decode_section(bytes, magic, 1) != codec.schema():
        throw Error("incompatible Severian MIR schema")
    input = codec.ArchiveInput(metadata.decode_section(bytes, magic, 2).split("\n"))
    module = codec.get_model_hir_module_module_Module(input)
    if input.cursor != int(len(input.lines)):
        throw Error("unindexed Severian MIR data")
    semantic_interface.validate_semantic_module(module)
    return module
