import source
import CfgBody, empty_cfg from "cfg.sev"
import CfgEdge, CfgExit, CfgTerminator, Constant, TypeId, ValueId, execution_block, inherit_source, span from "block.sev"
import Block, BlockKind, OperationOrigin, SourceBlockId from "../../syntax/block/block.sev"
import Operation from "../../syntax/function/function.sev"
import diagnostics

# Compiler-owned state. Source semantic execution receives a checked capability,
# never an ordinary runtime value or a callable that can capture this object.
class ExecutionContext:
    body: CfgBody
    cursor: list[int] = [0]
    origin: OperationOrigin = OperationOrigin()
    source_block: Block | None = None


def block(context: ExecutionContext) -> int:
    index = int(len(context.body.blocks))
    context.body.blocks.append(execution_block(index, context.origin, context.source_block))
    return index


def bind_source(context: ExecutionContext, source_block: Block):
    context.source_block = source_block
    selected = context.body.blocks[context.cursor[0]]
    if len(selected.operations) == 0 and selected.terminator == None:
        selected.origin = OperationOrigin(context.origin.span, context.origin.block, context.origin.callable, context.origin.path[:])
        inherit_source(selected, source_block)
        context.body.blocks[context.cursor[0]] = selected


def at(context: ExecutionContext, target: int):
    if target < 0 or target >= len(context.body.blocks):
        throw Error("invalid CFG block handle")
    context.cursor[0] = target


def open(context: ExecutionContext) -> bool:
    return context.body.blocks[context.cursor[0]].terminator == None


def append(context: ExecutionContext, operation: Operation) -> bool | diagnostics.Diagnostic:
    terminated ?= context.body.blocks[context.cursor[0]].terminator
    if terminated != None:
        return error(diagnostics.Diagnostic("E000230", "instruction after CFG terminator", terminated.span))
    append_at(context, context.cursor[0], operation)
    return true


def terminate(context: ExecutionContext, exit: CfgExit, origin: CfgTerminator) -> bool | diagnostics.Diagnostic:
    if not open(context):
        return error(diagnostics.Diagnostic("E000230", "CFG block already terminated: second terminator", origin.span))
    selected = context.body.blocks[context.cursor[0]]
    selected.terminator = CfgTerminator(exit, origin.grammar, origin.span)
    context.body.blocks[context.cursor[0]] = selected
    return true


def fallthrough(context: ExecutionContext, target: int, origin: CfgTerminator):
    if open(context):
        terminate(context, CfgExit.Jump(CfgEdge(target)), origin)


def append_at(context: ExecutionContext, target: int, operation: Operation):
    selected = context.body.blocks[target]
    selected.operations.append(operation)
    selected.origins.append(context.origin)


def source_origin(context: ExecutionContext, span: source.Span | None, block: SourceBlockId | None = None) -> OperationOrigin:
    return OperationOrigin(span, block if block != None else context.origin.block, context.origin.callable, context.origin.path)


test "CFG creation inherits the active source block instead of a numeric source identity":
    original = Block(id=SourceBlockId(17), parent=SourceBlockId(4), kind=BlockKind.While)
    context = ExecutionContext(empty_cfg(TypeId(2), original), source_block=original)
    created = block(context)
    assert(created == 1)
    assert(context.body.blocks[created].cfg_index == created)
    assert(context.body.blocks[created].id.index == 17)
    assert(context.body.blocks[created].parent == original.parent)
    assert(context.body.blocks[created].kind == BlockKind.While)


test "binding a branch source preserves its existing CFG parameters":
    context = ExecutionContext(empty_cfg(TypeId(2)))
    context.body.blocks[0].parameters.append(ValueId(3))
    branch = Block(id=SourceBlockId(23), kind=BlockKind.Else)
    context.origin = OperationOrigin(block=branch.id)
    bind_source(context, branch)
    assert(context.body.blocks[0].id.index == 23)
    assert(context.body.blocks[0].kind == BlockKind.Else)
    assert(context.body.blocks[0].cfg_index == 0)
    assert(context.body.blocks[0].parameters[0].index == 3)
