import * from "../../syntax/block/block.sev"
import * from "block.sev" as cfg_blocks
import * from "branch.sev"
import * from "lazy.sev"
import * from "effects.sev"
import * from "control_flow.sev" as control_flow
import source
import * from "../../syntax/function/lowering.sev"
import * from "../../syntax/symbol/symbol.sev"
import * from "../../syntax/literal/value.sev"
import * from "../../syntax/function/syntax.sev"
import * from "../../syntax/function/function.sev"
import * from "../../syntax/source.sev"


class LocalDecl:
    id: LocalId
    type_id: TypeId
    mutable: bool
    argument: bool


enum Projection:
    Field(index: u32)
    Index(local: LocalId)
    Dereference
    Downcast(variant: u32)


class Place:
    local: LocalId
    projection: list[Projection]


def local_place(local: LocalId) -> Place:
    return Place(local, [])


enum Operand:
    Copy(place: Place)
    Move(place: Place)
    Constant(value: LiteralValue, type_id: TypeId)
    Function(definition: DefId)


enum Callee:
    Direct(function: DefId, substitution: Substitution)
    FunctionValue(operand: Operand)
    Method(implementation: DefId, receiver: Operand, substitution: Substitution)
    Constructor(type_definition: DefId, variant: VariantId | None)
    Intrinsic(operation: OpId)


enum Rvalue:
    Use(operand: Operand)
    Unary(operator: UnaryOperator, operand: Operand)
    Binary(operator: BinaryOperator, left: Operand, right: Operand)
    BorrowShared(place: Place)
    BorrowExclusive(place: Place)
    Convert(operand: Operand, conversion: ExpressionConversion)
    Aggregate(type_id: TypeId, fields: list[Operand])


enum CfgStatement:
    Assign(place: Place, value: Rvalue)
    Drop(place: Place)
    StorageLive(local: LocalId)
    StorageDead(local: LocalId)
    Assert(condition: Operand, message: Operand | None)
    Coverage(point: CoveragePoint)
    Operation(id: OpId, operands: list[Operand], results: list[Place], attributes: map[AttributeId, AttrValue])


enum SwitchCase:
    Integer(value: i128)
    Boolean(value: bool)
    Variant(index: u32)
    Type(type_id: TypeId)


class CfgBody:
    entry: int
    blocks: list[Block]
    return_type: TypeId
    origin: OperationOrigin = OperationOrigin()


def empty_cfg(return_type: TypeId, source_block: Block | None = None) -> CfgBody:
    return CfgBody(0, [cfg_blocks.execution_block(0, source_block=source_block)], return_type)


test "CFG entry uses the shared block defaults":
    body = empty_cfg(TypeId(2), Block(id=SourceBlockId(12), kind=BlockKind.Callable))
    assert(body.entry == 0)
    assert(len(body.blocks) == 1)
    assert(body.blocks[0].cfg_index == 0)
    assert(body.blocks[0].id.index == 12)
    assert(body.blocks[0].kind == BlockKind.Callable)
    assert(len(body.blocks[0].operations) == 0)
    assert(body.blocks[0].terminator == None)
