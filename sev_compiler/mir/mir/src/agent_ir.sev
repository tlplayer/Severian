import "../../../frontend/modules/graph/model.sev" as model_frontend_modules_graph_model
import "../../../hir/module/module.sev" as model_hir_module_module
import "../../cfg/cfg.sev" as model_mir_cfg_cfg
import "../../../syntax/block/block.sev" as model_syntax_block_block
import "../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import "../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import "../../../frontend/modules/graph/queries.sev" as graph_queries
import source
import "hierarchy_ir.sev" as hierarchy_ir
import "cfg.sev" as cfg
import "semantic_graph.sev" as semantic_graph


def quoted(value: string) -> string:
    return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") + "\""


def identity(id: model_syntax_symbol_symbol.DefId) -> string:
    return quoted(model_frontend_modules_graph_model.definition_identity(id))


def span_json(span: source.Span, files: list[source.SourceFile]) -> string | Error:
    for file in files:
        if file.id.index == span.source.index:
            if span.end < span.start:
                throw Error("reversed source span in Agent IR")
            return "{\"path\":" + quoted(file.path) + ",\"start\":" + string(source.utf8_offset(file, span.start)) + ",\"end\":" + string(source.utf8_offset(file, span.end)) + "}"
    throw Error("unknown source identity in Agent IR")


def metadata_value(expression: model_syntax_function_function.Expression) -> string:
    match expression.kind:
        case LiteralValue:
            match value:
                case NoneValue:
                    return "null"
                case BooleanValue:
                    return "true" if value else "false"
                case IntegerValue:
                    return spelling
                case StringValue:
                    return quoted(value)
                case FloatValue:
                    return quoted(spelling)
                case CharacterValue:
                    return string(value)
                case _:
                    return "null"
        case Name:
            return "null" if name == "absent" else quoted(name)
        case SourceSymbol:
            return quoted(spelling)
        case _:
            return "null"


def values_json(values: list[model_syntax_symbol_symbol.ValueId]) -> string:
    output: list[string] = []
    for value in values:
        output.append(quoted(string(value.index)))
    return "[" + output.join(",") + "]"


def operation_kind(operation: model_syntax_function_function.Operation) -> string:
    match operation:
        case DebugOwnership:
            return "DebugOwnership"
        case DebugLocation:
            return "DebugLocation"
        case DebugValue:
            return "DebugValue"
        case Coverage:
            return "Coverage"
        case TypeLayout:
            return "TypeLayout"
        case IsVariant:
            return "IsVariant"
        case Allocate:
            return "Allocate"
        case Constant:
            return "Constant"
        case Load:
            return "Load"
        case Store:
            return "Store"
        case Alias:
            return "Alias"
        case CallFields:
            return "Call"
        case Call:
            return "Call"
        case Unary:
            return "Unary"
        case Binary:
            return "Binary"
        case FieldAddress:
            return "FieldAddress"
        case Assert:
            return "Assert"
        case _:
            throw Error("noncanonical operation in Agent IR")


def origin_json(origin: model_syntax_block_block.OperationOrigin, files: list[source.SourceFile]) -> string | Error:
    location := "null"
    span ?= origin.span
    if span != None:
        location = span_json(span, files)
    block := "null"
    source_block ?= origin.block
    if source_block != None:
        block = string(source_block.index)
    frames: list[string] = []
    for frame in origin.path:
        callsite := "null"
        span ?= frame.span
        if span != None:
            callsite = span_json(span, files)
        frames.append("{\"definition\":" + identity(frame.definition) + ",\"name\":" + quoted(frame.name) + ",\"source\":" + callsite + "}")
    return "{\"block\":" + block + ",\"source\":" + location + ",\"callable_path\":[" + frames.join(",") + "]}"


def body_json(definition: model_syntax_symbol_symbol.DefId, body: model_mir_cfg_cfg.CfgBody, files: list[source.SourceFile], module: model_hir_module_module.Module) -> string | Error:
    blocks: list[string] = []
    for block in body.blocks:
        operations: list[string] = []
        origins: list[string] = []
        position := 0
        for operation in block.operations:
            operations.append(operation_json(operation, module))
            origins.append(origin_json(block.origins[position], files))
            position += 1
        terminal ?= block.terminator
        if terminal != None:
            kind := "Unreachable"
            payload := ""
            match terminal.exit:
                case Jump:
                    kind = "Branch"
                case Conditional:
                    kind = "ConditionalBranch"
                    payload = ",\"condition\":" + quoted(string(condition.index))
                case Raise:
                    kind = "Throw"
                    payload = ",\"value\":" + quoted(string(value.index))
                case FinishFields:
                    kind = "Return"
                    payload = ",\"values\":" + values_json(values)
                case Finish:
                    kind = "Return"
                    returned ?= value
                    payload = ",\"value\":null"
                    if returned != None:
                        payload = ",\"value\":" + quoted(string(returned.index))
                case _:
                    throw Error("Unimplemented (sev_compiler/transforms/mir/src/agent_ir.sev)")
            edges: list[string] = []
            for edge in cfg.successors(terminal.exit):
                edges.append("{\"target\":" + quoted(string(edge.target)) + ",\"arguments\":" + values_json(edge.arguments) + "}")
            terminator = "{\"kind\":" + quoted(kind) + payload + ",\"grammar\":" + identity(terminal.grammar) + ",\"source\":" + span_json(terminal.span, files) + ",\"successors\":[" + edges.join(",") + "]}"
            blocks.append("{\"id\":" + quoted(string(block.cfg_index)) + ",\"kind\":" + quoted(hierarchy_ir.block_kind(block.kind)) + ",\"origin\":" + origin_json(block.origin, files) + ",\"parameters\":" + values_json(block.parameters) + ",\"operations\":[" + operations.join(",") + "],\"origins\":[" + origins.join(",") + "],\"terminator\":" + terminator + "}")
    return "{\"definition\":" + identity(definition) + ",\"entry\":" + quoted(string(body.entry)) + ",\"blocks\":[" + blocks.join(",") + "]}"


def emit(module: model_hir_module_module.Module, files: list[source.SourceFile], graph: model_frontend_modules_graph_model.DefinitionGraph, package_graph: string) -> string | Error:
    if not graph.frozen:
        throw Error("Agent IR requires a verified semantic graph")
    definitions: list[string] = []
    functions: list[string] = []
    values: list[string] = []
    for value in module.values:
        values.append("{\"id\":" + quoted(string(value.id.index)) + ",\"type\":" + string(value.type_id.index) + "}")
    emitted: list[string] = []
    for declaration in module.traits:
        key = model_frontend_modules_graph_model.definition_identity(declaration.definition)
        if key in emitted:
            continue
        emitted.append(key)
        node = graph.nodes[model_frontend_modules_graph_model.definition_index(graph, declaration.definition).index]
        aliases: list[string] = []
        for name in node.names:
            aliases.append(quoted(name))
        bases: list[string] = []
        for base in declaration.bases:
            name ?= model_syntax_type_annotation.simple_type_name(base)
            if name != None:
                bases.append(identity(semantic_graph.grammar_parent(module, declaration, name)))
        properties: list[string] = []
        for property in declaration.properties:
            value ?= property.default
            if value != None:
                properties.append(quoted(property.name) + ":" + metadata_value(value))
        kind = "grammar" if declaration.grammar else "trait"
        definitions.append("{\"id\":" + identity(declaration.definition) + ",\"submodule\":" + string(node.submodule) + ",\"name\":" + quoted(declaration.name) + ",\"aliases\":[" + aliases.join(",") + "],\"kind\":" + quoted(kind) + ",\"bases\":[" + bases.join(",") + "],\"metadata\":{" + properties.join(",") + "},\"source\":" + span_json(declaration.span, files) + "}")
    for declaration in module.functions:
        key = model_frontend_modules_graph_model.definition_identity(declaration.definition)
        if key in emitted:
            continue
        emitted.append(key)
        node = graph.nodes[model_frontend_modules_graph_model.definition_index(graph, declaration.definition).index]
        origin := "null"
        declared ?= declaration.span
        if declared != None:
            origin = span_json(declared, files)
        definitions.append("{\"id\":" + identity(declaration.definition) + ",\"submodule\":" + string(node.submodule) + ",\"name\":" + quoted(declaration.name) + ",\"kind\":\"function\",\"bases\":[],\"source\":" + origin + "}")
        if declaration.cfg_index >= 0:
            functions.append(body_json(declaration.definition, module.cfg_bodies[declaration.cfg_index], files, module))
    if len(module.cfg_bodies) != 0:
        definition = model_syntax_symbol_symbol.DefId(0, 0, model_syntax_symbol_symbol.DeclarationId(0))
        node = graph.nodes[model_frontend_modules_graph_model.definition_index(graph, definition).index]
        definitions.append("{\"id\":" + identity(definition) + ",\"submodule\":" + string(node.submodule) + ",\"name\":\"$initializer\",\"kind\":\"function\",\"bases\":[],\"source\":null}")
        functions.append(body_json(definition, module.cfg_bodies[0], files, module))
    dependencies: list[string] = []
    for edge in graph.dependencies:
        kind = "call" if edge.kind == model_frontend_modules_graph_model.DependencyKind.Invocation else "inherits"
        origin := "null"
        location ?= edge.origin
        if location != None:
            origin = origin_json(location, files)
        dependencies.append("{\"from\":" + identity(graph.nodes[edge.dependent.index].definition) + ",\"to\":" + identity(graph.nodes[edge.requirement.index].definition) + ",\"kind\":" + quoted(kind) + ",\"origin\":" + origin + "}")
    components: list[string] = []
    for component in graph_queries.dependency_components(graph):
        members: list[string] = []
        for member in component.members:
            members.append(identity(graph.nodes[member.index].definition))
        components.append("[" + members.join(",") + "]")
    return "{\"semantic_hierarchy\":" + hierarchy_ir.emit(module, graph, files) + ",\"schema_version\":2,\"stage\":\"cfg\",\"source_coordinates\":\"utf8-bytes\",\"package_graph\":" + package_graph + ",\"definitions\":[" + definitions.join(",") + "],\"functions\":[" + functions.join(",") + "],\"values\":[" + values.join(",") + "],\"dependencies\":[" + dependencies.join(",") + "],\"dependency_components\":[" + components.join(",") + "]}"



def operation_json(operation: model_syntax_function_function.Operation, module: model_hir_module_module.Module) -> string | Error:
    fields := ""
    operands: list[model_syntax_symbol_symbol.ValueId] := []
    results: list[model_syntax_symbol_symbol.ValueId] = []
    match operation:
        case DebugOwnership:
            fields = ",\"name\":" + quoted(name) + ",\"ownership\":" + quoted(mode)
        case DebugValue:
            operands.append(value)
            fields = ",\"name\":" + quoted(name) + ",\"ownership\":" + quoted(ownership) + ",\"address\":" + string(address)
        case TypeLayout:
            fields = ",\"type\":" + string(subject.index) + ",\"alignment\":" + ("true" if alignment else "false")
            results.append(result)
        case IsVariant:
            operands.append(value)
            results.append(result)
            fields = ",\"variant\":" + string(variant)
        case Allocate:
            fields = ",\"type\":" + string(type_id.index)
            results.append(result)
        case Constant:
            literal = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(value), source.Span(source.SourceId(0), 0, 0))
            fields = ",\"value\":" + metadata_value(literal)
            results.append(result)
        case Load:
            operands.append(address)
            results.append(result)
        case Store:
            operands.append(address)
            operands.append(value)
        case Alias:
            operands.append(value)
            results.append(result)
        case FieldAddress:
            operands.append(object)
            results.append(result)
            fields = ",\"owner\":" + string(owner.index) + ",\"field\":" + string(index)
        case CallFields:
            operands = arguments
            for output in outputs:
                results.append(output)
            fields = ",\"function\":" + identity(semantic_graph.callable_definition(module, function))
        case Call:
            operands = arguments
            results.append(result)
            fields = ",\"function\":" + identity(semantic_graph.callable_definition(module, function))
        case Unary:
            operands.append(operand)
            results.append(result)
            fields = ",\"symbol\":" + quoted(operator.symbol) + ",\"grammar\":" + identity(operator.definition)
        case Binary:
            operands.append(left)
            operands.append(right)
            results.append(result)
            fields = ",\"symbol\":" + quoted(operator.symbol) + ",\"grammar\":" + identity(operator.definition)
        case Assert:
            operands.append(condition)
        case _:
            throw Error("unimplemented (sev_compiler/transforms/mir/src/agent_ir.sev)")
    return "{\"kind\":" + quoted(operation_kind(operation)) + fields + ",\"operands\":" + values_json(operands) + ",\"results\":" + values_json(results) + "}"
