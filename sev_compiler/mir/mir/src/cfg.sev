import * from "../../../hir/module/module.sev" as model_hir_module_module
import * from "../../cfg/branch.sev" as model_mir_cfg_branch
import * from "../../cfg/cfg.sev" as model_mir_cfg_cfg
import * from "../../value.sev" as model_mir_value
import * from "../../../syntax/block/block.sev" as model_syntax_block_block
import * from "../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../syntax/literal/value.sev" as model_syntax_literal_value
import * from "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import * from "package:ownership/ownership/src/cfg.sev" as ownership_cfg
import * from "../../cfg/availability.sev" as availability
import * from "../../cfg/dominance.sev" as graph
import * from "package:cfg_builder/builder.sev"
import * from "../../../syntax/type/storage.sev" as storage_types
import source
import diagnostics


def origin(module: model_hir_module_module.Module, name: string, span: source.Span) -> model_mir_cfg_branch.CfgTerminator:
    for definition in module.traits:
        if definition.grammar and definition.name == name:
            return model_mir_cfg_branch.CfgTerminator(model_mir_cfg_branch.CfgExit.Dead, definition.definition, span)
    throw Error("missing source grammar contract " + name)


def successors(exit: model_mir_cfg_branch.CfgExit) -> list[model_mir_cfg_branch.CfgEdge]:
    match exit:
        case Jump:
            return [edge]
        case Conditional:
            return [taken, otherwise]
        case _:
            return []


def finish(module: model_hir_module_module.Module, context: ExecutionContext, span: source.Span, parameters: list[model_syntax_symbol_symbol.ValueId] = []) -> bool | diagnostics.Diagnostic:
    origin = origin(module, "Return", span)
    if open(context):
        terminate(context, model_mir_cfg_branch.CfgExit.Finish(None) if context.body.return_type.index == 2 else model_mir_cfg_branch.CfgExit.Dead, origin)
    verify(module, context.body)
    prune_unreachable(context.body)
    verify_availability(context.body, parameters)
    return verify(module, context.body)


def verify(module: model_hir_module_module.Module, body: model_mir_cfg_cfg.CfgBody) -> bool | diagnostics.Diagnostic:
    if body.entry < 0 or body.entry >= len(body.blocks):
        return error(diagnostics.Diagnostic("E000230", "CFG entry block does not exist", None))
    block_index := 0
    for selected in body.blocks:
        if selected.cfg_index != block_index:
            return error(diagnostics.Diagnostic("E000230", "CFG block identity mismatch", None))
        layout ?= selected.layout
        if layout != None:
            if selected.id.index != layout.id.index or selected.kind != layout.kind:
                return error(diagnostics.Diagnostic("E000230", "CFG block lost its source block identity or kind", selected.span))
        block_index += 1
        terminator ?= selected.terminator
        if terminator == None:
            return error(diagnostics.Diagnostic("E000230", "CFG block requires exactly one terminator", None))
        if terminator != None:
            resolved := false
            for definition in module.traits:
                if definition.grammar and definition.definition.module == terminator.grammar.module and definition.definition.declaration.value == terminator.grammar.declaration.value:
                    resolved = true
            if not resolved:
                return error(diagnostics.Diagnostic("E000230", "CFG edge requires resolved grammar provenance", terminator.span))
            match terminator.exit:
                case Conditional:
                    if module.values[condition.index].type_id.index != 1:
                        return error(diagnostics.Diagnostic("E000230", "CFG branch requires bool", terminator.span))
                case Raise:
                    type_id = module.values[value.index].type_id
                    valid := false
                    for record in module.records:
                        if record.type_id.index == type_id.index and len(model_syntax_function_function.outcome_variants(record)) != 0:
                            valid = true
                    if not valid:
                        return error(diagnostics.Diagnostic("E000230", "CFG raise requires a typed outcome", terminator.span))
                    if body.return_type.index != 2 and body.return_type.index != type_id.index:
                        return error(diagnostics.Diagnostic("E000230", "CFG error outcome does not match function boundary", terminator.span))
                case FinishFields:
                    expected = storage_types.value_fields(body.return_type, module.records)
                    if len(values) != len(expected):
                        return error(diagnostics.Diagnostic("E000230", "CFG return field count mismatch", terminator.span))
                    position := 0
                    for returned in values:
                        if module.values[returned.index].type_id.index != expected[position].index:
                            return error(diagnostics.Diagnostic("E000230", "CFG return field type mismatch", terminator.span))
                        position += 1
                case Finish:
                    returned ?= value
                    if returned != None:
                        if module.values[returned.index].type_id.index != body.return_type.index:
                            return error(diagnostics.Diagnostic("E000230", "CFG return type mismatch", terminator.span))
                    elif body.return_type.index != 2:
                        return error(diagnostics.Diagnostic("E000230", "CFG return requires a value", terminator.span))
                case _:
                    throw diagnostics.diagnostic("E000230", "unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
            for edge in successors(terminator.exit):
                if edge.target < 0 or edge.target >= len(body.blocks):
                    return error(diagnostics.Diagnostic("E000230", "CFG successor does not exist", terminator.span))
                parameters = body.blocks[edge.target].parameters
                if len(parameters) != len(edge.arguments):
                    return error(diagnostics.Diagnostic("E000230", "CFG successor argument count mismatch", terminator.span))
                index := 0
                for argument in edge.arguments:
                    if module.values[argument.index].type_id.index != module.values[parameters[index].index].type_id.index:
                        return error(diagnostics.Diagnostic("E000230", "CFG successor argument type mismatch", terminator.span))
                    index += 1
    return true



def value(module: model_hir_module_module.Module, type_id: model_syntax_symbol_symbol.TypeId) -> model_syntax_symbol_symbol.ValueId:
    id = model_syntax_symbol_symbol.ValueId(u32(len(module.values)))
    module.values.append(model_mir_value.Value(id, type_id))
    return id


def simplify_storage(module: model_hir_module_module.Module, body: model_mir_cfg_cfg.CfgBody):
    slots: list[model_syntax_symbol_symbol.ValueId] = []
    counts: list[int] = []
    initialized: list[model_syntax_symbol_symbol.ValueId] = []
    definitions: list[int] = []
    positions: list[int] = []
    direct: list[bool] = []
    for block in body.blocks:
        for operation in block.operations:
            match operation:
                case Allocate:
                    if type_id.index == 3 or storage_types.buffer_element(type_id, module.records).index != 0:
                        slots.append(result)
                        counts.append(0)
                        initialized.append(result)
                        definitions.append(-1)
                        positions.append(-1)
                        direct.append(true)
                case _:
                    throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
    for block in body.blocks:
        position := 0
        for operation in block.operations:
            match operation:
                case Store:
                    index := 0
                    for slot in slots:
                        if slot.index == address.index:
                            counts[index] += 1
                            initialized[index] = value
                            definitions[index] = block.cfg_index
                            positions[index] = position
                        index += 1
                case _:
                    throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
            position += 1
    parents = dominators(body)
    for block in body.blocks:
        position := 0
        for operation in block.operations:
            match operation:
                case Load:
                    index := 0
                    for slot in slots:
                        if slot.index == address.index:
                            if counts[index] != 1 or not graph.contains(parents, definitions[index], block.cfg_index):
                                direct[index] = false
                            elif definitions[index] == block.cfg_index and positions[index] >= position:
                                direct[index] = false
                        index += 1
                case Store:
                    throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
                case _:
                    for input in operation_inputs(operation):
                        index := 0
                        for slot in slots:
                            if slot.index == input.index:
                                direct[index] = false
                            index += 1
            position += 1
    for block in body.blocks:
        body.blocks[block.cfg_index] = simplify_storage_block(block, slots, initialized, direct)


def simplify_storage_block(block: model_syntax_block_block.Block, slots: list[model_syntax_symbol_symbol.ValueId], initialized: list[model_syntax_symbol_symbol.ValueId], direct: list[bool]) -> model_syntax_block_block.Block:
    operations: list[model_syntax_function_function.Operation] = []
    origins: list[model_syntax_block_block.OperationOrigin] = []
    position := 0
    for operation in block.operations:
        origin = block.origins[position]
        position += 1
        retained := true
        match operation:
            case Allocate:
                index := 0
                for slot in slots:
                    if slot.index == result.index and direct[index]:
                        retained = false
                    index += 1
            case Store:
                index := 0
                for slot in slots:
                    if slot.index == address.index and direct[index]:
                        retained = false
                    index += 1
            case Load:
                index := 0
                for slot in slots:
                    if slot.index == address.index and direct[index]:
                        operations.append(model_syntax_function_function.Operation.Alias(initialized[index], result))
                        origins.append(origin)
                        retained = false
                    index += 1
            case _:
                throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
        if retained:
            operations.append(operation)
            origins.append(origin)
    block.operations = operations
    block.origins = origins
    return block


def promote_storage(module: model_hir_module_module.Module, body: model_mir_cfg_cfg.CfgBody):
    simplify_storage(module, body)
    slots: list[model_syntax_symbol_symbol.ValueId] = []
    initial: list[model_syntax_symbol_symbol.ValueId] = []
    prefix: list[model_syntax_function_function.Operation] = []
    prefix_origins: list[model_syntax_block_block.OperationOrigin] = []
    for selected in body.blocks:
        position := 0
        for operation in selected.operations:
            origin = selected.origins[position]
            position += 1
            match operation:
                case Allocate:
                    if type_id.index == 3 or storage_types.buffer_element(type_id, module.records).index != 0:
                        slots.append(result)
                        empty = value(module, type_id)
                        initial.append(empty)
                        prefix.append(model_syntax_function_function.Operation.Constant(model_syntax_literal_value.StringValue("") if type_id.index == 3 else model_syntax_literal_value.NoneValue(), empty))
                        prefix_origins.append(origin)
                    else:
                        prefix.append(operation)
                        prefix_origins.append(origin)
                case _:
                    throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
    for selected in body.blocks:
        body.blocks[selected.cfg_index] = promote_storage_block(module, selected, body.entry, slots, initial, prefix, prefix_origins)


def promote_storage_block(module: model_hir_module_module.Module, selected: model_syntax_block_block.Block, entry: int, slots: list[model_syntax_symbol_symbol.ValueId], initial: list[model_syntax_symbol_symbol.ValueId], prefix: list[model_syntax_function_function.Operation], prefix_origins: list[model_syntax_block_block.OperationOrigin]) -> model_syntax_block_block.Block:
    current := initial[:]
    if selected.cfg_index != entry:
        current = []
        for slot in slots:
            parameter = value(module, module.values[initial[len(current)].index].type_id)
            selected.parameters.append(parameter)
            current.append(parameter)
    operations: list[model_syntax_function_function.Operation] := []
    origins: list[model_syntax_block_block.OperationOrigin] := []
    if selected.cfg_index == entry:
        operations = prefix[:]
        origins = prefix_origins[:]
    position := 0
    for operation in selected.operations:
        origin = selected.origins[position]
        position += 1
        retained := true
        match operation:
            case Allocate:
                retained = false
            case Load:
                index := 0
                for slot in slots:
                    if slot.index == address.index:
                        operations.append(model_syntax_function_function.Operation.Alias(current[index], result))
                        origins.append(origin)
                        retained = false
                    index += 1
            case Store:
                index := 0
                for slot in slots:
                    if slot.index == address.index:
                        current[index] = value
                        retained = false
                    index += 1
            case _:
                throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
        if retained:
            operations.append(operation)
            origins.append(origin)
    selected.operations = operations
    selected.origins = origins
    terminal ?= selected.terminator
    if terminal != None:
        for edge in successors(terminal.exit):
            for item in current:
                edge.arguments.append(item)
    return selected


def operation_inputs(operation: model_syntax_function_function.Operation) -> list[model_syntax_symbol_symbol.ValueId]:
    return ownership_cfg.operation_inputs(operation)


def operation_results(operation: model_syntax_function_function.Operation) -> list[model_syntax_symbol_symbol.ValueId]:
    return ownership_cfg.operation_results(operation)


def reachable_blocks(body: model_mir_cfg_cfg.CfgBody) -> list[int]:
    return ownership_cfg.reachable_blocks(body)


def dominators(body: model_mir_cfg_cfg.CfgBody) -> list[int]:
    return ownership_cfg.dominators(body)


def verify_inputs(values: list[model_syntax_symbol_symbol.ValueId], available: list[int], span: source.Span) -> bool | diagnostics.Diagnostic:
    return ownership_cfg.verify_inputs(values, available, span)


def verify_ssa_inputs(values: list[model_syntax_symbol_symbol.ValueId], definitions: availability.Definitions, parents: list[int], block: int, position: int, span: source.Span) -> bool | diagnostics.Diagnostic:
    return ownership_cfg.verify_ssa_inputs(values, definitions, parents, block, position, span)


def verify_availability(body: model_mir_cfg_cfg.CfgBody, parameters: list[model_syntax_symbol_symbol.ValueId]) -> bool | diagnostics.Diagnostic:
    return ownership_cfg.verify_availability(body, parameters)


def prune_unreachable(body: model_mir_cfg_cfg.CfgBody):
    constants: list[int] = []
    booleans: list[bool] = []
    for block in body.blocks:
        for operation in block.operations:
            match operation:
                case Constant:
                    match value:
                        case BooleanValue:
                            constants.append(int(result.index))
                            booleans.append(value)
                        case _:
                            throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
                case _:
                    throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
    for block in body.blocks:
        terminal ?= block.terminator
        if terminal != None:
            match terminal.exit:
                case Conditional:
                    index := 0
                    for constant in constants:
                        if constant == int(condition.index):
                            edge = taken if booleans[index] else otherwise
                            block.terminator = model_mir_cfg_branch.CfgTerminator(model_mir_cfg_branch.CfgExit.Jump(edge), terminal.grammar, terminal.span)
                            body.blocks[block.cfg_index] = block
                        index += 1
                case _:
                    throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
    reachable = [body.entry]
    cursor := 0
    while cursor < len(reachable):
        terminal ?= body.blocks[reachable[cursor]].terminator
        if terminal != None:
            for edge in successors(terminal.exit):
                if edge.target not in reachable:
                    reachable.append(edge.target)
        cursor += 1
    mapping: list[int] = []
    next := 0
    for block in body.blocks:
        mapping.append(next if block.cfg_index in reachable else -1)
        if block.cfg_index in reachable:
            next += 1
    retained: list[model_syntax_block_block.Block] = []
    for block in body.blocks:
        if block.cfg_index not in reachable:
            continue
        terminal ?= block.terminator
        if terminal != None:
            exit := terminal.exit
            match terminal.exit:
                case Jump:
                    exit = model_mir_cfg_branch.CfgExit.Jump(model_mir_cfg_branch.CfgEdge(mapping[edge.target], edge.arguments))
                case Conditional:
                    left = model_mir_cfg_branch.CfgEdge(mapping[taken.target], taken.arguments)
                    right = model_mir_cfg_branch.CfgEdge(mapping[otherwise.target], otherwise.arguments)
                    exit = model_mir_cfg_branch.CfgExit.Conditional(condition, left, right)
                case _:
                    throw Error("unimplemented (sev_compiler/transforms/mir/src/cfg.sev)")
            block.terminator = model_mir_cfg_branch.CfgTerminator(exit, terminal.grammar, terminal.span)
        block.cfg_index = mapping[block.cfg_index]
        retained.append(block)
    body.entry = mapping[body.entry]
    body.blocks.clear()
    for block in retained:
        body.blocks.append(block)
