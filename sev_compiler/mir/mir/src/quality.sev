import MirAnalysis, MirContext from "model.sev"
import "../../../syntax/block/block.sev" as model_syntax_block_block
import "../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../syntax/source.sev" as model_syntax_source
import "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import source
import "cfg.sev" as cfg

def debug_source(module: MirContext, span: source.Span) -> bool:
    for file in module.analysis.debug_files:
        if file.source_id == span.source_id:
            return true
    return false

# Region identities depend on source identity and position, not visitation order
# or compilation-unit order. Reject a collision instead of merging measurements.
def quality_region(module: MirContext, span: source.Span, kind: string) -> int:
    for excluded in module.analysis.quality.exclusions:
        if excluded.source_id == span.source_id and span.start >= excluded.start and span.start < excluded.end:
            return 0
    for file in module.analysis.quality.files:
        if file.source_id != span.source_id:
            continue
        identity = file.path + ":" + string(span.start) + ":" + string(span.end) + ":" + kind
        id := 1
        for byte in identity.bytes():
            id = (id * 131 + int(byte)) % 9007199254740881
        id = max(id, 1)
        for region in module.analysis.quality.regions:
            if region.id == id:
                if region.file != file.path or region.span.start != span.start or region.span.end != span.end or region.kind != kind:
                    throw Error("quality region identity collision")
                return id
        line := 1
        column := 1
        for index in range(int(span.start)):
            if file.characters[index] == "\n":
                line += 1
                column = 1
            else:
                column += 1
        module.analysis.quality.regions.append(model_syntax_source.QualityRegion(id, kind, span, file.path, line, column))
        return id
    return 0

def quality_hit(module: MirContext, context: cfg.ExecutionContext, span: source.Span, kind: string):
    id = quality_region(module, span, kind)
    if id != 0:
        cfg.append(context, model_syntax_function_function.Operation.Coverage(model_syntax_source.CoveragePoint(span.start, model_syntax_source.CoverageKind.Line, 0, string(id), None, None)))

def quality_decision(module: MirContext, span: source.Span, kind: string, value: model_syntax_symbol_symbol.ValueId) -> model_syntax_function_function.Operation | None:
    otherwise = quality_region(module, span, kind + "False")
    if otherwise == 0:
        return None
    taken = quality_region(module, span, kind + "True")
    key = string(otherwise) + "," + string(taken)
    return model_syntax_function_function.Operation.Coverage(model_syntax_source.CoveragePoint(span.start, model_syntax_source.CoverageKind.Branch, 0, key, None, None, value))

def quality_branches(analysis: MirAnalysis):
    for realization in analysis.callables:
        if realization.key not in analysis.selected:
            continue
        body ?= realization.body
        if body == None:
            continue
        module = MirContext(analysis, realization)
        if body != None:
            for block in body.blocks:
                terminal ?= block.terminator
                if terminal != None:
                    match terminal.exit:
                        case Conditional:
                            measured ?= quality_decision(module, terminal.span, "Branch", condition)
                            if measured != None:
                                realization.changed()
                                block.operations.append(measured)
                                block.origins.append(model_syntax_block_block.OperationOrigin(terminal.span, body.origin.block, body.origin.callable, body.origin.path))
                        case Jump:
                            continue
                        case Raise:
                            continue
                        case Finish:
                            continue
                        case FinishFields:
                            continue
                        case Dead:
                            continue
