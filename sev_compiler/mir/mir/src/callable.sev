import "../../../hir/module/hierarchy.sev" as model_hir_module_hierarchy
import "../../../hir/module/module.sev" as model_hir_module_module
import "../../cfg/branch.sev" as model_mir_cfg_branch
import "../../cfg/cfg.sev" as model_mir_cfg_cfg
import "../../cfg/lazy.sev" as model_mir_cfg_lazy
import "../../value.sev" as model_mir_value
import "../../../syntax/block/block.sev" as model_syntax_block_block
import "../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import "../../../syntax/literal/value.sev" as model_syntax_literal_value
import "../../../syntax/primitive/declarations.sev" as model_syntax_primitive_declarations
import "../../../syntax/source.sev" as model_syntax_source
import "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import "../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import source
import diagnostics
import "cfg.sev" as cfg
import "../../ownership/ownership/src/plan.sev" as ownership
import "aggregate.sev" as aggregate
import "../../../syntax/type/storage.sev" as storage_types
import "../../../syntax/function/lowering.sev" as boundary
import "quality.sev" as quality


class CallableMirScope:
    bindings: list[model_syntax_symbol_symbol.ValueId] = []
    loops: list[tuple[int, int]] = []
    update_operands: list[model_syntax_symbol_symbol.ValueId] = []
    return_target: int = -1
    inline_functions: list[int] = []
    aggregates: aggregate.AggregateStorage = aggregate.AggregateStorage()
    borrowed_records: list[int] = []
    debug_names: list[string] = []
    error_targets: list[int] = []
    error_expectations: list[model_syntax_function_function.Expression] = []


def mir_check_expected_error(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, raised: model_syntax_symbol_symbol.ValueId, expected: model_syntax_function_function.Expression) -> unit | diagnostics.Diagnostic:
    if expected.type_id.index == 0:
        return
    variant_index := -1
    for record in module.records:
        if record.type_id.index == module.values[raised.index].type_id.index:
            index := 0
            for variant in model_syntax_function_function.outcome_variants(record):
                if variant.index == expected.type_id.index:
                    variant_index = index
                index += 1
    matches := mir_value(module, model_syntax_primitive_declarations.bool_type_id())
    if variant_index < 0:
        cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.BooleanValue(false), matches))
    else:
        matches = aggregate.test_variant(module, context, scope.aggregates, raised, variant_index)
    cfg.append(context, model_syntax_function_function.Operation.Assert(matches, None, model_syntax_source.AssertionOrigin(0, 0, 0, None)))
    if variant_index >= 0:
        match expected.kind:
            case ErrorExpectation:
                expected_value ?= value
                predicate ?= comparison
                if expected_value != None:
                    if predicate != None:
                        subject = model_syntax_function_function.Expression(model_syntax_function_function.UpdateOperand(0), expected.span, type_id=module.values[raised.index].type_id)
                        payload = model_syntax_function_function.Expression(model_syntax_function_function.FieldReference(subject, variant_index + 1), expected.span, type_id=expected.type_id)
                        local = CallableMirScope(scope.bindings, scope.loops, [raised], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations)
                        actual = mir_expression(module, context, local, payload)
                        wanted = mir_expression(module, context, scope, expected_value)
                        local.update_operands = [actual, wanted]
                        equal = mir_expression(module, context, local, predicate)
                        cfg.append(context, model_syntax_function_function.Operation.Assert(equal, None, model_syntax_source.AssertionOrigin(0, 0, 0, None)))
            case _:
                return error(diagnostics.Diagnostic("E000231", "invalid error expectation", expected.span))


def mir_value(module: model_hir_module_module.Module, type_id: model_syntax_symbol_symbol.TypeId) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    id = model_syntax_symbol_symbol.ValueId(u32(len(module.values)))
    module.values.append(model_mir_value.Value(id, type_id))
    return id


def mir_expression(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, expression: model_syntax_function_function.Expression) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    previous = context.origin
    context.origin = cfg.source_origin(context, expression.span)
    lowered = mir_expression_value(module, context, scope, expression)
    if len(module.quality_files) > 0 and expression.type_id.index == model_syntax_primitive_declarations.bool_type_id().index:
        match expression.kind:
            case LiteralValue:
                # Constants do not represent a runtime coverage decision.
                context.origin = previous
                return lowered
            case _:
                measured ?= quality.quality_decision(module, expression.span, "Condition", lowered)
                if measured != None:
                    cfg.append(context, measured)
    context.origin = previous
    return lowered

def mir_expression_value(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, expression: model_syntax_function_function.Expression) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    match expression.kind:
        case Ownership:
            result = mir_expression(module, context, scope, value)
            if mode == "move" and quality.debug_source(module, expression.span):
                match value.kind:
                    case BindingReference:
                        if int(binding.index) < len(scope.debug_names):
                            cfg.append(context, model_syntax_function_function.Operation.DebugOwnership(scope.debug_names[binding.index], "moved", expression.span))
                    case _:
                        throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
            return result
        case AddressOf:
            return callable_mir_place(module, context, scope, value)
        case TypeLayout:
            result = mir_value(module, model_syntax_primitive_declarations.i64_type_id())
            cfg.append(context, model_syntax_function_function.Operation.TypeLayout(subject, alignment, result))
            return result
        case BlockValue:
            local = CallableMirScope(scope.bindings[:], scope.loops, scope.update_operands, scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations)
            mir_block(module, context, body, local)
            previous = context.origin
            layout ?= body.layout
            if layout != None:
                context.origin = cfg.source_origin(context, value.span, layout.id)
            result = mir_expression(module, context, local, value)
            context.origin = previous
            return result
        case Evaluate:
            evaluated = mir_expression(module, context, scope, value)
            return mir_expression(module, context, CallableMirScope(scope.bindings, scope.loops, [evaluated], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations), body)
        case UpdateOperand:
            return scope.update_operands[index]
        case ListValue:
            elements_values: list[model_syntax_symbol_symbol.ValueId] = []
            for element in elements:
                elements_values.append(mir_expression(module, context, scope, element))
            count = mir_value(module, model_syntax_primitive_declarations.i64_type_id())
            cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.IntegerValue(string(len(elements))), count))
            exemplar := count
            if len(elements_values) != 0:
                exemplar = elements_values[0]
            else:
                exemplar = mir_value(module, storage_types.buffer_element(expression.type_id, module.records))
                cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.NoneValue(), exemplar))
            local := CallableMirScope(scope.bindings, scope.loops, [count, exemplar], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations)
            result = mir_expression(module, context, local, construction)
            position := 0
            for value in elements_values:
                index = mir_value(module, model_syntax_primitive_declarations.i64_type_id())
                cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.IntegerValue(string(position)), index))
                local = CallableMirScope(scope.bindings, scope.loops, [result, index, value], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations)
                mir_expression(module, context, local, storage)
                position += 1
            return result
        case IndexReference:
            receiver = mir_expression(module, context, scope, object)
            offset = mir_expression(module, context, scope, index)
            return mir_expression(module, context, CallableMirScope(scope.bindings, scope.loops, [receiver, offset], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations), access)
        case OutcomeValue:
            payload = mir_expression(module, context, scope, value)
            if storage_types.owned_record(expression.type_id, module.records):
                handle = aggregate.allocate(module, context, scope.aggregates, expression.type_id)
                members = aggregate.fields(scope.aggregates, handle)
                tag = mir_value(module, model_syntax_primitive_declarations.i64_type_id())
                cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.IntegerValue(string(variant)), tag))
                cfg.append(context, model_syntax_function_function.Operation.Store(members[0], tag))
                aggregate.store(module, context, scope.aggregates, members[variant + 1], payload)
                return handle
            address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
            cfg.append(context, model_syntax_function_function.Operation.Allocate(expression.type_id, address))
            empty = mir_value(module, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.NoneValue(), empty))
            cfg.append(context, model_syntax_function_function.Operation.Store(address, empty))
            tag = mir_value(module, model_syntax_primitive_declarations.i64_type_id())
            cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.IntegerValue(string(variant)), tag))
            tag_address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
            cfg.append(context, model_syntax_function_function.Operation.FieldAddress(address, expression.type_id, 0, tag_address))
            cfg.append(context, model_syntax_function_function.Operation.Store(tag_address, tag))
            payload_address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
            cfg.append(context, model_syntax_function_function.Operation.FieldAddress(address, expression.type_id, variant + 1, payload_address))
            cfg.append(context, model_syntax_function_function.Operation.Store(payload_address, payload))
            result = mir_value(module, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Load(address, result))
            return result
        case OutcomeTest:
            input = mir_expression(module, context, scope, value)
            return aggregate.test_variant(module, context, scope.aggregates, input, variant)
        case OutcomeUnwrap:
            origin = cfg.origin(module, "Outcome", expression.span)
            syntax = model_syntax_function_syntax.OperatorSyntax("", model_syntax_function_syntax.Fixity.Prefix, 0, model_syntax_function_syntax.Associativity.None, definition=origin.grammar)
            evaluated = execute_grammar(module, context, scope, syntax, [value], [], expression.span, expression.type_id)
            return semantic_runtime(evaluated, expression.span)
        case ThrowValue:
            origin = cfg.origin(module, "Throw", expression.span)
            syntax = model_syntax_function_syntax.OperatorSyntax("", model_syntax_function_syntax.Fixity.Prefix, 0, model_syntax_function_syntax.Associativity.None, definition=origin.grammar)
            execute_grammar(module, context, scope, syntax, [value], [], expression.span)
            # Keep expression composition typed after this terminating edge.
            # CFG reachability removes this continuation before emission.
            cfg.at(context, cfg.block(context))
            if storage_types.owned_record(expression.type_id, module.records):
                result = aggregate.allocate(module, context, scope.aggregates, expression.type_id)
                aggregate.initialize(module, context, scope.aggregates, result, expression.type_id)
                return result
            result = mir_value(module, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.NoneValue(), result))
            return result
        case LiteralValue:
            match value:
                case StringValue:
                    if storage_types.string_element(expression.type_id, module.records).index != 0:
                        return callable_string_literal(module, context, scope, value, expression.type_id)
                case _:
                    throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
            result = mir_value(module, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Constant(value, result))
            return result
        case BindingReference:
            address = callable_mir_place(module, context, scope, expression)
            return aggregate.load(module, context, address, expression.type_id)
        case FieldReference:
            address = callable_mir_place(module, context, scope, expression)
            return aggregate.load(module, context, address, expression.type_id)
        case RecordValue:
            if storage_types.owned_record(expression.type_id, module.records):
                handle = aggregate.allocate(module, context, scope.aggregates, expression.type_id)
                members = aggregate.fields(scope.aggregates, handle)
                for record in module.records:
                    if record.type_id.index == expression.type_id.index:
                        field_index := 0
                        for field in record.fields:
                            present := false
                            for argument in fields:
                                if argument.name == field.name:
                                    present = true
                            if not present:
                                aggregate.initialize(module, context, scope.aggregates, members[field_index], field.type_id)
                            field_index += 1
                for argument in fields:
                    value = mir_expression(module, context, scope, argument.value)
                    for record in module.records:
                        if record.type_id.index == expression.type_id.index:
                            index := 0
                            for field in record.fields:
                                if argument.name == field.name:
                                    aggregate.store(module, context, scope.aggregates, members[index], value)
                                index += 1
                return handle
            address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
            cfg.append(context, model_syntax_function_function.Operation.Allocate(expression.type_id, address))
            for argument in fields:
                value = mir_expression(module, context, scope, argument.value)
                for record in module.records:
                    if record.type_id.index == expression.type_id.index:
                        index := 0
                        for field in record.fields:
                            if argument.name == field.name:
                                target = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
                                cfg.append(context, model_syntax_function_function.Operation.FieldAddress(address, expression.type_id, index, target))
                                cfg.append(context, model_syntax_function_function.Operation.Store(target, value))
                            index += 1
            result = mir_value(module, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Load(address, result))
            return result
        case TypeName:
            mir_expression(module, context, scope, value)
            result = mir_value(module, expression.type_id)
            if storage_types.string_element(expression.type_id, module.records).index != 0:
                return callable_string_literal(module, context, scope, name, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.StringValue(name), result))
            return result
        case Unary:
            input = mir_expression(module, context, scope, operand)
            if operator.symbol == "+":
                return input
            result = mir_value(module, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Unary(operator, input, result))
            return result
        case Binary:
            lhs = mir_expression(module, context, scope, left)
            rhs = mir_expression(module, context, scope, right)
            result = mir_value(module, expression.type_id)
            cfg.append(context, model_syntax_function_function.Operation.Binary(operator, lhs, rhs, result))
            return result
        case Conditional:
            origin = cfg.origin(module, "Conditional", expression.span)
            syntax = model_syntax_function_syntax.OperatorSyntax("", model_syntax_function_syntax.Fixity.Prefix, 0, model_syntax_function_syntax.Associativity.None, definition=origin.grammar)
            evaluated = execute_grammar(module, context, scope, syntax, [condition, then_value, else_value], [], expression.span)
            result = semantic_runtime(evaluated, expression.span)
            if module.values[result.index].type_id.index != expression.type_id.index:
                return error(diagnostics.Diagnostic("E000231", "grammar result type mismatch", expression.span))
            return result
        case ResolvedCall:
            match callee:
                case Direct:
                    native := false
                    target: model_syntax_symbol_symbol.FunctionId | None := None
                    for declaration in module.functions:
                        if model_syntax_symbol_symbol.same_definition(declaration.definition, function):
                            target = declaration.id
                            native = boundary.scalar_boundary(declaration, "mlir") != ""
                            if not native and (declaration.result_origin >= 0 or callable_exclusive_signature(declaration) or (declaration.extension and storage_types.buffer_element(declaration.parameter_types[0], module.records).index != 0)):
                                return callable_inline_receiver(module, context, scope, declaration, arguments, expression.span)
                            if aggregate.signature(declaration, module.records):
                                return callable_aggregate_call(module, context, scope, declaration, arguments, expression.span)
                    evaluated: list[model_syntax_symbol_symbol.ValueId] = []
                    for argument in arguments:
                        if storage_types.indirect_value(argument.value.type_id, module.records) and not native:
                            evaluated.append(callable_mir_place(module, context, scope, argument.value))
                        else:
                            evaluated.append(mir_expression(module, context, scope, argument.value))
                    inputs: list[model_syntax_symbol_symbol.ValueId] = []
                    for declaration in module.functions:
                        if model_syntax_symbol_symbol.same_definition(declaration.definition, function):
                            parameter_index := 0
                            for parameter in declaration.parameters:
                                argument_index := 0
                                for argument in arguments:
                                    if argument.name == parameter.name or (argument.name == None and parameter_index == argument_index):
                                        inputs.append(evaluated[argument_index])
                                    argument_index += 1
                                parameter_index += 1
                    result = mir_value(module, expression.type_id)
                    selected ?= target
                    if selected == None:
                        return error(diagnostics.Diagnostic("E000230", "resolved definition has no executable callable", expression.span))
                    if selected != None:
                        cfg.append(context, model_syntax_function_function.Operation.Call(selected, inputs, result))
                    return result
                case _:
                    return error(diagnostics.Diagnostic("E000230", "semantic analysis admitted an unresolved call", expression.span))
        case _:
            throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
    return error(diagnostics.Diagnostic("E000230", "semantic analysis admitted an unresolved expression", expression.span))


# A source extension borrows its receiver's binding. Inline buffer receivers
# before SSA promotion so descriptor replacement and all allocation aliases
# remain visible to the existing ownership pipeline, including loop backedges.
def callable_exclusive_parameter(parameter: model_syntax_function_function.FunctionParameter) -> bool:
    for modifier in parameter.modifiers:
        if modifier.name in ["borrow mut", "inferred write"]:
            return true
    return false


def callable_exclusive_signature(function: model_syntax_function_function.FunctionDeclaration) -> bool:
    for parameter in function.parameters:
        if callable_exclusive_parameter(parameter):
            return true
    return false


def callable_inline_receiver(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, function: model_syntax_function_function.FunctionDeclaration, arguments: list[model_syntax_function_function.CallArgument], span: source.Span) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    previous = context.origin
    path = previous.path[:]
    path.append(model_syntax_block_block.CallableOrigin(function.definition, function.name, span))
    context.origin = model_syntax_block_block.OperationOrigin(span, previous.block, function.definition, path)
    result = callable_inline_receiver_value(module, context, scope, function, arguments, span)
    context.origin = previous
    return result


def callable_inline_receiver_value(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, function: model_syntax_function_function.FunctionDeclaration, arguments: list[model_syntax_function_function.CallArgument], span: source.Span) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    identity = int(function.id.value)
    if identity in scope.inline_functions:
        if aggregate.signature(function, module.records):
            return error(diagnostics.Diagnostic("E000230", "recursive owned aggregate calls require a reference ABI", span))
        return error(diagnostics.Diagnostic("E000230", "recursive buffer receiver methods require a reference ABI", span))
    if boundary.scalar_boundary(function, "mlir") != "" or function.body == None:
        return error(diagnostics.Diagnostic("E000230", "owned aggregate boundaries require an ownership ABI", span))
    continuation = cfg.block(context)
    result := mir_value(module, function.result_type)
    if function.result_type.index != model_syntax_primitive_declarations.unit_type_id().index:
        result = aggregate.parameter(module, context, scope.aggregates, function.result_type, continuation)
    local = CallableMirScope(return_target=continuation, inline_functions=scope.inline_functions[:], aggregates=scope.aggregates)
    local.inline_functions.append(identity)
    # Arguments have been bound to parameters by semantic analysis. Evaluate
    # each once before entering the callee, including aliased value arguments.
    evaluated: list[model_syntax_symbol_symbol.ValueId] = []
    for argument in arguments:
        receiver := function.extension and storage_types.buffer_element(function.parameter_types[0], module.records).index != 0 and argument.name == function.parameters[0].name
        for parameter in function.parameters:
            if argument.name == parameter.name and callable_exclusive_parameter(parameter):
                receiver = true
        if receiver or storage_types.indirect_value(argument.value.type_id, module.records):
            evaluated.append(callable_mir_place(module, context, scope, argument.value))
        else:
            evaluated.append(mir_expression(module, context, scope, argument.value))
    index := 0
    for parameter in function.parameters:
        argument_index := 0
        for argument in arguments:
            if argument.name == parameter.name:
                receiver = (function.extension and index == 0 and storage_types.buffer_element(parameter.type_id, module.records).index != 0) or (callable_exclusive_parameter(parameter) and not storage_types.indirect_value(parameter.type_id, module.records))
                if receiver or storage_types.owned_record(parameter.type_id, module.records):
                    local.bindings.append(evaluated[argument_index])
                    if storage_types.owned_record(parameter.type_id, module.records):
                        local.borrowed_records.append(index)
                else:
                    type_id = model_syntax_primitive_declarations.pointer_type_id() if storage_types.indirect_value(parameter.type_id, module.records) else parameter.type_id
                    cell = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
                    cfg.append(context, model_syntax_function_function.Operation.Allocate(type_id, cell))
                    cfg.append(context, model_syntax_function_function.Operation.Store(cell, evaluated[argument_index]))
                    local.bindings.append(cell)
            argument_index += 1
        index += 1
    body ?= function.body
    if body == None:
        return error(diagnostics.Diagnostic("E000230", "receiver borrowing requires a source body", span))
    if body != None:
        # Inline-only callables never pass through standalone body lowering.
        # Give each expansion its own source layout before emitting operations;
        # emitted origins retain that identity even if the source is reused.
        model_hir_module_hierarchy.hierarchy_region(module.hierarchy, function.definition, body, origin=function.span)
        mir_block(module, context, body, local)
    origin = cfg.origin(module, "Return", span)
    if cfg.open(context):
        if function.result_type.index == model_syntax_primitive_declarations.unit_type_id().index:
            cfg.fallthrough(context, continuation, origin)
        else:
            cfg.terminate(context, model_mir_cfg_branch.CfgExit.Dead, origin)
    cfg.at(context, continuation)
    if function.result_origin >= 0:
        origin_parameter = function.parameters[function.result_origin].name
        argument_index := 0
        for argument in arguments:
            if argument.name == origin_parameter:
                return evaluated[argument_index]
            argument_index += 1
    return result


def mir_block(module: model_hir_module_module.Module, context: cfg.ExecutionContext, block: model_syntax_block_block.Block, scope: CallableMirScope) -> bool | diagnostics.Diagnostic:
    previous = context.origin
    previous_block = context.source_block
    layout ?= block.layout
    if layout != None:
        context.origin = cfg.source_origin(context, layout.span, layout.id)
    cfg.bind_source(context, block)
    result = mir_block_contents(module, context, block, scope)
    context.origin = previous
    context.source_block = previous_block
    return result


def mir_block_contents(module: model_hir_module_module.Module, context: cfg.ExecutionContext, block: model_syntax_block_block.Block, scope: CallableMirScope) -> bool | diagnostics.Diagnostic:
    for statement in block.statements:
        if not cfg.open(context):
            return true
        match statement:
            case BindingStatement:
                context.origin = cfg.source_origin(context, binding.span)
                if quality.debug_source(module, binding.span):
                    while len(scope.debug_names) <= int(binding.id.index):
                        scope.debug_names.append("")
                    scope.debug_names[binding.id.index] = binding.name
                    cfg.append(context, model_syntax_function_function.Operation.DebugLocation(binding.span))
                    debug_mode := binding.value.loan_mode
                    match binding.value.kind:
                        case Ownership:
                            debug_mode = mode
                        case _:
                            throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                    cfg.append(context, model_syntax_function_function.Operation.DebugOwnership(binding.name, debug_mode, binding.span))
                quality.quality_hit(module, context, binding.span, "Statement")
                if binding.value.loan_mode == "borrow mut" and not binding.update:
                    scope.bindings.append(mir_expression(module, context, scope, binding.value))
                    continue
                match binding.value.kind:
                    case Ownership:
                        if mode == "borrow mut" and not binding.update:
                            scope.bindings.append(callable_mir_place(module, context, scope, value))
                            continue
                    case _:
                        throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                value := mir_expression(module, context, scope, binding.value)
                if quality.debug_source(module, binding.span):
                    cfg.append(context, model_syntax_function_function.Operation.DebugValue(binding.name, value, binding.span, 0, binding.value.loan_mode, false, binding.type_id))
                if storage_types.owned_record(binding.type_id, module.records):
                    if binding.update:
                        if int(binding.id.index) in scope.borrowed_records:
                            return error(diagnostics.Diagnostic("E000230", "owned aggregate parameter rebinding requires a reference ABI", binding.span))
                        aggregate.store(module, context, scope.aggregates, scope.bindings[binding.id.index], value)
                    else:
                        destination = aggregate.allocate(module, context, scope.aggregates, binding.type_id)
                        aggregate.store(module, context, scope.aggregates, destination, value)
                        scope.bindings.append(destination)
                    continue
                if storage_types.indirect_value(binding.type_id, module.records):
                    address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
                    cfg.append(context, model_syntax_function_function.Operation.Allocate(binding.type_id, address))
                    cfg.append(context, model_syntax_function_function.Operation.Store(address, value))
                    value = address
                if binding.update:
                    cfg.append(context, model_syntax_function_function.Operation.Store(scope.bindings[binding.id.index], value))
                else:
                    cell = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
                    stored_type = model_syntax_primitive_declarations.pointer_type_id() if storage_types.indirect_value(binding.type_id, module.records) else binding.type_id
                    cfg.append(context, model_syntax_function_function.Operation.Allocate(stored_type, cell))
                    cfg.append(context, model_syntax_function_function.Operation.Store(cell, value))
                    scope.bindings.append(cell)
                if quality.debug_source(module, binding.span):
                    cfg.append(context, model_syntax_function_function.Operation.DebugValue(binding.name, scope.bindings[binding.id.index], binding.span, 0, binding.value.loan_mode, true, binding.type_id))
            case ExpressionStatement:
                context.origin = cfg.source_origin(context, expression.span)
                if quality.debug_source(module, expression.span):
                    cfg.append(context, model_syntax_function_function.Operation.DebugLocation(expression.span))
                quality.quality_hit(module, context, expression.span, "Statement")
                mir_expression(module, context, scope, expression)
            case Assert:
                context.origin = cfg.source_origin(context, span)
                quality.quality_hit(module, context, span, "Statement")
                value = mir_expression(module, context, scope, condition)
                origin = model_syntax_source.AssertionOrigin(span.start, condition_span.start, condition_span.end, None)
                cfg.append(context, model_syntax_function_function.Operation.Assert(value, None, origin))
            case GrammarApply:
                context.origin = cfg.source_origin(context, span)
                if quality.debug_source(module, span):
                    cfg.append(context, model_syntax_function_function.Operation.DebugLocation(span))
                quality.quality_hit(module, context, span, "Statement")
                execute_grammar(module, context, scope, syntax, operands, bodies, span)
            case _:
                return error(diagnostics.Diagnostic("E000230", "semantic analysis admitted an unsupported statement", None))

    return true

def require_function(required: list[model_syntax_symbol_symbol.FunctionId], function: model_syntax_symbol_symbol.FunctionId):
    for previous in required:
        if previous.value == function.value:
            return
    required.append(function)


class CallableDependencyPath:
    function: model_syntax_symbol_symbol.FunctionId
    path: list[model_syntax_block_block.CallableOrigin]


def require_call(module: model_hir_module_module.Module, required: list[model_syntax_symbol_symbol.FunctionId], paths: list[CallableDependencyPath], function: model_syntax_symbol_symbol.FunctionId, origin: model_syntax_block_block.OperationOrigin):
    require_function(required, function)
    for known in paths:
        if known.function.value == function.value:
            return
    for declaration in module.functions:
        if declaration.id.value == function.value:
            path = origin.path[:]
            path.append(model_syntax_block_block.CallableOrigin(declaration.definition, declaration.name, origin.span))
            paths.append(CallableDependencyPath(function, path))
            return


def required_calls(module: model_hir_module_module.Module, body: borrow model_mir_cfg_cfg.CfgBody, required: list[model_syntax_symbol_symbol.FunctionId], paths: list[CallableDependencyPath]):
    for block in borrow body.blocks:
        position := 0
        for operation in borrow block.operations:
            origin = block.origins[position]
            position += 1
            match operation:
                case CallFields:
                    require_call(module, required, paths, function, origin)
                case Call:
                    require_call(module, required, paths, function, origin)
                case _:
                    continue


def build_callables(module: model_hir_module_module.Module, library_sources: list[int] = [], export_names: list[string] = []) -> model_hir_module_module.Module | diagnostics.Diagnostic:
    module.hierarchy.regions = []
    module.hierarchy.sentences = []
    module.hierarchy.blocks = []
    module.cfg_bodies = []
    initializer = model_syntax_symbol_symbol.DefId(0, 0, model_syntax_symbol_symbol.DeclarationId(0))
    model_hir_module_hierarchy.hierarchy_region(module.hierarchy, initializer, module.initializer, origin=module.initializer.span)
    module.hierarchy.blocks[0].kind = model_syntax_block_block.BlockKind.Global
    type_blocks: list[tuple[model_syntax_symbol_symbol.TypeId, model_syntax_symbol_symbol.RegionId]] = []
    for record in module.records:
        region = model_hir_module_hierarchy.hierarchy_region(module.hierarchy, record.definition, model_syntax_block_block.Block([], span=record.span), origin=record.span)
        module.hierarchy.blocks[region.index].kind = model_syntax_block_block.BlockKind.Class
        type_blocks.append((record.type_id, region))
    for trait in module.traits:
        region = model_hir_module_hierarchy.hierarchy_region(module.hierarchy, trait.definition, model_syntax_block_block.Block([], span=trait.span), origin=trait.span)
        module.hierarchy.blocks[region.index].kind = model_syntax_block_block.BlockKind.Trait
    scope = CallableMirScope()
    context := cfg.ExecutionContext(model_mir_cfg_cfg.empty_cfg(model_syntax_primitive_declarations.unit_type_id(), module.initializer), source_block=module.initializer)
    context.origin = model_syntax_block_block.OperationOrigin(module.initializer.span, model_syntax_block_block.SourceBlockId(0), initializer, [model_syntax_block_block.CallableOrigin(initializer, "$initializer", module.initializer.span)])
    context.body.origin = context.origin
    context.body.blocks[context.body.entry].origin = context.origin
    mir_block(module, context, module.initializer, scope)
    cfg.finish(module, context, source.Span(source.SourceId(0), 0, 0))
    ownership.analyze_ownership(module, context.body, [])
    cfg.promote_storage(module, context.body)
    ownership.authorize_lowering(module, context.body, [])
    module.cfg_bodies.append(context.body)
    module.globals = scope.bindings
    functions: list[model_syntax_function_function.FunctionDeclaration] = []
    required: list[model_syntax_symbol_symbol.FunctionId] = []
    paths: list[CallableDependencyPath] = []
    required_calls(module, context.body, required, paths)
    # Runtime entry points are roots even when a generated test has no user
    # source span (for example the summary of a file with no test declarations).
    entry ?= module.entry
    if entry != None:
        require_function(required, entry)
    for test in module.tests:
        function ?= test.function
        if function != None:
            require_function(required, function)
    # All application declarations remain roots, including library exports and
    # unused functions that still need lowering diagnostics. Imported bodies
    # are demand driven. Scan lowered calls so inlined ownership operations,
    # recursive calls and source grammar-generated calls use the same graph.
    for function in borrow module.functions:
        # An external declaration is a dependency of a live call, not a root.
        # Its signature was already checked during semantic analysis.
        if function.name in export_names:
            require_function(required, function.id)
        origin ?= function.span
        if origin != None:
            if int(origin.source.index) not in library_sources:
                require_function(required, function.id)
        else:
            require_function(required, function.id)
    cursor := 0
    while cursor < len(required):
        identity = required[cursor]
        cursor += 1
        selected := -1
        index := 0
        for candidate in borrow module.functions:
            if candidate.id.value == identity.value:
                selected = index
                break
            index += 1
        if selected == -1:
            return error(diagnostics.Diagnostic("E000230", "call graph refers to an unknown function", None))
        function = module.functions[selected]
        if callable_exclusive_signature(function) and boundary.scalar_boundary(function, "mlir") == "":
            if function.body == None:
                return error(diagnostics.Diagnostic("E000230", "owned aggregate boundaries require an ownership ABI", function.span))
            continue
        # Specializations and test mocks copy declarations. Allocate each
        # lowered signature independently instead of appending to a shared list.
        function.values = []
        local = CallableMirScope()
        for parameter in function.parameters:
            local.debug_names.append(parameter.name)
        source_body ?= function.body
        source_block: model_syntax_block_block.SourceBlockId | None := None
        if source_body != None:
            parent: model_syntax_symbol_symbol.RegionId | None := None
            introduced_by: model_syntax_block_block.SentenceId | None := None
            for owner in type_blocks:
                if function.owner_type.index != 0 and owner[0].index == function.owner_type.index:
                    parent = owner[1]
                    sentence = model_syntax_block_block.SentenceId(u32(len(module.hierarchy.sentences)))
                    introduced_by = sentence
                    module.hierarchy.sentences.append(model_hir_module_hierarchy.SemanticSentence(sentence, owner[1], function.span, int(len(module.hierarchy.blocks[owner[1].index].children))))
                    break
            region = model_hir_module_hierarchy.hierarchy_region(module.hierarchy, function.definition, source_body, parent, introduced_by, function.span)
            module.hierarchy.blocks[region.index].kind = model_syntax_block_block.BlockKind.Callable
            if function.name == "main":
                module.hierarchy.blocks[region.index].kind = model_syntax_block_block.BlockKind.Main
            source_block = model_syntax_block_block.SourceBlockId(region.index)
            if function.name.starts_with("__test_") or function.name.starts_with("$case$"):
                module.hierarchy.blocks[region.index].kind = model_syntax_block_block.BlockKind.Test
        context = cfg.ExecutionContext(model_mir_cfg_cfg.empty_cfg(function.result_type, source_body), source_block=source_body)
        path = [model_syntax_block_block.CallableOrigin(function.definition, function.name, function.span)]
        for dependency in paths:
            if dependency.function.value == function.id.value:
                path = dependency.path
                break
        context.origin = model_syntax_block_block.OperationOrigin(function.span, source_block, function.definition, path)
        context.body.origin = context.origin
        context.body.blocks[context.body.entry].origin = context.origin
        for type_id in function.parameter_types:
            if storage_types.owned_record(type_id, module.records):
                cell = aggregate.parameter(module, context, local.aggregates, type_id, context.body.entry)
                local.bindings.append(cell)
                continue
            stored_type = model_syntax_primitive_declarations.pointer_type_id() if storage_types.indirect_value(type_id, module.records) and boundary.scalar_boundary(function, "mlir") == "" else type_id
            parameter_value = mir_value(module, stored_type)
            function.values.append(parameter_value)
            if len(module.debug_files) > 0 and len(function.parameters) >= len(function.values):
                parameter = function.parameters[len(function.values) - 1]
                if quality.debug_source(module, parameter.span):
                    mode := ""
                    for modifier in parameter.modifiers:
                        mode = modifier.name
                    cfg.append(context, model_syntax_function_function.Operation.DebugValue(parameter.name, parameter_value, parameter.span, int(len(function.values)), mode, false, stored_type))
                    cfg.append(context, model_syntax_function_function.Operation.DebugOwnership(parameter.name, mode, parameter.span))
            cell = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
            cfg.append(context, model_syntax_function_function.Operation.Allocate(stored_type, cell))
            cfg.append(context, model_syntax_function_function.Operation.Store(cell, parameter_value))
            local.bindings.append(cell)
            if len(module.debug_files) > 0 and len(function.parameters) >= len(function.values):
                parameter = function.parameters[len(function.values) - 1]
                if quality.debug_source(module, parameter.span):
                    cfg.append(context, model_syntax_function_function.Operation.DebugValue(parameter.name, cell, parameter.span, int(len(function.values)), "", true, stored_type))
        # Aggregate parameters were added as entry block values; interleave
        # leaves with scalar parameters in source parameter order.
        if aggregate.signature(function, module.records):
            function.values = []
            parameter_cursor := 0
            for type_id in function.parameter_types:
                if storage_types.owned_record(type_id, module.records):
                    for value in callable_parameter_fields(context.body, local.aggregates, local.bindings[parameter_cursor]):
                        function.values.append(value)
                else:
                    for operation in context.body.blocks[context.body.entry].operations:
                        match operation:
                            case Store:
                                if address.index == local.bindings[parameter_cursor].index:
                                    function.values.append(value)
                            case _:
                                throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                parameter_cursor += 1
        body ?= function.body
        if body != None:
            declared_span ?= function.span
            if declared_span != None:
                quality.quality_hit(module, context, declared_span, "Function")
            mir_block(module, context, body, local)
            span := source.Span(source.SourceId(0), 0, 0)
            declared ?= function.span
            if declared != None:
                span = declared
            cfg.finish(module, context, span, function.values)
            ownership.analyze_ownership(module, context.body, function.values)
            cfg.promote_storage(module, context.body)
            ownership.authorize_lowering(module, context.body, function.values)
            required_calls(module, context.body, required, paths)
            function.cfg_index = int(len(module.cfg_bodies))
            module.cfg_bodies.append(context.body)
        functions.append(function)
    module.functions = functions
    return module


def callable_mir_place(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, expression: model_syntax_function_function.Expression) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    match expression.kind:
        case Ownership:
            return callable_mir_place(module, context, scope, value)
        case BindingReference:
            if storage_types.owned_record(expression.type_id, module.records):
                return scope.bindings[binding.index]
            if storage_types.indirect_value(expression.type_id, module.records):
                address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
                cfg.append(context, model_syntax_function_function.Operation.Load(scope.bindings[binding.index], address))
                return address
            return scope.bindings[binding.index]
        case FieldReference:
            base = callable_mir_place(module, context, scope, object)
            if storage_types.owned_record(object.type_id, module.records):
                return aggregate.fields(scope.aggregates, base)[index]
            result = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
            cfg.append(context, model_syntax_function_function.Operation.FieldAddress(base, object.type_id, index, result))
            return result
        case _:
            value = mir_expression(module, context, scope, expression)
            if storage_types.owned_record(expression.type_id, module.records):
                return value
            address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
            cfg.append(context, model_syntax_function_function.Operation.Allocate(expression.type_id, address))
            cfg.append(context, model_syntax_function_function.Operation.Store(address, value))
            return address



enum SemanticValue:
    SourceOperand(operand: model_mir_cfg_lazy.LazyOperand)
    RuntimeValue(value: model_syntax_symbol_symbol.ValueId)
    IndexedHandle(receiver: model_syntax_symbol_symbol.ValueId, index: model_syntax_symbol_symbol.ValueId, access: model_syntax_function_function.Expression, storage: model_syntax_function_function.Expression | None)
    PlaceHandle(address: model_syntax_symbol_symbol.ValueId, type_id: model_syntax_symbol_symbol.TypeId)
    BlockHandle(block: int)
    Nothing


class SemanticFrame:
    context: cfg.ExecutionContext
    origin: model_mir_cfg_branch.CfgTerminator
    result_type: model_syntax_symbol_symbol.TypeId = model_syntax_symbol_symbol.TypeId(0)
    names: list[string] = []
    values: list[SemanticValue] = []


def semantic_value(frame: SemanticFrame, name: string, span: source.Span) -> SemanticValue | diagnostics.Diagnostic:
    index := 0
    for candidate in frame.names:
        if candidate == name:
            return frame.values[index]
        index += 1
    return error(diagnostics.Diagnostic("E000231", "unknown compiler context value " + name, span))


def semantic_block(value: SemanticValue, span: source.Span) -> int | diagnostics.Diagnostic:
    match value:
        case BlockHandle:
            return block
        case _:
            return error(diagnostics.Diagnostic("E000231", "CFG operation requires a block handle", span))


def semantic_runtime(value: SemanticValue, span: source.Span) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    match value:
        case RuntimeValue:
            return value
        case _:
            return error(diagnostics.Diagnostic("E000231", "CFG operation requires a lowered runtime value", span))


def semantic_path(expression: model_syntax_function_function.Expression) -> string:
    match expression.kind:
        case Name:
            return name
        case Member:
            return semantic_path(object) + "." + name
        case _:
            return ""


def semantic_eval(module: model_hir_module_module.Module, scope: CallableMirScope, frame: SemanticFrame, expression: model_syntax_function_function.Expression) -> SemanticValue | diagnostics.Diagnostic:
    match expression.kind:
        case Name:
            return semantic_value(frame, name, expression.span)
        case Call:
            name = semantic_path(callee)
            inputs: list[SemanticValue] = []
            for argument in arguments:
                inputs.append(semantic_eval(module, scope, frame, argument.value))
            if name == "place" and len(inputs) == 1:
                match inputs[0]:
                    case SourceOperand:
                        match operand:
                            case ExpressionBody:
                                match expression.kind:
                                    case BindingReference:
                                        if storage_types.owned_record(expression.type_id, module.records) and int(binding.index) in scope.borrowed_records:
                                            return error(diagnostics.Diagnostic("E000230", "owned aggregate parameter rebinding requires a reference ABI", expression.span))
                                    case IndexReference:
                                        receiver = mir_expression(module, frame.context, scope, object)
                                        offset = mir_expression(module, frame.context, scope, index)
                                        return IndexedHandle(receiver, offset, access, storage)
                                    case _:
                                        throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                                address = callable_mir_place(module, frame.context, scope, expression)
                                return PlaceHandle(address, expression.type_id)
                            case _:
                                throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                    case _:
                        throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                return error(diagnostics.Diagnostic("E000231", "place requires a resolved destination", expression.span))
            if name == "load" and len(inputs) == 1:
                match inputs[0]:
                    case IndexedHandle:
                        local = CallableMirScope(scope.bindings, scope.loops, [receiver, index], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations)
                        return RuntimeValue(mir_expression(module, frame.context, local, access))
                    case PlaceHandle:
                        return RuntimeValue(aggregate.load(module, frame.context, address, type_id))
                    case _:
                        return error(diagnostics.Diagnostic("E000231", "load requires a place", expression.span))
            if name == "store" and len(inputs) == 2:
                value = semantic_runtime(inputs[1], expression.span)
                match inputs[0]:
                    case IndexedHandle:
                        implementation ?= storage
                        if implementation != None:
                            local = CallableMirScope(scope.bindings, scope.loops, [receiver, index, value], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations)
                            mir_expression(module, frame.context, local, implementation)
                            return Nothing
                        return error(diagnostics.Diagnostic("E000231", "indexed storage is not writable", expression.span))
                    case PlaceHandle:
                        if module.values[value.index].type_id.index != type_id.index:
                            return error(diagnostics.Diagnostic("E000231", "place store type mismatch", expression.span))
                        aggregate.store(module, frame.context, scope.aggregates, address, value)
                        return Nothing
                    case _:
                        return error(diagnostics.Diagnostic("E000231", "store requires a place", expression.span))
            if name == "apply" and len(inputs) == 3:
                previous = semantic_runtime(inputs[1], expression.span)
                right = semantic_runtime(inputs[2], expression.span)
                match inputs[0]:
                    case SourceOperand:
                        match operand:
                            case ExpressionBody:
                                local = CallableMirScope(scope.bindings, scope.loops, [previous, right], scope.return_target, scope.inline_functions, scope.aggregates, scope.borrowed_records, scope.debug_names, scope.error_targets, scope.error_expectations)
                                return RuntimeValue(mir_expression(module, frame.context, local, expression))
                            case _:
                                throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                    case _:
                        throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                return error(diagnostics.Diagnostic("E000231", "apply requires a resolved update", expression.span))
            if name == "cfg.block" and len(inputs) == 0:
                return BlockHandle(cfg.block(frame.context))
            if name == "cfg.begin_loop" and len(inputs) == 2:
                scope.loops.append((semantic_block(inputs[0], expression.span), semantic_block(inputs[1], expression.span)))
                return Nothing
            if name == "cfg.end_loop" and len(inputs) == 0:
                if len(scope.loops) == 0:
                    return error(diagnostics.Diagnostic("E000231", "compiler context has no active loop", expression.span))
                scope.loops.pop()
                return Nothing
            if name in ["cfg.loop_header", "cfg.loop_exit"] and len(inputs) == 0:
                if len(scope.loops) == 0:
                    return error(diagnostics.Diagnostic("E000231", "compiler context has no active loop", expression.span))
                return BlockHandle(scope.loops[-1][0] if name == "cfg.loop_header" else scope.loops[-1][1])
            if name == "cfg.at" and len(inputs) == 1:
                cfg.at(frame.context, semantic_block(inputs[0], expression.span))
                return Nothing
            if name == "cfg.fallthrough" and len(inputs) == 1:
                cfg.fallthrough(frame.context, semantic_block(inputs[0], expression.span), frame.origin)
                return Nothing
            if name == "cfg.parameter" and len(inputs) == 2:
                target = semantic_block(inputs[0], expression.span)
                exemplar = semantic_runtime(inputs[1], expression.span)
                parameter = aggregate.parameter(module, frame.context, scope.aggregates, module.values[exemplar.index].type_id, target)
                return RuntimeValue(parameter)
            if name == "cfg.goto" and len(inputs) >= 1:
                edge_arguments: list[model_syntax_symbol_symbol.ValueId] = []
                for input in inputs[1:]:
                    for value in aggregate.values(module, frame.context, scope.aggregates, semantic_runtime(input, expression.span)):
                        edge_arguments.append(value)
                cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Jump(model_mir_cfg_branch.CfgEdge(semantic_block(inputs[0], expression.span), edge_arguments)), frame.origin)
                return Nothing
            if name == "cfg.branch" and len(inputs) == 3:
                condition = semantic_runtime(inputs[0], expression.span)
                if module.values[condition.index].type_id.index != model_syntax_primitive_declarations.bool_type_id().index:
                    return error(diagnostics.Diagnostic("E000231", "CFG branch condition requires bool", expression.span))
                taken = model_mir_cfg_branch.CfgEdge(semantic_block(inputs[1], expression.span))
                otherwise = model_mir_cfg_branch.CfgEdge(semantic_block(inputs[2], expression.span))
                cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Conditional(condition, taken, otherwise), frame.origin)
                return Nothing
            if name == "cfg.catch" and len(inputs) == 2:
                scope.error_targets.append(semantic_block(inputs[0], expression.span))
                match inputs[1]:
                    case SourceOperand:
                        match operand:
                            case ExpressionBody:
                                scope.error_expectations.append(expression)
                            case _:
                                return error(diagnostics.Diagnostic("E000231", "expected an error expectation expression", expression.span))
                    case _:
                        return error(diagnostics.Diagnostic("E000231", "expected an error expectation operand", expression.span))
                return Nothing
            if name == "cfg.end_catch" and len(inputs) == 0:
                if len(scope.error_targets) == 0:
                    return error(diagnostics.Diagnostic("E000231", "compiler context has no active error handler", expression.span))
                scope.error_targets.pop()
                scope.error_expectations.pop()
                return Nothing
            if name == "cfg.throw" and len(inputs) == 1:
                raised = semantic_runtime(inputs[0], expression.span)
                if len(scope.error_targets) != 0:
                    mir_check_expected_error(module, frame.context, scope, raised, scope.error_expectations[-1])
                    cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Jump(model_mir_cfg_branch.CfgEdge(scope.error_targets[-1])), frame.origin)
                elif scope.return_target >= 0 and len(frame.context.body.blocks[scope.return_target].parameters) != 0:
                    cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Jump(model_mir_cfg_branch.CfgEdge(scope.return_target, aggregate.values(module, frame.context, scope.aggregates, raised))), frame.origin)
                elif frame.context.body.return_type.index == module.values[raised.index].type_id.index and storage_types.owned_record(frame.context.body.return_type, module.records):
                    cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.FinishFields(aggregate.values(module, frame.context, scope.aggregates, raised)), frame.origin)
                elif storage_types.owned_record(module.values[raised.index].type_id, module.records):
                    # An unhandled outcome has no return boundary. Terminate
                    # here without letting its lowering-only handle escape.
                    failed = mir_value(module, model_syntax_primitive_declarations.bool_type_id())
                    cfg.append(frame.context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.BooleanValue(false), failed))
                    cfg.append(frame.context, model_syntax_function_function.Operation.Assert(failed, None, model_syntax_source.AssertionOrigin(0, 0, 0, None)))
                    # Keep one return form for the ownership pass. The assert
                    # always traps, so this continuation cannot execute.
                    if scope.return_target >= 0:
                        cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Jump(model_mir_cfg_branch.CfgEdge(scope.return_target, [])), frame.origin)
                    elif frame.context.body.return_type.index == model_syntax_primitive_declarations.unit_type_id().index:
                        cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Finish(None), frame.origin)
                    else:
                        return error(diagnostics.Diagnostic("E000230", "CFG error outcome does not match function boundary", expression.span))
                else:
                    cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Raise(raised), frame.origin)
                return Nothing
            if name in ["outcome.success", "outcome.payload"] and len(inputs) == 1:
                input = semantic_runtime(inputs[0], expression.span)
                type_id = module.values[input.index].type_id
                for record in module.records:
                    if record.type_id.index == type_id.index:
                        index := 0
                        for variant in model_syntax_function_function.outcome_variants(record):
                            if variant.index == frame.result_type.index:
                                if name == "outcome.success":
                                    return RuntimeValue(aggregate.test_variant(module, frame.context, scope.aggregates, input, index))
                                if storage_types.owned_record(type_id, module.records):
                                    field = aggregate.fields(scope.aggregates, input)[index + 1]
                                    return RuntimeValue(aggregate.load(module, frame.context, field, variant))
                                address = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
                                cfg.append(frame.context, model_syntax_function_function.Operation.Allocate(type_id, address))
                                cfg.append(frame.context, model_syntax_function_function.Operation.Store(address, input))
                                field = mir_value(module, model_syntax_primitive_declarations.pointer_type_id())
                                cfg.append(frame.context, model_syntax_function_function.Operation.FieldAddress(address, type_id, index + 1, field))
                                result = mir_value(module, variant)
                                cfg.append(frame.context, model_syntax_function_function.Operation.Load(field, result))
                                return RuntimeValue(result)
                            index += 1
                return error(diagnostics.Diagnostic("E000231", "outcome operation requires a declared variant", expression.span))
            if name == "cfg.return" and len(inputs) <= 1:
                returned: model_syntax_symbol_symbol.ValueId | None := None
                inline_arguments: list[model_syntax_symbol_symbol.ValueId] = []
                if len(inputs) == 1:
                    match inputs[0]:
                        case RuntimeValue:
                            returned = value
                            for returned_field in aggregate.values(module, frame.context, scope.aggregates, value):
                                inline_arguments.append(returned_field)
                        case Nothing:
                            throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                        case _:
                            return error(diagnostics.Diagnostic("E000231", "CFG return requires a lowered value", expression.span))
                if scope.return_target >= 0:
                    cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Jump(model_mir_cfg_branch.CfgEdge(scope.return_target, inline_arguments)), frame.origin)
                elif storage_types.owned_record(frame.context.body.return_type, module.records):
                    cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.FinishFields(inline_arguments), frame.origin)
                else:
                    cfg.terminate(frame.context, model_mir_cfg_branch.CfgExit.Finish(returned), frame.origin)
                return Nothing
            if name == "lower" and len(inputs) == 1:
                match inputs[0]:
                    case SourceOperand:
                        match operand:
                            case ExpressionBody:
                                return RuntimeValue(mir_expression(module, frame.context, scope, expression))
                            case StatementBody:
                                if not cfg.open(frame.context):
                                    return error(diagnostics.Diagnostic("E000230", "body lowering after CFG terminator", frame.origin.span))
                                mir_block(module, frame.context, body, CallableMirScope(scope.bindings[:], scope.loops, return_target=scope.return_target, inline_functions=scope.inline_functions, aggregates=scope.aggregates, borrowed_records=scope.borrowed_records, debug_names=scope.debug_names, error_targets=scope.error_targets, error_expectations=scope.error_expectations))
                                return Nothing
                    case Nothing:
                        return Nothing
                    case _:
                        return error(diagnostics.Diagnostic("E000231", "lower requires a source operand", expression.span))
            return error(diagnostics.Diagnostic("E000231", "invalid compiler context call " + name, expression.span))
        case _:
            return error(diagnostics.Diagnostic("E000231", "invalid compiler context expression", expression.span))


def execute_grammar(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, syntax: model_syntax_function_syntax.OperatorSyntax, operands: list[model_syntax_function_function.Expression], bodies: list[model_syntax_block_block.Block], span: source.Span, result_type: model_syntax_symbol_symbol.TypeId = model_syntax_symbol_symbol.TypeId(0)) -> SemanticValue | diagnostics.Diagnostic:
    for definition in module.traits:
        if definition.grammar and definition.definition.module == syntax.definition.module and definition.definition.declaration.value == syntax.definition.declaration.value:
            capable := false
            for property in definition.properties:
                if property.name == "control_flow":
                    supplied ?= property.default
                    if supplied != None:
                        match supplied.kind:
                            case Name:
                                capable = name in ["Branch", "Loop", "Return", "Error", "Mutation"]
                            case Member:
                                capable = name in ["Branch", "Loop", "Return", "Error", "Mutation"]
                            case _:
                                throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
            if not capable:
                return error(diagnostics.Diagnostic("E000231", "compiler context requires a control-flow grammar capability", span))
            for method in definition.methods:
                if method.name == "semantic":
                    program ?= method.body
                    if program != None:
                        frame = SemanticFrame(context, model_mir_cfg_branch.CfgTerminator(model_mir_cfg_branch.CfgExit.Dead, definition.definition, span), result_type)
                        for operand in operands:
                            frame.values.append(SourceOperand(model_mir_cfg_lazy.LazyOperand.ExpressionBody(operand)))
                        for body in bodies:
                            frame.values.append(SourceOperand(model_mir_cfg_lazy.LazyOperand.StatementBody(body)))
                        if len(frame.values) > len(method.parameters):
                            return error(diagnostics.Diagnostic("E000231", "grammar semantic operand count mismatch", span))
                        parameter_index := 0
                        for parameter in method.parameters:
                            required = "Ex" if parameter_index < len(operands) or len(bodies) == 0 else "B"
                            valid := false
                            optional := false
                            annotations := [parameter.annotation]
                            match parameter.annotation.kind:
                                case Union:
                                    annotations = members
                                case _:
                                    throw diagnostics.diagnostic("E000231", "unimplemented (sev_compiler/transforms/mir/src/callable.sev)")
                            for annotation in annotations:
                                name ?= model_syntax_type_annotation.simple_type_name(annotation)
                                if name == required:
                                    valid = true
                                if name == "absent":
                                    optional = true
                            if not valid:
                                return error(diagnostics.Diagnostic("E000231", "compiler semantic parameter requires " + required, parameter.span))
                            if parameter_index >= len(frame.values):
                                if not optional:
                                    return error(diagnostics.Diagnostic("E000231", "grammar semantic operand count mismatch", span))
                                frame.values.append(Nothing)
                            frame.names.append(parameter.name)
                            parameter_index += 1
                        for statement in program.statements:
                            match statement:
                                case BindingStatement:
                                    if binding.name in frame.names:
                                        return error(diagnostics.Diagnostic("E000231", "compiler context binding already exists", binding.span))
                                    value = semantic_eval(module, scope, frame, binding.value)
                                    frame.names.append(binding.name)
                                    frame.values.append(value)
                                case ExpressionStatement:
                                    semantic_eval(module, scope, frame, expression)
                                case Return:
                                    returned ?= value
                                    if returned != None:
                                        return semantic_eval(module, scope, frame, returned)
                                    return Nothing
                                case _:
                                    return error(diagnostics.Diagnostic("E000231", "unsupported semantic context statement", span))
                        return Nothing
            return error(diagnostics.Diagnostic("E000231", "grammar requires a semantic body", span))
    return error(diagnostics.Diagnostic("E000231", "unresolved grammar capability", span))


# A function receives each owned record leaf as an ordinary SSA argument.
def callable_parameter_fields(body: model_mir_cfg_cfg.CfgBody, state: aggregate.AggregateStorage, slot: model_syntax_symbol_symbol.ValueId) -> list[model_syntax_symbol_symbol.ValueId]:
    values: list[model_syntax_symbol_symbol.ValueId] = []
    for place in state.places:
        if place.value.index == slot.index:
            for field in place.fields:
                for value in callable_parameter_fields(body, state, field):
                    values.append(value)
            return values
    for operation in body.blocks[body.entry].operations:
        match operation:
            case Store:
                if address.index == slot.index:
                    values.append(value)
            case _:
                continue
    return values


def callable_aggregate_call(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, function: model_syntax_function_function.FunctionDeclaration, arguments: list[model_syntax_function_function.CallArgument], span: source.Span) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    if boundary.scalar_boundary(function, "mlir") != "" or boundary.scalar_boundary(function, "c") != "":
        return error(diagnostics.Diagnostic("E000230", "owned aggregate boundaries require an ownership ABI", span))
    inputs: list[model_syntax_symbol_symbol.ValueId] = []
    evaluated: list[model_syntax_symbol_symbol.ValueId] = []
    for argument in arguments:
        if storage_types.indirect_value(argument.value.type_id, module.records):
            evaluated.append(callable_mir_place(module, context, scope, argument.value))
        else:
            evaluated.append(mir_expression(module, context, scope, argument.value))
    for parameter in function.parameters:
        index := 0
        for argument in arguments:
            if argument.name == parameter.name:
                for value in aggregate.values(module, context, scope.aggregates, evaluated[index]):
                    inputs.append(value)
            index += 1
    outputs: list[model_syntax_symbol_symbol.ValueId] = []
    for type_id in storage_types.value_fields(function.result_type, module.records):
        outputs.append(mir_value(module, type_id))
    cfg.append(context, model_syntax_function_function.Operation.CallFields(function.id, inputs, outputs))
    if storage_types.owned_record(function.result_type, module.records):
        result = aggregate.allocate(module, context, scope.aggregates, function.result_type)
        aggregate.write_values(module, context, scope.aggregates, result, outputs, [0])
        return result
    if len(outputs) != 0:
        return outputs[0]
    return mir_value(module, function.result_type)


# A literal exposes constant array storage with capacity equal to its length.
# Appending grows through vector -> array -> storage -> memory before writing.
def callable_string_literal(module: model_hir_module_module.Module, context: cfg.ExecutionContext, scope: CallableMirScope, text: string, type_id: model_syntax_symbol_symbol.TypeId) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    leaves = storage_types.value_fields(type_id, module.records)
    buffer = mir_value(module, leaves[0])
    cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.StringValue(text), buffer))
    count = mir_value(module, model_syntax_primitive_declarations.i64_type_id())
    size = len(text.characters()) if storage_types.string_element(type_id, module.records).index == model_syntax_primitive_declarations.char_type_id().index else len(text.bytes())
    cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.IntegerValue(string(size)), count))
    result = aggregate.allocate(module, context, scope.aggregates, type_id)
    aggregate.write_values(module, context, scope.aggregates, result, [buffer, count], [0])
    return result
