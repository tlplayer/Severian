import MirAnalysis from "../model.sev"
import diagnostics
import "../callable.sev" as callable
import "../quality.sev" as quality
import "../verify.sev" as verification


# Both driver entries construct CFG and obtain MIR ownership authorization.
def build(analysis: MirAnalysis, exports: list[string] = []) -> MirAnalysis | diagnostics.Diagnostic:
    callable.build_callables(analysis, exports)
    quality.quality_branches(analysis)
    verification.verify(analysis)
    return analysis
