import MirAnalysis, MirContext, require_registered from "model.sev"
import diagnostics
import "cfg.sev" as cfg
import "../../ownership/ownership/src/plan.sev" as ownership


def verify(analysis: MirAnalysis) -> bool | diagnostics.Diagnostic:
    for realization in analysis.callables:
        if realization.key not in analysis.selected:
            continue
        context = MirContext(analysis, realization)
        require_registered(context)
        declaration = realization.declaration
        body ?= realization.body
        match declaration.call_type:
            case External:
                if body != None:
                    return error(diagnostics.Diagnostic("E000230", "an external callable cannot own an executable CFG", declaration.span))
            case Severian:
                if body == None:
                    return error(diagnostics.Diagnostic("E000230", "callable realization requires an executable CFG", declaration.span))
                if body != None:
                    if body.return_type != declaration.result_type:
                        return error(diagnostics.Diagnostic("E000230", "callable CFG result does not match its resolved signature", declaration.span))
                    cfg.verify(context, body)
                    cfg.verify_availability(body, declaration.values)
                    realization.cfg_revision = realization.revision
                    ownership.authorize_lowering(context, body, declaration.values)
                    realization.require_ready()
    return true
