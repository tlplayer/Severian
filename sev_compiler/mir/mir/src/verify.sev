import * from "../../../hir/module/module.sev" as model_hir_module_module
import diagnostics
import * from "cfg.sev" as cfg


def verify(module: model_hir_module_module.Module) -> bool | diagnostics.Diagnostic:
    if len(module.cfg_bodies) != 0:
        cfg.verify(module, module.cfg_bodies[0])
        cfg.verify_availability(module.cfg_bodies[0], [])
    for function in module.functions:
        if function.cfg_index >= 0:
            body = module.cfg_bodies[function.cfg_index]
            cfg.verify(module, body)
            cfg.verify_availability(body, function.values)
    return true
