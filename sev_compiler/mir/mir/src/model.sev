# HIR hands MIR modules indexing the same submodules and shared block graph.
# CFG, ownership and lowered operations remain on the existing block model.
import Program, Module, Submodule from "../../../hir/hir/src/program.sev"
import BlockGraph, BlockAddress from "../../../hir/hir/src/dependencies.sev"
import Block from "../../../syntax/block/block.sev"
import checked_block from "../../../hir/hir/src/dependencies.sev"
import FunctionDeclaration, RecordDeclaration from "../../../syntax/function/function.sev"
import TraitDeclaration, TestDeclaration from "../../../syntax/function/syntax.sev"
import DefinitionID, FunctionId, TypeBinding, ValueId, same_definition, semantic_key from "../../../syntax/symbol/symbol.sev"
import Value from "../../../syntax/generic/value.sev"
import CfgBody from "../../cfg/cfg.sev"
import QualityRegion from "../../../syntax/source.sev"
import SourceFile, Span from "../../../frontend/source/source.sev"


# A realization refers to a resolved declaration and its canonical source block.
# Value IDs and CFG positions are local to this realization, not to a source
# module. Execution blocks live in body; they never enter the HIR partition.
class CallableRealization:
    key: string
    declaration: FunctionDeclaration
    source: BlockAddress | None
    values: list[Value] = []
    body: CfgBody | None = None
    revision: int = 0
    cfg_revision: int = -1
    ownership_revision: int = -1

    def changed():
        self.revision += 1
        self.cfg_revision = -1
        self.ownership_revision = -1

    def require_ready():
        if self.body == None:
            throw Error("callable realization has no executable body: " + self.key)
        if self.cfg_revision != self.revision:
            throw Error("callable CFG must be verified for its current revision: " + self.key)
        if self.ownership_revision != self.revision:
            throw Error("callable ownership must be verified for its current revision: " + self.key)


class QualityAnalysis:
    files: list[SourceFile] = []
    exclusions: list[Span] = []
    regions: list[QualityRegion] = []


class MirAnalysis:
    program: Program
    # These are resolved declaration references, not another source hierarchy.
    records: list[RecordDeclaration] = []
    traits: list[TraitDeclaration] = []
    callables: list[CallableRealization] = []
    roots: list[FunctionId] = []
    initializers: list[FunctionId] = []
    entry: FunctionId | None = None
    tests: list[TestDeclaration] = []
    selected: list[string] = []
    files: list[SourceFile] = []
    debug_files: list[SourceFile] = []
    quality: QualityAnalysis = QualityAnalysis()


# Passes receive the analysis and the particular realization whose ValueIds
# they consume. A function cannot accidentally index a sibling's value table.
class MirContext:
    analysis: MirAnalysis
    callable: CallableRealization


def realization_key(definition: DefinitionID, arguments: list[TypeBinding]) -> string:
    parameters: list[int] = []
    types: list[int] = []
    for argument in arguments:
        parameter = int(argument.parameter.index)
        if parameter in parameters:
            throw Error("duplicate generic parameter in callable realization")
        position := 0
        while position < len(parameters) and parameters[position] < parameter:
            position += 1
        parameters.insert(position, parameter)
        types.insert(position, int(argument.type_id.index))
    parts = [string(definition.package), string(definition.module), string(definition.declaration.value)]
    for index in range(len(parameters)):
        parts.append(string(parameters[index]))
        parts.append(string(types[index]))
    return semantic_key(parts)


def add_callable(analysis: MirAnalysis, declaration: FunctionDeclaration, source: BlockAddress | None) -> MirContext:
    address ?= source
    if address != None:
        checked_block(analysis.program.graph, address)
        analysis.program.submodule_of(address)
    key = realization_key(declaration.definition, declaration.type_arguments)
    for existing in analysis.callables:
        if existing.key == key:
            throw Error("duplicate callable realization: " + key)
        if existing.declaration.id.value == declaration.id.value:
            throw Error("duplicate executable function identity")
    realization = CallableRealization(key, declaration, source)
    analysis.callables.append(realization)
    return MirContext(analysis, realization)


def callable_context(analysis: MirAnalysis, id: FunctionId) -> MirContext:
    for realization in analysis.callables:
        if realization.declaration.id.value == id.value:
            return MirContext(analysis, realization)
    throw Error("call refers to an unknown executable function: " + string(id.value))


def callable_declarations(analysis: MirAnalysis) -> list[FunctionDeclaration]:
    return [realization.declaration for realization in analysis.callables]


def require_registered(context: MirContext):
    key = realization_key(context.callable.declaration.definition, context.callable.declaration.type_arguments)
    if key != context.callable.key:
        throw Error("callable realization identity changed after registration")
    for registered in context.analysis.callables:
        if registered == context.callable:
            return
    throw Error("callable realization does not belong to this MIR analysis")
