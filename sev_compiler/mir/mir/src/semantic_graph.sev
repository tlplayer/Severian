import "../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../frontend/modules/graph/model.sev" as model_frontend_modules_graph_model
import "../../../hir/module/hierarchy.sev" as model_hir_module_hierarchy
import "../../../hir/module/module.sev" as model_hir_module_module
import "../../cfg/cfg.sev" as model_mir_cfg_cfg
import "../../../syntax/constraint/model.sev" as model_syntax_constraint_model
import "../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import "../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import source
import "../../../frontend/modules/graph/verify.sev" as graph_verify


def callable_definition(module: model_hir_module_module.Module, function: model_syntax_symbol_symbol.FunctionId) -> model_syntax_symbol_symbol.DefId | Error:
    for declaration in borrow module.functions:
        if declaration.id.value == function.value:
            return declaration.definition
    throw Error("call graph refers to an unknown function: " + string(function.value))


def grammar_parent(module: model_hir_module_module.Module, declaration: model_syntax_function_syntax.TraitDeclaration, name: string) -> model_syntax_symbol_symbol.DefId | Error:
    for parent in borrow module.traits:
        if parent.name == declaration.lookup + name:
            return parent.definition
    for parent in borrow module.traits:
        if parent.name == name:
            return parent.definition
    throw Error("semantic graph refers to an unknown base: " + name)


def body_dependencies(graph: model_frontend_modules_graph_model.DefinitionGraph, module: model_hir_module_module.Module, definition: model_syntax_symbol_symbol.DefId, body: model_mir_cfg_cfg.CfgBody) -> unit | Error:
    owner = model_frontend_modules_graph_model.definition_index(graph, definition)
    for block in body.blocks:
        position := 0
        for operation in block.operations:
            origin = block.origins[position]
            position += 1
            match operation:
                case Call:
                    target = model_frontend_modules_graph_model.definition_index(graph, callable_definition(module, function))
                    model_frontend_modules_graph_model.add_dependency(graph, owner, target, model_frontend_modules_graph_model.DependencyKind.Invocation, origin)
                case CallFields:
                    target = model_frontend_modules_graph_model.definition_index(graph, callable_definition(module, function))
                    model_frontend_modules_graph_model.add_dependency(graph, owner, target, model_frontend_modules_graph_model.DependencyKind.Invocation, origin)
                case _:
                    continue


def source_owner(owners: list[model_frontend_modules_graph_model.SourceUnit], span: source.Span | None, fallback: int) -> int | Error:
    origin ?= span
    if origin != None:
        for owner in owners:
            if owner.source.index == origin.source.index:
                return owner.submodule
        throw Error("definition source has no package-owned submodule membership")
    return fallback


def build(module: model_hir_module_module.Module, owners: list[model_frontend_modules_graph_model.SourceUnit], root: int) -> model_frontend_modules_graph_model.DefinitionGraph | Error:
    graph = model_frontend_modules_graph_model.DefinitionGraph()
    module.obligations = []
    for declaration in module.traits:
        kind = model_frontend_modules_graph_model.DefinitionKind.GrammarDefinition if declaration.grammar else model_frontend_modules_graph_model.DefinitionKind.TraitDefinition
        model_frontend_modules_graph_model.add_definition(graph, declaration.definition, kind, declaration.name, declaration.span, alias=true, submodule=source_owner(owners, declaration.span, root))
    executable_ids: list[string] = []
    for declaration in module.functions:
        key := string(declaration.id.value)
        if key in executable_ids:
            throw Error("duplicate executable function identity: " + key)
        executable_ids.append(key)
        unit = source_owner(owners, declaration.span, root)
        node = model_frontend_modules_graph_model.add_definition(graph, declaration.definition, model_frontend_modules_graph_model.DefinitionKind.Callable, declaration.name, declaration.span, alias=true, submodule=unit)
        owner_key := ""
        for owner in owners:
            if owner.submodule == unit:
                owner_key = owner.key
                break
        key = model_syntax_function_function.callable_key(declaration, owner_key)
        if declaration.semantic_key != "":
            key = declaration.semantic_key
        definition_node = graph.nodes[node.index]
        definition_node.semantic_key = key
        graph.nodes[node.index] = definition_node
        body ?= declaration.body
        if body != None:
            layout ?= body.layout
            if layout == None:
                throw Error("callable has no source block layout")
            region = model_syntax_symbol_symbol.RegionId(layout.id.index)
            for attachment in declaration.attachments:
                module.obligations.append(model_syntax_constraint_model.ConstraintObligation(declaration.definition, attachment.role, attachment.condition, region=region))
    initializer = model_syntax_symbol_symbol.DefId(0, 0, model_syntax_symbol_symbol.DeclarationId(0))
    if len(module.cfg_bodies) > 0:
        model_frontend_modules_graph_model.add_definition(graph, initializer, model_frontend_modules_graph_model.DefinitionKind.Callable, "$initializer", None, submodule=root)
    for declaration in module.traits:
        owner = model_frontend_modules_graph_model.definition_index(graph, declaration.definition)
        for base in declaration.bases:
            name ?= model_syntax_type_annotation.simple_type_name(base)
            if name != None:
                target = model_frontend_modules_graph_model.definition_index(graph, grammar_parent(module, declaration, name))
                model_frontend_modules_graph_model.add_dependency(graph, owner, target, model_frontend_modules_graph_model.DependencyKind.Inheritance)
    for declaration in module.functions:
        if declaration.cfg_index >= len(module.cfg_bodies):
            throw Error("callable CFG index is out of bounds")
        if declaration.cfg_index >= 0:
            body_dependencies(graph, module, declaration.definition, module.cfg_bodies[declaration.cfg_index])
    if len(module.cfg_bodies) > 0:
        body_dependencies(graph, module, initializer, module.cfg_bodies[0])
    model_hir_module_hierarchy.verify_hierarchy(module.hierarchy)
    graph_verify.freeze_definitions(graph)
    return graph
