import "../../../hir/module/module.sev" as model_hir_module_module
import "../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../syntax/literal/value.sev" as model_syntax_literal_value
import "../../../syntax/primitive/declarations.sev" as model_syntax_primitive_declarations
import "../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import diagnostics
import "cfg.sev" as cfg
import "../../../syntax/type/storage.sev" as storage


class AggregatePlace:
    value: model_syntax_symbol_symbol.ValueId
    fields: list[model_syntax_symbol_symbol.ValueId]


class AggregateStorage:
    places: list[AggregatePlace] = []


# Owned records are decomposed into ordinary field slots before CFG promotion.
# The aggregate handle exists only during lowering; executable operations and
# edges contain the field values, keeping memref ownership visible to MLIR.
def fields(state: AggregateStorage, value: model_syntax_symbol_symbol.ValueId) -> list[model_syntax_symbol_symbol.ValueId]:
    for place in state.places:
        if place.value.index == value.index:
            return place.fields
    throw Error("missing decomposed aggregate storage")


def allocate(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, type_id: model_syntax_symbol_symbol.TypeId) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    if not storage.owned_record(type_id, module.records):
        address = cfg.value(module, model_syntax_primitive_declarations.pointer_type_id())
        # A join can receive fields from either predecessor. Its slots must
        # dominate both paths even before the general storage promotion pass.
        cfg.append_at(context, context.body.entry, model_syntax_function_function.Operation.Allocate(type_id, address))
        return address
    handle = cfg.value(module, type_id)
    members: list[model_syntax_symbol_symbol.ValueId] = []
    for record in module.records:
        if record.type_id.index == type_id.index:
            # Semantic lifetime checking has already inserted destructor calls.
            # Keep their string/buffer fields visible to MLIR deallocation too.
            for field in record.fields:
                members.append(allocate(module, context, state, field.type_id))
    state.places.append(AggregatePlace(handle, members))
    return handle


def load(module: model_hir_module_module.Module, context: cfg.ExecutionContext, address: model_syntax_symbol_symbol.ValueId, type_id: model_syntax_symbol_symbol.TypeId) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    if storage.owned_record(type_id, module.records):
        return address
    result = cfg.value(module, type_id)
    cfg.append(context, model_syntax_function_function.Operation.Load(address, result))
    return result


def initialize(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, address: model_syntax_symbol_symbol.ValueId, type_id: model_syntax_symbol_symbol.TypeId):
    if not storage.owned_record(type_id, module.records):
        value = cfg.value(module, type_id)
        cfg.append(context, model_syntax_function_function.Operation.Constant(model_syntax_literal_value.NoneValue(), value))
        cfg.append(context, model_syntax_function_function.Operation.Store(address, value))
        return
    members = fields(state, address)
    for record in module.records:
        if record.type_id.index == type_id.index:
            index := 0
            for field in record.fields:
                initialize(module, context, state, members[index], field.type_id)
                index += 1


def test_variant(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, value: model_syntax_symbol_symbol.ValueId, variant: int) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    input := value
    if storage.owned_record(module.values[value.index].type_id, module.records):
        input = load(module, context, fields(state, value)[0], model_syntax_primitive_declarations.i64_type_id())
    result = cfg.value(module, model_syntax_primitive_declarations.bool_type_id())
    cfg.append(context, model_syntax_function_function.Operation.IsVariant(input, variant, result))
    return result


def store(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, address: model_syntax_symbol_symbol.ValueId, value: model_syntax_symbol_symbol.ValueId) -> unit | diagnostics.Diagnostic:
    type_id = module.values[value.index].type_id
    if not storage.owned_record(type_id, module.records):
        cfg.append(context, model_syntax_function_function.Operation.Store(address, value))
        return
    # Snapshot all leaves before writing, including overlapping projections.
    snapshots = values(module, context, state, value)
    write_values(module, context, state, address, snapshots, [0])


def values(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, value: model_syntax_symbol_symbol.ValueId) -> list[model_syntax_symbol_symbol.ValueId] | diagnostics.Diagnostic:
    type_id = module.values[value.index].type_id
    if not storage.owned_record(type_id, module.records):
        return [value]
    result: list[model_syntax_symbol_symbol.ValueId] = []
    members = fields(state, value)
    for record in module.records:
        if record.type_id.index == type_id.index:
            index := 0
            for field in record.fields:
                member = load(module, context, members[index], field.type_id)
                for leaf in values(module, context, state, member):
                    result.append(leaf)
                index += 1
    return result


def write_values(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, address: model_syntax_symbol_symbol.ValueId, values: list[model_syntax_symbol_symbol.ValueId], cursor: list[int]) -> unit | diagnostics.Diagnostic:
    if not storage.owned_record(module.values[address.index].type_id, module.records):
        cfg.append(context, model_syntax_function_function.Operation.Store(address, values[cursor[0]]))
        cursor[0] += 1
        return
    for field in fields(state, address):
        write_values(module, context, state, field, values, cursor)


def parameter(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, type_id: model_syntax_symbol_symbol.TypeId, target: int) -> model_syntax_symbol_symbol.ValueId | diagnostics.Diagnostic:
    if not storage.owned_record(type_id, module.records):
        result = cfg.value(module, type_id)
        context.body.blocks[target].parameters.append(result)
        return result
    result = allocate(module, context, state, type_id)
    parameter_fields(module, context, state, result, type_id, target)
    return result


def parameter_fields(module: model_hir_module_module.Module, context: cfg.ExecutionContext, state: AggregateStorage, address: model_syntax_symbol_symbol.ValueId, type_id: model_syntax_symbol_symbol.TypeId, target: int) -> unit | diagnostics.Diagnostic:
    if not storage.owned_record(type_id, module.records):
        value = cfg.value(module, type_id)
        context.body.blocks[target].parameters.append(value)
        cfg.append_at(context, target, model_syntax_function_function.Operation.Store(address, value))
        return
    members = fields(state, address)
    for record in module.records:
        if record.type_id.index == type_id.index:
            index := 0
            for field in record.fields:
                parameter_fields(module, context, state, members[index], field.type_id, target)
                index += 1


def signature(function: model_syntax_function_function.FunctionDeclaration, records: list[model_syntax_function_function.RecordDeclaration]) -> bool:
    if storage.owned_record(function.result_type, records):
        return true
    for type_id in function.parameter_types:
        if storage.owned_record(type_id, records):
            return true
    return false
