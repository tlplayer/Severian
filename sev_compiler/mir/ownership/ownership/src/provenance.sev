import * from "../../../../hir/module/module.sev" as model_hir_module_module
import * from "../../../cfg/cfg.sev" as model_mir_cfg_cfg
import * from "../../../../syntax/block/block.sev" as model_syntax_block_block
import * from "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import diagnostics


def origin_at(body: model_mir_cfg_cfg.CfgBody, block: model_syntax_block_block.Block, position: int) -> model_syntax_block_block.OperationOrigin:
    if position >= 0 and position < len(block.origins):
        return block.origins[position]
    terminal ?= block.terminator
    if terminal != None:
        origin := block.origin
        if origin.block == None and origin.callable == None:
            origin = body.origin
        return model_syntax_block_block.OperationOrigin(terminal.span, origin.block, origin.callable, origin.path)
    if block.origin.block != None or block.origin.callable != None:
        return block.origin
    return body.origin


def frame(module: model_hir_module_module.Module, origin: model_syntax_block_block.CallableOrigin, label: string = "") -> diagnostics.CallFrame:
    name = origin.name if label == "" else label + ": " + origin.name
    path := module.path
    line := 0
    column := 0
    span ?= origin.span
    if span != None:
        files = module.debug_files[:] + module.quality_files[:]
        input ?= module.source_file
        if input != None:
            files.append(input)
        for file in files:
            if file.id.index == span.source.index and span.start <= len(file.characters):
                path = file.path
                line = 1
                column = 1
                for index in range(int(span.start)):
                    if file.characters[index] == "\n":
                        line += 1
                        column = 1
                    else:
                        column += 1
                break
    return diagnostics.CallFrame(string(origin.definition.package), name, path, line, column)


def memory_diagnostic(module: model_hir_module_module.Module, message: string, origin: model_syntax_block_block.OperationOrigin, related: model_syntax_block_block.OperationOrigin | None = None) -> diagnostics.Diagnostic:
    frames: list[diagnostics.CallFrame] = []
    previous ?= related
    if previous != None:
        for call in previous.path:
            frames.append(frame(module, model_syntax_block_block.CallableOrigin(call.definition, call.name, previous.span), "storage origin"))
    cursor := int(len(origin.path))
    while cursor > 0:
        cursor -= 1
        call = origin.path[cursor]
        frames.append(frame(module, call, "compiler callable path"))
    return diagnostics.Diagnostic("E000303", message, origin.span, frames)


test "block provenance takes precedence over the callable fallback":
    region = model_syntax_block_block.SourceBlockId(27)
    block = model_syntax_block_block.Block(origin=model_syntax_block_block.OperationOrigin(block=region))
    body = model_mir_cfg_cfg.CfgBody(0, [block], model_syntax_symbol_symbol.TypeId(2))
    selected = origin_at(body, block, -1)
    assert(selected.block == region)
