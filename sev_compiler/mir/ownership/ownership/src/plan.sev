import * from "../../../../hir/module/module.sev" as model_hir_module_module
import * from "../../../cfg/cfg.sev" as model_mir_cfg_cfg
import * from "../../../../syntax/block/block.sev" as model_syntax_block_block
import * from "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import diagnostics
import * from "cfg.sev" as cfg
import * from "provenance.sev" as provenance
import * from "initialization.sev" as initialization


class ValueAlias:
    source: model_syntax_symbol_symbol.ValueId
    target: model_syntax_symbol_symbol.ValueId


class StorageOrigin:
    value: model_syntax_symbol_symbol.ValueId
    origin: model_syntax_block_block.OperationOrigin


class OwnershipPlan:
    views: list[model_syntax_symbol_symbol.ValueId] = []
    storage: list[model_syntax_symbol_symbol.ValueId] = []
    aliases: list[ValueAlias] = []
    origins: list[StorageOrigin] = []


# MIR is the executable ownership boundary. Source effects remain attached to
# typed bodies, while availability, initialization and stack escapes are checked
# on the completed graph and repeated after transformations before emission.
def analyze_ownership(module: model_hir_module_module.Module, body: model_mir_cfg_cfg.CfgBody, parameters: list[model_syntax_symbol_symbol.ValueId]) -> OwnershipPlan | diagnostics.Diagnostic:
    try:
        cfg.verify_availability(body, parameters)
    catch failure: diagnostics.Diagnostic:
        origin = model_syntax_block_block.OperationOrigin(failure.span, body.origin.block, body.origin.callable, body.origin.path)
        annotated = provenance.memory_diagnostic(module, failure.message, origin)
        annotated.code = failure.code
        return error(annotated)
    report = OwnershipPlan(views=parameters[:])
    for block in body.blocks:
        if len(block.origins) != len(block.operations):
            return error(provenance.memory_diagnostic(module, "MIR operation lost its source provenance", body.origin))
        position := 0
        for operation in block.operations:
            origin = provenance.origin_at(body, block, position)
            position += 1
            match operation:
                case Allocate:
                    report.storage.append(result)
                    report.origins.append(StorageOrigin(result, origin))
                case Alias:
                    report.aliases.append(ValueAlias(value, result))
                case FieldAddress:
                    report.aliases.append(ValueAlias(object, result))
                case _:
                    continue
        terminal ?= block.terminator
        if terminal != None:
            for edge in cfg.successors(terminal.exit):
                index := 0
                for argument in edge.arguments:
                    report.aliases.append(ValueAlias(argument, body.blocks[edge.target].parameters[index]))
                    index += 1
    initialization.verify(module, body)
    verify_escapes(module, body, report)
    return report


def storage_origin(plan: borrow OwnershipPlan, value: model_syntax_symbol_symbol.ValueId) -> model_syntax_block_block.OperationOrigin | None:
    reachable: list[int] = [int(value.index)]
    cursor := 0
    while cursor < len(reachable):
        current = reachable[cursor]
        cursor += 1
        for storage in borrow plan.origins:
            if int(storage.value.index) == current:
                return storage.origin
        for alias in borrow plan.aliases:
            if int(alias.target.index) == current and int(alias.source.index) not in reachable:
                reachable.append(int(alias.source.index))
    return None


def stack_owner(plan: borrow OwnershipPlan, value: model_syntax_symbol_symbol.ValueId) -> bool:
    return storage_origin(plan, value) != None


def verify_escapes(module: model_hir_module_module.Module, body: borrow model_mir_cfg_cfg.CfgBody, plan: borrow OwnershipPlan) -> unit | diagnostics.Diagnostic:
    reachable = cfg.reachable_blocks(body)
    for block in borrow body.blocks:
        if block.id not in reachable:
            continue
        terminal ?= block.terminator
        if terminal != None:
            returned_values: list[model_syntax_symbol_symbol.ValueId] := []
            match terminal.exit:
                case Finish:
                    returned ?= value
                    if returned != None:
                        returned_values.append(returned)
                case FinishFields:
                    returned_values = values[:]
                case _:
                    continue
            for value in returned_values:
                owner ?= storage_origin(plan, value)
                if owner != None:
                    return error(provenance.memory_diagnostic(module, "returned view outlives its local storage owner", provenance.origin_at(body, block, int(len(block.operations))), owner))


def authorize_lowering(module: borrow model_hir_module_module.Module, body: borrow model_mir_cfg_cfg.CfgBody, parameters: borrow list[model_syntax_symbol_symbol.ValueId]) -> OwnershipPlan | diagnostics.Diagnostic:
    return analyze_ownership(module, body, parameters)
