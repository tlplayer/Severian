import MirAnalysis, MirContext from "../../../mir/src/model.sev"
import authorize_lowering from "plan.sev"
import Diagnostic from "../../../../syntax/primitive/error/diagnostic.sev"

def validate(analysis: MirAnalysis) -> unit | Diagnostic:
    for realization in analysis.callables:
        if realization.key not in analysis.selected:
            continue
        body ?= realization.body
        if body != None:
            authorize_lowering(MirContext(analysis, realization), body, realization.declaration.values)
    return unit

import "cfg.sev" as _dependency_cfg
import "effects.sev" as _dependency_effects
import "loans.sev" as _dependency_loans
import "places.sev" as _dependency_places

