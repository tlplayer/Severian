import environment
import file
import path
import process
import source
import package
import os
import * from "../boundaries/driver/src/directory_tests.sev" as directory_tests
import * from "../boundaries/driver/src/package_command.sev"
import * from "../boundaries/driver/src/package_compiler.sev"
import * from "../boundaries/driver/src/pipeline/source.sev" as compiler
import * from "../boundaries/backend/src/native_mlir.sev" as backend
import * from "../boundaries/driver/src/profiling.sev" as profiling

@c(symbol="exit")
def exit_status(status: i32)


def execute_native_arguments(arguments: list[string]) -> int | Error:
    if len(arguments) > 1 and arguments[1] == "__compile-unit":
        compile_package_unit(arguments)
        return 0
    command := "run"
    input := ""
    output := ""
    emit := ""
    binary := ""
    platform := ""
    profile := ""
    alias := ""
    locked := false
    library := false
    development := false
    sysroot := environment.get("SEVERIAN_SYSROOT", "..")
    application: list[string] := []
    cursor := 1
    if len(arguments) > 1:
        if arguments[1] in ["build", "run", "test", "check", "new", "add", "remove", "update", "resolve", "tree", "metadata", "publish", "install", "clean"]:
            command = arguments[1]
            cursor += 1
    while cursor < len(arguments):
        argument = arguments[cursor]
        if argument == "--version":
            print("sev 0.1.0 (Severian source compiler)")
            return 0
        if argument == "--help" or argument == "-h":
            print("usage: sev_compiler COMMAND [PACKAGE|FILE.sev] [--bin NAME] [--build-profile PROFILE] [--target PLATFORM] [--locked] [--emit mlir|agent-ir|plan] [-o OUTPUT] [--sysroot ROOT] [-- ARGS]\ncommands: new check build test run add remove update resolve tree metadata publish install clean\nprofiling: --profile [cpu|memory|time] --profile-output DIR")
            return 0
        if argument == "--":
            application = arguments[cursor + 1:]
            break
        if argument == "--locked":
            locked = true
        elif argument == "--lib":
            library = true
        elif argument == "--dev":
            development = true
        elif argument == "--dry-run":
            emit = "plan"
        elif argument in ["--emit", "--sysroot", "-o", "--output", "--bin", "--filter", "--target", "--build-profile", "--alias"]:
            cursor += 1
            if cursor >= len(arguments):
                throw Error(argument + " requires a value")
            if argument == "--emit":
                emit = arguments[cursor]
            elif argument == "--sysroot":
                sysroot = arguments[cursor]
            elif argument == "--bin" or argument == "--filter":
                binary = arguments[cursor]
            elif argument == "--target":
                platform = arguments[cursor]
            elif argument == "--build-profile":
                profile = arguments[cursor]
            elif argument == "--alias":
                alias = arguments[cursor]
            else:
                output = arguments[cursor]
        elif argument.starts_with("-"):
            throw Error("unknown option " + argument)
        elif input == "":
            input = argument
        else:
            throw Error("unexpected argument " + argument)
        cursor += 1
    if emit != "" and emit != "mlir" and emit != "agent-ir" and emit != "plan":
        throw Error("unsupported emission stage " + emit)
    if len(application) > 0 and command != "run":
        throw Error("application arguments require run")
    location = input if input != "" else "."
    if command == "test" and os.is_dir(location) and not os.is_file(location + "/package.toml"):
        return directory_tests.run(location, sysroot, output, profile, platform, binary, emit)
    if not input.ends_with(".sev"):
        status = package_command(command, input, sysroot, binary, platform, profile, emit, output, application, locked, library, alias, development)
        if status != 0:
            return status
        return 0
    files: list[source.SourceFile] = []
    resolution = package.Resolution([], [], "")
    mlir = compiler.compile_to_mlir(compiler.load_input(input), command == "test" or command == "check", sysroot, emit, resolution, files)
    if emit != "":
        if output == "":
            print(mlir)
        else:
            if file.write(output, mlir) != 0:
                throw Error("could not write MLIR output")
        return 0
    if command == "check":
        return 0
    if output == "":
        name = path.basename(input).replace(".sev", "")
        if command == "build":
            output = "package.pkg/bin/" + name
        elif command == "test":
            output = package.temporary("package.pkg/debug/tests", "run-") + "/bin/" + name
        else:
            output = package.temporary("package.pkg/cache/run", "run-") + "/bin/" + name
    sources: list[string] = []
    for file in files:
        sources.append(file.path)
    backend.emit_native(mlir, output, native_arguments=package.native_arguments(resolution, sources))
    if command == "build":
        print("built " + output)
    else:
        status = backend.execute_native(output, application)
        if status != 0:
            return status

    return 0


def main():
    status := 0
    try:
        invocation = profiling.parse(process.arguments())
        started = profiling.begin(invocation)
        if invocation.mode == "cpu" or invocation.mode == "memory":
            status = profiling.capture(invocation, started)
        else:
            try:
                status = execute_native_arguments(invocation.arguments)
            catch failure: Error:
                process.write_error(failure.message + "\n")
                status = 1
            profiling.finish(invocation, started, status)
    catch failure: Error:
        process.write_error(failure.message + "\n")
        status = 1
    if status != 0:
        exit_status(i32(status))
