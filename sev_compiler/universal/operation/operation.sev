import * from "../id/compiler.sev"
import * from "../literal/value.sev"
import * from "../operator/kind.sev"
import * from "../source/assertion_origin.sev"
import * from "../statement/statement.sev"


enum Operation:
    TypeLayout(subject: TypeId, alignment: bool, result: ValueId)
    Coverage(point: CoveragePoint)
    # Accepts a tagged aggregate or its decomposed integer tag.
    IsVariant(value: ValueId, variant: int, result: ValueId)
    Constant(value: LiteralValue, result: ValueId)
    Unary(operator: OperatorSyntax, operand: ValueId, result: ValueId)
    Binary(operator: OperatorSyntax, left: ValueId, right: ValueId, result: ValueId)
    Call(function: FunctionId, arguments: list[ValueId], result: ValueId)
    CallFields(function: FunctionId, arguments: list[ValueId], outputs: list[ValueId])
    Assert(condition: ValueId, message: ValueId | None, origin: AssertionOrigin)
    Allocate(type_id: TypeId, result: ValueId)
    Alias(value: ValueId, result: ValueId)
    Load(address: ValueId, result: ValueId)
    Store(address: ValueId, value: ValueId)
    FieldAddress(object: ValueId, owner: TypeId, index: int, result: ValueId)
    CompiledRegionCall(artifact_id: ArtifactId, inputs: list[ValueId], outputs: list[ValueId])
