import "primitive.sev"
import "../operator/trait/logical.sev"
import "../operator/trait/equitable.sev"
import "../operator/trait/bitwise.sev"

trait Boolean: Primitive + Logical + Equatable + Bitwise


# The compiler-side model selected when a source value has type `bool`.
# Target lowering is responsible for representing Bool as MLIR `i1`.
class Bool: Boolean
    name: string = "bool"
