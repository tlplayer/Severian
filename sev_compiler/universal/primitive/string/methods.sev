import * from "core.sev" as text
import * from "format.sev" as format
import * from "../slicing.sev" as slicing


@mlir("memref.extract_aligned_pointer_as_index")
def __float_end_address(value: buffer[int]) -> index

@mlir("llvm.ptrtoint")
def __float_pointer_value(value: native_ptr) -> int

def __parse_float_buffer(value: string, end: borrow buffer[int]) -> float:
    return format.__parse(format.__address(value), format.__pointer(text.__size(__float_end_address(end))))

operator float(value: string) -> float:
    buffer = format.__terminated(value)
    end = [0]
    result = __parse_float_buffer(buffer, end)
    consumed := end[0] - __float_pointer_value(format.__address(buffer))
    assert(consumed > 0, "invalid floating-point string")
    while consumed < text.byte_count(value):
        assert(__space(text.byte_at(value, consumed)), "invalid floating-point string")
        consumed += 1
    return result

operator f64(value: string) -> f64:
    return float(value)


def __contains_bytes(value: string, needle: string) -> bool:
    offset := 0
    while offset + text.byte_count(needle) <= text.byte_count(value):
        index := 0
        while index < text.byte_count(needle):
            if text.byte_at(value, offset + index) != text.byte_at(needle, index):
                break
            index += 1
        if index == text.byte_count(needle):
            return true
        offset += 1
    return false


# ASCII case conversion preserves all other UTF-8 bytes. Full Unicode case
# mapping (including expanding mappings) requires the Unicode data library.
def __upper_ascii(value: string) -> string:
    result = text.__allocate(text.__index(text.byte_count(value)))
    position := 0
    while position < text.byte_count(value):
        byte := text.byte_at(value, position)
        if byte >= 97 and byte <= 122:
            byte -= 32
        text.__store(u8(byte), result, text.__index(position))
        position += 1
    return result


operator in(needle: string, value: string) -> bool:
    return __contains_bytes(value, needle)


operator slice_at(value: string, start: int, stop: int, step: int, has_start: bool, has_stop: bool) -> string:
    assert(step != 0)
    size = text.length(value)
    reverse = step < 0
    position := slicing.bound(start, size, reverse) if has_start else (size - 1 if reverse else 0)
    end = slicing.bound(stop, size, reverse) if has_stop else (-1 if reverse else size)
    result := ""
    while (position > end if reverse else position < end):
        result.append(text.character_at(value, position))
        position = slicing.next_position(position, end, step)
    return result


extend string:
    def contains(needle: string) -> bool:
        return __contains_bytes(self, needle)

    def upper() -> string:
        return __upper_ascii(self)

    def replace(needle: string, replacement: string) -> string:
        size = text.byte_count(self)
        width = text.byte_count(needle)
        extra = text.byte_count(replacement)
        matches := 0
        position := 0
        while position <= size:
            if width == 0 or __matches(self, needle, position):
                assert(matches < 9223372036854775807)
                matches += 1
                if width != 0:
                    position += width
                    continue
            if position == size:
                break
            position = text.__offset(self, 1, position) if width == 0 else position + 1
        remaining = size - matches * width
        if extra != 0:
            assert(matches <= (9223372036854775807 - remaining) / extra)
        result = text.__allocate(text.__index(remaining + matches * extra))
        position = 0
        output := 0
        while position <= size:
            if width == 0 or __matches(self, needle, position):
                offset := 0
                while offset < extra:
                    text.__store(text.__load(replacement, text.__index(offset)), result, text.__index(output))
                    output += 1
                    offset += 1
                if width != 0:
                    position += width
                    continue
            if position == size:
                break
            count = text.__offset(self, 1, position) - position if width == 0 else 1
            offset := 0
            while offset < count:
                text.__store(text.__load(self, text.__index(position)), result, text.__index(output))
                position += 1
                output += 1
                offset += 1
        return result


def __matches(value: string, needle: string, position: int) -> bool:
    count = text.byte_count(needle)
    if position > text.byte_count(value) - count:
        return false
    offset := 0
    while offset < count:
        if text.byte_at(value, position + offset) != text.byte_at(needle, offset):
            return false
        offset += 1
    return true


def __space(value: int) -> bool:
    return value == 32 or (value >= 9 and value <= 13)


operator int(value: string) -> int:
    first := 0
    last := text.byte_count(value)
    while first < last and __space(text.byte_at(value, first)):
        first += 1
    while last > first and __space(text.byte_at(value, last - 1)):
        last -= 1
    assert(first < last)
    sign = text.byte_at(value, first)
    negative = sign == 45
    if sign == 43 or negative:
        first += 1
    assert(first < last)
    limit = -9223372036854775808 if negative else -9223372036854775807
    result := 0
    position := first
    while position < last:
        digit = text.byte_at(value, position) - 48
        assert(digit >= 0 and digit <= 9)
        assert(result >= limit / 10)
        result *= 10
        assert(result >= limit + digit)
        result -= digit
        position += 1
    return result if negative else -result


def __test_formatted(value: string) -> string:
    return f"Hello, {value}!"


def __test_interpolation_identity(value: string) -> string:
    return f"{value}"


def __test_text(calls: borrow int) -> string:
    calls += 1
    return "λ" + "😀"


def __test_number(calls: borrow int) -> int:
    calls += 10
    return 42


test "interpolation reads strings without consuming them":
    name = "Sev" + "erian"
    assert(f"{name}:{type(name)}" == "Severian:string")
    greeting = __test_formatted(name)
    assert(name[:5] == "Sever")
    drop(name)
    assert(greeting == "Hello, Severian!")
    empty = ""
    assert(f"{empty}" == "")
    assert(empty == "")


test "interpolation evaluates once and preserves returned values":
    original = "Sev" + "erian"
    result = __test_interpolation_identity(original)
    assert(original == "Severian")
    drop(original)
    assert(result == "Severian")
    calls := 0
    assert(f"{__test_text(borrow calls)}:{__test_number(borrow calls)}" == "λ😀:42")
    assert(calls == 11)


test "string and character concatenation":
    count = 10
    ratio = 0.5
    character = '!'
    assert(string(count + ratio) + character == "10.5!")
    assert("hello" + 'λ' == "helloλ")
    result: string = "hello" + '😀'
    assert(result == "hello😀")
    appended := "hello"
    appended += '!'
    assert(appended == "hello!")


def __test_recursive_length(value: string, remaining: int) -> int:
    if remaining == 0:
        return value.length()
    return __test_recursive_reader(value, remaining - 1)


def __test_recursive_reader(value: string, remaining: int) -> int:
    return __test_recursive_length(value, remaining)


test "recursive readers preserve a shared view":
    value = "Severian"
    saved = view value
    assert(__test_recursive_length(saved, 8) == 8)
    assert(saved == "Severian")
    drop(saved)
    value.append('!')
    assert(value == "Severian!")


def __test_consume(value: move string) -> int:
    return value.length()


def __test_format_consumed(value: move string) -> string:
    return f"{__test_consume(move value)}"


test with compiler "interpolation preserves explicit moves":
    name = "Severian"
    __test_format_consumed(name)
    reject:
        print(name)


test "append chains string and character suffixes":
    assert("Apple".append("s").append('!') == "Apples!")
    value := ""
    value.append('a')
    value.append('λ')
    value.append('中')
    value.append('😀')
    assert(value == "aλ中😀")
    assert(value.length() == 4)
    value.append("")
    value.append(" tail")
    assert(value == "aλ中😀 tail")
    assert("".append("") == "")


test "append handles self append and independent copies":
    value := "a"
    value.append('b')
    before = clone value
    suffix = copy value
    value.append(suffix)
    assert(value == "abab")
    assert(before == "ab")
    before.append('!')
    assert(before == "ab!")
    assert(value == "abab")
    saved = clone value
    for index in range(100):
        value.append('x')
    assert(saved == "abab")
    assert(value.length() == 104)
    drop(value)
    assert(saved == "abab")
    assert(before == "ab!")


test "4096 character appends reuse vector capacity":
    value := ""
    previous := 0
    allocations := 0
    allocated_units := 0
    for index in range(4096):
        value.append('x')
        current = __raw_index(__raw_buffer_address(value.storage.data))
        if current != previous:
            allocations += 1
            allocated_units += value.capacity()
            previous = current
    assert(value.length() == 4096)
    assert(value.capacity() == 4096)
    assert(allocations <= 5)
    assert(allocated_units <= 7936)


test "string encoding and initial capacity are parameters":
    empty = string()
    assert(empty.length() == 0)
    assert(empty.capacity() == 256)
    small: string[u8, 2] = ""
    small.append('a')
    small.append('b')
    small.append('c')
    assert(small.capacity() == 4)
    assert(string(small) == "abc")
    wide: string[u32, 2] = ""
    wide.append('λ')
    wide.append('😀')
    wide.append('!')
    assert(wide.length() == 3)
    assert(wide.capacity() == 4)
    assert(wide.storage.used == 3)
    assert(string(wide) == "λ😀!")
    literal: string[u32, 1] = "λ😀"
    literal.append('!')
    assert(string(literal) == "λ😀!")


test with compiler "append respects a shared view":
    value := "hello"
    saved = view value
    reject:
        value.append('!')
        print(saved)


test with compiler "string encoding must be u8 or u32":
    reject:
        value: string[u16] = "invalid"


def __test_mutate(value: borrow string):
    value.append('!')


def __test_independent(value: copy string) -> string:
    value.append('!')
    return value


test "parameter contracts preserve owners and make copies independent":
    value = "hello"
    duplicate = __test_independent(value)
    assert(value == "hello")
    assert(duplicate == "hello!")
    __test_mutate(value)
    assert(value == "hello!")


test "chained append keeps the original receiver":
    value = "a"
    value.append("b").append('c')
    assert(value == "abc")
    alias = value.append('d')
    alias.append('e')
    drop(alias)
    assert(value == "abcde")


test with compiler "default views cannot mutate consume or escape":
    reject:
        def mutate(value: string):
            value.append('!')
    reject:
        def consume(value: string):
            drop(value)
    reject:
        def consume(value: string):
            other = move value
    reject:
        def escape(value: string) -> string:
            return value
    reject:
        def mutate_alias(value: string):
            alias = value
            alias.append('!')


test with compiler "a saved append result keeps its exclusive loan":
    value = "a"
    alias = value.append('b')
    reject:
        value.append('c')
    accept:
        alias.append('c')
        drop(alias)
        value.append('d')
