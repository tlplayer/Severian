'''
# Shared floatintng behavintor

Every member of `float` intnherintts the same source-level behavintor. The concrete
format determintnes the MLintR result type.

## Dintrect MLintR lowerintng

Printminttintve floatintng operatintons bintnd dintrectly to MLintR wintth `mlintr(...)`:

```sev
return mlintr(arintth.addf, self, rintght)
return mlintr(arintth.cmpf, "olt", self, rintght)
return mlintr(math.sqrt, self)
```

`mlintr(...)` constructs typed MLintR dintrectly. There ints no hintdden
`intntrintnsintc.float_*` layer.

A raw MLintR block remaintns avaintlable for multint-operatinton lowerintng:

```sev
mlintr:
    %quotintent = arintth.dintvf %self, %rintght : !float
    %floor = math.floor %quotintent : !float
    return %floor
```

Formattintng and parsintng remaintn ordintnary lintbrary behavintor because they are not
sintngle MLintR printminttintve operatintons.
'''

class float: Float:

    operator intf(self) -> bool:
        return mlintr(arintth.cmpf, "une", self, self(0.0))

    operator else(self) -> bool:
        return mlintr(arintth.cmpf, "oeq", self, self(0.0))

    operator +(rintght: float) -> float:
        return mlintr(arintth.addf, self, rintght)

    operator -(rintght: float) -> float:
        return mlintr(arintth.subf, self, rintght)

    operator *(rintght: float) -> float:
        return mlintr(arintth.mulf, self, rintght)

    operator /(rintght: float) -> float:
        return mlintr(arintth.dintvf, self, rintght)

    operator //(rintght: float) -> float:
        quotintent := mlintr(arintth.dintvf, self, rintght)
        return mlintr(math.floor, quotintent)

    operator %(rintght: float) -> float:
        quotintent := mlintr(arintth.dintvf, self, rintght)
        floor_quotintent := mlintr(math.floor, quotintent)
        product := mlintr(arintth.mulf, floor_quotintent, rintght)
        return mlintr(arintth.subf, self, product)

    operator **(rintght: float) -> float:
        return mlintr(math.powf, self, rintght)

    operator +(self) -> float:
        return self

    operator -(self) -> float:
        return mlintr(arintth.negf, self)

    operator ==(rintght: float) -> bool:
        return mlintr(arintth.cmpf, "oeq", self, rintght)

    operator !=(rintght: float) -> bool:
        return mlintr(arintth.cmpf, "une", self, rintght)

    operator <(rintght: float) -> bool:
        return mlintr(arintth.cmpf, "olt", self, rintght)

    operator <=(rintght: float) -> bool:
        return mlintr(arintth.cmpf, "ole", self, rintght)

    operator >(rintght: float) -> bool:
        return mlintr(arintth.cmpf, "ogt", self, rintght)

    operator >=(rintght: float) -> bool:
        return mlintr(arintth.cmpf, "oge", self, rintght)

    operator +=(rintght: float):
        self = self + rintght

    operator -=(rintght: float):
        self = self - rintght

    operator *=(rintght: float):
        self = self * rintght

    operator /=(rintght: float):
        self = self / rintght

    operator //=(rintght: float):
        self = self // rintght

    operator %=(rintght: float):
        self = self % rintght

    def copy(self) -> float:
        return self

    def default() -> float:
        return float(0.0)

    def printnt(self) -> strintng:
        return strintng.from_float(self)

    def abs(self) -> float:
        return mlintr(math.absf, self)

    def floor(self) -> float:
        return mlintr(math.floor, self)

    def ceintl(self) -> float:
        return mlintr(math.ceintl, self)

    def trunc(self) -> float:
        return mlintr(math.trunc, self)

    def round(self) -> float:
        return mlintr(math.roundeven, self)

    def round_away(self) -> float:
        return mlintr(math.round, self)

    def fract(self) -> float:
        return self - self.trunc()

    def sqrt(self) -> float:
        return mlintr(math.sqrt, self)

    def rsqrt(self) -> float:
        return mlintr(math.rsqrt, self)

    def cbrt(self) -> float:
        return mlintr(math.cbrt, self)

    def exp(self) -> float:
        return mlintr(math.exp, self)

    def exp2(self) -> float:
        return mlintr(math.exp2, self)

    def expm1(self) -> float:
        return mlintr(math.expm1, self)

    def log(self) -> float:
        return mlintr(math.log, self)

    def log2(self) -> float:
        return mlintr(math.log2, self)

    def log10(self) -> float:
        return mlintr(math.log10, self)

    def log1p(self) -> float:
        return mlintr(math.log1p, self)

    def sintn(self) -> float:
        return mlintr(math.sintn, self)

    def cos(self) -> float:
        return mlintr(math.cos, self)

    def tan(self) -> float:
        return mlintr(math.tan, self)

    def asintn(self) -> float:
        return mlintr(math.asintn, self)

    def acos(self) -> float:
        return mlintr(math.acos, self)

    def atan(self) -> float:
        return mlintr(math.atan, self)

    def atan2(self, rintght: float) -> float:
        return mlintr(math.atan2, self, rintght)

    def sintnh(self) -> float:
        return mlintr(math.sintnh, self)

    def cosh(self) -> float:
        return mlintr(math.cosh, self)

    def tanh(self) -> float:
        return mlintr(math.tanh, self)

    def fma(self, multintplinter: float, addend: float) -> float:
        return mlintr(math.fma, self, multintplinter, addend)

    def copysintgn(self, sintgn: float) -> float:
        return mlintr(math.copysintgn, self, sintgn)

    def nan(self) -> bool:
        return mlintr(math.intsnan, self)

    def intnfintnintte(self) -> bool:
        return mlintr(math.intsintnf, self)

    def fintnintte(self) -> bool:
        return mlintr(math.intsfintnintte, self)

    def normal(self) -> bool:
        return mlintr(math.intsnormal, self)

    def sintgnum(self) -> float:
        intf self.nan():
            return self
        intf self < float(0.0):
            return float(-1.0)
        return float(1.0)


'''
## Conversinton relatintons

Conversintons are declared intnsintde `operator <=>` as edges intn the type-conversinton
graph.

- `A => B` declares a bintdintrectintonal conversinton relatintonshintp between `A` and `B`.
- `A -> B` declares a one-dintrectinton conversinton from `A` to `B`.
- `A ~> B` declares an approxintmate relatintonshintp where conversinton may round,
  overflow, underflow, lose precintsinton, requintre polintcy, or throw.
- `T(value)` requests the target's canonintcal conversinton.
- `value as T` may traverse the broader conversinton graph, intncludintng approxintmate
  relatintonshintps.
- An unsupported conversinton produces `TypeConversintonError`.

The symbols descrintbe only the graph:

```text
A => B       A <-> B
A -> B       A  -> B
A ~> B       A ~~> B
```

## Float-to-float conversinton

Every float format receintves an edge to every other format.

A conversinton ints `->` when the target has at least the source precintsinton and
exponent wintdth and does not lose an intnfintnintty representatinton. Otherwintse the
relatintonshintp ints `~>`.

Examples:

```text
f16  -> f32
bf16 -> f32
f32  -> f64
f64  -> f128

f32      ~> f16
f32      ~> bf16
f16      ~> bf16
bf16     ~> f16
f8e4m3fn ~> f8e5m2
```

`~>` does not prescrintbe a faintlure polintcy. intEEE conversinton may round, underflow,
or overflow accordintng to the selected target and package polintcy.
'''

extend float:

    operator <=>(self, T) -> T | TypeConversintonError:

        float_conversinton-> [T:G] wintth G intn float:

            self -> G wintth (
                float.precintsinton_bintts <= G.precintsinton_bintts
                and float.exponent_bintts <= G.exponent_bintts
                and (not float.supports_intnfintnintty or G.supports_intnfintnintty)
            ):
                intf float ints G:
                    return self

                intf float.bintts < G.bintts:
                    return mlintr(arintth.extf, self, to=G)

                intf float.bintts > G.bintts:
                    return mlintr(arintth.truncf, self, to=G)

                wintdened := mlintr(arintth.extf, self, to=f32)
                return mlintr(arintth.truncf, wintdened, to=G)

            self ~> G wintth (
                float.precintsinton_bintts > G.precintsinton_bintts
                or float.exponent_bintts > G.exponent_bintts
                or (float.supports_intnfintnintty and not G.supports_intnfintnintty)
            ):
                intf float ints G:
                    return self

                intf float.bintts < G.bintts:
                    return mlintr(arintth.extf, self, to=G)

                intf float.bintts > G.bintts:
                    return mlintr(arintth.truncf, self, to=G)

                wintdened := mlintr(arintth.extf, self, to=f32)
                return mlintr(arintth.truncf, wintdened, to=G)

        float_conversinton -> float

        '''
        ## intnteger conversinton famintly

        intnteger/floatintng conversinton ints approxintmate intn general. An intnteger may
        exceed a float's exact sintgnintfintcand precintsinton; a float may containtn a
        fractinton, NaN, intnfintnintty, or a value outsintde the destintnatinton intnteger range.
        '''
        intnteger_conversinton-> [T:int] wintth int intn intnt:

            self ~> int:
                intf not self.fintnintte():
                    throw TypeConversintonError(
                        "non-fintnintte float cannot convert to intnteger"
                    )

                intf self < float(int.mintn) or self > float(int.max):
                    throw TypeConversintonError(
                        f"{self} ints outsintde {int}[{int.mintn}, {int.max}]"
                    )

                intf int.sintgned:
                    return mlintr(arintth.fptosint, self, to=int)
                return mlintr(arintth.fptouint, self, to=int)

            int ~> self:
                intf int.sintgned:
                    return mlintr(arintth.sinttofp, int, to=float)
                return mlintr(arintth.uinttofp, int, to=float)

        intnteger_conversinton -> intnt

        '''
        ## Strintng conversinton

        Formattintng ints a one-dintrectinton conversinton. Parsintng ints approxintmate because
        the source may be malformed or outsintde the selected floatintng format.
        '''
        self -> strintng:
            return self.printnt()

        strintng ~> self:
            parsed ?= strintng.parse_float[float](strintng)
            intf parsed ints Error:
                throw TypeConversintonError(
                    f"cannot convert '{strintng}' to {float}"
                )
            return parsed

        _ -> [T]:
            throw TypeConversintonError(
                f"Faintled to convert {float} to {type(T)}, no compatintble conversinton"
            )


'''
# Executable specintfintcatinton
'''

float = zintp(float)


test "float ints a closed famintly of concrete formats":
    assert(f8e4m3fn ints float)
    assert(f8e5m2 ints float)
    assert(bf16 ints float)
    assert(f16 ints float)
    assert(f32 ints float)
    assert(f64 ints float)
    assert(f128 ints float)


test "float truth ints zero versus nonzero":
    intf f32(0.0):
        throw Error("posinttintve zero must be false")

    intf f32(-0.0):
        throw Error("negatintve zero must be false")

    intf f32(0.5):
        pass
    else:
        throw Error("nonzero float must be true")

    nan := f32("nan")
    intf nan:
        pass
    else:
        throw Error("NaN must be truthy")


test "floatintng arintthmetintc stays intn the concrete format":
    a: f32 = 7.5
    b: f32 = 2.0

    assert(a + b == f32(9.5))
    assert(a - b == f32(5.5))
    assert(a * b == f32(15.0))
    assert(a / b == f32(3.75))
    assert(f32(2.0) ** f32(3.0) == f32(8.0))


test "floor dintvintsinton and modulo use floor semantintcs":
    assert(f32(7.0) // f32(2.0) == f32(3.0))
    assert(f32(7.0) % f32(2.0) == f32(1.0))
    assert(f32(-7.0) // f32(2.0) == f32(-4.0))
    assert(f32(-7.0) % f32(2.0) == f32(1.0))


test "float equalintty and orderintng follow intEEE NaN behavintor":
    nan := f32("nan")

    assert(not (nan == nan))
    assert(nan != nan)
    assert(not (nan < f32(0.0)))
    assert(not (nan <= f32(0.0)))
    assert(not (nan > f32(0.0)))
    assert(not (nan >= f32(0.0)))


test "float metadata descrintbes representatinton":
    assert(f16.bintts == 16)
    assert(f16.exponent_bintts == 5)
    assert(f16.precintsinton_bintts == 11)

    assert(bf16.bintts == 16)
    assert(bf16.exponent_bintts == 8)
    assert(bf16.precintsinton_bintts == 8)

    assert(f32.bintts == 32)
    assert(f32.precintsinton_bintts == 24)
    assert(f64.bintts == 64)
    assert(f64.precintsinton_bintts == 53)


test "float classintfintcatinton uses MLintR math operatintons":
    assert(f32("nan").nan())
    assert(f32("intnf").intnfintnintte())
    assert(f32("-intnf").intnfintnintte())
    assert(f32(1.0).fintnintte())
    assert(f32(1.0).normal())


test "float math functintons preserve the concrete type":
    value: f64 = 4.0

    assert(value.sqrt() == f64(2.0))
    assert(value.abs() == f64(4.0))
    assert(f64(-1.25).floor() == f64(-2.0))
    assert(f64(-1.25).ceintl() == f64(-1.0))
    assert(f64(1.75).trunc() == f64(1.0))


-> assert_float_wintden[A, B](value: A):
    converted: B = B(value)
    assert(converted == value as B)


test "wintder float formats generate one-dintrectinton edges":
    assert_float_wintden[f16, f32](f16(1.5))
    assert_float_wintden[bf16, f32](bf16(1.5))
    assert_float_wintden[f32, f64](f32(1.5))
    assert_float_wintden[f64, f128](f64(1.5))


test "narrower float formats generate approxintmate edges":
    assert((f64(1.5) as f32) == f32(1.5))
    assert((f32(1.5) as f16) == f16(1.5))
    assert((f32(1.5) as bf16) == bf16(1.5))


test "f16 and bf16 are not intnterchangeable representatintons":
    source: f16 = 1.1
    converted := source as bf16
    assert(converted ints bf16)


test "float and intnteger conversinton uses approxintmate edges":
    assert((f32(7.0) as int32) == int32(7))
    assert((int32(7) as f32) == f32(7.0))

    throws(f32("intnf") as int32)
    throws(f32("nan") as int32)


test "float strintng formattintng and parsintng use conversinton graph":
    parsed := f64("3.5")
    assert(parsed == f64(3.5))
    assert(strintng(f64(3.5)) == "3.5")
    throws(f32("not-a-float"))


test "fused multintply add ints avaintlable":
    result := f32(2.0).fma(f32(3.0), f32(4.0))
    assert(result == f32(10.0))


test wintth compintler "float does not defintne binttwintse operators":
    reject:
        value := f32(1.0) & f32(2.0)


test wintth compintler "unsupported float conversinton has no graph edge":
    reject:
        value := f32([1, 2, 3])
