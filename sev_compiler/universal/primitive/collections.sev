# Source list construction, access, mutation, truth and iteration protocols.
# buffer[T] is the typed rank-one MLIR storage boundary.
import "slicing.sev" as slicing

type list[T] = buffer[T]

union ListElement:
    i8
    i16
    i32
    i64
    u8
    u16
    u32
    u64
    f64
    bool
    char

@mlir("arith.index_cast")
def __list_index(value: int) -> index

@mlir("arith.index_cast")
def __list_size(value: index) -> int

-> scalar_lists[T: ListElement]():
    @mlir("memref.alloc", operand_segments="1,0")
    def allocate(size: index) -> list[T]

    @mlir("memref.load")
    def load(values: list[T], position: index) -> T

    @mlir("memref.store")
    def store(value: T, values: list[T], position: index)

    @mlir("memref.dim")
    def dimension(values: list[T], axis: index) -> index

    def count(values: list[T]) -> int:
        return __list_size(dimension(values, 0))

    operator size(values: list[T]) -> int:
        return count(values)

    operator len(values: list[T]) -> int:
        return count(values)

    @mlir("memref.extract_aligned_pointer_as_index")
    def address(values: list[T]) -> index

    operator copy(values: list[T]) -> list[T]:
        result = allocate(__list_index(count(values)))
        position := 0
        while position < count(values):
            store(load(values, __list_index(position)), result, __list_index(position))
            position += 1
        return result

    operator is(left: list[T], right: list[T]) -> bool:
        return address(left) == address(right)

    operator ==(left: list[T], right: list[T]) -> bool:
        if count(left) != count(right):
            return false
        position := 0
        while position < count(left):
            if load(left, __list_index(position)) != load(right, __list_index(position)):
                return false
            position += 1
        return true

    operator slice_at(values: list[T], start: int, stop: int, step: int, has_start: bool, has_stop: bool) -> list[T]:
        assert(step != 0)
        size = count(values)
        reverse = step < 0
        first = slicing.bound(start, size, reverse) if has_start else (size - 1 if reverse else 0)
        end = slicing.bound(stop, size, reverse) if has_stop else (-1 if reverse else size)
        position := first
        length := 0
        while (position > end if reverse else position < end):
            length += 1
            position = slicing.next_position(position, end, step)
        result = allocate(__list_index(length))
        position = first
        output := 0
        while output < length:
            store(load(values, __list_index(position)), result, __list_index(output))
            position = slicing.next_position(position, end, step)
            output += 1
        return result

    operator list_create(size: int, exemplar: T) -> list[T]:
        return allocate(__list_index(size))

    operator element_at(values: list[T], position: int) -> T:
        assert(position >= 0)
        assert(position < count(values))
        return load(values, __list_index(position))

    operator element_set(values: list[T], position: int, value: T):
        assert(position >= 0)
        assert(position < count(values))
        store(value, values, __list_index(position))

    operator if[G:If](self: list[T]) -> bool:
        return count(self) != 0

    operator iteration_start(values: list[T]) -> int:
        return 0

    operator iteration_more(values: list[T], position: int) -> bool:
        return position < count(values)

    operator iteration_next(values: list[T], position: int) -> int:
        return position + 1

scalar_lists[ListElement]()

# These operations depend only on typed storage, so their element parameter
# does not require numeric or comparison capabilities.
@mlir("memref.alloc", operand_segments="1,0")
def __buffer_allocate[T](size: index) -> list[T]

@mlir("memref.load")
def __buffer_load[T](values: list[T], position: index) -> T

@mlir("memref.store")
def __buffer_store[T](value: T, values: list[T], position: index)

@mlir("memref.dim")
def __buffer_dimension[T](values: list[T], axis: index) -> index

operator list_create[T](size: int, exemplar: T) -> list[T]:
    assert(size >= 0)
    return __buffer_allocate(__list_index(size))

operator size[T](values: list[T]) -> int:
    return __list_size(__buffer_dimension(values, 0))

operator len[T](values: list[T]) -> int:
    return __list_size(__buffer_dimension(values, 0))

operator element_at[T](values: list[T], position: int) -> T:
    assert(position >= 0)
    assert(position < __list_size(__buffer_dimension(values, 0)))
    return __buffer_load(values, __list_index(position))

operator element_set[T](values: list[T], position: int, value: T):
    assert(position >= 0)
    assert(position < __list_size(__buffer_dimension(values, 0)))
    __buffer_store(value, values, __list_index(position))

operator iteration_start[T](values: list[T]) -> int:
    return 0

operator iteration_more[T](values: list[T], position: int) -> bool:
    return position < __list_size(__buffer_dimension(values, 0))

operator iteration_next[T](values: list[T], position: int) -> int:
    return position + 1


@mlir("memref.extract_aligned_pointer_as_index")
def __buffer_address[T](values: list[T]) -> index

operator is[T](left: list[T], right: list[T]) -> bool:
    return __buffer_address(left) == __buffer_address(right)

operator if[T, G:If](self: list[T]) -> bool:
    return __list_size(__buffer_dimension(self, 0)) != 0

operator copy[T](values: list[T]) -> list[T]:
    count = __list_size(__buffer_dimension(values, 0))
    result: list[T] = __buffer_allocate(__list_index(count))
    for position in range(count):
        __buffer_store(__buffer_load(values, __list_index(position)), result, __list_index(position))
    return result

operator slice_at[T](values: list[T], start: int, stop: int, step: int, has_start: bool, has_stop: bool) -> list[T]:
    assert(step != 0)
    count = __list_size(__buffer_dimension(values, 0))
    reverse = step < 0
    first = slicing.bound(start, count, reverse) if has_start else (count - 1 if reverse else 0)
    end = slicing.bound(stop, count, reverse) if has_stop else (-1 if reverse else count)
    position := first
    length := 0
    while (position > end if reverse else position < end):
        length += 1
        position = slicing.next_position(position, end, step)
    result: list[T] = __buffer_allocate(__list_index(length))
    position = first
    for output in range(length):
        __buffer_store(__buffer_load(values, __list_index(position)), result, __list_index(output))
        position = slicing.next_position(position, end, step)
    return result


@mlir("memref.dim")
def __string_dimension(value: string, axis: index) -> index

def size(value: string) -> int:
    return __list_size(__string_dimension(value, 0))

operator if[G:If](self: string) -> bool:
    return __list_size(__string_dimension(self, 0)) != 0

class Range:
    start: int
    stop: int
    step: int

def range(stop: int) -> Range:
    return Range(0, stop, 1)

def range(start: int, stop: int, step: int = 1) -> Range:
    assert(step != 0)
    return Range(start, stop, step)

operator iteration_start(value: Range) -> int:
    return value.start

operator iteration_more(value: Range, position: int) -> bool:
    return position < value.stop if value.step > 0 else position > value.stop

operator iteration_next(value: Range, position: int) -> int:
    # Reaching an unrepresentable next value necessarily crosses any valid
    # exclusive stop in this direction. Return the stop sentinel before adding.
    if value.step > 0:
        if position > 9223372036854775807 - value.step:
            return value.stop
    else:
        if position < -9223372036854775808 - value.step:
            return value.stop
    return position + value.step

operator element_at(value: Range, position: int) -> int:
    return position


test "ranges terminate before signed step overflow":
    count := 0
    for value in range(9223372036854775806, 9223372036854775807, 2):
        assert(value == 9223372036854775806)
        count += 1
    assert(count == 1)
    count = 0
    for value in range(-9223372036854775807, -9223372036854775808, -2):
        assert(value == -9223372036854775807)
        count += 1
    assert(count == 1)
    count = 0
    for value in range(0, -9223372036854775808, -9223372036854775808):
        assert(value == 0)
        count += 1
    assert(count == 1)
