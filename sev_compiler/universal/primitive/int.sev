import "primitive.sev"

import "../operator/trait/arithmetic.sev"
import "../operator/trait/bitwise.sev"
import "../operator/trait/equatable.sev"
import "../operator/trait/ordered.sev"


'''
# `int`

`int` is Severian's closed family of fixed-width integer primitives.

```sev
union int:
    i8
    i16
    i32
    i64
    i128
    isize
    u8
    u16
    u32
    u64
    u128
    usize
```

The union is a type family for declarations, conversions, generic constraints,
documentation, and generated tests. A concrete integer value still has a concrete
storage type such as `i32` or `u64`.

Unsuffixed integer literals belong to the `int` family. The compiler resolves the
concrete representation from the expected type and literal range instead of
materializing a runtime `int` wrapper.

## Storage

Fixed-width integers lower to MLIR signless integer storage (`i8`, `i16`, `i32`,
`i64`, `i128`). Signedness remains a Severian type-system property and controls
comparison, extension, division, and conversion semantics.

`isize` and `usize` use the target pointer width.

## Truth

Integers participate in the `Truth` contract:

```text
0       -> false
nonzero -> true
```

Truth testing is not a narrowing conversion. `if value:` asks the integer for its
truth value without changing the integer's type.
'''


trait IntegerArithmetic:
    operator +(right: Self) -> Self
    operator -(right: Self) -> Self
    operator *(right: Self) -> Self
    operator /(right: Self) -> Self
    operator //(right: Self) -> Self
    operator %(right: Self) -> Self
    operator **(right: u32) -> Self

    operator +=(right: Self)
    operator -=(right: Self)
    operator *=(right: Self)
    operator /=(right: Self)
    operator //=(right: Self)
    operator %=(right: Self)


trait IntegerShift:
    operator <<[LeftShift: Y, I: int](right: I) -> Self
    operator >>[RightShift: Y, I: int](right: I) -> Self
    operator <<=[LeftShift: Y, I: int](right: I)
    operator >>=[RightShift: Y, I: int](right: I)


trait IntegerBitwiseAssign:
    operator &=(right: Self)
    operator |=(right: Self)
    operator ^=(right: Self)


trait Integer:
    Primitive
    Truth
    IntegerArithmetic
    IntegerShift
    Equatable
    Ordered
    Bitwise
    IntegerBitwiseAssign
    Copy
    Clone
    Default
    Hash
    Print
    ConstParam
    Structural

    property bits: u16
    property signed: bool
    property min: Self
    property max: Self


trait SignedInteger: Integer
trait UnsignedInteger: Integer


'''
# Integer family

The family itself is closed. Libraries may define numeric classes that convert to
or from an integer, but they do not become members of `int` merely by implementing
`Integer`.
'''
union signed_int:
    i8
    i16
    i32
    i64
    i128
    isize


union unsigned_int:
    u8
    u16
    u32
    u64
    u128
    usize


union int:
    signed_int
    unsigned_int


'''
# Primitive declarations

Only representation metadata differs between the concrete types. Behavior is
specified once by the `Integer` contracts and generated conversion relations below.
'''
class i8: SignedInteger :
    name: string = "i8"
    size: byte = 1B
    alignment: byte = 1B
    bits: u16 = 8
    signed: bool = true
    min: i8 = -128
    max: i8 = 127
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(8, true)
    default_literal: bool = true


class i16: SignedInteger :
    name: string = "i16"
    size: byte = 2B
    alignment: byte = 2B
    bits: u16 = 16
    signed: bool = true
    min: i16 = -32768
    max: i16 = 32767
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(16, true)
    default_literal: bool = true


class i32: SignedInteger :
    name: string = "i32"
    size: byte = 4B
    alignment: byte = 4B
    bits: u16 = 32
    signed: bool = true
    min: i32 = -2147483648
    max: i32 = 2147483647
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(32, true)
    default_literal: bool = true


class i64: SignedInteger :
    name: string = "i64"
    size: byte = 8B
    alignment: byte = 8B
    bits: u16 = 64
    signed: bool = true
    min: i64 = -9223372036854775808
    max: i64 = 9223372036854775807
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(64, true)
    default_literal: bool = true


class i128: SignedInteger :
    name: string = "i128"
    size: byte = 16B
    alignment: byte = 16B
    bits: u16 = 128
    signed: bool = true
    min: i128 = -(2 ** 127)
    max: i128 = (2 ** 127) - 1
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(128, true)
    default_literal: bool = true


class isize: SignedInteger :
    name: string = "isize"
    size: byte = target.pointer_size
    alignment: byte = target.pointer_alignment
    bits: u16 = target.pointer_bits
    signed: bool = true
    min: isize = -(2 ** (bits - 1))
    max: isize = (2 ** (bits - 1)) - 1
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(bits, true)
    default_literal: bool = true


class u8: UnsignedInteger :
    name: string = "u8"
    size: byte = 1B
    alignment: byte = 1B
    bits: u16 = 8
    signed: bool = false
    min: u8 = 0
    max: u8 = 255
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(8, false)
    default_literal: bool = true


class u16: UnsignedInteger :
    name: string = "u16"
    size: byte = 2B
    alignment: byte = 2B
    bits: u16 = 16
    signed: bool = false
    min: u16 = 0
    max: u16 = 65535
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(16, false)
    default_literal: bool = true


class u32: UnsignedInteger :
    name: string = "u32"
    size: byte = 4B
    alignment: byte = 4B
    bits: u16 = 32
    signed: bool = false
    min: u32 = 0
    max: u32 = 4294967295
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(32, false)
    default_literal: bool = true


class u64: UnsignedInteger :
    name: string = "u64"
    size: byte = 8B
    alignment: byte = 8B
    bits: u16 = 64
    signed: bool = false
    min: u64 = 0
    max: u64 = 18446744073709551615
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(64, false)
    default_literal: bool = true


class u128: UnsignedInteger :
    name: string = "u128"
    size: byte = 16B
    alignment: byte = 16B
    bits: u16 = 128
    signed: bool = false
    min: u128 = 0
    max: u128 = (2 ** 128) - 1
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(128, false)
    default_literal: bool = true


class usize: UnsignedInteger :
    name: string = "usize"
    size: byte = target.pointer_size
    alignment: byte = target.pointer_alignment
    bits: u16 = target.pointer_bits
    signed: bool = false
    min: usize = 0
    max: usize = (2 ** bits) - 1
    category: PrimitiveCategory = PrimitiveCategory.Integer
    representation: PrimitiveRepresentation = PrimitiveRepresentation.IntegerBits(bits, false)
    default_literal: bool = true


'''
# Shared integer behavior

These operators are inherited by every member of `int`. The compiler lowers the
operation using the concrete member's width and signedness.

## Direct MLIR lowering

Primitive operations bind directly to MLIR with `mlir(...)`.

```sev
return mlir(arith.addi, self, right)
return mlir(arith.cmpi, "slt", self, right)
return mlir(math.ctpop, self)
```

`mlir(...)` is typed IR construction: the compiler resolves Severian values and
types to MLIR SSA operands and result types, verifies the operation, and inserts
the resulting operation into the current lowering region.

Signedness remains a Severian property because MLIR integer storage is signless.
Operations that care about signedness therefore choose the concrete MLIR op or
predicate explicitly:

```sev
if I.signed:
    return mlir(arith.divsi, self, right)
return mlir(arith.divui, self, right)
```

A raw block is available when an operation needs several MLIR statements:

```sev
mlir:
    %result = arith.addi %self, %right : !I
    return %result
```

Formatting, parsing, hashing, and other library behavior are not disguised as
compiler intrinsics. They remain ordinary Severian/library operations unless
they have a real MLIR operation to bind to.
'''
extend [I: int] I:

    operator if(self) -> bool:
        return self != 0

    operator else(self) -> bool:
        return self == 0

    operator +(right: I) -> I:
        return mlir(arith.addi, self, right)

    operator -(right: I) -> I:
        return mlir(arith.subi, self, right)

    operator *(right: I) -> I:
        return  mlir(arith.muli, self, right)

    operator /(right: I) -> I:
        if I.signed:
            return mlir(arith.divsi, self, right)
        return mlir(arith.divui, self, right)

    operator //(right: I) -> I:
        if I.signed:
            return mlir(arith.floordivsi, self, right)
        return mlir(arith.divui, self, right)

    operator %(right: I) -> I:
        if I.signed:
            return mlir(arith.remsi, self, right)
        return mlir(arith.remui, self, right)

    operator **(right: u32) -> I:
        return mlir(math.ipowi, self, right as I)

    operator &(right: I) -> I:
        return mlir(arith.andi, self, right)

    operator |(right: I) -> I:
        return mlir(arith.ori, self, right)

    operator ^(right: I) -> I:
        return mlir(arith.xori, self, right)

    operator <<[LeftShift: Y, S: int](right: S) -> I:
        return mlir(arith.shli, self, right as I)

    operator >>[RightShift: Y, S: int](right: S) -> I:
        if I.signed:
            return mlir(arith.shrsi, self, right as I)
        return mlir(arith.shrui, self, right as I)

    operator ==(right: I) -> bool:
        return mlir(arith.cmpi, "eq", self, right)

    operator !=(right: I) -> bool:
        return not (self == right)

    operator <(right: I) -> bool:
        if I.signed:
            return mlir(arith.cmpi, "slt", self, right)
        return mlir(arith.cmpi, "ult", self, right)

    operator <=(right: I) -> bool:
        return self < right or self == right

    operator >(right: I) -> bool:
        return right < self

    operator >=(right: I) -> bool:
        return right <= self

    operator +=(right: I):
        self = self + right

    operator -=(right: I):
        self = self - right

    operator *=(right: I):
        self = self * right

    operator /=(right: I):
        self = self / right

    operator //=(right: I):
        self = self // right

    operator %=(right: I):
        self = self % right

    operator &=(right: I):
        self = self & right

    operator |=(right: I):
        self = self | right

    operator ^=(right: I):
        self = self ^ right

    operator <<=[LeftShift: Y, S: int](right: S):
        self = self << right

    operator >>=[RightShift: Y, S: int](right: S):
        self = self >> right

    def copy(self) -> I:
        return self

    def default() -> I:
        return 0

    def hash(self) -> u64:
        return hash(self.to_ne_bytes())

    def print(self) -> string:
        return string.from_integer(self, base=10)

    def abs(self) -> I:
        if I.signed:
            return mlir(math.absi, self)
        return self

    def rotate_left(self, count: u32) -> I:
        shift := count % u32(I.bits)
        if shift == 0:
            return self

        left := mlir(arith.shli, self, shift as I)
        right := mlir(arith.shrui, self, (u32(I.bits) - shift) as I)
        return mlir(arith.ori, left, right)

    def rotate_right(self, count: u32) -> I:
        shift := count % u32(I.bits)
        if shift == 0:
            return self

        right := mlir(arith.shrui, self, shift as I)
        left := mlir(arith.shli, self, (u32(I.bits) - shift) as I)
        return mlir(arith.ori, left, right)

    def little_endian(self) -> bytes[I.bits / 8]:
        result := bytes[I.bits / 8]()
        for index in range(I.bits / 8):
            shifted := mlir(arith.shrui, self, I(index * 8))
            if I.bits == 8:
                result[index] = mlir(arith.bitcast, shifted, to=u8)
            else:
                result[index] = mlir(arith.trunci, shifted, to=u8)
        return result

    def big_endian(self) -> bytes[I.bits / 8]:
        result := bytes[I.bits / 8]()
        for index in range(I.bits / 8):
            shift := (I.bits / 8 - index - 1) * 8
            shifted := mlir(arith.shrui, self, I(shift))
            if I.bits == 8:
                result[index] = mlir(arith.bitcast, shifted, to=u8)
            else:
                result[index] = mlir(arith.trunci, shifted, to=u8)
        return result

    def native_endian(self) -> bytes[I.bits / 8]:
        if target.endian == Endian.Little:
            return self.to_le_bytes()
        return self.to_be_bytes()


extend [I: signed_int] I:

    operator +(self) -> I:
        return self

    operator -(self) -> I:
        return mlir(arith.subi, I(0), self)

    def signum(self) -> I:
        if self < 0:
            return -1
        if self > 0:
            return 1
        return 0

    def is_negative(self) -> bool:
        return self < 0

    def is_positive(self) -> bool:
        return self > 0


extend [I: unsigned_int] I:

    operator +(self) -> I:
        return self


'''
## Conversion relations

Conversions are declared inside `operator <=>` as edges in the type-conversion
graph.

- `A => B` declares a bidirectional conversion relationship between `A` and `B`.
- `A -> B` declares a one-direction conversion from `A` to `B`.
- `A ~> B` declares an approximate relationship where conversion may lose
  information, require a policy, or fail with `TypeConversionError`.
- `T(value)` requests the canonical conversion to `T`.
- `value as T` requests conversion through the broader conversion graph and may
  use relationships that the canonical constructor does not.
- An unsupported conversion produces `TypeConversionError`.

The symbols describe the graph. They do not impose a global policy about what a
programmer is allowed to request.

```text
A => B       A <-> B
A -> B       A  -> B
A ~> B       A ~~> B
```

## Integer-to-integer conversion

Every concrete member of `int` receives conversion edges to every other member.
The relation is selected from the source and target ranges:

- if every source value fits in the target, the source has a `->` edge to target;
- otherwise the source has a `~>` edge to target.

This gives widening conversions such as `i8 -> i16`, while narrowing or
signedness-changing conversions such as `i64 ~> i8` and `i16 ~> u16` are marked
as approximate.

The `~>` body checks the value before lowering the cast. `as` may request the edge,
but it does not disable the check.
'''
extend [I: int] I:

    operator <=>(self, T) -> T | TypeConversionError:

        integer_conversion-> [T:J] with J in int:

            self -> J with self.min >= J.min and self.max <= J.max:
                if I.bits < J.bits:
                    if I.signed:
                        return mlir(arith.extsi, self, to=J)
                    return mlir(arith.extui, self, to=J)
                if I.bits > J.bits:
                    return mlir(arith.trunci, self, to=J)
                return mlir(arith.bitcast, self, to=J)

            self ~> J with self.min < J.min or self.max > J.max:
                if self < J.min or self > J.max:
                    throw TypeConversionError(
                        f"{I} value {self} is outside {J}[{J.min}, {J.max}]"
                    )
                if I.bits < J.bits:
                    if I.signed:
                        return mlir(arith.extsi, self, to=J)
                    return mlir(arith.extui, self, to=J)
                if I.bits > J.bits:
                    return mlir(arith.trunci, self, to=J)
                return mlir(arith.bitcast, self, to=J)

        integer_conversion -> int

        '''
        ## Floating conversion family

        Integer and floating-point storage do not share an exact conversion graph
        in general. Large integers may lose precision when represented as a float;
        floats may contain fractions, infinities, NaNs, or values outside the target
        integer range. Both directions are therefore `~>` relationships.
        '''
        float_conversion-> [T:F] with F in float:

            self ~> F:
                if I.signed:
                    return mlir(arith.sitofp, self, to=F)
                return mlir(arith.uitofp, self, to=F)

            F ~> self:
                if not F.is_finite():
                    throw TypeConversionError("non-finite float cannot convert to int")
                if F < I.min or F > I.max:
                    throw TypeConversionError(
                        f"{F} is outside {I}[{I.min}, {I.max}]"
                    )
                if I.signed:
                    return mlir(arith.fptosi, F, to=I)
                return mlir(arith.fptoui, F, to=I)

        float_conversion -> float

        '''
        ## String conversion

        Integer formatting is one-directional and total. Parsing is approximate
        because the string may not represent a valid integer or may exceed the
        target integer range.
        '''
        self -> string:
            return self.print()

        string ~> self:
            parsed ?= string.parse_integer[int](string, base=10)
            if parsed is Error:
                throw TypeConversionError(f"cannot convert '{string}' to {I}")
            return parsed

        _ -> [T]:
            throw TypeConversionError(
                f"Failed to convert {I} to {type(T)}, no compatible conversion"
            )


'''
# Executable specification

These tests describe family membership, truth behavior, integer operators,
signedness, conversion-edge generation, approximate conversions, formatting, and
compiler rejection.
'''


test "int is a closed family of concrete integer primitives":
    assert(i8 is int)
    assert(i16 is int)
    assert(i32 is int)
    assert(i64 is int)
    assert(i128 is int)
    assert(isize is int)
    assert(u8 is int)
    assert(u16 is int)
    assert(u32 is int)
    assert(u64 is int)
    assert(u128 is int)
    assert(usize is int)


test "integer truth is zero versus nonzero":
    if i32(0):
        throw Error("zero must be false")

    if i32(27):
        pass
    else:
        throw Error("nonzero integer must be true")

    if i32(-1):
        pass
    else:
        throw Error("negative nonzero integer must be true")


test "integer arithmetic uses the concrete type":
    a: i32 = 20
    b: i32 = 6

    assert(a + b == 26)
    assert(a - b == 14)
    assert(a * b == 120)
    assert(a // b == 3)
    assert(a % b == 2)
    assert(i32(2) ** 5 == 32)


test "signed integer unary operations are defined":
    value: i32 = -7
    assert(+value == -7)
    assert(-value == 7)
    assert(value.abs() == 7)
    assert(value.signum() == -1)
    assert(i32(0).signum() == 0)
    assert(i32(8).signum() == 1)


test "integer bitwise and shifts are concrete":
    value: u8 = 0b1010
    assert((value & u8(0b1100)) == u8(0b1000))
    assert((value | u8(0b0101)) == u8(0b1111))
    assert((value ^ u8(0b1111)) == u8(0b0101))
    assert((u8(1) << 3) == u8(8))
    assert((u8(8) >> 3) == u8(1))


test "integer ordering respects signedness":
    assert(i32(-1) < i32(0))
    assert(i32(0) < i32(1))
    assert(u32(0) < u32(1))
    assert(i32(7) >= i32(7))


test "integer metadata defines range and width":
    assert(i8.bits == 8)
    assert(i8.min == -128)
    assert(i8.max == 127)
    assert(u8.bits == 8)
    assert(u8.min == 0)
    assert(u8.max == 255)


-> assert_lossless_integer_conversion[A, B](value: A):
    converted: B = B(value)
    assert(converted == value as B)


test "widening integer conversions generate one directional edges":
    assert_lossless_integer_conversion[i8, i16](100)
    assert_lossless_integer_conversion[u8, u16](255)
    assert_lossless_integer_conversion[i32, i64](2147483647)


test "narrowing integer conversions use approximate graph edges":
    assert((i16(127) as i8) == i8(127))
    assert((i16(255) as u8) == u8(255))

    throws(i16(128) as i8)
    throws(i16(-1) as u8)
    throws(u16(256) as u8)


test "integer and float conversion may approximate":
    assert((i32(7) as f32) == f32(7.0))
    assert((f32(7.0) as i32) == i32(7))


test "integer string formatting and parsing use conversion graph":
    assert(string(i32(-42)) == "-42")
    assert(i32("42") == 42)
    assert(i32("-42") == -42)
    throws(i32("forty-two"))


test "integer endian bytes preserve representation":
    value: u16 = 0x1234
    assert(value.big_endian() == bytes([0x12, 0x34]))
    assert(value.little_endian() == bytes([0x34, 0x12]))


test with compiler "unsigned integers do not define unary negation":
    reject:
        value := -u32(1)


test with compiler "unsupported conversion has no canonical edge":
    reject:
        value := i32([1, 2, 3])




test with compiler "package level no loss of data for conversion":
    import package
    #Set package for compiler to reject data loss for conversion
    package.config.set("lossless.conversion",true)
    reject:
        big_number: i64 = 10**10
        small_representation: f8 = big_number

    package.config.set("lossless.conversion",false)
    accept:
        big_number: i64 = 10**10
        small_representation: f8 = big_number
