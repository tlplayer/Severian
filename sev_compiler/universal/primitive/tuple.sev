import "../component/services.sev" as compiler


trait TupleSyntax: G:
    symbol: Y = (
    form: GrammarForm = GrammarForm.Delimited
    closing: string = ")"
    separator: string = ","
    grouping: bool = true

    def semantic(values: list[Ex]) -> Ex:
        return compiler.construct(tuple, values)


class tuple[...T]:
    items: ...T
