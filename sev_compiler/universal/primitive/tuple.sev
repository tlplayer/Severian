import "../component/services.sev" as compiler


trait TupleSyntax: G:
    symbol: Y = (
    form: GrammarForm = GrammarForm.Delimited
    closing: string = ")"
    separator: string = ","
    grouping: bool = true

    def semantic(values: list[Ex]) -> Ex:
        return compiler.construct(tuple, values)


class tuple[*T]:
    *items: T

    @expand("Index.access")
    def element_at(value: Ex, position: Ex) -> Ex:
        fields = compiler.fields(value)
        index := compiler.integer(position, 0)
        if index < 0:
            index = index + compiler.size(fields)
        assert(index >= 0 and index < compiler.size(fields), "tuple index is out of bounds")
        return fields[index]

    @expand("Slice.access")
    def slice_at(value: Ex, start: Ex, stop: Ex, step: Ex) -> Ex:
        fields = compiler.fields(value)
        size = compiler.size(fields)
        stride = compiler.integer(step, 1)
        assert(stride != 0, "tuple slice step cannot be zero")
        first := size - 1 if stride < 0 else 0
        last := -1 if stride < 0 else size
        if not compiler.missing(start):
            first = tuple_bound(compiler.integer(start, 0), size, stride < 0)
        if not compiler.missing(stop):
            last = tuple_bound(compiler.integer(stop, 0), size, stride < 0)
        selected: list[Ex] = []
        while (first > last if stride < 0 else first < last):
            selected.append(fields[first])
            first = tuple_next(first, last, stride)
        return compiler.rebuild(value, selected)

    @expand("string")
    def format(value: Ex) -> Ex:
        fields = compiler.fields(value)
        result := compiler.text("(")
        index := 0
        for field in fields:
            if index != 0:
                result = compiler.concat(result, compiler.text(","))
            result = compiler.concat(result, compiler.render(field))
            index = index + 1
        ending = ",)" if compiler.size(fields) == 1 else ")"
        return compiler.concat(result, compiler.text(ending))


@expand("helper")
def tuple_bound(value: int, size: int, reverse: bool) -> int:
    result := value
    if result < 0:
        result = result + size
    minimum = -1 if reverse else 0
    maximum = size - 1 if reverse else size
    if result < minimum:
        return minimum
    if result > maximum:
        return maximum
    return result


@expand("helper")
def tuple_next(position: int, end: int, step: int) -> int:
    if step < 0:
        if step <= end - position:
            return end
    else:
        if step >= end - position:
            return end
    return position + step
