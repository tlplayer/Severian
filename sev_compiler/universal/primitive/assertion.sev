# cf.assert terminates the process, but its hosted LLVM lowering prints through
# buffered stdout. Emit the diagnostic to stderr before handing it the condition.
@c(symbol="write")
def __assert_write(descriptor: i32, data: native_ptr, size: int) -> int

@mlir("memref.extract_aligned_pointer_as_index")
def __assert_address(value: string) -> index

@mlir("arith.index_cast")
def __assert_index(value: index) -> int

@mlir("llvm.inttoptr")
def __assert_pointer(value: int) -> native_ptr

def __assert_condition(condition: bool, message: string) -> bool:
    if not condition:
        diagnostic = "assertion failed: " + message + "\n"
        address = __assert_index(__assert_address(diagnostic))
        remaining := size(diagnostic)
        offset := 0
        while remaining > 0:
            written = __assert_write(2, __assert_pointer(address + offset), remaining)
            if written <= 0:
                break
            offset += written
            remaining -= written
    return condition
