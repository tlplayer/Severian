trait IndexedId:
    property index: u32


trait StableId:
    property value: u128


trait NamedId:
    property value: string


class HirId: IndexedId
    index: u32


class BindingId: IndexedId
    index: u32


class VariantId: IndexedId
    index: u32


class ValueId: IndexedId
    index: u32


class TypeId: IndexedId
    index: u32


class GenericParamId: IndexedId
    index: u32


class DeclarationId: StableId
    value: u128


class CompilerId: StableId
    value: u128


class DefId:
    package: u128
    module: u128
    declaration: DeclarationId


class Substitution:
    arguments: list[tuple[GenericParamId, TypeId]] = []


class OpId:
    dialect: u128
    operation: u128


class AttributeId: StableId
    value: u128


enum AttrValue:
    Integer(value: i128)
    Boolean(value: bool)
    String(value: string)
    Type(value: TypeId)
    Types(value: list[TypeId])


class BlockId: IndexedId
    index: u32


class LocalId: IndexedId
    index: u32


class ScopeId:
    module: ModuleId


class PackageId: IndexedId
    index: u32


class CompiledRegionId: IndexedId
    index: u32


class ArtifactId: IndexedId
    index: u32


class FunctionId: StableId
    value: u128


class ModuleId: StableId
    value: u128


class ProviderId: StableId
    value: u128


class InterfaceId: NamedId
    value: string


class FfiId: NamedId
    value: string


class AbiId: NamedId
    value: string


class SymbolId: NamedId
    value: string
