import * from "../type/scalar.sev" as scalar


test "scalar lookup preserves the catalog and rejects unknown identities":
    catalog = scalar.scalar_types()
    names: list[string] = []
    for entry in catalog:
        names.append(entry.name)
        assert(scalar.scalar_type_name(entry.name) == entry.id)
        assert(scalar.scalar_type_name("$buffer$" + entry.name) == scalar.TypeId(entry.id.index + 200))
    assert(names.join(",") == "bool,unit,string,index,native_ptr,None,absent,f64,u8,u16,u32,u64,char,i8,i16,i32,i64")
    assert(scalar.scalar_type_name("usize") == scalar.TypeId(564))
    assert(scalar.scalar_type_name("int") == scalar.TypeId(64))
    assert(scalar.scalar_type_name("float") == scalar.TypeId(164))
    for identity in range(1100):
        known := false
        buffer := false
        for entry in catalog:
            if identity == int(entry.id.index):
                known = true
            if identity == int(entry.id.index) + 200:
                buffer = true
        found ?= scalar.scalar_type(scalar.TypeId(u32(identity)))
        assert((found != None) == (known or buffer))
        if found != None:
            assert((found.representation == "buffer") == buffer)
            for entry in catalog:
                if identity == int(entry.id.index):
                    assert(found.name == entry.name and found.bits == entry.bits)
                    assert(found.signed == entry.signed and found.boolean == entry.boolean)
                    assert(found.representation == entry.representation)
                if identity == int(entry.id.index) + 200:
                    assert(found.name == "$buffer$" + entry.name and found.bits == entry.bits)
                    assert(found.signed and not found.boolean)
