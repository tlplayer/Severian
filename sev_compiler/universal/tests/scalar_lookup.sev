import * from "../type/scalar.sev" as scalar


def check_identity(identity: int, catalog: list[scalar.ScalarType]):
    matches_scalar := false
    matches_buffer := false
    for entry in catalog:
        if identity == int(entry.id.index):
            matches_scalar = true
        if identity == int(entry.id.index) + 200:
            matches_buffer = true
    catalog_lookup_value ?= scalar.scalar_type(scalar.TypeId(u32(identity)))
    assert((catalog_lookup_value != None) == (matches_scalar or matches_buffer))
    if catalog_lookup_value != None:
        assert((catalog_lookup_value.representation == "buffer") == matches_buffer)
        for entry in catalog:
            if identity == int(entry.id.index):
                assert(catalog_lookup_value.name == entry.name and catalog_lookup_value.bits == entry.bits)
                assert(catalog_lookup_value.signed == entry.signed and catalog_lookup_value.boolean == entry.boolean)
                assert(catalog_lookup_value.representation == entry.representation)
            if identity == int(entry.id.index) + 200:
                assert(catalog_lookup_value.name == "$buffer$" + entry.name and catalog_lookup_value.bits == entry.bits)
                assert(catalog_lookup_value.signed and not catalog_lookup_value.boolean)


test "scalar lookup preserves the catalog and rejects unknown identities":
    catalog = scalar.scalar_types()
    names: list[string] = []
    for entry in catalog:
        names.append(entry.name)
        assert(scalar.scalar_type_name(entry.name) == entry.id)
        assert(scalar.scalar_type_name("$buffer$" + entry.name) == scalar.TypeId(entry.id.index + 200))
    assert(names.join(",") == "bool,unit,string,index,native_ptr,None,absent,f64,u8,u16,u32,u64,char,i8,i16,i32,i64")
    assert(scalar.scalar_type_name("usize") == scalar.TypeId(564))
    assert(scalar.scalar_type_name("int") == scalar.TypeId(64))
    assert(scalar.scalar_type_name("float") == scalar.TypeId(164))
    for identity in range(1100):
        check_identity(identity, catalog)
