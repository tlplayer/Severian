import * from "../declaration/function.sev"
import * from "scalar.sev"


# Storage types retain their element identity independently of value layouts.
def buffer_element(id: TypeId, records: borrow list[RecordDeclaration]) -> TypeId:
    if scalar_representation(id) == "buffer":
        return TypeId(id.index - 200)
    for record in borrow records:
        if record.type_id.index == id.index:
            return record.storage_element
    return TypeId(0)


def indirect_value(id: TypeId, records: borrow list[RecordDeclaration]) -> bool:
    for record in borrow records:
        if record.type_id.index == id.index and record.representation in ["OwnedBuffer", "String"]:
            return true
    return id.index >= 1000 and buffer_element(id, records).index == 0


def owned_record(id: TypeId, records: borrow list[RecordDeclaration], active: list[int] = []) -> bool:
    if not indirect_value(id, records) or int(id.index) in active:
        return false
    path = active[:]
    path.append(int(id.index))
    for record in borrow records:
        if record.type_id.index == id.index:
            for field in borrow record.fields:
                if field.type_id.index == 3 or buffer_element(field.type_id, records).index != 0 or owned_record(field.type_id, records, path):
                    return true
    return false


def copy_storage(id: TypeId, records: borrow list[RecordDeclaration], active: list[int] = []) -> bool:
    if id.index == 2:
        return false
    if id.index >= 100000:
        return true
    if int(id.index) in active:
        return false
    if buffer_element(id, records).index != 0:
        return false
    representation = scalar_representation(id)
    if representation != "unknown":
        return representation in ["integer", "float", "index", "pointer"]
    for record in borrow records:
        if record.type_id.index == id.index:
            for method in borrow record.methods:
                if method.name == "drop":
                    return false
            path = active[:]
            path.append(int(id.index))
            for field in borrow record.fields:
                if not copy_storage(field.type_id, records, path):
                    return false
            return true
    return false


# Flatten owned records at function boundaries so their buffers remain visible
# to the target's ownership pass without duplicating each caller's control flow.
def value_fields(id: TypeId, records: borrow list[RecordDeclaration]) -> list[TypeId]:
    if id.index == 2:
        return []
    if not owned_record(id, records):
        return [id]
    result: list[TypeId] = []
    for record in borrow records:
        if record.type_id.index == id.index:
            for field in borrow record.fields:
                for leaf in value_fields(field.type_id, records):
                    result.append(leaf)
    return result


# String literals use the same typed buffer leaves as their source vector.
def string_element(id: TypeId, records: borrow list[RecordDeclaration]) -> TypeId:
    for record in borrow records:
        if record.type_id.index == id.index and record.representation == "String":
            leaves = value_fields(id, records)
            if len(leaves) > 0:
                return buffer_element(leaves[0], records)
    return TypeId(0)
