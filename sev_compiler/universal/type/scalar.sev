import * from "../id/compiler.sev"


# Stable identities for the first source-compiled scalar pipeline. The table
# belongs to universal, and both semantic analysis and MLIR lowering consult it.
class ScalarType:
    id: TypeId
    name: string
    bits: u16
    boolean: bool
    representation: string = "integer"
    signed: bool = true


def scalar_types() -> list[ScalarType]:
    return [ScalarType(TypeId(1), "bool", 1, true), ScalarType(TypeId(2), "unit", 0, false), ScalarType(TypeId(3), "string", 8, false, "utf8"), ScalarType(TypeId(4), "index", 64, false, "index"), ScalarType(TypeId(5), "native_ptr", 64, false, "pointer"), ScalarType(TypeId(6), "None", 64, false, "pointer"), ScalarType(TypeId(7), "absent", 64, false, "pointer"), ScalarType(TypeId(164), "f64", 64, false, "float"), ScalarType(TypeId(108), "u8", 8, false, signed=false), ScalarType(TypeId(516), "u16", 16, false, signed=false), ScalarType(TypeId(532), "u32", 32, false, signed=false), ScalarType(TypeId(564), "u64", 64, false, signed=false), ScalarType(TypeId(132), "char", 32, false, signed=false), ScalarType(TypeId(8), "i8", 8, false), ScalarType(TypeId(16), "i16", 16, false), ScalarType(TypeId(32), "i32", 32, false), ScalarType(TypeId(64), "i64", 64, false)]


def scalar_type_name(name: string) -> TypeId | None:
    if name == "usize":
        return TypeId(564)
    for element in scalar_types():
        if name == "$buffer$" + element.name:
            return TypeId(200 + element.id.index)
    for scalar in scalar_types():
        if scalar.name == name or (name == "int" and scalar.name == "i64") or (name == "float" and scalar.name == "f64"):
            return scalar.id
    return None


def scalar_type(id: TypeId) -> ScalarType | None:
    for element in scalar_types():
        if id.index == 200 + element.id.index:
            return ScalarType(id, "$buffer$" + element.name, element.bits, false, "buffer")
    for scalar in scalar_types():
        if scalar.id.index == id.index:
            return scalar
    return None


def scalar_representation(id: TypeId) -> string:
    known ?= scalar_type(id)
    if known != None:
        return known.representation
    return "unknown"


def integer_minimum(type: ScalarType) -> string:
    if not type.signed:
        return "0"
    if type.bits == 64:
        return "-9223372036854775808"
    return "-" + string(1 << (int(type.bits) - 1))


def integer_maximum(type: ScalarType) -> string:
    if type.bits == 64:
        return "9223372036854775807" if type.signed else "18446744073709551615"
    return string((1 << (int(type.bits) - (1 if type.signed else 0))) - 1)
