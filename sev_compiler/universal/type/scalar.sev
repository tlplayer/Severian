import "../id/compiler.sev"


# Stable identities for the first source-compiled scalar pipeline. The table
# belongs to universal, and both semantic analysis and MLIR lowering consult it.
class ScalarType:
    id: TypeId
    name: string
    bits: u16
    boolean: bool
    representation: string = "integer"


def scalar_types() -> list[ScalarType]:
    return [ScalarType(TypeId(1), "bool", 1, true), ScalarType(TypeId(2), "unit", 0, false), ScalarType(TypeId(3), "string", 8, false, "utf8"), ScalarType(TypeId(4), "index", 64, false, "index"), ScalarType(TypeId(108), "u8", 8, false), ScalarType(TypeId(132), "char", 32, false), ScalarType(TypeId(8), "i8", 8, false), ScalarType(TypeId(16), "i16", 16, false), ScalarType(TypeId(32), "i32", 32, false), ScalarType(TypeId(64), "i64", 64, false)]


def scalar_type_name(name: string) -> TypeId | None:
    for scalar in scalar_types():
        if scalar.name == name or (name == "int" and scalar.name == "i64"):
            return scalar.id
    return None


def scalar_type(id: TypeId) -> ScalarType | None:
    for scalar in scalar_types():
        if scalar.id.index == id.index:
            return scalar
    return None
