import profiling
import * from "../id/compiler.sev"


# Stable identities for the first source-compiled scalar pipeline. The table
# belongs to universal, and both semantic analysis and MLIR lowering consult it.
enum ScalarIdentities:
    Bool {1}
    Unit {2}
    String {3}
    Index {4}
    NativePtr {5}
    NoneValue {6}
    Absent {7}
    F32 {163}
    F64 {164}
    U8 {108}
    U16 {516}
    U32 {532}
    U64 {564}
    Char {132}
    I8 {8}
    I16 {16}
    I32 {32}
    I64 {64}


def scalar_identities() -> list[int]:
    return [
        int(ScalarIdentities.Bool),
        int(ScalarIdentities.Unit),
        int(ScalarIdentities.String),
        int(ScalarIdentities.Index),
        int(ScalarIdentities.NativePtr),
        int(ScalarIdentities.NoneValue),
        int(ScalarIdentities.Absent),
        int(ScalarIdentities.F32),
        int(ScalarIdentities.F64),
        int(ScalarIdentities.U8),
        int(ScalarIdentities.U16),
        int(ScalarIdentities.U32),
        int(ScalarIdentities.U64),
        int(ScalarIdentities.Char),
        int(ScalarIdentities.I8),
        int(ScalarIdentities.I16),
        int(ScalarIdentities.I32),
        int(ScalarIdentities.I64),
    ]


class ScalarType:
    id: TypeId
    name: string
    bits: u16
    boolean: bool
    representation: string = "integer"
    signed: bool = true




def scalar_types() -> list[ScalarType]:
    values: list[ScalarType] = []
    for identity in scalar_identities():
        value ?= scalar_type(TypeId(u32(identity)))
        if value != None:
            values.append(value)
    return values


def scalar_type_name(name: string) -> TypeId | None:
    if name == "usize":
        return TypeId(564)
    if name == "int":
        return TypeId(64)
    if name == "float":
        return TypeId(164)
    buffer = name.starts_with("$buffer$")
    spelling = name[8:] if buffer else name
    known ?= scalar_descriptor(TypeId(0), spelling)
    if known != None:
        return TypeId(known.id.index + 200) if buffer else known.id
    return None


@record_calls
def make_scalar_descriptor(id: TypeId, name: string = "") -> ScalarType | None:
    # Lookup constructs only the requested descriptor. Semantic analysis asks
    # this on hot paths; allocating the full catalog here multiplies both
    # allocation traffic and compile time. scalar_types retains catalog order.
    if id.index == 1 or name == "bool":
        return ScalarType(TypeId(1), "bool", 1, true)
    if id.index == 2 or name == "unit":
        return ScalarType(TypeId(2), "unit", 0, false)
    if id.index == 3 or name == "string":
        return ScalarType(TypeId(3), "string", 8, false, "utf8")
    if id.index == 4 or name == "index":
        return ScalarType(TypeId(4), "index", 64, false, "index")
    if id.index == 5 or name == "native_ptr":
        return ScalarType(TypeId(5), "native_ptr", 64, false, "pointer")
    if id.index == 6 or name == "None":
        return ScalarType(TypeId(6), "None", 64, false, "pointer")
    if id.index == 7 or name == "absent":
        return ScalarType(TypeId(7), "absent", 64, false, "pointer")
    if id.index == 163 or name == "f32":
        return ScalarType(TypeId(163), "f32", 32, false, "float")
    if id.index == 164 or name == "f64":
        return ScalarType(TypeId(164), "f64", 64, false, "float")
    if id.index == 108 or name == "u8":
        return ScalarType(TypeId(108), "u8", 8, false, signed=false)
    if id.index == 516 or name == "u16":
        return ScalarType(TypeId(516), "u16", 16, false, signed=false)
    if id.index == 532 or name == "u32":
        return ScalarType(TypeId(532), "u32", 32, false, signed=false)
    if id.index == 564 or name == "u64":
        return ScalarType(TypeId(564), "u64", 64, false, signed=false)
    if id.index == 132 or name == "char":
        return ScalarType(TypeId(132), "char", 32, false, signed=false)
    if id.index == 8 or name == "i8":
        return ScalarType(TypeId(8), "i8", 8, false)
    if id.index == 16 or name == "i16":
        return ScalarType(TypeId(16), "i16", 16, false)
    if id.index == 32 or name == "i32":
        return ScalarType(TypeId(32), "i32", 32, false)
    if id.index == 64 or name == "i64":
        return ScalarType(TypeId(64), "i64", 64, false)
    return None


class ScalarSlot:
    value: ScalarType | None


# The scalar catalog is immutable package data. Optional descriptors are stored
# as values too, avoiding a freshly boxed sum payload on every successful query.
def initialize_scalar_catalog():
    values = ScalarCatalog
    for index in range(1000):
        values.append(ScalarSlot(None))
    for identity in scalar_identities():
        descriptor ?= make_scalar_descriptor(TypeId(u32(identity)))
        if descriptor != None:
            values[identity] = ScalarSlot(descriptor)
            values[identity + 200] = ScalarSlot(ScalarType(TypeId(u32(identity + 200)), "$buffer$" + descriptor.name, descriptor.bits, false, "buffer"))


ScalarCatalog: list[ScalarSlot] = []


def scalar_descriptor(id: TypeId, name: string = "") -> ScalarType | None:
    if len(ScalarCatalog) == 0:
        initialize_scalar_catalog()
    if id.index != 0 and name != "":
        return make_scalar_descriptor(id, name)
    if name == "":
        if id.index < 1000:
            selected ?= ScalarCatalog[id.index].value
            if selected != None:
                if selected.representation != "buffer":
                    return ScalarCatalog[id.index].value
        return None
    for identity in scalar_identities():
        selected ?= ScalarCatalog[identity].value
        if selected != None:
            if selected.name == name:
                return ScalarCatalog[identity].value
    return None


def scalar_type(id: TypeId) -> ScalarType | None:
    if len(ScalarCatalog) == 0:
        initialize_scalar_catalog()
    if id.index < 1000:
        return ScalarCatalog[id.index].value
    return None


def scalar_representation(id: TypeId) -> string:
    known ?= scalar_type(id)
    if known != None:
        return known.representation
    return "unknown"


def integer_minimum(type: ScalarType) -> string:
    if not type.signed:
        return "0"
    if type.bits == 64:
        return "-9223372036854775808"
    return "-" + string(1 << (int(type.bits) - 1))


def integer_maximum(type: ScalarType) -> string:
    if type.bits == 64:
        return "9223372036854775807" if type.signed else "18446744073709551615"
    return string((1 << (int(type.bits) - (1 if type.signed else 0))) - 1)
