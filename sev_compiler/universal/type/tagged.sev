import diagnostics
import source
import universal


class VariantSelection:
    record: int = -1
    variant: int = -1


# Tagged types use the same tagged aggregate storage as declared outcomes. Their
# nominal type stays distinct, so success propagation does not unwrap them.
def layouts(records: list[universal.RecordDeclaration]) -> unit | diagnostics.Diagnostic:
    count = len(records)
    cursor := 0
    while cursor < count:
        record := records[cursor]
        if record.representation == "TaggedAggregate":
            fields = [universal.FunctionParameter("$tag", universal.named_type("int", [], record.span), absent, record.span)]
            names: list[string] = []
            index := 0
            for variant in record.alternatives:
                if variant.name in names:
                    return error(diagnostics.diagnostic_at("E000206", "duplicate tagged variant " + variant.name, variant.span))
                names.append(variant.name)
                payload_name = record.name + "." + variant.name
                payload = universal.RecordDeclaration(payload_name, variant.fields, [], variant.span, type_id=universal.TypeId(u32(1000 + len(records))), lookup=record.lookup)
                records.append(payload)
                fields.append(universal.FunctionParameter("$variant" + string(index), universal.named_type(payload_name, [], variant.span), absent, variant.span))
                index += 1
            for variant in record.alternatives:
                seen: list[string] = []
                for destination in variant.transitions:
                    if destination not in names:
                        return error(diagnostics.diagnostic_at("E000213", "unknown transition destination " + destination, variant.span))
                    if destination in seen:
                        return error(diagnostics.diagnostic_at("E000213", "duplicate transition destination " + destination, variant.span))
                    seen.append(destination)
            record.fields = fields
            records[cursor] = record
        cursor += 1


def select(records: list[universal.RecordDeclaration], namespace: string, path: string, expected: universal.TypeId, span: source.Span) -> VariantSelection | diagnostics.Diagnostic:
    result := VariantSelection()
    ordinal := 0
    for record in records:
        if expected.index != 0 and expected.index != record.type_id.index:
            ordinal += 1
            continue
        index := 0
        for variant in record.alternatives:
            qualified = record.name + "." + variant.name
            visible = record.name == namespace + record.name.split(".")[-1] or record.lookup == ""
            if path == qualified or namespace + path == qualified or (path == variant.name and visible):
                if result.record != -1:
                    return error(diagnostics.diagnostic_at("E000206", "ambiguous tagged variant " + path, span))
                result = VariantSelection(ordinal, index)
            index += 1
        ordinal += 1
    return result


def path(expression: universal.Expression) -> string:
    match expression.kind:
        case Name:
            return name
        case Member:
            return path(object) + "." + name
        case _:
            return ""
