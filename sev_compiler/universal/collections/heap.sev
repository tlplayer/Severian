import "../primitive/primitive.sev"
import "list.sev"


'''
# `heap[T]`

`heap` is Severian's binary min-heap.

Type parameters:

```text
T    ordered element type
```

Bootstrap implementation constraint:

```text
T: Ordered + Copy + Default
```

The minimum element is stored at index zero. For node `i`:

```text
parent(i) = (i - 1) // 2
left(i)   = 2*i + 1
right(i)  = 2*i + 2
```

The public contract promises heap ordering, not storage order. Iteration over the
backing array is intentionally not part of the API because heap layout is an
implementation detail.

Complexity target:

```text
peek       O(1)
push       O(log n)
pop        O(log n)
clear      O(n) bootstrap / O(1) logical shape
```

Truth follows logical length through `operator if/else`.
'''


trait Heap[T]:
    Truth

    property length: usize

    def len(self) -> usize
    def push(self, value: T)
    def peek(self) -> (T, bool)
    def pop(self) -> (T, bool)
    def replace(self, value: T) -> (T, bool)
    def push_pop(self, value: T) -> T
    def clear(self)


class heap[T: Ordered + Copy + Default]:
    trait Heap[T]

    __items: list[T]
    length: usize


    def heap():
        __items = list[T]()
        length = 0


    operator if(self) -> self.length != 0
    operator else(self) -> self.length == 0


    def len(self) -> usize:
        return length


    def __parent(index: usize) -> usize:
        return (index - 1) // 2


    def __left(index: usize) -> usize:
        return index * 2 + 1


    def __right(index: usize) -> usize:
        return index * 2 + 2


    def push(self, value: T):
        __items.append(value)
        length += 1
        __sift_up(length - 1)


    def peek(self) -> (T, bool):
        if length == 0:
            return (T.default(), false)

        return (__items[0], true)


    def pop(self) -> (T, bool):
        if length == 0:
            return (T.default(), false)

        minimum := __items[0]
        tail, ok := __items.pop()
        assert(ok)

        length -= 1

        if length != 0:
            __items[0] = tail
            __sift_down(0)

        return (minimum, true)


    def replace(self, value: T) -> (T, bool):
        if length == 0:
            push(value)
            return (T.default(), false)

        minimum := __items[0]
        __items[0] = value
        __sift_down(0)
        return (minimum, true)


    def push_pop(self, value: T) -> T:
        if length == 0:
            return value

        if value <= __items[0]:
            return value

        minimum := __items[0]
        __items[0] = value
        __sift_down(0)
        return minimum


    def __sift_up(self, start: usize):
        index := start

        while index > 0:
            parent := __parent(index)

            if __items[parent] <= __items[index]:
                break

            __items.swap(parent, index)
            index = parent


    def __sift_down(self, start: usize):
        index := start

        while true:
            left := __left(index)

            if left >= length:
                break

            right := __right(index)
            smallest := left

            if right < length and __items[right] < __items[left]:
                smallest = right

            if __items[index] <= __items[smallest]:
                break

            __items.swap(index, smallest)
            index = smallest


    def clear(self):
        __items.clear()
        length = 0


'''
# Executable specification
'''


test "heap returns values in ascending order":
    values := heap[i32]()

    values.push(5)
    values.push(1)
    values.push(4)
    values.push(2)
    values.push(3)

    for expected in range(1, 6):
        value, ok := values.pop()
        assert(ok)
        assert(value == expected)

    assert(values.len() == 0)


test "heap peek does not change shape":
    values := heap[i32]()
    values.push(7)
    values.push(2)
    values.push(9)

    before := values.len()
    value, ok := values.peek()

    assert(ok)
    assert(value == 2)
    assert(values.len() == before)


test "heap replace removes old minimum":
    values := heap[i32]()
    values.push(2)
    values.push(5)
    values.push(8)

    old, had_value := values.replace(6)

    assert(had_value)
    assert(old == 2)

    minimum, ok := values.peek()
    assert(ok)
    assert(minimum == 5)


test "heap push_pop keeps larger value in heap":
    values := heap[i32]()
    values.push(3)
    values.push(5)

    returned := values.push_pop(4)
    assert(returned == 3)

    minimum, ok := values.peek()
    assert(ok)
    assert(minimum == 4)


test with compiler "heap requires an ordered element type":
    reject:
        class Packet:
            id: usize

        values := heap[Packet]()
