import "../primitive/primitive.sev"


'''
# `deque[T]`

`deque` is Severian's runtime-sized double-ended owned sequence.

Type parameters:

```text
T    element type
```

Bootstrap implementation constraint:

```text
T: Copy + Default
```

The representation is a circular typed allocation. Logical index zero is
`__head`; elements wrap around the physical allocation without shifting.

```text
logical:   0   1   2   3
           |   |   |   |
physical: [2] [3] [0] [1]
                   ^
                 head
```

Both ends have amortized O(1) push/pop. Indexed access is O(1).

## Ownership and shape

- the deque owns its allocation;
- a push/pop changes shape and requires exclusive shape access;
- indexed replacement preserves shape;
- `copy()` creates independent storage;
- `drop` releases the allocation exactly once.

## Truth

An empty deque is false and a non-empty deque is true through `operator if/else`.
'''


trait Deque[T]:
    Truth

    property length: usize
    property capacity: usize

    operator [](index: usize) -> T
    operator []=(index: usize, value: T)

    def len(self) -> usize
    def cap(self) -> usize
    def reserve(self, additional: usize)

    def push_front(self, value: T)
    def push_back(self, value: T)
    def pop_front(self) -> (T, bool)
    def pop_back(self) -> (T, bool)
    def front(self) -> (T, bool)
    def back(self) -> (T, bool)

    def clear(self)
    def copy(self) -> deque[T]
    def iter(self) -> Iterator[T]


class deque[T: Copy + Default]:
    trait Deque[T]

    __memory: *[T]
    __head: usize
    length: usize
    capacity: usize


    def deque():
        unsafe:
            __memory = allocate[T](0)

        __head = 0
        length = 0
        capacity = 0


    def deque(initial_capacity: usize):
        unsafe:
            __memory = allocate[T](initial_capacity)

            for index in range(initial_capacity):
                __memory[index] = T.default()

        __head = 0
        length = 0
        capacity = initial_capacity


    operator if(self) -> self.length != 0
    operator else(self) -> self.length == 0


    def len(self) -> usize:
        return length


    def cap(self) -> usize:
        return capacity


    def __physical(self, index: usize) -> usize:
        if capacity == 0:
            return 0

        return (__head + index) % capacity


    operator [](index: usize) -> T:
        if index >= length:
            throw IndexError(
                f"deque index {index} outside [0, {length})"
            )

        physical := __physical(index)

        unsafe:
            return __memory[physical]


    operator []=(index: usize, value: T):
        if index >= length:
            throw IndexError(
                f"deque index {index} outside [0, {length})"
            )

        physical := __physical(index)

        unsafe:
            __memory[physical] = value


    def reserve(self, additional: usize):
        required := length + additional

        if required <= capacity:
            return

        new_capacity := max(usize(4), capacity)

        while new_capacity < required:
            new_capacity *= 2

        unsafe:
            replacement := allocate[T](new_capacity)

            for index in range(length):
                replacement[index] = self[index]

            for index in range(length, new_capacity):
                replacement[index] = T.default()

            free(__memory)

        __memory = move replacement
        __head = 0
        capacity = new_capacity


    def push_front(self, value: T):
        reserve(1)

        if length == 0:
            __head = 0
        else:
            __head = (__head + capacity - 1) % capacity

        unsafe:
            __memory[__head] = value

        length += 1


    def push_back(self, value: T):
        reserve(1)
        physical := __physical(length)

        unsafe:
            __memory[physical] = value

        length += 1


    def front(self) -> (T, bool):
        if length == 0:
            return (T.default(), false)

        return (self[0], true)


    def back(self) -> (T, bool):
        if length == 0:
            return (T.default(), false)

        return (self[length - 1], true)


    def pop_front(self) -> (T, bool):
        if length == 0:
            return (T.default(), false)

        unsafe:
            value := __memory[__head]
            __memory[__head] = T.default()

        __head = (__head + 1) % capacity
        length -= 1

        if length == 0:
            __head = 0

        return (value, true)


    def pop_back(self) -> (T, bool):
        if length == 0:
            return (T.default(), false)

        physical := __physical(length - 1)

        unsafe:
            value := __memory[physical]
            __memory[physical] = T.default()

        length -= 1

        if length == 0:
            __head = 0

        return (value, true)


    def clear(self):
        for index in range(length):
            physical := __physical(index)

            unsafe:
                __memory[physical] = T.default()

        __head = 0
        length = 0


    def copy(self) -> deque[T]:
        result := deque[T](capacity)

        for value in self:
            result.push_back(value)

        return result


    def iter(self) -> Iterator[T]:
        for index in range(length):
            yield self[index]


    def drop():
        unsafe:
            free(__memory)


'''
# Executable specification
'''


test "deque pushes and pops at both ends":
    values := deque[i32]()

    values.push_back(20)
    values.push_front(10)
    values.push_back(30)

    assert(values.len() == 3)
    assert(values[0] == 10)
    assert(values[1] == 20)
    assert(values[2] == 30)

    first, ok := values.pop_front()
    assert(ok)
    assert(first == 10)

    last, ok := values.pop_back()
    assert(ok)
    assert(last == 30)

    remaining, ok := values.front()
    assert(ok)
    assert(remaining == 20)


test "deque wraparound preserves logical order":
    values := deque[i32](4)

    values.push_back(1)
    values.push_back(2)
    values.push_back(3)

    _, ok := values.pop_front()
    assert(ok)
    _, ok := values.pop_front()
    assert(ok)

    values.push_back(4)
    values.push_back(5)
    values.push_front(2)

    assert(values.len() == 4)
    assert(values[0] == 2)
    assert(values[1] == 3)
    assert(values[2] == 4)
    assert(values[3] == 5)


test "deque indexed mutation does not change shape":
    values := deque[i32]()
    values.push_back(1)
    values.push_back(2)

    before := values.len()
    values[1] = 20

    assert(values.len() == before)
    assert(values[1] == 20)


test "deque empty operations return false":
    values := deque[i32]()

    _, front_ok := values.pop_front()
    _, back_ok := values.pop_back()

    assert(not front_ok)
    assert(not back_ok)


test with compiler "deque element type is invariant":
    reject:
        ints := deque[i32]()
        floats: deque[f32] = ints
