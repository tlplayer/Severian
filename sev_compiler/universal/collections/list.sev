import "../primitive/primitive.sev"
import "../primitive/array.sev"
import "../primitive/slice.sev"


'''
# `list[T]`

`list` is Severian's runtime-sized contiguous owned sequence.

Type parameters:

```text
T    element type
```

Bootstrap implementation constraint:

```text
T: Copy + Default
```

The constraint is temporary. The bootstrap memory layer can allocate typed slots
and copy initialized values, but it does not yet expose placement construction and
per-element destruction for arbitrary owned classes. The public `List[T]`
contract does not require `Copy + Default`.

## Representation

```text
list[T]

length = 3
capacity = 4

__memory
   |
   +-------------------+
   | T | T | T | _     |
   +-------------------+
     0   1   2
```

`length` counts initialized elements. `capacity` counts allocated slots.
Capacity grows geometrically and is not part of the value's logical shape.

## Ownership

- the list owns its backing allocation;
- indexing copies `T` in the bootstrap implementation;
- slices borrow the list storage;
- resizing requires exclusive access to the list shape;
- `copy()` creates independent storage;
- `drop` releases the allocation exactly once.

## Truth

```text
[]       -> false
[x, ...] -> true
```

Truth uses `operator if/else`; there is no redundant `is_empty()` API.

## Absence

Operations where absence is ordinary return a value and success bit:

```sev
value, ok := values.pop()
index, found := values.find(needle)
value, ok := values.remove(needle)
```

The bootstrap `Default` constraint supplies the unused value on a false result.
A later placement/destruction-capable implementation can replace these with
`T | None` without changing indexing, ownership, or shape semantics.
'''


trait List[T]:
    Truth

    property length: usize
    property capacity: usize

    operator [](index: usize) -> T
    operator []=(index: usize, value: T)
    operator [](range: Range[usize]) -> slice[T]

    def len(self) -> usize
    def cap(self) -> usize

    def reserve(self, additional: usize)
    def append(self, value: T)
    def extend(self, values: slice[T])
    def insert(self, index: usize, value: T)

    def pop(self) -> (T, bool)
    def pop(self, index: usize) -> (T, bool)
    def find(self, value: T) -> (usize, bool)
    def remove(self, value: T) -> (T, bool)

    def swap(self, left: usize, right: usize)
    def truncate(self, length: usize)
    def reverse(self)
    def clear(self)
    def copy(self) -> list[T]
    def iter(self) -> Iterator[T]


class list[T: Copy + Default]:
    trait List[T]

    __memory: *[T]
    length: usize
    capacity: usize


    def list():
        unsafe:
            __memory = allocate[T](0)

        length = 0
        capacity = 0


    def list[N: usize](values: array[T, N]):
        requested := max(usize(4), N)

        unsafe:
            __memory = allocate[T](requested)

            for index in range(N):
                __memory[index] = values[index]

            for index in range(N, requested):
                __memory[index] = T.default()

        length = N
        capacity = requested


    def list(values: slice[T]):
        requested := max(usize(4), values.len())

        unsafe:
            __memory = allocate[T](requested)

            for index in range(values.len()):
                __memory[index] = values[index]

            for index in range(values.len(), requested):
                __memory[index] = T.default()

        length = values.len()
        capacity = requested


    operator if(self) -> self.length != 0
    operator else(self) -> self.length == 0


    operator [](index: usize) -> T:
        if index >= length:
            throw IndexError(
                f"list index {index} outside [0, {length})"
            )

        unsafe:
            return __memory[index]


    operator []=(index: usize, value: T):
        if index >= length:
            throw IndexError(
                f"list index {index} outside [0, {length})"
            )

        unsafe:
            __memory[index] = value


    operator [](range: Range[usize]) -> slice[T]:
        start := range.start
        end := range.end

        if start > end:
            throw IndexError(
                f"slice start {start} exceeds end {end}"
            )

        if end > length:
            throw IndexError(
                f"slice end {end} exceeds list length {length}"
            )

        return slice[T](
            borrow __memory,
            start,
            end - start,
        )


    def len(self) -> usize:
        return length


    def cap(self) -> usize:
        return capacity


    def reserve(self, additional: usize):
        required := length + additional

        if required <= capacity:
            return

        new_capacity := max(usize(4), capacity)

        while new_capacity < required:
            new_capacity *= 2

        __grow(new_capacity)


    def __grow(self, new_capacity: usize):
        if new_capacity <= capacity:
            return

        unsafe:
            replacement := allocate[T](new_capacity)

            for index in range(length):
                replacement[index] = __memory[index]

            for index in range(length, new_capacity):
                replacement[index] = T.default()

            free(__memory)

        __memory = move replacement
        capacity = new_capacity


    def append(self, value: T):
        reserve(1)

        unsafe:
            __memory[length] = value

        length += 1


    def extend(self, values: slice[T]):
        incoming := values.len()

        if incoming == 0:
            return

        reserve(incoming)

        for index in range(incoming):
            unsafe:
                __memory[length + index] = values[index]

        length += incoming


    def insert(self, index: usize, value: T):
        if index > length:
            throw IndexError(
                f"list insert index {index} outside [0, {length}]"
            )

        reserve(1)
        cursor := length

        while cursor > index:
            unsafe:
                __memory[cursor] = __memory[cursor - 1]

            cursor -= 1

        unsafe:
            __memory[index] = value

        length += 1


    def pop(self) -> (T, bool):
        if length == 0:
            return (T.default(), false)

        return pop(length - 1)


    def pop(self, index: usize) -> (T, bool):
        if index >= length:
            return (T.default(), false)

        unsafe:
            value := __memory[index]

        cursor := index

        while cursor + 1 < length:
            unsafe:
                __memory[cursor] = __memory[cursor + 1]

            cursor += 1

        length -= 1

        unsafe:
            __memory[length] = T.default()

        return (value, true)


    def find(self, value: T) -> (usize, bool):
        for index in range(length):
            if self[index] == value:
                return (index, true)

        return (0, false)


    def remove(self, value: T) -> (T, bool):
        index, found := find(value)

        if not found:
            return (T.default(), false)

        return pop(index)


    def swap(self, left: usize, right: usize):
        if left >= length or right >= length:
            throw IndexError("list swap index outside logical length")

        if left == right:
            return

        value := self[left]
        self[left] = self[right]
        self[right] = value


    def truncate(self, new_length: usize):
        if new_length >= length:
            return

        for index in range(new_length, length):
            unsafe:
                __memory[index] = T.default()

        length = new_length


    def reverse(self):
        if length < 2:
            return

        left := usize(0)
        right := length - 1

        while left < right:
            swap(left, right)
            left += 1
            right -= 1


    def clear(self):
        truncate(0)


    def copy(self) -> list[T]:
        result := list[T]()
        result.reserve(length)

        for index in range(length):
            result.append(self[index])

        return result


    def iter(self) -> Iterator[T]:
        for index in range(length):
            yield self[index]


    def drop():
        unsafe:
            free(__memory)


'''
# Executable specification
'''


test "list exposes logical length and capacity separately":
    values := list[i32]()

    assert(values.len() == 0)
    assert(values.cap() == 0)

    values.reserve(8)

    assert(values.len() == 0)
    assert(values.cap() >= 8)


test "list append insert pop and remove preserve order":
    values := list[i32](array[i32, 3]([10, 30, 40]))

    values.insert(1, 20)
    assert(values.len() == 4)
    assert(values[0] == 10)
    assert(values[1] == 20)
    assert(values[2] == 30)
    assert(values[3] == 40)

    popped, ok := values.pop(1)
    assert(ok)
    assert(popped == 20)
    assert(values[1] == 30)

    removed, ok := values.remove(30)
    assert(ok)
    assert(removed == 30)
    assert(values.len() == 2)


test "list truth follows logical length":
    empty := list[i32]()
    full := list[i32](array[i32, 1]([1]))

    if empty:
        throw Error("empty list must be false")

    if full:
        pass
    else:
        throw Error("non-empty list must be true")


test "list slice borrows initialized storage":
    values := list[i32](array[i32, 4]([10, 20, 30, 40]))
    middle := values[1:3]

    assert(middle.len() == 2)
    assert(middle[0] == 20)
    assert(middle[1] == 30)


test "list reverse and truncate change only logical shape":
    values := list[i32](array[i32, 4]([1, 2, 3, 4]))
    before := values.cap()

    values.reverse()
    assert(values[0] == 4)
    assert(values[3] == 1)

    values.truncate(2)
    assert(values.len() == 2)
    assert(values.cap() == before)


test with compiler "list cannot resize through a live slice":
    reject:
        values := list[i32](array[i32, 4]([1, 2, 3, 4]))
        borrowed := values[1:3]
        values.append(5)
        assert(borrowed[0] == 2)


test with compiler "bootstrap list requires copy default elements":
    reject:
        class Resource:
            handle: usize

            def drop():
                release(handle)

        values := list[Resource]()
