import diagnostics
import "block.sev"
import "branch.sev"
import "lazy.sev"
import "effects.sev"
import "control_flow.sev" as control_flow
import source
import "../operation/operation.sev"
import "../id/compiler.sev"
import "../literal/value.sev"
import "../operator/kind.sev"
import "../type/expression_conversion.sev"
import "../source/assertion_origin.sev"


class LocalDecl:
    id: LocalId
    type_id: TypeId
    mutable: bool
    argument: bool


enum Projection:
    Field(index: u32)
    Index(local: LocalId)
    Dereference
    Downcast(variant: u32)


class Place:
    local: LocalId
    projection: list[Projection]


def local_place(local: LocalId) -> Place:
    return Place(local, [])


enum Operand:
    Copy(place: Place)
    Move(place: Place)
    Constant(value: LiteralValue, type_id: TypeId)
    Function(definition: DefId)


enum Callee:
    Direct(function: DefId, substitution: Substitution)
    FunctionValue(operand: Operand)
    Method(implementation: DefId, receiver: Operand, substitution: Substitution)
    Constructor(type_definition: DefId, variant: VariantId | None)
    Intrinsic(operation: OpId)


enum Rvalue:
    Use(operand: Operand)
    Unary(operator: UnaryOperator, operand: Operand)
    Binary(operator: BinaryOperator, left: Operand, right: Operand)
    BorrowShared(place: Place)
    BorrowExclusive(place: Place)
    Convert(operand: Operand, conversion: ExpressionConversion)
    Aggregate(type_id: TypeId, fields: list[Operand])


enum CfgStatement:
    Assign(place: Place, value: Rvalue)
    Drop(place: Place)
    StorageLive(local: LocalId)
    StorageDead(local: LocalId)
    Assert(condition: Operand, message: Operand | None)
    Coverage(point: CoveragePoint)
    Operation(id: OpId, operands: list[Operand], results: list[Place], attributes: map[AttributeId, AttrValue])


enum SwitchCase:
    Integer(value: i128)
    Boolean(value: bool)
    Variant(index: u32)
    Type(type_id: TypeId)


enum Terminator:
    Goto(target: BlockId, arguments: list[Operand])
    Branch(condition: Operand, then_block: BlockId, else_block: BlockId)
    Switch(discriminant: Operand, targets: list[tuple[SwitchCase, BlockId]], fallback: BlockId)
    Call(callee: Callee, arguments: list[Operand], destination: Place | None, target: BlockId, unwind: BlockId | None)
    Return(value: Operand | None)
    Throw(value: Operand)
    Unreachable


class CfgBody:
    entry: int
    blocks: list[BasicBlock]
    return_type: TypeId


def empty_cfg(return_type: TypeId) -> CfgBody:
    return CfgBody(0, [BasicBlock(0)], return_type)


# Compiler-owned state. Source semantic execution receives a checked capability,
# never an ordinary runtime value or a callable that can capture this object.
class ExecutionContext:
    body: CfgBody
    cursor: list[int] = [0]


def block(context: ExecutionContext) -> int:
    index = int(len(context.body.blocks))
    context.body.blocks.append(BasicBlock(index))
    return index


def at(context: ExecutionContext, target: int):
    if target < 0 or target >= len(context.body.blocks):
        throw Error("invalid CFG block handle")
    context.cursor[0] = target


def open(context: ExecutionContext) -> bool:
    return context.body.blocks[context.cursor[0]].terminator == None


def append(context: ExecutionContext, operation: Operation) -> bool | diagnostics.Diagnostic:
    terminated ?= context.body.blocks[context.cursor[0]].terminator
    if terminated != None:
        return error(diagnostics.Diagnostic("E000230", "instruction after CFG terminator", terminated.span))
    context.body.blocks[context.cursor[0]].operations.append(operation)
    return true


def terminate(context: ExecutionContext, exit: CfgExit, origin: CfgTerminator) -> bool | diagnostics.Diagnostic:
    if not open(context):
        return error(diagnostics.Diagnostic("E000230", "CFG block already terminated: second terminator", origin.span))
    selected = context.body.blocks[context.cursor[0]]
    selected.terminator = CfgTerminator(exit, origin.grammar, origin.span)
    context.body.blocks[context.cursor[0]] = selected
    return true


def fallthrough(context: ExecutionContext, target: int, origin: CfgTerminator):
    if open(context):
        terminate(context, CfgExit.Jump(CfgEdge(target)), origin)
