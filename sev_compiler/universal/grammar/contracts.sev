trait Error:
    pass


trait Is: G:
    symbol: Y = is
    fixity: Fixity = Fixity.Infix
    precedence: int = 3
    associativity: Associativity = None


trait Throw: G:
    control_flow: ControlFlow = Error

    def semantic(value: Ex):
        result = lower(value)
        cfg.throw(result)


trait Outcome: G:
    control_flow: ControlFlow = Error

    def semantic(value: Ex):
        result = lower(value)
        valid = outcome.success(result)
        taken = cfg.block()
        failed = cfg.block()
        cfg.branch(valid, taken, failed)
        cfg.at(failed)
        cfg.throw(result)
        cfg.at(taken)
        payload = outcome.payload(result)
        return payload


trait List: G:
    construction: string = "list_create"


trait Index: G:
    access: string = "element_at"
    storage: string = "element_set"


trait Slice: G:
    access: string = "slice_at"


trait Iteration: G:
    start: string = "iteration_start"
    condition: string = "iteration_more"
    access: string = "element_at"
    advance: string = "iteration_next"


trait For: G:
    control_flow: ControlFlow = Loop

    def semantic(condition: Ex, body: B, advance: B):
        header = cfg.block()
        execute = cfg.block()
        step = cfg.block()
        exit = cfg.block()
        cfg.goto(header)
        cfg.at(header)
        value = lower(condition)
        cfg.branch(value, execute, exit)
        cfg.begin_loop(step, exit)
        cfg.at(execute)
        lower(body)
        cfg.fallthrough(step)
        cfg.at(step)
        lower(advance)
        cfg.fallthrough(header)
        cfg.end_loop()
        cfg.at(exit)
