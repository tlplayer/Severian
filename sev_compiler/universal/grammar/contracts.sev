    associativity: Associativity = None
    operations: {T: ScalarOperation} = {
        i8 | i16 | i32 | int | u8 | u16 | u32 | u64 | index | bool: ScalarOperation("cmpi", predicate=0),
        float: ScalarOperation("cmpf", predicate=1),
