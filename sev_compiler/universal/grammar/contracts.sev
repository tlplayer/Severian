trait Contains: G:
    symbol: Y = in
    fixity: Fixity = Fixity.Infix
    precedence: int = 3
    associativity: Associativity = None


trait LogicalAnd: G:
    symbol: Y = and
    fixity: Fixity = Fixity.Infix
    precedence: int = 2
    associativity: Associativity = Left
    right: Operand = Lazy[bool]
    short_circuit: bool = true

    def semantic(left: bool, right: bool) -> bool:
        return right if left else false


trait LogicalOr: G:
    symbol: Y = or
    fixity: Fixity = Fixity.Infix
    precedence: int = 1
    associativity: Associativity = Left
    right: Operand = Lazy[bool]
    short_circuit: bool = true

    def semantic(left: bool, right: bool) -> bool:
        return true if left else right


trait If: G:
    symbol: Y = if
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    control_flow: ControlFlow = Branch

    def semantic(condition: Ex, then_body: B, else_body: B):
        value = lower(condition)
        taken = cfg.block()
        otherwise = cfg.block()
        exit = cfg.block()
        cfg.branch(value, taken, otherwise)
        cfg.at(taken)
        lower(then_body)
        cfg.fallthrough(exit)
        cfg.at(otherwise)
        lower(else_body)
        cfg.fallthrough(exit)
        cfg.at(exit)


trait While: G:
    symbol: Y = while
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    control_flow: ControlFlow = Loop

    def semantic(condition: Ex, body: B):
        header = cfg.block()
        execute = cfg.block()
        exit = cfg.block()
        cfg.goto(header)
        cfg.at(header)
        value = lower(condition)
        cfg.branch(value, execute, exit)
        cfg.begin_loop(header, exit)
        cfg.at(execute)
        lower(body)
        cfg.fallthrough(header)
        cfg.end_loop()
        cfg.at(exit)


trait Break: G:
    control_flow: ControlFlow = Branch

    def semantic():
        exit = cfg.loop_exit()
        cfg.goto(exit)


trait Continue: G:
    control_flow: ControlFlow = Branch

    def semantic():
        header = cfg.loop_header()
        cfg.goto(header)


trait Return: G:
    control_flow: ControlFlow = Return

    def semantic(value: Ex | absent):
        result = lower(value)
        cfg.return(result)


trait Conditional: G:
    control_flow: ControlFlow = Branch

    def semantic(condition: Ex, then_value: Ex, else_value: Ex) -> X:
        value = lower(condition)
        taken = cfg.block()
        otherwise = cfg.block()
        exit = cfg.block()
        cfg.branch(value, taken, otherwise)
        cfg.at(taken)
        selected = lower(then_value)
        result = cfg.parameter(exit, selected)
        cfg.goto(exit, selected)
        cfg.at(otherwise)
        alternative = lower(else_value)
        cfg.goto(exit, alternative)
        cfg.at(exit)
        return result


trait Assign: G:
    control_flow: ControlFlow = Mutation

    def semantic(destination: Ex, value: Ex):
        target = place(destination)
        right = lower(value)
        store(target, right)


trait AddAssign: G:
    symbol: Y = +=
    form: GrammarForm = GrammarForm.Assignment
    operation: string = "+"
    control_flow: ControlFlow = Mutation

    def semantic(destination: Ex, value: Ex, update: Ex):
        target = place(destination)
        previous = load(target)
        right = lower(value)
        updated = apply(update, previous, right)
        store(target, updated)


trait SubtractAssign: G:
    symbol: Y = -=
    form: GrammarForm = GrammarForm.Assignment
    operation: string = "-"
    control_flow: ControlFlow = Mutation

    def semantic(destination: Ex, value: Ex, update: Ex):
        target = place(destination)
        previous = load(target)
        right = lower(value)
        updated = apply(update, previous, right)
        store(target, updated)


