# Source grammar contracts loaded into the shared declaration environment.
trait G:
    symbol: Y
    arity: int | absent
    precedence: int | absent
    associativity: Associativity | absent
    left: Operand | absent
    right: Operand | absent
    result: T | absent
    evaluation: Evaluation
    effects: Effects
    conversions: Conversions
    overflow: Overflow | absent
    underflow: Underflow | absent
    control_flow: ControlFlow | absent
    short_circuit: bool | absent
    const: bool
    foldable: bool
    operations: {T: ScalarOperation}

    def valid(left: Ex, right: Ex) -> bool
    def semantic(left: Ex, right: Ex) -> X


trait Positive: G:
    symbol: Y = +
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    associativity: Associativity = Right
    operations: {T: ScalarOperation} = {
        i8 | i16 | i32 | int | u8 | u16 | u32 | u64 | index: ScalarOperation("addi"),
        float: ScalarOperation("addf"),
    }


trait Negative: G:
    symbol: Y = -
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    associativity: Associativity = Right
    operations: {T: ScalarOperation} = {
        i8 | i16 | i32 | int | u8 | u16 | u32 | u64 | index: ScalarOperation("subi"),
        float: ScalarOperation("negf", direct=true),
    }


trait Not: G:
    symbol: Y = not
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    associativity: Associativity = Right
    operations: {T: ScalarOperation} = {
        bool: ScalarOperation("xori", identity=1),
    }


trait Bang: G:
    symbol: Y = !
    fixity: Fixity = Fixity.Prefix
    precedence: int = 10
    associativity: Associativity = Right
    operations: {T: ScalarOperation} = {
        bool: ScalarOperation("xori", identity=1),
    }


