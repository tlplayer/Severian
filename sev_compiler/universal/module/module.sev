import source
import * from "../id/compiler.sev"
import * from "../declaration/language.sev"
import * from "../declaration/function.sev"
import * from "../expression/expression.sev"
import * from "../statement/statement.sev"
import * from "../cfg/cfg.sev"
import * from "../value/lowered.sev"
import * from "../grammar/grammar.sev"


enum Item:
    Import(declaration: ImportDeclaration)
    Trait(declaration: TraitDeclaration)
    BindingItem(binding: Binding)
    ExpressionItem(expression: Expression)
    Function(declaration: FunctionDeclaration)
    Type(declaration: TypeDeclaration)
    Record(declaration: RecordDeclaration)
    Test(declaration: TestDeclaration)
    OperatorItem(declaration: OperatorDeclaration)
    GrammarItem(declaration: GrammarDeclaration)


class Module:
    items: list[Item]
    id: ModuleId = ModuleId(0)
    package: PackageId = PackageId(0)
    path: string = ""
    source_file: source.SourceFile | None = None
    resolved_imports: list[ModuleId] = []
    bindings: list[Binding] = []
    initializer: Block = Block([], [], [])
    # Preserve the seed record ABI; executable initializers occupy cfg_bodies[0].
    initializer_cfg: CfgBody | None = None
    cfg_bodies: list[CfgBody] = []
    functions: list[FunctionDeclaration] = []
    generic_functions: list[FunctionDeclaration] = []
    entry: FunctionId | None = None
    tests: list[TestDeclaration] = []
    types: list[TypeDeclaration] = []
    values: list[Value] = []
    globals: list[ValueId] = []
    records: list[RecordDeclaration] = []
    traits: list[TraitDeclaration] = []
    binding_values: list[tuple[BindingId, ValueId]] = []
    grammars: list[GrammarDeclaration] = []


class Program:
    modules: list[Module]


def empty_module() -> Module:
    return Module([])


def empty_program() -> Program:
    return Program([])
