class DeclarationId:
    value: u128


class PrimitiveId:
    declaration: DeclarationId


class CompilerId:
    declaration: DeclarationId


class TypeId:
    index: u32


class GenericParamId:
    index: u32


class InferVarId:
    index: u32


class RegionId:
    index: u32


class DefId:
    package: u128
    module: u128
    declaration: DeclarationId


class InstanceId:
    definition: DefId
    substitution: list[TypeId]


def stable_hash(value: string) -> u128:
    # FNV-1a is part of the compiler interface. Do not replace it with a
    # process-random hash: declaration and operation identities are persisted.
    result := u128(144066263297769815596495629667062367629)
    prime: u128 = 309485009821345068724781371
    for byte in value.bytes():
        result = (result ^ u128(byte)) * prime
    return result


def declaration_id_from_path(path: string) -> DeclarationId:
    return DeclarationId(stable_hash(path))


def declaration_id(value: u128) -> DeclarationId:
    return DeclarationId(value)


def primitive_id(declaration: DeclarationId) -> PrimitiveId:
    return PrimitiveId(declaration)


def compiler_id(declaration: DeclarationId) -> CompilerId:
    return CompilerId(declaration)


def type_id(index: u32) -> TypeId:
    return TypeId(index)


def compiler_declaration(id: CompilerId) -> DeclarationId:
    return id.declaration


test "declaration identity depends on canonical path":
    before = declaration_id_from_path("core.primitives.i32")
    unrelated = declaration_id_from_path("core.primitives.f128")
    after = declaration_id_from_path("core.primitives.i32")
    assert(before == after)
    assert(before != unrelated)


test "identifier wrappers preserve their underlying identity":
    declaration = declaration_id_from_path("compiler.frontend.semantic")
    assert(primitive_id(declaration).declaration == declaration)
    assert(compiler_declaration(compiler_id(declaration)) == declaration)
    assert(type_id(7).index == 7)
