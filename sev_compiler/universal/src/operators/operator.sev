import "ids.sev"
import "literal.sev"

enum UnaryOperator:
    Positive
    Negative
    Not


enum BinaryOperator:
    BitwiseOr
    BitwiseAnd
    BitwiseXor
    Add
    Subtract
    Multiply
    Divide
    Remainder
    Power
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    Contains
    And
    Or


enum TypePattern:
    Exact(type_id: TypeId)
    SameAsLeft
    SameAsRight


enum TypeConstraint:
    Known(type_id: TypeId)
    Literal(kind: LiteralKind)


class OperatorSignature:
    kind: BinaryOperator
    left: TypePattern
    right: TypePattern
    result: TypePattern
