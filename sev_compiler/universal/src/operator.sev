import "ids.sev"
import "literal.sev"

enum UnaryOperator:
    Positive
    Negative
    Not


enum BinaryOperator:
    Add
    Subtract
    Multiply
    Divide
    Remainder
    Power
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    Contains
    And
    Or


enum TypePattern:
    Exact(type_id: TypeId)
    SameAsLeft
    SameAsRight


enum TypeConstraint:
    Known(type_id: TypeId)
    Literal(kind: LiteralKind)


class OperatorSignature:
    operator: BinaryOperator
    left: TypePattern
    right: TypePattern
    result: TypePattern


def unary_operator(spelling: string) -> UnaryOperator | None:
    if spelling == "+": return Positive
    if spelling == "-": return Negative
    if spelling == "not": return Not
    return None


def binary_operator(spelling: string) -> BinaryOperator | None:
    if spelling == "+": return Add
    if spelling == "-": return Subtract
    if spelling == "*": return Multiply
    if spelling == "/": return Divide
    if spelling == "%": return Remainder
    if spelling == "**": return Power
    if spelling == "==": return Equal
    if spelling == "!=": return NotEqual
    if spelling == "<": return Less
    if spelling == "<=": return LessEqual
    if spelling == ">": return Greater
    if spelling == ">=": return GreaterEqual
    if spelling == "in": return Contains
    if spelling == "and": return And
    if spelling == "or": return Or
    return None


def operator_spelling(operator: BinaryOperator) -> string:
    match operator:
        case Add: return "+"
        case Subtract: return "-"
        case Multiply: return "*"
        case Divide: return "/"
        case Remainder: return "%"
        case Power: return "**"
        case Equal: return "=="
        case NotEqual: return "!="
        case Less: return "<"
        case LessEqual: return "<="
        case Greater: return ">"
        case GreaterEqual: return ">="
        case Contains: return "in"
        case And: return "and"
        case Or: return "or"

