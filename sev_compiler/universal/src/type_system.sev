import "ids.sev"
import source

class Substitution:
    # Store wrapper payloads so bootstrap maps use native integer storage.
    arguments: map[int, int]

    def get(parameter: GenericParamId) -> TypeId | None:
        known = arguments.get(int(parameter.index), -1)
        if known < 0:
            return None
        return TypeId(u32(known))

    def values() -> list[int]:
        return arguments.values()


class Signature:
    parameters: list[TypeId]
    result: TypeId


enum TypeKind:
    Primitive(id: PrimitiveId)
    Nominal(definition: DefId, substitution: Substitution)
    Parameter(parameter: GenericParamId)
    Infer(variable: InferVarId)
    Function(signature: Signature)
    Tuple(elements: list[TypeId])
    Union(members: list[TypeId])
    Reference(target: TypeId, mutable: bool, lifetime: RegionId)
    Resource(definition: DefId, substitution: Substitution)


def intern_ty_kind(kinds: borrow mut list[TypeKind], kind: move TypeKind) -> TypeId:
    index := u32(0)
    for known in kinds:
        if known == kind:
            return TypeId(index)
        index += 1
    kinds.append(move kind)
    return TypeId(u32(len(kinds) - 1))


class TyInterner:
    kinds: list[TypeKind]
    next_infer: u32

    def TyInterner():
        kinds = []
        next_infer = 0

    def intern(kind: TypeKind) -> TypeId:
        return intern_ty_kind(borrow mut kinds, move kind)

    def kind(id: TypeId) -> TypeKind | None:
        if id.index >= len(kinds):
            return None
        return kinds[id.index]

    def fresh_infer() -> TypeId:
        variable = InferVarId(next_infer)
        next_infer += 1
        candidate: TypeKind = Infer(variable)
        index := u32(0)
        for known in kinds:
            if known == candidate:
                return TypeId(index)
            index += 1
        kinds.append(candidate)
        return TypeId(u32(len(kinds) - 1))

    def parameter(parameter: GenericParamId) -> TypeId:
        candidate: TypeKind = Parameter(parameter)
        index := u32(0)
        for known in kinds:
            if known == candidate:
                return TypeId(index)
            index += 1
        kinds.append(candidate)
        return TypeId(u32(len(kinds) - 1))

    def substitute(type_id: TypeId, replacements: Substitution) -> TypeId:
        known = kind(type_id)
        match known:
            case Parameter:
                replacement = replacements.get(parameter)
                return replacement if replacement != None else type_id
            case Nominal:
                known_arguments = substitution
                arguments: map[int, int] = {}
                for parameter, argument in known_arguments.arguments:
                    arguments[parameter] = int(substitute(TypeId(u32(argument)), replacements).index)
                candidate: TypeKind = Nominal(definition, Substitution(arguments))
                index := u32(0)
                for existing in kinds:
                    if existing == candidate:
                        return TypeId(index)
                    index += 1
                kinds.append(candidate)
                return TypeId(u32(len(kinds) - 1))
            case Resource:
                known_arguments = substitution
                arguments: map[int, int] = {}
                for parameter, argument in known_arguments.arguments:
                    arguments[parameter] = int(substitute(TypeId(u32(argument)), replacements).index)
                candidate: TypeKind = Resource(definition, Substitution(arguments))
                index := u32(0)
                for existing in kinds:
                    if existing == candidate:
                        return TypeId(index)
                    index += 1
                kinds.append(candidate)
                return TypeId(u32(len(kinds) - 1))
            case Function:
                replaced_parameters: list[TypeId] = []
                for parameter in signature.parameters:
                    replaced_parameters.append(substitute(parameter, replacements))
                candidate: TypeKind = Function(Signature(replaced_parameters, substitute(signature.result, replacements)))
                index := u32(0)
                for existing in kinds:
                    if existing == candidate:
                        return TypeId(index)
                    index += 1
                kinds.append(candidate)
                return TypeId(u32(len(kinds) - 1))
            case Tuple:
                known_elements = elements
                replaced_elements: list[TypeId] = []
                for element in known_elements:
                    replaced_elements.append(substitute(element, replacements))
                candidate: TypeKind = Tuple(replaced_elements)
                index := u32(0)
                for existing in kinds:
                    if existing == candidate:
                        return TypeId(index)
                    index += 1
                kinds.append(candidate)
                return TypeId(u32(len(kinds) - 1))
            case Union:
                known_members = members
                replaced_members: list[TypeId] = []
                for member in known_members:
                    replaced_members.append(substitute(member, replacements))
                return union(replaced_members)
            case Reference:
                candidate: TypeKind = Reference(substitute(target, replacements), mutable, lifetime)
                index := u32(0)
                for existing in kinds:
                    if existing == candidate:
                        return TypeId(index)
                    index += 1
                kinds.append(candidate)
                return TypeId(u32(len(kinds) - 1))
            case _:
                return type_id

    def union(members: list[TypeId]) -> TypeId:
        canonical: list[TypeId] = []
        for member in members:
            known = kind(member)
            match known:
                case Union:
                    nested_members = members
                    for nested_member in nested_members:
                        if not canonical.contains(nested_member):
                            canonical.append(nested_member)
                case _:
                    if not canonical.contains(member):
                        canonical.append(member)
        canonical = canonical.sorted(|type_id| type_id.index)
        if len(canonical) == 1:
            return canonical[0]
        union_kind: TypeKind = TypeKind.Union(canonical)
        index := u32(0)
        for existing in kinds:
            if existing == union_kind:
                return TypeId(index)
            index += 1
        kinds.append(union_kind)
        return TypeId(u32(len(kinds) - 1))


class TraitRef:
    trait_id: DefId
    self_type: TypeId
    substitution: Substitution


class ConstraintId:
    index: u32


enum ConstraintKind:
    Equal(left: TypeId, right: TypeId)
    Implements(reference: TraitRef)


class Constraint:
    id: ConstraintId
    kind: ConstraintKind
    span: source.Span
    reason: string
    parent: ConstraintId | None


enum CompilerCapability:
    Copy
    Send
    Sync
    FfiSafe(abi: string)
    DeviceSafe


def compiler_capability(name: string) -> CompilerCapability | None:
    if name == "Copy":
        return Copy
    if name == "Send":
        return Send
    if name == "Sync":
        return Sync
    if name == "DeviceSafe":
        return DeviceSafe
    return None


def ffi_safe_capability(abi: string) -> CompilerCapability:
    return FfiSafe(abi)


enum UnifyError:
    Mismatch(left: TypeId, right: TypeId)
    Occurs(variable: InferVarId, type_id: TypeId)
    Unknown(type_id: TypeId)


class InferenceContext:
    bindings: map[InferVarId, TypeId]
    constraints: list[Constraint]
    next_constraint: u32

    def InferenceContext():
        bindings = {}
        constraints = []
        next_constraint = 0

    def resolve(interner: borrow TyInterner, type_id: TypeId) -> TypeId:
        known = interner.kind(type_id)
        match known:
            case Infer:
                bound = bindings.get(variable)
                if bound == None:
                    return type_id
                return resolve(interner, bound)
            case _:
                return type_id

    def constrain_equal(
        interner: borrow TyInterner,
        left: TypeId,
        right: TypeId,
        span: source.Span,
        reason: string,
        parent: ConstraintId | None = None,
    ) -> unit | UnifyError:
        id = ConstraintId(next_constraint)
        next_constraint += 1
        constraints.append(Constraint(id, Equal(left, right), span, reason, parent))
        return unify(interner, left, right)

    def constrain_implements(
        reference: move TraitRef,
        span: source.Span,
        reason: string,
        parent: ConstraintId | None = None,
    ) -> ConstraintId:
        id = ConstraintId(next_constraint)
        next_constraint += 1
        constraints.append(Constraint(id, Implements(reference), span, reason, parent))
        return id

    def unify(interner: borrow TyInterner, left: TypeId, right: TypeId) -> unit | UnifyError:
        left = resolve(interner, left)
        right = resolve(interner, right)
        if left == right:
            return unit
        left_kind = interner.kind(left)
        right_kind = interner.kind(right)
        match left_kind:
            case Infer:
                return bind(interner, variable, right)
        match right_kind:
            case Infer:
                return bind(interner, variable, left)
        return error(Mismatch(left, right))

    def bind(interner: borrow TyInterner, target_variable: InferVarId, type_id: TypeId) -> unit | UnifyError:
        match interner.kind(type_id):
            case Infer:
                if variable == target_variable:
                    return unit
        if occurs(interner, target_variable, type_id):
            return error(Occurs(target_variable, type_id))
        bindings[target_variable] = type_id
        return unit

    def occurs(interner: borrow TyInterner, target_variable: InferVarId, type_id: TypeId) -> bool:
        known = interner.kind(type_id)
        match known:
            case Infer:
                if variable == target_variable:
                    return true
                bound = bindings.get(variable)
                return false if bound == None else occurs(interner, target_variable, bound)
            case Nominal:
                for argument in substitution.values():
                    if occurs(interner, target_variable, TypeId(u32(argument))):
                        return true
            case Resource:
                for argument in substitution.values():
                    if occurs(interner, target_variable, TypeId(u32(argument))):
                        return true
            case Function:
                for parameter in signature.parameters:
                    if occurs(interner, target_variable, parameter):
                        return true
                return occurs(interner, target_variable, signature.result)
            case Tuple:
                for element in elements:
                    if occurs(interner, target_variable, element):
                        return true
            case Union:
                for member in members:
                    if occurs(interner, target_variable, member):
                        return true
            case Reference:
                return occurs(interner, target_variable, target)
        return false


class ImplId:
    index: u32


class ImplDefinition:
    id: ImplId
    defining_package: u128
    trait_id: DefId
    self_type: TypeId
    substitution: Substitution


def register_impl(
    implementations: borrow mut list[ImplDefinition],
    interner: borrow TyInterner,
    defining_package: u128,
    trait_id: DefId,
    self_type: TypeId,
    substitution: move Substitution,
) -> ImplId | ImplError:
    match interner.kind(self_type):
        case Nominal:
            if defining_package != trait_id.package and defining_package != definition.package:
                return error(Orphan(defining_package, trait_id.package, definition.package))
            for implementation in implementations:
                if implementation.trait_id == trait_id and substitutions_overlap(interner, implementation.substitution, substitution) and types_overlap(interner, implementation.self_type, self_type):
                    return error(Overlap(implementation.id))
            id = ImplId(u32(len(implementations)))
            implementations.append(ImplDefinition(id, defining_package, trait_id, self_type, move substitution))
            return id
        case Resource:
            if defining_package != trait_id.package and defining_package != definition.package:
                return error(Orphan(defining_package, trait_id.package, definition.package))
            for implementation in implementations:
                if implementation.trait_id == trait_id and substitutions_overlap(interner, implementation.substitution, substitution) and types_overlap(interner, implementation.self_type, self_type):
                    return error(Overlap(implementation.id))
            id = ImplId(u32(len(implementations)))
            implementations.append(ImplDefinition(id, defining_package, trait_id, self_type, move substitution))
            return id
        case _:
            return error(NonNominal(self_type))


enum ImplSelection:
    Selected(id: ImplId)
    Missing
    Ambiguous(candidates: list[ImplId])


enum ImplError:
    Orphan(defining_package: u128, trait_package: u128, type_package: u128)
    Overlap(existing: ImplId)
    NonNominal(type_id: TypeId)


class ImplTable:
    implementations: list[ImplDefinition]

    def ImplTable():
        implementations = []

    def register(
        interner: borrow TyInterner,
        defining_package: u128,
        trait_id: DefId,
        self_type: TypeId,
        substitution: move Substitution,
    ) -> ImplId | ImplError:
        return register_impl(borrow mut implementations, borrow interner, defining_package, trait_id, self_type, move substitution)

    def select(reference: TraitRef) -> ImplSelection:
        matches: list[ImplId] = []
        for implementation in implementations:
            if implementation.trait_id == reference.trait_id and implementation.self_type == reference.self_type and implementation.substitution == reference.substitution:
                matches.append(implementation.id)
        if len(matches) == 0:
            return Missing
        if len(matches) == 1:
            return Selected(matches[0])
        return Ambiguous(matches)


def substitutions_overlap(interner: borrow TyInterner, left: Substitution, right: Substitution) -> bool:
    if len(left.arguments) != len(right.arguments):
        return false
    right_arguments = right.arguments
    for parameter, left_type in left.arguments:
        right_index = right_arguments.get(parameter, -1)
        if right_index < 0:
            return false
        if not types_overlap(interner, TypeId(u32(left_type)), TypeId(u32(right_index))):
            return false
    return true


def types_overlap(interner: borrow TyInterner, left: TypeId, right: TypeId) -> bool:
    if left == right:
        return true
    match interner.kind(left):
        case Parameter:
            return true
        case Infer:
            return true
        case Nominal:
            return nominal_types_overlap(interner, definition, substitution, right)
        case Resource:
            return resource_types_overlap(interner, definition, substitution, right)
        case _:
            match interner.kind(right):
                case Parameter:
                    return true
                case Infer:
                    return true
                case _:
                    return false
    return false


def nominal_types_overlap(
    interner: borrow TyInterner,
    left_definition: DefId,
    left_substitution: Substitution,
    right: TypeId,
) -> bool:
    match interner.kind(right):
        case Nominal:
            return definition == left_definition and substitutions_overlap(interner, left_substitution, substitution)
        case _:
            return false
    return false


def resource_types_overlap(
    interner: borrow TyInterner,
    left_definition: DefId,
    left_substitution: Substitution,
    right: TypeId,
) -> bool:
    match interner.kind(right):
        case Resource:
            return definition == left_definition and substitutions_overlap(interner, left_substitution, substitution)
        case _:
            return false
    return false


test "unions flatten sort and deduplicate":
    types = TyInterner()
    first = types.intern(Nominal(DefId(0, 0, DeclarationId(1)), Substitution({})))
    second = types.intern(Nominal(DefId(0, 0, DeclarationId(2)), Substitution({})))
    nested = types.union([second, first])
    assert(types.union([first, nested, second]) == nested)
    assert(types.union([second, first]) == types.union([first, second]))


test "occurs check rejects recursive inference bindings":
    types = TyInterner()
    variable = types.fresh_infer()
    recursive = types.intern(Nominal(DefId(0, 0, DeclarationId(3)), Substitution({0: int(variable.index)})))
    inference = InferenceContext()
    match types.kind(variable):
        case Infer:
            assert(inference.occurs(borrow types, variable, recursive))
        case _:
            assert(false)


test "constraints retain diagnostic provenance":
    types = TyInterner()
    concrete = types.intern(Nominal(DefId(1, 0, DeclarationId(4)), Substitution({})))
    span = source.Span(source.SourceId(0), 10, 20)
    inference = InferenceContext()
    parent = ConstraintId(0)
    inference.constraints.append(Constraint(parent, Equal(concrete, concrete), span, "required by generic declaration", None))
    inference.constraints.append(Constraint(ConstraintId(1), Equal(concrete, concrete), span, "inferred from call argument", parent))
    assert(len(inference.constraints) == 2)
    assert(inference.constraints[1].span == span)
    assert(inference.constraints[1].parent == parent)
    assert(inference.constraints[1].reason == "inferred from call argument")


test "implementation coherence enforces ownership and rejects overlap":
    types = TyInterner()
    trait_id = DefId(1, 0, DeclarationId(1))
    type_id = types.intern(Nominal(DefId(2, 0, DeclarationId(2)), Substitution({})))
    table = ImplTable()
    match table.register(borrow types, 3, trait_id, type_id, Substitution({})):
        case _id:
            assert(false)
        case error:
            assert(len(table.implementations) == 0)
    first = table.register(borrow types, 2, trait_id, type_id, Substitution({}))
    match table.register(borrow types, 1, trait_id, type_id, Substitution({})):
        case _id:
            assert(false)
        case error:
            assert(len(table.implementations) == 1)
            assert(table.implementations[0].id == first)


test "coherence permits disjoint concrete instances but rejects blanket overlap":
    types = TyInterner()
    trait_id = DefId(1, 0, DeclarationId(10))
    list_definition = DefId(2, 0, DeclarationId(11))
    integer = types.intern(Nominal(DefId(3, 0, DeclarationId(12)), Substitution({})))
    string = types.intern(Nominal(DefId(3, 0, DeclarationId(13)), Substitution({})))
    parameter = types.parameter(GenericParamId(0))
    integer_list = types.intern(Nominal(list_definition, Substitution({0: int(integer.index)})))
    string_list = types.intern(Nominal(list_definition, Substitution({0: int(string.index)})))
    blanket_list = types.intern(Nominal(list_definition, Substitution({0: int(parameter.index)})))
    table = ImplTable()
    table.register(borrow types, 2, trait_id, integer_list, Substitution({}))
    table.register(borrow types, 2, trait_id, string_list, Substitution({}))
    assert(len(table.implementations) == 2)
    match table.register(borrow types, 2, trait_id, blanket_list, Substitution({})):
        case _id:
            assert(false)
        case error:
            assert(len(table.implementations) == 2)
