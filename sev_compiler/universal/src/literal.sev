enum LiteralKind:
    Integer
    Float
    Boolean
    Character
    String
    Bytes
    NoneValue
    Unit


enum LiteralValue:
    IntegerValue(spelling: string)
    FloatValue(spelling: string)
    BooleanValue(value: bool)
    CharacterValue(value: char)
    StringValue(value: string)
    BytesValue(value: list[u8])
    NoneValue
    UnitValue


def literal_kind(value: LiteralValue) -> LiteralKind:
    match value:
        case IntegerValue: return Integer
        case FloatValue: return Float
        case BooleanValue: return Boolean
        case CharacterValue: return Character
        case StringValue: return String
        case BytesValue: return Bytes
        case NoneValue: return LiteralKind.NoneValue
        case UnitValue: return Unit


def literal_spelling(value: LiteralValue) -> string | None:
    match value:
        case IntegerValue: return spelling
        case FloatValue: return spelling
        case StringValue: return value
        else: return None

