import "types/mod.sev"
import "operation_registry.sev"

class UniversalContext:
    types: TypeContext
    operations: OperationRegistry


class UniversalError:
    message: string

    def display() -> string:
        return message


def universal_context(types: TypeContext) -> UniversalContext:
    return UniversalContext(types, OperationRegistry())


test "a universal context owns types and operation interfaces":
    context = universal_context(TypeContext())
    assert(len(context.types.definitions) == 0)
    assert(len(context.operations.interfaces) == 0)
