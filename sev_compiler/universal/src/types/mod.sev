import "../ids.sev"
import "../literal.sev"
import "../operator.sev"
import "../type_system.sev"

enum PrimitiveCategory:
    Boolean
    Character
    Integer
    Float
    Text
    Bytes
    Absence
    Unit
    Arguments


enum IntegerWidth:
    Fixed(bits: u16)
    Machine


enum FloatFormat:
    Ieee(bits: u16)
    BrainFloat16
    Machine


enum PrimitiveRepresentation:
    Integer(bits: IntegerWidth, signed: bool)
    Float(format: FloatFormat)
    PointerInteger(signed: bool)
    Boolean
    Character
    String
    Bytes
    NoneValue
    Unit
    Arguments


class PrimitiveDefinition:
    id: PrimitiveId
    type_id: TypeId
    category: PrimitiveCategory
    representation: PrimitiveRepresentation
    default_literal: bool


enum TypeDefinitionKind:
    Primitive(definition: PrimitiveDefinition)
    Trait
    Applied(constructor: TypeId, arguments: list[TypeId])


class TypeDefinition:
    id: TypeId
    declaration: DeclarationId
    path: string
    name: string
    parameter_count: int
    kind: TypeDefinitionKind


class ResolvedBinary:
    left: TypeId
    right: TypeId
    result: TypeId
    signature: OperatorSignature


class ResolvedUnary:
    operand: TypeId
    result: TypeId


enum TypeError:
    UnknownCategory(value: string)
    UnknownRepresentation(value: string)
    MissingBitWidth
    DuplicateName(name: string)
    UnknownTypeId(type_id: TypeId)
    AlreadyDefined(path: string)
    DuplicateDefault(kind: LiteralKind)
    InvalidDefaultLiteralCategory
    WrongArgumentCount(expected: int, actual: int)
    OperatorNotFound


def primitive_category(value: string) -> PrimitiveCategory | TypeError:
    if value == "boolean":
        return Boolean
    if value == "character":
        return Character
    if value == "integer":
        return Integer
    if value == "float":
        return Float
    if value == "text":
        return Text
    if value == "bytes":
        return Bytes
    if value == "absence":
        return Absence
    if value == "unit":
        return Unit
    if value == "arguments":
        return Arguments
    return error(UnknownCategory(value))


def primitive_representation(value: string, bits: u16 | None, signed: bool) -> PrimitiveRepresentation | TypeError:
    if value == "fixed-integer":
        if bits == None:
            return error(MissingBitWidth)
        return Integer(Fixed(bits), signed)
    if value == "machine-signed":
        return Integer(Machine, true)
    if value == "pointer-integer":
        return PointerInteger(signed)
    if value == "machine-float":
        return Float(FloatFormat.Machine)
    if value == "ieee-float":
        if bits == None:
            return error(MissingBitWidth)
        return Float(Ieee(bits))
    if value == "brain-float" and bits == 16:
        return Float(BrainFloat16)
    if value == "i1":
        return PrimitiveRepresentation.Boolean
    if value == "unicode-scalar":
        return PrimitiveRepresentation.Character
    if value == "string":
        return PrimitiveRepresentation.String
    if value == "byte-string":
        return PrimitiveRepresentation.Bytes
    if value == "none":
        return NoneValue
    if value == "unit":
        return PrimitiveRepresentation.Unit
    if value == "arguments":
        return PrimitiveRepresentation.Arguments
    return error(UnknownRepresentation(value))


class TypeContext:
    interner: TyInterner
    definitions: list[TypeDefinition]
    by_name: map[string, TypeId]
    defaults: map[LiteralKind, TypeId]
    binary: list[OperatorSignature]
    unary: list[tuple[UnaryOperator, TypeId, TypeId]]
    applications: map[string, TypeId]
    compile_routes: map[TypeId, CompilerId]
    capabilities: map[TypeId, set[CompilerCapability]]
    structural_members: map[TypeId, list[TypeId]]

    def TypeContext():
        interner = TyInterner()
        definitions = []
        by_name = {}
        defaults = {}
        binary = []
        unary = []
        applications = {}
        compile_routes = {}
        capabilities = {}
        structural_members = {}

    def register_declaration(path: string, name: string, parameter_count: int = 0) -> TypeId | TypeError:
        if by_name.contains(name):
            return error(DuplicateName(name))
        id = interner.intern(Nominal(DefId(0, 0, DeclarationId(u128(len(definitions) + 1))), Substitution({})))
        definition = TypeDefinition(id, DeclarationId(u128(len(definitions) + 1)), path, name, parameter_count, Trait)
        definitions.append(definition)
        by_name[name] = id
        return id

    def define_primitive(type_id: TypeId, category: PrimitiveCategory, representation: PrimitiveRepresentation, default_literal: bool) -> PrimitiveId | TypeError:
        definition = definition(type_id)
        if definition == None:
            return error(UnknownTypeId(type_id))
        primitive_id = PrimitiveId(definition.declaration)
        primitive = PrimitiveDefinition(primitive_id, type_id, category, representation, default_literal)
        definitions[type_id.index] = TypeDefinition(
            definition.id,
            definition.declaration,
            definition.path,
            definition.name,
            definition.parameter_count,
            Primitive(primitive),
        )
        grant_capability(type_id, Send)
        grant_capability(type_id, Sync)
        if category == Boolean or category == Character or category == Integer or category == Float or category == Absence or category == Unit:
            grant_capability(type_id, Copy)
        if category == Boolean or category == Character or category == Integer or category == Float or category == Unit:
            grant_capability(type_id, FfiSafe("C"))
            grant_capability(type_id, DeviceSafe)
        if default_literal:
            kind: LiteralKind | None = None
            if category == Boolean:
                kind = LiteralKind.Boolean
            if category == Character:
                kind = LiteralKind.Character
            if category == Integer:
                kind = LiteralKind.Integer
            if category == Float:
                kind = LiteralKind.Float
            if category == Text:
                kind = LiteralKind.String
            if category == Bytes:
                kind = LiteralKind.Bytes
            if category == Absence:
                kind = LiteralKind.NoneValue
            if category == Unit:
                kind = LiteralKind.Unit
            if kind != None:
                defaults[kind] = type_id
        return primitive_id

    def resolve_name(name: string) -> TypeId | None:
        return by_name.get(name)

    def definition(id: TypeId) -> TypeDefinition | None:
        if id.index >= len(definitions):
            return None
        return definitions[id.index]

    def kind(id: TypeId) -> TyKind | None:
        return interner.kind(id)

    def fresh_infer() -> TypeId:
        return interner.fresh_infer()

    def intern_type(kind: TyKind) -> TypeId:
        return interner.intern(kind)

    def parameter(id: GenericParamId) -> TypeId:
        return interner.parameter(id)

    def substitute(type_id: TypeId, substitution: Substitution) -> TypeId:
        return interner.substitute(type_id, substitution)

    def union(members: list[TypeId]) -> TypeId:
        return interner.union(members)

    def instantiate(constructor: TypeId, arguments: list[TypeId]) -> TypeId | TypeError:
        definition = definition(constructor)
        if definition == None:
            return error(UnknownTypeId(constructor))
        if definition.parameter_count != len(arguments):
            return error(WrongArgumentCount(definition.parameter_count, len(arguments)))
        key = string(constructor.index) + ":" + string(arguments)
        known = applications.get(key)
        if known != None:
            return known
        parameters: map[int, int] = {}
        index: u32 = 0
        for argument in arguments:
            parameters[int(index)] = int(argument.index)
            index += 1
        id = interner.intern(Nominal(DefId(0, 0, definition.declaration), Substitution(parameters)))
        applications[key] = id
        return id

    def set_compile_route(type_id: TypeId, compiler: CompilerId):
        compile_routes[type_id] = compiler

    def compile_route(type_id: TypeId) -> CompileRoute:
        compiler = compile_routes.get(type_id)
        if compiler == None:
            return Standard
        return Compiler(compiler)

    def add_binary(signature: OperatorSignature):
        if not binary.contains(signature):
            binary.append(signature)

    def add_unary(operator: UnaryOperator, operand: TypeId, result: TypeId):
        candidate = (operator, operand, result)
        if not unary.contains(candidate):
            unary.append(candidate)

    def type_for_literal(value: LiteralValue) -> TypeId | None:
        return defaults.get(literal_kind(value))

    def resolve_unary(operator: UnaryOperator, operand: TypeId) -> ResolvedUnary | TypeError:
        for candidate in unary:
            if candidate[0] == operator and candidate[1] == operand:
                return ResolvedUnary(operand, candidate[2])
        return error(OperatorNotFound)

    def resolve_binary(operator: BinaryOperator, left: TypeId, right: TypeId) -> ResolvedBinary | TypeError:
        for signature in binary:
            if signature.kind != operator:
                continue
            match signature.left:
                case Exact:
                    if type_id != left:
                        continue
                case _:
                    continue
            expected_right = pattern_type(signature.right, left, right)
            if expected_right != right:
                continue
            return ResolvedBinary(left, right, pattern_type(signature.result, left, right), signature)
        return error(OperatorNotFound)

    def supports_binary(operator: BinaryOperator, operand: TypeId) -> bool:
        for signature in binary:
            if signature.kind != operator:
                continue
            match signature.left:
                case Exact:
                    if type_id != operand:
                        continue
                case _:
                    continue
            if pattern_type(signature.right, operand, operand) == operand:
                return true
        return false

    def grant_capability(type_id: TypeId, capability: CompilerCapability):
        if not capabilities.contains(type_id):
            capabilities[type_id] = set()
        capabilities[type_id].add(capability)

    def register_structural_members(type_id: TypeId, members: list[TypeId]):
        structural_members[type_id] = members

    def has_capability(type_id: TypeId, capability: CompilerCapability) -> bool:
        return derive_capability(type_id, capability, set())

    def derive_capability(
        type_id: TypeId,
        capability: CompilerCapability,
        visiting: set[TypeId],
    ) -> bool:
        direct = capabilities.get(type_id)
        if direct != None and direct.contains(capability):
            return true
        if visiting.contains(type_id):
            return false
        next_visiting = visiting.copy()
        next_visiting.add(type_id)
        member_types = structural_members.get(type_id)
        if member_types != None:
            for member in member_types:
                if not derive_capability(member, capability, next_visiting):
                    return false
            return true
        match kind(type_id):
            case Tuple:
                for element in elements:
                    if not derive_capability(element, capability, next_visiting):
                        return false
                return true
            case Union:
                for member in members:
                    if not derive_capability(member, capability, next_visiting):
                        return false
                return true
            case Reference:
                if capability == Copy:
                    return not mutable
                if capability == Send:
                    return derive_capability(target, Send, next_visiting)
                if capability == Sync:
                    return derive_capability(target, Sync, next_visiting)
                return false
            case Resource:
                return false
        return false


def pattern_type(pattern: TypePattern, left: TypeId, right: TypeId) -> TypeId:
    match pattern:
        case Exact:
            return type_id
        case SameAsLeft:
            return left
        case SameAsRight:
            return right


class TypeContextBuilder:
    context: TypeContext

    def TypeContextBuilder():
        context = TypeContext()

    def register_declaration(path: string, name: string) -> TypeId | TypeError:
        return context.register_declaration(path, name)

    def register_generic_declaration(path: string, name: string, parameter_count: int) -> TypeId | TypeError:
        return context.register_declaration(path, name, parameter_count)

    def define_primitive(type_id: TypeId, category: PrimitiveCategory, representation: PrimitiveRepresentation, default_literal: bool) -> PrimitiveId | TypeError:
        return context.define_primitive(type_id, category, representation, default_literal)

    def add_binary(signature: OperatorSignature):
        context.add_binary(signature)

    def add_unary(operator: UnaryOperator, operand: TypeId, result: TypeId):
        context.add_unary(operator, operand, result)

    def grant_capability(type_id: TypeId, capability: CompilerCapability):
        context.grant_capability(type_id, capability)

    def register_structural_members(type_id: TypeId, members: list[TypeId]):
        context.register_structural_members(type_id, members)

    def build() -> TypeContext:
        return context


test "compiler capabilities derive structurally and remain conservative for resources":
    types = TypeContext()
    scalar = types.intern_type(Nominal(DefId(0, 0, DeclarationId(1)), Substitution({})))
    point = types.intern_type(Nominal(DefId(0, 0, DeclarationId(2)), Substitution({})))
    resource = types.intern_type(Resource(DefId(0, 0, DeclarationId(3)), Substitution({})))
    file = types.intern_type(Nominal(DefId(0, 0, DeclarationId(4)), Substitution({})))
    types.grant_capability(scalar, Copy)
    types.grant_capability(scalar, Send)
    types.grant_capability(scalar, FfiSafe("C"))
    types.grant_capability(scalar, DeviceSafe)
    types.register_structural_members(point, [scalar, scalar])
    types.register_structural_members(file, [resource])
    assert(types.has_capability(point, Copy))
    assert(types.has_capability(point, Send))
    assert(types.has_capability(point, FfiSafe("C")))
    assert(types.has_capability(point, DeviceSafe))
    assert(not types.has_capability(file, Copy))
    assert(not types.has_capability(file, Send))
    types.grant_capability(resource, Send)
    assert(types.has_capability(file, Send))
