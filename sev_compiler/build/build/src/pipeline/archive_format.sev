import package

# Compiler-owned envelope: fixed-width big-endian directory entries permit
# consumers to decode a selected section without decoding preceding sections.
# Section 1 describes compatibility; subsequent sections carry compiler data.
def encode_sections(magic: string, sections: list[string]) -> list[u8]:
    bytes: list[u8] = []
    package.append_text(bytes, magic)
    if len(bytes) == 0 or len(bytes) > 8:
        throw Error("compiler metadata magic must fit eight bytes")
    # Magic padding is binary data. A character-to-string conversion may use
    # a NUL-terminated hosted representation and cannot carry this padding.
    for index in range(int(len(bytes)), 8):
        bytes.append(u8(0))
    package.append_number(bytes, 1, 4)
    package.append_number(bytes, int(len(sections)), 4)
    offset := 16 + int(len(sections)) * 20
    for index in range(int(len(sections))):
        size = int(len(sections[index].bytes()))
        package.append_number(bytes, index + 1, 4)
        package.append_number(bytes, offset, 8)
        package.append_number(bytes, size, 8)
        offset += size
    for section in sections:
        package.append_text(bytes, section)
    return bytes


def decode_section(bytes: list[u8], magic: string, selected: int) -> string | Error:
    width = int(len(magic.bytes()))
    if width == 0 or width > 8 or int(len(bytes)) < 16 or package.archive_text(bytes, 0, width) != magic:
        throw Error("invalid compiler metadata magic")
    for index in range(width, 8):
        if bytes[index] != 0:
            throw Error("invalid compiler metadata magic padding")
    if package.number(bytes, 8, 4) != 1:
        throw Error("unsupported compiler metadata version")
    count = package.number(bytes, 12, 4)
    if count > (int(len(bytes)) - 16) / 20:
        throw Error("truncated compiler metadata directory")
    end := 16 + count * 20
    result := ""
    found := false
    for index in range(count):
        cursor = 16 + index * 20
        tag = package.number(bytes, cursor, 4)
        offset = package.number(bytes, cursor + 4, 8)
        size = package.number(bytes, cursor + 12, 8)
        if tag != index + 1 or offset != end or size > int(len(bytes)) - offset:
            throw Error("invalid compiler metadata section bounds")
        end = offset + size
        if tag == selected:
            result = package.archive_text(bytes, offset, size)
            found = true
    if end != int(len(bytes)) or not found:
        throw Error("missing or unindexed compiler metadata section")
    return result


def encode_interface(contract: string) -> list[u8]:
    return encode_sections("SEVPKGI", ["severian-scalar-c-1", contract])


def decode_interface(location: string) -> string | Error:
    bytes = package.read_bytes(location)
    magic = "SEVPKGI"
    if decode_section(bytes, magic, 1) != "severian-scalar-c-1":
        throw Error("incompatible Severian interface ABI")
    return decode_section(bytes, magic, 2)
