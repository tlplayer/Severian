import backend
import source
import "source.sev" as pipeline
import "frontend.sev" as frontend
import Diagnostic from "../../../../syntax/primitive/error/diagnostic.sev"

class Compiler:
    sysroot: string = "."

    def analyze_source(input: source.SourceFile, package: string = "", module: string = "") -> frontend.FrontendResult | list[Diagnostic]:
        return frontend.analyze_source(input, package, module)

    def compile_source(input: source.SourceFile, output: string) -> backend.Artifact | Error:
        mlir = pipeline.compile_to_mlir(input, sysroot=sysroot)
        backend.emit_native(mlir, output, sysroot=sysroot)
        return backend.Artifact(output, backend.Executable)

    def compile_file(path: string, output: string) -> backend.Artifact | Error:
        return compile_source(pipeline.load_input(path), output)

    def check_file(path: string):
        pipeline.compile_to_mlir(pipeline.load_input(path), sysroot=sysroot, emit="check")


def compile_source(input: source.SourceFile, output: string) -> backend.Artifact | Error:
    return Compiler().compile_source(input, output)


def compile_file(path: string, output: string) -> backend.Artifact | Error:
    return Compiler().compile_file(path, output)


def check_file(path: string):
    Compiler().check_file(path)
