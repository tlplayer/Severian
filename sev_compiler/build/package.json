{
  "language": {
    "explicit-imports": true
  },
  "package": {
    "name": "sev-compiler-build",
    "version": "0.1.0",
    "edition": "2026",
    "publish": false
  },
  "lib": {
    "name": "build",
    "path": "build/src/lib.sev"
  },
  "bin": [
    {
      "name": "sev-bootstrap-driver",
      "path": "build/src/main.sev"
    }
  ],
  "dependencies": {
    "core_string": {
      "path": "../../library/core/string",
      "package": "core.string"
    },
    "interface": {
      "path": "../../library/package/compile/interface",
      "package": "sev-semantic-interface"
    },
    "environment": {
      "path": "../../library/system/environment",
      "package": "environment"
    },
    "file": {
      "path": "../../library/system/file",
      "package": "file"
    },
    "os": {
      "path": "../../library/system/os",
      "package": "os"
    },
    "path": {
      "path": "../../library/system/path",
      "package": "path"
    },
    "process": {
      "path": "../../library/system/process",
      "package": "process"
    },
    "time": {
      "path": "../../library/core/time",
      "package": "time"
    },
    "package": {
      "path": "../../library/package",
      "package": "package"
    },
    "backend": {
      "path": "../../library/package/compile/backend",
      "package": "sev-mlir-backend"
    },
    "diagnostics": {
      "path": "../syntax/error",
      "package": "sev-compiler-diagnostics"
    },
    "lexer": {
      "path": "../frontend/lexer",
      "package": "sev-compiler-lexer"
    },
    "modules": {
      "path": "../hir/modules",
      "package": "sev-compiler-modules"
    },
    "mir": {
      "path": "../mir",
      "package": "sev-compiler-mir"
    },
    "mlir": {
      "path": "../lir/mlir",
      "package": "sev-compiler-mlir"
    },
    "parser": {
      "path": "../frontend/parser",
      "package": "sev-compiler-parser"
    },
    "semantic": {
      "path": "../hir/semantic",
      "package": "sev-compiler-semantic"
    },
    "source": {
      "path": "../frontend/source",
      "package": "sev-compiler-source"
    },
    "syntax": {
      "package": "sev-compiler-syntax",
      "path": "../syntax"
    },
    "lowering": {
      "path": "../lir/lowering",
      "package": "sev-compiler-lowering"
    },
    "codec": {
      "path": "codec",
      "package": "sev-build-codec"
    }
  },
  "build": {
    "generators": [
      "frontend_codec.sev"
    ]
  }
}
