def archive_header() -> string:
    return "# Generated by sev_compiler/build/frontend_codec.sev during the package build.\nimport syntax\nimport lexer\nimport source\nimport package\nimport \"package:semantic/semantic/src/callable.sev\" as semantic\nimport \"package:semantic/semantic/src/definitions.sev\" as definitions\n\n\nclass ArchiveInput:\n    lines: list[string]\n    cursor: int = 0\n    source_ids: list[int] = []\n\n\ndef take(input: ArchiveInput) -> string | Error:\n    if input.cursor >= len(input.lines):\n        throw Error(\"truncated frontend archive\")\n    value = input.lines[input.cursor]\n    input.cursor += 1\n    return value\n\n\ndef archive_count(input: ArchiveInput) -> int | Error:\n    value = int(take(input))\n    if value < 0 or value > len(input.lines):\n        throw Error(\"invalid frontend archive count\")\n    return value\n\n\n"


def body_header() -> string:
    return "def archive_quote(value: string) -> string:\n    return value.replace(\"\\\\\", \"\\\\\\\\\").replace(\"\\n\", \"\\\\n\").replace(\"\\r\", \"\\\\r\")\n\n\ndef archive_unquote(value: string) -> string | Error:\n    output: list[string] = []\n    escaped := false\n    for character in value.characters():\n        part = string(character)\n        if escaped:\n            if part not in [\"n\", \"r\", \"\\\\\"]:\n                throw Error(\"invalid body archive escape\")\n            output.append(\"\\n\" if part == \"n\" else (\"\\r\" if part == \"r\" else \"\\\\\"))\n            escaped = false\n        elif part == \"\\\\\":\n            escaped = true\n        else:\n            output.append(part)\n    if escaped:\n        throw Error(\"truncated body archive escape\")\n    return output.join(\"\")\n\n\n"


def relative(location: string, directory: string) -> string:
    target = location.split("/")
    base = directory.split("/")
    common := 0
    while common < int(len(target)) and common < int(len(base)) and target[common] == base[common]:
        common += 1
    parts: list[string] = []
    for index in range(common, int(len(base))):
        parts.append("..")
    for index in range(common, int(len(target))):
        parts.append(target[index])
    return parts.join("/")


def model_imports(codec: Codec, directory: string) -> string:
    imports: list[string] = []
    for namespace in package.sorted_strings(codec.namespaces):
        if not namespace.starts_with("model_"):
            continue
        used := false
        for value in codec.types:
            if value.contains(namespace + "."):
                used = true
        if not used:
            continue
        for model in codec.models:
            if model.namespace == namespace:
                line = "import \"" + relative(model.location, directory) + "\" as " + namespace
                if line not in imports:
                    imports.append(line)
                break
    return imports.join("\n") + "\n"


def names(text: string, functions_only: bool = false) -> list[string]:
    result: list[string] = []
    for line in text.split("\n"):
        if line.starts_with("def "):
            result.append(line[4:].split("(")[0])
        elif not functions_only and line.starts_with("class "):
            result.append(declaration(line))
    return result


def archive_text(text: string, mode: string) -> string:
    archive = "mir_archive" if mode == "mir" else ("semantic_archive" if mode == "interface" else ("body_archive" if mode == "bodies" else "frontend_archive"))
    text = text.replace("frontend_archive", archive)
    if mode != "bodies":
        return text
    lines: list[string] = []
    for line in text.split("\n"):
        if not line.starts_with("import \"package:semantic/") and line != "import package":
            lines.append(line)
    return lines.join("\n").replace("package.toml_quote", "archive_quote").replace("package.unquote", "archive_unquote")


def publish(destination: string, contents: string) -> unit | Error:
    # Compare bytes so a corrupt non-UTF-8 output can be repaired as well.
    directory = path.dirname(destination)
    package.mkdir(directory)
    temporary = package.temporary(directory, ".sev-codec-")
    staged = temporary + "/output"
    try:
        package.write_text(staged, contents)
        if not os.is_file(destination) or package.read_bytes(destination) != package.read_bytes(staged):
            package.replace_file(staged, destination)
        package.remove_tree(temporary)
    catch failure: Error:
        package.remove_tree(temporary)
        throw Error(failure.message)


def sha256(text: string, directory: string) -> string | Error:
    temporary = package.temporary(directory, ".sev-hash-")
    try:
        package.write_text(temporary + "/input", text)
        result = package.digest(temporary + "/input").replace("sha256:", "")
        package.remove_tree(temporary)
        return result
    catch failure: Error:
        package.remove_tree(temporary)
        throw Error(failure.message)


def generate(root: string, mode: string = "frontend") -> string | Error:
    if mode not in ["frontend", "mir", "interface", "bodies"]:
        throw Error("unknown frontend codec mode: " + mode)
    root = package.canonical(root)
    codec = Codec(root, mode)
    for location in model_sources():
        namespace = "model_" + identifier(location[int(len("sev_compiler/")):-4])
        load_models(codec, root + "/" + location, namespace)
    exported_sources(codec, root + "/sev_compiler/frontend/lexer/lexer/src/lib.sev")
    for location in package.sorted_strings(codec.exports):
        load_models(codec, location, "lexer")
    load_models(codec, root + "/sev_compiler/frontend/source/source.sev", "source")
    load_models(codec, root + "/sev_compiler/hir/semantic/semantic/src/definitions.sev", "definitions")
    load_models(codec, root + "/sev_compiler/hir/semantic/semantic/src/callable.sev", "semantic")
    contracts := ["model_hir_module_module.Module", "lexer.SyntaxRegistry", "list[source.SourceFile]", "list[semantic.PreludeAnalysis]"]
    if mode == "mir":
        contracts = ["model_hir_module_module.Module"]
    elif mode == "interface":
        contracts = ["model_hir_module_module.Module", "lexer.SyntaxRegistry", "list[source.SourceFile]", "list[string]"]
    elif mode == "bodies":
        contracts = ["model_syntax_block_block.Block"]
    for contract in contracts:
        ensure(codec, contract)
    build := root + "/sev_compiler/build/package.pkg/build"
    if mode == "interface":
        build = root + "/library/package/compile/interface/package.pkg/build"
    elif mode == "bodies":
        build = root + "/sev_compiler/hir/semantic/package.pkg/build"
    package.mkdir(build)
    body: list[string] = []
    for option in codec.options:
        body.append(option)
    for function in codec.functions:
        body.append(function)
    schema = sha256(body.join("\n\n\n"), build)
    identity := package.read_text(root + "/sev_compiler/build/frontend_codec.sev") + package.read_text(root + "/sev_compiler/build/codec/src/lib.sev") + package.read_text(root + "/sev_compiler/build/codec/src/host.sev")
    seen: list[string] = []
    for location in package.sorted_strings(codec.sources):
        if location in seen:
            continue
        seen.append(location)
        contents := ""
        for index in range(int(len(codec.sources))):
            if codec.sources[index] == location:
                contents = codec.contents[index]
        identity += relative(location, root) + string(char(0)) + contents + string(char(0))
    identity += "mir" if mode == "mir" else "frontend"
    generation = sha256(identity, build)
    archive = "mir_archive" if mode == "mir" else ("semantic_archive" if mode == "interface" else ("body_archive" if mode == "bodies" else "frontend_archive"))
    output = build + "/" + generation + "/staging/" + archive + ".sev"
    directory = output[:-4]
    header := model_imports(codec, path.dirname(output)) + archive_header()
    if mode == "bodies":
        header += body_header()
    codec_names: list[string] = []
    for name in package.sorted_strings(names(header + "\n" + codec.options.join("\n") + "\n" + codec.functions.join("\n"))):
        if name not in codec_names:
            codec_names.append(name)
    codec_names.append("schema")
    chunks: list[string] = []
    chunk: list[string] = []
    lines := 0
    for function in codec.functions:
        count = int(len(function.split("\n"))) + 3
        if len(chunk) > 0 and lines + count > 650:
            chunks.append(chunk.join("\n\n\n"))
            chunk.clear()
            lines = 0
        chunk.append(function)
        lines += count
    if len(chunk) > 0:
        chunks.append(chunk.join("\n\n\n"))
    lock = file.native_lock(build + "/frontend_archive.lock")
    if lock < 0:
        throw Error("could not lock frontend archive generation")
    try:
        imports: list[string] = []
        for index in range(int(len(chunks))):
            name = "part_" + ("0" if index < 10 else "") + string(index) + ".sev"
            functions = names(chunks[index], true)
            required: list[string] = []
            for symbol in codec_names:
                if symbol not in functions:
                    required.append(symbol)
            text = model_imports(codec, directory) + "# Generated by sev_compiler/build/frontend_codec.sev.\nimport syntax\nimport lexer\nimport source\nimport package\nimport \"package:semantic/semantic/src/callable.sev\" as semantic\nimport \"package:semantic/semantic/src/definitions.sev\" as definitions\nimport " + required.join(", ") + " from \"../frontend_archive.sev\"\n\n\n" + chunks[index] + "\n"
            publish(directory + "/" + name, archive_text(text, mode))
            imports.append("import " + functions.join(", ") + " from \"frontend_archive/" + name + "\"")
        text = header + "def schema() -> string:\n    return \"" + schema + "\"\n\n\n" + codec.options.join("\n\n\n") + "\n\n" + imports.join("\n") + "\n"
        publish(output, archive_text(text, mode))
        # Publish the stable entry last, after all shards have been repaired.
        publish(build + "/" + archive + ".sev", "# Generated frontend codec entry.\nimport " + codec_names.join(", ") + " from \"" + relative(output, build) + "\"\n")
        file.unlock(lock)
    catch failure: Error:
        file.unlock(lock)
        throw Error(failure.message)
    return output


def repository() -> string | Error:
    configured = environment.get("SEVERIAN_SYSROOT", "")
    if configured != "":
        return package.canonical(configured)
    active = environment.get("SEVERIAN_ACTIVE_GENERATOR", "")
    location := path.dirname(active) if active != "" else process.current_directory()
    while true:
        if package.exists(location + "/sev_compiler/package.json"):
            return package.canonical(location)
        parent = path.dirname(location)
        if parent == location:
            throw Error("set SEVERIAN_SYSROOT to the Severian repository")
        location = parent
    throw Error("set SEVERIAN_SYSROOT to the Severian repository")


def main():
    root = repository()
    for mode in ["frontend", "mir", "interface", "bodies"]:
        generate(root, mode)


test "archive tuples split only at the outer type level":
    assert(split("int, list[tuple[string, bool]], source.Span") == ["int", "list[tuple[string, bool]]", "source.Span"])


test "lexer reexports retain canonical callable archive identity":
    codec = Codec(repository(), "frontend")
    location = codec.root + "/sev_compiler/syntax/function/function.sev"
    load_models(codec, location, "model_syntax_function_function")
    count = len(codec.models)
    load_models(codec, location, "lexer")
    assert(len(codec.models) == count)
    assert(resolve(codec, "FunctionDeclaration", "lexer") == "model_syntax_function_function.FunctionDeclaration")
    for model in codec.models:
        if model.name == "model_syntax_function_function.FunctionDeclaration":
            for field in model.fields:
                assert(field.name != "binary_requirements")
                assert(field.name != "capability_requirements")


test "frontend and MIR preserve their distinct transient field rules":
    assert(skip_field("model_syntax_block_block.Block", "operations", "frontend"))
    assert(not skip_field("model_syntax_block_block.Block", "operations", "mir"))
    assert(skip_field("model_syntax_function_function.FunctionDeclaration", "cfg", "frontend"))
    assert(not skip_field("model_syntax_function_function.FunctionDeclaration", "cfg", "mir"))
    assert(skip_field("model_hir_module_module.Module", "binding_values", "mir"))
    assert(skip_field("source.SourceFile", "byte_offsets", "mir"))


test "archive optional values retain tags and wrapper decoding":
    codec = Codec("", "frontend")
    ensure(codec, "int | None")
    assert(codec.options == ["class ArchiveOption_int_None:\n    value: int | None"])
    assert(codec.functions[-1].contains("if supplied != None:"))
    assert(codec.functions[-1].contains("return ArchiveOption_int_None(None)"))
    assert(codec.functions[-1].contains("invalid frontend archive optional tag"))


test "archive schema and publication survive warm reuse and corrupt output":
    directory = package.temporary("/tmp", "sev-codec-")
    try:
        assert(sha256("abc", directory) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
        destination = directory + "/codec.sev"
        contents = "def schema() -> string:\n    return \"fixture\"\n"
        publish(destination, contents)
        before = package.capture(["stat", "-c", "%y", destination])
        publish(destination, contents)
        assert(package.capture(["stat", "-c", "%y", destination]) == before)
        package.write_bytes(destination, [u8(255)])
        publish(destination, contents)
        assert(package.read_text(destination) == contents)
        os.remove(destination)
        publish(destination, contents)
        assert(package.read_text(destination) == contents)
        package.remove_tree(directory)
    catch failure: Error:
        package.remove_tree(directory)
        throw Error(failure.message)


test "all archive modes regenerate deterministically and repair missing shards":
    root = repository()
    for mode in ["frontend", "mir", "interface", "bodies"]:
        output = generate(root, mode)
        original = package.read_text(output)
        stamp = package.capture(["stat", "-c", "%y", output])
        assert(generate(root, mode) == output)
        assert(package.capture(["stat", "-c", "%y", output]) == stamp)
        shard = output[:-4] + "/part_00.sev"
        original_shard = package.read_text(shard)
        package.write_bytes(shard, [u8(255)])
        assert(generate(root, mode) == output)
        assert(package.read_text(shard) == original_shard)
        os.remove(shard)
        assert(generate(root, mode) == output)
        assert(package.read_text(shard) == original_shard)
        assert(package.read_text(output) == original)
