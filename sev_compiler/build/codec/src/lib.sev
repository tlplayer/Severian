import "host.sev" as package
import environment
import process
import path
import file
import os

class Field:
    name: string
    type: string

class Variant:
    name: string
    fields: list[Field]

class Model:
    name: string
    kind: string
    namespace: string
    location: string
    fields: list[Field] = []
    variants: list[Variant] = []

class Codec:
    root: string
    mode: string
    models: list[Model] = []
    sources: list[string] = []
    contents: list[string] = []
    namespaces: list[string] = []
    exports: list[string] = []
    types: list[string] = []
    functions: list[string] = []
    options: list[string] = []


def split(value: string, separator: string = ",") -> list[string]:
    result: list[string] = []
    start := 0
    depth := 0
    for index in range(int(len(value))):
        part = value[index:index + 1]
        if part in ["[", "("]:
            depth += 1
        if part in ["]", ")"]:
            depth -= 1
        if part == separator and depth == 0:
            result.append(value[start:index].strip())
            start = index + 1
    result.append(value[start:].strip())
    return result


def identifier(value: string) -> string:
    result := ""
    for part in value.characters():
        text = string(part)
        if "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(text):
            result += text
        elif not result.ends_with("_"):
            result += "_"
    while result.starts_with("_"):
        result = result[1:]
    while result.ends_with("_"):
        result = result[:-1]
    return result


def declaration(line: string) -> string:
    if not line.starts_with("class ") and not line.starts_with("enum "):
        return ""
    return line.split(" ")[1].split(":")[0].split("[")[0]


def skip_field(model: string, field: string, mode: string) -> bool:
    if model == "source.SourceFile" and field in ["characters", "byte_offsets"]:
        return true
    if model == "model_syntax_function_function.FunctionDeclaration":
        return field in (["binary_requirements", "capability_requirements"] if mode == "mir" else ["binary_requirements", "capability_requirements", "cfg"])
    if model == "model_hir_module_module.Module":
        return field in (["binding_values"] if mode == "mir" else ["initializer_cfg", "cfg_bodies", "values", "globals", "binding_values", "quality_files", "quality_exclusions", "quality_regions", "debug_files"])
    return mode != "mir" and model == "model_syntax_block_block.Block" and field in ["operations", "lowered_operations", "cfg_index", "parameters", "terminator", "origins", "origin"]


def load_models(codec: Codec, location: string, namespace: string) -> unit | Error:
    location = package.canonical(location)
    for index in range(int(len(codec.sources))):
        if codec.sources[index] == location and codec.namespaces[index] == namespace:
            return
    codec.sources.append(location)
    codec.namespaces.append(namespace)
    contents = package.read_text(location)
    codec.contents.append(contents)
    current := -1
    for line in contents.split("\n"):
        name := declaration(line)
        if name != "":
            # Re-exporting a syntax model does not create a new model identity.
            # Preserve its canonical namespace and transient-field policy.
            canonical := false
            if namespace == "lexer":
                for existing in codec.models:
                    if existing.location == location and existing.namespace.starts_with("model_") and existing.name == existing.namespace + "." + name:
                        canonical = true
            if canonical:
                current = -1
                continue
            codec.models.append(Model(namespace + "." + name, "class" if line.starts_with("class ") else "enum", namespace, location))
            current = int(len(codec.models)) - 1
            continue
        if line != "" and not line.starts_with(" ") and not line.starts_with("#"):
            current = -1
        if current < 0 or not line.starts_with("    ") or line.starts_with("     "):
            continue
        model = codec.models[current]
        text = line.strip()
        if model.kind == "class":
            if not text.contains(": ") or text.starts_with("def "):
                continue
            pieces = text.split(": ")
            name = pieces[0]
            if identifier(name) == name and not skip_field(model.name, name, codec.mode):
                model.fields.append(Field(name, text[int(len(name)) + 2:].split(" = ")[0]))
        elif text != "" and identifier(text.split("(")[0]) == text.split("(")[0]:
            fields: list[Field] = []
            name = text.split("(")[0]
            if text.contains("("):
                for value in split(text[int(len(name)) + 1:-1]):
                    pieces = value.split(": ")
                    if len(pieces) != 2:
                        throw Error("invalid archive variant field: " + value)
                    fields.append(Field(pieces[0], pieces[1]))
            model.variants.append(Variant(name, fields))


def exported_sources(codec: Codec, location: string) -> unit | Error:
    location = package.canonical(location)
    if location in codec.exports:
        return
    codec.exports.append(location)
    for line in package.read_text(location).split("\n"):
        if not line.starts_with("import ") or not line.contains(" from \"") or not line.ends_with("\""):
            continue
        locator = line.split("\"")[1]
        target := path.dirname(location) + "/" + locator
        if locator.starts_with("package:"):
            parts = locator[8:].split("/")
            owner := path.dirname(location)
            while not package.exists(owner + "/package.json"):
                parent = path.dirname(owner)
                if parent == owner:
                    throw Error("package import outside a package: " + location)
                owner = parent
            entries = package.parse_document(package.read_text(owner + "/package.json"))
            raw = package.setting(entries, "dependencies", parts[0])
            if raw == "":
                throw Error("codec needs a resolved local dependency: " + locator)
            dependency = package.parse_dependency(parts[0], raw, false)
            if dependency.reference.source != "path":
                throw Error("codec needs a resolved local dependency: " + locator)
            dependency_path = dependency.reference.location
            dependency_root = package.canonical(dependency_path if dependency_path.starts_with("/") else owner + "/" + dependency_path)
            member := locator[8 + int(len(parts[0])):]
            if member == "":
                document = package.parse_document(package.read_text(dependency_root + "/package.json"))
                member = "/" + package.text_setting(document, "lib", "path")
            target = package.canonical(dependency_root + member)
            if not target.starts_with(dependency_root + "/"):
                throw Error("package import escapes dependency: " + locator)
        exported_sources(codec, target)


def numeric(value: string) -> bool:
    if value in ["int", "float"]:
        return true
    if len(value) < 2 or value[:1] not in ["u", "i", "f"]:
        return false
    for digit in value[1:].characters():
        if not "0123456789".contains(string(digit)):
            return false
    return true


def resolve(codec: Codec, value: string, namespace: string) -> string | Error:
    value = value.strip()
    if value.contains(" | "):
        parts: list[string] = []
        for part in value.split(" | "):
            parts.append(resolve(codec, part, namespace))
        return parts.join(" | ")
    if value.contains("["):
        base = value.split("[")[0]
        parts: list[string] = []
        for part in split(value[int(len(base)) + 1:-1]):
            parts.append(resolve(codec, part, namespace))
        return base + "[" + parts.join(", ") + "]"
    if value in ["bool", "string", "None", "absent"] or numeric(value):
        return value
    for index in range(int(len(codec.models))):
        model = codec.models[int(len(codec.models)) - index - 1]
        if model.name == value or model.name == namespace + "." + value:
            return model.name
    if value in ["SourceId", "Span", "SourceFile"]:
        return "source." + value
    parts = value.split(".")
    member = parts[-1]
    for index in range(int(len(codec.models))):
        model = codec.models[int(len(codec.models)) - index - 1]
        if model.namespace.starts_with("model_") and model.name.ends_with("." + member):
            return model.name
    for model in codec.models:
        if model.name == "lexer." + value:
            return model.name
    throw Error("unresolved archive model " + value + " from " + namespace)


def read_field(codec: Codec, output: list[string], value: string, index: int, indent: string = "    ") -> unit | Error:
    ensure(codec, value)
    name = "field_" + string(index)
    call = "get_" + identifier(value) + "(input)"
    if value.contains(" | "):
        output.append(indent + "optional_" + string(index) + " = " + call)
        output.append(indent + name + " ?= optional_" + string(index) + ".value")
    else:
        output.append(indent + name + " = " + call)


def put(codec: Codec, value: string, expression: string) -> string | Error:
    ensure(codec, value)
    return "put_" + identifier(value) + "(output, " + expression + ")"


def ensure(codec: Codec, value: string) -> unit | Error:
    if value in codec.types:
        return
    codec.types.append(value)
    name = identifier(value)
    result = "ArchiveOption_" + name if value.contains(" | ") else value
    encode: list[string] = ["def put_" + name + "(output: list[string], value: " + value + "):"]
    decode: list[string] = ["def get_" + name + "(input: ArchiveInput) -> " + result + " | Error:"]
    if value == "string":
        encode.append("    output.append(package.toml_quote(value))")
        decode.append("    return package.unquote(take(input))")
    elif value == "bool":
        encode.append("    output.append(\"1\" if value else \"0\")")
        decode.append("    value = take(input)\n    if value not in [\"0\", \"1\"]:\n        throw Error(\"invalid frontend archive boolean\")\n    return value == \"1\"")
    elif numeric(value):
        encode.append("    output.append(string(value))")
        decode.append("    return " + value + "(take(input))")
    elif value.contains(" | "):
        parts = value.split(" | ")
        if len(parts) != 2 or parts[1] not in ["None", "absent"]:
            throw Error("unsupported archive union: " + value)
        codec.options.append("class " + result + ":\n    value: " + value)
        encode.append("    supplied ?= value\n    if supplied != " + parts[1] + ":\n        output.append(\"1\")\n        " + put(codec, parts[0], "supplied") + "\n    else:\n        output.append(\"0\")")
        decode.append("    tag = take(input)\n    if tag == \"0\":\n        return " + result + "(" + parts[1] + ")\n    if tag != \"1\":\n        throw Error(\"invalid frontend archive optional tag\")\n    return " + result + "(get_" + identifier(parts[0]) + "(input))")
    elif value.starts_with("list["):
        child = value[5:-1]
        encode.append("    output.append(string(len(value)))\n    for element in borrow value:\n        " + put(codec, child, "element"))
        decode.append("    result: " + value + " = []\n    count = archive_count(input)\n    for index in range(count):\n        result.append(get_" + identifier(child) + "(input))\n    return result")
    elif value.starts_with("tuple["):
        children = split(value[6:-1])
        args: list[string] = []
        for index in range(int(len(children))):
            encode.append("    " + put(codec, children[index], "value[" + string(index) + "]"))
            read_field(codec, decode, children[index], index)
            args.append("field_" + string(index))
        decode.append("    return (" + args.join(", ") + ")")
    else:
        found := false
        for index in range(int(len(codec.models))):
            model = codec.models[int(len(codec.models)) - index - 1]
            if model.name != value:
                continue
            found = true
            if model.kind == "class":
                args: list[string] = []
                for index in range(int(len(model.fields))):
                    field = model.fields[index]
                    child = resolve(codec, field.type, model.namespace)
                    encode.append("    " + put(codec, child, "value." + field.name))
                    read_field(codec, decode, child, index)
                    args.append(("" if value == "source.SourceFile" else field.name + "=") + "field_" + string(index))
                if codec.mode == "interface" and value == "source.SourceId":
                    decode.append("    if len(input.source_ids) > 0:\n        if field_0 >= len(input.source_ids):\n            throw Error(\"semantic interface has a dangling source identity\")\n        return source.SourceId(index=u32(input.source_ids[field_0]))")
                decode.append("    return " + value + "(" + args.join(", ") + ")")
            else:
                encode.append("    match value:")
                decode.append("    tag = archive_count(input)")
                for index in range(int(len(model.variants))):
                    variant = model.variants[index]
                    encode.append("        case " + variant.name + ":\n            output.append(\"" + string(index) + "\")")
                    decode.append("    if tag == " + string(index) + ":")
                    args: list[string] = []
                    for position in range(int(len(variant.fields))):
                        field = variant.fields[position]
                        child = resolve(codec, field.type, model.namespace)
                        encode.append("            " + put(codec, child, field.name))
                        read_field(codec, decode, child, position, "        ")
                        args.append("field_" + string(position))
                    decode.append("        return " + value + "." + variant.name + ("(" + args.join(", ") + ")" if len(args) > 0 else ""))
                decode.append("    throw Error(\"invalid frontend archive variant: " + value + "\")")
            break
        if not found:
            throw Error("missing archive model: " + value)
    codec.functions.append(encode.join("\n") + "\n\n\n" + decode.join("\n"))


