import diagnostics
import source
import universal
import "../../../universal/type/scalar.sev" as scalar
import "../../../universal/type/storage.sev" as storage_types


# Shared declaration environment. AST declarations survive with resolved
# identities; callable analysis and the package entry use the same environment.
class RecordInstance:
    type_id: universal.TypeId
    template: universal.DefId
    arguments: list[universal.TypeBinding]


class SemanticDefinitions:
    aliases: list[universal.TypeDeclaration] = []
    traits: list[universal.TraitDeclaration] = []
    implementations: list[universal.RecordDeclaration] = []
    symbol_descriptors: list[universal.TraitDeclaration] = []
    record_templates: list[universal.RecordDeclaration] = []
    record_instances: list[RecordInstance] = []
    expression_functions: list[universal.FunctionDeclaration] = []


def definition_id(name: string, ordinal: int) -> universal.DefId:
    # Keep declaration identities disjoint from executable function ordinals.
    return universal.DefId(0, 1, universal.DeclarationId(u128(ordinal + 1)))


def trait_named(definitions: SemanticDefinitions, name: string, namespace: string) -> universal.TraitDeclaration | None:
    for declaration in definitions.traits:
        if declaration.name == namespace + name:
            return declaration
    for declaration in definitions.traits:
        if declaration.name == name:
            return declaration
    return None


def alias_named(definitions: SemanticDefinitions, name: string, namespace: string) -> universal.TypeDeclaration | None:
    for declaration in definitions.aliases:
        if declaration.name == namespace + name:
            return declaration
    for declaration in definitions.aliases:
        if declaration.name == name:
            return declaration
    return None


def type_annotation(definitions: SemanticDefinitions, annotation: universal.TypeAnnotation, records: list[universal.RecordDeclaration], namespace: string, active: list[string] = []) -> universal.TypeId | diagnostics.Diagnostic:
    match annotation.kind:
        case Named:
            if name == "buffer" and len(arguments) == 1:
                element = type_annotation(definitions, arguments[0], records, namespace, active)
                if int(element.index) in [1, 8, 16, 32, 64, 108, 516, 532, 564, 132, 164]:
                    return universal.TypeId(200 + element.index)
                if not storage_types.copy_storage(element, records):
                    return error(diagnostics.diagnostic_at("E000205", "buffer elements require copyable storage; owned elements require destruction lowering", annotation.span))
                for record in records:
                    if record.storage_element.index == element.index:
                        return record.type_id
                id = universal.TypeId(u32(1000 + len(records)))
                records.append(universal.RecordDeclaration("$buffer$" + type_name(element, records), [], [], annotation.span, type_id=id, storage_element=element))
                return id
            alias ?= alias_named(definitions, name, namespace)
            if alias != None:
                if len(alias.type_parameters) != len(arguments):
                    return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", annotation.span))
                if alias.name in active:
                    return error(diagnostics.diagnostic_at("E000205", "cyclic type alias " + alias.name, annotation.span))
                if alias.id.index != 0:
                    return alias.id
                target ?= alias.definition
                if target != None:
                    # Arguments belong to the caller's scope; the alias body
                    # belongs to its declaration scope. Resolve that boundary
                    # before substituting names into the alias definition.
                    replacements: list[universal.TypeAnnotation] = []
                    for argument in arguments:
                        actual = type_annotation(definitions, argument, records, namespace, active)
                        replacements.append(universal.named_type(type_name(actual, records), [], argument.span))
                    substituted = replace_annotation(target, alias.type_parameters, replacements)
                    match substituted.kind:
                        case Union:
                            # Family values still require a concrete member.
                            return error(diagnostics.diagnostic_at("E000205", "family requires a concrete member: " + alias.name, annotation.span))
                        case _:
                            path = active[:]
                            path.append(alias.name)
                            return type_annotation(definitions, substituted, records, alias.lookup, path)
            template ?= record_template(definitions, name, namespace)
            if template != None:
                return instantiate_record(definitions, template, arguments, records, namespace, annotation.span)
            for record in records:
                if record.name == namespace + name:
                    if len(arguments) != 0:
                        return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", annotation.span))
                    return record.type_id
            for record in records:
                if record.name == name:
                    if len(arguments) != 0:
                        return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", annotation.span))
                    return record.type_id
            known ?= scalar.scalar_type_name(name)
            if known != None:
                return known
            return error(diagnostics.diagnostic_at("E000205", "unknown type " + name, annotation.span))
        case Union:
            variants: list[universal.TypeId] = []
            key := "$outcome"
            for member in members:
                variant = type_annotation(definitions, member, records, namespace, active)
                for previous in variants:
                    if previous.index == variant.index:
                        return error(diagnostics.diagnostic_at("E000205", "duplicate outcome variant", annotation.span))
                variants.append(variant)
                key += "$" + string(variant.index)
            for record in records:
                if record.name == key:
                    return record.type_id
            successes := 0
            for variant in variants:
                if int(variant.index) not in [6, 7] and not error_conformance(definitions, records, variant):
                    successes += 1
            if successes != 1 or len(variants) < 2:
                return error(diagnostics.diagnostic_at("E000205", "typed outcome requires one success type and missing or Error variants", annotation.span))
            fields = [universal.FunctionParameter("$tag", universal.named_type("int", [], annotation.span), None, annotation.span, type_id=universal.TypeId(64))]
            index := 0
            for variant in variants:
                fields.append(universal.FunctionParameter("$variant" + string(index), universal.named_type(type_name(variant, records), [], annotation.span), None, annotation.span, type_id=variant))
                index += 1
            id = universal.TypeId(u32(1000 + len(records)))
            records.append(universal.RecordDeclaration(key, fields, [], annotation.span, type_id=id))
            return id
        case _:
            return error(diagnostics.diagnostic_at("E000205", "a value requires one concrete type", annotation.span))


def type_name(type_id: universal.TypeId, records: list[universal.RecordDeclaration]) -> string:
    known ?= scalar.scalar_type(type_id)
    if known != None:
        return known.name
    for record in records:
        if record.type_id.index == type_id.index:
            return record.name
    return "$parameter$" + string(type_id.index)


def replace_annotation(annotation: universal.TypeAnnotation, names: list[string], replacements: list[universal.TypeAnnotation]) -> universal.TypeAnnotation:
    match annotation.kind:
        case Named:
            index := 0
            for parameter in names:
                if name == parameter and len(arguments) == 0:
                    return replacements[index]
                index += 1
            replaced: list[universal.TypeAnnotation] = []
            for argument in arguments:
                replaced.append(replace_annotation(argument, names, replacements))
            return universal.named_type(name, replaced, annotation.span)
        case Union:
            replaced: list[universal.TypeAnnotation] = []
            for member in members:
                replaced.append(replace_annotation(member, names, replacements))
            return universal.TypeAnnotation(universal.Union(replaced), annotation.span)


def inherited_traits(definitions: SemanticDefinitions, declaration: universal.TraitDeclaration, active: list[string] = []) -> list[universal.TraitDeclaration] | diagnostics.Diagnostic:
    if declaration.name in active:
        return error(diagnostics.diagnostic_at("E000212", "cyclic trait inheritance " + declaration.name, declaration.span))
    result = [declaration]
    path = active[:]
    path.append(declaration.name)
    for base in declaration.bases:
        name ?= universal.simple_type_name(base)
        if name == None:
            return error(diagnostics.diagnostic_at("E000212", "trait base must name a registered trait", base.span))
        if name != None:
            parent ?= trait_named(definitions, name, declaration.lookup)
            if parent == None:
                return error(diagnostics.diagnostic_at("E000212", "unknown trait " + name, base.span))
            if parent != None:
                for inherited in inherited_traits(definitions, parent, path):
                    found := false
                    for previous in result:
                        if previous.name == inherited.name:
                            found = true
                    if not found:
                        result.append(inherited)
    return result


def resolve_operator_constraints(definitions: SemanticDefinitions, operation: universal.OperatorDeclaration, namespace: string) -> universal.OperatorDeclaration | diagnostics.Diagnostic:
    constraints: list[universal.GenericConstraint] = []
    for constraint in operation.constraints:
        grammar_bound := false
        match constraint:
            case Parameter:
                bound_name ?= universal.simple_type_name(bound)
                if bound_name != None:
                    contract_definition ?= trait_named(definitions, bound_name, namespace)
                    if contract_definition != None:
                        if contract_definition.grammar:
                            if operation.grammar_parameter != absent:
                                return error(diagnostics.diagnostic_at("E000212", "operator requires one grammar binding", span))
                            operation.grammar_parameter = parameter
                            syntax = operation.syntax
                            syntax.domain = universal.OperatorDomain.GrammarOperator
                            syntax.grammar_name = bound_name
                            operation.syntax = syntax
                            grammar_bound = true
                    else:
                        known := alias_named(definitions, bound_name, namespace) != None
                        for implementation in definitions.implementations:
                            if implementation.name == bound_name or implementation.name == namespace + bound_name:
                                known = true
                        if not known:
                            return error(diagnostics.diagnostic_at("E000212", "unknown operator constraint " + bound_name, span))
            case _:
                pass
        if not grammar_bound:
            constraints.append(constraint)
    parameters: list[string] = []
    grammar_parameter ?= operation.grammar_parameter
    for parameter in operation.type_parameters:
        retained := true
        if grammar_parameter != absent:
            retained = parameter != grammar_parameter
        if retained:
            parameters.append(parameter)
    operation.type_parameters = parameters
    operation.constraints = constraints
    operation.syntax = resolve_grammar_binding(definitions, operation.syntax, namespace, operation.span)
    return operation


def resolve_grammar_binding(definitions: SemanticDefinitions, syntax: universal.OperatorSyntax, namespace: string, span: source.Span) -> universal.OperatorSyntax | diagnostics.Diagnostic:
    if syntax.domain != universal.OperatorDomain.GrammarOperator:
        return syntax
    contract_definition ?= trait_named(definitions, syntax.grammar_name, namespace)
    if contract_definition == None:
        return error(diagnostics.diagnostic_at("E000212", "unknown grammar contract " + syntax.grammar_name, span))
    if contract_definition != None:
        if not contract_definition.grammar:
            return error(diagnostics.diagnostic_at("E000212", "operator binding requires a compiler G contract", span))
        for inherited in inherited_traits(definitions, contract_definition):
            for property in inherited.properties:
                if property.name == "symbol":
                    value ?= property.default
                    if value != None:
                        match value.kind:
                            case SourceSymbol:
                                if spelling != syntax.symbol:
                                    return error(diagnostics.diagnostic_at("E000212", "operator symbol does not match its grammar contract", span))
                                syntax.definition = contract_definition.definition
                                return syntax
                            case _:
                                return error(diagnostics.diagnostic_at("E000212", "grammar symbol requires a resolved source symbol", span))
        return error(diagnostics.diagnostic_at("E000212", "grammar binding requires a source symbol", span))
    return syntax


def register_declarations(module: universal.Module, environment: SemanticDefinitions = SemanticDefinitions()) -> SemanticDefinitions | diagnostics.Diagnostic:
    definitions = SemanticDefinitions(environment.aliases[:], environment.traits[:])
    names: list[string] = []
    ordinal := 0
    for item in module.items:
        match item:
            case Function:
                result ?= declaration.result
                if result != None:
                    if len(declaration.type_parameters) == 0 and universal.simple_type_name(result) == "Ex":
                        function := declaration
                        function.definition = definition_id(function.name, 40000 + ordinal)
                        definitions.expression_functions.append(function)
                        ordinal += 1
            case Trait:
                if declaration.name.split(".")[-1] == "G" and declaration.name != "G":
                    return error(diagnostics.diagnostic_at("E000212", "reserved compiler contract G cannot be redeclared", declaration.span))
                if declaration.compiler_descriptor and not declaration.grammar and declaration.name != "G":
                    definitions.symbol_descriptors.append(declaration)
                    continue
                trait_declaration := declaration
                if trait_declaration.name in names:
                    if trait_declaration.name == "G":
                        return error(diagnostics.diagnostic_at("E000212", "reserved compiler contract G cannot be redeclared", trait_declaration.span))
                    return error(diagnostics.diagnostic_at("E000212", "duplicate declaration " + trait_declaration.name, trait_declaration.span))
                names.append(trait_declaration.name)
                trait_declaration.definition = definition_id(trait_declaration.name, ordinal)
                if trait_declaration.grammar:
                    trait_declaration.definition = universal.DefId(0, u128(trait_declaration.span.source.index) + 2, universal.DeclarationId(u128(trait_declaration.span.start) + 1))
                ordinal += 1
                if len(trait_declaration.type_parameters) != 0 or len(trait_declaration.constraints) != 0:
                    return error(diagnostics.diagnostic_at("E000212", "generic trait declarations require trait argument substitution", trait_declaration.span))
                resolved_methods: list[universal.FunctionDeclaration] = []
                resolved_operators: list[universal.OperatorDeclaration] = []
                resolved_properties: list[universal.PropertyDeclaration] = []
                for property in trait_declaration.properties:
                    property.definition = definition_id(property.name, ordinal)
                    ordinal += 1
                    resolved_properties.append(property)
                for method in trait_declaration.methods:
                    method.definition = definition_id(method.name, ordinal)
                    resolved_methods.append(method)
                    ordinal += 1
                for operation in trait_declaration.operators:
                    operation.definition = definition_id(operation.syntax.symbol, ordinal)
                    resolved_operators.append(operation)
                    ordinal += 1
                trait_declaration.properties = resolved_properties
                trait_declaration.methods = resolved_methods
                trait_declaration.operators = resolved_operators
                definitions.traits.append(trait_declaration)
            case Type:
                if declaration.name in names:
                    return error(diagnostics.diagnostic_at("E000205", "duplicate declaration " + declaration.name, declaration.span))
                names.append(declaration.name)
                if len(declaration.constraints) != 0 or declaration.definition == None:
                    return error(diagnostics.diagnostic_at("E000205", "type declaration requires a concrete alias or closed family", declaration.span))
                definitions.aliases.append(declaration)
            case Record:
                record_declaration := declaration
                record_declaration.definition = definition_id(declaration.name, 30000 + ordinal)
                if len(declaration.type_parameters) != 0 and not declaration.extension:
                    definitions.record_templates.append(record_declaration)
                definitions.implementations.append(record_declaration)
                if not declaration.extension:
                    if declaration.name in names:
                        # A family behavior declaration can share its family's name.
                        family ?= alias_named(definitions, declaration.name, "")
                        if family == None:
                            return error(diagnostics.diagnostic_at("E000205", "duplicate declaration " + declaration.name, declaration.span))
                    else:
                        names.append(declaration.name)
                ordinal += 1
            case _:
                pass
    trait_index := 0
    for declaration in definitions.traits:
        inherited_traits(definitions, declaration)
        member_names: list[string] = []
        for method in declaration.methods:
            if method.name in member_names:
                return error(diagnostics.diagnostic_at("E000212", "duplicate trait member " + method.name, declaration.span))
            member_names.append(method.name)
        symbols: list[string] = []
        resolved_operators: list[universal.OperatorDeclaration] = []
        for operation in declaration.operators:
            operation = resolve_operator_constraints(definitions, operation, declaration.lookup)
            resolved_operators.append(operation)
            key = operation.syntax.symbol + string(len(operation.parameters)) + string(operation.receiver)
            if key in symbols:
                return error(diagnostics.diagnostic_at("E000212", "duplicate trait operator " + operation.syntax.symbol, operation.span))
            symbols.append(key)
        declaration.operators = resolved_operators
        definitions.traits[trait_index] = declaration
        trait_index += 1
    module.traits = definitions.traits
    module.types = definitions.aliases
    return definitions


def family_members(definitions: SemanticDefinitions, annotation: universal.TypeAnnotation, records: list[universal.RecordDeclaration], namespace: string, active: list[string] = []) -> list[universal.TypeId] | diagnostics.Diagnostic:
    match annotation.kind:
        case Union:
            result: list[universal.TypeId] = []
            for member in members:
                for concrete in family_members(definitions, member, records, namespace, active):
                    duplicate := false
                    for previous in result:
                        if previous.index == concrete.index:
                            duplicate = true
                    if not duplicate:
                        result.append(concrete)
            if len(result) == 0:
                return error(diagnostics.diagnostic_at("E000205", "empty type family", annotation.span))
            return result
        case Named:
            alias ?= alias_named(definitions, name, namespace)
            if alias != None:
                if alias.name in active:
                    return error(diagnostics.diagnostic_at("E000205", "cyclic type family " + alias.name, annotation.span))
                target ?= alias.definition
                if target != None:
                    path = active[:]
                    path.append(alias.name)
                    return family_members(definitions, target, records, alias.lookup, path)
    return [type_annotation(definitions, annotation, records, namespace)]


def error_conformance(definitions: SemanticDefinitions, records: list[universal.RecordDeclaration], type_id: universal.TypeId) -> bool | diagnostics.Diagnostic:
    required ?= trait_named(definitions, "Error", "")
    if required == None:
        return false
    if required != None:
        for record in records:
            if record.type_id.index == type_id.index:
                for base in record.traits:
                    name ?= universal.simple_type_name(base)
                    if name != None:
                        declared ?= trait_named(definitions, name, record.lookup)
                        if declared != None:
                            for inherited in inherited_traits(definitions, declared):
                                if inherited.definition.module == required.definition.module and inherited.definition.declaration.value == required.definition.declaration.value:
                                    return true
    return false


# Generic records retain their declaration identity and canonical type bindings.
# Allocate identity before resolving fields, so recursive applications terminate;
# the concrete layout validator diagnoses recursive storage afterwards.
def record_template(definitions: SemanticDefinitions, name: string, namespace: string) -> universal.RecordDeclaration | None:
    for template in definitions.record_templates:
        if template.name == namespace + name:
            return template
    for template in definitions.record_templates:
        if template.name == name:
            return template
    return None


def instantiate_record(definitions: SemanticDefinitions, template: universal.RecordDeclaration, arguments: list[universal.TypeAnnotation], records: list[universal.RecordDeclaration], namespace: string, span: source.Span) -> universal.TypeId | diagnostics.Diagnostic:
    if (template.type_pack == "" and len(arguments) != len(template.type_parameters)) or (template.type_pack != "" and len(arguments) < len(template.type_parameters) - 1):
        return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", span))
    if len(template.traits) != 0:
        return error(diagnostics.diagnostic_at("E000205", "generic record trait implementations require instantiated trait validation", span))
    actuals: list[universal.TypeBinding] = []
    replacements: list[universal.TypeAnnotation] = []
    index := 0
    name := template.name + "["
    for argument in arguments:
        actual = type_annotation(definitions, argument, records, namespace)
        actuals.append(universal.TypeBinding(universal.GenericParamId(u32(index)), actual))
        replacements.append(universal.named_type(type_name(actual, records), [], span))
        if index > 0:
            name += ", "
        name += type_name(actual, records)
        index += 1
    name += "]"
    for instance in definitions.record_instances:
        origin = instance.template
        if origin.module == template.definition.module and origin.declaration.value == template.definition.declaration.value:
            equal := len(instance.arguments) == len(actuals)
            index = 0
            for binding in instance.arguments:
                if equal:
                    equal = binding.type_id.index == actuals[index].type_id.index
                index += 1
            if equal:
                return instance.type_id
    if len(records) >= 4096:
        return error(diagnostics.diagnostic_at("E000205", "record specialization limit exceeded", span))
    id = universal.TypeId(u32(1000 + len(records)))
    position = len(records)
    record = universal.RecordDeclaration(name, [], [], template.span, type_id=id, lookup=template.lookup, definition=template.definition)
    records.append(record)
    definitions.record_instances.append(RecordInstance(id, template.definition, actuals))
    fields: list[universal.FunctionParameter] = []
    names: list[string] = []
    for field in template.fields:
        if field.name in names:
            return error(diagnostics.diagnostic_at("E000205", "duplicate field " + field.name, field.span))
        names.append(field.name)
        if field.variadic:
            if template.type_pack == "" or universal.simple_type_name(field.annotation) != template.type_pack:
                return error(diagnostics.diagnostic_at("E000205", "expanded field must use the declared type pack", field.span))
            if field.default != None:
                return error(diagnostics.diagnostic_at("E000205", "expanded fields cannot have defaults", field.span))
            offset := 0
            for replacement in replacements[len(template.type_parameters) - 1:]:
                type_id = type_annotation(definitions, replacement, records, template.lookup)
                if scalar.scalar_representation(type_id) == "utf8" or storage_types.buffer_element(type_id, records).index != 0:
                    return error(diagnostics.diagnostic_at("E000205", "aggregate resource fields require ownership lowering", field.span))
                if type_id.index == 2:
                    return error(diagnostics.diagnostic_at("E000205", "unit cannot be stored in a record field", field.span))
                fields.append(universal.FunctionParameter(field.name + "$" + string(offset), replacement, None, field.span, type_id=type_id, pack=field.name))
                offset += 1
            continue
        annotation = replace_annotation(field.annotation, template.type_parameters, replacements)
        type_id = type_annotation(definitions, annotation, records, template.lookup)
        if type_id.index == 3:
            return error(diagnostics.diagnostic_at("E000205", "record string fields require aggregate ownership lowering", field.span))
        if type_id.index == 2:
            return error(diagnostics.diagnostic_at("E000205", "unit cannot be stored in a record field", field.span))
        fields.append(universal.FunctionParameter(field.name, annotation, field.default, field.span, type_id=type_id))
    record.fields = fields
    record.methods = template.methods
    record.traits = template.traits
    record.operators = template.operators
    records[position] = record
    return id



def record_instance(definitions: SemanticDefinitions, type_id: universal.TypeId) -> RecordInstance | None:
    for instance in definitions.record_instances:
        if instance.type_id.index == type_id.index:
            return instance
    return None
