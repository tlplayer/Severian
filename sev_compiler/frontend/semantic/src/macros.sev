import lexer
import diagnostics
from lexer import TokenKind
import parser
import source
import universal
import "../../../universal/type/scalar.sev" as scalar
import "../../../universal/type/scalar_conversion.sev" as conversions
import "../../../universal/type/integer_spelling.sev" as integer_spelling
import "definitions.sev" as family_definitions


# Declaration macros enumerate type families before ordinary name resolution.
# This first subset takes no runtime arguments and emits function declarations.
class ScalarMacro:
    name: string
    bindings: list[string]
    families: list[string]
    tokens: list[lexer.Token]
    functions: list[string]


def macro_identifier(input: parser.Parser) -> string:
    token = parser.parser_next(input)
    match token.kind:
        case Identifier:
            return string(token)
        case _:
            throw Error("expected macro identifier")


def macro_definition(input: parser.Parser) -> ScalarMacro:
    parser.parser_next(input)
    name = macro_identifier(input)
    parser.parser_expect_symbol(input, "[", "expected macro type parameters")
    bindings: list[string] := []
    parameters: list[string] = []
    while not parser.parser_at_symbol(input, "]"):
        parameter = macro_identifier(input)
        parser.parser_expect_symbol(input, ":", "expected macro type binding")
        binding = macro_identifier(input)
        bindings.append(binding)
        parameters.append(parameter)
        if parser.parser_take_symbol(input, ",") == None:
            break
    parser.parser_expect_symbol(input, "]", "expected closing macro parameters")
    parser.parser_expect_symbol(input, "(", "expected macro argument list")
    parser.parser_expect_symbol(input, ")", "enumerative macros take no runtime arguments")
    families: list[string] = []
    if parser.parser_at_symbol(input, ":"):
        # In the direct form, the left-hand name is the body binding and
        # the right-hand name is the family: -> lists[T: int]():
        for family in bindings:
            families.append(family)
        bindings = parameters
    else:
        if macro_identifier(input) != "with":
            throw Error("expected enumerative macro constraints")
        for binding in bindings:
            if len(families) > 0:
                if macro_identifier(input) != "and":
                    throw Error("expected and between macro families")
            if macro_identifier(input) != binding or macro_identifier(input) != "in":
                throw Error("macro family constraints must follow binding order")
            family = macro_identifier(input)
            families.append(family)
    seen: list[string] = []
    for binding in bindings:
        if binding in seen:
            throw Error("duplicate macro type binding")
        seen.append(binding)
    parser.parser_expect_symbol(input, ":", "expected macro body")
    parser.parser_expect(input, Newline, "expected newline after macro")
    parser.parser_separators(input)
    parser.parser_expect(input, Indent, "expected indented macro body")
    tokens: list[lexer.Token] = []
    functions: list[string] = []
    depth := 1
    while depth > 0:
        token = parser.parser_next(input)
        if token.kind == Eof:
            throw Error("unterminated macro body")
        if token.kind == Indent:
            depth += 1
        elif token.kind == Dedent:
            depth -= 1
        if depth == 0:
            break
        if depth == 1:
            match token.kind:
                case Identifier:
                    if string(token) == "def":
                        match parser.parser_peek(input).kind:
                            case Identifier:
                                functions.append(string(parser.parser_peek(input)))
                            case _:
                                throw Error("expected generated function name")
                case _:
                    pass
        tokens.append(token)
    if len(bindings) == 0 or len(functions) == 0:
        throw Error("enumerative macros require type bindings and functions")
    return ScalarMacro(name, bindings, families, tokens, functions)


def macro_property(type: scalar.ScalarType, name: string, lexeme: lexer.Lexeme) -> lexer.Token:
    if name == "id":
        return lexer.token_from_lexeme(lexer.TokenKind.Integer, lexeme, "" + string(type.id.index))
    if name == "bits":
        return lexer.token_from_lexeme(lexer.TokenKind.Integer, lexeme, "" + string(type.bits))
    if name == "signed":
        return lexer.token_from_lexeme(lexer.TokenKind.Identifier, lexeme, "true" if type.signed else "false")
    if type.representation == "float":
        throw Error("unsupported floating type property " + name)
    lower = scalar.integer_minimum(type)
    maximum = scalar.integer_maximum(type)
    upper := ""
    if type.bits == 64:
        upper = "9223372036854775808" if type.signed else "18446744073709551616"
    else:
        upper = string(1 << (int(type.bits) - (1 if type.signed else 0)))
    if name == "min":
        return lexer.token_from_lexeme(lexer.TokenKind.Integer, lexeme, lower)
    if name == "max":
        return lexer.token_from_lexeme(lexer.TokenKind.Integer, lexeme, maximum)
    if name == "min_float":
        return lexer.token_from_lexeme(lexer.TokenKind.Float, lexeme, lower + ".0")
    if name == "upper_float":
        return lexer.token_from_lexeme(lexer.TokenKind.Float, lexeme, upper + ".0")
    throw Error("unsupported scalar type property " + name)


class MacroInteger:
    known: bool
    value: string = "0"


class MacroCondition:
    known: bool
    value: bool = false


def macro_integer(expression: universal.Expression) -> MacroInteger:
    match expression.kind:
        case LiteralValue:
            match value:
                case IntegerValue:
                    return MacroInteger(true, spelling)
                case _:
                    pass
        case _:
            pass
    return MacroInteger(false)


def macro_condition(expression: universal.Expression) -> MacroCondition:
    match expression.kind:
        case LiteralValue:
            match value:
                case BooleanValue:
                    return MacroCondition(true, value)
                case _:
                    pass
        case Binary:
            lhs = macro_integer(left)
            rhs = macro_integer(right)
            if lhs.known:
                if rhs.known:
                    order = integer_spelling.compare(lhs.value, rhs.value)
                    if operator.symbol == "==":
                        return MacroCondition(true, order == 0)
                    if operator.symbol == "!=":
                        return MacroCondition(true, order != 0)
                    if operator.symbol == "<":
                        return MacroCondition(true, order < 0)
                    if operator.symbol == ">":
                        return MacroCondition(true, order > 0)
                    if operator.symbol == "<=":
                        return MacroCondition(true, order <= 0)
                    if operator.symbol == ">=":
                        return MacroCondition(true, order >= 0)
        case _:
            pass
    return MacroCondition(false)


def macro_block(block: universal.Block) -> universal.Block:
    result = universal.empty_block()
    for statement in block.statements:
        match statement:
            case If:
                condition_value = macro_condition(condition)
                if condition_value.known:
                    chosen = macro_block(then_block if condition_value.value else else_block)
                    for selected in chosen.statements:
                        result.statements.append(selected)
                        match selected:
                            case Return:
                                return result
                            case _:
                                pass
                else:
                    result.statements.append(universal.If(condition, macro_block(then_block), macro_block(else_block), span))
            case Return:
                result.statements.append(statement)
                return result
            case _:
                result.statements.append(statement)
    return result


def macro_instance(definition: ScalarMacro, types: list[scalar.ScalarType], output: universal.Module):
    suffix := ""
    for type in types:
        suffix += "$" + type.name
    tokens: list[lexer.Token] = []
    cursor := 0
    while cursor < len(definition.tokens):
        token = definition.tokens[cursor]
        cursor += 1
        replacement := token
        match token.kind:
            case Identifier:
                value = string(token)
                index := 0
                for binding in definition.bindings:
                    if value == binding:
                        replacement = lexer.token_from_lexeme(lexer.TokenKind.Identifier, token.lexeme, types[index].name)
                        if cursor + 1 < len(definition.tokens) and lexer.token_is_symbol(definition.tokens[cursor], "."):
                            match definition.tokens[cursor + 1].kind:
                                case Identifier:
                                    replacement = macro_property(types[index], string(definition.tokens[cursor + 1]), token.lexeme)
                                case _:
                                    throw Error("expected scalar type property")
                            cursor += 2
                    index += 1
                if value in definition.functions:
                    replacement = lexer.token_from_lexeme(lexer.TokenKind.Identifier, token.lexeme, value + suffix)
            case _:
                pass
        tokens.append(replacement)
    end = definition.tokens[-1].span
    eof_span = source.Span(end.source, end.end, end.end)
    tokens.append(lexer.token_from_lexeme(Eof, lexer.Lexeme("", eof_span)))
    expanded = parser.parse(tokens)
    for item in expanded.items:
        match item:
            case Function:
                function := declaration
                body ?= function.body
                if body != None:
                    function.body = macro_block(body)
                output.items.append(universal.Function(function))
            case Test:
                test_declaration := declaration
                test_declaration.body = macro_block(declaration.body)
                output.items.append(universal.Test(test_declaration))
            case OperatorItem:
                operation := declaration
                body ?= operation.body
                if body != None:
                    operation.body = macro_block(body)
                output.items.append(universal.OperatorItem(operation))
            case _:
                throw Error("enumerative macro bodies must emit functions, operators or tests")


def macro_family(name: string, environment: family_definitions.SemanticDefinitions, span: source.Span) -> list[scalar.ScalarType] | diagnostics.Diagnostic:
    members: list[scalar.ScalarType] = []
    declared ?= family_definitions.alias_named(environment, name, "")
    if declared == None and (name == "int" or name == "float"):
        for type in scalar.scalar_types():
            if conversions.scalar_numeric(type.id) and ((name == "float") == (type.representation == "float")):
                members.append(type)
        return members
    for id in family_definitions.family_members(environment, universal.named_type(name, [], span), [], ""):
        type ?= scalar.scalar_type(id)
        if type == None:
            return error(diagnostics.diagnostic_at("E000205", "enumerative macro requires primitive type metadata", span))
        if type != None:
            members.append(type)
    return members


def macro_enumerate(definition: ScalarMacro, types: list[scalar.ScalarType], output: universal.Module, environment: family_definitions.SemanticDefinitions) -> unit | diagnostics.Diagnostic:
    if len(types) == len(definition.bindings):
        macro_instance(definition, types, output)
        return
    family = definition.families[len(types)]
    for type in macro_family(family, environment, definition.tokens[0].span):
        selected = types[:]
        selected.append(type)
        macro_enumerate(definition, selected, output, environment)


def parse_module(tokens: list[lexer.Token]) -> universal.Module | diagnostics.Diagnostic:
    input = parser.Parser(tokens)
    definitions: list[ScalarMacro] = []
    ordinary: list[lexer.Token] = []
    expanded = universal.empty_module()
    invoked: list[string] = []
    depth := 0
    line_start := true
    while not parser.parser_at_simple(input, Eof):
        if depth == 0 and line_start and parser.parser_at_symbol(input, "->"):
            definition = macro_definition(input)
            for previous in definitions:
                if previous.name == definition.name:
                    return error(diagnostics.diagnostic_at("E000120", "duplicate enumerative macro " + definition.name, parser.parser_peek(input).span))
            definitions.append(definition)
            continue
        invocation := false
        if depth == 0 and line_start:
            for definition in definitions:
                if parser.parser_at_identifier(input, definition.name):
                    if definition.name in invoked:
                        return error(diagnostics.diagnostic_at("E000120", "duplicate macro expansion " + definition.name, parser.parser_peek(input).span))
                    invoked.append(definition.name)
                    parser.parser_next(input)
                    parser.parser_expect_symbol(input, "[", "expected macro family arguments")
                    index := 0
                    for family in definition.families:
                        if index > 0:
                            parser.parser_expect_symbol(input, ",", "expected macro family separator")
                        if macro_identifier(input) != family:
                            return error(diagnostics.diagnostic_at("E000120", "macro argument must name its constrained family", parser.parser_peek(input).span))
                        index += 1
                    parser.parser_expect_symbol(input, "]", "expected end of macro family arguments")
                    parser.parser_expect_symbol(input, "(", "expected macro invocation")
                    parser.parser_expect_symbol(input, ")", "enumerative macros take no runtime arguments")
                    parser.parser_expect(input, Newline, "macro invocation must occupy a statement")
                    invocation = true
        if not invocation:
            token = parser.parser_next(input)
            if token.kind == Indent:
                depth += 1
            elif token.kind == Dedent:
                depth -= 1
            line_start = token.kind == Newline or token.kind == Dedent
            ordinary.append(token)
    ordinary.append(parser.parser_next(input))
    result = parser.parse(ordinary)
    environment = family_definitions.SemanticDefinitions()
    for item in result.items:
        match item:
            case Type:
                environment.aliases.append(declaration)
            case _:
                pass
    for name in invoked:
        for definition in definitions:
            if definition.name == name:
                macro_enumerate(definition, [], expanded, environment)
    for item in expanded.items:
        result.items.append(item)
    return result
