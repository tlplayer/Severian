    grammar_scalar.resolve(state.declarations, state.records)
    for record in state.records[existing_records:]:
        if definitions.record_instance(state.declarations, record.type_id) != None:
            continue
        if record.name.starts_with("$outcome$") or record.name.starts_with("$union$") or record.storage_element.index != 0:
            continue
        resolved_fields: list[universal.FunctionParameter] = []
        field_names: list[string] = []
        for field in record.fields:
            if field.name in field_names:
                return error(callable_diagnostic("duplicate field " + field.name, field.span))
            field_names.append(field.name)
