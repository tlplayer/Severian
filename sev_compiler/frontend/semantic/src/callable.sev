    if len(captured) == 0 and len(prepared) == 0:
        captured.append(PreludeAnalysis(module, state.declarations, state.templates, state.generics, state.constants, state.names, state.types, state.mutables, state.next_id, state.registered_methods))
    return module


def callable_implicit_field(state: CallableAnalysis, name: string, span: source.Span) -> universal.Expression | None:
    for record in state.records:
        if record.type_id.index == state.owner.index:
            for field in record.fields:
                if field.name == name:
                    receiver = universal.Expression(universal.Name("self"), span)
                    return universal.Expression(universal.Member(receiver, name), span)
    return None


def callable_receiver(state: CallableAnalysis, callee: universal.Expression) -> universal.Expression | diagnostics.Diagnostic:
    match callee.kind:
        case Member:
            return callable_expression(state, object, universal.TypeId(0))
        case _:
            return callable_expression(state, universal.Expression(universal.Name("self"), callee.span), state.owner)


def callable_method(state: CallableAnalysis, callee: universal.Expression, argument_count: int = -1) -> CallableOptionalFunction | diagnostics.Diagnostic:
    owner := state.owner
    member := ""
    match callee.kind:
        case Member:
            owner = callable_hint(state, object)
            member = name
        case Name:
            if name in state.names:
                return CallableOptionalFunction()
            member = name
        case _:
            return CallableOptionalFunction()
    implicit := false
    match callee.kind:
        case Name:
            implicit = true
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return callable_owner_method(state, owner, member, argument_count, implicit, callee.span)


def callable_owner_method(state: CallableAnalysis, owner: universal.TypeId, member: string, argument_count: int, implicit: bool, span: source.Span) -> CallableOptionalFunction | diagnostics.Diagnostic:
    callable_register_record_methods(state, owner)
    if owner.index >= 100000:
        required = callable_required_member(state, owner, member)
        return required
    if owner.index != 0:
        for function in state.functions:
            if not function.constructor and function.owner_type.index == owner.index and function.name.split(".")[-1] == member and (not implicit or callable_accepts_arity(function, argument_count + 1)):
                return CallableOptionalFunction(function)
    for record in state.records:
        if record.type_id.index == owner.index:
            for function in state.functions:
                if not function.constructor and function.name == record.name + "." + member and (not implicit or callable_accepts_arity(function, argument_count + 1)):
                    return CallableOptionalFunction(function)
    selected: universal.FunctionDeclaration | None := None
    for template in state.generics:
        if not template.extension or template.name.split(".")[-1] != member or owner.index == 0:
            continue
        if implicit and not callable_accepts_arity(template, argument_count + 1):
            continue
        actuals: list[universal.TypeId] = []
        for parameter in template.type_parameters:
            actuals.append(universal.TypeId(0))
        namespace := ""
        lookup ?= template.lookup
        if lookup != None:
            namespace = lookup
        inferred ?= callable_infer_annotation(state, template.parameters[0].annotation, owner, template.type_parameters, actuals, namespace)
        if inferred is Diagnostic:
            continue
        candidate = callable_specialize_generic(state, template, actuals)
        if candidate.parameter_types[0].index != owner.index:
            continue
        if selected != None:
            return error(callable_diagnostic("ambiguous extension method " + member, span))
        selected = candidate
    return CallableOptionalFunction(selected)


def callable_scope(state: CallableAnalysis) -> CallableAnalysis:
    return CallableAnalysis(state.names[:], state.types[:], state.functions, next_id=state.next_id, namespace=state.namespace, mutables=state.mutables[:], constants=state.constants, templates=state.templates, records=state.records, owner=state.owner, loop_depth=state.loop_depth, declarations=state.declarations, generics=state.generics, contract=state.contract, refinements=state.refinements[:], transitions=state.transitions[:], dead=state.dead[:], resources=state.resources[:], drop_cache=state.drop_cache, deferred=state.deferred[:], loop_defer_start=state.loop_defer_start, loop_resource_start=state.loop_resource_start, destructor=state.destructor, test_context=state.test_context, unsafe_depth=state.unsafe_depth, loans=state.loans[:], readonly=state.readonly[:], borrowed_parameters=state.borrowed_parameters[:], result_mode=state.result_mode, result_origin=state.result_origin, uninitialized=state.uninitialized[:], moved_elements=state.moved_elements[:], projecting=state.projecting, initializing=state.initializing, parameter_effects=state.parameter_effects, closures=state.closures, source_files=state.source_files, excluded_functions=state.excluded_functions, prelude_sources=state.prelude_sources, function_index=state.function_index, generic_index=state.generic_index, template_index=state.template_index, registered_methods=state.registered_methods, return_type=state.return_type, catching_error=state.catching_error, mock_functions=state.mock_functions[:], attachments=state.attachments[:], required_functions=state.required_functions, body_cache=state.body_cache)


def callable_terminates(block: universal.Block) -> bool:
    for statement in block.statements:
        match statement:
            case Return:
                return true
            case Break:
                return true
            case Continue:
                return true
            case GrammarApply:
                if exits:
                    return true
                if len(bodies) == 2 and callable_terminates(bodies[0]) and callable_terminates(bodies[1]):
                    return true
            case If:
                match condition.kind:
                    case LiteralValue:
                        match value:
                            case BooleanValue:
                                if value and callable_terminates(then_block):
                                    return true
                                if not value and callable_terminates(else_block):
                                    return true
                            case _:
                                throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                    case _:
                        throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                if callable_terminates(then_block) and callable_terminates(else_block):
                    return true
            case _:
                throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return false


def callable_owner(state: CallableAnalysis, function: universal.FunctionDeclaration) -> universal.TypeId:
    if function.constructor:
        return universal.TypeId(0)
    if function.owner_type.index != 0:
        return function.owner_type
    for record in state.records:
        for method in record.methods:
            qualified := record.name + "." + method.name
            if method.name.starts_with(record.name + "."):
                qualified = method.name
            if function.name == qualified:
                return record.type_id
    return universal.TypeId(0)


def callable_iteration(state: CallableAnalysis, name: string, iterable: universal.Expression, body: universal.Block, span: source.Span, result_type: universal.TypeId) -> universal.Block | diagnostics.Diagnostic:
    output = universal.empty_block()
    prefix = "$iteration$" + string(state.next_id[0])
    state.next_id[0] += 1
    receiver_binding = callable_binding(state, universal.Binding(prefix, None, iterable, false, false, span))
    output.statements.append(universal.BindingStatement(receiver_binding))
    receiver = universal.Expression(universal.BindingReference(receiver_binding.id), span, type_id=receiver_binding.type_id)
    start = callable_protocol(state, "Iteration", "start", [receiver], span)
    cursor_binding = callable_binding(state, universal.Binding(prefix + "$cursor", None, start, false, false, span, mutable=true))
    output.statements.append(universal.BindingStatement(cursor_binding))
    cursor = universal.Expression(universal.BindingReference(cursor_binding.id), span, type_id=cursor_binding.type_id)
    condition = callable_protocol(state, "Iteration", "condition", [receiver, cursor], span, universal.bool_type_id())
    item = callable_protocol(state, "Iteration", "access", [receiver, cursor], span)
    next = callable_protocol(state, "Iteration", "advance", [receiver, cursor], span, cursor.type_id)
    local = callable_scope(state)
    local.loop_depth += 1
    local.loop_defer_start = int(len(local.deferred))
    local.loop_resource_start = int(len(local.resources))
    iteration = universal.Binding(name, None, item, false, false, span)
    statements: list[universal.Statement] = [universal.BindingStatement(iteration)]
    for statement in body.statements:
        statements.append(statement)
    loop_body = callable_block(local, statements, result_type, false)
    advance = callable_control(state, "Assign", [cursor, next], [], span)
    output.statements.append(callable_control(state, "For", [condition], [loop_body, universal.Block([advance])], span))
    remaining: list[loans.Loan] = []
    for loan in state.loans:
        if loan.borrower != int(receiver_binding.id.index):
            remaining.append(loan)
    state.loans = remaining
    return output


def callable_body(state: CallableAnalysis, function: universal.FunctionDeclaration) -> universal.Block | diagnostics.Diagnostic:
    function = lazy_bodies.load(function, state.body_cache)
    origin ?= function.template
    if origin != None:
        for template in state.generics:
            if template.definition.declaration.value == origin.declaration.value:
                arguments: list[universal.TypeId] = []
                for binding in function.type_arguments:
                    arguments.append(binding.type_id)
                state = callable_generic_environment(state, template, arguments)
                state.contract = None
    local = CallableAnalysis(functions=state.functions, constants=state.constants, templates=state.templates, records=state.records, owner=callable_owner(state, function), declarations=state.declarations, generics=state.generics, contract=state.contract, source_files=state.source_files, excluded_functions=state.excluded_functions, prelude_sources=state.prelude_sources, function_index=state.function_index, generic_index=state.generic_index, template_index=state.template_index, registered_methods=state.registered_methods, required_functions=state.required_functions, body_cache=state.body_cache)
    local.destructor = function.name.ends_with(".drop")
    if local.destructor and (function.result_type.index != 2 or len(function.parameters) != 1):
        return error(callable_diagnostic("destructor must take only self and return non-throwing unit", function.span))
    local.test_context = function.name.starts_with("__test_") or function.name.starts_with("$case$")
    local.return_type = function.result_type
    local.mock_functions = function.mock_functions[:]
    local.result_mode = function.result_mode
    local.result_origin = function.result_origin
    namespace ?= function.lookup
    if namespace != None:
        local.namespace = namespace
    for parameter in function.parameters:
        binding = int(len(local.names))
        for modifier in parameter.modifiers:
            if modifier.name == "borrow":
                local.readonly.append(binding)
            if modifier.name in ["borrow", "borrow mut"]:
                local.borrowed_parameters.append(binding)
            if modifier.name == "move" and callable_has_drop(state, function.parameter_types[binding]) and not local.destructor:
                local.resources.append(binding)
        local.names.append(parameter.name)
        local.mutables.append(true)
    if function.owner_type.index != 0:
        local.declarations = definitions.SemanticDefinitions(local.declarations.aliases[:], local.declarations.traits, local.declarations.implementations, record_templates=local.declarations.record_templates, record_instances=local.declarations.record_instances, expression_functions=local.declarations.expression_functions)
        for record in state.records:
            if record.type_id.index == function.owner_type.index:
                local.declarations.aliases.append(universal.TypeDeclaration([], local.namespace + "Self", [], [], None, record.span, id=function.owner_type))
    local.types = function.parameter_types[:]
    callable_record_environment(local, function.owner_type)
    for attachment in function.attachments:
        if attachment.role != universal.AttachmentRole.Dispatch:
            # Resolve in the parameter scope once. A nested binding with the
            # same spelling cannot retarget a function contract later.
            condition = callable_expression(callable_scope(local), attachment.condition, universal.bool_type_id())
            local.attachments.append(universal.WithAttachment(attachment.role, condition, attachment.stage, attachment.interface))
    body ?= function.body
    if body != None:
        entry = universal.empty_block()
        entry.span = body.span
        callable_contract_checks(local, entry, universal.AttachmentRole.Entry)
        callable_contract_checks(local, entry, universal.AttachmentRole.Fix)
        resolved = callable_block(local, body.statements, function.result_type, origin=body.span)
        for statement in resolved.statements:
            entry.statements.append(statement)
        return entry
    return universal.empty_block()


def callable_record_layout(records: list[universal.RecordDeclaration], type_id: universal.TypeId, ancestors: list[int]):
    if type_id.index < 1000:
        return
    identity = int(type_id.index)
    if identity in ancestors:
        throw Error("recursive value record requires indirection")
    path = ancestors[:]
    path.append(identity)
    for record in records:
        if record.type_id.index == type_id.index:
            for field in record.fields:
                callable_record_layout(records, field.type_id, path)


def callable_replace_signature(function: universal.FunctionDeclaration, names: list[string], replacements: list[universal.TypeAnnotation]) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
    parameters: list[universal.FunctionParameter] = []
    for parameter in function.parameters:
        annotation = definitions.replace_annotation(parameter.annotation, names, replacements)
        parameters.append(universal.FunctionParameter(parameter.name, annotation, parameter.default, parameter.span, modifiers=parameter.modifiers, variadic=parameter.variadic, keyword_only=parameter.keyword_only))
    result: universal.TypeAnnotation | None := None
    annotation ?= function.result
    if annotation != None:
        result = definitions.replace_annotation(annotation, names, replacements)
    return universal.FunctionDeclaration(decorators=function.decorators, name=function.name, parameters=parameters, result=result, body=function.body, span=function.span, lookup=function.lookup, operator_syntax=function.operator_syntax, owner_type=function.owner_type, definition=function.definition, extension=function.extension, result_mode=function.result_mode, result_origin=function.result_origin, attachments=function.attachments[:], semantic_key=function.semantic_key, lazy_body=function.lazy_body, prelude=function.prelude)


def callable_register_aliases(state: CallableAnalysis) -> unit | diagnostics.Diagnostic:
    index := 0
    for alias in state.declarations.aliases:
        if len(alias.type_parameters) != 0:
            index += 1
            continue
        target ?= alias.definition
        if target != None:
            match target.kind:
                case Union:
                    definitions.family_members(state.declarations, target, state.records, alias.lookup, [alias.name])
                case _:
                    alias.id = callable_annotation(target, state.records, alias.lookup, state.declarations)
                    state.declarations.aliases[index] = alias
        index += 1


def callable_operator_function(operation: universal.OperatorDeclaration, owner: universal.TypeId, namespace: string, records: list[universal.RecordDeclaration]) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
    receiver_type = universal.named_type(definitions.type_name(owner, records), [], operation.span)
    parameters: list[universal.FunctionParameter] = []
    if operation.receiver:
        parameters.append(universal.FunctionParameter("self", receiver_type, None, operation.span))
    for parameter in operation.parameters:
        annotation = definitions.replace_annotation(parameter.annotation, ["Self"], [receiver_type])
        parameters.append(universal.FunctionParameter(parameter.name, annotation, None, parameter.span, modifiers=[universal.BoundaryModifier(parameter.mode)] if parameter.mode != "" else []))
    result = definitions.replace_annotation(operation.result, ["Self"], [receiver_type])
    key = universal.semantic_key([universal.definition_identity(operation.definition), "operator-realization", definitions.type_name(owner, records) if owner.index != 0 else "global"])
    return universal.FunctionDeclaration(name=namespace + "$operator$" + string(operation.definition.declaration.value) + "$" + string(owner.index), parameters=parameters, result=result, body=operation.body, span=operation.span, lookup=namespace, operator_syntax=operation.syntax, owner_type=owner, definition=universal.definition_from_key(key), type_parameters=operation.type_parameters, constraints=operation.constraints, result_mode=operation.result_mode, semantic_key=key)


def callable_same_types(left: list[universal.TypeId], right: list[universal.TypeId]) -> bool | diagnostics.Diagnostic:
    if len(left) != len(right):
        return false
    index := 0
    for type_id in left:
        if type_id.index != right[index].index:
            return false
        index += 1
    return true


def callable_register_operators(state: CallableAnalysis, module: universal.Module, first: int = 0) -> unit | diagnostics.Diagnostic:
    ordinal := first
    for item in module.items:
        match item:
            case OperatorItem:
                namespace := ""
                operation_span = declaration.span
                for source_item in borrow module.items:
                    match source_item:
                        case Function:
                            origin ?= declaration.span
                            if origin != None:
                                if origin.source.index == operation_span.source.index:
                                    lookup ?= declaration.lookup
                                    if lookup != None:
                                        namespace = lookup
                        case _:
                            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                operation = definitions.resolve_operator_constraints(state.declarations, declaration, namespace)
                if operation.definition.declaration.value == 0:
                    operation.definition = definitions.definition_id(operation.syntax.symbol, 10000 + ordinal)
                ordinal += 1
                function = callable_operator_function(operation, universal.TypeId(0), namespace, state.records)
                if len(function.type_parameters) != 0:
                    callable_register_generic(state, function)
                    continue
                signature = callable_signature(function, int(len(state.functions)), state.records, state.declarations)
                for previous in borrow state.functions:
                    syntax ?= previous.operator_syntax
                    if syntax != None:
                        if syntax.symbol == operation.syntax.symbol and callable_same_types(previous.parameter_types, signature.parameter_types):
                            return error(diagnostics.diagnostic_at("E000212", "ambiguous operator implementation " + syntax.symbol, operation.span))
                state.functions.append(signature)
            case Record:
                if declaration.extension and len(declaration.type_parameters) != 0:
                    if len(declaration.fields) != 0 or len(declaration.operators) != 0 or len(declaration.traits) != 0:
                        return error(callable_diagnostic("generic extensions currently declare methods", declaration.span))
                    receiver = definitions.extension_annotation(declaration)
                    for method in declaration.methods:
                        function := callable_replace_signature(method, ["Self"], [receiver])
                        function.name = declaration.lookup + "$extension$" + string(ordinal) + "." + method.name
                        ordinal += 1
                        function.extension = true
                        function.lookup = declaration.lookup
                        function.type_parameters = declaration.type_parameters[:]
                        function.constraints = declaration.constraints[:]
                        for constraint in method.constraints:
                            function.constraints.append(constraint)
                        if len(method.type_parameters) != 0:
                            return error(callable_diagnostic("generic extension method parameters require call argument inference", method.span))
                        parameters = [universal.FunctionParameter("self", receiver, None, declaration.span)]
                        for parameter in function.parameters:
                            if parameter.name == "self":
                                parameters[0] = parameter
                            else:
                                parameters.append(parameter)
                        function.parameters = parameters
                        callable_register_generic(state, function)
                    continue
                owners: list[universal.TypeId] := []
                if declaration.extension or definitions.alias_named(state.declarations, declaration.name, declaration.lookup) != None:
                    owners = definitions.family_members(state.declarations, definitions.extension_annotation(declaration), state.records, declaration.lookup)
                    if len(declaration.fields) != 0:
                        return error(diagnostics.diagnostic_at("E000212", "extensions cannot add stored fields", declaration.span))
                else:
                    for record in state.records:
                        if record.name == declaration.name:
                            owners.append(record.type_id)
                for owner in owners:
                    for operation in declaration.operators:
                        operation = definitions.resolve_operator_constraints(state.declarations, operation, declaration.lookup)
                        if len(operation.type_parameters) != 0 or len(operation.constraints) != 0:
                            return error(diagnostics.diagnostic_at("E000212", "generic operator implementations require operator argument inference", operation.span))
                        if operation.definition.declaration.value == 0:
                            operation.definition = definitions.definition_id(declaration.name, 10000 + ordinal)
                        ordinal += 1
                        function := callable_operator_function(operation, owner, declaration.lookup, state.records)
                        function.operator_syntax = definitions.resolve_grammar_binding(state.declarations, operation.syntax, declaration.lookup, operation.span)
                        if operation.syntax.domain == universal.OperatorDomain.GrammarOperator:
                            contract_definition ?= definitions.trait_named(state.declarations, operation.syntax.grammar_name, declaration.lookup)
                            if contract_definition != None:
                                if function.body == None:
                                    for inherited in definitions.inherited_traits(state.declarations, contract_definition):
                                        for method in inherited.methods:
                                            if method.name == "semantic" and method.body != None and function.body == None:
                                                if len(method.parameters) != len(function.parameters):
                                                    return error(diagnostics.diagnostic_at("E000212", "grammar semantic operand count does not match implementation", operation.span))
                                                receiver_annotation = universal.named_type(definitions.type_name(owner, state.records), [], operation.span)
                                                semantic_method = callable_replace_signature(method, ["Self"], [receiver_annotation])
                                                parameter_index := 0
                                                for parameter in semantic_method.parameters:
                                                    declared_type = callable_annotation(function.parameters[parameter_index].annotation, state.records, declaration.lookup, state.declarations)
                                                    semantic_type = callable_annotation(parameter.annotation, state.records, inherited.lookup, state.declarations)
                                                    if declared_type.index != semantic_type.index:
                                                        return error(diagnostics.diagnostic_at("E000212", "grammar semantic operand type does not match implementation", operation.span))
                                                    parameter_index += 1
                                                declared_result ?= function.result
                                                semantic_result ?= semantic_method.result
                                                if declared_result != None:
                                                    if semantic_result != None:
                                                        expected_result = callable_annotation(declared_result, state.records, declaration.lookup, state.declarations)
                                                        actual_result = callable_annotation(semantic_result, state.records, inherited.lookup, state.declarations)
                                                        if expected_result.index != actual_result.index:
                                                            return error(diagnostics.diagnostic_at("E000212", "grammar semantic result type does not match implementation", operation.span))
                                                function.parameters = semantic_method.parameters
                                                function.result = semantic_method.result
                                                function.body = semantic_method.body
                                                function.lookup = inherited.lookup
                        receiver_type = universal.named_type(definitions.type_name(owner, state.records), [], declaration.span)
                        family_names = [declaration.name, declaration.name.split(".")[-1]]
                        function = callable_replace_signature(function, family_names, [receiver_type, receiver_type])
                        signature = callable_signature(function, int(len(state.functions)), state.records, state.declarations)
                        for previous in state.functions:
                            syntax ?= previous.operator_syntax
                            if syntax != None:
                                if syntax.symbol == operation.syntax.symbol and callable_same_types(previous.parameter_types, signature.parameter_types):
                                    return error(diagnostics.diagnostic_at("E000212", "ambiguous operator implementation " + syntax.symbol, operation.span))
                        state.functions.append(signature)
                    if declaration.extension and len(declaration.methods) != 0:
                        for method in declaration.methods:
                            receiver_type = universal.named_type(definitions.type_name(owner, state.records), [], declaration.span)
                            function := callable_replace_signature(method, ["Self"], [receiver_type])
                            function.name = definitions.type_name(owner, state.records) + "." + method.name
                            function.owner_type = owner
                            function.extension = true
                            function.lookup = declaration.lookup
                            parameters = [universal.FunctionParameter("self", receiver_type, None, declaration.span)]
                            for parameter in function.parameters:
                                if parameter.name == "self":
                                    parameters[0] = parameter
                                else:
                                    parameters.append(parameter)
                            function.parameters = parameters
                            state.functions.append(callable_signature(function, int(len(state.functions)), state.records, state.declarations))
            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")


def callable_requirement_signature(state: CallableAnalysis, function: universal.FunctionDeclaration) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
    parameters: list[universal.TypeId] = []
    namespace := ""
    lookup ?= function.lookup
    if lookup != None:
        namespace = lookup
    for parameter in function.parameters:
        parameters.append(callable_annotation(parameter.annotation, state.records, namespace, state.declarations))
    function.parameter_types = parameters
    annotation ?= function.result
    function.result_type = universal.unit_type_id()
    if annotation != None:
        function.result_type = callable_annotation(annotation, state.records, namespace, state.declarations)
    return function


def callable_trait(state: CallableAnalysis, bound: universal.TypeAnnotation, namespace: string) -> universal.TraitDeclaration | diagnostics.Diagnostic:
    match bound.kind:
        case Named:
            resolved: list[universal.TypeAnnotation] = []
            for argument in arguments:
                type_id = callable_annotation(argument, state.records, namespace, state.declarations)
                resolved.append(universal.TypeAnnotation(universal.Named(definitions.type_name(type_id, state.records), []), argument.span, binding=argument.binding))
            return definitions.trait_application(state.declarations, universal.named_type(name, resolved, bound.span), namespace)
        case _:
            return error(callable_diagnostic("constraint must name a trait", bound.span))


def callable_parameter_traits(state: CallableAnalysis, type_id: universal.TypeId) -> list[universal.TraitDeclaration] | diagnostics.Diagnostic:
    result: list[universal.TraitDeclaration] = []
    contract ?= state.contract
    if contract != None:
        index := 0
        for parameter_name in contract.type_parameters:
            if type_id.index == callable_symbolic_parameter(contract, index).index:
                for constraint in contract.constraints:
                    match constraint:
                        case Parameter:
                            if parameter == parameter_name:
                                trait = callable_trait(state, bound, state.namespace)
                                for inherited in definitions.inherited_traits(state.declarations, trait):
                                    result.append(inherited)
                        case _:
                            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            index += 1
    return result


def callable_operator(state: CallableAnalysis, symbol: string, operands: list[universal.TypeId], span: source.Span) -> CallableOptionalFunction | diagnostics.Diagnostic:
    for operand in operands:
        callable_register_record_methods(state, operand)
    selected: universal.FunctionDeclaration | None := None
    for function in callable_index.matching_operators(state.function_index, state.functions, symbol):
        syntax ?= function.operator_syntax
        if syntax != None:
            if syntax.symbol == symbol and callable_same_types(function.parameter_types, operands):
                if selected != None:
                    return error(diagnostics.diagnostic_at("E000212", "ambiguous operator implementation " + symbol, span))
                selected = function
    if selected != None:
        return CallableOptionalFunction(selected)
    for template in callable_index.matching_operators(state.generic_index, state.generics, symbol):
        syntax ?= template.operator_syntax
        if syntax != None:
            if syntax.symbol != symbol or len(template.parameters) != len(operands):
                continue
            actuals: list[universal.TypeId] = []
            for parameter in template.type_parameters:
                actuals.append(universal.TypeId(0))
            namespace := ""
            lookup ?= template.lookup
            if lookup != None:
                namespace = lookup
            index := 0
            matched := true
            for parameter in template.parameters:
                inferred ?= callable_infer_annotation(state, parameter.annotation, operands[index], template.type_parameters, actuals, namespace)
                if inferred is Diagnostic:
                    matched = false
                index += 1
            if not matched:
                continue
            candidate = callable_specialize_generic(state, template, actuals)
            if callable_same_types(candidate.parameter_types, operands):
                if selected != None:
                    return error(diagnostics.diagnostic_at("E000212", "ambiguous generic operator implementation " + symbol, span))
                selected = candidate
    if selected != None:
        return CallableOptionalFunction(selected)
    symbolic := false
    for operand in operands:
        if operand.index >= 100000:
            symbolic = true
    if symbolic:
        for trait in callable_parameter_traits(state, operands[0]):
            for operation in trait.operators:
                if operation.syntax.symbol == symbol:
                    function = callable_requirement_signature(state, callable_operator_function(operation, operands[0], trait.lookup, state.records))
                    if callable_same_types(function.parameter_types, operands):
                        previous ?= selected
                        if previous != None:
                            if previous.result_type.index != function.result_type.index:
                                return error(diagnostics.diagnostic_at("E000219", "ambiguous generic operator requirement " + symbol, span))
                        function.type_arguments = [universal.TypeBinding(universal.GenericParamId(0), operands[0])]
                        selected = function
        if selected == None:
            return error(diagnostics.diagnostic_at("E000219", "generic operator use requires an explicit trait capability: " + symbol, span))
        return CallableOptionalFunction(selected)
    if selected == None and (len(operands) == 1 or len(operands) == 2):
        homogeneous := true
        for operand in operands:
            if operand.index != operands[0].index:
                homogeneous = false
        if homogeneous:
            lookup = grammar_scalar.lookup(state.declarations, symbol, int(len(operands)), operands[0])
            syntax ?= lookup.syntax
            if syntax != None:
                operation ?= syntax.scalar_operation
                if operation != None:
                    parameters: list[universal.FunctionParameter] = []
                    for index in range(int(len(operands))):
                        annotation = universal.named_type(definitions.type_name(operands[index], state.records), [], span)
                        parameters.append(universal.FunctionParameter("operand" + string(index), annotation, None, span, type_id=operands[index]))
                    result_type = universal.bool_type_id() if operation.predicate >= 0 else operands[0]
                    selected = universal.FunctionDeclaration(parameters=parameters, parameter_types=operands, result_type=result_type, operator_syntax=syntax, definition=syntax.definition)
    return CallableOptionalFunction(selected)


def callable_resolved_operator(state: CallableAnalysis, function: universal.FunctionDeclaration, operands: list[universal.Expression], span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    if len(operands) != len(function.parameter_types):
        return error(diagnostics.diagnostic_at("E000212", "operator or member argument count mismatch", span))
    if expected.index != 0 and expected.index != function.result_type.index:
        return error(diagnostics.diagnostic_at("E000212", "operator result does not match expected type", span))
    scalar_syntax ?= function.operator_syntax
    if scalar_syntax != None:
        if scalar_syntax.scalar_operation != None:
            kind: universal.ExpressionKind := universal.Unary(scalar_syntax, operands[0])
            if len(operands) == 2:
                kind = universal.Binary(scalar_syntax, operands[0], operands[1])
            id = universal.HirId(u32(state.next_id[0]))
            state.next_id[0] += 1
            return universal.Expression(kind, span, id, function.result_type)
    arguments: list[universal.CallArgument] = []
    index := 0
    for operand in operands:
        if operand.type_id.index != function.parameter_types[index].index:
            return error(diagnostics.diagnostic_at("E000212", "operator operand type mismatch", span))
        arguments.append(universal.CallArgument(function.parameters[index].name, callable_parameter_value(state, function.parameters[index], operand, function.parameter_types[index]), operand.span))
        index += 1
    id = universal.HirId(u32(state.next_id[0]))
    state.next_id[0] += 1
    resolved = universal.Expression(universal.ResolvedCall(universal.Direct(lazy_bodies.require(state.required_functions, function.definition), universal.Substitution(function.type_arguments)), arguments), span, id, function.result_type)
    syntax ?= function.operator_syntax
    if syntax != None:
        if syntax.domain == universal.OperatorDomain.GrammarOperator:
            resolved.grammar = syntax.definition
    return callable_borrowed_result(function, arguments, resolved)


def callable_required_member(state: CallableAnalysis, owner: universal.TypeId, name: string) -> CallableOptionalFunction | diagnostics.Diagnostic:
    selected: universal.FunctionDeclaration | None := None
    for trait in callable_parameter_traits(state, owner):
        for method in trait.methods:
            if method.name == name:
                receiver_type = universal.named_type(definitions.type_name(owner, state.records), [], trait.span)
                function := callable_replace_signature(method, ["Self"], [receiver_type])
                parameters = [universal.FunctionParameter("self", receiver_type, None, trait.span)]
                for parameter in function.parameters:
                    parameters.append(parameter)
                function.parameters = parameters
                function.lookup = trait.lookup
                function = callable_requirement_signature(state, function)
                previous ?= selected
                if previous != None:
                    if not callable_same_types(previous.parameter_types, function.parameter_types) or previous.result_type.index != function.result_type.index:
                        return error(diagnostics.diagnostic_at("E000212", "ambiguous trait member " + name, trait.span))
                selected = function
    return CallableOptionalFunction(selected)


def callable_satisfies(state: CallableAnalysis, type_id: universal.TypeId, trait: universal.TraitDeclaration) -> bool | diagnostics.Diagnostic:
    if type_id.index >= 100000:
        for available in callable_parameter_traits(state, type_id):
            if expansion.same(available.definition, trait.definition) and len(available.arguments) == len(trait.arguments):
                equal := true
                index := 0
                for argument in available.arguments:
                    left = callable_annotation(argument, state.records, available.lookup, state.declarations)
                    right = callable_annotation(trait.arguments[index], state.records, trait.lookup, state.declarations)
                    equal = equal and left.index == right.index
                    index += 1
                if equal:
                    return true
        return false
    callable_register_record_methods(state, type_id)
    for required in definitions.inherited_traits(state.declarations, trait):
        for operation in required.operators:
            signature = callable_requirement_signature(state, callable_operator_function(operation, type_id, required.lookup, state.records))
            operator_lookup = callable_operator(state, operation.syntax.symbol, signature.parameter_types, operation.span)
            implementation ?= operator_lookup.function
            if implementation == None:
                return false
            if implementation != None:
                if implementation.result_type.index != signature.result_type.index:
                    return false
        for method in required.methods:
            found := false
            receiver_type = universal.named_type(definitions.type_name(type_id, state.records), [], required.span)
            signature := callable_replace_signature(method, ["Self"], [receiver_type])
            parameters = [universal.FunctionParameter("self", receiver_type, None, required.span)]
            for parameter in signature.parameters:
                parameters.append(parameter)
            signature.parameters = parameters
            signature.lookup = required.lookup
            signature = callable_requirement_signature(state, signature)
            for function in state.functions:
                if function.owner_type.index == type_id.index and function.name.split(".")[-1] == method.name:
                    if callable_same_types(function.parameter_types, signature.parameter_types) and function.result_type.index == signature.result_type.index:
                        found = true
            if not found:
                # Generic extension methods satisfy the same contract as
                # methods declared directly on a record.
                lookup = callable_owner_method(state, type_id, method.name, len(signature.parameters) - 1, false, required.span)
                implementation ?= lookup.function
                if implementation != None:
                    found = callable_same_types(implementation.parameter_types, signature.parameter_types) and implementation.result_type.index == signature.result_type.index
            if not found:
                return false
        for property in required.properties:
            found := false
            receiver_type = universal.named_type(definitions.type_name(type_id, state.records), [], required.span)
            annotation = definitions.replace_annotation(property.annotation, ["Self"], [receiver_type])
            expected = callable_annotation(annotation, state.records, required.lookup, state.declarations)
            for record in state.records:
                if record.type_id.index == type_id.index:
                    for field in record.fields:
                        if field.name == property.name and field.type_id.index == expected.index:
                            found = true
            if not found:
                return false
    return true


def callable_validate_implementations(state: CallableAnalysis) -> unit | diagnostics.Diagnostic:
    for declaration in state.declarations.implementations:
        if declaration.extension and len(declaration.type_parameters) != 0:
            continue
        owners: list[universal.TypeId] := []
        if declaration.extension or definitions.alias_named(state.declarations, declaration.name, declaration.lookup) != None:
            owners = definitions.family_members(state.declarations, definitions.extension_annotation(declaration), state.records, declaration.lookup)
        else:
            for record in state.records:
                if record.name == declaration.name:
                    owners.append(record.type_id)
        for owner in owners:
            for bound in declaration.traits:
                trait = callable_trait(state, bound, declaration.lookup)
                if not callable_satisfies(state, owner, trait):
                    return error(diagnostics.diagnostic_at("E000212", "class does not satisfy trait " + trait.name, bound.span))



def callable_register_generic(state: CallableAnalysis, function: universal.FunctionDeclaration) -> unit | diagnostics.Diagnostic:
    operation = boundary.scalar_boundary(function, "mlir")
    if (function.body == None and operation == "") or (len(function.decorators) != 0 and operation == ""):
        return error(diagnostics.diagnostic("E000219", "generic function requires a source body or typed MLIR boundary"))
    if len(function.type_parameters) > 256:
        return error(callable_diagnostic("generic parameter limit exceeded", function.span))
    names: list[string] = []
    for parameter in function.type_parameters:
        if parameter in names:
            return error(diagnostics.diagnostic("E000219", "duplicate generic parameter " + parameter))
        names.append(parameter)
    namespace := ""
    lookup ?= function.lookup
    if lookup != None:
        namespace = lookup
    for constraint in function.constraints:
        match constraint:
            case Parameter:
                if parameter not in names:
                    return error(diagnostics.diagnostic_at("E000219", "constraint names an unknown parameter", span))
                definitions.trait_application(state.declarations, bound, namespace)
            case _:
                return error(diagnostics.diagnostic("E000219", "predicate constraints require compile-time evaluation"))
    for previous in state.generics:
        if previous.name == function.name and not (previous.prelude and not function.prelude and function.name in state.excluded_functions):
            return error(diagnostics.diagnostic("E000219", "ambiguous generic overload " + function.name))
    if function.definition.declaration.value == 0:
        function.definition = definitions.definition_id(function.name, 20000 + int(len(state.generics)))
    state.generics.append(function)


def callable_generic_environment(state: CallableAnalysis, function: universal.FunctionDeclaration, arguments: list[universal.TypeId]) -> CallableAnalysis | diagnostics.Diagnostic:
    local = callable_scope(state)
    local.declarations = definitions.SemanticDefinitions(state.declarations.aliases[:], state.declarations.traits, state.declarations.implementations, record_templates=state.declarations.record_templates, record_instances=state.declarations.record_instances, expression_functions=state.declarations.expression_functions)
    local.contract = function
    lookup ?= function.lookup
    if lookup != None:
        local.namespace = lookup
    index := 0
    for name in function.type_parameters:
        span = function.parameters[0].span
        alias = universal.TypeDeclaration([], local.namespace + name, [], [], None, span, id=arguments[index], lookup=local.namespace)
        callable_prepend_alias(local.declarations, alias)
        canonical = universal.TypeDeclaration([], definitions.type_name(arguments[index], state.records), [], [], None, span, id=arguments[index])
        callable_prepend_alias(local.declarations, canonical)
        index += 1
    return local


def callable_validate_generics(state: CallableAnalysis, module: universal.Module, first: int = 0) -> unit | diagnostics.Diagnostic:
    for function in state.generics[first:]:
        if function.lazy_body != "":
            module.generic_functions.append(function)
            continue
        arguments: list[universal.TypeId] = []
        index := 0
        for name in function.type_parameters:
            arguments.append(callable_symbolic_parameter(function, index))
            index += 1
        local = callable_generic_environment(state, function, arguments)
        signature := callable_replace_signature(function, [], [])
        signature = callable_signature(signature, 0, state.records, local.declarations)
        signature.definition = function.definition
        signature.body = callable_body(local, signature)
        signature.type_parameters = function.type_parameters
        signature.constraints = function.constraints
        generic_parameters: list[universal.GenericParamId] = []
        generic_index := 0
        for name in function.type_parameters:
            generic_parameters.append(universal.GenericParamId(u32(generic_index)))
            generic_index += 1
        signature.generic_parameters = generic_parameters
        module.generic_functions.append(signature)


def callable_select_generic(state: CallableAnalysis, name: string, arguments: list[universal.CallArgument], expected: universal.TypeId = universal.TypeId(0), allow_prelude: bool = true) -> CallableOptionalSelection | diagnostics.Diagnostic:
    for template in callable_index.named(state.generic_index, state.generics, name, allow_prelude):
        if template.name != name or (not allow_prelude and template.prelude):
            continue
        bound = packs.bind_arguments(template, arguments)
        if bound.message != "":
            return error(diagnostics.diagnostic("E000219", bound.message))
        actuals: list[universal.TypeId] = []
        for parameter in template.type_parameters:
            actuals.append(universal.TypeId(0))
        for argument in bound.arguments:
            for parameter in template.parameters:
                if argument.name == parameter.name:
                    typed = callable_expression(callable_scope(state), argument.value, universal.TypeId(0))
                    namespace := ""
                    lookup ?= template.lookup
                    if lookup != None:
                        namespace = lookup
                    callable_infer_annotation(state, parameter.annotation, typed.type_id, template.type_parameters, actuals, namespace)
        result_annotation ?= template.result
        if result_annotation != None:
            if expected.index != 0:
                namespace := ""
                lookup ?= template.lookup
                if lookup != None:
                    namespace = lookup
                callable_infer_annotation(state, result_annotation, expected, template.type_parameters, actuals, namespace)
        signature = callable_specialize_generic(state, template, actuals)
        return CallableOptionalSelection(CallableSelection(signature, bound.arguments))
    return CallableOptionalSelection()


def callable_specialize_generic(state: CallableAnalysis, template: universal.FunctionDeclaration, actuals: list[universal.TypeId]) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
    suffix := ""
    symbolic := false
    substitution = universal.Substitution([])
    index := 0
    for actual in actuals:
        if actual.index == 0:
            return error(diagnostics.diagnostic("E000219", "generic parameter cannot be inferred"))
        symbolic = symbolic or callable_symbolic_type(state, actual)
        suffix += "$" + string(actual.index)
        substitution.arguments.append(universal.TypeBinding(universal.GenericParamId(u32(index)), actual))
        index += 1
    namespace := ""
    lookup ?= template.lookup
    if lookup != None:
        namespace = lookup
    local = callable_generic_environment(state, template, actuals)
    for constraint in template.constraints:
        match constraint:
            case Parameter:
                constraint_index := 0
                for name in template.type_parameters:
                    if parameter == name:
                        trait = callable_trait(local, bound, namespace)
                        if not callable_satisfies(state, actuals[constraint_index], trait):
                            return error(diagnostics.diagnostic_at("E000219", "type does not satisfy trait " + trait.name, span))
                    constraint_index += 1
            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    instance_name = template.name + "$generic" + suffix
    for function in state.functions:
        if function.name == instance_name:
            return function
    signature := callable_replace_signature(template, [], [])
    signature.name = instance_name
    signature = callable_signature(signature, int(len(state.functions)), state.records, local.declarations)
    signature.template = template.definition
    signature.type_arguments = substitution.arguments
    arguments_key: list[string] = [template.semantic_key, "specialization"]
    for actual in actuals:
        arguments_key.append(definitions.type_name(actual, state.records))
    signature.semantic_key = universal.semantic_key(arguments_key)
    signature.definition = universal.definition_from_key(signature.semantic_key)
    if symbolic:
        signature.definition = template.definition
    else:
        if callable_specialization_count(state) >= 1024:
            return error(diagnostics.diagnostic("E000219", "specialization limit exceeded"))
        state.functions.append(signature)
    return signature


def callable_mlir(state: CallableAnalysis, arguments: list[universal.CallArgument], span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    if len(arguments) == 0 or expected.index == 0 or expected.index >= 100000:
        return error(diagnostics.diagnostic_at("E000212", "mlir requires an operation and a concrete result type", span))
    operation = callable_path(arguments[0].value)
    if len(operation.split(".")) != 2:
        return error(diagnostics.diagnostic_at("E000212", "mlir operation must have a dialect and mnemonic", span))
    operands: list[universal.Expression] = []
    parameters: list[universal.FunctionParameter] = []
    index := 0
    for argument in arguments[1:]:
        if argument.name != None:
            return error(diagnostics.diagnostic_at("E000212", "MLIR keyword attributes require typed attribute lowering", span))
        operand = callable_expression(state, argument.value, universal.TypeId(0))
        if scalar.scalar_type(operand.type_id) == None:
            return error(diagnostics.diagnostic_at("E000212", "MLIR binding requires a primitive operand", span))
        operands.append(operand)
        annotation = universal.named_type(definitions.type_name(operand.type_id, state.records), [], span)
        parameters.append(universal.FunctionParameter("operand_" + string(index), annotation, None, span))
        index += 1
    result = universal.named_type(definitions.type_name(expected, state.records), [], span)
    decorator = universal.Decorator("mlir", [universal.DecoratorArgument("", universal.String(operation), span)], span)
    function = universal.FunctionDeclaration(decorators=[decorator], name="$mlir$" + string(len(state.functions)), parameters=parameters, result=result, span=span)
    signature = callable_signature(function, int(len(state.functions)), state.records, state.declarations)
    state.functions.append(signature)
    return callable_resolved_operator(state, signature, operands, span, expected)


def analyze_callables(module: universal.Module, include_tests: bool = false, initializer_namespace: string = "", source_files: list[source.SourceFile] = []) -> universal.Module | diagnostics.Diagnostic:
    return analyze_registered_callables(module, include_tests, [], [], [], definitions.SemanticDefinitions(), initializer_namespace, source_files)


def callable_prepend_alias(declarations: definitions.SemanticDefinitions, alias: universal.TypeDeclaration):
    aliases = [alias]
    for previous in declarations.aliases:
        if previous.name != alias.name:
            aliases.append(previous)
    declarations.aliases = aliases


def callable_required_property(state: CallableAnalysis, receiver: universal.Expression, name: string, span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    result_type := universal.TypeId(0)
    requirement := universal.DefId(0, 0, universal.DeclarationId(0))
    for trait in callable_parameter_traits(state, receiver.type_id):
        for property in trait.properties:
            if property.name == name:
                annotation = definitions.replace_annotation(property.annotation, ["Self"], [universal.named_type(definitions.type_name(receiver.type_id, state.records), [], span)])
                actual = callable_annotation(annotation, state.records, trait.lookup, state.declarations)
                if result_type.index != 0 and actual.index != result_type.index:
                    return error(diagnostics.diagnostic_at("E000219", "ambiguous trait property " + name, span))
                result_type = actual
                requirement = property.definition
    if result_type.index == 0:
        return error(diagnostics.diagnostic_at("E000219", "generic member requires an explicit trait property: " + name, span))
    if expected.index != 0 and expected.index != result_type.index:
        return error(diagnostics.diagnostic_at("E000219", "trait property does not match expected type", span))
    id = universal.HirId(u32(state.next_id[0]))
    state.next_id[0] += 1
    return universal.Expression(universal.RequiredMember(receiver, requirement, name), span, id, result_type)



def callable_truth(state: CallableAnalysis, expression: universal.Expression) -> universal.Expression | diagnostics.Diagnostic:
    value = callable_expression(state, expression, universal.TypeId(0))
    if value.type_id.index == 1:
        return value
    for record in state.records:
        if record.type_id.index == value.type_id.index:
            index := 0
            for variant in universal.outcome_variants(record):
                if int(variant.index) not in [6, 7] and not definitions.error_conformance(state.declarations, state.records, variant):
                    return universal.Expression(universal.OutcomeTest(value, index), expression.span, type_id=universal.bool_type_id())
                index += 1
    implementation = callable_operator(state, "if", [value.type_id], expression.span)
    function ?= implementation.function
    if function != None:
        return callable_resolved_operator(state, function, [value], expression.span, universal.bool_type_id())
    return error(callable_diagnostic("condition requires a truth protocol returning bool", expression.span))



def callable_control(state: CallableAnalysis, name: string, operands: list[universal.Expression], bodies: list[universal.Block], span: source.Span, exits: bool = false) -> universal.Statement | diagnostics.Diagnostic:
    definition ?= definitions.trait_named(state.declarations, name, "")
    if definition != None:
        if definition.grammar:
            syntax = universal.OperatorSyntax("", universal.Fixity.Prefix, 0, universal.Associativity.None, definition=definition.definition, grammar_name=definition.name)
            return universal.GrammarApply(syntax, operands, bodies, span, exits)
    return error(callable_diagnostic("missing source control grammar " + name, span))



def callable_semantic_expression(expression: universal.Expression, names: list[string], operands: list[universal.Expression]) -> universal.Expression | diagnostics.Diagnostic:
    match expression.kind:
        case Name:
            index := 0
            for parameter in names:
                if parameter == name:
                    return operands[index]
                index += 1
        case LiteralValue:
            return expression
        case Conditional:
            test = callable_semantic_expression(condition, names, operands)
            taken = callable_semantic_expression(then_value, names, operands)
            otherwise = callable_semantic_expression(else_value, names, operands)
            return universal.Expression(universal.Conditional(test, taken,otherwise), expression.span)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return error(callable_diagnostic("unsupported lazy semantic expression", expression.span))


def callable_success(state: CallableAnalysis, value: universal.Expression) -> universal.Expression | diagnostics.Diagnostic:
    for record in state.records:
        if record.type_id.index == value.type_id.index:
            for variant in universal.outcome_variants(record):
                if int(variant.index) not in [6, 7] and not definitions.error_conformance(state.declarations, state.records, variant):
                    return universal.Expression(universal.OutcomeUnwrap(value), value.span, type_id=variant)
    return value


def callable_protocol_name(state: CallableAnalysis, contract: string, property_name: string, span: source.Span) -> string | diagnostics.Diagnostic:
    definition ?= definitions.trait_named(state.declarations, contract, "")
    if definition != None:
        for property in definition.properties:
            if property.name == property_name:
                supplied ?= property.default
                if supplied != None:
                    match supplied.kind:
                        case LiteralValue:
                            match value:
                                case StringValue:
                                    return value
                                case _:
                                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                        case _:
                            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return error(callable_diagnostic("missing source protocol " + contract + "." + property_name, span))


def callable_protocol(state: CallableAnalysis, contract: string, property: string, operands: list[universal.Expression], span: source.Span, expected: universal.TypeId = universal.TypeId(0)) -> universal.Expression | diagnostics.Diagnostic:
    name = callable_protocol_name(state, contract, property, span)
    types: list[universal.TypeId] = []
    for operand in operands:
        types.append(operand.type_id)
    selected = callable_operator(state, name, types, span)
    function ?= selected.function
    if function != None:
        return callable_resolved_operator(state, function, operands, span, expected)
    return error(callable_diagnostic("missing source protocol implementation " + contract + "." + property, span))


# Type-valued subscripts in constructor position use the annotation resolver.
def callable_application_target(expression: universal.Expression) -> string:
    match expression.kind:
        case TypeApplication:
            return callable_path(target)
        case Subscript:
            return callable_path(object)
        case Slice:
            return callable_path(object)
        case _:
            return ""


def callable_explicit_generic(state: CallableAnalysis, callee: universal.Expression, allow_prelude: bool = true) -> CallableOptionalFunction | diagnostics.Diagnostic:
    name = callable_application_target(callee)
    if name == "" or name in state.names:
        return CallableOptionalFunction(None)
    lookup := name
    for template in state.generics:
        if template.name == state.namespace + name and (allow_prelude or not template.prelude):
            lookup = template.name
            break
    for template in state.generics:
        if template.name == lookup and (allow_prelude or not template.prelude):
            annotation = callable_type_expression(callee)
            match annotation.kind:
                case Named:
                    default_scope := ""
                    scope ?= template.lookup
                    if scope != None:
                        default_scope = scope
                    defaults = definitions.scoped_defaults(state.declarations, template.type_defaults, default_scope)
                    ordered = definitions.bind_type_arguments(template.type_parameters, arguments, annotation.span, defaults=defaults)
                    actuals: list[universal.TypeId] = []
                    for argument in ordered:
                        actuals.append(callable_annotation(argument, state.records, state.namespace, state.declarations))
                    return CallableOptionalFunction(callable_specialize_generic(state, template, actuals))
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return CallableOptionalFunction(None)


def callable_type_expression(expression: universal.Expression) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    match expression.kind:
        case LiteralValue:
            match value:
                case IntegerValue:
                    return universal.named_type(spelling, [], expression.span)
                case _:
                    return error(callable_diagnostic("expected a type or integer argument", expression.span))
        case Name:
            return universal.named_type(name, [], expression.span)
        case Member:
            return universal.named_type(callable_path(expression), [], expression.span)
        case Binary:
            if operator.symbol == "|":
                return universal.TypeAnnotation(universal.Union([callable_type_expression(left), callable_type_expression(right)]), expression.span)
            return error(callable_diagnostic("expected a type argument", expression.span))
        case Subscript:
            argument = callable_type_expression(index)
            return universal.named_type(callable_path(object), [argument], expression.span)
        case TypeApplication:
            return universal.named_type(callable_path(target), arguments, expression.span)
        case Slice:
            parameter ?= start
            argument ?= stop
            if parameter != None:
                if argument != None:
                    if step == None:
                        name = callable_path(parameter)
                        if name != "":
                            annotation = callable_type_expression(argument)
                            annotation.binding = name
                            return universal.named_type(callable_path(object), [annotation], expression.span)
            return error(callable_diagnostic("expected a named type argument", expression.span))
        case _:
            return error(callable_diagnostic("expected a type argument", expression.span))


def callable_constructor_type(state: CallableAnalysis, callee: universal.Expression) -> universal.TypeId | diagnostics.Diagnostic:
    match callee.kind:
        case SourceSymbol:
            for record in state.records:
                if expansion.same(record.definition, definition) and definitions.record_instance(state.declarations, record.type_id) == None:
                    return record.type_id
        case Subscript:
            name = callable_path(object)
            if name == "char" or definitions.bootstrap_storage_type(state.declarations, name, state.namespace) or definitions.record_template(state.declarations, name, state.namespace) != None or definitions.alias_named(state.declarations, name, state.namespace) != None:
                annotation = callable_type_expression(callee)
                resolved = callable_annotation(annotation, state.records, state.namespace, state.declarations)
                callable_record_layout(state.records, resolved, [])
                return resolved
        case TypeApplication:
            name = callable_path(target)
            if name == "char" or definitions.bootstrap_storage_type(state.declarations, name, state.namespace) or definitions.record_template(state.declarations, name, state.namespace) != None or definitions.alias_named(state.declarations, name, state.namespace) != None:
                annotation = callable_type_expression(callee)
                resolved = callable_annotation(annotation, state.records, state.namespace, state.declarations)
                callable_record_layout(state.records, resolved, [])
                return resolved
        case Slice:
            name = callable_path(object)
            if name == "char" or definitions.bootstrap_storage_type(state.declarations, name, state.namespace) or definitions.record_template(state.declarations, name, state.namespace) != None or definitions.alias_named(state.declarations, name, state.namespace) != None:
                annotation = callable_type_expression(callee)
                resolved = callable_annotation(annotation, state.records, state.namespace, state.declarations)
                callable_record_layout(state.records, resolved, [])
                return resolved
        case Name:
            template ?= definitions.record_template(state.declarations, name, state.namespace)
            if template != None:
                if len(template.type_parameters) == len(template.type_defaults):
                    return callable_annotation(universal.named_type(name, [], callee.span), state.records, state.namespace, state.declarations)
            alias ?= definitions.alias_named(state.declarations, name, state.namespace)
            if alias != None:
                if len(alias.type_parameters) == 0:
                    return callable_annotation(universal.named_type(name, [], callee.span), state.records, state.namespace, state.declarations)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return universal.TypeId(0)


def callable_record_environment(state: CallableAnalysis, owner: universal.TypeId):
    for record in state.records:
        if record.type_id.index == owner.index:
            instance ?= definitions.record_instance(state.declarations, record.type_id)
            if instance != None:
                if len(instance.values) != 0:
                    state.constants = state.constants[:]
                for supplied in instance.values:
                    number = definitions.value_argument(state.declarations, supplied, record.lookup)
                    value = universal.Expression(universal.LiteralValue(universal.IntegerValue(number)), supplied.span, type_id=universal.i64_type_id())
                    state.constants.append(universal.Binding(record.lookup + supplied.binding, None, value, false, false, supplied.span, type_id=universal.i64_type_id()))
                    target = universal.named_type(number, [], supplied.span)
                    callable_prepend_alias(state.declarations, universal.TypeDeclaration([], record.lookup + supplied.binding, [], [], target, supplied.span, lookup=record.lookup))
                for template in state.declarations.record_templates:
                    if expansion.same(template.definition, instance.template):
                        index := 0
                        for name in template.type_parameters:
                            if name == template.type_pack:
                                continue
                            for binding in instance.arguments:
                                if binding.parameter.index == u32(index):
                                    alias = universal.TypeDeclaration([], record.lookup + name, [], [], None, record.span, id=binding.type_id, lookup=record.lookup)
                                    callable_prepend_alias(state.declarations, alias)
                            for binding in instance.constructors:
                                if binding.parameter.index == u32(index):
                                    for constructor in state.declarations.record_templates:
                                        if expansion.same(constructor.definition, binding.definition):
                                            arguments: list[universal.TypeAnnotation] = []
                                            for parameter in constructor.type_parameters:
                                                arguments.append(universal.named_type(parameter, [], record.span))
                                            target = universal.named_type(constructor.name, arguments, record.span)
                                            alias = universal.TypeDeclaration([], record.lookup + name, constructor.type_parameters, [], target, record.span, lookup=constructor.lookup)
                                            callable_prepend_alias(state.declarations, alias)
                            index += 1


def callable_register_record_methods(state: CallableAnalysis, owner: universal.TypeId) -> unit | diagnostics.Diagnostic:
    # Record method contracts are immutable within this function catalog.
    # String is a record instance with a primitive ID, so query the declaration
    # registry instead of classifying instances by a numeric ID range.
    if int(owner.index) in state.registered_methods or definitions.record_instance(state.declarations, owner) == None:
        return
    for record in borrow state.records:
        if record.type_id.index != owner.index:
            continue
        local = callable_scope(state)
        local.declarations = definitions.SemanticDefinitions(state.declarations.aliases[:], state.declarations.traits, state.declarations.implementations, record_templates=state.declarations.record_templates, record_instances=state.declarations.record_instances, expression_functions=state.declarations.expression_functions)
        callable_record_environment(local, owner)
        constructors_registered := false
        for function in borrow state.functions:
            if function.constructor and function.owner_type.index == owner.index:
                constructors_registered = true
        for template in state.templates:
            if template.constructor and template.owner_type.index == owner.index:
                constructors_registered = true
        for method in record.methods:
            if method.name == record.name.split("[")[0].split(".")[-1]:
                if not constructors_registered:
                    factory = construction.factory(record, method)
                    callable_register_factory(state, factory, local.declarations)
                continue
            if len(method.type_parameters) != 0 or len(method.constraints) != 0:
                return error(callable_diagnostic("generic record methods require method argument inference", method.span))
            name = record.name + "." + method.name
            found := false
            for function in borrow state.functions:
                if function.name == name:
                    previous ?= function.span
                    declared ?= method.span
                    if previous != None:
                        if declared != None:
                            if previous.source.index == declared.source.index and previous.start == declared.start:
                                found = true
            if found:
                continue
            receiver_type = universal.named_type(record.name, [], record.span)
            method = callable_replace_signature(method, ["Self"], [receiver_type])
            method.name = name
            if not method.extension:
                method.lookup = record.lookup
            method.owner_type = owner
            receiver = universal.FunctionParameter("self", receiver_type, None, record.span)
            receiver.modifiers.append(universal.BoundaryModifier("implicit receiver"))
            for field in record.fields:
                receiver.modifiers.append(universal.BoundaryModifier("receiver field " + field.name))
            parameters = [receiver]
            for parameter in method.parameters:
                if parameter.name == "self":
                    if len(parameters) != 1:
                        return error(callable_diagnostic("self must be the first method parameter", parameter.span))
                    parameters[0] = parameter
                else:
                    parameters.append(parameter)
            method.parameters = parameters
            state.functions.append(callable_signature(method, int(len(state.functions)), state.records, local.declarations))

        for operation in record.operators:
            found := false
            for function in borrow state.functions:
                syntax ?= function.operator_syntax
                if syntax != None:
                    if function.owner_type.index == owner.index and syntax.symbol == operation.syntax.symbol:
                        found = true
            if found:
                continue
            if operation.definition.declaration.value == 0:
                operation.definition = definitions.definition_id(record.name + "." + operation.syntax.symbol, 10000 + int(len(state.functions)))
            function = callable_operator_function(operation, owner, record.lookup, state.records)
            function.owner_type = owner
            state.functions.append(callable_signature(function, int(len(state.functions)), state.records, local.declarations))
    state.registered_methods.append(int(owner.index))
    # Receiver-effect inference follows calls through owned fields. Register
    # those method signatures before it sees an unresolved call and caches a
    # conservative write effect for an otherwise read-only method.
    for record in state.records:
        if record.type_id.index == owner.index:
            for field in record.fields:
                callable_register_record_methods(state, field.type_id)
    state.parameter_effects.clear()


def callable_infer_annotation(state: CallableAnalysis, annotation: universal.TypeAnnotation, actual: universal.TypeId, parameters: list[string], actuals: list[universal.TypeId], namespace: string) -> unit | diagnostics.Diagnostic:
    match annotation.kind:
        case Named:
            index := 0
            for parameter in parameters:
                if name == parameter and len(arguments) == 0:
                    if actuals[index].index != 0 and actuals[index].index != actual.index:
                        return error(diagnostics.diagnostic_at("E000219", "conflicting generic type arguments", annotation.span))
                    actuals[index] = actual
                    return
                index += 1
            alias ?= definitions.alias_named(state.declarations, name, namespace)
            if alias != None:
                target ?= alias.definition
                if target != None:
                    if len(arguments) != len(alias.type_parameters):
                        return error(callable_diagnostic("type argument count mismatch", annotation.span))
                    expanded = definitions.replace_annotation(target, alias.type_parameters, arguments)
                    callable_infer_annotation(state, expanded, actual, parameters, actuals, alias.lookup)
                    return
            if definitions.bootstrap_storage_type(state.declarations, name, namespace) and len(arguments) == 1:
                element = storage_types.buffer_element(actual, state.records)
                if element.index == 0:
                    return error(callable_diagnostic("generic argument has the wrong storage type", annotation.span))
                callable_infer_annotation(state, arguments[0], element, parameters, actuals, namespace)
                return
            template ?= definitions.record_template(state.declarations, name, namespace)
            if template != None:
                for record in state.records:
                    if record.type_id.index == actual.index:
                        instance ?= definitions.record_instance(state.declarations, record.type_id)
                        if instance != None:
                            if instance.template.declaration.value == template.definition.declaration.value and len(arguments) == len(instance.arguments):
                                index = 0
                                for argument in arguments:
                                    callable_infer_annotation(state, argument, instance.arguments[index].type_id, parameters, actuals, namespace)
                                    index += 1
                                return
                return error(callable_diagnostic("generic argument has the wrong record type", annotation.span))
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")



def callable_validate_record_arguments(state: CallableAnalysis, record: universal.RecordDeclaration) -> unit | diagnostics.Diagnostic:
    instance ?= definitions.record_instance(state.declarations, record.type_id)
    if instance == None:
        return
    local = callable_scope(state)
    local.declarations = definitions.SemanticDefinitions(state.declarations.aliases[:], state.declarations.traits, state.declarations.implementations, record_templates=state.declarations.record_templates, record_instances=state.declarations.record_instances, expression_functions=state.declarations.expression_functions)
    callable_record_environment(local, record.type_id)
    for bound in record.traits:
        trait = callable_trait(local, bound, record.lookup)
        if not callable_satisfies(local, record.type_id, trait):
            return error(callable_diagnostic("class does not satisfy trait " + trait.name, bound.span))
    if instance != None:
        for template in state.declarations.record_templates:
            if not expansion.same(template.definition, instance.template):
                continue
            for constraint in template.constraints:
                match constraint:
                    case Parameter:
                        family: list[universal.TypeId] := []
                        match bound.kind:
                            case Union:
                                family = definitions.family_members(local.declarations, bound, local.records, template.lookup)
                            case _:
                                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                        if len(family) != 0:
                            parameter_index := 0
                            for name in template.type_parameters:
                                if name == parameter:
                                    for binding in instance.arguments:
                                        if binding.parameter.index == u32(parameter_index):
                                            accepted := false
                                            for member in family:
                                                if member.index == binding.type_id.index:
                                                    accepted = true
                                            if not accepted:
                                                return error(callable_diagnostic("type is outside the parameter's type family", span))
                                parameter_index += 1
                            continue
                        trait = callable_trait(local, bound, template.lookup)
                        index := 0
                        found := false
                        for name in template.type_parameters:
                            if parameter == name:
                                found = true
                                for binding in instance.arguments:
                                    if binding.parameter.index == u32(index):
                                        if binding.type_id.index < 100000:
                                            if not callable_satisfies(local, binding.type_id, trait):
                                                return error(callable_diagnostic("type does not satisfy trait " + trait.name, span))
                                for binding in instance.constructors:
                                    if binding.parameter.index == u32(index):
                                        actual = callable_annotation(universal.named_type(parameter, trait.arguments, span), local.records, template.lookup, local.declarations)
                                        if not callable_satisfies(local, actual, trait):
                                            return error(callable_diagnostic("container does not satisfy trait " + trait.name, span))
                            index += 1
                        if not found:
                            return error(callable_diagnostic("constraint names an unknown parameter", span))
                    case _:
                        return error(callable_diagnostic("predicate constraints require compile-time evaluation", template.span))



def callable_symbolic_parameter(function: universal.FunctionDeclaration, index: int) -> universal.TypeId:
    # Parameter scopes must not share identities merely because their names or
    # positions agree. Concrete type bindings remain local to each declaration.
    return universal.TypeId(u32(100000 + int(function.definition.declaration.value) * 256 + index))


def callable_symbolic_type(state: CallableAnalysis, type_id: universal.TypeId) -> bool:
    if type_id.index >= 100000:
        return true
    element = storage_types.buffer_element(type_id, state.records)
    if element.index != 0:
        return callable_symbolic_type(state, element)
    instance ?= definitions.record_instance(state.declarations, type_id)
    if instance != None:
        for binding in instance.arguments:
            if callable_symbolic_type(state, binding.type_id):
                return true
    return false


# Static pack projections and slices preserve each selected field type.
def callable_constant_integer(expression: universal.Expression | None, fallback: int) -> int | diagnostics.Diagnostic:
    value ?= expression
    if value == None:
        return fallback
    if value != None:
        match value.kind:
            case LiteralValue:
                match value:
                    case IntegerValue:
                        return int(spelling)
                    case _:
                        throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            case Unary:
                if operator.symbol == "-":
                    return 0 - callable_constant_integer(operand, 0)
                if operator.symbol == "+":
                    return callable_constant_integer(operand, 0)
            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        return error(callable_diagnostic("indices and slice bounds require constant integers", value.span))
    return fallback


class CallableFieldPack:
    found: bool = false
    values: list[universal.Expression] = []
    receiver: universal.Expression | None = None


def callable_field_pack(state: CallableAnalysis, expression: universal.Expression) -> CallableFieldPack | diagnostics.Diagnostic:
    match expression.kind:
        case Member:
            owner = callable_hint(state, object)
            for record in state.records:
                if record.type_id.index != owner.index:
                    continue
                declared := false
                for template in state.declarations.record_templates:
                    if template.definition.module == record.definition.module and template.definition.declaration.value == record.definition.declaration.value:
                        for field in template.fields:
                            if field.variadic and field.name == name:
                                declared = true
                if not declared:
                    return CallableFieldPack()
                receiver = callable_expression(state, object, universal.TypeId(0))
                fields: list[universal.Expression] = []
                index := 0
                for field in record.fields:
                    if field.pack == name:
                        fields.append(universal.Expression(universal.FieldReference(receiver, index), expression.span, type_id=field.type_id))
                    index += 1
                return CallableFieldPack(true, fields, receiver)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return CallableFieldPack()


def callable_infer_field_pack(state: CallableAnalysis, callee: universal.Expression, arguments: list[universal.CallArgument], expected: universal.TypeId) -> universal.TypeId | diagnostics.Diagnostic:
    name = callable_path(callee)
    selected := definitions.record_template(state.declarations, name, state.namespace)
    match callee.kind:
        case SourceSymbol:
            for candidate in state.declarations.record_templates:
                if expansion.same(candidate.definition, definition):
                    selected = candidate
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    template ?= selected
    if template != None:
        if name in state.names:
            return error(callable_diagnostic("binding is not callable: " + name, callee.span))
        contextual ?= definitions.record_instance(state.declarations, expected)
        if contextual != None:
            if contextual.template.module == template.definition.module and contextual.template.declaration.value == template.definition.declaration.value:
                return expected
        if template.type_pack == "":
            for method in template.methods:
                if method.name == template.name.split(".")[-1]:
                    return error(callable_diagnostic("custom constructors require explicit generic type arguments", callee.span))
            bound = packs.bind_arguments(universal.FunctionDeclaration(parameters=template.fields), arguments)
            if bound.message != "":
                return error(callable_diagnostic(bound.message, callee.span))
            actuals: list[universal.TypeId] = []
            for parameter in template.type_parameters:
                actuals.append(universal.TypeId(0))
            for argument in bound.arguments:
                for field in template.fields:
                    if argument.name == field.name:
                        actual = callable_expression(state, argument.value, universal.TypeId(0))
                        callable_infer_annotation(state, field.annotation, actual.type_id, template.type_parameters, actuals, template.lookup)
            annotations: list[universal.TypeAnnotation] = []
            for actual in actuals:
                if actual.index == 0:
                    return error(callable_diagnostic("record type parameter cannot be inferred", callee.span))
                annotations.append(universal.named_type(definitions.type_name(actual, state.records), [], callee.span))
            resolved = definitions.instantiate_record(state.declarations, template, annotations, state.records, state.namespace, callee.span)
            callable_record_layout(state.records, resolved, [])
            return resolved
        if len(template.type_parameters) != 1 or len(template.fields) != 1 or not template.fields[0].variadic:
            return error(callable_diagnostic("inferred aggregate construction requires one field pack", callee.span))
        annotations: list[universal.TypeAnnotation] = []
        for argument in arguments:
            if argument.name != None:
                return error(callable_diagnostic("field pack construction requires positional values", argument.span))
            value = callable_expression(state, argument.value, universal.TypeId(0))
            annotations.append(universal.named_type(definitions.type_name(value.type_id, state.records), [], argument.span))
        resolved = definitions.instantiate_record(state.declarations, template, annotations, state.records, state.namespace, callee.span)
        callable_record_layout(state.records, resolved, [])
        return resolved
    return universal.TypeId(0)


def callable_pack_iteration(state: CallableAnalysis, name: string, pack: CallableFieldPack, body: universal.Block, span: source.Span, result_type: universal.TypeId) -> universal.Block | diagnostics.Diagnostic:
    output = universal.empty_block()
    values: list[universal.Expression] = []
    receiver ?= pack.receiver
    if receiver != None:
        receiver_name = "$pack$receiver$" + string(len(state.names))
        binding = callable_binding(state, universal.Binding(receiver_name, None, receiver, false, false, span))
        output.statements.append(universal.BindingStatement(binding))
        base = universal.Expression(universal.BindingReference(binding.id), span, type_id=binding.type_id)
        for value in pack.values:
            match value.kind:
                case FieldReference:
                    values.append(universal.Expression(universal.FieldReference(base, index), value.span, type_id=value.type_id))
                case _:
                    return error(callable_diagnostic("field pack requires resolved projections", span))
    index := 0
    for value in values:
        prefix = "$pack$" + string(state.next_id[0]) + "$" + string(index) + "$"
        replacement = prefix + name
        names = state.names[:]
        replacements = state.names[:]
        names.append(name)
        replacements.append(replacement)
        expanded = packs.expand_block(body, "", 0, names, replacements, prefix)
        binding = universal.Binding(replacement, None, value, false, false, span)
        output.statements.append(universal.BindingStatement(callable_binding(state, binding)))
        typed = callable_block(state, expanded.statements, result_type, false, origin=expanded.span)
        for statement in typed.statements:
            output.statements.append(statement)
        index += 1
    return output


class CallableExpansion:
    value: universal.Expression | None = None


def callable_expand_grammar(state: CallableAnalysis, callee: universal.Expression, arguments: list[universal.CallArgument], span: source.Span) -> CallableExpansion | diagnostics.Diagnostic:
    match callee.kind:
        case SourceSymbol:
            for grammar in state.declarations.traits:
                if not expansion.same(grammar.definition, definition):
                    continue
                for method in grammar.methods:
                    if method.name == "semantic":
                        operands: list[universal.Expression] = []
                        for argument in arguments:
                            operands.append(argument.value)
                        pack = universal.Expression(universal.ListLiteral(operands), span)
                        result = expansion.invoke(state.declarations, method, [pack], grammar.lookup, span, [10000])
                        result.span = span
                        result.grammar = grammar.definition
                        return CallableExpansion(result)
                return error(callable_diagnostic("expression grammar requires a semantic method", span))
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return CallableExpansion()


def callable_pack_record(state: CallableAnalysis, type_id: universal.TypeId) -> universal.RecordDeclaration | None:
    for record in state.records:
        if record.type_id.index != type_id.index:
            continue
        for template in state.declarations.record_templates:
            if expansion.same(template.definition, record.definition):
                if len(template.fields) == 1 and template.fields[0].variadic:
                    return record
    return None


def callable_type_method(state: CallableAnalysis, callee: universal.Expression) -> CallableOptionalFunction | diagnostics.Diagnostic:
    match callee.kind:
        case Member:
            path = callable_path(object)
            if path == "" or path in state.names:
                return CallableOptionalFunction()
            owner := callable_constructor_type(state, object)
            if owner.index == 0:
                for record in state.records:
                    if record.name == path or record.name == state.namespace + path:
                        owner = record.type_id
            if owner.index == 0:
                return CallableOptionalFunction()
            if owner.index >= 100000:
                requirement = callable_required_member(state, owner, name)
                method ?= requirement.function
                if method != None:
                    function = callable_replace_signature(method, [], [])
                    function.parameters = function.parameters[1:]
                    function.parameter_types = method.parameter_types[1:]
                    function.result_type = method.result_type
                    return CallableOptionalFunction(function)
                return CallableOptionalFunction()
            callable_register_record_methods(state, owner)
            selected: universal.FunctionDeclaration | None := None
            for function in state.functions:
                if function.owner_type.index == owner.index and function.name.split(".")[-1] == name:
                    selected = function
            method ?= selected
            if method != None:
                if name.starts_with("_") and state.owner.index != owner.index:
                    return error(callable_diagnostic("method is private: " + name, callee.span))
                instance_name = method.name + "$type"
                for function in state.functions:
                    if function.name == instance_name:
                        return CallableOptionalFunction(function)
                function := callable_replace_signature(method, [], [])
                function.name = instance_name
                function.parameters = function.parameters[1:]
                for record in state.records:
                    if record.type_id.index == owner.index:
                        for declared in record.methods:
                            if declared.name == name:
                                function.body = declared.body
                function = callable_signature(function, int(len(state.functions)), state.records, state.declarations)
                state.functions.append(function)
                return CallableOptionalFunction(function)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return CallableOptionalFunction()


def callable_match_expression(state: CallableAnalysis, subject: universal.Expression, arms: list[universal.MatchArm], span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    local = callable_scope(state)
    binding = callable_binding(local, universal.Binding("$match_subject_" + string(span.start), None, subject, false, true, span))
    resolved = matches.resolve_arms(state.declarations, state.records, state.namespace, binding.id, binding.type_id, arms, span, true)
    values: list[universal.Expression] = []
    conditions: list[universal.Expression] = []
    result_type := expected
    for arm in resolved:
        scoped = callable_scope(local)
        statements = arm.body.statements
        if len(statements) == 0:
            return error(callable_diagnostic("match expression arm requires a final value", span))
        body = callable_block(scoped, statements[:-1], universal.unit_type_id(), false)
        if callable_terminates(body):
            return error(callable_diagnostic("match expression arm must reach its final value", span))
        last := statements[-1]
        match last:
            case Match:
                last = universal.ExpressionStatement(universal.Expression(universal.MatchExpression(subject, arms), span))
            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        match last:
            case ExpressionStatement:
                value = callable_expression(scoped, expression, result_type)
                if value.type_id.index == 2:
                    return error(callable_diagnostic("match expression arm requires a value", expression.span))
                result_type = value.type_id
                values.append(universal.Expression(universal.BlockValue(body, value), span, type_id=result_type))
            case _:
                return error(callable_diagnostic("match expression arm requires a final value", span))
        conditions.append(callable_expression(local, arm.condition, universal.bool_type_id()))
    result := values[-1]
    cursor := len(values) - 1
    while cursor > 0:
        cursor -= 1
        result = universal.Expression(universal.Conditional(conditions[cursor], values[cursor], result), span, type_id=result_type)
    return universal.Expression(universal.BlockValue(universal.Block([universal.BindingStatement(binding)]), result), span, type_id=result_type)


def callable_union_member(state: CallableAnalysis, receiver: universal.Expression, record: universal.RecordDeclaration, name: string, span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    local = callable_scope(state)
    binding = callable_binding(local, universal.Binding("$union_subject_" + string(span.start), None, receiver, false, true, span))
    values: list[universal.Expression] = []
    types: list[universal.TypeAnnotation] = []
    index := 0
    for variant in universal.union_variants(record):
        projected = universal.Expression(universal.FieldReference(matches.reference(binding.id, binding.type_id, span), index + 1), span, type_id=variant)
        found := false
        for member in state.records:
            if member.type_id.index == variant.index:
                for field in member.fields:
                    if field.name == name:
                        found = true
        if not found:
            return error(callable_diagnostic("member " + name + " is not available on every member of narrowed union", span))
        value = callable_expression(local, universal.Expression(universal.Member(projected, name), span), universal.TypeId(0))
        values.append(value)
        known := false
        for annotation in types:
            if callable_annotation(annotation, state.records, state.namespace, state.declarations).index == value.type_id.index:
                known = true
        if not known:
            types.append(universal.named_type(definitions.type_name(value.type_id, state.records), [], span))
        index += 1
    result_type := values[0].type_id
    if len(types) > 1:
        result_type = callable_annotation(universal.TypeAnnotation(universal.Union(types), span), state.records, state.namespace, state.declarations)
    if expected.index != 0 and expected.index != result_type.index:
        return error(callable_diagnostic("union member does not match expected type", span))
    result := callable_expression(local, values[-1], result_type)
    cursor := len(values) - 1
    while cursor > 0:
        cursor -= 1
        value = callable_expression(local, values[cursor], result_type)
        result = universal.Expression(universal.Conditional(matches.tag_test(matches.reference(binding.id, binding.type_id, span), cursor, span), value, result), span, type_id=result_type)
    return universal.Expression(universal.BlockValue(universal.Block([universal.BindingStatement(binding)]), result), span, type_id=result_type)


def callable_transition_states(state: CallableAnalysis, index: int, record: universal.RecordDeclaration) -> list[int]:
    for entry in state.transitions:
        if entry.binding == index:
            return entry.variants
    result: list[int] = []
    ordinal := 0
    for alternative in record.alternatives:
        result.append(ordinal)
        ordinal += 1
    return result


def callable_set_transition(state: CallableAnalysis, index: int, variants: list[int]):
    cursor := 0
    while cursor < len(state.transitions):
        if state.transitions[cursor].binding == index:
            state.transitions[cursor] = TransitionState(index, variants)
            return
        cursor += 1
    state.transitions.append(TransitionState(index, variants))


def callable_transition(state: CallableAnalysis, index: int, value: universal.Expression, span: source.Span, update: bool) -> unit | diagnostics.Diagnostic:
    for record in state.records:
        if record.type_id.index != value.type_id.index:
            continue
        constrained := false
        for alternative in record.alternatives:
            if len(alternative.transitions) != 0:
                constrained = true
        if not constrained:
            continue
        destinations: list[int] := []
        match value.kind:
            case OutcomeValue:
                destinations.append(variant)
            case BindingReference:
                destinations = callable_transition_states(state, int(binding.index), record)
            case _:
                ordinal := 0
                for alternative in record.alternatives:
                    destinations.append(ordinal)
                    ordinal += 1
        if update:
            for previous in callable_transition_states(state, index, record):
                for destination in destinations:
                    if record.alternatives[destination].name not in record.alternatives[previous].transitions:
                        return error(diagnostics.Diagnostic("E000213", "invalid state transition " + record.alternatives[previous].name + " -> " + record.alternatives[destination].name, span))
        callable_set_transition(state, index, destinations)


def callable_join_transitions(state: CallableAnalysis, left: CallableAnalysis, right: CallableAnalysis):
    index := 0
    for type_id in state.types:
        for record in state.records:
            if record.type_id.index == type_id.index and len(record.alternatives) != 0:
                variants = callable_transition_states(left, index, record)[:]
                for variant in callable_transition_states(right, index, record):
                    if variant not in variants:
                        variants.append(variant)
                callable_set_transition(state, index, variants)
        index += 1


def callable_excluded(state: CallableAnalysis, name: string, span: source.Span) -> bool:
    return name in state.excluded_functions and int(span.source.index) not in state.prelude_sources


def callable_regular_call(state: CallableAnalysis, expression: universal.Expression, name: string, arguments: list[universal.CallArgument], expected: universal.TypeId, allow_prelude: bool = true) -> universal.Expression | diagnostics.Diagnostic:
    function_lookup = callable_select_function(state, name, arguments, expected, allow_prelude)
    selected ?= function_lookup.selection
    selected_functions: list[universal.FunctionDeclaration] = []
    if selected != None:
        selected_functions.append(selected.function)
    for function in selected_functions:
        if function.prelude and function.name == "allocate":
            callable_require_unsafe(state, expression.span)
        target = callable_mock_target(state, function, expression.span)
        if target != function.name:
            return callable_regular_call(state, expression, target, arguments, expected, allow_prelude)
        matches := false
        if selected != None:
            matches = function.id.value == selected.function.id.value
        if matches:
            if name in state.names:
                return error(callable_diagnostic("a scalar binding is not callable: " + name, expression.span))
            if len(arguments) != len(function.parameters) and selected == None:
                return error(callable_diagnostic("wrong argument count for " + name, expression.span))
            resolved: list[universal.CallArgument] := []
            if selected != None:
                for argument in selected.arguments:
                    index := 0
                    for parameter in function.parameters:
                        if argument.name == parameter.name:
                            value = callable_expression(state, argument.value, function.parameter_types[index])
                            resolved.append(universal.CallArgument(parameter.name, value, argument.span))
                        index += 1
            # Evaluate all arguments before activating automatic call loans.
            # A receiver may read its fields while computing another argument.
            contracted: list[universal.CallArgument] = []
            for argument in resolved:
                for parameter in function.parameters:
                    if argument.name == parameter.name:
                        value = callable_parameter_value(state, parameter, argument.value, parameter.type_id)
                        contracted.append(universal.CallArgument(parameter.name, value, argument.span))
            resolved = contracted
            result_type = function.result_type
            kind: universal.ExpressionKind = universal.ResolvedCall(universal.Direct(lazy_bodies.require(state.required_functions, function.definition), universal.Substitution(function.type_arguments)), resolved)
            id = universal.HirId(u32(state.next_id[0]))
            state.next_id[0] += 1
            if expected.index != 0 and result_type.index != expected.index:
                unwrapped = callable_success(state, universal.Expression(kind, expression.span, id, result_type))
                if unwrapped.type_id.index != expected.index:
                    return error(callable_diagnostic("call result does not match its expected scalar type", expression.span))
                return unwrapped
            result = callable_borrowed_result(function, resolved, universal.Expression(kind, expression.span, id, result_type, grammar=expression.grammar))
            if function.name.starts_with("$mock$"):
                return callable_success(state, result)
            return result
    for function in state.functions:
        if function.name == state.namespace + name:
            return error(callable_diagnostic("no overload accepts these arguments for " + name, expression.span))
    return error(callable_diagnostic("unknown callable " + name, expression.span))


def callable_register_factory(state: CallableAnalysis, factory: universal.FunctionDeclaration, environment: definitions.SemanticDefinitions) -> unit | diagnostics.Diagnostic:
    if len(factory.parameters) != 0 and factory.parameters[0].variadic:
        parameters: list[universal.FunctionParameter] = []
        namespace := ""
        lookup ?= factory.lookup
        if lookup != None:
            namespace = lookup
        for original in factory.parameters:
            parameter := original
            actual = callable_annotation(parameter.annotation, state.records, namespace, environment)
            parameter.annotation = universal.named_type(definitions.type_name(actual, state.records), [], parameter.span)
            parameters.append(parameter)
        factory.parameters = parameters
        state.templates.append(factory)
    else:
        state.functions.append(callable_signature(factory, int(len(state.functions)), state.records, environment))


def callable_accepts_arity(function: universal.FunctionDeclaration, count: int) -> bool:
    required := 0
    for parameter in function.parameters:
        if parameter.default == None:
            required += 1
    return count >= required and count <= len(function.parameters)



def callable_same_owner(state: CallableAnalysis, left: universal.TypeId, right: universal.TypeId) -> bool:
    if left.index == right.index:
        return true
    for owner in state.records:
        if owner.type_id.index == left.index:
            for target in state.records:
                if target.type_id.index == right.index and expansion.same(owner.definition, target.definition):
                    return true
    return false
