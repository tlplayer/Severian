                            target = universal.Expression(universal.Name(template.name), callee.span)
                            return callable_expression(state, universal.Expression(universal.Call(target, arguments), expression.span), expected)
                    bound = packs.bind_arguments(universal.FunctionDeclaration(parameters=record.fields), arguments)
                    if bound.message != "":
                        creation ?= state.resource_creation
                        if creation != None:
                            if len(arguments) == 0 and creation.start == expression.span.start and creation.end == expression.span.end and creation.source.index == expression.span.source.index:
                                defaults: list[universal.CallArgument] = []
                                for field in record.fields:
                                    default ?= field.default
                                    if default != None:
                                        typed_default = callable_expression(state, default, field.type_id)
                                        defaults.append(universal.CallArgument(field.name, typed_default, field.span))
                                return universal.Expression(universal.RecordValue(defaults), expression.span, type_id=record.type_id)
                        return error(callable_diagnostic(bound.message, expression.span))
                    resolved: list[universal.CallArgument] := []
                    for argument in bound.arguments:
                        for field in record.fields:
                            if argument.name == field.name:
                                previous_creation = state.resource_creation
                                enclosing ?= previous_creation
                                if enclosing != None:
                                    if enclosing.source.index == expression.span.source.index and enclosing.start == expression.span.start and enclosing.end == expression.span.end:
                                        state.resource_creation = argument.value.span
                                typed = callable_expression(state, argument.value, field.type_id)
                                state.resource_creation = previous_creation
                                if callable_has_drop(state, field.type_id):
                                    match typed.kind:
                                        case BindingReference:
                                            return error(callable_diagnostic("owned resource fields require move", argument.span))
                                        case FieldReference:
                                            return error(callable_diagnostic("owned resource fields require move", argument.span))
                                        case _:
                                            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                                checked = callable_field_value(state, record, field, typed, argument.span)
                                resolved.append(universal.CallArgument(field.name, checked, argument.span))
                    if expected.index != 0 and expected.index != record.type_id.index:
                        return error(callable_diagnostic("constructor does not match expected type", expression.span))
                    return universal.Expression(universal.RecordValue(resolved), expression.span, type_id=record.type_id, grammar=expression.grammar)
            type_method = callable_type_method(state, callee)
            type_function ?= type_method.function
            if type_function != None:
                bound = packs.bind_arguments(type_function, arguments)
                if bound.message != "":
                    return error(callable_diagnostic(bound.message, expression.span))
                operands: list[universal.Expression] = []
                for argument in bound.arguments:
                    index := 0
                    for parameter in type_function.parameters:
                        if argument.name == parameter.name:
                            operands.append(callable_expression(state, argument.value, type_function.parameter_types[index]))
                        index += 1
                return callable_resolved_operator(state, type_function, operands, expression.span, expected)
            method_lookup = callable_method(state, callee, len(arguments))
            source_method ?= method_lookup.function
            if source_method != None:
                method := callable_contract_signature(state, source_method)
                receiver = callable_receiver(state, callee)
                if receiver.type_id.index >= 100000:
                    supplied: list[universal.Expression] = [receiver]
                    index := 1
                    for argument in arguments:
                        if index >= len(method.parameter_types):
                            return error(callable_diagnostic("wrong trait member argument count", expression.span))
                        supplied.append(callable_parameter_value(state, method.parameters[index], argument.value, method.parameter_types[index]))
                        index += 1
                    return callable_resolved_operator(state, method, supplied, expression.span, expected)
                if method.name.split(".")[-1].starts_with("_") and not callable_same_owner(state, state.owner, receiver.type_id):
                    return error(callable_diagnostic("method is private: " + method.name, expression.span))
                supplied = [universal.CallArgument(None, receiver, receiver.span)]
                for argument in arguments:
                    supplied.append(argument)
                if not method.extension:
                    target = universal.Expression(universal.Name(method.name), callee.span)
                    return callable_expression(state, universal.Expression(universal.Call(target, supplied), expression.span), expected)
                overloads = callable_select_function(state, method.name, supplied, expected)
                overload ?= overloads.selection
                if overload != None:
                    method = callable_contract_signature(state, overload.function)
                bound = packs.bind_arguments(method, supplied)
                if bound.message != "":
                    return error(callable_diagnostic(bound.message, expression.span))
                resolved: list[universal.CallArgument] := []
                for argument in bound.arguments:
                    index := 0
                    for parameter in method.parameters:
                        if argument.name == parameter.name:
                            operand = callable_expression(state, argument.value, method.parameter_types[index])
                            resolved.append(universal.CallArgument(parameter.name, operand, argument.span))
                        index += 1
                contracted: list[universal.CallArgument] = []
                for argument in resolved:
                    for parameter in method.parameters:
                        if argument.name == parameter.name:
                            operand = callable_parameter_value(state, parameter, argument.value, parameter.type_id)
                            contracted.append(universal.CallArgument(parameter.name, operand, argument.span))
                resolved = contracted
                id = universal.HirId(u32(state.next_id[0]))
                state.next_id[0] += 1
                kind = universal.ResolvedCall(universal.Direct(lazy_bodies.require(state.required_functions, method.definition), universal.Substitution(method.type_arguments)), resolved)
                result := callable_borrowed_result(method, resolved, universal.Expression(kind, expression.span, id, method.result_type))
                if expected.index != 0 and expected.index != result.type_id.index:
                    result = callable_success(state, result)
                    if expected.index != result.type_id.index:
                        return error(callable_diagnostic("call result does not match its expected scalar type", expression.span))
                return result
            if alias_type.index != 0 and conversions.scalar_numeric(alias_type):
                target_name = definitions.type_name(alias_type, state.records)
                if target_name != name:
                    target_call = universal.Expression(universal.Name(target_name), callee.span)
                    return callable_expression(state, universal.Expression(universal.Call(target_call, arguments), expression.span), expected)
            target ?= scalar.scalar_type_name(name)
            if target != None:
                if conversions.scalar_numeric(target):
                    if len(arguments) == 1 and arguments[0].name == None:
                        operand = callable_expression(state, arguments[0].value, universal.TypeId(0))
                        selected = callable_operator(state, name, [operand.type_id], expression.span)
                        conversion ?= selected.function
                        if conversion != None:
                            if conversion.result_type.index != target.index:
                                return error(callable_diagnostic("conversion operator must return its declared target type", expression.span))
                            return callable_resolved_operator(state, conversion, [operand], expression.span, expected)
                    if len(arguments) < 1 or len(arguments) > 2:
                        return error(callable_diagnostic("numeric conversion requires a value and optional mode", expression.span))
                    if arguments[0].name != None:
                        return error(callable_diagnostic("numeric conversion value must be positional", arguments[0].span))
                    mode := ""
                    if len(arguments) == 2:
                        if arguments[1].name != None and arguments[1].name != "mode":
                            return error(callable_diagnostic("unknown numeric conversion argument", arguments[1].span))
                        match arguments[1].value.kind:
                            case Name:
                                mode = name
                            case LiteralValue:
                                match value:
                                    case StringValue:
                                        mode = value
                                    case _:
                                        return error(callable_diagnostic("numeric conversion mode must be a policy name", arguments[1].span))
                            case _:
                                return error(callable_diagnostic("numeric conversion mode must be a policy name", arguments[1].span))
                    converted = callable_convert(state, callable_expression(state, arguments[0].value, universal.TypeId(0)), target, mode)
                    if expected.index != 0 and expected.index != target.index:
                        return error(callable_diagnostic("conversion result does not match its expected scalar type", expression.span))
                    return converted
            if name == "type":
                if len(arguments) != 1 or arguments[0].name != None:
                    return error(callable_diagnostic("type requires one positional value", expression.span))
                typed_value = callable_expression(state, arguments[0].value, universal.TypeId(0))
                known ?= scalar.scalar_type(typed_value.type_id)
                if known != None:
                    display := known.name
                    if display == "i64":
                        display = "int"
                    elif display == "f64":
                        display = "float"
                    if expected.index != 0 and expected.index != 3:
                        return error(callable_diagnostic("type name does not match its expected scalar type", expression.span))
                    id = universal.HirId(u32(state.next_id[0]))
                    state.next_id[0] += 1
                    return universal.Expression(universal.TypeName(typed_value, display), expression.span, id, universal.string_type_id())
                return error(callable_diagnostic("type requires a concrete value", expression.span))
            named_operation = callable_index.has_operator(state.function_index, state.functions, name) or callable_index.has_operator(state.generic_index, state.generics, name)
            if name != "" and "." not in name and name not in state.names and state.owner.index != 0:
                for record in state.records:
                    if record.type_id.index == state.owner.index:
                        for method in record.methods:
                            if method.name == name and name != record.name.split(".")[-1]:
                                supplied := len(arguments)
                                if len(method.parameters) != 0 and method.parameters[0].name == "self":
                                    supplied += 1
                                if not callable_accepts_arity(method, supplied):
                                    continue
                                receiver = universal.Expression(universal.Name("self"), callee.span)
                                member = universal.Expression(universal.Member(receiver, name), callee.span)
                                return callable_expression(state, universal.Expression(universal.Call(member, arguments), expression.span), expected)
            if named_operation:
                operands: list[universal.Expression] = []
                types: list[universal.TypeId] = []
                positional := true
                for argument in arguments:
                    if argument.name != None:
                        positional = false
                    operand = callable_expression(state, argument.value, universal.TypeId(0))
                    operands.append(operand)
                    types.append(operand.type_id)
                if positional:
                    selected_operator = callable_operator(state, name, types, expression.span)
                    implementation ?= selected_operator.function
                    if implementation != None:
                        return callable_resolved_operator(state, implementation, operands, expression.span, expected)
            return callable_regular_call(state, expression, name, arguments, expected)
        case _:
            return error(callable_diagnostic("expression is outside the scalar bootstrap subset", expression.span))
    if expected.index != 0 and result_type.index != expected.index:
        return error(callable_diagnostic("expression does not match its expected scalar type", expression.span))
    id = universal.HirId(u32(state.next_id[0]))
    state.next_id[0] += 1
    return universal.Expression(kind, expression.span, id, result_type, grammar=expression.grammar, loan_root=expression.loan_root, loan_mode=expression.loan_mode)


def callable_binding(state: CallableAnalysis, binding: universal.Binding) -> universal.Binding | diagnostics.Diagnostic:
    index := 0
    for name in state.names:
        if name == binding.name:
            if binding.scoped:
                state.names[index] = "$shadowed_" + string(index)
                index += 1
                continue
            if binding.mutable or binding.annotation != None:
                return error(callable_diagnostic("duplicate scalar binding " + binding.name, binding.span))
            if not state.mutables[index]:
                return error(callable_diagnostic("cannot reassign immutable binding " + name, binding.span))
            if index in state.dead and not callable_has_drop(state, state.types[index]):
                return error(callable_diagnostic("cannot reassign a dropped or moved binding", binding.span))
            loans.access(state.loans, index, true, binding.span)
            if index in state.readonly:
                return error(callable_diagnostic("cannot reassign a shared borrow parameter", binding.span))
            previous_creation = state.resource_creation
            state.resource_creation = binding.value.span
            value = callable_expression(state, binding.value, state.types[index])
            state.resource_creation = previous_creation
            callable_transition(state, index, value, binding.span, true)
            return universal.Binding(name, None, value, true, false, binding.span, universal.BindingId(u32(index)), value.type_id, true)
        index += 1
    if binding.update:
        return error(callable_diagnostic("cannot update unknown binding " + binding.name, binding.span))
    expected := universal.TypeId(0)
    annotation ?= binding.annotation
    if annotation != None:
        expected = callable_annotation(annotation, state.records, state.namespace, state.declarations)
    previous_creation = state.resource_creation
    state.resource_creation = binding.value.span
    value := callable_expression(state, binding.value, expected)
    state.resource_creation = previous_creation
    source_root = loans.binding(value)
    if source_root >= 0 and source_root in state.readonly and not storage_types.copy_storage(value.type_id, state.records):
        value.loan_root = source_root
        value.loan_mode = "borrow"
    if not binding.preserve_error and binding.annotation == None:
        value = callable_success(state, value)
    if value.type_id.index == 2:
        return error(callable_diagnostic("unit calls cannot initialize scalar bindings", binding.span))
    id = universal.BindingId(u32(len(state.names)))
    state.names.append(binding.name)
    state.types.append(value.type_id)
    state.mutables.append(binding.mutable)
    match value.kind:
        case RecordValue:
            for record in state.records:
                if record.type_id.index == value.type_id.index:
                    field_index := 0
                    for field in record.fields:
                        present := false
                        for argument in fields:
                            if argument.name == field.name:
                                present = true
                        if not present:
                            state.uninitialized.append((int(id.index), field_index))
                        field_index += 1
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    match value.kind:
        case Ownership:
            if mode in ["borrow", "borrow mut"]:
                root = loans.owner(state.loans, loans.binding(value))
                if len(state.loans) != 0:
                    state.loans[-1] = loans.Loan(root, int(id.index), mode == "borrow mut")
                if mode == "borrow":
                    state.readonly.append(int(id.index))
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    if value.loan_mode in ["borrow", "borrow mut"] and value.loan_root >= 0:
        root = loans.owner(state.loans, value.loan_root)
        state.loans.append(loans.Loan(root, int(id.index), value.loan_mode == "borrow mut"))
        if value.loan_mode == "borrow":
            state.readonly.append(int(id.index))
    callable_transition(state, int(id.index), value, binding.span, false)
    return universal.Binding(binding.name, binding.annotation, value, false, binding.preserve_error, binding.span, id, value.type_id, binding.mutable)


def callable_assertion(state: CallableAnalysis, condition: universal.Expression, message: universal.Expression | None, span: source.Span, condition_span: source.Span) -> universal.Statement | diagnostics.Diagnostic:
    resolved = callable_expression(state, condition, universal.bool_type_id())
    description := "condition is false"
    if int(condition_span.source.index) < len(state.source_files):
        characters = state.source_files[condition_span.source.index].characters
        if condition_span.start < condition_span.end and int(condition_span.end) <= len(characters):
            description = characters[int(condition_span.start):int(condition_span.end)].join("")
    diagnostic := universal.Expression(universal.LiteralValue(universal.StringValue(description)), span)
    supplied ?= message
    if supplied != None:
        diagnostic = supplied
    location = diagnostics.render_location(condition_span, state.source_files)
    if location != "":
        suffix = universal.Expression(universal.LiteralValue(universal.StringValue(location)), span)
        diagnostic = universal.Expression(universal.Binary(universal.operator_syntax(universal.Add()), diagnostic, suffix), span)
    diagnostic = callable_expression(state, diagnostic, universal.string_type_id())
    yes = universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), span, type_id=universal.bool_type_id())
    no = universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), span, type_id=universal.bool_type_id())
    failed = callable_raw_call(state, "__assert_condition", [no, diagnostic], span, universal.bool_type_id())
    # Keep the condition single-evaluation and the diagnostic lazy.
    checked = universal.Expression(universal.Conditional(resolved, yes, failed), span, type_id=universal.bool_type_id())
    return universal.Assert(checked, None, span, condition_span)


def callable_expression_statement(state: CallableAnalysis, expression: universal.Expression) -> universal.Statement | diagnostics.Diagnostic:
    match expression.kind:
        case MockValue:
            callable_install_mock(state, calls, results, fallback, expression.span)
            return universal.ExpressionStatement(universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), expression.span, type_id=universal.bool_type_id()))
        case Call:
            match callee.kind:
                case Name:
                    if name == "throws":
                        if not state.test_context:
                            return error(callable_diagnostic("throws is only available in tests", expression.span))
                        if len(arguments) < 1 or len(arguments) > 2 or arguments[0].name != None or arguments[0].spread:
                            return error(callable_diagnostic("throws requires exactly one positional expression", expression.span))
                        expectation := universal.Expression(universal.ErrorExpectation(None, None), expression.span)
                        if len(arguments) == 2:
                            if arguments[1].name != "$error":
                                return error(callable_diagnostic("expected -> ErrorType or -> error_value after throws expression", expression.span))
                            expectation = callable_error_expectation(state, arguments[1].value)
                        local = callable_scope(state)
                        local.catching_error = true
                        value = callable_success(local, callable_expression(local, arguments[0].value, universal.TypeId(0)))
                        no = universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), expression.span)
                        message = universal.Expression(universal.LiteralValue(universal.StringValue("expected an error to be thrown")), expression.span)
                        failure = callable_assertion(state, no, message, expression.span, arguments[0].value.span)
                        return callable_control(state, "Throws", [value, expectation], [universal.Block([failure])], expression.span)
                    if name == "assert" and not callable_excluded(state, "assert", expression.span):
                        if len(arguments) < 1 or len(arguments) > 2:
                            return error(callable_diagnostic("assert requires a condition and optional message", expression.span))
                        for argument in arguments:
                            if argument.name != None or argument.spread:
                                return error(callable_diagnostic("assert requires positional arguments", expression.span))
                        message: universal.Expression | None := None
                        if len(arguments) == 2:
                            message = arguments[1].value
                        return callable_assertion(state, arguments[0].value, message, expression.span, arguments[0].value.span)
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            value = callable_expression(state, expression, universal.TypeId(0))
            return universal.ExpressionStatement(value)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return error(callable_diagnostic("expected a scalar binding, call, or assertion", expression.span))


def callable_mock_result(state: CallableAnalysis, function: universal.FunctionDeclaration, errors: list[universal.TypeId], span: source.Span) -> universal.TypeId | diagnostics.Diagnostic:
    variants: list[universal.TypeId] := []
    for record in state.records:
        if record.type_id.index == function.result_type.index:
            variants = universal.outcome_variants(record)
    if len(variants) == 0:
        variants.append(function.result_type)
    for error_type in errors:
        found := false
        for variant in variants:
            found = found or variant.index == error_type.index
        if not found:
            variants.append(error_type)
    if len(variants) == 1:
        return variants[0]
    members: list[universal.TypeAnnotation] = []
    for variant in variants:
        members.append(universal.named_type(definitions.type_name(variant, state.records), [], span))
    return callable_annotation(universal.TypeAnnotation(universal.Union(members), span), state.records, state.namespace, state.declarations)


def callable_install_mock(state: CallableAnalysis, calls: list[universal.Expression], results: list[universal.Expression], fallback: universal.Expression, span: source.Span) -> unit | diagnostics.Diagnostic:
    if not state.test_context:
        return error(callable_diagnostic("mock is only available in tests", span))
    if len(calls) == 0:
        return error(callable_diagnostic("mock requires at least one invocation", span))
    errors: list[universal.TypeId] = []
    match fallback.kind:
        case ThrowValue:
            raised = callable_expression(state, value, universal.TypeId(0))
            if not definitions.error_conformance(state.declarations, state.records, raised.type_id):
                return error(callable_diagnostic("mock fallback must throw an Error", span))
            errors.append(raised.type_id)
        case _:
            return error(callable_diagnostic("mock requires an else throw fallback", span))
    originals: list[universal.FunctionDeclaration] = []
    bound_calls: list[list[universal.CallArgument]] = []
    for invocation in calls:
        match invocation.kind:
            case Call:
                lookup = callable_select_function(state, callable_path(callee), arguments)
                selection ?= lookup.selection
                if selection == None:
                    return error(callable_diagnostic("mock target must resolve to a function", invocation.span))
                if selection != None:
                    originals.append(selection.function)
                    bound_calls.append(selection.arguments)
            case _:
                return error(callable_diagnostic("mock rules must begin with an invocation", invocation.span))
    installed: list[string] = []
    for original in originals:
        if original.name in installed:
            continue
        installed.append(original.name)
        if original.result_type.index == 2:
            return error(callable_diagnostic("mock rules require a value-returning function", span))
        function := original
        ordinal = len(state.functions) + 1
        function.name = "$mock$" + string(ordinal) + "$" + original.name
        function.id = universal.FunctionId(u128(ordinal))
        function.semantic_key = universal.semantic_key([original.semantic_key, "mock", function.name])
        function.definition = universal.definition_from_key(function.semantic_key)
        function.result_type = callable_mock_result(state, original, errors, span)
        function.result = universal.named_type(definitions.type_name(function.result_type, state.records), [], span)
        function.lookup = state.namespace
        function.mock_functions = state.mock_functions[:]
        body = universal.empty_block()
        exhaustive := false
        rule := 0
        for target in originals:
            if target.name == original.name:
                # There is only one invocation of a zero-argument function.
                # Its first rule covers every call, so no fallback is reachable.
                if len(original.parameters) == 0:
                    body.statements.append(universal.Return(results[rule], span))
                    exhaustive = true
                    break
                condition := universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), span)
                for argument in bound_calls[rule]:
                    name ?= argument.name
                    if name != None:
                        parameter = universal.Expression(universal.Name(name), span)
                        equal = universal.Expression(universal.Binary(universal.operator_syntax(universal.Equal()), parameter, argument.value), span)
                        no = universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), span)
                        condition = universal.Expression(universal.Conditional(condition, equal, no), span)
                body.statements.append(universal.If(condition, universal.Block([universal.Return(results[rule], span)]), universal.empty_block(), span))
            rule += 1
        match fallback.kind:
            case ThrowValue:
                if not exhaustive:
                    body.statements.append(universal.Throw(value, span))
            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        function.body = body
        state.functions.append(function)
        state.mock_functions.append(universal.MockFunction(original.name, function.name))


def callable_mock_target(state: CallableAnalysis, function: universal.FunctionDeclaration, span: source.Span) -> string | diagnostics.Diagnostic:
    if len(state.mock_functions) == 0 or function.name.starts_with("$mock$"):
        return function.name
    for replacement in state.mock_functions:
        if replacement.original == function.name:
            return replacement.replacement
    if function.prelude or function.body == None or function.constructor or function.owner_type.index != 0:
        return function.name
    name = state.mock_functions[-1].replacement + "$through$" + function.name
    for existing in state.functions:
        if existing.name == name:
            return name
    errors: list[universal.TypeId] = []
    for replacement in state.mock_functions:
        for mock in state.functions:
            if mock.name == replacement.replacement:
                for record in state.records:
                    if record.type_id.index == mock.result_type.index:
                        for variant in universal.outcome_variants(record):
                            if definitions.error_conformance(state.declarations, state.records, variant):
                                errors.append(variant)
    specialized := function
    ordinal = len(state.functions) + 1
    specialized.name = name
    specialized.id = universal.FunctionId(u128(ordinal))
    specialized.semantic_key = universal.semantic_key([function.semantic_key, "mock-specialization", name])
    specialized.definition = universal.definition_from_key(specialized.semantic_key)
    if function.result_type.index != 2 and not definitions.error_conformance(state.declarations, state.records, function.result_type):
        specialized.result_type = callable_mock_result(state, function, errors, span)
        specialized.result = universal.named_type(definitions.type_name(specialized.result_type, state.records), [], span)
    specialized.mock_functions = state.mock_functions[:]
    state.functions.append(specialized)
    return name


def callable_error_expectation(state: CallableAnalysis, expected: universal.Expression) -> universal.Expression | diagnostics.Diagnostic:
    if callable_path(expected) == "Error":
        return universal.Expression(universal.ErrorExpectation(None, None), expected.span)
    if callable_type_operand(state, expected):
        type_id = callable_annotation(callable_type_expression(expected), state.records, state.namespace, state.declarations)
        if not definitions.error_conformance(state.declarations, state.records, type_id):
            return error(callable_diagnostic("throws expects an Error type", expected.span))
        return universal.Expression(universal.ErrorExpectation(None, None), expected.span, type_id=type_id)
    value = callable_expression(state, expected, universal.TypeId(0))
    if not definitions.error_conformance(state.declarations, state.records, value.type_id):
        return error(callable_diagnostic("throws expects an Error value", expected.span))
    left = universal.Expression(universal.UpdateOperand(0), expected.span, type_id=value.type_id)
    right = universal.Expression(universal.UpdateOperand(1), expected.span, type_id=value.type_id)
    comparison := universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), expected.span, type_id=universal.bool_type_id())
    no = universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), expected.span, type_id=universal.bool_type_id())
    for record in state.records:
        if record.type_id.index == value.type_id.index:
            index := 0
            for field in record.fields:
                a = universal.Expression(universal.FieldReference(left, index), expected.span, type_id=field.type_id)
                b = universal.Expression(universal.FieldReference(right, index), expected.span, type_id=field.type_id)
                equal = callable_expression(state, universal.Expression(universal.Binary(universal.operator_syntax(universal.Equal()), a, b), expected.span), universal.bool_type_id())
                comparison = universal.Expression(universal.Conditional(comparison, equal, no), expected.span, type_id=universal.bool_type_id())
                index += 1
    return universal.Expression(universal.ErrorExpectation(value, comparison), expected.span, type_id=value.type_id)


class FieldAccessResult:
    value: universal.Expression | None = None


def callable_saved_field_operand(state: CallableAnalysis, body: universal.Block, value: universal.Expression, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    binding = callable_binding(state, universal.Binding("$field_operand$" + string(state.next_id[0]), None, value, false, true, span))
    body.statements.append(universal.BindingStatement(binding))
    return universal.Expression(universal.BindingReference(binding.id), span, type_id=binding.type_id)


def callable_field_failure(state: CallableAnalysis, message: string, span: source.Span, result_type: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    local = callable_scope(state)
    local.catching_error = true
    text = universal.Expression(universal.LiteralValue(universal.StringValue(message)), span)
    constructor = universal.Expression(universal.Name("FieldError"), span)
    failure = universal.Expression(universal.Call(constructor, [universal.CallArgument(None, text, span)]), span)
    return callable_expression(local, universal.Expression(universal.ThrowValue(failure), span), result_type)


def callable_field_key(state: CallableAnalysis, record: universal.RecordDeclaration, value: universal.Expression) -> universal.Expression:
    match value.kind:
        case Name:
            if name not in state.names:
                for field in record.fields:
                    if field.name == name:
                        return universal.Expression(universal.LiteralValue(universal.StringValue(name)), value.span)
        case _:
            throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return value


def callable_literal_field(value: universal.Expression) -> string:
    match value.kind:
        case LiteralValue:
            match value:
                case StringValue:
                    return value
                case _:
                    throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        case _:
            throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return ""


def callable_field_access(state: CallableAnalysis, object: universal.Expression, operation: string, arguments: list[universal.CallArgument], span: source.Span, expected: universal.TypeId) -> FieldAccessResult | diagnostics.Diagnostic:
    local = callable_scope(state)
    body = universal.empty_block()
    receiver: universal.Expression | None := None
    # A builder starts with initialized storage, then validates each supplied
    # field through the same set path used for later updates.
    if operation == "set":
        match object.kind:
            case Call:
                if len(arguments) == 0:
                    name = callable_path(callee)
                    for record in state.records:
                        if record.name != name and record.name != state.namespace + name:
                            continue
                        constructor := false
                        for method in record.methods:
                            constructor = constructor or method.name == name.split(".")[-1]
                        if constructor:
                            continue
                        fields: list[universal.CallArgument] = []
                        for field in record.fields:
                            initial: universal.Expression := universal.Expression(universal.LiteralValue(universal.IntegerValue("0")), span)
                            if field.type_id.index == 3:
                                initial = universal.Expression(universal.LiteralValue(universal.StringValue("")), span)
                            elif field.type_id.index == 1:
                                initial = universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), span)
                            supplied ?= field.default
                            if supplied != None:
                                initial = supplied
                            fields.append(universal.CallArgument(field.name, callable_expression(local, initial, field.type_id), span))
                        storage = universal.Expression(universal.RecordValue(fields), span, type_id=record.type_id)
                        empty = universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), span, type_id=universal.bool_type_id())
                        receiver = callable_saved_field_operand(local, body, universal.Expression(universal.Evaluate(empty, storage), span, type_id=record.type_id), span)
            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    if receiver == None:
        receiver = callable_expression(local, object, universal.TypeId(0))
    selected ?= receiver
    if selected != None:
        for record in state.records:
            if record.type_id.index != selected.type_id.index:
                continue
            for method in record.methods:
                if method.name == operation:
                    return FieldAccessResult()
            if len(record.fields) == 0:
                return FieldAccessResult()
            subject := selected
            if loans.binding(subject) < 0:
                subject = callable_saved_field_operand(local, body, subject, span)
            keys: list[universal.Expression] = []
            values: list[universal.Expression] = []
            if operation == "set" and len(arguments) == 1:
                map_value = arguments[0].value
                match map_value.kind:
                    case MapLiteral:
                        return callable_field_updates(state, local, body, record, subject, keys, values, span, expected)
                    case _:
                        return error(callable_diagnostic("set requires a field and value, or a field map", span))
            if int(len(arguments)) != (1 if operation == "get" else 2):
                return error(callable_diagnostic(operation + " has the wrong number of arguments", span))
            for argument in arguments:
                if argument.name != None or argument.spread:
                    return error(callable_diagnostic(operation + " requires positional arguments", span))
            keys.append(arguments[0].value)
            if operation == "set":
                values.append(arguments[1].value)
                return callable_field_updates(state, local, body, record, subject, keys, values, span, expected)
            source_key = callable_field_key(local, record, keys[0])
            literal = callable_literal_field(source_key)
            key = callable_saved_field_operand(local, body, callable_expression(local, source_key, universal.string_type_id()), span)
            result_type := expected
            candidates: list[int] = []
            index := 0
            for field in record.fields:
                if (literal == "" or field.name == literal) and (state.owner.index == record.type_id.index or not field.name.starts_with("__")):
                    candidates.append(index)
                    if result_type.index == 0:
                        result_type = field.type_id
                    if result_type.index != field.type_id.index:
                        return error(callable_diagnostic("dynamic get requires fields with one common type; use a literal field name", span))
                index += 1
            if literal != "" and len(candidates) == 0:
                return error(callable_diagnostic("unknown or private field " + record.name + "." + literal, span))
            result := callable_field_failure(local, "unknown or private field on " + record.name, span, result_type)
            for index in candidates:
                field = record.fields[index]
                name = universal.Expression(universal.LiteralValue(universal.StringValue(field.name)), span)
                condition = callable_expression(local, universal.Expression(universal.Binary(universal.operator_syntax(universal.Equal()), key, name), span), universal.bool_type_id())
                value = universal.Expression(universal.FieldReference(subject, index), span, type_id=field.type_id)
                result = universal.Expression(universal.Conditional(condition, value, result), span, type_id=result_type)
            return FieldAccessResult(universal.Expression(universal.BlockValue(body, result), span, type_id=result_type))
    return FieldAccessResult()


def callable_field_updates(state: CallableAnalysis, local: CallableAnalysis, body: universal.Block, record: universal.RecordDeclaration, subject: universal.Expression, keys: list[universal.Expression], values: list[universal.Expression], span: source.Span, expected: universal.TypeId) -> FieldAccessResult | diagnostics.Diagnostic:
    root = loans.binding(subject)
    loans.access(state.loans, root, true, span)
    if root in state.readonly:
        return error(callable_diagnostic("set cannot mutate a shared borrow; use a writable receiver", span))
    commits = universal.empty_block()
    position := 0
    for source_key in keys:
        key_expression = callable_field_key(local, record, source_key)
        literal = callable_literal_field(key_expression)
        key = callable_saved_field_operand(local, body, callable_expression(local, key_expression, universal.string_type_id()), span)
        value = callable_saved_field_operand(local, body, callable_expression(local, values[position], universal.TypeId(0)), span)
        position += 1
        valid := callable_field_failure(local, "unknown, read-only, or incompatible field on " + record.name, span, universal.bool_type_id())
        found := false
        index := 0
        for field in record.fields:
            if (literal == "" or literal == field.name) and (state.owner.index == record.type_id.index or not field.name.starts_with("_")):
                if literal != "" and field.type_id.index != value.type_id.index:
                    return error(callable_diagnostic("field " + record.name + "." + field.name + " requires " + definitions.type_name(field.type_id, state.records), span))
                if field.type_id.index == value.type_id.index:
                    found = true
                    name = universal.Expression(universal.LiteralValue(universal.StringValue(field.name)), span)
                    condition = callable_expression(local, universal.Expression(universal.Binary(universal.operator_syntax(universal.Equal()), key, name), span), universal.bool_type_id())
                    checked = callable_field_value(local, record, field, value, span)
                    yes = universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), span, type_id=universal.bool_type_id())
                    validation = universal.Expression(universal.Evaluate(checked, yes), span, type_id=universal.bool_type_id())
                    valid = universal.Expression(universal.Conditional(condition, validation, valid), span, type_id=universal.bool_type_id())
                    target = universal.Expression(universal.FieldReference(subject, index), span, type_id=field.type_id)
                    update = callable_control(local, "Assign", [target, value], [], span)
                    commits.statements.append(callable_control(local, "If", [condition], [universal.Block([update]), universal.empty_block()], span))
            index += 1
        if literal != "" and not found:
            return error(callable_diagnostic("unknown or read-only field " + record.name + "." + literal, span))
        body.statements.append(universal.ExpressionStatement(valid))
    for commit in commits.statements:
        body.statements.append(commit)
    if expected.index != 0 and expected.index != record.type_id.index:
        return error(callable_diagnostic("set returns its receiver", span))
    return FieldAccessResult(universal.Expression(universal.BlockValue(body, subject), span, type_id=subject.type_id))


def callable_checked_assignment(state: CallableAnalysis, target: universal.Expression, value: universal.Expression, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    match target.kind:
        case FieldReference:
            for record in state.records:
                if record.type_id.index == object.type_id.index:
                    return callable_field_value(state, record, record.fields[index], value, span)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return value


def callable_field_value(state: CallableAnalysis, record: universal.RecordDeclaration, field: universal.FunctionParameter, value: universal.Expression, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    if len(field.field_constraints) == 0:
        return value
    local = callable_scope(state)
    local.namespace = record.lookup
    local.catching_error = true
    name = "$field_value$" + string(state.next_id[0])
    binding = callable_binding(local, universal.Binding(name, None, value, false, true, span))
    reference = universal.Expression(universal.BindingReference(binding.id), span, type_id=binding.type_id)
    body = universal.Block([universal.BindingStatement(binding)])
    for constraint in field.field_constraints:
        condition := packs.rename_expression(constraint.condition, [field.name], [name])
        condition = callable_expression(local, condition, universal.bool_type_id())
        failure ?= constraint.failure
        error_value := universal.Expression(universal.Call(universal.Expression(universal.Name("ConstraintError"), span), [universal.CallArgument(None, universal.Expression(universal.LiteralValue(universal.StringValue("constraint failed for field " + record.name + "." + field.name)), span), span)]), span)
        if failure != None:
            error_value = packs.rename_expression(failure, [field.name], [name])
        raised = callable_expression(local, universal.Expression(universal.ThrowValue(error_value), span), universal.bool_type_id())
        yes = universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), span, type_id=universal.bool_type_id())
        checked = universal.Expression(universal.Conditional(condition, raised if failure != None else yes, yes if failure != None else raised), span, type_id=universal.bool_type_id())
        body.statements.append(universal.ExpressionStatement(checked))
    return universal.Expression(universal.BlockValue(body, reference), span, type_id=value.type_id)


def callable_comparison_tail(state: CallableAnalysis, operands: list[universal.Expression], operators: list[universal.OperatorSyntax], index: int, left: universal.Expression, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    local = callable_scope(state)
    binding = callable_binding(local, universal.Binding("$comparison$" + string(state.next_id[0]), None, operands[index + 1], false, true, span))
    right = universal.Expression(universal.BindingReference(binding.id), span, type_id=binding.type_id)
    condition = callable_expression(local, universal.Expression(universal.Binary(operators[index], left, right), span), universal.bool_type_id())
    result := condition
    if index + 1 < len(operators):
        remainder = callable_comparison_tail(local, operands, operators, index + 1, right, span)
        no = universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), span, type_id=universal.bool_type_id())
        result = universal.Expression(universal.Conditional(condition, remainder, no), span, type_id=universal.bool_type_id())
    return universal.Expression(universal.BlockValue(universal.Block([universal.BindingStatement(binding)]), result), span, type_id=universal.bool_type_id())


def callable_raised_value(state: CallableAnalysis, value: universal.Expression, result_type: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    if state.destructor:
        return error(callable_diagnostic("a destructor cannot throw", value.span))
    raised = callable_expression(state, value, universal.TypeId(0))
    if not definitions.error_conformance(state.declarations, state.records, raised.type_id):
        return error(callable_diagnostic("throw requires a value conforming to Error", value.span))
    target := result_type
    if target.index == 2 or state.catching_error:
        # A local error edge needs an envelope with a storable success slot;
        # it never produces a success value or changes the function's result.
        alternatives = [universal.named_type("bool", [], value.span), universal.named_type(definitions.type_name(raised.type_id, state.records), [], value.span)]
        target = callable_annotation(universal.TypeAnnotation(universal.Union(alternatives), value.span), state.records, state.namespace, state.declarations)
    return callable_expression(state, raised, target)


def callable_has_drop(state: CallableAnalysis, type_id: universal.TypeId) -> bool:
    index = int(type_id.index) - 1000
    if index < 0 or index >= len(state.records):
        return false
    if len(state.drop_cache) != len(state.records):
        state.drop_cache.clear()
        for record in state.records:
            state.drop_cache.append(callable_needs_drop(state, record.type_id, []))
    return state.drop_cache[index]


def callable_needs_drop(state: borrow CallableAnalysis, type_id: universal.TypeId, ancestors: list[int]) -> bool:
    index = int(type_id.index) - 1000
    if index >= 0 and index < len(state.records) and index not in ancestors:
        for method in borrow state.records[index].methods:
            if method.name == "drop" or method.name.ends_with(".drop"):
                return true
        path = ancestors[:]
        path.append(index)
        for field in borrow state.records[index].fields:
            if callable_needs_drop(state, field.type_id, path):
                return true
    return false


def callable_field_transfer(state: CallableAnalysis, object: universal.Expression, index: int, span: source.Span) -> unit | diagnostics.Diagnostic:
    root = loans.binding(object)
    match object.kind:
        case BindingReference:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        case _:
            return error(callable_diagnostic("nested partial resource moves require initialized-place tracking", span))
    places.require_initialized(state.uninitialized, root, index, "use after drop or move of field", span)
    if not (state.destructor and root == 0):
        for record in state.records:
            if record.type_id.index == object.type_id.index:
                for method in record.methods:
                    if method.name == "drop" or method.name.ends_with(".drop"):
                        return error(callable_diagnostic("cannot partially move a value with custom cleanup outside its destructor", span))


def callable_transfer_result(state: CallableAnalysis, value: universal.Expression, span: source.Span, explicit: bool = false) -> unit | diagnostics.Diagnostic:
    match value.kind:
        case BindingReference:
            root = int(binding.index)
            if root not in state.dead:
                state.dead.append(root)
        case OutcomeValue:
            callable_transfer_result(state, value, span, explicit)
        case Ownership:
            callable_transfer_result(state, value, span, mode == "move")
        case FieldReference:
            if not explicit:
                return error(callable_diagnostic("returning an owned field requires move", span))
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")


def callable_destroy_fields(state: CallableAnalysis, value: universal.Expression, output: universal.Block, span: source.Span, run_hook: bool = true) -> unit | diagnostics.Diagnostic:
    index = definitions.record_position(state.records, value.type_id)
    if index < 0:
        return
    record = state.records[index]
    variants := universal.outcome_variants(record)
    if len(variants) == 0:
        variants = universal.union_variants(record)
    if len(variants) == 0 and record.representation == "TaggedAggregate":
        for field in record.fields[1:]:
            variants.append(field.type_id)
    if len(variants) != 0:
        ordinal := 0
        for variant in variants:
            if callable_has_drop(state, variant):
                cleanup = universal.empty_block()
                payload = universal.Expression(universal.FieldReference(value, ordinal + 1), span, type_id=variant)
                callable_destroy_fields(state, payload, cleanup, span)
                output.statements.append(callable_control(state, "If", [matches.tag_test(value, ordinal, span)], [cleanup, universal.empty_block()], span))
            ordinal += 1
        return
    # The cleanup hook borrows valid storage internally. Consumption belongs to
    # the enclosing destruction operation, after the hook and owned fields.
    for function in state.functions:
        if run_hook and function.name == record.name + ".drop":
            call = universal.Expression(universal.ResolvedCall(universal.Direct(lazy_bodies.require(state.required_functions, function.definition), universal.Substitution([])), [universal.CallArgument("self", value, span)]), span, type_id=universal.unit_type_id())
            output.statements.append(universal.ExpressionStatement(call))
            return
    cursor := int(len(record.fields))
    while cursor > 0:
        cursor -= 1
        field = record.fields[cursor]
        initialized := true
        match value.kind:
            case BindingReference:
                initialized = places.initialized(state.uninitialized, int(binding.index), cursor)
            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        if initialized and callable_has_drop(state, field.type_id):
            member = universal.Expression(universal.FieldReference(value, cursor), span, type_id=field.type_id)
            callable_destroy_fields(state, member, output, span)


def callable_drop(state: CallableAnalysis, value: universal.Expression, output: universal.Block, span: source.Span) -> unit | diagnostics.Diagnostic:
    projecting = state.projecting
    state.projecting = true
    resolved = callable_expression(state, value, universal.TypeId(0))
    state.projecting = projecting
    match resolved.kind:
        case FieldReference:
            root = loans.binding(object)
            if root < 0 or (root not in state.resources and not (state.destructor and root == 0)):
                return error(callable_diagnostic("cannot drop a borrowed resource field", span))
            loans.access(state.loans, root, true, span)
            callable_field_transfer(state, object, index, span)
            callable_destroy_fields(state, resolved, output, span)
            state.uninitialized.append((root, index))
        case BindingReference:
            index = int(binding.index)
            remaining: list[loans.Loan] = []
            released := false
            for loan in state.loans:
                if loan.borrower == index:
                    released = true
                else:
                    remaining.append(loan)
            if released:
                state.loans = remaining
                state.dead.append(index)
                return
            loans.release(state.loans, index, index in state.borrowed_parameters, span)
            if callable_has_drop(state, resolved.type_id):
                if index not in state.resources:
                    return error(callable_diagnostic("cannot drop a borrowed resource parameter", span))
                if state.loop_depth != 0 and index not in state.resources[state.loop_resource_start:]:
                    return error(callable_diagnostic("cannot consume an outer resource from a repeating loop", span))
                callable_destroy_fields(state, resolved, output, span)
            state.dead.append(index)
        case _:
            return error(callable_diagnostic("drop requires a local binding", span))


def callable_cleanup(state: CallableAnalysis, output: universal.Block, start: int, span: source.Span) -> unit | diagnostics.Diagnostic:
    cursor := int(len(state.resources))
    while cursor > start:
        cursor -= 1
        binding = state.resources[cursor]
        if binding not in state.dead:
            value = universal.Expression(universal.Name(state.names[binding]), span)
            callable_drop(state, value, output, span)


def callable_deferred_cleanup(state: CallableAnalysis, output: universal.Block, start: int) -> unit | diagnostics.Diagnostic:
    for expression in state.deferred[start:][::-1]:
        output.statements.append(callable_expression_statement(state, expression))


def callable_contract_checks(state: CallableAnalysis, output: universal.Block, role: universal.AttachmentRole) -> unit | diagnostics.Diagnostic:
    for attachment in state.attachments:
        if attachment.role == role:
            condition = attachment.condition
            if attachment.stage == universal.ConstraintStage.Static:
                result = constraints.prove_condition(condition)
                if result != universal.ProofResult.Proven:
                    return error(callable_diagnostic("static contract could not be proved", condition.span))
                continue
            output.statements.append(callable_assertion(state, condition, None, condition.span, condition.span))


def callable_block(state: CallableAnalysis, statements: list[universal.Statement], result_type: universal.TypeId, complete: bool = true, origin: source.Span | None = None) -> universal.Block | diagnostics.Diagnostic:
    output = universal.empty_block()
    output.span = origin
    resource_start = int(len(state.resources))
    defer_start = int(len(state.deferred))
    returned := false
    loop_exit := false
    index := 0
    for statement in statements:
        state.loans = loans.retained(state.loans)
        if returned:
            if loop_exit:
                break
            return error(callable_diagnostic("statement after unconditional return", None))
        match statement:
            case Defer:
                # Validate lexical scope now and check ownership again at exit.
                callable_expression_statement(callable_scope(state), value)
                state.deferred.append(value)
            case Unsafe:
                local = callable_scope(state)
                local.unsafe_depth += 1
                typed = callable_block(local, body.statements, result_type, false, origin=body.span)
                for binding in local.dead:
                    if binding < len(state.names) and binding not in state.dead:
                        state.dead.append(binding)
                condition = universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), span, type_id=universal.bool_type_id())
                returned = callable_terminates(typed)
                output.statements.append(callable_control(state, "If", [condition], [typed, universal.empty_block()], span, returned))
            case CompilerCheck:
                if not state.test_context:
                    return error(callable_diagnostic("compiler expectations require a test body", span))
                isolated = callable_scope(state)
                isolated.functions = state.functions[:]
                isolated.function_index = callable_index.FunctionIndex()
                isolated.records = state.records[:]
                isolated.generics = state.generics[:]
                isolated.generic_index = callable_index.FunctionIndex()
                isolated.declarations = definitions.SemanticDefinitions(state.declarations.aliases[:], state.declarations.traits, state.declarations.implementations, record_templates=state.declarations.record_templates, record_instances=state.declarations.record_instances[:])
                checked ?= callable_check_compiler_case(isolated, body)
                rejected := false
                if checked is Diagnostic:
                    rejected = true
                if rejected != reject:
                    return error(callable_diagnostic("compiler test expectation failed", span))
            case Drop:
                callable_drop(state, value, output, span)
            case BindingStatement:
                field ?= callable_implicit_field(state, binding.name, binding.span)
                implicit := false
                if field != None:
                    if not binding.scoped and binding.name not in state.names and binding.annotation == None and not binding.mutable:
                        target = callable_expression(state, field, universal.TypeId(0))
                        value = callable_expression(state, binding.value, target.type_id)
                        output.statements.append(callable_control(state, "Assign", [target, value], [], binding.span))
                        implicit = true
                if not implicit:
                    typed_binding = callable_binding(state, binding)
                    if callable_has_drop(state, typed_binding.type_id):
                        match typed_binding.value.kind:
                            case BindingReference:
                                return error(callable_diagnostic("resource aliases require an explicit ownership transfer", typed_binding.span))
                            case FieldReference:
                                return error(callable_diagnostic("resource field transfers are not supported", binding.span))
                            case _:
                                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                        if typed_binding.update:
                            saved = callable_binding(state, universal.Binding("$replacement$" + string(len(state.names)), None, typed_binding.value, false, true, binding.span))
                            output.statements.append(universal.BindingStatement(saved))
                            replaced = int(typed_binding.id.index)
                            if replaced not in state.dead:
                                old = universal.Expression(universal.BindingReference(typed_binding.id), binding.span, type_id=typed_binding.type_id)
                                callable_drop(state, old, output, binding.span)
                            alive: list[int] = []
                            for dead in state.dead:
                                if dead != replaced:
                                    alive.append(dead)
                            state.dead = alive
                            typed_binding.value = universal.Expression(universal.BindingReference(saved.id), binding.span, type_id=saved.type_id)
                        else:
                            state.resources.append(int(typed_binding.id.index))
                    output.statements.append(universal.BindingStatement(typed_binding))
            case FieldSet:
                state.initializing = update == None
                resolved = callable_expression(state, target, universal.TypeId(0))
                state.initializing = false
                root = loans.binding(resolved)
                if root >= 0:
                    loans.access(state.loans, root, true, span)
                    if root in state.readonly:
                        return error(callable_diagnostic("cannot mutate a shared borrow parameter", span))
                if callable_has_drop(state, resolved.type_id):
                    return error(callable_diagnostic("resource replacement requires ownership transfer support", span))
                match resolved.kind:
                    case BindingReference:
                        if not state.mutables[binding.index]:
                            return error(callable_diagnostic("cannot reassign immutable binding", span))
                    case FieldReference:
                        for record in state.records:
                            if record.type_id.index == object.type_id.index and state.owner.index != record.type_id.index:
                                if record.fields[index].name.starts_with("_"):
                                    return error(callable_diagnostic("field is read-only: " + record.fields[index].name, span))
                    case IndexReference:
                        if storage == None:
                            return error(callable_diagnostic("indexed storage is not writable", span))
                    case _:
                        return error(callable_diagnostic("assignment requires a writable place", span))
                value_type := resolved.type_id
                if update != None:
                    hint = callable_hint(state, value)
                    if hint.index != 0 and hint.index != resolved.type_id.index and (not conversions.scalar_numeric(hint) or not conversions.scalar_numeric(resolved.type_id)):
                        value_type = universal.TypeId(0)
                typed = callable_expression(state, value, value_type)
                match resolved.kind:
                    case FieldReference:
                        state.uninitialized = places.initialize(state.uninitialized, root, index)
                    case IndexReference:
                        remaining: list[tuple[int, int]] = []
                        for moved in state.moved_elements:
                            if moved[0] != root or moved[1] != loans.constant_index(index):
                                remaining.append(moved)
                        state.moved_elements = remaining
                    case _:
                        throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                match resolved.kind:
                    case BindingReference:
                        callable_transition(state, int(binding.index), typed, span, true)
                    case _:
                        throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                syntax ?= update
                if syntax != None:
                    operation := ""
                    definition ?= definitions.trait_named(state.declarations, syntax.grammar_name, "")
                    if definition != None:
                        for property in definition.properties:
                            if property.name == "operation":
                                supplied ?= property.default
                                if supplied != None:
                                    match supplied.kind:
                                        case LiteralValue:
                                            match value:
                                                case StringValue:
                                                    operation = value
                                                case _:
                                                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                                        case _:
                                            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                    if operation == "":
                        return error(callable_diagnostic("assignment grammar requires an update operation", span))
                    previous = universal.Expression(universal.UpdateOperand(0), span, type_id=resolved.type_id)
                    right = universal.Expression(universal.UpdateOperand(1), span, type_id=typed.type_id)
                    implementation = callable_operator(state, operation, [resolved.type_id, typed.type_id], span)
                    function ?= implementation.function
                    if function == None:
                        return error(callable_diagnostic("assignment requires a resolved update implementation " + operation, span))
                    if function != None:
                        updated = callable_resolved_operator(state, function, [previous, right], span, resolved.type_id)
                        checked = callable_checked_assignment(state, resolved, updated, span)
                        output.statements.append(universal.GrammarApply(syntax, [resolved, typed, checked], [], span, false))
                else:
                    checked = callable_checked_assignment(state, resolved, typed, span)
                    output.statements.append(callable_control(state, "Assign", [resolved, checked], [], span))
            case ExpressionStatement:
                dropped := false
                match expression.kind:
                    case Call:
                        match callee.kind:
                            case Member:
                                if name == "drop":
                                    if len(arguments) != 0:
                                        return error(callable_diagnostic("drop takes no arguments after its receiver", expression.span))
                                    callable_drop(state, object, output, expression.span)
                                    dropped = true
                            case _:
                                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                    case _:
                        throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                if not dropped:
                    output.statements.append(callable_expression_statement(state, expression))
            case Assert:
                output.statements.append(callable_assertion(state, condition, message, span, condition_span))
            case Throw:
                if state.destructor:
                    return error(callable_diagnostic("a destructor cannot throw", span))
                wrapped = callable_raised_value(state, value, result_type)
                saved = callable_binding(state, universal.Binding("$throw$" + string(state.next_id[0]), None, wrapped, false, true, span))
                output.statements.append(universal.BindingStatement(saved))
                callable_deferred_cleanup(state, output, 0)
                callable_contract_checks(state, output, universal.AttachmentRole.Fix)
                callable_contract_checks(state, output, universal.AttachmentRole.Exit)
                callable_cleanup(state, output, 0, span)
                output.statements.append(callable_control(state, "Throw", [universal.Expression(universal.BindingReference(saved.id), span, type_id=saved.type_id)], [], span, true))
                returned = true
            case Return:
                returned_value: universal.Expression | None := None
                expression_value ?= value
                if expression_value != None:
                    if result_type.index == 2:
                        return error(callable_diagnostic("unit function cannot return a value", span))
                    previous_creation = state.resource_creation
                    if callable_has_drop(state, result_type):
                        state.resource_creation = expression_value.span
                    typed_return = callable_expression(state, expression_value, result_type)
                    returned_value = typed_return
                    if state.result_mode in ["borrow", "borrow mut"]:
                        root = loans.owner(state.loans, loans.binding(typed_return))
                        if root != state.result_origin:
                            return error(callable_diagnostic("returned borrow must originate from its declared parameter", span))
                        if state.result_mode == "borrow mut" and root in state.readonly:
                            return error(callable_diagnostic("cannot return a mutable borrow of a view", span))
                    elif not storage_types.copy_storage(typed_return.type_id, state.records):
                        root = loans.owner(state.loans, loans.binding(typed_return))
                        if root in state.borrowed_parameters:
                            return error(callable_diagnostic("cannot return an owned value from a borrowed parameter; use copy or a borrowed result", span))
                    state.resource_creation = previous_creation
                elif result_type.index == 6:
                    returned_value = callable_expression(state, universal.Expression(universal.LiteralValue(universal.NoneValue()), span), result_type)
                elif result_type.index != 2:
                    return error(callable_diagnostic("scalar function must return a value", span))
                operands: list[universal.Expression] = []
                actual ?= returned_value
                if actual != None:
                    if callable_has_drop(state, actual.type_id):
                        callable_transfer_result(state, actual, span)
                    if len(state.deferred) != 0 or len(state.resources) != 0 or len(state.attachments) != 0:
                        saved = callable_binding(state, universal.Binding("$defer$return$" + string(state.next_id[0]), None, actual, false, true, span))
                        output.statements.append(universal.BindingStatement(saved))
                        operands.append(universal.Expression(universal.BindingReference(saved.id), span, type_id=saved.type_id))
                    else:
                        operands.append(actual)
                callable_deferred_cleanup(state, output, 0)
                callable_contract_checks(state, output, universal.AttachmentRole.Fix)
                callable_contract_checks(state, output, universal.AttachmentRole.Exit)
                callable_cleanup(state, output, 0, span)
                if state.destructor:
                    receiver = universal.Expression(universal.BindingReference(universal.BindingId(0)), span, type_id=state.types[0])
                    callable_destroy_fields(state, receiver, output, span, false)
                output.statements.append(callable_control(state, "Return", operands, [], span, true))
                returned = true
            case GrammarApply:
                resolved_operands: list[universal.Expression] = []
                for operand in operands:
                    resolved_operands.append(callable_expression(state, operand, universal.TypeId(0)))
                resolved_bodies: list[universal.Block] = []
                for body in bodies:
                    resolved_bodies.append(callable_block(callable_scope(state), body.statements, result_type, false, origin=body.span))
                output.statements.append(universal.GrammarApply(syntax, resolved_operands, resolved_bodies, span, exits))
            case If:
                resolved = callable_truth(state, condition)
                then_state = callable_scope(state)
                else_state = callable_scope(state)
                match resolved.kind:
                    case OutcomeTest:
                        match value.kind:
                            case BindingReference:
                                then_state.refinements.append((int(binding.index), variant))
                            case _:
                                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                    case _:
                        throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                then_typed = callable_block(then_state, then_block.statements, result_type, false, origin=then_block.span)
                else_typed = callable_block(else_state, else_block.statements, result_type, false, origin=else_block.span)
                callable_join_transitions(state, then_state, else_state)
                then_exits = callable_terminates(then_typed)
                else_exits = callable_terminates(else_typed)
                state.uninitialized.clear()
                state.moved_elements.clear()
                if not then_exits:
                    for moved in then_state.moved_elements:
                        if moved[0] < len(state.names):
                            state.moved_elements.append(moved)
                    for missing in then_state.uninitialized:
                        if missing[0] < len(state.names):
                            state.uninitialized.append(missing)
                if not else_exits:
                    for moved in else_state.moved_elements:
                        if moved[0] < len(state.names):
                            state.moved_elements.append(moved)
                    for missing in else_state.uninitialized:
                        if missing[0] < len(state.names):
                            state.uninitialized.append(missing)
                if not then_exits and not else_exits:
                    for missing in state.uninitialized:
                        field_type = state.records[int(state.types[missing[0]].index) - 1000].fields[missing[1]].type_id
                        if callable_has_drop(state, field_type):
                            in_then := false
                            in_else := false
                            for field in then_state.uninitialized:
                                if field[0] == missing[0] and field[1] == missing[1]:
                                    in_then = true
                            for field in else_state.uninitialized:
                                if field[0] == missing[0] and field[1] == missing[1]:
                                    in_else = true
                            if in_then != in_else:
                                return error(callable_diagnostic("conditional field destruction requires matching branch lifetimes", span))
                    for binding in state.resources:
                        if (binding in then_state.dead) != (binding in else_state.dead):
                            return error(callable_diagnostic("conditional resource drop requires matching branch lifetimes", span))
                if not then_exits:
                    for binding in then_state.dead:
                        if binding < len(state.names) and binding not in state.dead:
                            state.dead.append(binding)
                if not else_exits:
                    for binding in else_state.dead:
                        if binding < len(state.names) and binding not in state.dead:
                            state.dead.append(binding)
                returned = callable_terminates(universal.Block([universal.If(resolved, then_typed, else_typed, span)]))
                output.statements.append(callable_control(state, "If", [resolved], [then_typed, else_typed], span, returned))
            case Match:
                local = callable_scope(state)
                binding = callable_binding(local, universal.Binding("$match_subject_" + string(span.start), None, subject, false, true, span))
                resolved_arms = matches.resolve_arms(state.declarations, state.records, state.namespace, binding.id, binding.type_id, arms, span, false)
                tail := universal.empty_block()
                cursor := len(resolved_arms)
                while cursor > 0:
                    cursor -= 1
                    arm = resolved_arms[cursor]
                    # Tagged matches have proven coverage; a final wildcard is
                    # unconditional for scalar matches as well.
                    last = arms[cursor]
                    exhaustive := last.pattern == None and last.annotation == None
                    for record in state.records:
                        if record.type_id.index == binding.type_id.index:
                            if record.representation == "TaggedAggregate" or len(universal.union_variants(record)) != 0 or len(universal.outcome_variants(record)) != 0:
                                exhaustive = true
                    if cursor == len(resolved_arms) - 1 and exhaustive:
                        tail = arm.body
                    else:
                        tail = universal.Block([universal.If(arm.condition, arm.body, tail, span)])
                typed = callable_block(local, tail.statements, result_type, false, origin=tail.span)
                output.statements.append(universal.BindingStatement(binding))
                for nested in typed.statements:
                    output.statements.append(nested)
                returned = callable_terminates(typed)
                state.transitions.clear()
            case ForEach:
                state.transitions.clear()
                pack = callable_field_pack(state, iterable)
                expanded := universal.empty_block()
                if pack.found:
                    expanded = callable_pack_iteration(state, name, pack, body, span, result_type)
                else:
                    expanded = callable_iteration(state, name, iterable, body, span, result_type)
                for nested in expanded.statements:
                    output.statements.append(nested)
            case While:
                # A loop may execute repeatedly; discard straight-line state
                # facts before checking its body and subsequent statements.
                state.transitions.clear()
                resolved = callable_expression(state, condition, universal.bool_type_id())
                local = callable_scope(state)
                local.loop_depth += 1
                local.loop_defer_start = int(len(local.deferred))
                local.loop_resource_start = int(len(local.resources))
                typed = callable_block(local, body.statements, result_type, false, origin=body.span)
                output.statements.append(callable_control(state, "While", [resolved], [typed], span))
            case Break:
                if state.loop_depth == 0:
                    return error(callable_diagnostic("break outside a loop", span))
                callable_deferred_cleanup(state, output, state.loop_defer_start)
                callable_contract_checks(state, output, universal.AttachmentRole.Fix)
                callable_cleanup(state, output, state.loop_resource_start, span)
                output.statements.append(callable_control(state, "Break", [], [], span, true))
                returned = true
                loop_exit = true
            case Continue:
                if state.loop_depth == 0:
                    return error(callable_diagnostic("continue outside a loop", span))
                callable_deferred_cleanup(state, output, state.loop_defer_start)
                callable_contract_checks(state, output, universal.AttachmentRole.Fix)
                callable_cleanup(state, output, state.loop_resource_start, span)
                output.statements.append(callable_control(state, "Continue", [], [], span, true))
                returned = true
                loop_exit = true
            case _:
                return error(callable_diagnostic("statement is outside the scalar bootstrap subset", None))
        if not returned:
            callable_contract_checks(state, output, universal.AttachmentRole.Fix)
        index += 1
    if not returned:
        callable_deferred_cleanup(state, output, defer_start)
        callable_contract_checks(state, output, universal.AttachmentRole.Fix)
        if complete:
            callable_contract_checks(state, output, universal.AttachmentRole.Exit)
        callable_cleanup(state, output, 0 if complete else resource_start, source.Span(source.SourceId(0), 0, 0))
    if complete and not returned:
        if state.destructor:
            span = source.Span(source.SourceId(0), 0, 0)
            receiver = universal.Expression(universal.BindingReference(universal.BindingId(0)), span, type_id=state.types[0])
            callable_destroy_fields(state, receiver, output, span, false)
        if result_type.index == 6:
            span = source.Span(source.SourceId(0), 0, 0)
            value = callable_expression(state, universal.Expression(universal.LiteralValue(universal.NoneValue()), span), result_type)
            output.statements.append(callable_control(state, "Return", [value], [], span, true))
            return output
        if result_type.index != 2:
            return error(callable_diagnostic("scalar function can reach its end without returning a value", None))
        output.statements.append(callable_control(state, "Return", [], [], source.Span(source.SourceId(0), 0, 0), true))
    return output


def callable_signature(declaration: universal.FunctionDeclaration, ordinal: int, records: list[universal.RecordDeclaration] = [], declarations: definitions.SemanticDefinitions = definitions.SemanticDefinitions()) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
    if len(declaration.type_parameters) != 0 or len(declaration.constraints) != 0:
        return error(callable_diagnostic("generic or decorated functions are outside the scalar bootstrap subset", declaration.span))
    operation = boundary.scalar_boundary(declaration, "mlir")
    symbol = boundary.scalar_boundary(declaration, "c")
    if operation in ["cf.br", "cf.cond_br", "cf.switch", "func.return", "llvm.unreachable"]:
        return error(callable_diagnostic("CFG terminators require a compiler context and grammar capability", declaration.span))
    if len(declaration.decorators) != 0:
        if len(declaration.decorators) != 1 or (operation == "" and symbol == ""):
            return error(callable_diagnostic("unsupported scalar boundary annotation", declaration.span))
        if declaration.body != None:
            return error(callable_diagnostic("boundary declarations cannot have source bodies", declaration.span))
        if operation != "" and len(operation.split(".")) != 2:
            return error(callable_diagnostic("MLIR operation must have a dialect and mnemonic", declaration.span))
        if symbol != "":
            symbols := 0
            for argument in declaration.decorators[0].arguments:
                if argument.name == "" or argument.name == "symbol" or argument.name == None:
                    symbols += 1
            if symbols != 1:
                return error(callable_diagnostic("C boundary requires exactly one symbol", declaration.span))
        argument_names: list[string] = []
        for argument in declaration.decorators[0].arguments:
            argument_name ?= argument.name
            if argument_name != None:
                if argument_name in argument_names:
                    return error(callable_diagnostic("duplicate boundary argument", declaration.span))
                argument_names.append(argument_name)
                if argument_name != "" and operation == "" and not (symbol != "" and argument_name in ["symbol", "libraries"]):
                    return error(callable_diagnostic("unsupported boundary argument", declaration.span))
                if operation != "" and argument_name != "":
                    match argument.value:
                        case String:
                            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                        case _:
                            return error(callable_diagnostic("MLIR operation attributes require string literals", declaration.span))
        try:
            boundary.scalar_requirements(declaration, boundary.LoweringRequirements())
        catch failure: Error:
            return error(callable_diagnostic(failure.message, declaration.span))
        segments = boundary.scalar_operand_segments(declaration)
        if len(segments) != 0:
            size := 0
            for segment in segments:
                size += segment
            if size != int(len(declaration.parameters)):
                return error(callable_diagnostic("operand segments must account for every parameter", declaration.span))
    elif declaration.body == None:
        return error(callable_diagnostic("scalar function requires a body", declaration.span))
    namespace := ""
    lookup ?= declaration.lookup
    if lookup != None:
        namespace = lookup
    parameter_names: list[string] = []
    parameter_types: list[universal.TypeId] = []
    typed_parameters: list[universal.FunctionParameter] = []
    for source_parameter in declaration.parameters:
        parameter := source_parameter
        if parameter.name in parameter_names:
            return error(callable_diagnostic("duplicate parameter " + parameter.name, parameter.span))
        default_value ?= parameter.default
        if default_value != None:
            match default_value.kind:
                case LiteralValue:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                case _:
                    return error(callable_diagnostic("bootstrap parameter defaults must be literals", parameter.span))
        type_id = callable_annotation(parameter.annotation, records, namespace, declarations)
        if default_value != None:
            callable_expression(CallableAnalysis(), default_value, type_id)
        if type_id.index == 2:
            return error(callable_diagnostic("unit cannot be a scalar parameter", parameter.span))
        parameter.type_id = type_id
        parameter = callable_parameter_contract(parameter, records)
        if storage_types.indirect_value(type_id, records) and declaration.body != None:
            parameter.modifiers.append(universal.BoundaryModifier("reference"))
        parameter_names.append(parameter.name)
        parameter_types.append(type_id)
        typed_parameters.append(parameter)
    declaration.parameters = typed_parameters
    if declaration.extension and len(parameter_types) != 0:
        declaration.owner_type = parameter_types[0]
    result_type := universal.unit_type_id()
    annotation ?= declaration.result
    if annotation != None:
        result_type = callable_annotation(annotation, records, namespace, declarations)
    if symbol != "":
        if symbol == "main" or symbol.starts_with("__sev_scalar_") or symbol.starts_with("__sev_string_"):
            return error(callable_diagnostic("reserved external symbol " + symbol, declaration.span))
        if result_type.index == 3 or result_type.index == 4:
            return error(callable_diagnostic("C boundaries require scalar ABI types", declaration.span))
        for parameter_type in parameter_types:
            if parameter_type.index == 3 or parameter_type.index == 4:
                return error(callable_diagnostic("C boundaries require scalar ABI types", declaration.span))
    declaration.parameter_types = parameter_types
    declaration.result_type = result_type
    if declaration.result_mode in ["borrow", "borrow mut"]:
        origin := -1
        index := 0
        for parameter in declaration.parameters:
            for modifier in parameter.modifiers:
                if modifier.name == declaration.result_mode and parameter.type_id.index == result_type.index:
                    if origin >= 0:
                        return error(callable_diagnostic("borrowed result requires one matching parameter origin", declaration.span))
                    origin = index
            index += 1
        if origin < 0:
            return error(callable_diagnostic("borrowed result requires a matching borrowed parameter", declaration.span))
        declaration.result_origin = origin
    declaration.id = universal.FunctionId(u128(ordinal + 1))
    if declaration.semantic_key == "":
        declaration.semantic_key = universal.callable_key(declaration, "$generated")
    if declaration.definition.declaration.value == 0:
        declaration.definition = universal.definition_from_key(declaration.semantic_key)
    return declaration


def callable_check_compiler_case(state: CallableAnalysis, block: universal.Block) -> bool | diagnostics.Diagnostic:
    state.test_context = true
    index = int(len(state.functions))
    callable_block(state, block.statements, universal.unit_type_id(), origin=block.span)
    cursor := index
    # Pack calls may append signatures. Check their bodies too, without leaking
    # either successful or rejected specializations into the surrounding module.
    while cursor < len(state.functions):
        function = state.functions[cursor]
        cursor += 1
        callable_body(state, function)
    return true


def semantic_stage(previous: float, name: string) -> float:
    if environment.get("SEVERIAN_PROFILE_ACTIVE", "") == "1":
        now = time.monotonic()
        process.write_error("  Semantic " + name + ": " + string(now - previous) + "s\n")
        return now
    return previous


def analyze_registered_callables(module: universal.Module, include_tests: bool, visible: list[universal.FunctionDeclaration], own_ids: list[universal.FunctionId], test_ids: list[universal.FunctionId], environment: definitions.SemanticDefinitions, initializer_namespace: string = "", source_files: list[source.SourceFile] = [], prepared: list[PreludeAnalysis] = [], captured: list[PreludeAnalysis] = []) -> universal.Module | diagnostics.Diagnostic:
    module = with_clauses.expand_dispatch(module)
    measured := time.monotonic()
    policies = prepared[0].declarations.traits if len(prepared) > 0 else environment.traits
    module = test_modes.expand(module, include_tests, initializer_namespace, policies, source_files)
    registered = definitions.register_declarations(module, prepared[0].declarations if len(prepared) > 0 else environment, len(prepared) > 0)
    measured = semantic_stage(measured, "declarations")
    state = CallableAnalysis(functions=visible[:], declarations=registered, namespace=initializer_namespace, source_files=source_files, excluded_functions=module.excluded_functions, prelude_sources=module.prelude_sources)
    existing_records := 0
    existing_functions := int(len(visible))
    existing_generics := 0
    if len(prepared) > 0:
        previous = prepared[0]
        state.functions = previous.module.functions[:]
        state.records = previous.module.records[:]
        state.templates = previous.templates[:]
        state.generics = previous.generics[:]
        state.constants = previous.constants[:]
        state.names = previous.names[:]
        state.types = previous.types[:]
        state.mutables = previous.mutables[:]
        state.next_id = previous.next_id[:]
        state.registered_methods = previous.registered_methods[:]
        module.functions = previous.module.functions[:]
        module.generic_functions = previous.module.generic_functions[:]
        module.bindings = previous.module.bindings[:]
        module.initializer = universal.Block(previous.module.initializer.statements[:])
        existing_records = int(len(state.records))
        existing_functions = int(len(state.functions))
        existing_generics = int(len(state.generics))
    own_index := 0
    function_names: list[string] = []
    if len(prepared) > 0:
        for function in state.functions:
            function_names.append(function.name)
        for function in state.generics:
            function_names.append(function.name)
        for function in state.templates:
            function_names.append(function.name)
    for item in module.items:
        match item:
            case Record:
                if declaration.extension or definitions.alias_named(state.declarations, declaration.name, declaration.lookup) != None:
                    continue
                if len(declaration.type_parameters) != 0:
                    continue
                record_declaration := declaration
                for previous in state.records:
