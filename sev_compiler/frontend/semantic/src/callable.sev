    index := existing_functions
    record_index := existing_records
    # Conformance can discover provider methods and their specializations.
    # Process those bodies before finalizing the module as well.
    completed: list[int] = []
    progress := true
    while progress:
        progress = false
        index = existing_functions
        while index < len(state.functions):
            position = index
            function := state.functions[index]
            index += 1
            if position in completed or not lazy_bodies.needed(state.required_functions, function):
