                        continue
                if len(function_declaration.type_parameters) != 0:
                    callable_register_generic(state, function_declaration)
                    function_names.append(function_declaration.name)
                    continue
                variadic := false
                for parameter in function_declaration.parameters:
                    if parameter.variadic:
