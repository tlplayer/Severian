    tagged.layouts(state.records, existing_records)
    callable_register_aliases(state)
    for implementation in state.declarations.implementations[int(len(prepared[0].declarations.implementations)) if len(prepared) > 0 else 0:]:
        if not implementation.extension or len(implementation.methods) == 0 or len(implementation.type_parameters) != 0:
            continue
        owners = definitions.family_members(state.declarations, definitions.extension_annotation(implementation), state.records, implementation.lookup)
        for owner in owners:
            for record in state.records:
                if record.type_id.index != owner.index:
