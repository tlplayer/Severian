class TransitionState:
    binding: int
    variants: list[int]


class CallableAnalysis:
    names: list[string] = []
    types: list[universal.TypeId] = []
    functions: list[universal.FunctionDeclaration] = []
    next_id: list[int] = [0]
    namespace: string = ""
    mutables: list[bool] = []
    constants: list[universal.Binding] = []
    templates: list[universal.FunctionDeclaration] = []
    records: list[universal.RecordDeclaration] = []
    owner: universal.TypeId = universal.TypeId(0)
    loop_depth: int = 0
    declarations: definitions.SemanticDefinitions = definitions.SemanticDefinitions()
    generics: list[universal.FunctionDeclaration] = []
    contract: universal.FunctionDeclaration | None = None
    refinements: list[tuple[int, int]] = []
    transitions: list[TransitionState] = []
    dead: list[int] = []
    resources: list[int] = []
    drop_cache: list[bool] = []
    deferred: list[universal.Expression] = []
    loop_defer_start: int = 0
    loop_resource_start: int = 0
    destructor: bool = false
    test_context: bool = false
    resource_creation: source.Span | None = None
    unsafe_depth: int = 0
    loans: list[loans.Loan] = []
    readonly: list[int] = []
    borrowed_parameters: list[int] = []
    result_mode: string = ""
    result_origin: int = -1
    uninitialized: list[tuple[int, int]] = []
    moved_elements: list[tuple[int, int]] = []
    projecting: bool = false
    initializing: bool = false
    parameter_effects: list[parameter_effects.CachedEffect] = []
    closures: list[closures.Closure] = []
    source_files: list[source.SourceFile] = []
    excluded_functions: list[string] = []
    prelude_sources: list[int] = []
    function_index: callable_index.FunctionIndex = callable_index.FunctionIndex()
    generic_index: callable_index.FunctionIndex = callable_index.FunctionIndex()
    template_index: callable_index.FunctionIndex = callable_index.FunctionIndex()
    registered_methods: list[int] = []
    return_type: universal.TypeId = universal.unit_type_id()
    catching_error: bool = false
    mock_functions: list[universal.MockFunction] = []
    attachments: list[universal.WithAttachment] = []
    required_functions: list[universal.DefId] = []
    body_cache: lazy_bodies.BodyCache = lazy_bodies.BodyCache()


class PreludeAnalysis:
    module: universal.Module
    declarations: definitions.SemanticDefinitions
    templates: list[universal.FunctionDeclaration]
    generics: list[universal.FunctionDeclaration]
    constants: list[universal.Binding]
    names: list[string]
    types: list[universal.TypeId]
    mutables: list[bool]
    next_id: list[int]
    registered_methods: list[int]


def callable_diagnostic(message: string, span: source.Span | None) -> diagnostics.Diagnostic:
    return diagnostics.Diagnostic("E000200", message, span)


def callable_parameter_value(state: CallableAnalysis, parameter: universal.FunctionParameter, expression: universal.Expression, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    for modifier in parameter.modifiers:
        if modifier.name == "mirror":
            return error(callable_diagnostic("mirror requires copy-on-write support", expression.span))
        if modifier.name == "copy":
            match expression.kind:
                case Ownership:
                    if mode == "clone":
                        return callable_expression(state, expression, expected)
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            return callable_expression(state, universal.Expression(universal.Ownership("clone", expression), expression.span), expected)
        if modifier.name in ["move", "borrow", "borrow mut"]:
            match expression.kind:
                case Ownership:
                    if mode != modifier.name:
                        return error(callable_diagnostic("ownership argument does not match parameter mode " + modifier.name, expression.span))
                    return callable_expression(state, expression, expected)
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            wrapped = universal.Expression(universal.Ownership(modifier.name, expression), expression.span)
            return callable_expression(state, wrapped, expected)
    return callable_expression(state, expression, expected)


def callable_parameter_contract(parameter: universal.FunctionParameter, records: list[universal.RecordDeclaration]) -> universal.FunctionParameter:
    # Ownership is a signature contract, independent of the callee's body.
    for modifier in parameter.modifiers:
        if modifier.name in ["borrow", "borrow mut", "copy", "move", "mirror"]:
            return parameter
    for modifier in parameter.modifiers:
        if modifier.name == "implicit receiver":
            return parameter
    if storage_types.indirect_value(parameter.type_id, records) or not storage_types.copy_storage(parameter.type_id, records):
        parameter.modifiers = parameter.modifiers[:]
        parameter.modifiers.append(universal.BoundaryModifier("borrow"))
    return parameter


def callable_contract_signature(state: CallableAnalysis, function: universal.FunctionDeclaration) -> universal.FunctionDeclaration:
    # Kept as a normalization entry point for late generic specializations.
    parameters: list[universal.FunctionParameter] = []
    for parameter in function.parameters:
        implicit := false
        explicit := false
        for modifier in parameter.modifiers:
            implicit = implicit or modifier.name == "implicit receiver"
            explicit = explicit or modifier.name in ["borrow", "borrow mut", "copy", "move", "mirror"]
        if implicit and not explicit:
            effect = parameter_effects.infer(function, 0, state.functions, state.parameter_effects)
            parameter.modifiers = parameter.modifiers[:]
            parameter.modifiers.append(universal.BoundaryModifier("borrow mut" if effect > 0 else "borrow"))
        parameters.append(callable_parameter_contract(parameter, state.records))
    function.parameters = parameters
    return function


def callable_borrowed_result(function: universal.FunctionDeclaration, arguments: list[universal.CallArgument], result: universal.Expression) -> universal.Expression:
    if function.result_origin >= 0:
        origin = function.parameters[function.result_origin].name
        for argument in arguments:
            if argument.name == origin:
                result.loan_root = loans.binding(argument.value)
                result.loan_mode = function.result_mode
    return result


def callable_closure_call(state: CallableAnalysis, closure: closures.Closure, receiver: universal.Expression, arguments: list[universal.CallArgument], span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    parameters: list[universal.FunctionParameter] = []
    operands: list[universal.CallArgument] = []
    for record in state.records:
        if record.type_id.index == closure.type_id.index:
            index := 0
            for field in record.fields:
                parameters.append(field)
                value = universal.Expression(universal.FieldReference(receiver, index), span, type_id=field.type_id)
                operands.append(universal.CallArgument(field.name, value, span))
                index += 1
    inputs: list[universal.FunctionParameter] = []
    for name in closure.parameters:
        inputs.append(universal.FunctionParameter(name, universal.named_type("int", [], span), None, span))
    bound = packs.bind_arguments(universal.FunctionDeclaration(parameters=inputs), arguments)
    if bound.message != "":
        return error(callable_diagnostic(bound.message, span))
    for argument in bound.arguments:
        value = callable_expression(state, argument.value, universal.TypeId(0))
        operands.append(universal.CallArgument(argument.name, value, argument.span))
    for parameter in inputs:
        for argument in operands:
            if argument.name == parameter.name:
                parameter.type_id = argument.value.type_id
                parameter.annotation = universal.named_type(definitions.type_name(parameter.type_id, state.records), [], span)
        parameters.append(parameter)
    local = CallableAnalysis(functions=state.functions, templates=state.templates, records=state.records, declarations=state.declarations, generics=state.generics, namespace=state.namespace, constants=state.constants, source_files=state.source_files, excluded_functions=state.excluded_functions, prelude_sources=state.prelude_sources, function_index=state.function_index, generic_index=state.generic_index, template_index=state.template_index, registered_methods=state.registered_methods, required_functions=state.required_functions, body_cache=state.body_cache)
    for parameter in parameters:
        local.names.append(parameter.name)
        local.types.append(parameter.type_id)
        local.mutables.append(false)
    result = callable_expression(local, closure.body, expected)
    ordinal = len(state.functions) + 1
    function = universal.FunctionDeclaration(name="$lambda$" + string(ordinal), parameters=parameters, parameter_types=local.types, result_type=result.type_id, body=universal.Block([universal.Return(result, span)]), span=span, id=universal.FunctionId(u128(ordinal)), definition=universal.DefId(0, 0, universal.DeclarationId(u128(ordinal))), lookup=state.namespace)
    state.functions.append(function)
    return universal.Expression(universal.ResolvedCall(universal.Direct(lazy_bodies.require(state.required_functions, function.definition), universal.Substitution([])), operands), span, type_id=result.type_id)


def callable_require_unsafe(state: CallableAnalysis, span: source.Span) -> unit | diagnostics.Diagnostic:
    if state.unsafe_depth == 0:
        return error(callable_diagnostic("raw memory operation requires an unsafe scope", span))


def callable_none_literal(expression: universal.Expression) -> bool:
    match expression.kind:
        case LiteralValue:
            match value:
                case NoneValue:
                    return true
                case _:
                    throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        case _:
            throw Error("unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return false


def callable_pointer_element(state: CallableAnalysis, type_id: universal.TypeId) -> universal.TypeId:
    instance ?= definitions.record_instance(state.declarations, type_id)
    if instance != None:
        for template in state.declarations.record_templates:
            if template.name == "pointer" and expansion.same(template.definition, instance.template):
                if len(instance.arguments) == 1:
                    return instance.arguments[0].type_id
    return universal.TypeId(0)


def callable_raw_call(state: CallableAnalysis, name: string, values: list[universal.Expression], span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    arguments: list[universal.CallArgument] = []
    for value in values:
        arguments.append(universal.CallArgument(None, value, span))
    return callable_expression(state, universal.Expression(universal.Call(universal.Expression(universal.Name(name), span), arguments), span), expected)


def callable_pointer_value(state: CallableAnalysis, type_id: universal.TypeId, address: universal.Expression, span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    if expected.index != 0 and expected.index != type_id.index:
        return error(callable_diagnostic("pointer does not match its expected pointee type", span))
    return universal.Expression(universal.RecordValue([universal.CallArgument("__address", address, span)]), span, type_id=type_id)


def callable_pointer_offset(state: CallableAnalysis, base: universal.Expression, index: universal.Expression, element: universal.TypeId, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    width = universal.Expression(universal.TypeLayout(element, false), span, type_id=universal.i64_type_id())
    offset = callable_expression(state, universal.Expression(universal.Binary(universal.operator_syntax(universal.Multiply()), index, width), span), universal.i64_type_id())
    return callable_raw_call(state, "__raw_offset", [base, offset], span, universal.pointer_type_id())


def callable_pointer_index(state: CallableAnalysis, receiver: universal.Expression, index: universal.Expression, element: universal.TypeId, span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    if expected.index != 0 and expected.index != element.index:
        return error(callable_diagnostic("pointer element does not match expected type", span))
    position := callable_expression(state, index, universal.TypeId(0))
    bytes := false
    for record in state.records:
        if record.type_id.index == position.type_id.index and record.name == "byte":
            position = callable_raw_call(state, "__raw_byte_offset", [position], span, universal.i64_type_id())
            bytes = true
    if position.type_id.index != 64:
        return error(callable_diagnostic("pointer index requires an int element offset or a byte offset", span))
    container = universal.Expression(universal.UpdateOperand(0), span, type_id=receiver.type_id)
    offset = universal.Expression(universal.UpdateOperand(1), span, type_id=position.type_id)
    base = universal.Expression(universal.FieldReference(container, 0), span, type_id=universal.pointer_type_id())
    address := base
    if bytes:
        address = callable_raw_call(state, "__raw_offset", [base, offset], span, universal.pointer_type_id())
    else:
        address = callable_pointer_offset(state, base, offset, element, span)
    access = callable_raw_call(state, "__raw_load", [address], span, element)
    value = universal.Expression(universal.UpdateOperand(2), span, type_id=element)
    storage = callable_raw_call(state, "__raw_store", [value, address], span, universal.unit_type_id())
    return universal.Expression(universal.IndexReference(receiver, position, access, storage), span, type_id=element)


def callable_annotation(annotation: universal.TypeAnnotation, records: list[universal.RecordDeclaration] = [], namespace: string = "", declarations: definitions.SemanticDefinitions = definitions.SemanticDefinitions()) -> universal.TypeId | diagnostics.Diagnostic:
    return definitions.type_annotation(declarations, annotation, records, namespace)


def callable_path(expression: universal.Expression) -> string:
    match expression.kind:
        case Name:
            return name
        case Member:
            return callable_path(object) + "." + name
        case _:
            return ""


def callable_type_operand(state: CallableAnalysis, expression: universal.Expression) -> bool | diagnostics.Diagnostic:
    match expression.kind:
        case Binary:
            return operator.symbol == "|" and callable_type_operand(state, left) and callable_type_operand(state, right)
        case SourceSymbol:
            return callable_constructor_type(state, expression).index != 0
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    application = callable_application_target(expression)
    name = callable_path(expression) if application == "" else application
    if name == "":
        return false
    # Value bindings, including an object's fields, shadow type spellings.
    root = name.split(".")[0]
    if root in state.names:
        return false
    for constant in state.constants:
        if constant.name == root or constant.name == state.namespace + root:
            return false
    if callable_implicit_field(state, root, expression.span) != None:
        return false
    if scalar.scalar_type_name(name) != None or definitions.bootstrap_storage_type(state.declarations, name, state.namespace):
        return true
    if definitions.alias_named(state.declarations, name, state.namespace) != None:
        return true
    if definitions.record_template(state.declarations, name, state.namespace) != None:
        return true
    for record in state.records:
        if record.name == name or record.name == state.namespace + name:
            return true
    return false


def callable_hint(state: CallableAnalysis, expression: universal.Expression) -> universal.TypeId | diagnostics.Diagnostic:
    named_tagged_variant = callable_tagged_selection(state, expression)
    if named_tagged_variant.record != -1:
        return state.records[named_tagged_variant.record].type_id
    match expression.kind:
        case Ownership:
            return callable_hint(state, value)
        case AddressOf:
            return callable_expression(state, expression, universal.TypeId(0)).type_id
        case TypeLayout:
            return universal.i64_type_id()
        case ComparisonChain:
            return universal.bool_type_id()
        case Stringify:
            return universal.string_type_id()
        case Name:
            index := 0
            for name_value in state.names:
                if name_value == name:
                    return state.types[index]
                index += 1
            for constant in state.constants:
                if constant.name == state.namespace + name or constant.name == name:
                    return constant.type_id
            field ?= callable_implicit_field(state, name, expression.span)
            if field != None:
                return callable_hint(state, field)
        case Call:
            application_name = callable_application_target(callee)
            selected_name = callable_path(callee) if application_name == "" else application_name
            if callable_excluded(state, selected_name, expression.span):
                return callable_expression(state, expression, universal.TypeId(0)).type_id
            # A type operand must be resolved before ordinary value overload
            # inference, which would try to look up a generic type as a binding.
            if selected_name == "bytes" and len(arguments) == 1 and arguments[0].name == None and callable_type_operand(state, arguments[0].value):
                return callable_expression(state, expression, universal.TypeId(0)).type_id
            match callee.kind:
                case Subscript:
                    if callable_path(object) in ["bytes", "alignment"]:
                        return callable_expression(state, expression, universal.TypeId(0)).type_id
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            variant = callable_tagged_selection(state, callee)
            if variant.record != -1:
                return state.records[variant.record].type_id
            match callee.kind:
                case SourceSymbol:
                    return callable_expression(state, expression, universal.TypeId(0)).type_id
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            name = callable_path(callee)
            for function in state.functions:
                syntax ?= function.operator_syntax
                if syntax != None:
                    if syntax.symbol == name:
                        return callable_expression(state, expression, universal.TypeId(0)).type_id
            if name == "type" or name == "string":
                return universal.string_type_id()
            if name == "len" and len(arguments) == 1:
                pack = callable_field_pack(state, arguments[0].value)
                if pack.found:
                    return universal.i64_type_id()
            target ?= scalar.scalar_type_name(name)
            if target != None:
                if conversions.scalar_numeric(target):
                    return target
            template ?= definitions.record_template(state.declarations, name, state.namespace)
            if template != None:
                return callable_expression(state, expression, universal.TypeId(0)).type_id
            constructed = callable_constructor_type(state, callee)
            if constructed.index != 0:
                return constructed
            for record in state.records:
                if record.name == state.namespace + name or record.name == name:
                    return record.type_id
            type_method = callable_type_method(state, callee)
            type_function ?= type_method.function
            if type_function != None:
                return type_function.result_type
            method_lookup = callable_method(state, callee, len(arguments))
            method ?= method_lookup.function
            if method != None:
                return method.result_type
            function_lookup = callable_select_function(state, name, arguments)
            function ?= function_lookup.selection
            if function != None:
                return function.function.result_type
        case Member:
            owner = callable_hint(state, object)
            if owner.index >= 100000:
                typed = callable_expression(state, expression, universal.TypeId(0))
                return typed.type_id
            for record in state.records:
                if record.type_id.index == owner.index:
                    for field in record.fields:
                        if field.name == name:
                            return field.type_id
        case Unary:
            return callable_hint(state, operand)
        case Slice:
            return callable_hint(state, object)
        case Subscript:
            return callable_expression(state, expression, universal.TypeId(0)).type_id
        case Binary:
            if grammar_scalar.comparison(state.declarations, operator.symbol):
                return universal.bool_type_id()
            left_type = callable_hint(state, left)
            right_type = callable_hint(state, right)
            # An overload can return a different type from either operand,
            # for example Duration / Duration -> float.
            if left_type.index >= 1000 or right_type.index >= 1000:
                return callable_expression(state, expression, universal.TypeId(0)).type_id
            return conversions.scalar_common_numeric(left_type, right_type)
        case LiteralValue:
            match value:
                case FloatValue:
                    return universal.f64_type_id()
                case StringValue:
                    return universal.string_type_id()
                case CharacterValue:
                    return universal.char_type_id()
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
        case Conditional:
            hint = callable_hint(state, then_value)
            if hint.index != 0:
                return hint
            return callable_hint(state, else_value)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return universal.TypeId(0)


class CallableOptionalFunction:
    function: universal.FunctionDeclaration | None = None


class CallableSelection:
    function: universal.FunctionDeclaration
    arguments: list[universal.CallArgument]


class CallableOptionalSelection:
    selection: CallableSelection | None = None


def callable_convert(state: CallableAnalysis, operand: universal.Expression, target: universal.TypeId, mode: string = "") -> universal.Expression | diagnostics.Diagnostic:
    for record in state.records:
        if record.type_id.index == operand.type_id.index and len(universal.union_variants(record)) != 0:
            local = callable_scope(state)
            span = operand.span
            binding = callable_binding(local, universal.Binding("$conversion$" + string(state.next_id[0]), None, operand, false, true, span))
            reference = matches.reference(binding.id, binding.type_id, span)
            values: list[universal.Expression] = []
            index := 0
            target_name = definitions.type_name(target, state.records)
            for variant in universal.union_variants(record):
                projected = universal.Expression(universal.FieldReference(reference, index + 1), span, type_id=variant)
                arguments = [universal.CallArgument(None, projected, span)]
                if mode != "":
                    arguments.append(universal.CallArgument(None, universal.Expression(universal.LiteralValue(universal.StringValue(mode)), span), span))
                invocation = universal.Expression(universal.Call(universal.Expression(universal.Name(target_name), span), arguments), span)
                values.append(callable_expression(local, invocation, target))
                index += 1
            result := values[-1]
            cursor := len(values) - 1
            while cursor > 0:
                cursor -= 1
                result = universal.Expression(universal.Conditional(matches.tag_test(reference, cursor, span), values[cursor], result), span, type_id=target)
            return universal.Expression(universal.BlockValue(universal.Block([universal.BindingStatement(binding)]), result), span, type_id=target)
    required = conversions.scalar_conversion_rank(operand.type_id, target)
    if required < 0:
        return error(callable_diagnostic("explicit conversion requires numeric primitive types", operand.span))
    selected := required
    if mode != "":
        selected = conversions.scalar_conversion_mode(mode)
        if selected < 0:
            return error(callable_diagnostic("unknown numeric conversion mode " + mode, operand.span))
        if selected < required:
            return error(callable_diagnostic(mode + " conversion cannot satisfy the required numeric policy", operand.span))
    if operand.type_id.index == target.index:
        return operand
    source_type ?= scalar.scalar_type(operand.type_id)
    target_type ?= scalar.scalar_type(target)
    if source_type != None:
        if target_type != None:
            name = "numeric.convert$" + source_type.name + "$" + target_type.name
            for function in state.functions:
                if function.name == name:
                    policy = callable_expression(state, universal.Expression(universal.LiteralValue(universal.BooleanValue(selected == 3)), operand.span), universal.bool_type_id())
                    arguments = [universal.CallArgument(None, operand, operand.span), universal.CallArgument(None, policy, operand.span)]
                    id = universal.HirId(u32(state.next_id[0]))
                    state.next_id[0] += 1
                    return universal.Expression(universal.ResolvedCall(universal.Direct(lazy_bodies.require(state.required_functions, function.definition), universal.Substitution([])), arguments), operand.span, id, target)
    return error(callable_diagnostic("missing generated numeric conversion", operand.span))


def callable_operand(state: CallableAnalysis, expression: universal.Expression, target: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    hint = callable_hint(state, expression)
    if hint.index != 0 and hint.index != target.index:
        rank = conversions.scalar_conversion_rank(hint, target)
        mixed = scalar.scalar_representation(target) == "float" and scalar.scalar_representation(hint) != "float"
        if rank >= 0 and (rank <= 1 or mixed):
            return callable_convert(state, callable_expression(state, expression, universal.TypeId(0)), target)
    return callable_expression(state, expression, target)


def callable_select_pack(state: CallableAnalysis, template: universal.FunctionDeclaration, arguments: list[universal.CallArgument]) -> CallableSelection | diagnostics.Diagnostic:
    count := 0
    keyword := false
    for argument in arguments:
        if argument.name != None:
            keyword = true
        else:
            if keyword:
                return error(callable_diagnostic("positional argument follows keyword argument", argument.span))
            count += 1
    parameters = packs.pack_parameters(template, count)
    prototype = universal.FunctionDeclaration(parameters=parameters)
    bound = packs.bind_arguments(prototype, arguments)
    if bound.message != "":
        return error(callable_diagnostic(bound.message, template.span))
    namespace := ""
    lookup ?= template.lookup
    if lookup != None:
        namespace = lookup
    concrete: list[universal.FunctionParameter] = []
    suffix := ""
    symbolic := false
    for parameter in parameters:
        for argument in bound.arguments:
            if argument.name == parameter.name:
                expected := universal.TypeId(0)
                match parameter.annotation.kind:
                    case Named:
                        if name != "V":
                            expected = callable_annotation(parameter.annotation, state.records, namespace, state.declarations)
                    case _:
                        expected = callable_annotation(parameter.annotation, state.records, namespace, state.declarations)
                typed = callable_expression(callable_scope(state), argument.value, expected)
                symbolic = symbolic or callable_symbolic_type(state, typed.type_id)
                known ?= scalar.scalar_type(typed.type_id)
                if known != None or typed.type_id.index >= 1000:
                    suffix += "_" + string(typed.type_id.index)
                    annotation = universal.named_type(definitions.type_name(typed.type_id, state.records), [], parameter.span)
                    concrete.append(universal.FunctionParameter(parameter.name, annotation, None, parameter.span, keyword_only=parameter.keyword_only))
                else:
                    return error(callable_diagnostic("variadic argument has no concrete value type", argument.span))
    instance_name = template.name + "$pack$" + string(count) + suffix
    for function in state.functions:
        if function.name == instance_name:
            return CallableSelection(callable_contract_signature(state, function), bound.arguments)
    if callable_specialization_count(state) >= 512:
        return error(callable_diagnostic("bootstrap specialization limit exceeded", template.span))
    template = lazy_bodies.load(template, state.body_cache)
    instance = universal.FunctionDeclaration(name=instance_name, parameters=concrete, result=template.result, body=packs.pack_body(template, count), span=template.span, lookup=template.lookup, owner_type=template.owner_type, constructor=template.constructor, prelude=template.prelude)
    signature = callable_signature(instance, int(len(state.functions)), state.records, state.declarations)
    signature.pack_specialization = true
    signature.semantic_key = universal.callable_key(instance, template.semantic_key)
    signature.definition = universal.definition_from_key(signature.semantic_key)
    # Contract checking may call a pack with an enclosing generic's symbolic
    # parameter. Its annotation is meaningful only in that generic environment.
    # Concrete callers reselect the pack after substitution; do not enqueue a
    # symbolic body for native lowering in the global declaration environment.
    if not symbolic:
        state.functions.append(signature)
    else:
        signature.definition = template.definition
    return CallableSelection(signature, bound.arguments)


def callable_specialization_count(state: CallableAnalysis) -> int:
    count := 0
    for function in state.functions:
        if function.template != None or function.pack_specialization:
            count += 1
    return count


def callable_select_function(state: CallableAnalysis, name: string, arguments: list[universal.CallArgument], expected: universal.TypeId = universal.TypeId(0), allow_prelude: bool = true) -> CallableOptionalSelection | diagnostics.Diagnostic:
    lookup := state.namespace + name
    local = len(callable_index.named(state.generic_index, state.generics, lookup, allow_prelude)) > 0 or len(callable_index.named(state.template_index, state.templates, lookup, allow_prelude)) > 0 or len(callable_index.named(state.function_index, state.functions, lookup, allow_prelude)) > 0
    if not local:
        lookup = name
        if name == "string" and allow_prelude and len(callable_index.named(state.function_index, state.functions, name, allow_prelude)) == 0:
            lookup = "format.string"
    templates = callable_index.named(state.template_index, state.templates, lookup, allow_prelude)
    generics = callable_index.named(state.generic_index, state.generics, lookup, allow_prelude)
    candidates = callable_index.named(state.function_index, state.functions, lookup, allow_prelude)
    message := "no overload accepts these arguments for " + name
    for function in candidates:
        bound = packs.bind_arguments(function, arguments)
        if bound.message != "":
            message = bound.message
            continue
        if len(candidates) == 1 and len(templates) == 0 and len(generics) == 0:
            return CallableOptionalSelection(CallableSelection(callable_contract_signature(state, function), bound.arguments))
        compatible := true
        for argument in bound.arguments:
            typed = callable_expression(callable_scope(state), argument.value, universal.TypeId(0))
            index := 0
            for parameter in function.parameters:
                if argument.name == parameter.name:
                    if typed.type_id.index != function.parameter_types[index].index:
                        compatible = false
                index += 1
        if compatible:
            return CallableOptionalSelection(CallableSelection(callable_contract_signature(state, function), bound.arguments))
    # Exact fixed signatures take precedence over a generic or variadic
    # fallback. Selecting a fallback must not evaluate an argument twice.
    for template in templates:
        return CallableOptionalSelection(callable_select_pack(state, template, arguments))
    generic = callable_select_generic(state, lookup, arguments, expected, allow_prelude)
    if generic.selection != None or len(candidates) == 0:
        return generic
    return error(callable_diagnostic(message, arguments[0].span if len(arguments) != 0 else None))


def callable_expression(state: CallableAnalysis, expression: universal.Expression, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    loan_start = int(len(state.loans))
    resolved = callable_expression_checked(state, expression, expected)
    match expression.kind:
        case Call:
            state.loans = loans.retained(state.loans, loan_start)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    # Operators and conversions can also resolve to calls. Their automatic
    # argument loans end with that expression, just like a spelled-out call.
    match resolved.kind:
        case ResolvedCall:
            state.loans = loans.retained(state.loans, loan_start)
        case _:
            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    return resolved


def callable_expression_checked(state: CallableAnalysis, expression: universal.Expression, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    for record in state.records:
        if record.type_id.index == expected.index and record.representation == "TaggedAggregate":
            value = callable_expression_inner(state, expression, universal.TypeId(0))
            if value.type_id.index == expected.index:
                return value
            index := 0
            for field in record.fields[1:]:
                if field.type_id.index == value.type_id.index:
                    return universal.Expression(universal.OutcomeValue(value, index), expression.span, type_id=expected)
                index += 1
            return error(callable_diagnostic("value is not a variant of the expected enum", expression.span))
        if record.type_id.index == expected.index and (len(universal.outcome_variants(record)) != 0 or len(universal.union_variants(record)) != 0):
            value = callable_expression_inner(state, expression, universal.TypeId(0))
            if value.type_id.index == expected.index:
                return value
            index := 0
            variants := universal.outcome_variants(record)
            if len(variants) == 0:
                variants = universal.union_variants(record)
            for variant in variants:
                if variant.index == value.type_id.index:
                    return universal.Expression(universal.OutcomeValue(value, index), expression.span, type_id=expected)
                index += 1
            return error(callable_diagnostic("value is not a declared outcome variant", expression.span))
    resolved = callable_expression_inner(state, expression, expected)
    if callable_has_drop(state, resolved.type_id):
        match resolved.kind:
            case BindingReference:
                return resolved
            case FieldReference:
                return resolved
            case Ownership:
                return resolved
            case _:
                allowed ?= state.resource_creation
                if allowed != None:
                    if allowed.source.index == expression.span.source.index and allowed.start == expression.span.start and allowed.end == expression.span.end:
                        return resolved
                return error(callable_diagnostic("resource temporary requires a local binding", expression.span))
    return resolved


def callable_tagged_selection(state: CallableAnalysis, expression: universal.Expression) -> tagged.VariantSelection | diagnostics.Diagnostic:
    path = callable_path(expression)
    if path == "" or path.split(".")[0] in state.names:
        return tagged.VariantSelection()
    for constant in state.constants:
        if constant.name == path or constant.name == state.namespace + path:
            return tagged.VariantSelection()
    return tagged.select(state.records, state.namespace, path, universal.TypeId(0), expression.span)


def callable_tagged_value(state: CallableAnalysis, selection: tagged.VariantSelection, arguments: list[universal.CallArgument], span: source.Span, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    record = state.records[selection.record]
    payload_type = record.fields[selection.variant + 1].type_id
    if expected.index != 0 and expected.index != record.type_id.index and expected.index != payload_type.index:
        return error(callable_diagnostic("tagged alternative does not match expected type", span))
    for payload in state.records:
        if payload.type_id.index == payload_type.index:
            bound = packs.bind_arguments(universal.FunctionDeclaration(parameters=payload.fields), arguments)
            if bound.message != "":
                return error(callable_diagnostic(bound.message, span))
            value = callable_expression(state, universal.Expression(universal.RecordValue(bound.arguments), span, type_id=payload_type), payload_type)
            if expected.index == payload_type.index:
                return value
            return universal.Expression(universal.OutcomeValue(value, selection.variant), span, type_id=record.type_id)
    return error(callable_diagnostic("tagged alternative has no payload layout", span))


def callable_slice_bound(state: CallableAnalysis, bound: universal.Expression | None, fallback: string, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    supplied ?= bound
    if supplied != None:
        return callable_expression(state, supplied, universal.i64_type_id())
    literal = universal.Expression(universal.LiteralValue(universal.IntegerValue(fallback)), span)
    return callable_expression(state, literal, universal.i64_type_id())


def callable_expression_inner(state: CallableAnalysis, expression: universal.Expression, expected: universal.TypeId) -> universal.Expression | diagnostics.Diagnostic:
    path = callable_path(expression)
    if path == "cfg" or path.starts_with("cfg.") or path == "lower":
        return error(callable_diagnostic("compiler context requires a resolved grammar capability", expression.span))
    named_tagged_variant = callable_tagged_selection(state, expression)
    if named_tagged_variant.record != -1:
        return callable_tagged_value(state, named_tagged_variant, [], expression.span, expected)
    result_type := expected
    kind := expression.kind
    match expression.kind:
        case Lambda:
            mentioned: list[string] = []
            closures.names(body, mentioned)
            captures: list[string] = []
            fields: list[universal.FunctionParameter] = []
            values: list[universal.CallArgument] = []
            for name in mentioned:
                if name in state.names and name not in parameters:
                    reference = universal.Expression(universal.Name(name), expression.span)
                    value = callable_expression(state, reference, universal.TypeId(0))
                    if not storage_types.copy_storage(value.type_id, state.records):
                        return error(callable_diagnostic("owned closure captures require a capture ownership contract", expression.span))
                    captures.append(name)
                    annotation = universal.named_type(definitions.type_name(value.type_id, state.records), [], expression.span)
                    fields.append(universal.FunctionParameter(name, annotation, None, expression.span, type_id=value.type_id))
                    values.append(universal.CallArgument(name, value, expression.span))
            type_id = universal.TypeId(u32(1000 + len(state.records)))
            state.records.append(universal.RecordDeclaration("$closure$" + string(type_id.index), fields, [], expression.span, type_id=type_id))
            state.closures.append(closures.Closure(type_id, parameters, body, captures))
            return universal.Expression(universal.RecordValue(values), expression.span, type_id=type_id)
        case Ownership:
            if expression.type_id.index != 0:
                return expression
            if mode == "mirror":
                return error(callable_diagnostic("mirror requires copy-on-write support", expression.span))
            operand = callable_expression(state, value, expected)
            if mode == "clone":
                if callable_has_drop(state, operand.type_id):
                    return error(callable_diagnostic("resource cloning requires an explicit clone implementation", expression.span))
                selected = callable_operator(state, "copy", [operand.type_id], expression.span)
                implementation ?= selected.function
                if implementation != None:
                    return callable_resolved_operator(state, implementation, [operand], expression.span, expected)
                if storage_types.copy_storage(operand.type_id, state.records):
                    if storage_types.indirect_value(operand.type_id, state.records):
                        fields: list[universal.CallArgument] = []
                        receiver = universal.Expression(universal.UpdateOperand(0), expression.span, type_id=operand.type_id)
                        for record in state.records:
                            if record.type_id.index == operand.type_id.index:
                                field_index := 0
                                for field in record.fields:
                                    member = universal.Expression(universal.FieldReference(receiver, field_index), expression.span, type_id=field.type_id)
                                    copied = callable_expression(state, universal.Expression(universal.Ownership("clone", member), expression.span), field.type_id)
                                    fields.append(universal.CallArgument(field.name, copied, expression.span))
                                    field_index += 1
                        copied_record = universal.Expression(universal.RecordValue(fields), expression.span, type_id=operand.type_id)
                        return universal.Expression(universal.Evaluate(operand, copied_record), expression.span, type_id=operand.type_id)
                    return operand
                return error(callable_diagnostic("copy requires a copy implementation", expression.span))
            binding_index = loans.binding(operand)
            if binding_index < 0:
                if mode in ["borrow", "borrow mut", "move"]:
                    return universal.Expression(universal.Ownership(mode, operand), expression.span, type_id=operand.type_id)
                return error(callable_diagnostic("ownership operation requires a local place", expression.span))
            if mode == "move":
                if state.destructor and binding_index == 0:
                    match operand.kind:
                        case BindingReference:
                            return error(callable_diagnostic("a destructor cannot move or resurrect self", expression.span))
                        case _:
                            throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
                loans.access(state.loans, binding_index, true, expression.span)
                if binding_index in state.borrowed_parameters or loans.owner(state.loans, binding_index) != binding_index:
                    return error(callable_diagnostic("cannot move a borrowed value", expression.span))
                if state.loop_depth != 0:
                    return error(callable_diagnostic("move in a loop requires per-iteration ownership", expression.span))
                match operand.kind:
                    case BindingReference:
                        state.dead.append(binding_index)
                    case IndexReference:
                        position = loans.constant_index(index)
                        if position < 0:
                            return error(callable_diagnostic("element move requires a constant nonnegative index", expression.span))
                        state.moved_elements.append((binding_index, position))
                    case FieldReference:
                        if callable_has_drop(state, operand.type_id):
                            callable_field_transfer(state, object, index, expression.span)
                        state.uninitialized.append((binding_index, index))
                    case _:
                        return error(callable_diagnostic("partial moves require field initialization tracking", expression.span))
            else:
                exclusive = mode == "borrow mut"
                loans.access(state.loans, binding_index, exclusive, expression.span)
                if exclusive and binding_index in state.readonly:
                    return error(callable_diagnostic("cannot mutate through a view", expression.span))
                state.loans.append(loans.Loan(loans.owner(state.loans, binding_index), -1, exclusive))
            return universal.Expression(universal.Ownership(mode, operand), expression.span, type_id=operand.type_id)
        case MatchExpression:
            return callable_match_expression(state, subject, arms, expression.span, expected)
        case BlockValue:
            return expression
        case Evaluate:
            return expression
        case ComparisonChain:
            local = callable_scope(state)
            first = callable_binding(local, universal.Binding("$comparison$" + string(state.next_id[0]), None, operands[0], false, true, expression.span))
            reference = universal.Expression(universal.BindingReference(first.id), expression.span, type_id=first.type_id)
            value = callable_comparison_tail(local, operands, operators, 0, reference, expression.span)
            return universal.Expression(universal.BlockValue(universal.Block([universal.BindingStatement(first)]), value), expression.span, type_id=universal.bool_type_id())
        case ThrowValue:
            raised = callable_raised_value(state, value, state.return_type)
            result_type = expected if expected.index != 0 else universal.unit_type_id()
            return universal.Expression(universal.ThrowValue(raised), expression.span, type_id=result_type)
        case UpdateOperand:
            result_type = expression.type_id
        case Fallback:
            receiver = callable_expression(state, value, universal.TypeId(0))
            for record in state.records:
                if record.type_id.index == receiver.type_id.index:
                    index := 0
                    for variant in universal.outcome_variants(record):
                        if int(variant.index) not in [6, 7] and not definitions.error_conformance(state.declarations, state.records, variant):
                            reference = universal.Expression(universal.UpdateOperand(0), expression.span, type_id=receiver.type_id)
                            test = universal.Expression(universal.OutcomeTest(reference, index), expression.span, type_id=universal.bool_type_id())
                            taken = universal.Expression(universal.FieldReference(reference, index + 1), expression.span, type_id=variant)
                            otherwise = callable_expression(state, alternative, variant)
                            body = universal.Expression(universal.Conditional(test, taken, otherwise), expression.span, type_id=variant)
                            if expected.index != 0 and expected.index != variant.index:
                                return error(callable_diagnostic("fallback does not match expected type", expression.span))
                            return universal.Expression(universal.Evaluate(receiver, body), expression.span, type_id=variant)
                        index += 1
            return error(callable_diagnostic("fallback requires an optional or fallible value", expression.span))
        case ListLiteral:
            element_type := universal.TypeId(0)
            if storage_types.buffer_element(expected, state.records).index != 0:
                element_type = storage_types.buffer_element(expected, state.records)
            typed: list[universal.Expression] = []
            for element in elements:
                value = callable_expression(state, element, element_type)
                element_type = value.type_id
                typed.append(value)
            if element_type.index == 0:
                return error(callable_diagnostic("empty collection requires an element type", expression.span))
            count = universal.Expression(universal.UpdateOperand(0), expression.span, type_id=universal.i64_type_id())
            exemplar = universal.Expression(universal.UpdateOperand(1), expression.span, type_id=element_type)
            create = callable_protocol(state, "List", "construction", [count, exemplar], expression.span, expected)
            container = universal.Expression(universal.UpdateOperand(0), expression.span, type_id=create.type_id)
            index = universal.Expression(universal.UpdateOperand(1), expression.span, type_id=universal.i64_type_id())
            element = universal.Expression(universal.UpdateOperand(2), expression.span, type_id=element_type)
            storage = callable_protocol(state, "Index", "storage", [container, index, element], expression.span, universal.unit_type_id())
            return universal.Expression(universal.ListValue(typed, create, storage), expression.span, type_id=create.type_id)
        case Slice:
            receiver = callable_expression(state, object, universal.TypeId(0))
            for record in state.records:
                if record.type_id.index == receiver.type_id.index and callable_pack_record(state, record.type_id) != None:
                    stride = callable_constant_integer(step, 1)
                    if stride == 0:
                        return error(callable_diagnostic("aggregate slice step cannot be zero", expression.span))
                    size = int(len(record.fields))
                    first := size - 1 if stride < 0 else 0
                    last := -1 if stride < 0 else size
                    if start != None:
                        first = slicing.bound(callable_constant_integer(start, first), size, stride < 0)
                    if stop != None:
                        last = slicing.bound(callable_constant_integer(stop, last), size, stride < 0)
                    base = universal.Expression(universal.UpdateOperand(0), expression.span, type_id=receiver.type_id)
                    fields: list[universal.Expression] = []
                    while (first > last if stride < 0 else first < last):
                        fields.append(universal.Expression(universal.FieldReference(base, first), expression.span, type_id=record.fields[first].type_id))
                        first = slicing.next_position(first, last, stride)
                    target = universal.Expression(universal.SourceSymbol(record.name, record.definition), expression.span)
                    arguments: list[universal.CallArgument] = []
                    for field in fields:
                        arguments.append(universal.CallArgument(None, field, field.span))
                    body = callable_expression(state, universal.Expression(universal.Call(target, arguments), expression.span), expected)
                    return universal.Expression(universal.Evaluate(receiver, body), expression.span, type_id=body.type_id)
            operands: list[universal.Expression] = [receiver]
            operands.append(callable_slice_bound(state, start, "0", expression.span))
            operands.append(callable_slice_bound(state, stop, "0", expression.span))
            operands.append(callable_slice_bound(state, step, "1", expression.span))
            for present in [start != None, stop != None]:
                literal = universal.Expression(universal.LiteralValue(universal.BooleanValue(present)), expression.span)
                operands.append(callable_expression(state, literal, universal.bool_type_id()))
            return callable_protocol(state, "Slice", "access", operands, expression.span, expected)
        case Subscript:
            pack = callable_field_pack(state, object)
            if pack.found:
                position := callable_constant_integer(index, 0)
                if position < 0:
                    position += int(len(pack.values))
                if position < 0 or position >= len(pack.values):
                    return error(callable_diagnostic("field pack index is out of bounds", index.span))
                return callable_expression(state, pack.values[position], expected)
            projecting = state.projecting
            state.projecting = true
            receiver = callable_expression(state, object, universal.TypeId(0))
            state.projecting = projecting
            if not state.initializing:
                for moved in state.moved_elements:
                    if moved[0] == loans.binding(receiver):
                        position = loans.constant_index(index)
                        if position < 0 or moved[1] == position:
                            return error(callable_diagnostic("use after move of collection element", expression.span))
            pointee = callable_pointer_element(state, receiver.type_id)
            if pointee.index != 0:
                callable_require_unsafe(state, expression.span)
                return callable_pointer_index(state, receiver, index, pointee, expression.span, expected)
            for record in state.records:
                if record.type_id.index == receiver.type_id.index and callable_pack_record(state, record.type_id) != None:
                    position := callable_constant_integer(index, 0)
                    if position < 0:
                        position += int(len(record.fields))
                    if position < 0 or position >= len(record.fields):
                        return error(callable_diagnostic("aggregate index is out of bounds", index.span))
                    field_type = record.fields[position].type_id
                    if expected.index != 0 and expected.index != field_type.index:
                        return error(callable_diagnostic("aggregate element does not match expected type", expression.span))
                    return universal.Expression(universal.FieldReference(receiver, position), expression.span, type_id=field_type)
            position = callable_expression(state, index, universal.i64_type_id())
            container = universal.Expression(universal.UpdateOperand(0), expression.span, type_id=receiver.type_id)
            offset = universal.Expression(universal.UpdateOperand(1), expression.span, type_id=position.type_id)
            access = callable_protocol(state, "Index", "access", [container, offset], expression.span, expected)
            element = universal.Expression(universal.UpdateOperand(2), expression.span, type_id=access.type_id)
            storage: universal.Expression | None := None
            store_name = callable_protocol_name(state, "Index", "storage", expression.span)
            selected = callable_operator(state, store_name, [receiver.type_id, position.type_id, access.type_id], expression.span)
            function ?= selected.function
            if function != None:
                storage = callable_resolved_operator(state, function, [container, offset, element], expression.span, universal.unit_type_id())
            return universal.Expression(universal.IndexReference(receiver, position, access, storage), expression.span, type_id=access.type_id)
        case AddressOf:
            # The typed form carries a native address; the source form constructs
            # pointer[T] only after checking that its operand denotes storage.
            if expression.type_id.index == 5:
                return expression
            callable_require_unsafe(state, expression.span)
            resolved = callable_expression(state, value, universal.TypeId(0))
            address: universal.Expression | None := None
            match resolved.kind:
                case BindingReference:
                    if not state.mutables[binding.index]:
                        return error(callable_diagnostic("address requires mutable storage", expression.span))
                    if not storage_types.copy_storage(resolved.type_id, state.records):
                        return error(callable_diagnostic("address requires copyable storage; index the buffer for an element address", expression.span))
                    address = universal.Expression(universal.AddressOf(resolved), expression.span, type_id=universal.pointer_type_id())
                case FieldReference:
                    if not storage_types.copy_storage(resolved.type_id, state.records):
                        return error(callable_diagnostic("address requires copyable field storage", expression.span))
                    address = universal.Expression(universal.AddressOf(resolved), expression.span, type_id=universal.pointer_type_id())
                case IndexReference:
                    if storage_types.buffer_element(object.type_id, state.records).index != 0:
                        base = callable_raw_call(state, "__raw_buffer_address", [object], expression.span, universal.index_type_id())
                        integer = callable_raw_call(state, "__raw_index", [base], expression.span, universal.i64_type_id())
                        native = callable_raw_call(state, "__raw_pointer", [integer], expression.span, universal.pointer_type_id())
                        address = callable_pointer_offset(state, native, index, resolved.type_id, expression.span)
                case _:
                    throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            native ?= address
            if native != None:
                annotation = universal.named_type("pointer", [universal.named_type(definitions.type_name(resolved.type_id, state.records), [], expression.span)], expression.span)
                pointer_type = callable_annotation(annotation, state.records, state.namespace, state.declarations)
                return callable_pointer_value(state, pointer_type, native, expression.span, expected)
            return error(callable_diagnostic("address requires a local, field, or buffer element", expression.span))
