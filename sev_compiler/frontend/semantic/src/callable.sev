                # bodies above; they do not execute as module initializers.
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            case Function:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            case Record:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            case Trait:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            case Type:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
            case Test:
                if include_tests:
                    runtime_test := declaration
                    if len(declaration.source_modes) == 1 and declaration.source_modes[0] == "compiler":
                        for compiler_case in declaration.compiler_cases:
                            isolated_definitions = definitions.SemanticDefinitions(state.declarations.aliases[:], state.declarations.traits, state.declarations.implementations, record_templates=state.declarations.record_templates, record_instances=state.declarations.record_instances[:])
                            isolated = CallableAnalysis(functions=state.functions[:], constants=state.constants[:], templates=state.templates[:], namespace=declaration.lookup, records=state.records[:], declarations=isolated_definitions, generics=state.generics, source_files=state.source_files, excluded_functions=state.excluded_functions, prelude_sources=state.prelude_sources)
                            rejected := compiler_case.parse_error != ""
