    module.records = state.records
    measured = semantic_stage(measured, "records")
    callable_register_operators(state, module, 1000000 if len(prepared) > 0 else 0)
    measured = semantic_stage(measured, "operators")
    for item in module.items:
        match item:
            case Function:
                function_declaration := declaration
