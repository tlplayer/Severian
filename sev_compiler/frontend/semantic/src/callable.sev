            case _:
                throw diagnostics.diagnostic("E000200", "unimplemented (sev_compiler/frontend/semantic/src/callable.sev)")
    callable_validate_generics(state, module, existing_generics)
    measured = semantic_stage(measured, "generic contracts")
    for item in module.items:
        match item:
            case BindingItem:
                if binding.name in function_names:
                    return error(callable_diagnostic("binding conflicts with function " + binding.name, binding.span))
                # Provider literals were registered in state.constants above.
                # Materialize them at their uses instead of allocating runtime
                # storage merely because their provider belongs to the prelude.
