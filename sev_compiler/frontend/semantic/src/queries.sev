import modules
import universal
import "package.sev"

enum QueryError:
    UnknownModule(module: universal.ModuleId)
    UnknownName(scope: universal.ScopeId, name: string)
    Ambiguous(definitions: list[universal.DefId])
    NotFunction(definition: universal.DefId)
    MissingBody(definition: universal.DefId)


class SemanticQueries:
    program: TypedProgram

    def collect_declarations(module: universal.ModuleId) -> list[universal.DefId] | QueryError:
        scope = program.index.modules.get(module)
        if scope == None:
            return error(UnknownModule(module))
        return scope.items

    def resolve_name(scope: universal.ScopeId, name: string) -> universal.DefId | QueryError:
        module = program.index.modules.get(scope.module)
        if module == None:
            return error(UnknownModule(scope.module))
        resolution = module.scope.bindings.get(name)
        if resolution == None:
            return error(UnknownName(scope, name))
        match resolution:
            case Def: return definition
            case OverloadSet: return error(Ambiguous(definitions))
            case Ambiguous: return error(Ambiguous(definitions))
            case Module: return error(UnknownName(scope, name))

    def signature_of(definition: universal.DefId) -> universal.FunctionDeclaration | QueryError:
        item = program.index.definitions.get(definition)
        if item == None:
            return error(NotFunction(definition))
        match item.kind:
            case Function: return signature
        return error(NotFunction(definition))

    def type_check(definition: universal.DefId) -> universal.FunctionDeclaration | QueryError:
        for module in program.hir_program.modules:
            for function in module.functions:
                if function.definition == definition:
                    return function
        return error(MissingBody(definition))
