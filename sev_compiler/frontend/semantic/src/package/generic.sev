import universal
import "../package.sev"

class GenericInstance:
    definition: universal.DefId
    substitution: map[string, string]


class MonomorphizationCollector:
    instances: map[universal.DefId, list[GenericInstance]]

    def MonomorphizationCollector():
        instances = {}

    def collect(definition: universal.DefId, substitution: map[string, string]):
        if not instances.contains(definition):
            instances[definition] = []
        candidate = GenericInstance(definition, substitution)
        if not instances[definition].contains(candidate):
            instances[definition].append(candidate)


def substitute_annotation(annotation: universal.TypeAnnotation, substitution: map[string, string]) -> universal.TypeAnnotation:
    match annotation.kind:
        case Named:
            replacement = substitution.get(name)
            if replacement != None and len(arguments) == 0:
                return universal.named_type(replacement, [], annotation.span)
            replaced: list[universal.TypeAnnotation] = []
            for argument in arguments:
                replaced.append(substitute_annotation(argument, substitution))
            return universal.named_type(name, replaced, annotation.span)
        case Union:
            replaced: list[universal.TypeAnnotation] = []
            for member in members:
                replaced.append(substitute_annotation(member, substitution))
            return universal.TypeAnnotation(universal.Union(replaced), annotation.span)


def specialize_signature(signature: universal.FunctionDeclaration, substitution: map[string, string]) -> universal.FunctionDeclaration:
    parameters: list[universal.FunctionParameter] = []
    for parameter in signature.parameters:
        parameters.append(universal.FunctionParameter(parameter.name, substitute_annotation(parameter.annotation, substitution), parameter.default, parameter.span))
    return universal.FunctionDeclaration(parameters = parameters, result = substitute_annotation(signature.result, substitution), constraints = signature.constraints)
