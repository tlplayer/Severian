import * from "../../../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import * from "../../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import * from "../package.sev"

class GenericInstance:
    definition: model_syntax_symbol_symbol.DefId
    substitution: map[string, string]


class MonomorphizationCollector:
    instances: map[model_syntax_symbol_symbol.DefId, list[GenericInstance]]

    def MonomorphizationCollector():
        instances = {}

    def collect(definition: model_syntax_symbol_symbol.DefId, substitution: map[string, string]):
        if not instances.contains(definition):
            instances[definition] = []
        candidate = GenericInstance(definition, substitution)
        if not instances[definition].contains(candidate):
            instances[definition].append(candidate)


def substitute_annotation(annotation: model_syntax_type_annotation.TypeAnnotation, substitution: map[string, string]) -> model_syntax_type_annotation.TypeAnnotation:
    match annotation.kind:
        case Named:
            replacement = substitution.get(name)
            if replacement != None and len(arguments) == 0:
                return model_syntax_type_annotation.named_type(replacement, [], annotation.span)
            replaced: list[model_syntax_type_annotation.TypeAnnotation] = []
            for argument in arguments:
                replaced.append(substitute_annotation(argument, substitution))
            return model_syntax_type_annotation.named_type(name, replaced, annotation.span)
        case Union:
            replaced: list[model_syntax_type_annotation.TypeAnnotation] = []
            for member in members:
                replaced.append(substitute_annotation(member, substitution))
            return model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Union(replaced), annotation.span)


def specialize_signature(signature: model_syntax_function_function.FunctionDeclaration, substitution: map[string, string]) -> model_syntax_function_function.FunctionDeclaration:
    parameters: list[model_syntax_function_function.FunctionParameter] = []
    for parameter in signature.parameters:
        parameters.append(model_syntax_function_function.FunctionParameter(parameter.name, substitute_annotation(parameter.annotation, substitution), parameter.default, parameter.span))
    return model_syntax_function_function.FunctionDeclaration(parameters = parameters, result = substitute_annotation(signature.result, substitution), constraints = signature.constraints)
