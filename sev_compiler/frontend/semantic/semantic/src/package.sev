import * from "../../../../hir/module/module.sev" as model_hir_module_module
import * from "../../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol

enum Visibility:
    Public


enum DefKind:
    Function(signature: model_syntax_function_function.FunctionDeclaration)
    Type
    Trait
    Constant
    Import


class Definition:
    id: model_syntax_symbol_symbol.DefId
    name: string
    module: model_syntax_symbol_symbol.ModuleId
    visibility: Visibility
    kind: DefKind


enum Resolution:
    Def(definition: model_syntax_symbol_symbol.DefId)
    Module(module: model_syntax_symbol_symbol.ModuleId)
    OverloadSet(definitions: list[model_syntax_symbol_symbol.DefId])
    Ambiguous(definitions: list[model_syntax_symbol_symbol.DefId])


class Scope:
    bindings: map[string, Resolution]


class ModuleScope:
    id: model_syntax_symbol_symbol.ModuleId
    package: model_syntax_symbol_symbol.PackageId
    items: list[model_syntax_symbol_symbol.DefId]
    scope: Scope


class ProgramIndex:
    packages: map[model_syntax_symbol_symbol.PackageId, list[model_syntax_symbol_symbol.ModuleId]]
    modules: map[model_syntax_symbol_symbol.ModuleId, ModuleScope]
    definitions: map[model_syntax_symbol_symbol.DefId, Definition]
    exports: map[model_syntax_symbol_symbol.ModuleId, map[string, Resolution]]


class TypedProgram:
    index: ProgramIndex
    hir_program: model_hir_module_module.Program

def definition_id(package: model_syntax_symbol_symbol.PackageId, module: model_syntax_symbol_symbol.ModuleId, name: string, ordinal: int) -> model_syntax_symbol_symbol.DefId:
    declaration: u128 = module.value ^ u128(ordinal + 1)
    for character in name.characters():
        declaration = declaration * 1099511628211 ^ u128(int(character))
    return model_syntax_symbol_symbol.DefId(u128(package.index), module.value, model_syntax_symbol_symbol.DeclarationId(declaration))


def insert_resolution(bindings: map[string, Resolution], name: string, new_definition: model_syntax_symbol_symbol.DefId):
    existing = bindings.get(name)
    if existing == None:
        bindings[name] = Def(new_definition)
        return
    match existing:
        case Def:
            bindings[name] = OverloadSet([definition, new_definition])
        case OverloadSet:
            definitions.append(new_definition)
            bindings[name] = OverloadSet(definitions)
        case Ambiguous:
            definitions.append(new_definition)
            bindings[name] = Ambiguous(definitions)
        case Module:
            bindings[name] = Ambiguous([new_definition])


def collect_declarations(graph: model_hir_module_module.ModuleGraph) -> ProgramIndex:
    index = ProgramIndex({}, {}, {}, {})
    for module in graph.modules:
        items: list[model_syntax_symbol_symbol.DefId] = []
        scope = Scope({})
        exports: map[string, Resolution] = {}
        ordinal = 0
        for item in module.items:
            name: string | None = None
            kind: DefKind | None = None
            match item:
                case Function:
                    name = declaration.name
                    kind = DefKind.Function(declaration)
                case Type:
                    name = declaration.name
                    kind = DefKind.Type
                case Trait:
                    name = declaration.name
                    kind = DefKind.Trait
                case BindingItem:
                    name = binding.name
                    kind = DefKind.Constant
            if name != None:
                id = definition_id(module.package, module.id, name, ordinal)
                ordinal += 1
                definition = Definition(id, name, module.id, Public, kind)
                index.definitions[id] = definition
                items.append(id)
                insert_resolution(scope.bindings, name, id)
                insert_resolution(exports, name, id)
        index.modules[module.id] = ModuleScope(module.id, module.package, items, scope)
        index.exports[module.id] = exports
        if not index.packages.contains(module.package):
            index.packages[module.package] = []
        index.packages[module.package].append(module.id)
    return index


def resolve_imports(graph: model_hir_module_module.ModuleGraph, index: ProgramIndex):
    for module in graph.modules:
        scope = index.modules[module.id].scope
        for item in module.items:
            match item:
                case Import:
                    if declaration.resolved_module == None:
                        continue
                    imported = declaration.resolved_module
                    match declaration.subject:
                        case Name:
                            alias = declaration.alias if declaration.alias != None else name
                            scope.bindings[alias] = Module(imported)
                        case Locator:
                            alias = declaration.alias if declaration.alias != None else locator
                            scope.bindings[alias] = Module(imported)
                    if declaration.source_name != None:
                        exported = index.exports[imported].get(name)
                        if exported != None:
                            scope.bindings[declaration.alias if declaration.alias != None else name] = exported


def analyze_package(graph: model_hir_module_module.ModuleGraph) -> TypedProgram:
    index = collect_declarations(graph)
    resolve_imports(graph, index)
    return TypedProgram(index, model_hir_module_module.empty_program())
