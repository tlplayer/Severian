import "../../../../syntax/block/block.sev" as model_syntax_block_block
import "../../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../../syntax/sentence/sentence.sev" as model_syntax_sentence_sentence


class BoundArguments:
    arguments: list[model_syntax_function_function.CallArgument] = []
    message: string = ""


def bind_arguments(function: model_syntax_function_function.FunctionDeclaration, arguments: list[model_syntax_function_function.CallArgument]) -> BoundArguments:
    result: list[model_syntax_function_function.CallArgument] = []
    assigned: list[string] = []
    positional := 0
    keyword := false
    for argument in arguments:
        name := ""
        supplied ?= argument.name
        if supplied != None:
            keyword = true
            name = supplied
        else:
            if keyword:
                return BoundArguments(message="positional argument follows keyword argument")
            if positional >= len(function.parameters):
                return BoundArguments(message="wrong argument count")
            parameter = function.parameters[positional]
            if parameter.keyword_only:
                return BoundArguments(message="parameter is keyword-only: " + parameter.name)
            name = parameter.name
            positional += 1
        found := false
        for parameter in function.parameters:
            if parameter.name == name:
                found = true
        if not found:
            return BoundArguments(message="unknown keyword argument " + name)
        if name in assigned:
            return BoundArguments(message="duplicate argument " + name)
        assigned.append(name)
        result.append(model_syntax_function_function.CallArgument(name, argument.value, argument.span, spread=argument.spread))
    for parameter in function.parameters:
        if parameter.name not in assigned:
            default_value ?= parameter.default
            if default_value != None:
                result.append(model_syntax_function_function.CallArgument(parameter.name, default_value, parameter.span))
            else:
                return BoundArguments(message="wrong argument count: missing " + parameter.name)
    return BoundArguments(result)


def renamed(name: string, names: list[string], replacements: list[string]) -> string:
    index := int(len(names)) - 1
    while index >= 0:
        if names[index] == name:
            return replacements[index]
        index -= 1
    return name


def rename_optional_expression(expression: model_syntax_function_function.Expression | None, names: list[string], replacements: list[string]) -> model_syntax_function_function.Expression | None:
    supplied ?= expression
    if supplied != None:
        return rename_expression(supplied, names, replacements)
    return None


def rename_expression(expression: model_syntax_function_function.Expression, names: list[string], replacements: list[string]) -> model_syntax_function_function.Expression:
    kind := expression.kind
    match expression.kind:
        case MockValue:
            renamed_calls: list[model_syntax_function_function.Expression] = []
            renamed_results: list[model_syntax_function_function.Expression] = []
            for call in calls:
                renamed_calls.append(rename_expression(call, names, replacements))
            for result in results:
                renamed_results.append(rename_expression(result, names, replacements))
            kind = model_syntax_function_function.MockValue(renamed_calls, renamed_results, rename_expression(fallback, names, replacements))
        case Ownership:
            kind = model_syntax_function_function.Ownership(mode, rename_expression(value, names, replacements))
        case AddressOf:
            kind = model_syntax_function_function.AddressOf(rename_expression(value, names, replacements))
        case Name:
            kind = model_syntax_function_function.Name(renamed(name, names, replacements))
        case Member:
            kind = model_syntax_function_function.Member(rename_expression(object, names, replacements), name)
        case Fallback:
            kind = model_syntax_function_function.Fallback(rename_expression(value, names, replacements), rename_expression(alternative, names, replacements))
        case ThrowValue:
            kind = model_syntax_function_function.ThrowValue(rename_expression(value, names, replacements))
        case ComparisonChain:
            values: list[model_syntax_function_function.Expression] = []
            for operand in operands:
                values.append(rename_expression(operand, names, replacements))
            kind = model_syntax_function_function.ComparisonChain(values, operators)
        case ListLiteral:
            renamed_elements: list[model_syntax_function_function.Expression] = []
            for element in elements:
                renamed_elements.append(rename_expression(element, names, replacements))
            kind = model_syntax_function_function.ListLiteral(renamed_elements)
        case Subscript:
            kind = model_syntax_function_function.Subscript(rename_expression(object, names, replacements), rename_expression(index, names, replacements))
        case Slice:
            kind = model_syntax_function_function.ExpressionKind.Slice(rename_expression(object, names, replacements), rename_optional_expression(start, names, replacements), rename_optional_expression(stop, names, replacements), rename_optional_expression(step, names, replacements))
        case RecordValue:
            renamed_fields: list[model_syntax_function_function.CallArgument] = []
            for field in fields:
                renamed_fields.append(model_syntax_function_function.CallArgument(field.name, rename_expression(field.value, names, replacements), field.span))
            kind = model_syntax_function_function.RecordValue(renamed_fields)
        case Call:
            operands: list[model_syntax_function_function.CallArgument] = []
            for argument in arguments:
                operands.append(model_syntax_function_function.CallArgument(argument.name, rename_expression(argument.value, names, replacements), argument.span, spread=argument.spread))
            kind = model_syntax_function_function.Call(rename_expression(callee, names, replacements), operands)
        case Unary:
            kind = model_syntax_function_function.Unary(operator, rename_expression(operand, names, replacements))
        case Binary:
            kind = model_syntax_function_function.Binary(operator, rename_expression(left, names, replacements), rename_expression(right, names, replacements))
        case Conditional:
            kind = model_syntax_function_function.ExpressionKind.Conditional(rename_expression(condition, names, replacements), rename_expression(then_value, names, replacements), rename_expression(else_value, names, replacements))
        case Stringify:
            kind = model_syntax_function_function.Stringify(rename_expression(value, names, replacements))
        case _:
            throw Error("unimplemented (sev_compiler/frontend/semantic/semantic/src/packs.sev)")
    return model_syntax_function_function.Expression(kind, expression.span, type_id=expression.type_id, grammar=expression.grammar)


def expand_block(block: model_syntax_block_block.Block, pack: string, count: int, names: list[string], replacements: list[string], prefix: string) -> model_syntax_block_block.Block:
    result = model_syntax_block_block.Block()
    for statement in block.statements:
        match statement:
            case ForEach:
                match iterable.kind:
                    case Name:
                        if name != pack:
                            throw Error("bootstrap iteration requires the variadic pack")
                    case _:
                        throw Error("bootstrap iteration requires the variadic pack")
                # The iteration binding and its locals get distinct names for
                # each instantiation. Outer mutable bindings retain their names.
                match statement:
                    case ForEach:
                        index := 0
                        while index < count:
                            loop_names = names[:]
                            loop_replacements = replacements[:]
                            loop_names.append(name)
                            loop_replacements.append(pack + "__" + string(index))
                            expanded = expand_block(body, pack, count, loop_names, loop_replacements, prefix + "__iteration_" + string(index) + "_")
                            for expanded_statement in expanded.statements:
                                result.statements.append(expanded_statement)
                            index += 1
                    case _:
                        throw Error("unimplemented (sev_compiler/frontend/semantic/semantic/src/packs.sev)")
            case BindingStatement:
                value = rename_expression(binding.value, names, replacements)
                if binding.name not in names:
                    names.append(binding.name)
                    replacements.append(prefix + binding.name)
                result.statements.append(model_syntax_sentence_sentence.BindingStatement(model_syntax_sentence_sentence.Binding(renamed(binding.name, names, replacements), binding.annotation, value, binding.update, binding.preserve_error, binding.span, mutable=binding.mutable)))
            case FieldSet:
                result.statements.append(model_syntax_sentence_sentence.FieldSet(rename_expression(target, names, replacements), rename_expression(value, names, replacements), span, update))
            case ExpressionStatement:
                result.statements.append(model_syntax_sentence_sentence.ExpressionStatement(rename_expression(expression, names, replacements)))
            case Return:
                returned: model_syntax_function_function.Expression | None := None
                expression_value ?= value
                if expression_value != None:
                    returned = rename_expression(expression_value, names, replacements)
                result.statements.append(model_syntax_sentence_sentence.Statement.Return(returned, span))
            case Assert:
                result.statements.append(model_syntax_sentence_sentence.Assert(rename_expression(condition, names, replacements), message, span, condition_span))
            case If:
                taken = expand_block(then_block, pack, count, names[:], replacements[:], prefix)
                otherwise = expand_block(else_block, pack, count, names[:], replacements[:], prefix)
                result.statements.append(model_syntax_sentence_sentence.Statement.If(rename_expression(condition, names, replacements), taken, otherwise, span))
            case Unsafe:
                result.statements.append(model_syntax_sentence_sentence.Unsafe(expand_block(body, pack, count, names[:], replacements[:], prefix), span))
            case Defer:
                result.statements.append(model_syntax_sentence_sentence.Defer(rename_expression(value, names, replacements), span))
            case _:
                throw Error("statement is outside bootstrap variadic specialization")
    return result


def pack_parameters(function: model_syntax_function_function.FunctionDeclaration, count: int) -> list[model_syntax_function_function.FunctionParameter]:
    result: list[model_syntax_function_function.FunctionParameter] = []
    pack = function.parameters[0]
    index := 0
    while index < count:
        result.append(model_syntax_function_function.FunctionParameter(pack.name + "__" + string(index), pack.annotation, None, pack.span))
        index += 1
    for parameter in function.parameters[1:]:
        result.append(parameter)
    return result


def pack_body(function: model_syntax_function_function.FunctionDeclaration, count: int) -> model_syntax_block_block.Block:
    names: list[string] = []
    for parameter in function.parameters:
        if not parameter.variadic:
            names.append(parameter.name)
    body ?= function.body
    if body != None:
        return expand_block(body, function.parameters[0].name, count, names, names[:], "")
    throw Error("variadic function requires a source body")
