import * from "../../../../hir/module/module.sev" as model_hir_module_module
import * from "../../../../syntax/block/block.sev" as model_syntax_block_block
import * from "../../../../syntax/constraint/model.sev" as model_syntax_constraint_model
import * from "../../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import * from "../../../../syntax/literal/value.sev" as model_syntax_literal_value
import * from "../../../../syntax/sentence/sentence.sev" as model_syntax_sentence_sentence
import * from "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import * from "../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import diagnostics
import source


def has_dispatch(function: model_syntax_function_function.FunctionDeclaration) -> bool:
    for attachment in function.attachments:
        if attachment.role == model_syntax_constraint_model.AttachmentRole.Dispatch:
            return true
    return false


def predicate_key(expression: model_syntax_function_function.Expression) -> string | diagnostics.Diagnostic:
    match expression.kind:
        case Name:
            return model_syntax_symbol_symbol.semantic_key(["name", name])
        case LiteralValue:
            match value:
                case BooleanValue:
                    return "true" if value else "false"
                case IntegerValue:
                    return model_syntax_symbol_symbol.semantic_key(["integer", spelling])
                case _:
                    return error(
                        diagnostics.diagnostic_at(
                            "E000219",
                            "dispatch predicate requires boolean or integer literals",
                            expression.span,
                        ),
                    )
        case Binary:
            if operator.symbol not in ["==", "!=", "<", "<=", ">", ">=", "and", "or"]:
                return error(
                    diagnostics.diagnostic_at(
                        "E000219",
                        "dispatch predicate operation is not proven total and effect-free",
                        expression.span,
                    ),
                )
            return model_syntax_symbol_symbol.semantic_key(
                [operator.symbol, predicate_key(left), predicate_key(right)],
            )
        case Unary:
            if operator.symbol != "not":
                return error(
                    diagnostics.diagnostic_at(
                        "E000219",
                        "dispatch unary operation is not proven total",
                        expression.span,
                    ),
                )
            return model_syntax_symbol_symbol.semantic_key(["not", predicate_key(operand)])
        case ComparisonChain:
            parts: list[string] = []
            for operand in operands:
                parts.append(predicate_key(operand))
            for operator in operators:
                if operator.symbol not in ["==", "!=", "<", "<=", ">", ">="]:
                    return error(
                        diagnostics.diagnostic_at(
                            "E000219",
                            "unsupported dispatch comparison",
                            expression.span,
                        ),
                    )
                parts.append(operator.symbol)
            return model_syntax_symbol_symbol.semantic_key(parts)
        case _:
            return error(
                diagnostics.diagnostic_at(
                    "E000219",
                    "dispatch predicate needs an effect and termination proof",
                    expression.span,
                ),
            )


def literal_integer(value: string, span: source.Span) -> model_syntax_function_function.Expression:
    return model_syntax_function_function.Expression(
        model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.IntegerValue(value)),
        span,
    )


def stable_predicate_inputs(expression: model_syntax_function_function.Expression, parameters: list[model_syntax_function_function.FunctionParameter]) -> unit | diagnostics.Diagnostic:
    match expression.kind:
        case Name:
            for parameter in parameters:
                if parameter.name == name:
                    return
            return error(diagnostics.diagnostic_at("E000219", "shared dispatch predicates may read only their scalar parameters", expression.span))
        case Binary:
            stable_predicate_inputs(left, parameters)
            stable_predicate_inputs(right, parameters)
        case Unary:
            stable_predicate_inputs(operand, parameters)
        case ComparisonChain:
            for operand in operands:
                stable_predicate_inputs(operand, parameters)
        case LiteralValue:
            return
        case _:
            return error(diagnostics.diagnostic_at("E000219", "dispatch predicate needs stable scalar inputs", expression.span))


def named(name: string, span: source.Span) -> model_syntax_function_function.Expression:
    return model_syntax_function_function.Expression(model_syntax_function_function.Name(name), span)


def binary(symbol: string, left: model_syntax_function_function.Expression, right: model_syntax_function_function.Expression, span: source.Span) -> model_syntax_function_function.Expression:
    return model_syntax_function_function.Expression(
        model_syntax_function_function.Binary(
            model_syntax_function_syntax.OperatorSyntax(
                symbol,
                model_syntax_function_syntax.Fixity.Infix,
                30,
                model_syntax_function_syntax.Associativity.Left,
            ),
            left,
            right,
        ),
        span,
    )


def guard(function: model_syntax_function_function.FunctionDeclaration, span: source.Span) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    condition := model_syntax_function_function.Expression(
        model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)),
        span,
    )
    for attachment in function.attachments:
        if attachment.role == model_syntax_constraint_model.AttachmentRole.Dispatch:
            predicate_key(attachment.condition)
            stable_predicate_inputs(attachment.condition, function.parameters)
            condition = binary("and", condition, attachment.condition, span)
    return condition


# Each prefix is a reusable node. Its parent must pass before its next predicate
# runs; two candidates sharing a prefix therefore evaluate it only once.
def shared_guard(function: model_syntax_function_function.FunctionDeclaration, span: source.Span, statements: list[model_syntax_sentence_sentence.Statement], keys: list[string], names: list[string]) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    prefix := model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), span)
    identity := "true"
    for attachment in function.attachments:
        if attachment.role == model_syntax_constraint_model.AttachmentRole.Dispatch:
            identity = model_syntax_symbol_symbol.semantic_key([identity, predicate_key(attachment.condition)])
            selected := -1
            cursor := 0
            for key in keys:
                if key == identity:
                    selected = cursor
                    break
                cursor += 1
            if selected < 0:
                selected = int(len(keys))
                name = "$dispatch$prefix$" + string(selected)
                # Conditional makes the prerequisite explicit even when a
                # user-defined boolean operator does not short-circuit.
                condition = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Conditional(prefix, attachment.condition, model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(false)), span)), span)
                statements.append(model_syntax_sentence_sentence.BindingStatement(model_syntax_sentence_sentence.Binding(name, None, condition, false, false, span)))
                keys.append(identity)
                names.append(name)
            prefix = named(names[selected], span)
    return prefix


# Produce ordinary source-level control flow before callable registration. The
# selected body is invoked only after every candidate's guard has been checked.
# Arguments are wrapper parameters, so neither guards nor selection repeat them.
def expand_dispatch(module: model_hir_module_module.Module, receiver: bool = false) -> model_hir_module_module.Module | diagnostics.Diagnostic:
    # Expand method families before registration adds the nominal receiver.
    # Each record is a separate type-dispatch domain; predicates only distinguish
    # implementations within that domain and an identical callable signature.
    for item in module.items:
        match item:
            case Record:
                methods: list[model_hir_module_module.Item] = []
                for method in declaration.methods:
                    methods.append(model_hir_module_module.Function(method))
                expanded = expand_dispatch(model_hir_module_module.Module(methods), true)
                replacements: list[model_syntax_function_function.FunctionDeclaration] = []
                for method in expanded.items:
                    match method:
                        case Function:
                            replacements.append(declaration)
                        case _:
                            continue
                # Avoid variant payload shadowing the enclosing declaration.
                match item:
                    case Record:
                        declaration.methods = replacements
                    case _:
                        continue
            case _:
                continue
    guarded_keys: list[string] = []
    for item in module.items:
        match item:
            case Function:
                if has_dispatch(declaration):
                    guarded_keys.append(
                        model_syntax_symbol_symbol.callable_key(declaration, declaration.name),
                    )
            case _:
                continue
    if len(guarded_keys) == 0:
        return module
    groups: list[string] = []
    output: list[model_hir_module_module.Item] = []
    for item in module.items:
        match item:
            case Function:
                key = model_syntax_symbol_symbol.callable_key(declaration, declaration.name)
                guarded = key in guarded_keys
                if not guarded:
                    output.append(item)
                    continue
                if key in groups:
                    continue
                groups.append(key)
                family: list[model_syntax_function_function.FunctionDeclaration] = []
                for candidate_item in module.items:
                    match candidate_item:
                        case Function:
                            if model_syntax_symbol_symbol.callable_key(
                                declaration,
                                declaration.name,
                            ) == key:
                                family.append(declaration)
                        case _:
                            continue
                first = family[0]
                family_name = first.name
                family_identity = first.semantic_key
                origin ?= first.span
                if origin == None:
                    return error(
                        diagnostics.diagnostic(
                            "E000219",
                            "dispatch family requires source provenance",
                        ),
                    )
                if origin != None:
                    if len(
                        first.type_parameters,
                    ) != 0 or len(first.constraints) != 0 or first.body == None:
                        return error(
                            diagnostics.diagnostic_at(
                                "E000219",
                                "runtime dispatch requires concrete source signatures",
                                origin,
                            ),
                        )
                    for parameter in first.parameters:
                        name ?= model_syntax_type_annotation.simple_type_name(parameter.annotation)
                        if name == None:
                            return error(
                                diagnostics.diagnostic_at(
                                    "E000219",
                                    "dispatch parameter needs a proven scalar predicate domain",
                                    parameter.span,
                                ),
                            )
                        if name != None:
                            if name not in ["bool", "int", "i8", "i16", "i32", "i64", "i128", "u8", "u16", "u32", "u64", "u128"]:
                                return error(
                                    diagnostics.diagnostic_at(
                                        "E000219",
                                        "dispatch parameter needs a proven scalar predicate domain",
                                        parameter.span,
                                    ),
                                )
                        if parameter.variadic or len(parameter.modifiers) != 0:
                            return error(
                                diagnostics.diagnostic_at(
                                    "E000219",
                                    "dispatch requires fixed scalar value parameters",
                                    parameter.span,
                                ),
                            )
                    statements: list[model_syntax_sentence_sentence.Statement] = []
                    statements.append(
                        model_syntax_sentence_sentence.BindingStatement(
                            model_syntax_sentence_sentence.Binding(
                                "$dispatch$count",
                                None,
                                literal_integer("0", origin),
                                false,
                                false,
                                origin,
                                mutable=true,
                            ),
                        ),
                    )
                    calls: list[model_syntax_function_function.Expression] = []
                    guards: list[string] = []
                    predicate_keys: list[string] = []
                    candidate_names: list[string] = []
                    candidate_predicates: list[model_syntax_function_function.Expression] = []
                    prefix_keys: list[string] = []
                    prefix_names: list[string] = []
                    index := 0
                    for candidate in family:
                        if candidate.body == None or len(candidate.type_parameters) != 0 or len(candidate.constraints) != 0:
                            return error(diagnostics.diagnostic_at("E000219", "runtime dispatch requires concrete source implementations", origin))
                        if len(
                            candidate.parameters,
                        ) != len(
                            first.parameters,
                        ) or candidate.result_mode != first.result_mode:
                            return error(
                                diagnostics.diagnostic_at(
                                    "E000219",
                                    "dispatch candidates have incompatible contracts",
                                    origin,
                                ),
                            )
                        result ?= candidate.result
                        first_result ?= first.result
                        if (result == None) != (first_result == None):
                            return error(diagnostics.diagnostic_at("E000219", "dispatch candidates must have the same result", origin))
                        if result != None:
                            if first_result != None:
                                if model_syntax_symbol_symbol.annotation_key(
                                    result,
                                ) != model_syntax_symbol_symbol.annotation_key(first_result):
                                    return error(
                                        diagnostics.diagnostic_at(
                                            "E000219",
                                            "dispatch candidates must have the same result",
                                            origin,
                                        ),
                                    )
                        arguments: list[model_syntax_function_function.CallArgument] = []
                        cursor := 0
                        for parameter in candidate.parameters:
                            if parameter.name != first.parameters[cursor].name:
                                return error(
                                    diagnostics.diagnostic_at(
                                        "E000219",
                                        "dispatch candidates must agree on parameter names",
                                        parameter.span,
                                    ),
                                )
                            arguments.append(
                                model_syntax_function_function.CallArgument(
                                    None,
                                    named(parameter.name, origin),
                                    origin,
                                ),
                            )
                            cursor += 1
                        condition = guard(candidate, origin)
                        candidate_predicates.append(condition)
                        predicate_identity = predicate_key(condition)
                        if predicate_identity in predicate_keys:
                            return error(
                                diagnostics.diagnostic_at(
                                    "E000219",
                                    "duplicate dispatch predicate",
                                    origin,
                                ),
                            )
                        predicate_keys.append(predicate_identity)
                        condition = shared_guard(candidate, origin, statements, prefix_keys, prefix_names)
                        flag = "$dispatch$guard$" + string(index)
                        guards.append(flag)
                        statements.append(
                            model_syntax_sentence_sentence.BindingStatement(
                                model_syntax_sentence_sentence.Binding(
                                    flag,
                                    None,
                                    condition,
                                    false,
                                    false,
                                    origin,
                                ),
                            ),
                        )
                        increment = model_syntax_sentence_sentence.BindingStatement(
                            model_syntax_sentence_sentence.Binding(
                                "$dispatch$count",
                                None,
                                binary(
                                    "+",
                                    named("$dispatch$count", origin),
                                    literal_integer("1", origin),
                                    origin,
                                ),
                                true,
                                false,
                                origin,
                            ),
                        )
                        statements.append(
                            model_syntax_sentence_sentence.Statement.If(
                                named(flag, origin),
                                model_syntax_block_block.Block([increment]),
                                model_syntax_block_block.empty_block(),
                                origin,
                            ),
                        )
                        candidate.name = family_name + "$dispatch$" + string(
                            index,
                        )
                        candidate.semantic_key = model_syntax_symbol_symbol.semantic_key(
                            [candidate.semantic_key, "dispatch", predicate_identity],
                        )
                        candidate.definition = model_syntax_symbol_symbol.definition_from_key(
                            candidate.semantic_key,
                        )
                        contracts: list[model_syntax_constraint_model.WithAttachment] = []
                        for attachment in candidate.attachments:
                            if attachment.role != model_syntax_constraint_model.AttachmentRole.Dispatch:
                                contracts.append(attachment)
                        candidate.attachments = contracts
                        candidate_names.append(candidate.name)
                        output.append(model_hir_module_module.Function(candidate))
                        target := named(candidate.name, origin)
                        if receiver:
                            target = model_syntax_function_function.Expression(model_syntax_function_function.Member(named("self", origin), candidate.name), origin)
                        calls.append(
                            model_syntax_function_function.Expression(
                                model_syntax_function_function.Call(
                                    target,
                                    arguments,
                                ),
                                origin,
                            ),
                        )
                        index += 1
                    message = model_syntax_function_function.Expression(
                        model_syntax_function_function.ExpressionKind.LiteralValue(
                            model_syntax_literal_value.StringValue(
                                "dispatch requires exactly one matching implementation",
                            ),
                        ),
                        origin,
                    )
                    statements.append(
                        model_syntax_sentence_sentence.Assert(
                            binary(
                                "==",
                                named("$dispatch$count", origin),
                                literal_integer("1", origin),
                                origin,
                            ),
                            message,
                            origin,
                            origin,
                        ),
                    )
                    tail := model_syntax_block_block.empty_block()
                    index = int(len(calls))
                    result ?= first.result
                    is_unit := result == None
                    if result != None:
                        is_unit = model_syntax_type_annotation.simple_type_name(result) == "unit"
                    while index > 0:
                        index -= 1
                        branch = model_syntax_block_block.Block(
                            [model_syntax_sentence_sentence.ExpressionStatement(
                                calls[index],
                            ), model_syntax_sentence_sentence.Statement.Return(None, origin)],
                        ) if is_unit else model_syntax_block_block.Block(
                            [model_syntax_sentence_sentence.Statement.Return(calls[index], origin)],
                        )
                        if index == int(len(calls)) - 1:
                            tail = branch
                        else:
                            tail = model_syntax_block_block.Block(
                                [model_syntax_sentence_sentence.Statement.If(
                                    named(guards[index], origin),
                                    branch,
                                    tail,
                                    origin,
                                )],
                            )
                    for statement in tail.statements:
                        statements.append(statement)
                    wrapper = model_syntax_function_function.FunctionDeclaration(
                        name=family_name,
                        parameters=first.parameters,
                        result=first.result,
                        body=model_syntax_block_block.Block(statements),
                        span=first.span,
                        lookup=first.lookup,
                        result_mode=first.result_mode,
                        prelude=first.prelude,
                    )
                    wrapper.semantic_key = model_syntax_symbol_symbol.semantic_key(
                        [family_identity, "dispatch-family"],
                    )
                    wrapper.definition = model_syntax_symbol_symbol.definition_from_key(
                        wrapper.semantic_key,
                    )
                    wrapper.dispatch_candidates = candidate_names
                    wrapper.dispatch_predicates = candidate_predicates
                    output.append(model_hir_module_module.Function(wrapper))
            case _:
                output.append(item)
    module.items = output
    return module
