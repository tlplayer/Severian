import * from "../../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol


class Closure:
    type_id: model_syntax_symbol_symbol.TypeId
    parameters: list[string]
    body: model_syntax_function_function.Expression
    captures: list[string]


def names(value: model_syntax_function_function.Expression, result: list[string]):
    match value.kind:
        case Name:
            if name not in result:
                result.append(name)
        case Binary:
            names(left, result)
            names(right, result)
        case Unary:
            names(operand, result)
        case Ownership:
            names(value, result)
        case Member:
            names(object, result)
        case Subscript:
            names(object, result)
            names(index, result)
        case Call:
            names(callee, result)
            for argument in arguments:
                names(argument.value, result)
        case Conditional:
            names(condition, result)
            names(then_value, result)
            names(else_value, result)
        case ListLiteral:
            for element in elements:
                names(element, result)
        case _:
            throw Error("unimplemented (sev_compiler/frontend/semantic/semantic/src/closures.sev)")
