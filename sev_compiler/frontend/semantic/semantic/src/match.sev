import * from "../../../../syntax/block/block.sev" as model_syntax_block_block
import * from "../../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import * from "../../../../syntax/literal/value.sev" as model_syntax_literal_value
import * from "../../../../syntax/primitive/declarations.sev" as model_syntax_primitive_declarations
import * from "../../../../syntax/sentence/sentence.sev" as model_syntax_sentence_sentence
import * from "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import * from "../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import diagnostics
import source
import * from "definitions.sev" as definitions
import * from "../../../../syntax/type/tagged.sev" as tagged


def literal_pattern(expression: model_syntax_function_function.Expression) -> bool:
    match expression.kind:
        case LiteralValue:
            return true
        case Unary:
            if operator.symbol == "-" or operator.symbol == "+":
                match operand.kind:
                    case LiteralValue:
                        return true
                    case _:
                        throw Error("unimplemented (sev_compiler/frontend/semantic/semantic/src/match.sev)")
        case _:
            throw Error("unimplemented (sev_compiler/frontend/semantic/semantic/src/match.sev)")
    return false


# Desugar before type checking so ordinary equality resolution, branch scopes,
# and return analysis apply. The unspellable local evaluates the subject once.
def expand_match(subject: model_syntax_function_function.Expression, arms: list[model_syntax_sentence_sentence.MatchArm], span: source.Span) -> model_syntax_sentence_sentence.Statement | diagnostics.Diagnostic:
    if len(arms) == 0:
        return error(diagnostics.Diagnostic("E000206", "match requires at least one arm", span))
    wildcard := false
    for arm in arms:
        if wildcard:
            return error(diagnostics.Diagnostic("E000206", "match arm after wildcard is unreachable", arm.span))
        if arm.annotation != None or arm.binding_name != None:
            return error(diagnostics.Diagnostic("E000206", "match supports only literal and wildcard patterns", arm.span))
        pattern ?= arm.pattern
        if pattern != None:
            if not literal_pattern(pattern):
                return error(diagnostics.Diagnostic("E000206", "match supports only literal and wildcard patterns", pattern.span))
        else:
            wildcard = true
    name = "$match_subject_" + string(span.start)
    tail := model_syntax_block_block.empty_block()
    index := len(arms)
    while index > 0:
        index -= 1
        arm = arms[index]
        condition := model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), span)
        pattern ?= arm.pattern
        if pattern != None:
            reference = model_syntax_function_function.Expression(model_syntax_function_function.Name(name), subject.span)
            condition = model_syntax_function_function.Expression(model_syntax_function_function.Binary(model_syntax_function_syntax.operator_syntax(model_syntax_function_syntax.Equal()), reference, pattern), pattern.span)
        tail = model_syntax_block_block.Block([model_syntax_sentence_sentence.Statement.If(condition, arm.body, tail, span)])
    binding = model_syntax_sentence_sentence.Binding(name, None, subject, false, false, subject.span)
    body = model_syntax_block_block.Block([model_syntax_sentence_sentence.BindingStatement(binding)])
    for statement in tail.statements:
        body.statements.append(statement)
    taken = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), span)
    return model_syntax_sentence_sentence.Statement.If(taken, body, model_syntax_block_block.empty_block(), span)


class ResolvedArm:
    condition: model_syntax_function_function.Expression
    body: model_syntax_block_block.Block


# Resolve pattern identities, payload contracts and coverage before producing
# ordinary bindings, projections and conditions. No backend pattern protocol.
def resolve_arms(declarations: definitions.SemanticDefinitions, records: list[model_syntax_function_function.RecordDeclaration], namespace: string, subject_id: model_syntax_symbol_symbol.BindingId, subject_type: model_syntax_symbol_symbol.TypeId, arms: list[model_syntax_sentence_sentence.MatchArm], span: source.Span, expression_match: bool) -> list[ResolvedArm] | diagnostics.Diagnostic:
    variants: list[model_syntax_symbol_symbol.TypeId] := []
    alternatives: list[model_syntax_function_function.CallableAlternative] := []
    nominal := ""
    for record in records:
        if record.type_id.index == subject_type.index:
            if record.representation == "TaggedAggregate":
                nominal = record.name
                alternatives = record.alternatives
                for field in record.fields[1:]:
                    variants.append(field.type_id)
            else:
                variants = model_syntax_function_function.union_variants(record)
                if len(variants) == 0:
                    variants = model_syntax_function_function.outcome_variants(record)
    # A captured single variant is already narrowed to its nominal payload type.
    single := false
    if len(variants) == 0:
        for record in records:
            for alternative in record.alternatives:
                if definitions.type_name(subject_type, records) == record.name + "." + alternative.name:
                    variants.append(subject_type)
                    alternatives.append(alternative)
                    nominal = record.name
                    single = true
    output: list[ResolvedArm] = []
    covered: list[int] = []
    wildcard := false
    for arm in arms:
        if wildcard:
            return error(diagnostics.Diagnostic("E000206", "match arm after wildcard is unreachable", arm.span))
        selected: list[int] = []
        body = model_syntax_block_block.empty_block()
        condition := model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), span, type_id=model_syntax_primitive_declarations.bool_type_id())
        pattern ?= arm.pattern
        annotation ?= arm.annotation
        if annotation != None:
            annotations = type_members(annotation)
            for member in annotations:
                type_id = definitions.type_annotation(declarations, member, records, namespace)
                found := -1
                index := 0
                for variant in variants:
                    if variant.index == type_id.index:
                        found = index
                    index += 1
                if found == -1:
                    return error(diagnostics.Diagnostic("E000206", "capture type is not a variant of the match subject", arm.span))
                if found in selected:
                    return error(diagnostics.Diagnostic("E000206", "duplicate capture type", arm.span))
                selected.append(found)
            capture ?= arm.binding_name
            if capture != None:
                if capture != "_":
                    capture_type = definitions.type_annotation(declarations, annotation, records, namespace)
                    captured := projection(reference(subject_id, subject_type, span), variants[selected[-1]], selected[-1], single, span)
                    if len(selected) > 1:
                        captured = model_syntax_function_function.Expression(model_syntax_function_function.OutcomeValue(captured, len(selected) - 1), span, type_id=capture_type)
                        cursor := len(selected) - 1
                        while cursor > 0:
                            cursor -= 1
                            index = selected[cursor]
                            value = projection(reference(subject_id, subject_type, span), variants[index], index, single, span)
                            wrapped = model_syntax_function_function.Expression(model_syntax_function_function.OutcomeValue(value, cursor), span, type_id=capture_type)
                            captured = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Conditional(tag_test(reference(subject_id, subject_type, span), index, span), wrapped, captured), span, type_id=capture_type)
                    body.statements.append(model_syntax_sentence_sentence.BindingStatement(model_syntax_sentence_sentence.Binding(capture, None, captured, false, true, span, scoped=true)))
        elif pattern != None:
            if len(variants) == 0:
                if not literal_pattern(pattern):
                    return error(diagnostics.Diagnostic("E000206", "match supports only literal and wildcard patterns", pattern.span))
                condition = model_syntax_function_function.Expression(model_syntax_function_function.Binary(model_syntax_function_syntax.operator_syntax(model_syntax_function_syntax.Equal()), reference(subject_id, subject_type, span), pattern), pattern.span)
            else:
                constructor := pattern
                arguments: list[model_syntax_function_function.CallArgument] := []
                destructure := false
                match pattern.kind:
                    case Call:
                        constructor = callee
                        destructure = true
                    case _:
                        throw diagnostics.diagnostic("E000206", "unimplemented (sev_compiler/frontend/semantic/semantic/src/match.sev)")
                arguments = pattern_arguments(pattern)
                index := 0
                for alternative in alternatives:
                    spelling = tagged.path(constructor)
                    if spelling == alternative.name or spelling == nominal + "." + alternative.name or namespace + spelling == nominal + "." + alternative.name:
                        selected.append(index)
                    index += 1
                if len(selected) != 1:
                    return error(diagnostics.Diagnostic("E000206", "pattern is not a variant of the match subject", pattern.span))
                if destructure:
                    alternative = alternatives[selected[0]]
                    if len(arguments) != len(alternative.fields):
                        return error(diagnostics.Diagnostic("E000206", "wrong payload arity in match pattern", pattern.span))
                    payload = projection(reference(subject_id, subject_type, span), variants[selected[0]], selected[0], single, span)
                    names: list[string] = []
                    index = 0
                    for argument in arguments:
                        binding = tagged.path(argument.value)
                        if argument.name != None or argument.spread or binding == "" or "." in binding:
                            return error(diagnostics.Diagnostic("E000206", "payload pattern requires a binding name or _", argument.span))
                        if binding != "_":
                            if binding in names:
                                return error(diagnostics.Diagnostic("E000206", "duplicate payload binding " + binding, argument.span))
                            names.append(binding)
                            value = model_syntax_function_function.Expression(model_syntax_function_function.Member(payload, alternative.fields[index].name), argument.span)
                            body.statements.append(model_syntax_sentence_sentence.BindingStatement(model_syntax_sentence_sentence.Binding(binding, None, value, false, true, argument.span, scoped=true)))
                        index += 1
        else:
            wildcard = true
        if len(selected) != 0:
            reachable := false
            for index in selected:
                if index not in covered:
                    reachable = true
                    covered.append(index)
            if not reachable:
                return error(diagnostics.Diagnostic("E000206", "unreachable tagged match arm", arm.span))
            if not single:
                condition = tag_test(reference(subject_id, subject_type, span), selected[-1], span)
                cursor := len(selected) - 1
                while cursor > 0:
                    cursor -= 1
                    condition = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Conditional(tag_test(reference(subject_id, subject_type, span), selected[cursor], span), model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), span, type_id=model_syntax_primitive_declarations.bool_type_id()), condition), span, type_id=model_syntax_primitive_declarations.bool_type_id())
        for statement in arm.body.statements:
            body.statements.append(statement)
        output.append(ResolvedArm(condition, body))
    if len(output) == 0:
        return error(diagnostics.Diagnostic("E000206", "match requires at least one arm", span))
    if not wildcard:
        if len(variants) != 0:
            if len(covered) != len(variants):
                return error(diagnostics.Diagnostic("E000206", "non-exhaustive tagged match", span))
        elif expression_match:
            return error(diagnostics.Diagnostic("E000206", "match expression requires exhaustive patterns or a wildcard", span))
    return output


def type_members(annotation: model_syntax_type_annotation.TypeAnnotation) -> list[model_syntax_type_annotation.TypeAnnotation]:
    match annotation.kind:
        case Union:
            return members
        case _:
            return [annotation]


def pattern_arguments(pattern: model_syntax_function_function.Expression) -> list[model_syntax_function_function.CallArgument]:
    match pattern.kind:
        case Call:
            return arguments
        case _:
            return []


def projection(subject: model_syntax_function_function.Expression, type_id: model_syntax_symbol_symbol.TypeId, index: int, single: bool, span: source.Span) -> model_syntax_function_function.Expression:
    if single:
        return clone(subject)
    return model_syntax_function_function.Expression(model_syntax_function_function.FieldReference(clone(subject), index + 1), span, type_id=type_id)


def tag_test(subject: model_syntax_function_function.Expression, index: int, span: source.Span) -> model_syntax_function_function.Expression:
    return model_syntax_function_function.Expression(model_syntax_function_function.OutcomeTest(clone(subject), index), span, type_id=model_syntax_primitive_declarations.bool_type_id())


def reference(binding: model_syntax_symbol_symbol.BindingId, type_id: model_syntax_symbol_symbol.TypeId, span: source.Span) -> model_syntax_function_function.Expression:
    return model_syntax_function_function.Expression(model_syntax_function_function.BindingReference(binding), span, type_id=type_id)
