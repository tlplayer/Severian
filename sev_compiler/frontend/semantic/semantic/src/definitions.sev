import "../../../../syntax/primitive/mlir.sev" as type_bindings
import "../../../../hir/module/module.sev" as model_hir_module_module
import "../../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import "../../../../syntax/primitive/declarations.sev" as model_syntax_primitive_declarations
import "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import "../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import "../../../../syntax/type/mlir.sev" as model_syntax_type_mlir
import diagnostics
import source
import "../../../../syntax/primitive/catalog.sev" as scalar
import "../../../../syntax/type/storage.sev" as storage_types
import "../../../../syntax/type/tagged.sev" as tagged


# Shared declaration environment. AST declarations survive with resolved
# identities; callable analysis and the package entry use the same environment.
class RecordInstance:
    type_id: model_syntax_symbol_symbol.TypeId
    template: model_syntax_symbol_symbol.DefId
    arguments: list[model_syntax_symbol_symbol.TypeBinding]
    constructors: list[model_syntax_symbol_symbol.TypeConstructorBinding] = []
    values: list[model_syntax_type_annotation.TypeAnnotation] = []


class SemanticDefinitions:
    aliases: list[model_syntax_function_syntax.TypeDeclaration] = []
    traits: list[model_syntax_function_syntax.TraitDeclaration] = []
    implementations: list[model_syntax_function_function.RecordDeclaration] = []
    symbol_descriptors: list[model_syntax_function_syntax.TraitDeclaration] = []
    record_templates: list[model_syntax_function_function.RecordDeclaration] = []
    record_instances: list[RecordInstance] = []
    expression_functions: list[model_syntax_function_function.FunctionDeclaration] = []


def definition_id(name: string, ordinal: int) -> model_syntax_symbol_symbol.DefId:
    # Compatibility for generated declarations without a source membership.
    # Registration order never participates in semantic identity.
    return model_syntax_symbol_symbol.named_definition("$generated", "declaration", name)


def trait_named(definitions: SemanticDefinitions, name: string, namespace: string) -> model_syntax_function_syntax.TraitDeclaration | None:
    for declaration in definitions.traits:
        if declaration.name == namespace + name:
            return declaration
    for declaration in definitions.traits:
        if declaration.name == name:
            return declaration
    return None


def alias_named(definitions: SemanticDefinitions, name: string, namespace: string) -> model_syntax_function_syntax.TypeDeclaration | None:
    for declaration in definitions.aliases:
        if declaration.name == namespace + name:
            return declaration
    for declaration in definitions.aliases:
        if declaration.name == name:
            return declaration
    return None


def bind_type_arguments(parameters: list[string], arguments: list[model_syntax_type_annotation.TypeAnnotation], span: source.Span, pack: string = "", defaults: list[model_syntax_type_annotation.TypeAnnotation] = []) -> list[model_syntax_type_annotation.TypeAnnotation] | diagnostics.Diagnostic:
    ordered: list[model_syntax_type_annotation.TypeAnnotation] = []
    for parameter in parameters:
        ordered.append(model_syntax_type_annotation.named_type("", [], span))
    filled: list[int] = []
    positional := 0
    named := false
    for argument in arguments:
        index := positional
        if argument.binding != "":
            named = true
            index = -1
            cursor := 0
            for parameter in parameters:
                if argument.binding == parameter:
                    index = cursor
                cursor += 1
            if index == -1:
                return error(diagnostics.diagnostic_at("E000205", "unknown type parameter " + argument.binding, argument.span))
            if argument.binding == pack:
                return error(diagnostics.diagnostic_at("E000205", "type packs require positional arguments", argument.span))
        else:
            if named:
                return error(diagnostics.diagnostic_at("E000205", "positional type argument follows named argument", argument.span))
            positional += 1
        if index in filled:
            return error(diagnostics.diagnostic_at("E000205", "duplicate type argument", argument.span))
        value = model_syntax_type_annotation.TypeAnnotation(argument.kind, argument.span)
        if index >= len(parameters):
            if pack == "":
                return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", span))
            ordered.append(value)
        else:
            ordered[index] = value
        filled.append(index)
    cursor := 0
    for parameter in parameters:
        if cursor not in filled:
            if parameter == pack:
                return ordered[:cursor]
            supplied := false
            for default in defaults:
                if default.binding == parameter:
                    ordered[cursor] = replace_annotation(model_syntax_type_annotation.TypeAnnotation(default.kind, default.span), parameters, ordered)
                    supplied = true
            if not supplied:
                return error(diagnostics.diagnostic_at("E000205", "missing type argument " + parameter, span))
        cursor += 1
    return ordered


def bootstrap_storage_type(definitions: SemanticDefinitions, name: string, namespace: string) -> bool:
    # The source prelude's list protocols use the rank-one storage boundary too.
    # Explicit list declarations and aliases retain their concrete contracts.
    return name == "array" or (name == "list" and alias_named(definitions, name, namespace) == None and record_template(definitions, name, namespace) == None)


def type_annotation(definitions: SemanticDefinitions, annotation: model_syntax_type_annotation.TypeAnnotation, records: list[model_syntax_function_function.RecordDeclaration], namespace: string, active: list[string] = []) -> model_syntax_symbol_symbol.TypeId | diagnostics.Diagnostic:
    match annotation.kind:
        case Named:
            if name == "char" and len(arguments) != 0:
                if len(arguments) != 1:
                    return error(diagnostics.diagnostic_at("E000205", "char requires one storage type", annotation.span))
                unit = type_annotation(definitions, arguments[0], records, namespace, active)
                if int(unit.index) not in [108, 532]:
                    return error(diagnostics.diagnostic_at("E000205", "char storage must be u8 or u32", annotation.span))
                return unit
            if bootstrap_storage_type(definitions, name, namespace) and len(arguments) == 1:
                element = type_annotation(definitions, arguments[0], records, namespace, active)
                if int(element.index) in [1, 8, 16, 32, 64, 108, 516, 532, 564, 132, 164]:
                    return model_syntax_symbol_symbol.TypeId(200 + element.index)
                if element.index == 3:
                    for record in records:
                        if record.storage_element.index == element.index:
                            return record.type_id
                    id = model_syntax_symbol_symbol.TypeId(u32(1000 + len(records)))
                    fields = [model_syntax_function_function.FunctionParameter("data", model_syntax_type_annotation.named_type("string", [], annotation.span), None, annotation.span, type_id=model_syntax_primitive_declarations.string_type_id()), model_syntax_function_function.FunctionParameter("ends", model_syntax_type_annotation.named_type("list", [model_syntax_type_annotation.named_type("int", [], annotation.span)], annotation.span), None, annotation.span, type_id=model_syntax_symbol_symbol.TypeId(264))]
                    records.append(model_syntax_function_function.RecordDeclaration("$buffer$string", fields, [], annotation.span, type_id=id, storage_element=element, representation="OwnedBuffer"))
                    return id
                if not storage_types.copy_storage(element, records):
                    return error(diagnostics.diagnostic_at("E000205", "array elements require copyable storage; owned elements require destruction lowering", annotation.span))
                for record in records:
                    if record.storage_element.index == element.index:
                        return record.type_id
                id = model_syntax_symbol_symbol.TypeId(u32(1000 + len(records)))
                records.append(model_syntax_function_function.RecordDeclaration("$buffer$" + type_name(element, records), [], [], annotation.span, type_id=id, storage_element=element, mlir=type_bindings.memref_mlir(), mlir_shape=[-1], mlir_element=element))
                return id
            alias ?= alias_named(definitions, name, namespace)
            if alias != None:
                ordered_arguments = bind_type_arguments(alias.type_parameters, arguments, annotation.span, defaults=scoped_defaults(definitions, alias.type_defaults, alias.lookup))
                if alias.name in active:
                    return error(diagnostics.diagnostic_at("E000205", "cyclic type alias " + alias.name, annotation.span))
                if alias.id.index != 0:
                    return alias.id
                target ?= alias.definition
                if target != None:
                    # Arguments belong to the caller's scope; the alias body
                    # belongs to its declaration scope. Resolve that boundary
                    # before substituting names into the alias definition.
                    replacements: list[model_syntax_type_annotation.TypeAnnotation] = []
                    for argument in ordered_arguments:
                        constructor_name ?= model_syntax_type_annotation.simple_type_name(argument)
                        if constructor_name != None:
                            constructor ?= record_template(definitions, constructor_name, namespace)
                            if constructor != None:
                                replacements.append(model_syntax_type_annotation.named_type(constructor.name, [], argument.span))
                                continue
                        actual = type_annotation(definitions, argument, records, namespace, active)
                        replacements.append(model_syntax_type_annotation.named_type(type_name(actual, records), [], argument.span))
                    substituted = replace_annotation(target, alias.type_parameters, replacements)
                    match substituted.kind:
                        case Union:
                            # Family values still require a concrete member.
                            return error(diagnostics.diagnostic_at("E000205", "family requires a concrete member: " + alias.name, annotation.span))
                        case _:
                            path = active[:]
                            path.append(alias.name)
                            return type_annotation(definitions, substituted, records, alias.lookup, path)
            template ?= record_template(definitions, name, namespace)
            if name == "Error" and template == None:
                for record in records:
                    if record.name == "MessageError":
                        return record.type_id
            if template != None:
                return instantiate_record(definitions, template, arguments, records, namespace, annotation.span)
            for record in records:
                if record.name == namespace + name:
                    if len(arguments) != 0:
                        return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", annotation.span))
                    return record.type_id
            for record in records:
                if record.name == name:
                    if len(arguments) != 0:
                        return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", annotation.span))
                    return record.type_id
            selection = tagged.select(records, namespace, name, model_syntax_symbol_symbol.TypeId(0), annotation.span)
            if selection.record != -1:
                return records[selection.record].fields[selection.variant + 1].type_id
            known ?= scalar.scalar_type_name(name)
            if known != None:
                return known
            return error(diagnostics.diagnostic_at("E000205", "unknown type " + name, annotation.span))
        case Union:
            variants: list[model_syntax_symbol_symbol.TypeId] = []
            key := "$outcome"
            for member in members:
                variant = type_annotation(definitions, member, records, namespace, active)
                for previous in variants:
                    if previous.index == variant.index:
                        return error(diagnostics.diagnostic_at("E000205", "duplicate outcome variant", annotation.span))
                variants.append(variant)
                key += "$" + string(variant.index)
            for record in records:
                if record.name == key:
                    return record.type_id
            successes := 0
            for variant in variants:
                if int(variant.index) not in [6, 7] and not error_conformance(definitions, records, variant):
                    successes += 1
            if len(variants) < 2:
                return error(diagnostics.diagnostic_at("E000205", "union requires at least two members", annotation.span))
            if successes != 1:
                key = "$union" + key[len("$outcome"):]
            for record in records:
                if record.name == key:
                    return record.type_id
            fields = [model_syntax_function_function.FunctionParameter("$tag", model_syntax_type_annotation.named_type("int", [], annotation.span), None, annotation.span, type_id=model_syntax_primitive_declarations.i64_type_id())]
            index := 0
            for variant in variants:
                fields.append(model_syntax_function_function.FunctionParameter("$variant" + string(index), model_syntax_type_annotation.named_type(type_name(variant, records), [], annotation.span), None, annotation.span, type_id=variant))
                index += 1
            id = model_syntax_symbol_symbol.TypeId(u32(1000 + len(records)))
            records.append(model_syntax_function_function.RecordDeclaration(key, fields, [], annotation.span, type_id=id))
            return id
        case _:
            return error(diagnostics.diagnostic_at("E000205", "a value requires one concrete type", annotation.span))


def type_name(type_id: model_syntax_symbol_symbol.TypeId, records: list[model_syntax_function_function.RecordDeclaration]) -> string:
    known ?= scalar.scalar_type(type_id)
    if known != None:
        return known.name
    for record in records:
        if record.type_id.index == type_id.index:
            return record.name
    return "$parameter$" + string(type_id.index)


def replace_annotation(annotation: model_syntax_type_annotation.TypeAnnotation, names: list[string], replacements: list[model_syntax_type_annotation.TypeAnnotation]) -> model_syntax_type_annotation.TypeAnnotation:
    match annotation.kind:
        case Named:
            index := 0
            for parameter in names:
                if name == parameter:
                    replacement := replacements[index]
                    if len(arguments) == 0:
                        replacement.binding = annotation.binding
                        return replacement
                    applied: list[model_syntax_type_annotation.TypeAnnotation] = []
                    for argument in arguments:
                        applied.append(replace_annotation(argument, names, replacements))
                    match replacement.kind:
                        case Named:
                            return model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Named(name, applied), annotation.span, binding=annotation.binding)
                        case _:
                            throw Error("unimplemented (sev_compiler/frontend/semantic/semantic/src/definitions.sev)")
                index += 1
            replaced: list[model_syntax_type_annotation.TypeAnnotation] = []
            for argument in arguments:
                replaced.append(replace_annotation(argument, names, replacements))
            return model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Named(name, replaced), annotation.span, binding=annotation.binding)
        case Union:
            replaced: list[model_syntax_type_annotation.TypeAnnotation] = []
            for member in members:
                replaced.append(replace_annotation(member, names, replacements))
            return model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Union(replaced), annotation.span, binding=annotation.binding)


def replace_function_types(function: model_syntax_function_function.FunctionDeclaration, names: list[string], replacements: list[model_syntax_type_annotation.TypeAnnotation]) -> model_syntax_function_function.FunctionDeclaration:
    parameters: list[model_syntax_function_function.FunctionParameter] = []
    for parameter in function.parameters:
        parameter.annotation = replace_annotation(parameter.annotation, names, replacements)
        parameters.append(parameter)
    function.parameters = parameters
    result ?= function.result
    if result != None:
        function.result = replace_annotation(result, names, replacements)
    return function


def trait_application(definitions: SemanticDefinitions, annotation: model_syntax_type_annotation.TypeAnnotation, namespace: string) -> model_syntax_function_syntax.TraitDeclaration | diagnostics.Diagnostic:
    match annotation.kind:
        case Named:
            declaration ?= trait_named(definitions, name, namespace)
            if declaration == None:
                return error(diagnostics.diagnostic_at("E000212", "unknown trait " + name, annotation.span))
            if declaration != None:
                applied := declaration
                replacements = bind_type_arguments(applied.type_parameters, arguments, annotation.span, defaults=scoped_defaults(definitions, applied.type_defaults, applied.lookup))
                applied.arguments = replacements
                methods: list[model_syntax_function_function.FunctionDeclaration] = []
                for method in applied.methods:
                    if len(method.type_parameters) != 0:
                        return error(diagnostics.Diagnostic("E000212", "generic trait methods require method argument inference", method.span))
                    methods.append(replace_function_types(method, applied.type_parameters, replacements))
                properties: list[model_syntax_function_syntax.PropertyDeclaration] = []
                for property in applied.properties:
                    property.annotation = replace_annotation(property.annotation, applied.type_parameters, replacements)
                    properties.append(property)
                operations: list[model_syntax_function_syntax.OperatorDeclaration] = []
                for operation in applied.operators:
                    parameters: list[model_syntax_function_syntax.OperatorParameter] = []
                    for parameter in operation.parameters:
                        parameter.annotation = replace_annotation(parameter.annotation, applied.type_parameters, replacements)
                        parameters.append(parameter)
                    operation.parameters = parameters
                    operation.result = replace_annotation(operation.result, applied.type_parameters, replacements)
                    operations.append(operation)
                bases: list[model_syntax_type_annotation.TypeAnnotation] = []
                for base in applied.bases:
                    bases.append(replace_annotation(base, applied.type_parameters, replacements))
                applied.methods = methods
                applied.properties = properties
                applied.operators = operations
                applied.bases = bases
                return applied
        case _:
            throw diagnostics.diagnostic("E000205", "unimplemented (sev_compiler/frontend/semantic/semantic/src/definitions.sev)")
    return error(diagnostics.diagnostic_at("E000212", "constraint must name a trait", annotation.span))


def inherited_traits(definitions: SemanticDefinitions, declaration: model_syntax_function_syntax.TraitDeclaration, active: list[string] = []) -> list[model_syntax_function_syntax.TraitDeclaration] | diagnostics.Diagnostic:
    if declaration.name in active:
        return error(diagnostics.diagnostic_at("E000212", "cyclic trait inheritance " + declaration.name, declaration.span))
    result = [declaration]
    path = active[:]
    path.append(declaration.name)
    for base in declaration.bases:
        parent = trait_application(definitions, base, declaration.lookup)
        for inherited in inherited_traits(definitions, parent, path):
            result.append(inherited)
    return result


def resolve_operator_constraints(definitions: SemanticDefinitions, operation: model_syntax_function_syntax.OperatorDeclaration, namespace: string) -> model_syntax_function_syntax.OperatorDeclaration | diagnostics.Diagnostic:
    constraints: list[model_syntax_function_syntax.GenericConstraint] = []
    for constraint in operation.constraints:
        grammar_bound := false
        match constraint:
            case Parameter:
                bound_name ?= model_syntax_type_annotation.simple_type_name(bound)
                if bound_name != None:
                    contract_definition ?= trait_named(definitions, bound_name, namespace)
                    if contract_definition != None:
                        if contract_definition.grammar:
                            if operation.grammar_parameter != absent:
                                return error(diagnostics.diagnostic_at("E000212", "operator requires one grammar binding", span))
                            operation.grammar_parameter = parameter
                            syntax = operation.syntax
                            syntax.domain = model_syntax_function_syntax.OperatorDomain.GrammarOperator
                            syntax.grammar_name = bound_name
                            operation.syntax = syntax
                            grammar_bound = true
                    else:
                        known := alias_named(definitions, bound_name, namespace) != None
                        for implementation in definitions.implementations:
                            if implementation.name == bound_name or implementation.name == namespace + bound_name:
                                known = true
                        if not known:
                            return error(diagnostics.diagnostic_at("E000212", "unknown operator constraint " + bound_name, span))
            case _:
                throw diagnostics.diagnostic("E000205", "unimplemented (sev_compiler/frontend/semantic/semantic/src/definitions.sev)")
        if not grammar_bound:
            constraints.append(constraint)
    parameters: list[string] = []
    grammar_parameter ?= operation.grammar_parameter
    for parameter in operation.type_parameters:
        retained := true
        if grammar_parameter != absent:
            retained = parameter != grammar_parameter
        if retained:
            parameters.append(parameter)
    operation.type_parameters = parameters
    operation.constraints = constraints
    operation.syntax = resolve_grammar_binding(definitions, operation.syntax, namespace, operation.span)
    return operation


def resolve_grammar_binding(definitions: SemanticDefinitions, syntax: model_syntax_function_syntax.OperatorSyntax, namespace: string, span: source.Span) -> model_syntax_function_syntax.OperatorSyntax | diagnostics.Diagnostic:
    if syntax.domain != model_syntax_function_syntax.OperatorDomain.GrammarOperator:
        return syntax
    contract_definition ?= trait_named(definitions, syntax.grammar_name, namespace)
    if contract_definition == None:
        return error(diagnostics.diagnostic_at("E000212", "unknown grammar contract " + syntax.grammar_name, span))
    if contract_definition != None:
        if not contract_definition.grammar:
            return error(diagnostics.diagnostic_at("E000212", "operator binding requires a compiler G contract", span))
        for inherited in inherited_traits(definitions, contract_definition):
            for property in inherited.properties:
                if property.name == "symbol":
                    value ?= property.default
                    if value != None:
                        match value.kind:
                            case SourceSymbol:
                                if spelling != syntax.symbol:
                                    return error(diagnostics.diagnostic_at("E000212", "operator symbol does not match its grammar contract", span))
                                syntax.definition = contract_definition.definition
                                return syntax
                            case _:
                                return error(diagnostics.diagnostic_at("E000212", "grammar symbol requires a resolved source symbol", span))
        return error(diagnostics.diagnostic_at("E000212", "grammar binding requires a source symbol", span))
    return syntax


def extension_annotation(declaration: model_syntax_function_function.RecordDeclaration) -> model_syntax_type_annotation.TypeAnnotation:
    target ?= declaration.extension_target
    if target != None:
        return target
    arguments: list[model_syntax_type_annotation.TypeAnnotation] = []
    for parameter in declaration.type_parameters:
        arguments.append(model_syntax_type_annotation.named_type(parameter, [], declaration.span))
    return model_syntax_type_annotation.named_type(declaration.name, arguments, declaration.span)


def infer_extension_parameters(definitions: SemanticDefinitions, annotation: model_syntax_type_annotation.TypeAnnotation, namespace: string, parameters: list[string]):
    match annotation.kind:
        case Named:
            if len(arguments) != 0:
                for argument in arguments:
                    infer_extension_parameters(definitions, argument, namespace, parameters)
                return
            if name in parameters or "." in name or name in ["Error", "Self"]:
                return
            if scalar.scalar_type_name(name) != None or alias_named(definitions, name, namespace) != None:
                return
            for declaration in definitions.implementations:
                if not declaration.extension and (declaration.name == name or declaration.name == namespace + name):
                    return
            # Constant shape arguments are values, not free type parameters.
            if len(name) != 0 and name[0] in "0123456789":
                return
            parameters.append(name)
        case Union:
            for member in members:
                infer_extension_parameters(definitions, member, namespace, parameters)


def resolve_extension_parameters(definitions: SemanticDefinitions, declaration: model_syntax_function_function.RecordDeclaration) -> model_syntax_function_function.RecordDeclaration:
    if not declaration.extension:
        return declaration
    target = extension_annotation(declaration)
    parameters = declaration.type_parameters[:]
    match target.kind:
        case Named:
            for argument in arguments:
                infer_extension_parameters(definitions, argument, declaration.lookup, parameters)
        case _:
            throw Error("unimplemented (sev_compiler/frontend/semantic/semantic/src/definitions.sev)")
    declaration.type_parameters = parameters
    return declaration


def register_declarations(module: model_hir_module_module.Module, environment: SemanticDefinitions = SemanticDefinitions(), incremental: bool = false) -> SemanticDefinitions | diagnostics.Diagnostic:
    definitions = SemanticDefinitions(environment.aliases[:], environment.traits[:], environment.implementations[:] if incremental else [], environment.symbol_descriptors[:] if incremental else [], environment.record_templates[:] if incremental else [], environment.record_instances[:] if incremental else [], environment.expression_functions[:] if incremental else [])
    names: list[string] = []
    ordinal := 1000000 if incremental else 0
    if incremental:
        for alias in environment.aliases:
            names.append(alias.name)
        for trait in environment.traits:
            names.append(trait.name)
        for record in environment.implementations:
            if not record.extension and record.name not in names:
                names.append(record.name)
    for item in module.items:
        match item:
            case Function:
                result ?= declaration.result
                if result != None:
                    if len(declaration.type_parameters) == 0 and model_syntax_type_annotation.simple_type_name(result) == "Ex":
                        function := declaration
                        if function.definition.declaration.value == 0:
                            function.definition = definition_id(function.name, 40000 + ordinal)
                        definitions.expression_functions.append(function)
                        ordinal += 1
            case Trait:
                if declaration.name.split(".")[-1] == "G" and declaration.name != "G":
                    return error(diagnostics.diagnostic_at("E000212", "reserved compiler contract G cannot be redeclared", declaration.span))
                if declaration.compiler_descriptor and not declaration.grammar and declaration.name != "G":
                    definitions.symbol_descriptors.append(declaration)
                    continue
                trait_declaration := declaration
                if trait_declaration.name in names:
                    if trait_declaration.name == "G":
                        return error(diagnostics.diagnostic_at("E000212", "reserved compiler contract G cannot be redeclared", trait_declaration.span))
                    return error(diagnostics.diagnostic_at("E000212", "duplicate declaration " + trait_declaration.name, trait_declaration.span))
                names.append(trait_declaration.name)
                if trait_declaration.definition.declaration.value == 0:
                    trait_declaration.definition = definition_id(trait_declaration.name, ordinal)
                for original in definitions.traits:
                    if original.source_name != "" and original.source_name == trait_declaration.source_name and original.span.source.index == trait_declaration.span.source.index and original.span.start == trait_declaration.span.start:
                        trait_declaration.definition = original.definition
                if trait_declaration.grammar:
                    if trait_declaration.definition.declaration.value == 0:
                        trait_declaration.definition = model_syntax_symbol_symbol.DefId(0, u128(trait_declaration.span.source.index) + 2, model_syntax_symbol_symbol.DeclarationId(u128(trait_declaration.span.start) + 1))
                ordinal += 1
                if len(trait_declaration.constraints) != 0:
                    return error(diagnostics.diagnostic_at("E000212", "trait parameter constraints require capability validation", trait_declaration.span))
                resolved_methods: list[model_syntax_function_function.FunctionDeclaration] = []
                resolved_operators: list[model_syntax_function_syntax.OperatorDeclaration] = []
                resolved_properties: list[model_syntax_function_syntax.PropertyDeclaration] = []
                for property in trait_declaration.properties:
                    if property.definition.declaration.value == 0:
                        property.definition = definition_id(property.name, ordinal)
                    ordinal += 1
                    resolved_properties.append(property)
                for method in trait_declaration.methods:
                    if method.definition.declaration.value == 0:
                        method.definition = definition_id(method.name, ordinal)
                    resolved_methods.append(method)
                    ordinal += 1
                for operation in trait_declaration.operators:
                    if operation.definition.declaration.value == 0:
                        operation.definition = definition_id(operation.syntax.symbol, ordinal)
                    resolved_operators.append(operation)
                    ordinal += 1
                trait_declaration.properties = resolved_properties
                trait_declaration.methods = resolved_methods
                trait_declaration.operators = resolved_operators
                definitions.traits.append(trait_declaration)
            case Type:
                if declaration.name in names:
                    return error(diagnostics.diagnostic_at("E000205", "duplicate declaration " + declaration.name, declaration.span))
                names.append(declaration.name)
                if len(declaration.constraints) != 0 or declaration.definition == None:
                    return error(diagnostics.diagnostic_at("E000205", "type declaration requires a concrete alias or closed family", declaration.span))
                definitions.aliases.append(declaration)
            case Record:
                record_declaration := declaration
                if record_declaration.definition.declaration.value == 0:
                    record_declaration.definition = definition_id(declaration.name, 30000 + ordinal)
                for original in definitions.record_templates:
                    if original.source_name != "" and original.source_name == record_declaration.source_name and original.span.source.index == record_declaration.span.source.index and original.span.start == record_declaration.span.start:
                        record_declaration.definition = original.definition
                if len(declaration.type_parameters) != 0 and not declaration.extension:
                    definitions.record_templates.append(record_declaration)
                definitions.implementations.append(record_declaration)
                if not declaration.extension:
                    if declaration.name in names:
                        # A family behavior declaration can share its family's name.
                        family ?= alias_named(definitions, declaration.name, "")
                        if family == None:
                            return error(diagnostics.diagnostic_at("E000205", "duplicate declaration " + declaration.name, declaration.span))
                    else:
                        names.append(declaration.name)
                ordinal += 1
            case _:
                throw diagnostics.diagnostic("E000205", "unimplemented (sev_compiler/frontend/semantic/semantic/src/definitions.sev)")
    # Resolve free extension parameters only after every concrete type and alias
    # is registered. list[string] is concrete; list[T] may bind an unknown T.
    implementation_index := 0
    for declaration in definitions.implementations:
        definitions.implementations[implementation_index] = resolve_extension_parameters(definitions, declaration)
        implementation_index += 1
    item_index := 0
    for item in module.items:
        match item:
            case Record:
                module.items[item_index] = model_hir_module_module.Record(resolve_extension_parameters(definitions, declaration))
            case _:
                throw diagnostics.diagnostic("E000205", "unimplemented (sev_compiler/frontend/semantic/semantic/src/definitions.sev)")
        item_index += 1
    trait_index := 0
    for declaration in definitions.traits:
        inherited_traits(definitions, declaration)
        member_names: list[string] = []
        for method in declaration.methods:
            if method.name in member_names:
                return error(diagnostics.diagnostic_at("E000212", "duplicate trait member " + method.name, declaration.span))
            member_names.append(method.name)
        symbols: list[string] = []
        resolved_operators: list[model_syntax_function_syntax.OperatorDeclaration] = []
        for operation in declaration.operators:
            operation = resolve_operator_constraints(definitions, operation, declaration.lookup)
            resolved_operators.append(operation)
            key = operation.syntax.symbol + string(len(operation.parameters)) + string(operation.receiver)
            if key in symbols:
                return error(diagnostics.diagnostic_at("E000212", "duplicate trait operator " + operation.syntax.symbol, operation.span))
            symbols.append(key)
        declaration.operators = resolved_operators
        definitions.traits[trait_index] = declaration
        trait_index += 1
    module.traits = definitions.traits
    module.types = definitions.aliases
    return definitions


def family_members(definitions: SemanticDefinitions, annotation: model_syntax_type_annotation.TypeAnnotation, records: list[model_syntax_function_function.RecordDeclaration], namespace: string, active: list[string] = []) -> list[model_syntax_symbol_symbol.TypeId] | diagnostics.Diagnostic:
    match annotation.kind:
        case Union:
            result: list[model_syntax_symbol_symbol.TypeId] = []
            for member in members:
                for concrete in family_members(definitions, member, records, namespace, active):
                    duplicate := false
                    for previous in result:
                        if previous.index == concrete.index:
                            duplicate = true
                    if not duplicate:
                        result.append(concrete)
            if len(result) == 0:
                return error(diagnostics.diagnostic_at("E000205", "empty type family", annotation.span))
            return result
        case Named:
            alias ?= alias_named(definitions, name, namespace)
            if alias != None:
                if alias.name in active:
                    return error(diagnostics.diagnostic_at("E000205", "cyclic type family " + alias.name, annotation.span))
                target ?= alias.definition
                if target != None:
                    if len(alias.type_parameters) != len(arguments):
                        return error(diagnostics.diagnostic_at("E000205", "type argument count mismatch", annotation.span))
                    replacements: list[model_syntax_type_annotation.TypeAnnotation] = []
                    for argument in arguments:
                        actual = type_annotation(definitions, argument, records, namespace, active)
                        replacements.append(model_syntax_type_annotation.named_type(type_name(actual, records), [], argument.span))
                    substituted = replace_annotation(target, alias.type_parameters, replacements)
                    path = active[:]
                    path.append(alias.name)
                    return family_members(definitions, substituted, records, alias.lookup, path)
    return [type_annotation(definitions, annotation, records, namespace)]


def error_conformance(definitions: SemanticDefinitions, records: list[model_syntax_function_function.RecordDeclaration], type_id: model_syntax_symbol_symbol.TypeId) -> bool | diagnostics.Diagnostic:
    required ?= trait_named(definitions, "Error", "")
    if required == None:
        return false
    if required != None:
        for record in records:
            if record.type_id.index == type_id.index:
                for base in record.traits:
                    name ?= model_syntax_type_annotation.simple_type_name(base)
                    if name != None:
                        declared ?= trait_named(definitions, name, record.lookup)
                        if declared != None:
                            for inherited in inherited_traits(definitions, declared):
                                if inherited.definition.module == required.definition.module and inherited.definition.declaration.value == required.definition.declaration.value:
                                    return true
    return false


# Generic records retain their declaration identity and canonical type bindings.
# Allocate identity before resolving fields, so recursive applications terminate;
# the concrete layout validator diagnoses recursive storage afterwards.
def record_template(definitions: SemanticDefinitions, name: string, namespace: string) -> model_syntax_function_function.RecordDeclaration | None:
    for template in definitions.record_templates:
        if template.name == namespace + name:
            for original in definitions.record_templates:
                if original.definition.package == template.definition.package and original.definition.module == template.definition.module and original.definition.declaration.value == template.definition.declaration.value:
                    return original
            return template
    for template in definitions.record_templates:
        if template.name == name:
            for original in definitions.record_templates:
                if original.definition.package == template.definition.package and original.definition.module == template.definition.module and original.definition.declaration.value == template.definition.declaration.value:
                    return original
            return template
    return None


def instantiate_record(definitions: SemanticDefinitions, template: model_syntax_function_function.RecordDeclaration, arguments: list[model_syntax_type_annotation.TypeAnnotation], records: list[model_syntax_function_function.RecordDeclaration], namespace: string, span: source.Span) -> model_syntax_symbol_symbol.TypeId | diagnostics.Diagnostic:
    arguments = bind_type_arguments(template.type_parameters, arguments, span, template.type_pack, scoped_defaults(definitions, template.type_defaults, template.lookup))
    actuals: list[model_syntax_symbol_symbol.TypeBinding] = []
    constructors: list[model_syntax_symbol_symbol.TypeConstructorBinding] = []
    replacements: list[model_syntax_type_annotation.TypeAnnotation] = []
    values: list[model_syntax_type_annotation.TypeAnnotation] = []
    index := 0
    name := template.name + "["
    for argument in arguments:
        number = value_argument(definitions, argument, namespace)
        if number != "":
            supplied = model_syntax_type_annotation.named_type(number, [], argument.span)
            supplied.binding = template.type_parameters[index]
            values.append(supplied)
            replacements.append(model_syntax_type_annotation.named_type(number, [], argument.span))
            if index > 0:
                name += ", "
            name += number
            index += 1
            continue
        constructor_name ?= model_syntax_type_annotation.simple_type_name(argument)
        if constructor_name != None:
            constructor ?= record_template(definitions, constructor_name, namespace)
            if constructor != None:
                constructors.append(model_syntax_symbol_symbol.TypeConstructorBinding(model_syntax_symbol_symbol.GenericParamId(u32(index)), constructor.definition))
                replacements.append(model_syntax_type_annotation.named_type(constructor.name, [], span))
                if index > 0:
                    name += ", "
                name += constructor.name
                index += 1
                continue
        actual = type_annotation(definitions, argument, records, namespace)
        actuals.append(model_syntax_symbol_symbol.TypeBinding(model_syntax_symbol_symbol.GenericParamId(u32(index)), actual))
        replacements.append(model_syntax_type_annotation.named_type(type_name(actual, records), [], span))
        if index > 0:
            name += ", "
        name += type_name(actual, records)
        index += 1
    name += "]"
    for instance in definitions.record_instances:
        origin = instance.template
        if origin.package == template.definition.package and origin.module == template.definition.module and origin.declaration.value == template.definition.declaration.value:
            equal := len(instance.arguments) == len(actuals) and len(instance.constructors) == len(constructors) and len(instance.values) == len(values)
            index = 0
            for binding in instance.arguments:
                if equal:
                    equal = binding.parameter.index == actuals[index].parameter.index and binding.type_id.index == actuals[index].type_id.index
                index += 1
            index = 0
            for binding in instance.constructors:
                if equal:
                    other = constructors[index]
                    equal = binding.parameter.index == other.parameter.index and binding.definition.package == other.definition.package and binding.definition.module == other.definition.module and binding.definition.declaration.value == other.definition.declaration.value
                index += 1
            index = 0
            for supplied in instance.values:
                if equal:
                    equal = supplied.binding == values[index].binding and model_syntax_type_annotation.simple_type_name(supplied) == model_syntax_type_annotation.simple_type_name(values[index])
                index += 1
            if equal:
                return instance.type_id
    if len(records) >= 4096:
        return error(diagnostics.diagnostic_at("E000205", "record specialization limit exceeded", span))
    id := model_syntax_symbol_symbol.TypeId(u32(1000 + len(records)))
    representation := ""
    if template.name == "string" and len(actuals) == 1 and len(values) == 1:
        if int(actuals[0].type_id.index) in [108, 532]:
            representation = "String"
            if actuals[0].type_id.index == 108:
                for default in template.type_defaults:
                    if default.binding == values[0].binding and model_syntax_type_annotation.simple_type_name(default) == model_syntax_type_annotation.simple_type_name(values[0]):
                        id = model_syntax_primitive_declarations.string_type_id()
    position = len(records)
    record = model_syntax_function_function.RecordDeclaration(name, [], [], template.span, type_id=id, lookup=template.lookup, definition=template.definition, representation=representation, decorators=template.decorators, mlir=template.mlir)
    record.mlir = model_syntax_function_function.declared_mlir_binding(template.decorators, template.name)
    for argument_index in range(int(len(template.type_parameters))):
        if argument_index < len(actuals):
            record.mlir_arguments.append((template.type_parameters[argument_index], actuals[argument_index].type_id))
    for supplied in values:
        spelling ?= model_syntax_type_annotation.simple_type_name(supplied)
        if spelling == None:
            return error(diagnostics.diagnostic_at("E000205", "MLIR value parameter requires a resolved spelling", supplied.span))
        if spelling != None:
            record.mlir_parameters.append(model_syntax_type_mlir.MlirTypeParameter(supplied.binding, spelling))
    records.append(record)
    definitions.record_instances.append(RecordInstance(id, template.definition, actuals, constructors, values))
    fields: list[model_syntax_function_function.FunctionParameter] = []
    names: list[string] = []
    for field in template.fields:
        if field.name in names:
            return error(diagnostics.diagnostic_at("E000205", "duplicate field " + field.name, field.span))
        names.append(field.name)
        if field.variadic:
            if template.type_pack == "" or model_syntax_type_annotation.simple_type_name(field.annotation) != template.type_pack:
                return error(diagnostics.diagnostic_at("E000205", "expanded field must use the declared type pack", field.span))
            if field.default != None:
                return error(diagnostics.diagnostic_at("E000205", "expanded fields cannot have defaults", field.span))
            offset := 0
            for replacement in replacements[len(template.type_parameters) - 1:]:
                type_id = type_annotation(definitions, replacement, records, template.lookup)
                if type_id.index == 2:
                    return error(diagnostics.diagnostic_at("E000205", "unit cannot be stored in a record field", field.span))
                fields.append(model_syntax_function_function.FunctionParameter(field.name + "$" + string(offset), replacement, None, field.span, type_id=type_id, pack=field.name))
                offset += 1
            continue
        annotation = replace_annotation(field.annotation, template.type_parameters, replacements)
        type_id = type_annotation(definitions, annotation, records, template.lookup)
        if type_id.index == 2:
            return error(diagnostics.diagnostic_at("E000205", "unit cannot be stored in a record field", field.span))
        fields.append(model_syntax_function_function.FunctionParameter(field.name, annotation, field.default, field.span, type_id=type_id))
    record.fields = fields
    record.methods = template.methods
    traits: list[model_syntax_type_annotation.TypeAnnotation] = []
    for trait in template.traits:
        traits.append(replace_annotation(trait, template.type_parameters, replacements))
    record.traits = traits
    record.operators = template.operators
    records[position] = record
    return id



def record_instance(definitions: SemanticDefinitions, type_id: model_syntax_symbol_symbol.TypeId) -> RecordInstance | None:
    for instance in definitions.record_instances:
        if instance.type_id.index == type_id.index:
            return instance
    return None


# Defaults are written in the declaration's scope. Actual arguments continue
# to resolve in the caller's scope, including earlier arguments used by defaults.
def scoped_default(definitions: SemanticDefinitions, annotation: model_syntax_type_annotation.TypeAnnotation, namespace: string) -> model_syntax_type_annotation.TypeAnnotation:
    match annotation.kind:
        case Named:
            qualified := name
            alias ?= alias_named(definitions, name, namespace)
            if alias != None:
                qualified = alias.name
            record ?= record_template(definitions, name, namespace)
            if record != None:
                qualified = record.name
            nested: list[model_syntax_type_annotation.TypeAnnotation] = []
            for argument in arguments:
                nested.append(scoped_default(definitions, argument, namespace))
            return model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Named(qualified, nested), annotation.span, binding=annotation.binding)
        case _:
            return annotation


def scoped_defaults(definitions: SemanticDefinitions, defaults: list[model_syntax_type_annotation.TypeAnnotation], namespace: string) -> list[model_syntax_type_annotation.TypeAnnotation]:
    result: list[model_syntax_type_annotation.TypeAnnotation] = []
    for default in defaults:
        result.append(scoped_default(definitions, default, namespace))
    return result


# Value parameters retain literal spellings separately from type identities.
# Resolving an alias here lets one generic forward its capacity to another.
def value_argument(definitions: SemanticDefinitions, annotation: model_syntax_type_annotation.TypeAnnotation, namespace: string, active: list[string] = []) -> string:
    name := ""
    supplied ?= model_syntax_type_annotation.simple_type_name(annotation)
    if supplied != None:
        name = supplied
    numeric := name != ""
    for character in name.characters():
        if character < "0" or character > "9":
            numeric = false
    if numeric:
        return name
    if name in active:
        return ""
    alias ?= alias_named(definitions, name, namespace)
    if alias != None:
        target ?= alias.definition
        if target != None:
            path = active[:]
            path.append(name)
            return value_argument(definitions, target, alias.lookup, path)
    return ""


def record_position(records: list[model_syntax_function_function.RecordDeclaration], type_id: model_syntax_symbol_symbol.TypeId) -> int:
    position := 0
    for record in records:
        if record.type_id.index == type_id.index:
            return position
        position += 1
    throw Error("unknown record identity")


# Resolve inherited type annotations once in HIR. Lowering only sees the
# selected binding and concrete type arguments, with no trait-name cases.
def resolve_record_mlir(definitions: SemanticDefinitions, record: model_syntax_function_function.RecordDeclaration, records: list[model_syntax_function_function.RecordDeclaration]):
    direct ?= model_syntax_function_function.declared_mlir_binding(record.decorators, record.name)
    if direct != None:
        record.mlir = direct
        return
    if record.mlir != None:
        return
    selected: model_syntax_type_mlir.MlirTypeBinding | None = None
    selected_key := ""
    for annotation in record.traits:
        applied = trait_application(definitions, annotation, record.lookup)
        for inherited in inherited_traits(definitions, applied):
            binding ?= model_syntax_function_function.declared_mlir_binding(inherited.decorators, inherited.name)
            if binding == None:
                continue
            if binding != None:
                spelling := binding.spelling
                arguments: list[tuple[string, model_syntax_symbol_symbol.TypeId]] = []
                for index in range(int(len(inherited.type_parameters))):
                    name = inherited.type_parameters[index]
                    argument = type_annotation(definitions, inherited.arguments[index], records, inherited.lookup)
                    key = "trait_" + string(inherited.definition.declaration.value) + "_" + name + "_" + string(argument.index)
                    spelling = spelling.replace("{" + name + "}", "{" + key + "}")
                    arguments.append((key, argument))
                if selected != None and selected_key != spelling:
                    throw Error("conflicting inherited MLIR type bindings: " + record.name)
                if selected == None:
                    selected = model_syntax_type_mlir.MlirTypeBinding(spelling)
                    selected_key = spelling
                    for argument in arguments:
                        record.mlir_arguments.append(argument)
    record.mlir = selected
