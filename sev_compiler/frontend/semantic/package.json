{
  "package": {
    "name": "sev-compiler-semantic",
    "version": "0.1.0",
    "edition": "2026",
    "publish": true
  },
  "lib": {
    "name": "semantic",
    "path": "semantic/src/lib.sev"
  },
  "dependencies": {
    "parser": {
      "path": "../parser",
      "package": "sev-compiler-parser"
    },
    "lexer": {
      "path": "../lexer",
      "package": "sev-compiler-lexer"
    },
    "environment": {
      "path": "../../../library/system/environment",
      "package": "environment"
    },
    "process": {
      "path": "../../../library/system/process",
      "package": "process"
    },
    "time": {
      "path": "../../../library/core/time",
      "package": "time"
    },
    "diagnostics": {
      "path": "../../syntax/diagnostics",
      "package": "sev-compiler-diagnostics"
    },
    "source": {
      "path": "../source",
      "package": "sev-compiler-source"
    },
    "ownership": {
      "path": "../../mir/ownership",
      "package": "sev-compiler-mir-ownership"
    },
    "file": {
      "path": "../../../library/system/file",
      "package": "file"
    },
    "primitives": {
      "path": "../../syntax/primitive",
      "package": "sev-compiler-primitives"
    },
    "syntax": {
      "package": "sev-compiler-syntax",
      "path": "../../syntax"
    }
  },
  "build": {
    "generators": [
      "generate_body_codec.py"
    ]
  },
  "dev-dependencies": {
    "modules": {
      "path": "../modules",
      "package": "sev-compiler-modules"
    }
  }
}
