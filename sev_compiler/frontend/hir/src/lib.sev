import source
import universal
import "model/expression/mod.sev"
import "model/statement/mod.sev"

class HirId:
    index: u32


class BindingId:
    index: u32


class VariantId:
    index: u32


class InterfaceId:
    value: string


class FfiId:
    value: string


class AbiId:
    value: string


class SymbolId:
    value: string


class ProviderId:
    value: string


class ExternalCall:
    interface: InterfaceId
    symbol: SymbolId
    provider: ProviderId | None
    ffi: FfiId
    abi: AbiId


enum CallType:
    Severian
    External(call: ExternalCall)


class BoundaryModifier:
    name: string


class BoundaryType:
    type_id: universal.TypeId
    modifiers: list[BoundaryModifier]


class FunctionParameter:
    binding: BindingId
    name: string
    contract: BoundaryType


class FunctionDeclaration:
    id: universal.FunctionId
    definition: universal.DefId
    name: string
    type_parameters: list[universal.GenericParamId]
    parameters: list[FunctionParameter]
    result: BoundaryType
    compile_route: universal.CompileRoute
    call_type: CallType
    body: Block | None


enum TestMode:
    Property
    Benchmark
    Chaos
    Profile
    Compiler
    Integration


def test_mode_name(mode: TestMode) -> string:
    match mode:
        case Property: return "property"
        case Benchmark: return "bench"
        case Chaos: return "chaos"
        case Profile: return "profile"
        case Compiler: return "compiler"
        case Integration: return "integ"


enum TestStream:
    Stdout
    Stderr


enum TestExpectation:
    Contains(stream: TestStream, value: string)
    Equals(stream: TestStream, value: string)


class TestDeclaration:
    name: string
    modes: list[TestMode]
    function: universal.FunctionId
    expectations: list[TestExpectation]


class TypeDeclaration:
    id: universal.TypeId
    name: string
    interface: InterfaceId | None


class Module:
    bindings: list[Binding]
    initializer: Block
    functions: list[FunctionDeclaration]
    entry: universal.FunctionId | None
    tests: list[TestDeclaration]
    types: list[TypeDeclaration]


class Program:
    modules: list[Module]


def empty_module() -> Module:
    return Module([], empty_block(), [], None, [], [])


def empty_program() -> Program:
    return Program([])
