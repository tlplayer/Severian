import source
import universal

class Expression:
    id: HirId
    type_id: universal.TypeId
    kind: ExpressionKind
    span: source.Span


enum Callee:
    Direct(function: universal.DefId, substitution: universal.Substitution)
    FunctionValue(expression: HirId)
    Method(implementation: universal.DefId, receiver: HirId, substitution: universal.Substitution)
    Constructor(type_definition: universal.DefId, variant: VariantId | None)
    Intrinsic(operation: universal.OpId)


enum ExpressionKind:
    Literal(value: universal.LiteralValue)
    Binding(binding: BindingId)
    Function(definition: universal.DefId)
    Call(callee: Callee, arguments: list[Expression])
    Convert(operand: Expression, conversion: universal.ExpressionConversion)
    Unary(operator: universal.UnaryOperator, operand: Expression)
    Binary(operator: universal.BinaryOperator, left: Expression, right: Expression)
