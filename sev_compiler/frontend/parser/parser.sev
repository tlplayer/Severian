import "../../syntax/recognition.sev" as syntax
import "../../syntax/block/global.sev" as _global_grammar
import TokenStream from "../lexer/stream.sev"
import TokenTerm from "../../syntax/generic/token.sev"
import Lexeme from "../../syntax/generic/lexeme.sev"
import B from "../../syntax/generic/block.sev"
import GrammarMatch from "contract.sev"
import GrammarContext, match_contract, select_grammar from "sequence.sev"
import ProofResult from "../../syntax/constraint/model.sev"
import ResolvedGrammarNode from "../../syntax/grammar/resolution.sev"
import Diagnostic from "../../syntax/primitive/error/diagnostic.sev"
import ParserDiagnostic from "diagnostic.sev"
import Block, BlockFile, SourceBlockId, global_source_block from "../../syntax/block/block.sev"
import BlockGraph, BlockUnit, index_block_file from "../../hir/hir/src/dependencies.sev"
import SourceFile, Span, virtual_source from "../source/source.sev"
import Program, partition from "../../hir/hir/src/program.sev"


class TokenLine:
    tokens: list[TokenTerm]
    prefix: Lexeme


# A quoted token is atomic even when its lexeme contains line breaks.
# Structural line breaks and horizontal spacing retain their source windows.
def token_lines(input: TokenStream) -> list[TokenLine]:
    lines: list[TokenLine] = []
    terms: list[TokenTerm] := []
    prefix := ""
    start: u32 := 0
    for token in input.tokens:
        spelling = token.lexeme.text
        if token.kind == "NEWLINE" or spelling == "\n" or spelling == "\r\n":
            if len(terms) > 0:
                lines.append(TokenLine(terms, Lexeme(prefix, Span(input.source.source_id, start, start + u32(len(prefix))))))
            terms = []
            prefix = ""
            start = token.span.end
        elif token.kind == "COMMENT":
            continue
        elif token.kind == "INDENT" or token.kind == "SPACE" or spelling == " " or spelling == "\t" or spelling == "\r":
            if len(terms) == 0:
                prefix += spelling
        else:
            terms.append(token)
    if len(terms) > 0:
        lines.append(TokenLine(terms, Lexeme(prefix, Span(input.source.source_id, start, start + u32(len(prefix))))))
    return lines


def attach_node(node: ResolvedGrammarNode, owner: SourceBlockId, unit: int = 0):
    node.owner = owner
    node.owner_unit = unit
    for child in node.children:
        attach_node(child, owner, unit)


def parser(input: TokenStream, package: string = "", module: string = "") -> BlockGraph | list[Diagnostic]:
    root = global_source_block(input.source)
    root.context.identity = root.id
    file = BlockFile(input.source.path, input.source.source_id, [root])
    graph = BlockGraph()
    root_providers: list[syntax.RegisteredGrammar] = []
    root_context = GrammarContext(body=root)
    for label, grammar in syntax.registry(B):
        if len(grammar.sequence) == 0 and grammar.construct != None:
            proof = ProofResult.Proven if grammar.accepts == None else grammar.accepts([], root_context)
            if proof is Diagnostic:
                return [proof]
            if proof == ProofResult.Proven:
                root_providers.append(grammar)
    if len(root_providers) > 1:
        return [ParserDiagnostic("multiple grammars provide the global block", root.span, "parser.block")]
    provider: B := root
    if len(root_providers) == 1:
        constructed = root_providers[0].construct([], root_context)
        if constructed is Diagnostic:
            return [constructed]
        block = constructed.block()
        if block == None:
            return [ParserDiagnostic("global grammar did not construct a block", root.span, "parser.block")]
        provider = block
        provider.context = root.context
        provider.span = root.span
        provider.subblocks = root.subblocks
    providers: list[B] = [provider]
    root.implementation = provider
    ancestry: list[int] = [0]
    previous: dict[int, B] = {}
    pending: int | None := None
    for line in token_lines(input):
        parent_index := ancestry[-1]
        level = providers[parent_index].indentation_level(line.prefix)
        if level is Diagnostic:
            return [level]
        if pending != None:
            expected = providers[pending].body_indentation(int(len(ancestry)) - 1, line.prefix)
            if expected is Diagnostic:
                return [expected]
            ancestry.append(pending)
            pending = None
        else:
            if level >= len(ancestry):
                return [ParserDiagnostic("indentation has no owning block grammar", line.prefix.span, "parser.block")]
            while len(ancestry) > level + 1:
                ancestry.pop()
        parent_index = ancestry[-1]
        parent = providers[parent_index]
        for ancestor in ancestry:
            location = file.blocks[ancestor].span
            if location != None:
                location.end = line.tokens[-1].span.end
                file.blocks[ancestor].span = location
                providers[ancestor].span = location
        body = Block()
        context = GrammarContext(parent, body, previous[parent_index] if parent_index in previous else None)
        candidates = match_contract(line.tokens, None, context)
        if candidates is Diagnostic:
            return [candidates]
        complete: list[GrammarMatch] = []
        for candidate in candidates:
            if candidate.consumed <= 0 or candidate.consumed > len(line.tokens):
                return [ParserDiagnostic("grammar returned invalid token consumption", line.tokens[0].span, "parser.grammar")]
            if candidate.consumed == len(line.tokens):
                complete.append(candidate)
        if len(complete) == 0:
            return [ParserDiagnostic("no registered grammar resolves this token sequence", line.tokens[0].span, "parser.grammar")]
        selected = select_grammar(complete, line.tokens[0].span)
        if selected is Diagnostic:
            return [selected]
        resolved = selected.resolve()
        if resolved is Diagnostic:
            return [resolved]
        for node in resolved.nodes:
            value = node.value.block()
            if value != None:
                body.id = SourceBlockId(u32(len(file.blocks)))
                body.parent = file.blocks[parent_index].id
                body.context = value.context
                body.context.identity = body.id
                body.context.parent = body.parent
                body.implementation = value
                body.name = value.declaration_name
                if value.partition_with_parent:
                    enclosing = file.blocks[parent_index]
                    body.partition_owner = enclosing.partition_owner if enclosing.partition_owner != None else enclosing.id
                body.span = node.span
                body.syntax_name = node.declaration
                value.span = node.span
                value.context = body.context
                value.subblocks = body.subblocks
                file.blocks[parent_index].subblocks.append(body.id)
                file.blocks.append(body)
                providers.append(value)
                previous[parent_index] = value
                pending = int(body.id.index)
                attach_node(node, body.id)
            else:
                attach_node(node, file.blocks[parent_index].id)
            # Header results stay ordered in the enclosing block; captures keep
            # their selected owner and original source spans.
            file.blocks[parent_index].contents.append(len(graph.nodes))
            graph.nodes.append(node)
        graph.types.extend(resolved.types)
        graph.expressions.extend(resolved.expressions)
    if pending != None:
        return [ParserDiagnostic("block header requires an indented body", file.blocks[pending].span, "parser.block")]
    index_block_file(graph, BlockUnit(input.source.path, package, module, "", file))
    return graph


# The public source entry retains stage diagnostics and hands MIR HIR's modules.
def parse_source(input: SourceFile, package: string = "", module: string = "") -> Program | list[Diagnostic]:
    tokens = lexer(input)
    if tokens is list[Diagnostic]:
        return tokens
    graph = parser(tokens, package, module)
    if graph is list[Diagnostic]:
        return graph
    return partition(graph)


def format_blocks(input: BlockGraph) -> string:
    return input.print()


test "empty token stream produces a global HIR block":
    graph = parser(TokenStream(virtual_source("empty.sev", ""), []))
    assert(graph is BlockGraph)
    assert(len(graph.units) == 1)
    assert(len(graph.units[0].file.blocks) == 1)
    assert(graph.units[0].file.blocks[0].syntax_name == "global")


import lexer from "../lexer/tokenize.sev"
import "../../syntax/block/if.sev" as _if_grammar
import "../../syntax/primitive/bool/bool.sev" as _bool_grammar
import "../../syntax/primitive/char/char.sev" as _character_grammar
import "../../syntax/block/main.sev" as _main_grammar
import "../../syntax/sentence/return.sev" as _return_grammar
import Statement from "../../syntax/sentence/sentence.sev"


test "main with an integer return retains its body and type-owned capture":
    program = parse_source(virtual_source("main.sev", "def main():\n    return 0\n"), "example", "main")
    assert(program is Program)
    blocks = program.graph.units[0].file.blocks
    assert(len(blocks) == 2)
    assert(blocks[1].name == "main")
    assert(blocks[1].parent == blocks[0].id)
    assert(blocks[1].contents == [1])
    returned = program.graph.nodes[1]
    assert(returned.owner == blocks[1].id and returned.owner_unit == 0)
    assert(returned.value.read[Statement](returned.span) is Statement)
    assert(returned.children[0].span == Span(0, 23, 24))
    assert(returned.children[0].value.read[int](returned.children[0].span) == 0)


test "declared nested if blocks preserve concrete conditions and ownership":
    tokens = lexer(virtual_source("nested.sev", "if true:\n    if false:\n        true\n"))
    assert(tokens is TokenStream)
    graph = parser(tokens)
    assert(graph is BlockGraph)
    blocks = graph.units[0].file.blocks
    assert(len(blocks) == 3)
    assert(blocks[1].parent == blocks[0].id)
    assert(blocks[2].parent == blocks[1].id)
    assert(blocks[0].subblocks == [blocks[1].id])
    assert(blocks[1].subblocks == [blocks[2].id])
    assert(graph.nodes[0].children[0].value.read[bool](graph.nodes[0].children[0].span) == true)
    assert(graph.nodes[1].children[0].value.read[bool](graph.nodes[1].children[0].span) == false)
    assert(graph.nodes[2].value.read[bool](graph.nodes[2].span) == true)
    assert(graph.nodes[2].owner == blocks[2].id)
    assert(graph.nodes[2].span.start == 31)


test "a declared block rejects an absent or incorrectly indented body":
    missing = lexer(virtual_source("missing.sev", "if true:\n"))
    assert(missing is TokenStream)
    assert(parser(missing) is list[Diagnostic])
    malformed = lexer(virtual_source("indent.sev", "if true:\n  true\n"))
    assert(malformed is TokenStream)
    assert(parser(malformed) is list[Diagnostic])


test "block lines preserve indentation windows and quoted block markers":
    source = virtual_source("quoted-block.sev", "if true:\n    \"if false: # text\"\n")
    tokens = lexer(source)
    assert(tokens is TokenStream)
    lines = token_lines(tokens)
    assert(len(lines) == 2)
    assert(lines[0].prefix.text == "")
    assert(lines[1].prefix.text == "    ")
    assert(lines[1].prefix.span == Span(source.source_id, 9, 13))
    assert(len(lines[1].tokens) == 1)
    quoted = lines[1].tokens[0]
    assert(quoted.lexeme.text == "\"if false: # text\"")
    assert(quoted.span.source_id == source.source_id)
    assert(source.text[quoted.span.start:quoted.span.end] == quoted.lexeme.text)


test "tokenizer parser and HIR share blocks through module partitioning":
    program = parse_source(virtual_source("nested.sev", "if true:\n    if false:\n        true\n"), "example", "main")
    assert(program is Program)
    assert(len(program.modules) == 1)
    assert(program.modules[0].name == "main")
    assert(len(program.submodules) == 1)
    assert(len(program.submodules[0].blocks) == 3)
    blocks = program.graph.units[0].file.blocks
    assert(blocks[0].contents == [0])
    assert(blocks[1].contents == [1])
    assert(blocks[2].contents == [2])
    assert(blocks[1].implementation != None)
    for node in program.graph.nodes:
        assert(node.owner_unit == 0)


test "source to HIR keeps tokenizer and parser failures at their stage":
    lexical = parse_source(virtual_source("unterminated.sev", "\"unfinished"))
    assert(lexical is list[Diagnostic])
    assert(len(lexical) > 0)
    structural = parse_source(virtual_source("missing-body.sev", "if true:\n"))
    assert(structural is list[Diagnostic])
    assert(len(structural) > 0)


test "empty source to HIR retains its global block and requested module":
    program = parse_source(virtual_source("empty.sev", ""), "example", "main")
    assert(program is Program)
    assert(len(program.graph.units[0].file.blocks) == 1)
    assert(len(program.submodules) == 1)
    assert(len(program.modules) == 1)
    assert(program.modules[0].package == "example")
    assert(program.modules[0].name == "main")
