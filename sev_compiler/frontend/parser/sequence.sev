import ProofResult from "../../syntax/constraint/model.sev"
import GrammarMatch, GrammarResolution, GrammarValue from "contract.sev"
import TokenTerm from "../../syntax/generic/token.sev"
import B from "../../syntax/generic/block.sev"
import Block from "../../syntax/block/block.sev"
import T from "../../syntax/generic/type.sev"
import Span from "../source/source.sev"
import Diagnostic from "../../syntax/grammar/contracts.sev"
import LexicalDiagnostic from "../../syntax/error/diagnostic.sev"
import "../../syntax/recognition.sev" as syntax


class GrammarContext:
    parent: B | None = None
    body: B = Block()
    previous: B | None = None
    fields: dict[string, GrammarValue] = {}
    span: Span | None = None


class CapturedGrammar:
    name: string
    matches: list[GrammarMatch] = []


class SequenceState:
    cursor: int
    captures: list[CapturedGrammar]


def capture_one[T](captures: list[CapturedGrammar], index: int) -> T:
    values = capture_many[T](captures, index)
    if len(values) != 1:
        throw Error("capture requires exactly one value")
    return values[0]


def capture_many[T](captures: list[CapturedGrammar], index: int) -> list[T]:
    values: list[T] = []
    for selected in captures[index].matches:
        resolved = selected.cached
        if resolved == None:
            throw Error("capture value is pending selection")
        if resolved is Diagnostic:
            throw resolved
        if len(resolved.nodes) != 1:
            throw Error("capture requires one concrete result node")
        value = resolved.nodes[0].value
        extracted = value.read[T](resolved.nodes[0].span)
        if extracted is Diagnostic:
            throw extracted
        values.append(extracted)
    return values


# Every recursive call is keyed by declaration and source position. This rejects
# left recursion without preventing a consuming recursive grammar.
def match_sequence(input: list[TokenTerm], grammar: syntax.RegisteredGrammar, context: GrammarContext, active: list[string] = []) -> list[GrammarMatch] | Diagnostic:
    if len(input) == 0:
        return []
    if not (grammar.syntax is syntax.SyntaxDeclaration):
        return LexicalDiagnostic("sequence grammar requires a declaration identity", input[0].span, "parser.grammar")
    key = grammar.syntax.path + ":" + grammar.syntax.name + ":" + string(input[0].span.start)
    if key in active:
        return []
    stack = active + [key]
    states = [SequenceState(0, [])]
    capture_index := 0
    for field in grammar.sequence:
        following: list[SequenceState] = []
        match field:
            case Literal:
                for state in states:
                    if state.cursor < len(input) and input[state.cursor].lexeme.text == spelling:
                        following.append(SequenceState(state.cursor + 1, state.captures))
            case Capture:
                repeated = capture_index in grammar.repetitions
                for state in states:
                    frontier = [SequenceState(state.cursor, state.captures + [CapturedGrammar(name)])]
                    if repeated:
                        following.extend(frontier)
                    while len(frontier) > 0:
                        next_frontier: list[SequenceState] = []
                        for partial in frontier:
                            if partial.cursor >= len(input):
                                continue
                            candidates = match_contract(input[partial.cursor:], grammar.capture_types[capture_index], context, stack)
                            if candidates is Diagnostic:
                                return candidates
                            for candidate in candidates:
                                if candidate.consumed <= 0 or candidate.consumed > len(input) - partial.cursor:
                                    return LexicalDiagnostic("capture did not make bounded progress", input[partial.cursor].span, "parser.capture")
                                captures = partial.captures[:]
                                captures[-1] = CapturedGrammar(name, captures[-1].matches + [candidate])
                                next_frontier.append(SequenceState(partial.cursor + candidate.consumed, captures))
                        following.extend(next_frontier)
                        frontier = next_frontier if repeated else []
                capture_index += 1
        states = following
        if len(states) == 0:
            return []
    matches: list[GrammarMatch] = []
    for state in states:
        if state.cursor > 0:
            matches.append(sequence_candidate(grammar, state, context, input))
    return matches


def sequence_candidate(grammar: syntax.RegisteredGrammar, state: SequenceState, context: GrammarContext, input: list[TokenTerm]) -> GrammarMatch:
    span = Span(input[0].span.source, input[0].span.start, input[state.cursor - 1].span.end)
    return GrammarMatch(state.cursor, lambda: construct_sequence(grammar, state.captures, context, span), check=lambda: check_sequence(grammar, state.captures, context), captures=state.captures, identity=grammar.syntax.path + ":" + grammar.syntax.name + ":" + string(span.start) + ":" + string(span.end))


def construct_sequence(grammar: syntax.RegisteredGrammar, captures: list[CapturedGrammar], context: GrammarContext, span: Span) -> GrammarResolution | Diagnostic:
    admissible = check_sequence(grammar, captures, context)
    if admissible is Diagnostic:
        return admissible
    if admissible != ProofResult.Proven:
        return LexicalDiagnostic("selected grammar constraints are not established", span, "parser.constraint")
    if grammar.construct == None:
        return LexicalDiagnostic("grammar has no construction callable", span, "parser.construct")
    value = grammar.construct(captures, context)
    if value is Diagnostic:
        return value
    children: list[ResolvedGrammarNode] = []
    for capture in captures:
        for selected in capture.matches:
            resolved = selected.resolve()
            if resolved is Diagnostic:
                return resolved
            children.extend(resolved.nodes)
    return GrammarResolution(nodes=[ResolvedGrammarNode(value, span, grammar.syntax.name, children)])


import ResolvedGrammarNode from "../../syntax/grammar/resolution.sev"


def match_contract(input: list[TokenTerm], required: T | None, context: GrammarContext, active: list[string] = []) -> list[GrammarMatch] | Diagnostic:
    matches: list[GrammarMatch] = []
    for label, grammar in syntax.registry(required):
        if grammar.construct != None:
            candidates = match_sequence(input, grammar, context, active)
            if candidates is Diagnostic:
                return candidates
            matches.extend(candidates)
        elif grammar.match_tokens != None:
            selected = grammar.match_tokens(input)
            if selected is Diagnostic:
                return selected
            if selected != None:
                matches.append(selected)
    return matches


def match_declared_sentence(input: list[TokenTerm], label: string) -> GrammarMatch | None | Diagnostic:
    for declaration, grammar in syntax.registry():
        if declaration.name == label:
            matches = match_sequence(input, grammar, GrammarContext())
            if matches is Diagnostic:
                return matches
            if len(matches) == 0:
                return None
            return select_grammar(matches, input[0].span)
    return None


def context_value[T](value: B | None) -> T:
    if value is T:
        return value
    throw Error("grammar context does not implement the receiver field contract")


def captures_ready(captures: list[CapturedGrammar]) -> bool:
    for capture in captures:
        for candidate in capture.matches:
            if candidate.cached == None:
                return false
    return true


def check_sequence(grammar: syntax.RegisteredGrammar, captures: list[CapturedGrammar], context: GrammarContext) -> ProofResult | Diagnostic:
    if grammar.accepts == None:
        return ProofResult.Proven
    return grammar.accepts(captures, context)


def same_interpretation(left: GrammarMatch, right: GrammarMatch) -> bool:
    if left.identity != right.identity or left.consumed != right.consumed or len(left.captures) != len(right.captures):
        return false
    for index in range(len(left.captures)):
        first = left.captures[index]
        second = right.captures[index]
        if first.name != second.name or len(first.matches) != len(second.matches):
            return false
        for child in range(len(first.matches)):
            if not same_interpretation(first.matches[child], second.matches[child]):
                return false
    return true


# Captures can be evaluated before their parent only when every live parent
# agrees on that capture's interpretation. Competing child constructors never
# run just to see which enclosing predicate they might satisfy.
def select_grammar(candidates: list[GrammarMatch], span: Span) -> GrammarMatch | Diagnostic:
    live = candidates[:]
    while true:
        survivors: list[GrammarMatch] = []
        for candidate in live:
            proof = candidate.admissible()
            if proof is Diagnostic:
                return proof
            if proof != ProofResult.Refuted:
                duplicate := false
                for previous in survivors:
                    if same_interpretation(previous, candidate):
                        duplicate = true
                if not duplicate:
                    survivors.append(candidate)
        live = survivors
        if len(live) == 0:
            return LexicalDiagnostic("no grammar satisfies the supplied captures and constraints", span, "parser.select")
        progress := false
        for capture in live[0].captures:
            for child in capture.matches:
                if child.cached != None:
                    continue
                shared := true
                for alternative in live[1:]:
                    found := false
                    for other_capture in alternative.captures:
                        for other in other_capture.matches:
                            if same_interpretation(child, other):
                                found = true
                    if not found:
                        shared = false
                if shared:
                    selected = select_grammar([child], span)
                    if selected is Diagnostic:
                        return selected
                    value = selected.resolve()
                    if value is Diagnostic:
                        return value
                    for alternative in live:
                        for other_capture in alternative.captures:
                            for other in other_capture.matches:
                                if same_interpretation(child, other):
                                    other.cached = value
                                    other.selected = true
                    progress = true
        if progress:
            continue
        if len(live) != 1:
            return LexicalDiagnostic("multiple grammar interpretations remain admissible", span, "parser.select")
        proof = live[0].admissible()
        if proof is Diagnostic:
            return proof
        if proof != ProofResult.Proven:
            return LexicalDiagnostic("grammar constraints require unresolved capture or context facts", span, "parser.constraint")
        live[0].selected = true
        return live[0]


def context_field[T](context: GrammarContext, name: string) -> T:
    if name == "parent":
        return context_value[T](context.parent)
    if name == "body":
        return context_value[T](context.body)
    if name == "previous":
        return context_value[T](context.previous)
    if name in context.fields:
        # The caller retains the original diagnostic on a failed typed read.
        value = context.fields[name].read[T](context.span)
        if value is Diagnostic:
            throw value
        return value
    throw Error("grammar receiver field is not available in this context: " + name)
