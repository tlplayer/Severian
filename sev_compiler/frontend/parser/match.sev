import ResolvedGrammarNode from "../../syntax/grammar/resolution.sev"
import SyntaxDeclaration from "../../syntax/recognition.sev"
import virtual_source from "../source/source.sev"
import Token, TokenTerm from "../../syntax/generic/token.sev"
import Lexeme from "../../syntax/generic/lexeme.sev"
import Span from "../source/source.sev"
import Diagnostic from "../../syntax/primitive/error/diagnostic.sev"
import ParserDiagnostic from "diagnostic.sev"
import GrammarMatch, GrammarResolution, LiteralValue from "contract.sev"
import Block from "../../syntax/block/block.sev"
import TypeDeclaration from "../../syntax/function/syntax.sev"
import Expression from "../../syntax/function/function.sev"
import GrammarContext from "sequence.sev"
import ProofResult from "../../syntax/constraint/model.sev"
import LiteralValueOf from "../../syntax/grammar/resolution.sev"
import context_receiver, context_receiver_state, select_grammar from "sequence.sev"


# The token already carries declaration identity and the original lexeme.
# Construction runs only after the parser selects a unique grammar.
def match_declared_token(input: list[TokenTerm], label: string, construct: (Lexeme) -> LiteralValue, prefix: string = "", suffix: string = "", captured: bool = false) -> GrammarMatch | None | Diagnostic:
    if len(input) == 0:
        return None
    token = input[0]
    if not (token is Token) or label not in token.declarations:
        return None

    spelling = token.lexeme
    if captured:
        start = u32(len(prefix))
        end = u32(len(spelling.text) - len(suffix))
        if start > end:
            return ParserDiagnostic("capture escaped its token", token.span, "parser.capture")
        spelling = Lexeme(spelling.text[start:end], Span(token.span.source_id, token.span.start + start, token.span.start + end))

    return GrammarMatch(1, lambda: finish_declared_token(construct, spelling, token.span, label), identity=label + ":" + string(token.span.start) + ":" + string(token.span.end))


def finish_declared_token(construct: (Lexeme) -> LiteralValue, spelling: Lexeme, span: Span, label: string) -> GrammarResolution | Diagnostic:
    value = construct(spelling)
    node = ResolvedGrammarNode(value, span, label)
    return GrammarResolution(nodes=[node])


def match_contextual_token(input: list[TokenTerm], label: string, context: GrammarContext, accepts: (Lexeme, GrammarContext) -> ProofResult, construct: (Lexeme, GrammarContext) -> LiteralValue | Diagnostic, prefix: string = "", suffix: string = "", captured: bool = false) -> GrammarMatch | None | Diagnostic:
    if len(input) == 0:
        return None
    token = input[0]
    if token.span.end <= token.span.start:
        return None
    spelling = token.lexeme
    if not spelling.text.starts_with(prefix) or not spelling.text.ends_with(suffix):
        return None
    if captured:
        start = u32(len(prefix))
        end = u32(len(spelling.text) - len(suffix))
        if start > end:
            return None
        spelling = Lexeme(spelling.text[start:end], Span(token.span.source_id, token.span.start + start, token.span.start + end))
    elif spelling.text != prefix + suffix:
        return None
    return GrammarMatch(1, lambda: finish_contextual_token(accepts, construct, spelling, context, token.span, label), check=lambda: accepts(spelling, context), identity=label + ":" + string(token.span.start) + ":" + string(token.span.end))


def finish_contextual_token(accepts: (Lexeme, GrammarContext) -> ProofResult, construct: (Lexeme, GrammarContext) -> LiteralValue | Diagnostic, spelling: Lexeme, context: GrammarContext, span: Span, label: string) -> GrammarResolution | Diagnostic:
    if accepts(spelling, context) != ProofResult.Proven:
        return ParserDiagnostic("selected grammar receiver and constraints are not established", span, "parser.constraint")
    value = construct(spelling, context)
    if value is Diagnostic:
        return value
    return GrammarResolution(nodes=[ResolvedGrammarNode(value, span, label)])


class ContextualMatcherFixture:
    spelling: string
    constructions: int = 0


def contextual_matcher_accept(value: Lexeme, context: GrammarContext) -> ProofResult:
    state = context_receiver_state[ContextualMatcherFixture](context)
    if state != ProofResult.Proven:
        return state
    receiver = context_receiver[ContextualMatcherFixture](context)
    return ProofResult.Proven if value.text == receiver.spelling else ProofResult.Refuted


def contextual_matcher_construct(value: Lexeme, context: GrammarContext) -> LiteralValue | Diagnostic:
    receiver = context_receiver[ContextualMatcherFixture](context)
    receiver.constructions += 1
    return LiteralValueOf[string](value.text)


test "contextual token grammar preserves boundaries and constructs only after selection":
    source = virtual_source("receiver.sev", "[λ]next")
    span = Span(source.id, 0, 3)
    token = Token("fixture", Lexeme("[λ]", span), span)
    next_span = Span(source.id, 3, 7)
    following = Token("identifier", Lexeme("next", next_span), next_span)
    receiver = ContextualMatcherFixture("λ")
    context = GrammarContext(receiver=LiteralValueOf[ContextualMatcherFixture](receiver))
    matched = match_contextual_token([token, following], "Fixture.value", context, contextual_matcher_accept, contextual_matcher_construct, "[", "]", true)
    assert(matched is GrammarMatch)
    assert(matched.consumed == 1)
    assert(matched.admissible() == ProofResult.Proven)
    assert(receiver.constructions == 0)
    selected = select_grammar([matched], span)
    assert(selected is GrammarMatch)
    assert(receiver.constructions == 0)
    result = selected.resolve()
    assert(result is GrammarResolution)
    assert(result.nodes[0].value.read[string](span) == "λ")
    assert(result.nodes[0].span == span)
    assert(receiver.constructions == 1)
    selected.resolve()
    assert(receiver.constructions == 1)


test "contextual token grammar does not select missing or incompatible receivers":
    source = virtual_source("receiver.sev", "x")
    span = Span(source.id, 0, 1)
    token = Token("identifier", Lexeme("x", span), span)
    context = GrammarContext()
    matched = match_contextual_token([token], "Fixture.value", context, contextual_matcher_accept, contextual_matcher_construct, captured=true)
    assert(matched is GrammarMatch)
    assert(matched.admissible() == ProofResult.Unknown)
    assert(select_grammar([matched], span) is Diagnostic)
    context.receiver = LiteralValueOf[string]("wrong receiver")
    assert(matched.admissible() == ProofResult.Refuted)
    assert(select_grammar([matched], span) is Diagnostic)
    assert(match_contextual_token([token], "Fixture.fixed", context, contextual_matcher_accept, contextual_matcher_construct, "@@") == None)
    assert(match_contextual_token([], "Fixture.value", context, contextual_matcher_accept, contextual_matcher_construct, captured=true) == None)
    end = Span(source.id, 1, 1)
    assert(match_contextual_token([Token("EOF", Lexeme("", end), end)], "Fixture.value", context, contextual_matcher_accept, contextual_matcher_construct, captured=true) == None)


def matcher_test_construct(value: Lexeme) -> LiteralValue:
    return LiteralValueOf[bool](value.text == "true")


test "competing literal grammars report ambiguity without constructing either result":
    source = virtual_source("conflict.sev", "0")
    span = Span(source.id, 0, 1)
    token = Token("literal", Lexeme("0", span), span)
    receiver = ContextualMatcherFixture("0")
    context = GrammarContext(receiver=LiteralValueOf[ContextualMatcherFixture](receiver))
    first = match_contextual_token([token], "First.literal", context, contextual_matcher_accept, contextual_matcher_construct, captured=true)
    second = match_contextual_token([token], "Second.literal", context, contextual_matcher_accept, contextual_matcher_construct, captured=true)
    assert(first is GrammarMatch)
    assert(second is GrammarMatch)
    assert(select_grammar([first, second], span) is Diagnostic)
    assert(select_grammar([second, first], span) is Diagnostic)
    assert(receiver.constructions == 0)


test "token matching preserves concrete values":
    source = virtual_source("literal.sev", "true")
    span = Span(source.id, 0, 4)
    label = SyntaxDeclaration("fixture.sev", "Bool.true")
    token = Token("Bool.true", Lexeme("true", span), span, ["Bool.true"])
    matched = match_declared_token([token], label.name, matcher_test_construct)
    assert(matched is GrammarMatch)
    selected = select_grammar([matched], span)
    assert(selected is GrammarMatch)
    result = selected.resolve()
    assert(result is GrammarResolution)
    assert(result.nodes[0].value.read[bool](span) == true)
    assert(result.nodes[0].span == span)
    assert(match_declared_token([], label.name, matcher_test_construct) == None)
