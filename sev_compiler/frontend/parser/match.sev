import ResolvedGrammarNode from "../../syntax/grammar/resolution.sev"
import SyntaxDeclaration from "../../syntax/recognition.sev"
import virtual_source from "../source/source.sev"
import Token, TokenTerm from "../../syntax/generic/token.sev"
import Lexeme from "../../syntax/generic/lexeme.sev"
import Span from "../source/source.sev"
import Diagnostic from "../../syntax/primitive/error/diagnostic.sev"
import LexicalDiagnostic from "../../syntax/error/diagnostic.sev"
import GrammarMatch, GrammarResolution, GrammarValue from "contract.sev"
import Block from "../../syntax/block/block.sev"
import TypeDeclaration from "../../syntax/function/syntax.sev"
import Expression from "../../syntax/function/function.sev"


# The token already carries declaration identity and the original lexeme.
# Construction runs only after the parser selects a unique grammar.
def match_declared_token(input: list[TokenTerm], label: string, construct: (Lexeme) -> GrammarValue, prefix: string = "", suffix: string = "", captured: bool = false) -> GrammarMatch | None | Diagnostic:
    if len(input) == 0:
        return None
    token = input[0]
    if not (token is Token) or label not in token.declarations:
        return None

    spelling = token.lexeme
    if captured:
        start = u32(len(prefix))
        end = u32(len(spelling.text) - len(suffix))
        if start > end:
            return LexicalDiagnostic("capture escaped its token", token.span, "parser.capture")
        spelling = Lexeme(spelling.text[start:end], Span(token.span.source, token.span.start + start, token.span.start + end))

    return GrammarMatch(1, lambda: finish_declared_token(construct, spelling, token.span, label), identity=label + ":" + string(token.span.start) + ":" + string(token.span.end))


def finish_declared_token(construct: (Lexeme) -> GrammarValue, spelling: Lexeme, span: Span, label: string) -> GrammarResolution | Diagnostic:
    value = construct(spelling)
    node = ResolvedGrammarNode(value, span, label)
    return GrammarResolution(nodes=[node])


def matcher_test_construct(value: Lexeme) -> bool:
    return value.text == "true"


test "token matching preserves concrete values":
    source = virtual_source("literal.sev", "true")
    span = Span(source.id, 0, 4)
    label = SyntaxDeclaration("fixture.sev", "Bool.true")
    token = Token("Bool.true", Lexeme("true", span), span, ["Bool.true"])
    matched = match_declared_token([token], label.name, matcher_test_construct)
    assert(matched is GrammarMatch)
    result = matched.construct()
    assert(result is GrammarResolution)
    assert(result.nodes[0].value == true)
    assert(result.nodes[0].span == span)
    assert(match_declared_token([], label.name, matcher_test_construct) == None)
