tive, Power, Primitive, PrimitiveAlias, PrimitiveCategory, PrimitiveId, PrimitiveRepresentation, Projection, ProofResult, PropertyDeclaration, ProviderId, QualityRegion, RecordDeclaration, RegionId, RegisteredOperation, Remainder, ResolvedCallee, RightShift, RuntimeId, Rvalue, ScalarOperation, ScopeId, SemanticObject, Sentence, SentenceDefinition, SentenceField, SentenceId, SentenceMatch, Signature, Size, SourceBlockId, SourceFile, SourceId, SourceMap, Span, StableId, Statement, Substitution, Subtract, SwitchCase, Symbol, SymbolId, SymbolKind, SymbolName, Term, TermRole, TestCaseRow, TestDeclaration, TestExpectation, TestMode, TestModeArguments, TestStream, TokenTerm, TraitDeclaration, TraitRef, TyInterner, Type, TypeAnnotation, TypeAnnotationKind, TypeBinding, TypeConstraint, TypeConstructorBinding, TypeDeclaration, TypeId, TypeKind, TypePattern, TypeRef, UnaryOperation, UnaryOperator, UnifyError, ValueId, VariantId, WithAttachment, Y, accepts_shape, allocate_effect, annotation_key, array_mlir, attribute_id, backend_id, byte_view_mlir, callable_key, cfg_blocks, control_flow, declared_mlir_binding, definition_from_key, dialect_id, empty_cfg, free_effect, hashing, index_mlir, insert_type, io_effect, iteration_sentences, load, local_place, match_sentence, memref_mlir, named_definition, named_operation, named_type, no_effects, operation_id, operator_syntax, outcome_variants, provider_id, ranked_memref_storage, read_effect, record_mlir_binding, resolve_expression, resolve_sentence, resolved_function, runtime_id, same_constructor, same_definition, same_parameters, scalar_boundary, scalar_mlir, scalar_operand_segments, scalar_requirement_names, scalar_requirements, semantic_digest, semantic_key, simple_type_name, source_id, span, standard_block_syntax, struct_mlir, tensor_mlir, test_mode_name, throw_effect, type_children, union_variants, unranked_memref_mlir, unranked_tensor_mlir, utf8_offset, virtual_source, write_effect from "package:syntax/block/block.sev"


# This pass consumes source structure only. Primitive values, callable bodies,
# imports and prelude providers are resolved after block discovery.
def classify_block(sentence: BlockSentence, syntaxes: list[BlockSyntax]) -> BlockSyntax | None:
    return resolve_block_syntax(sentence, syntaxes)


def block_sentence(terms: list[BlockTerm], ordinal: int) -> BlockSentence:
    return BlockSentence(SentenceId(u32(ordinal)), source.Span(terms[0].span.source, terms[0].span.start, terms[-1].span.end), terms)


def append_block_sentence(file: BlockFile, owner: SourceBlockId, terms: list[BlockTerm]) -> BlockSentence:
    sentence = block_sentence(terms, int(file.next_sentence))
    file.next_sentence += 1
    file.blocks[owner.index].sentences.append(sentence)
    return sentence


def open_source_block(file: BlockFile, parent: SourceBlockId, header: BlockSentence, syntaxes: list[BlockSyntax]) -> SourceBlockId:
    block = declared_source_block(file, parent, header, syntaxes)
    block.context.identity = block.id
    block.context.parent = parent
    owner = file.blocks[parent.index]
    if len(owner.subblocks) > 0 and len(owner.sentences) >= 2:
        previous = file.blocks[owner.subblocks[-1].index]
        previous_header ?= previous.header
        if previous_header != None and previous_header.id == owner.sentences[-2].id:
            block.previous = previous.id
    file.blocks.append(block)
    file.blocks[parent.index].subblocks.append(block.id)
    return block.id



# Bodyless declarations still introduce blocks. A sentence with an indented
# body is consumed by open_source_block instead, so it gets exactly one identity.
def finish_source_header(file: BlockFile, owner: SourceBlockId, header: BlockSentence | None, syntaxes: list[BlockSyntax]):
    sentence ?= header
    if sentence != None:
        syntax ?= classify_block(sentence, syntaxes)
        if syntax != None and syntax.bodyless:
            open_source_block(file, owner, sentence, syntaxes)


def close_source_block(file: BlockFile, id: SourceBlockId, end: u32):
    span ?= file.blocks[id.index].span
    if span != None:
        file.blocks[id.index].span = source.Span(span.source, span.start, end)


def parse_blocks(file: source.SourceFile, syntaxes: list[BlockSyntax], rules: list[lexer.SourceLexicalRule] = [], providers: list[RecordDeclaration] = [], registered_tokens: list[lexer.Token] = [], sources: list[source.SourceFile] = [], defer: bool = false) -> BlockFile | diagnostics.Diagnostic:
    root = global_source_block(file)
    root.context.identity = root.id
    result = BlockFile(file.path, file.id, [root])
    owners = [SourceBlockId(0)]
    # False entries describe indentation inside a continued expression.
    indentation: list[bool] = []
    delimiters: list[string] = []
    terms: list[BlockTerm] = []
    pending: BlockSentence | None := None
    tokens = registered_tokens if len(registered_tokens) > 0 else lexer.scan_bootstrap(file, rules)
    for token in tokens:
        if token.kind == "Indent":
            structural = len(delimiters) == 0
            indentation.append(structural)
            if structural:
                header ?= pending
                if header == None:
                    return error(diagnostics.diagnostic_at("E000102", "block indentation has no introducing sentence", token.span))
                owners.append(open_source_block(result, owners[-1], header, syntaxes))
                pending = None
            continue
        if token.kind == "Dedent":
            finish_source_header(result, owners[-1], pending, syntaxes)
            pending = None
            if len(indentation) == 0:
                return error(diagnostics.diagnostic_at("E000102", "block dedent has no enclosing indentation", token.span))
            if indentation.pop():
                if len(terms) > 0:
                    tail = append_block_sentence(result, owners[-1], terms)
                    finish_source_header(result, owners[-1], tail, syntaxes)
                    terms = []
                close_source_block(result, owners.pop(), token.span.start)
                pending = None
            continue
        if token.kind == "Newline" or token.kind == "Eof":
            if len(delimiters) != 0:
                if token.kind == "Eof":
                    return error(diagnostics.diagnostic_at("E000102", "unclosed delimiter in block sentence", token.span))
                continue
            if len(terms) > 0:
                pending = append_block_sentence(result, owners[-1], terms)
                terms = []
            continue
        if len(terms) == 0:
            finish_source_header(result, owners[-1], pending, syntaxes)
            pending = None
        role := BlockTermRole.Opaque
        spelling = token.lexeme.text
        if token.kind == "Identifier":
            role = BlockTermRole.Name
        elif token.kind == "Symbol":
            role = BlockTermRole.Symbol
            if spelling in ["(", "[", "{"]:
                delimiters.append(")" if spelling == "(" else "]" if spelling == "[" else "}")
            elif spelling in [")", "]", "}"]:
                if len(delimiters) == 0 or delimiters[-1] != spelling:
                    return error(diagnostics.diagnostic_at("E000102", "mismatched delimiter in block sentence", token.span))
                delimiters.pop()
        terms.append(BlockTerm(spelling, token.span, role))
    finish_source_header(result, owners[-1], pending, syntaxes)
    while len(owners) > 1:
        close_source_block(result, owners.pop(), u32(len(file.characters)))
    resolve_provider_blocks(result, tokens, providers, sources, defer)
    return result


def format_blocks(file: BlockFile) -> string:
    lines: list[string] = []
    for block in file.blocks:
        depth := 0
        ancestor := block
        while true:
            parent ?= ancestor.parent
            if parent == None:
                break
            depth += 1
            ancestor = file.blocks[parent.index]
        indentation := ""
        for level in range(depth):
            indentation += "  "
        kind = block.syntax_name if block.syntax_name != "" else "lexical"
        name = " " + block.name if block.name != "" else ""
        span ?= block.span
        location := ""
        if span != None:
            location = " [" + string(span.start) + ":" + string(span.end) + "]"
        lines.append(indentation + kind + name + location + " sentences=" + string(len(block.sentences)) + " subblocks=" + string(len(block.subblocks)))
    return lines.join("\n")


test "block discovery preserves nesting without constructing primitive values":
    file = source.virtual_source("blocks.sev", "def outer():\n    while ready:\n        use(\"a:b\")\n    finish()\n")
    blocks = parse_blocks(file, standard_block_syntax())
    assert(len(blocks.blocks) == 3)
    assert(blocks.blocks[1].syntax_name == "function")
    assert(blocks.blocks[1].name == "outer")
    assert(blocks.blocks[2].syntax_name == "while")
    assert(len(blocks.blocks[1].sentences) == 2)
    assert(len(blocks.blocks[2].sentences) == 1)
    assert(blocks.blocks[2].sentences[0].terms[2].role == BlockTermRole.Opaque)


test "block kinds are supplied by syntax declarations":
    file = source.virtual_source("custom.sev", "widget Panel:\n    value\n")
    blocks = parse_blocks(file, [BlockSyntax("widget", ["widget"], BlockKind.Class, 1)])
    assert(blocks.blocks[1].syntax_name == "widget")
    assert(blocks.blocks[1].name == "Panel")


test "bodyless declarations are indexed as blocks":
    file = source.virtual_source("external.sev", "def foreign(value: int) -> int")
    blocks = parse_blocks(file, standard_block_syntax())
    assert(len(blocks.blocks) == 2)
    assert(blocks.blocks[1].name == "foreign")
    assert(len(blocks.blocks[1].sentences) == 0)


test "continued expressions do not introduce indentation blocks":
    file = source.virtual_source("continued.sev", "def outer():\n    use(\n        value,\n    )\n    finish()\n")
    blocks = parse_blocks(file, standard_block_syntax())
    assert(len(blocks.blocks) == 2)
    assert(len(blocks.blocks[1].sentences) == 2)


test "control blocks preserve their kinds and containment":
    file = source.virtual_source("control.sev", "if ready:\n    match value:\n        case Ready:\n            use(value)\nelse:\n    while waiting:\n        wait()\n")
    blocks = parse_blocks(file, standard_block_syntax())
    assert(len(blocks.blocks) == 6)
    assert(blocks.blocks[1].kind == BlockKind.If)
    assert(blocks.blocks[2].kind == BlockKind.Match)
    assert(blocks.blocks[3].kind == BlockKind.Case)
    assert(blocks.blocks[4].kind == BlockKind.Else)
    assert(blocks.blocks[5].kind == BlockKind.While)
    assert(blocks.blocks[2].parent == blocks.blocks[1].id)


test "control headers without bodies do not create declaration blocks":
    file = source.virtual_source("header.sev", "if ready\n")
    blocks = parse_blocks(file, standard_block_syntax())
    assert(len(blocks.blocks) == 1)


def block_provider_fixture(name: string, spelling: string) -> RecordDeclaration:
    definition = source.virtual_source(name + ".sev", "class " + name + ": Y + B\n    values: list[bool] = []\n    context: BlockContext = BlockContext()\n    span: Span | None = None\n    sentences: list[BlockSentence] = []\n    subblocks: list[SourceBlockId] = []\n    parent: B\n    sentence construct[\"" + spelling + "\", values...: bool, \":\"]() -> B with len(values) > 0:\n        self.values = values\n        return self\n")
    parsed = parser_module(Parser(lexer.scan_bootstrap(definition)))
    match parsed.items[0]:
        case Record:
            return declaration
        case _:
            throw Error("expected block provider fixture")


test "source windows retain selected provider and constructed typed fields":
    provider = block_provider_fixture("Custom", "custom")
    file = source.virtual_source("consumer.sev", "custom true:\n    finish()\n")
    blocks = parse_blocks(file, [], providers=[provider])
    assert(len(blocks.blocks) == 2)
    block = blocks.blocks[1]
    assert(block.syntax_name == "Custom")
    assert(block.context.provider != None and block.context.constructor != None)
    assert(len(block.context.values) == 1 and len(block.context.fields) == 1)
    assert(block.context.fields[0].name == "values")
    assert(len(block.context.values[0].expressions) == 1)
    assert(block.context.values[0].spans[0].start == 7)


test "block provider overlap is diagnosed before constructing either body":
    file = source.virtual_source("ambiguous.sev", "custom true:\n    finish()\n")
    first = block_provider_fixture("First", "custom")
    second = block_provider_fixture("Second", "custom")
    result ?= parse_blocks(file, [], providers=[first, second])
    assert(result is diagnostics.Diagnostic)


test "selected block constructor failure is not a dispatch retry":
    file = source.virtual_source("failed-constructor.sev", "custom true:\n    finish()\n")
    provider = block_provider_fixture("Broken", "custom")
    provider.sentences[0].body = Block()
    result ?= parse_blocks(file, [], providers=[provider])
    assert(result is diagnostics.Diagnostic)


test "block constructors execute locals and branches through the shared interpreter":
    provider = block_provider_fixture("Conditional", "custom")
    original ?= provider.sentences[0].body
    assert(original != None)
    if original != None:
        condition = Expression(ExpressionKind.LiteralValue(LiteralValue.BooleanValue(true)), provider.span)
        provider.sentences[0].body = Block([Statement.If(condition, original, Block(), provider.span)])
        file = source.virtual_source("conditional-constructor.sev", "custom true:\n    finish()\n")
        blocks = parse_blocks(file, [], providers=[provider])
        assert(len(blocks.blocks[1].context.fields) == 1)


test "source capture parsing keeps wide integer spelling":
    provider = block_provider_fixture("Wide", "custom")
    provider.sentences[0].parameters[0].annotation = named_type("u128", [], provider.span)
    file = source.virtual_source("wide-capture.sev", "custom 340282366920938463463374607431768211455:\n    finish()\n")
    blocks = parse_blocks(file, [], providers=[provider])
    expression = blocks.blocks[1].context.values[0].expressions[0]
    match expression.kind:
        case LiteralValue:
            match value:
                case IntegerValue:
                    assert(spelling == "340282366920938463463374607431768211455")
                case _:
                    assert(false)
        case _:
            assert(false)


test "parsed callable and nested bodies retain discovered block identities":
    file = source.virtual_source("owned-bodies.sev", "def main():\n    if true:\n        return\n")
    blocks = parse_blocks(file, standard_block_syntax())
    parsed = parser_module(Parser(lexer.scan_bootstrap(file), source_blocks=blocks))
    assert(len(parsed.source_blocks) == 1)
    match parsed.items[0]:
        case Function:
            body ?= declaration.body
            assert(body != None)
            if body != None:
                assert(body.id == blocks.blocks[1].id)
                assert(body.header != None)
                match body.statements[0]:
                    case If:
                        assert(then_block.id == blocks.blocks[2].id)
                        assert(then_block.parent == body.id)
                        assert(then_block.header != None)
                    case _:
                        assert(false)
        case _:
            assert(false)


test "deferred provider selection constructs the discovered block through shared dispatch":
    provider = block_provider_fixture("Custom", "custom")
    file = source.virtual_source("deferred.sev", "custom true:\n    finish()\n")
    blocks = parse_blocks(file, [], providers=[provider], defer=true)
    body = blocks.blocks[1]
    assert(body.context.constructor == None)
    assert(len(body.context.fields) == 0)
    finish_provider_block(blocks, body, ParsedBlockCaptures(), [])
    selected = blocks.blocks[1]
    assert(selected.id == body.id and selected.parent == body.parent)
    assert(selected.header == body.header and selected.span == body.span)
    assert(selected.context.constructor != None)
    assert(selected.syntax_name == "Custom")
    assert(len(selected.context.fields) == 1)
    assert(selected.context.fields[0].name == "values")
    assert(len(selected.context.fields[0].value.expressions) == 1)


test "deferred provider ambiguity never executes a constructor":
    file = source.virtual_source("deferred-ambiguous.sev", "custom true:\n    finish()\n")
    first = block_provider_fixture("First", "custom")
    second = block_provider_fixture("Second", "custom")
    blocks = parse_blocks(file, [], providers=[first, second], defer=true)
    result ?= finish_provider_block(blocks, blocks.blocks[1], ParsedBlockCaptures(), [])
    assert(result is diagnostics.Diagnostic)
    assert(blocks.blocks[1].context.constructor == None)
    assert(len(blocks.blocks[1].context.fields) == 0)


test "deferred selected constructor failure remains a diagnostic":
    file = source.virtual_source("deferred-failed.sev", "custom true:\n    finish()\n")
    provider = block_provider_fixture("Broken", "custom")
    provider.sentences[0].body = Block()
    blocks = parse_blocks(file, [], providers=[provider], defer=true)
    result ?= finish_provider_block(blocks, blocks.blocks[1], ParsedBlockCaptures(), [])
    assert(result is diagnostics.Diagnostic)


test "provider branch headers use declared repeated captures":
    provider = block_provider_fixture("Conditional", "if")
    file = source.virtual_source("declared-branch.sev", "def main():\n    if true, false:\n        return\n")
    tokens = lexer.scan_bootstrap(file)
    blocks = parse_blocks(file, standard_block_syntax(), providers=[provider], registered_tokens=tokens, defer=true)
    parsed = parser_module(Parser(tokens, source_blocks=blocks))
    match parsed.items[0]:
        case Function:
            body ?= declaration.body
            assert(body != None)
            if body != None:
                match body.statements[0]:
                    case If:
                        assert(then_block.id == blocks.blocks[2].id)
                        assert(len(then_block.context.candidates) == 1)
                        assert(len(then_block.context.candidates[0].captures[0].expressions) == 2)
                        match condition.kind:
                            case Conditional:
                                assert(true)
                            case _:
                                assert(false)
                    case _:
                        assert(false)
        case _:
            assert(false)


test "owned body selects its introducing sentence before nested bodies":
    file = source.virtual_source("nested-owners.sev", "def main():\n    if true:\n        if false:\n            return\n    return\n")
    tokens = lexer.scan_bootstrap(file)
    blocks = parse_blocks(file, standard_block_syntax(), registered_tokens=tokens)
    parsed = parser_module(Parser(tokens, source_blocks=blocks))
    match parsed.items[0]:
        case Function:
            body ?= declaration.body
            assert(body != None)
            if body != None:
                assert(body.id == blocks.blocks[1].id)
                assert(len(body.statements) == 2)
                match body.statements[0]:
                    case If:
                        assert(then_block.id == blocks.blocks[2].id)
                        assert(len(then_block.statements) == 1)
                    case _:
                        assert(false)
        case _:
            assert(false)
