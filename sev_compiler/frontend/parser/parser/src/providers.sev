import lexer
import source
import diagnostics
import Block, BlockFile, BlockSentence, SourceBlockId from "package:syntax/block/block.sev"
import BlockCaptureValue, BlockFieldValue, BlockProviderCandidate from "package:syntax/generic/block.sev"
import RecordDeclaration, FunctionDeclaration, FunctionParameter from "package:syntax/function/function.sev"
import TypeAnnotation, named_type, simple_type_name from "package:syntax/type/annotation.sev"
import Grammar from "package:syntax/sentence/sentence.sev"
import AttachmentRole from "package:syntax/constraint/model.sev"
import named_definition, ScopeId, ModuleId from "package:syntax/symbol/symbol.sev"
import Parser, parser_expression, parser_type_annotation, parser_identifier, parser_expect_symbol, parser_at_simple, parser_take_symbol from "statement/mod.sev"


BlockProviderCandidate as ProviderMatch


def capture_window(parameter: FunctionParameter, tokens: list[lexer.Token], eof: lexer.Token) -> BlockCaptureValue | diagnostics.Diagnostic:
    value = BlockCaptureValue(parameter.name, parameter.annotation, variadic=parameter.variadic)
    kind = simple_type_name(parameter.annotation)
    pieces: list[list[lexer.Token]] = []
    current: list[lexer.Token] = []
    depth := 0
    for token in tokens:
        spelling = token.lexeme.text
        if depth == 0 and parameter.variadic and (spelling == "," or (kind == "TypeAnnotation" and spelling == "+")):
            if len(current) == 0:
                return error(diagnostics.diagnostic_at("E000120", "empty repeated capture", token.span))
            pieces.append(current)
            current = []
            continue
        current.append(token)
        if spelling in ["(", "[", "{"]:
            depth += 1
        elif spelling in [")", "]", "}"]:
            depth -= 1
    if len(current) > 0:
        pieces.append(current)
    if not parameter.variadic and len(pieces) != 1:
        return error(diagnostics.diagnostic_at("E000120", "capture requires one value", eof.span))
    for piece in pieces:
        parser = Parser(piece + [eof])
        value.spans.append(source.Span(piece[0].span.source, piece[0].span.start, piece[-1].span.end))
        if kind == "Symbol":
            value.symbols.append(parser_identifier(parser, "expected symbol capture")[0])
        elif kind == "TypeAnnotation":
            value.types.append(parser_type_annotation(parser))
        elif kind == "FunctionParameter":
            name = parser_identifier(parser, "expected parameter capture")
            variadic = parser_take_symbol(parser, "...") != None
            annotation := named_type("Self", [], name[1])
            if name[0] != "self" or not parser_at_simple(parser, "Eof"):
                parser_expect_symbol(parser, ":", "expected parameter type")
                annotation = parser_type_annotation(parser)
            parameter_value = FunctionParameter(name[0], annotation, absent, name[1], variadic=variadic)
            if parser_take_symbol(parser, "=") != None:
                parameter_value.default = parser_expression(parser, 0)
            value.parameters.append(parameter_value)
        else:
            value.expressions.append(parser_expression(parser, 0))
        if not parser_at_simple(parser, "Eof"):
            return error(diagnostics.diagnostic_at("E000120", "capture did not consume its source window", piece[0].span))
    return value


# Enumerate balanced capture boundaries; declaration order never resolves an
# overlapping grammar or an ambiguous partition of the same sentence.
def match_provider_window(grammar: Grammar, parameters: list[FunctionParameter], tokens: list[lexer.Token], eof: lexer.Token, field: int = 0, cursor: int = 0, captures: list[BlockCaptureValue] = []) -> list[list[BlockCaptureValue]]:
    if field == len(grammar.fields):
        return [captures] if cursor == len(tokens) else []
    match grammar.fields[field]:
        case Literal:
            if cursor < len(tokens) and tokens[cursor].lexeme.text == spelling:
                return match_provider_window(grammar, parameters, tokens, eof, field + 1, cursor + 1, captures)
            return []
        case Capture:
            for parameter in parameters:
                if parameter.name != name:
                    continue
                matches: list[list[BlockCaptureValue]] = []
                end := cursor
                depth := 0
                while end <= len(tokens):
                    if depth == 0 and (end > cursor or parameter.variadic):
                        value ?= capture_window(parameter, tokens[cursor:end], eof)
                        if value is BlockCaptureValue:
                            for matched in match_provider_window(grammar, parameters, tokens, eof, field + 1, end, captures + [value]):
                                matches.append(matched)
                    if end == len(tokens):
                        break
                    spelling = tokens[end].lexeme.text
                    if spelling in ["(", "[", "{"]:
                        depth += 1
                    elif spelling in [")", "]", "}"]:
                        depth -= 1
                    if depth < 0:
                        break
                    end += 1
                return matches
    return []


def accepts_block_reference(annotation: TypeAnnotation, block: Block | None) -> bool:
    match annotation.kind:
        case Named:
            if block == None:
                return name == "None"
            return name == "B" or name == block.syntax_name
        case Union:
            for member in members:
                if accepts_block_reference(member, block):
                    return true
    return false


def provider_frame(match: ProviderMatch, file: BlockFile, block: Block) -> lexer.LexicalFrame:
    frame = lexer.LexicalFrame(lexer.SourceLexicalRule(match.owner.name, match.owner.methods, match.owner.span, declaration=match.owner), [10000], receiver=block, read_only=true)
    for field in ["parent", "previous"]:
        reference ?= block.parent if field == "parent" else block.previous
        value := lexer.LexicalValue.Nothing
        if reference != None:
            target = file.blocks[reference.index]
            value = lexer.LexicalValue.Number(int(reference.index))
            frame.type_names.append("self." + field)
            frame.type_values.append(target.syntax_name)
            parent ?= target.parent
            lexer.lexical_set(frame, "self." + field + ".parent", lexer.LexicalValue.Number(int(parent.index)) if parent != None else lexer.LexicalValue.Nothing)
        lexer.lexical_set(frame, "self." + field, value)
    for capture in match.captures:
        elements: list[string] = []
        for span in capture.spans:
            elements.append(string(span.start))
        lexer.lexical_set(frame, capture.name, lexer.LexicalValue.Capture(capture))
        if len(capture.symbols) == 1:
            lexer.lexical_set(frame, capture.name + ".name.value", lexer.LexicalValue.Text(capture.symbols[0]))
    return frame


def construct_provider(match: ProviderMatch, block: Block) -> unit | diagnostics.Diagnostic:
    expected_identity = block.id.index
    body ?= match.constructor.body
    if body == None:
        return error(diagnostics.diagnostic_at("E000120", "selected block has no constructor", match.owner.span))
    frame = lexer.LexicalFrame(lexer.SourceLexicalRule(match.owner.name, match.owner.methods, match.owner.span, declaration=match.owner), [10000], receiver=block)
    for capture in match.captures:
        lexer.lexical_set(frame, capture.name, lexer.LexicalValue.Capture(capture))
    if body != None:
        flow = lexer.lexical_block(frame, body)
        if flow.returned and not flow.breaking and not flow.continuing:
            match flow.value:
                case BlockReference:
                    if block.id.index == expected_identity:
                        return
                case _:
                    return error(diagnostics.diagnostic_at("E000120", "constructor must return its block", match.owner.span))
    return error(diagnostics.diagnostic_at("E000120", "block constructor did not return its block", match.owner.span))


def resolve_provider_blocks(file: BlockFile, tokens: list[lexer.Token], declarations: list[RecordDeclaration], sources: list[source.SourceFile] = [], defer: bool = false) -> unit | diagnostics.Diagnostic:
    if len(declarations) == 0:
        return
    eof = tokens[-1]
    for block in file.blocks:
        window: list[lexer.Token] = []
        header ?= block.header
        if header != None:
            for token in tokens:
                if token.span.start >= header.span.start and token.span.end <= header.span.end and token.kind not in ["Newline", "Indent", "Dedent", "Eof"]:
                    window.append(token)
        recognized := false
        for declaration in declarations:
            for sentence in declaration.sentences:
                grammar ?= sentence.sentence
                if grammar == None:
                    continue
                if grammar != None:
                    if len(grammar.fields) == 0:
                        if block.parent != None:
                            continue
                        recognized = true
                    else:
                        if len(window) == 0:
                            continue
                        match grammar.fields[0]:
                            case Literal:
                                if window[0].lexeme.text != spelling:
                                    continue
                                recognized = true
                            case _:
                                recognized = true
                    for captures in match_provider_window(grammar, sentence.parameters, window, eof):
                        candidate = ProviderMatch(declaration, sentence, captures)
                        block.context.candidates.append(candidate)
        block.context.requires_provider = recognized
        file.blocks[block.id.index] = block
        if not defer:
            finish_provider_block(file, block, ParsedBlockCaptures(), sources)


trait BlockCaptureResolver:
    def check(capture: BlockCaptureValue) -> bool | diagnostics.Diagnostic


# Bootstrap clients have no semantic environment; ordinary compilation defers
# selection and supplies SemanticBlockCaptures from the owning scope.
class ParsedBlockCaptures: BlockCaptureResolver
    def check(capture: BlockCaptureValue) -> bool | diagnostics.Diagnostic:
        return true


def finish_provider_block(file: BlockFile, block: Block, resolver: BlockCaptureResolver, sources: list[source.SourceFile]) -> unit | diagnostics.Diagnostic:
    if len(block.context.candidates) == 0:
        if block.context.requires_provider:
            return error(diagnostics.diagnostic_at("E000120", "no block provider matches the source window", block.span))
        return
    matches: list[ProviderMatch] = []
    for candidate in block.context.candidates:
        accepted := true
        for capture in candidate.captures:
            accepted = resolver.check(capture) and accepted
        if not accepted:
            continue
        for field in candidate.owner.fields:
            if field.name in ["parent", "previous"]:
                reference ?= block.parent if field.name == "parent" else block.previous
                target: Block | None = file.blocks[reference.index] if reference != None else None
                accepted = accepts_block_reference(field.annotation, target) and accepted
        if not accepted:
            continue
        frame = provider_frame(candidate, file, block)
        for attachment in candidate.constructor.attachments:
            if attachment.role == AttachmentRole.Dispatch:
                if not lexer.lexical_truth(lexer.lexical_expression(frame, attachment.condition), candidate.owner.span):
                    accepted = false
                    break
        if accepted:
            matches.append(candidate)
    if len(matches) != 1:
        return error(diagnostics.diagnostic_at("E000120", "typed block dispatch requires exactly one match; matches=" + string(len(matches)), block.span))
    selected = matches[0]
    block.syntax_name = selected.owner.name
    block.context.identity = block.id
    block.context.parent = block.parent
    block.context.scope = ScopeId(ModuleId(u128(file.source.index) + 1))
    provider_path := file.path
    for input in sources:
        if input.id.index == selected.owner.span.source.index:
            provider_path = input.path
    block.context.provider = selected.owner.definition if selected.owner.definition.declaration.value != 0 else named_definition(provider_path, "block-provider", selected.owner.name)
    block.context.constructor = selected.constructor.definition if selected.constructor.definition.declaration.value != 0 else named_definition(provider_path, selected.owner.name, selected.constructor.name)
    block.context.values = selected.captures
    construct_provider(selected, block)
    file.blocks[block.id.index] = block
