import "../../../../../hir/module/module.sev" as model_hir_module_module
import "../../../../../syntax/block/block.sev" as model_syntax_block_block
import "../../../../../syntax/constraint/model.sev" as model_syntax_constraint_model
import "../../../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import "../../../../../syntax/grammar/grammar.sev" as model_syntax_grammar_grammar
import "../../../../../syntax/literal/value.sev" as model_syntax_literal_value
import "../../../../../syntax/sentence/sentence.sev" as model_syntax_sentence_sentence
import "../../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import "../../../../../syntax/type/system.sev" as model_syntax_type_system
import lexer
from lexer import TokenKind
import diagnostics
from diagnostics import Diagnostic
import source
import Associativity, B, CompilerExpectation, CompilerTestCase, DecoratorValue, Fixity, Symbol, TokenKind, span from "../../../../../syntax/function/syntax.sev"

def formatted_string_expression(value: string, span: source.Span, syntaxes: list[model_syntax_function_syntax.OperatorSyntax], lexical_rules: list[model_syntax_function_function.RecordDeclaration] = []) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    rules: list[lexer.SourceLexicalRule] = []
    for declaration in lexical_rules:
        rules.append(lexer.source_lexical_rule(declaration))
    characters = value.characters()
    cursor := 0
    literal := ""
    parts: list[model_syntax_function_function.Expression] = []
    while cursor < len(characters):
        if characters[cursor] == "{" and cursor + 1 < len(characters) and characters[cursor + 1] == "{":
            literal += "{"
            cursor += 2
            continue
        if characters[cursor] == "}" and cursor + 1 < len(characters) and characters[cursor + 1] == "}":
            literal += "}"
            cursor += 2
            continue
        if characters[cursor] == "}":
            return error(diagnostics.Diagnostic("E000113", "single } in formatted string; write }} for a literal brace", span))
        if characters[cursor] != "{":
            literal += string(characters[cursor])
            cursor += 1
            continue
        if len(literal) > 0:
            parts.append(model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.StringValue(literal)), span))
            literal = ""
        expression_start = cursor + 1
        cursor = expression_start
        nesting := 0
        while cursor < len(characters):
            if characters[cursor] == "(" or characters[cursor] == "[":
                nesting += 1
            elif characters[cursor] == ")" or characters[cursor] == "]":
                nesting -= 1
            elif characters[cursor] == "}" and nesting == 0:
                break
            cursor += 1
        if cursor >= len(characters):
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation is missing }", span))
        expression_source = characters[expression_start:cursor].join("").strip()
        if len(expression_source) == 0:
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation may not be empty", span))
        interpolation = source.SourceFile(span.source, "<formatted-string>", expression_source)
        interpolation_tokens = lexer.scan_tokens(interpolation, syntaxes, rules=rules)
        expression_parser = Parser(interpolation_tokens)
        parsed_expression = parser_expression(expression_parser, 0)
        parser_separators(expression_parser)
        if not parser_at_simple(expression_parser, Eof):
            return error(diagnostics.Diagnostic("E000113", "unexpected token in formatted string interpolation", span))
        parts.append(model_syntax_function_function.Expression(model_syntax_function_function.Stringify(parsed_expression), span))
        cursor += 1
    if len(literal) > 0:
        parts.append(model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.StringValue(literal)), span))
    if len(parts) == 0:
        return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.StringValue("")), span)
    # Formatting owns its output while viewing interpolated inputs. Append
    # into one growing string, including the single-interpolation case.
    result := model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.StringValue("")), span)
    for part in parts:
        append = model_syntax_function_function.Expression(model_syntax_function_function.Member(result, "append"), span)
        result = model_syntax_function_function.Expression(model_syntax_function_function.Call(append, [model_syntax_function_function.CallArgument(None, part, span)]), span)
    return result

class Parser:
    tokens: list[lexer.Token]
    cursor: list[int] = [0]


# The shared cursor belongs to the parser state. Recursive parsing uses
# ordinary functions so every advance remains an executable mutation.
def parser_peek(parser: Parser) -> lexer.Token:
    return parser.tokens[parser.cursor[0]]

def parser_next(parser: Parser) -> lexer.Token:
    token = parser.tokens[parser.cursor[0]]
    parser.cursor[0] += 1
    return token

def parser_at_identifier(parser: Parser, expected: string) -> bool:
    match parser_peek(parser).kind:
        case Identifier:
            return string(parser_peek(parser)) == expected
        case _:
            throw Error("unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    return false

def parser_at_simple(parser: Parser, expected: lexer.TokenKind) -> bool:
    return parser_peek(parser).kind == expected

def parser_take(parser: Parser, expected: lexer.TokenKind) -> lexer.Token | None:
    if parser_at_simple(parser, expected):
        return parser_next(parser)
    return None

def parser_fail(parser: Parser, message: string) -> diagnostics.Diagnostic:
    return diagnostics.Diagnostic("E000120", message, parser_peek(parser).span)

def parser_identifier(parser: Parser, message: string) -> tuple[string, source.Span] | diagnostics.Diagnostic:
    token = parser_next(parser)
    match token.kind:
        case Identifier:
            return (string(token), token.span)
        case _:
            throw diagnostics.diagnostic("E000113", "unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    return error(diagnostics.Diagnostic("E000120", message, token.span))

def parser_expect(parser: Parser, expected: lexer.TokenKind, message: string) -> lexer.Token | diagnostics.Diagnostic:
    token ?= parser_take(parser, expected)
    if token != None:
        return token
    return error(parser_fail(parser, message))

def parser_at_symbol(parser: Parser, spelling: string) -> bool:
    return lexer.token_is_symbol(parser_peek(parser), spelling)


def parser_take_symbol(parser: Parser, spelling: string) -> lexer.Token | None:
    if parser_at_symbol(parser, spelling):
        return parser_next(parser)
    return None


def parser_expect_symbol(parser: Parser, spelling: string, message: string) -> lexer.Token | diagnostics.Diagnostic:
    token ?= parser_take_symbol(parser, spelling)
    if token != None:
        return token
    return error(parser_fail(parser, message))


def parser_separators(parser: Parser):
    while parser_at_simple(parser, Newline) or parser_at_symbol(parser, ","):
        parser_next(parser)


# Layout inside an explicit delimiter separates list items, not statements.
# Keep the original tokens and spans; only the delimited parser consumes it.
def parser_delimited_layout(parser: Parser):
    while parser_at_simple(parser, Newline) or parser_at_simple(parser, Indent) or parser_at_simple(parser, Dedent):
        parser_next(parser)

def parser_module(parser: Parser) -> model_hir_module_module.Module | diagnostics.Diagnostic:
    result = model_hir_module_module.Module([])
    parser_separators(parser)
    while not parser_at_simple(parser, Eof):
        if parser_declaration_syntax(parser).grammar_form == "Declaration":
            result.items.append(model_hir_module_module.Record(parser_named_declaration(parser, parser_declaration_syntax(parser))))
        elif parser_at_symbol(parser, "@"):
            decorators: list[model_syntax_function_syntax.Decorator] = []
            while parser_at_symbol(parser, "@"):
                decorators.append(parser_scalar_decorator(parser))
            if parser_at_identifier(parser, "class"):
                declaration = parser_record_declaration(parser)
                declaration.decorators = decorators
                result.items.append(model_hir_module_module.Record(declaration))
            elif parser_at_identifier(parser, "trait"):
                result.items.append(model_hir_module_module.Trait(parser_trait_declaration(parser, decorators)))
            elif parser_at_identifier(parser, "def"):
                result.items.append(model_hir_module_module.Function(parser_function_declaration(parser, decorators)))
            else:
                return error(parser_fail(parser, "expected class, trait, or function after decorator"))
        elif parser_at_identifier(parser, "from"):
            for declaration in parser_selective_imports(parser):
                result.items.append(model_hir_module_module.Import(declaration))
        elif parser_at_identifier(parser, "import"):
            for declaration in parser_import_members(parser):
                result.items.append(model_hir_module_module.Import(declaration))
        elif parser_at_identifier(parser, "trait"):
            result.items.append(model_hir_module_module.Trait(parser_trait_declaration(parser, [])))
        elif parser_at_identifier(parser, "grammar"):
            result.items.append(model_hir_module_module.GrammarItem(parser_grammar_declaration(parser)))
        elif parser_at_identifier(parser, "operator"):
            operation = parser_operator_declaration(parser)
            operation.receiver = false
            result.items.append(model_hir_module_module.OperatorItem(operation))
        elif parser_at_identifier(parser, "def"):
            result.items.append(model_hir_module_module.Function(parser_function_declaration(parser, [])))
        elif parser_at_identifier(parser, "class"):
            result.items.append(model_hir_module_module.Record(parser_record_declaration(parser)))
        elif parser_at_identifier(parser, "extend"):
            result.items.append(model_hir_module_module.Record(parser_record_declaration(parser, true)))
        elif parser_at_identifier(parser, "union"):
            result.items.append(model_hir_module_module.Item.Type(parser_family_declaration(parser)))
        elif parser_at_identifier(parser, "type") and parser.cursor[0] + 1 < len(parser.tokens) and not lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "("):
            result.items.append(model_hir_module_module.Item.Type(parser_type_declaration(parser, [])))
        elif parser_at_type_alias(parser):
            result.items.append(model_hir_module_module.Item.Type(parser_type_alias(parser, [])))
        elif parser_at_identifier(parser, "test"):
            result.items.append(model_hir_module_module.Test(parser_test_declaration(parser)))
        elif parser_at_identifier(parser, "return") or parser_at_identifier(parser, "break") or parser_at_identifier(parser, "continue"):
            return error(diagnostics.Diagnostic("E000121", "control flow is not valid at module scope", parser_peek(parser).span))
        else:
            statement = parser_simple_statement(parser)
            match statement:
                case BindingStatement:
                    result.items.append(model_hir_module_module.BindingItem(binding))
                case ExpressionStatement:
                    result.items.append(model_hir_module_module.ExpressionItem(expression))
                case _:
                    return error(parser_fail(parser, "expected a module declaration"))
        parser_separators(parser)
    return result

def parser_scalar_decorator(parser: Parser) -> model_syntax_function_syntax.Decorator | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected decorator name")[0]
    parser_expect_symbol(parser, "(", "expected decorator arguments")
    arguments: list[model_syntax_function_syntax.DecoratorArgument] = []
    while not parser_at_symbol(parser, ")"):
        argument_name := ""
        if parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "="):
            argument_name = parser_identifier(parser, "expected argument name")[0]
            parser_next(parser)
        token = parser_next(parser)
        match token.kind:
            case String:
                arguments.append(model_syntax_function_syntax.DecoratorArgument(argument_name, model_syntax_function_syntax.DecoratorValue.String(string(token)), token.span))
            case _:
                return error(parser_fail(parser, "decorator requires string arguments"))
        if parser_take_symbol(parser, ",") == None:
            break
    end = parser_expect_symbol(parser, ")", "expected closing decorator parenthesis").span
    parser_expect(parser, Newline, "expected newline after decorator")
    return model_syntax_function_syntax.Decorator(name, arguments, source.Span(start.source, start.start, end.end))

def parser_selective_imports(parser: Parser) -> list[model_syntax_function_syntax.ImportDeclaration] | diagnostics.Diagnostic:
    parser_next(parser)
    locator = parser_at_simple(parser, String)
    package_name := ""
    if locator:
        package_name = string(parser_next(parser))
    else:
        package_name = parser_identifier(parser, "expected an import source")[0]
    if not parser_at_identifier(parser, "import"):
        return error(parser_fail(parser, "expected import after source package"))
    parser_next(parser)
    multiline = parser_at_simple(parser, Newline)
    if multiline:
        parser_delimited_layout(parser)
    grouped = parser_take_symbol(parser, "{") != None
    if multiline and not grouped:
        return error(parser_fail(parser, "a new-line import list requires braces or a backslash continuation"))
    if grouped:
        parser_delimited_layout(parser)
    result: list[model_syntax_function_syntax.ImportDeclaration] = []
    while true:
        member := ("", parser_peek(parser).span)
        if parser_at_symbol(parser, "*"):
            token = parser_next(parser)
            member = ("*", token.span)
        else:
            member = parser_identifier(parser, "expected an import name")
        alias: string | None := None
        if parser_at_identifier(parser, "as"):
            parser_next(parser)
            alias = parser_identifier(parser, "expected an import alias")[0]
        if locator:
            selected: string | None := member[0]
            if member[0] == "*":
                selected = None
            result.append(model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.Locator(package_name), selected, alias, member[1]))
        else:
            result.append(model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.ImportSubject.Name(member[0]), package_name, alias, member[1]))
        if grouped:
            parser_delimited_layout(parser)
        if parser_take_symbol(parser, ",") == None:
            break
        if grouped:
            parser_delimited_layout(parser)
            if parser_at_symbol(parser, "}"):
                break
    if grouped:
        parser_expect_symbol(parser, "}", "expected } after import list")
    return result


def parser_import_members(parser: Parser) -> list[model_syntax_function_syntax.ImportDeclaration] | diagnostics.Diagnostic:
    start = parser_next(parser).span
    if parser_at_simple(parser, String):
        locator = parser_next(parser)
        if not parser_at_identifier(parser, "as"):
            return error(parser_fail(parser, "file namespace imports require an explicit as alias"))
        parser_next(parser)
        alias = parser_identifier(parser, "expected a namespace alias")[0]
        return [model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.Locator(string(locator)), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))]
    names: list[string] = []
    aliases: list[string | None] = []
    spans: list[source.Span] = []
    while true:
        span = parser_peek(parser).span
        name := ""
        if parser_take_symbol(parser, "*") != None:
            name = "*"
        else:
            name = parser_identifier(parser, "expected an import name or *")[0]
        alias: string | None := None
        if parser_at_identifier(parser, "as"):
            parser_next(parser)
            alias = parser_identifier(parser, "expected an import alias")[0]
        names.append(name)
        aliases.append(alias)
        spans.append(span)
        if parser_take_symbol(parser, ",") == None:
            break
    result: list[model_syntax_function_syntax.ImportDeclaration] = []
    if not parser_at_identifier(parser, "from"):
        if len(names) != 1 or names[0] == "*":
            return error(parser_fail(parser, "expected from after import list"))
        result.append(model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.ImportSubject.Name(names[0]), None, aliases[0], source.Span(start.source, start.start, parser_peek(parser).span.start)))
        return result
    parser_next(parser)
    locator = parser_at_simple(parser, String)
    origin := ""
    if locator:
        origin = string(parser_next(parser))
    else:
        origin = parser_identifier(parser, "expected an import source")[0]
    if parser_at_identifier(parser, "as"):
        if len(names) != 1:
            return error(parser_fail(parser, "alias each named import before from"))
        parser_next(parser)
        aliases[0] = parser_identifier(parser, "expected an import alias")[0]
    for index in range(int(len(names))):
        span := spans[index]
        if len(names) == 1:
            span = source.Span(start.source, start.start, parser_peek(parser).span.start)
        if locator:
            selected: string | None := names[index]
            if names[index] == "*":
                selected = None
            result.append(model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.Locator(origin), selected, aliases[index], span))
        else:
            result.append(model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.ImportSubject.Name(names[index]), origin, aliases[index], span))
    return result


def parser_import_declaration(parser: Parser) -> model_syntax_function_syntax.ImportDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    if parser_take_symbol(parser, "*") != None:
        if not parser_at_identifier(parser, "from"):
            return error(parser_fail(parser, "expected `from` after `import *`"))
        parser_next(parser)
        token = parser_expect(parser, String, "expected a locator string after `import * from`")
        alias: string | None := None
        if parser_at_identifier(parser, "as"):
            parser_next(parser)
            alias = parser_identifier(parser, "expected an import alias")[0]
        return model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.Locator(string(token)), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
    if parser_at_simple(parser, String):
        locator = parser_next(parser)
        if not parser_at_identifier(parser, "as"):
            return error(parser_fail(parser, "file namespace imports require an alias"))
        parser_next(parser)
        alias = parser_identifier(parser, "expected an import alias")[0]
        return model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.Locator(string(locator)), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
    first = parser_identifier(parser, "expected an import name")
    if parser_at_identifier(parser, "from"):
        parser_next(parser)
        if parser_at_simple(parser, String):
            locator = parser_next(parser)
            alias: string | None := None
            if parser_at_identifier(parser, "as"):
                parser_next(parser)
                alias = parser_identifier(parser, "expected an import alias")[0]
            return model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.Locator(string(locator)), first[0], alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
        source_name = parser_identifier(parser, "expected an import source")[0]
        alias: string | None := None
        if parser_at_identifier(parser, "as"):
            parser_next(parser)
            alias = parser_identifier(parser, "expected an import alias")[0]
        return model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.ImportSubject.Name(first[0]), source_name, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
    alias: string | None := None
    if parser_at_identifier(parser, "as"):
        parser_next(parser)
        alias = parser_identifier(parser, "expected an import alias")[0]
    return model_syntax_function_syntax.ImportDeclaration(model_syntax_function_syntax.ImportSubject.Name(first[0]), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))

def parser_type_parameters(parser: Parser, pack: list[string] = [], defaults: list[model_syntax_type_annotation.TypeAnnotation] = []) -> tuple[list[string], list[model_syntax_function_syntax.GenericConstraint]] | diagnostics.Diagnostic:
    parameters: list[string] = []
    constraints: list[model_syntax_function_syntax.GenericConstraint] = []
    if parser_take_symbol(parser, "[") == None:
        return (parameters, constraints)
    parser_delimited_layout(parser)
    if not parser_at_symbol(parser, "]"):
        while true:
            packed = parser_take_symbol(parser, "...") != None
            if len(pack) != 0:
                return error(parser_fail(parser, "a type pack must be the final generic parameter"))
            parameter = parser_identifier(parser, "expected a generic parameter")
            if parameter[0] in parameters:
                return error(parser_fail(parser, "duplicate generic parameter " + parameter[0]))
            if packed:
                pack.append(parameter[0])
            parameters.append(parameter[0])
            if parser_take_symbol(parser, ":") != None:
                bound = parser_type_annotation(parser)
                constraints.append(model_syntax_type_system.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
            if parser_take_symbol(parser, "=") != None:
                if packed:
                    return error(parser_fail(parser, "a type pack cannot have a default"))
                default = parser_type_annotation(parser)
                default.binding = parameter[0]
                defaults.append(default)
            elif len(defaults) != 0:
                return error(parser_fail(parser, "required type parameter follows a default"))
            parser_delimited_layout(parser)
            if parser_take_symbol(parser, ",") == None:
                break
            parser_delimited_layout(parser)
            if parser_at_symbol(parser, "]"):
                break
    parser_expect_symbol(parser, "]", "expected closing type parameter bracket")
    return (parameters, constraints)

def parser_declaration_constraints(parser: Parser, attachments: list[model_syntax_constraint_model.WithAttachment] = [], callable: bool = false) -> list[model_syntax_function_syntax.GenericConstraint] | diagnostics.Diagnostic:
    constraints: list[model_syntax_function_syntax.GenericConstraint] = []
    if not parser_at_identifier(parser, "with"):
        return constraints
    parser_next(parser)
    if callable and not parser_at_symbol(parser, "{"):
        attachments.append(model_syntax_constraint_model.WithAttachment(model_syntax_constraint_model.AttachmentRole.Dispatch, parser_expression(parser, 0)))
        return constraints
    parser_expect_symbol(parser, "{", "expected { after declaration with")
    multiline = parser_take(parser, Newline) != None
    if multiline:
        parser_expect(parser, Indent, "expected indented declaration constraints")
    parser_separators(parser)
    while not parser_at_symbol(parser, "}") and not parser_at_simple(parser, Dedent):
        if callable and (parser_at_identifier(parser, "entry") or parser_at_identifier(parser, "fix") or parser_at_identifier(parser, "exit")):
            role := model_syntax_constraint_model.AttachmentRole.Entry
            if parser_at_identifier(parser, "fix"):
                role = model_syntax_constraint_model.AttachmentRole.Fix
            elif parser_at_identifier(parser, "exit"):
                role = model_syntax_constraint_model.AttachmentRole.Exit
            parser_next(parser)
            attachments.append(model_syntax_constraint_model.WithAttachment(role, parser_expression(parser, 0)))
        elif parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], ":"):
            parameter = parser_identifier(parser, "expected constrained parameter")
            parser_expect_symbol(parser, ":", "expected colon after constrained parameter")
            bound = parser_type_annotation(parser)
            constraints.append(model_syntax_type_system.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
        elif callable:
            attachments.append(model_syntax_constraint_model.WithAttachment(model_syntax_constraint_model.AttachmentRole.Dispatch, parser_expression(parser, 0)))
        else:
            constraints.append(model_syntax_function_syntax.Predicate(parser_expression(parser, 0)))
        parser_take_symbol(parser, ",")
        parser_separators(parser)
    if multiline:
        parser_expect(parser, Dedent, "expected end of declaration constraints")
    parser_expect_symbol(parser, "}", "expected } after declaration constraints")
    return constraints

def parser_function_declaration(parser: Parser, decorators: list[model_syntax_function_syntax.Decorator]) -> model_syntax_function_function.FunctionDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a function name")[0]
    defaults: list[model_syntax_type_annotation.TypeAnnotation] = []
    generic_parts = parser_type_parameters(parser, defaults=defaults)
    generics = generic_parts[0]
    constraints := generic_parts[1]
    parser_expect_symbol(parser, "(", "expected opening parenthesis")
    parameters: list[model_syntax_function_function.FunctionParameter] = []
    keyword_only := false
    parser_delimited_layout(parser)
    while not parser_at_symbol(parser, ")"):
        variadic = parser_take_symbol(parser, "*") != None
        if variadic:
            if keyword_only:
                return error(parser_fail(parser, "only one variadic parameter is supported"))
            keyword_only = true
        parameter = parser_identifier(parser, "expected a parameter name")
        # Bare self uses the same inferred receiver as an omitted receiver.
        # Semantic analysis supplies its type and ownership contract.
        if parameter[0] == "self" and not variadic and not parser_at_symbol(parser, ":"):
            parser_delimited_layout(parser)
            if parser_take_symbol(parser, ",") != None:
                parser_delimited_layout(parser)
                continue
            break
        parser_expect_symbol(parser, ":", "expected colon after parameter")
        modifiers: list[model_syntax_function_function.BoundaryModifier] = []
        mode = parser_ownership_mode(parser)
        if mode != "":
            modifiers.append(model_syntax_function_function.BoundaryModifier(mode))
        annotation = parser_type_annotation(parser)
        default: model_syntax_function_function.Expression | absent := absent
        parameter_end := annotation.span.end
        if parser_take_symbol(parser, "=") != absent:
            parsed_default = parser_expression(parser, 0)
            default = parsed_default
            parameter_end = parsed_default.span.end
        parameters.append(model_syntax_function_function.FunctionParameter(parameter[0], annotation, default, source.Span(parameter[1].source, parameter[1].start, parameter_end), modifiers=modifiers, variadic=variadic, keyword_only=keyword_only and not variadic))
        parser_delimited_layout(parser)
        if parser_take_symbol(parser, ",") == None:
            break
        parser_delimited_layout(parser)
    close = parser_expect_symbol(parser, ")", "expected closing parenthesis").span
    result := model_syntax_type_annotation.named_type("unit", [], close)
    result_mode := ""
    if parser_take_symbol(parser, "->") != None:
        result_mode = parser_ownership_mode(parser)
        result = parser_type_annotation(parser)
    attachments: list[model_syntax_constraint_model.WithAttachment] = []
    for constraint in parser_declaration_constraints(parser, attachments, true):
        constraints.append(constraint)
    body: model_syntax_block_block.Block | None := None
    end := result.span.end
    if parser_take_symbol(parser, ":") != None:
        block = parser_indented_block(parser, "function")
        body = block[0]
        end = block[1]
    return model_syntax_function_function.FunctionDeclaration(decorators, name, generics, constraints, parameters, result, body, source.Span(start.source, start.start, end), result_mode=result_mode, type_defaults=defaults, attachments=attachments)

def parser_ownership_mode(parser: Parser) -> string:
    if parser_at_identifier(parser, "view"):
        parser_next(parser)
        return "borrow"
    if parser_at_identifier(parser, "borrow"):
        parser_next(parser)
        if parser_at_identifier(parser, "mut"):
            parser_next(parser)
        return "borrow mut"
    if parser_at_identifier(parser, "move") or parser_at_identifier(parser, "copy") or parser_at_identifier(parser, "mirror"):
        return string(parser_next(parser))
    return ""


def parser_at_type_alias(parser: Parser) -> bool:
    if parser_at_simple(parser, Integer):
        return false
    cursor := parser.cursor[0]
    depth := 0
    while cursor < len(parser.tokens):
        token = parser.tokens[cursor]
        if depth == 0:
            if token.kind == Newline or token.kind == Dedent or token.kind == Eof:
                return false
            if lexer.token_is_symbol(token, "=") or lexer.token_is_symbol(token, ":=") or lexer.token_is_symbol(token, ":") or lexer.token_is_symbol(token, ";"):
                return false
            if token.kind == Identifier and string(token) == "as":
                return true
        if lexer.token_is_symbol(token, "[") or lexer.token_is_symbol(token, "(") or lexer.token_is_symbol(token, "{"):
            depth += 1
        elif lexer.token_is_symbol(token, "]") or lexer.token_is_symbol(token, ")") or lexer.token_is_symbol(token, "}"):
            depth -= 1
        cursor += 1
    return false


def parser_type_alias(parser: Parser, decorators: list[model_syntax_function_syntax.Decorator]) -> model_syntax_function_syntax.TypeDeclaration | diagnostics.Diagnostic:
    definition = parser_type_annotation(parser)
    if not parser_at_identifier(parser, "as"):
        return error(parser_fail(parser, "expected as before alias name"))
    parser_next(parser)
    name = parser_identifier(parser, "expected an alias name")[0]
    defaults: list[model_syntax_type_annotation.TypeAnnotation] = []
    generic_parts = parser_type_parameters(parser, defaults=defaults)
    constraints := generic_parts[1]
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    return model_syntax_function_syntax.TypeDeclaration(decorators, name, generic_parts[0], constraints, definition, source.Span(definition.span.source, definition.span.start, parser_peek(parser).span.start), type_defaults=defaults)


def parser_type_declaration(parser: Parser, decorators: list[model_syntax_function_syntax.Decorator]) -> model_syntax_function_syntax.TypeDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a type name")[0]
    defaults: list[model_syntax_type_annotation.TypeAnnotation] = []
    generic_parts = parser_type_parameters(parser, defaults=defaults)
    parameters = generic_parts[0]
    constraints := generic_parts[1]
    definition: model_syntax_type_annotation.TypeAnnotation | None := None
    if parser_at_symbol(parser, "="):
        return error(parser_fail(parser, "type aliases use B as X, not type X = B"))
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    return model_syntax_function_syntax.TypeDeclaration(decorators, name, parameters, constraints, definition, source.Span(start.source, start.start, parser_peek(parser).span.start), type_defaults=defaults)

def parser_trait_declaration(parser: Parser, decorators: list[model_syntax_function_syntax.Decorator]) -> model_syntax_function_syntax.TraitDeclaration | diagnostics.Diagnostic:
    start_token = parser_next(parser)
    start = start_token.span
    name = parser_identifier(parser, "expected a trait name")[0]
    defaults: list[model_syntax_type_annotation.TypeAnnotation] = []
    generic_parts = parser_type_parameters(parser, defaults=defaults)
    constraints := generic_parts[1]
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    bases: list[model_syntax_type_annotation.TypeAnnotation] = []
    parser_expect_symbol(parser, ":", "expected trait bases or body")
    if not parser_at_simple(parser, Newline):
        while true:
            bases.append(parser_type_annotation(parser))
            if parser_take_symbol(parser, "+") == None:
                break
        parser_take_symbol(parser, ":")
    properties: list[model_syntax_function_syntax.PropertyDeclaration] = []
    operators: list[model_syntax_function_syntax.OperatorDeclaration] = []
    methods: list[model_syntax_function_function.FunctionDeclaration] = []
    parser_separators(parser)
    if parser_take(parser, Indent) != None:
        parser_separators(parser)
        while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
            if parser_at_identifier(parser, "def"):
                methods.append(parser_function_declaration(parser, []))
            elif parser_at_identifier(parser, "operator"):
                operators.append(parser_operator_declaration(parser))
            elif parser_at_identifier(parser, "property") or (parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], ":")):
                property_start = parser_peek(parser).span
                if parser_at_identifier(parser, "property"):
                    parser_next(parser)
                property_name = parser_identifier(parser, "expected property name")[0]
                parser_expect_symbol(parser, ":", "expected property type")
                annotation = parser_type_annotation(parser)
                default: model_syntax_function_function.Expression | None := None
                if parser_take_symbol(parser, "=") != None:
                    if start_token.grammar and property_name == "symbol":
                        symbol_token = parser_next(parser)
                        if len(symbol_token.syntaxes) == 0:
                            return error(parser_fail(parser, "expected a registered source symbol"))
                        syntax = start_token.syntaxes[0] if len(start_token.syntaxes) != 0 else symbol_token.syntaxes[0]
                        default = model_syntax_function_function.Expression(model_syntax_function_function.SourceSymbol(syntax.symbol, syntax.definition), symbol_token.span)
                    elif start_token.grammar and property_name in ["left", "right"]:
                        term = parser_type_primary(parser)
                        match term.kind:
                            case Named:
                                default = model_syntax_function_function.Expression(model_syntax_function_function.CompilerTerm(name, arguments), term.span)
                            case _:
                                return error(parser_fail(parser, "expected an operand requirement"))
                    else:
                        default = parser_expression(parser, 0)
                properties.append(model_syntax_function_syntax.PropertyDeclaration(property_name, annotation, default, property_start))
            else:
                # A bare type in a trait body is an inherited contract.
                bases.append(parser_type_annotation(parser))
            parser_separators(parser)
        parser_expect(parser, Dedent, "expected end of trait")
    return model_syntax_function_syntax.TraitDeclaration(decorators, name, generic_parts[0], constraints, bases, properties, operators, source.Span(start.source, start.start, parser_peek(parser).span.start), methods=methods, compiler_descriptor=start_token.descriptor, grammar=start_token.grammar, type_defaults=defaults)


def parser_operator_declaration(parser: Parser) -> model_syntax_function_syntax.OperatorDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    token = parser_next(parser)
    symbol := ""
    syntax := model_syntax_function_syntax.operator_syntax(model_syntax_function_syntax.Add())
    if len(token.syntaxes) != 0:
        syntax = token.syntaxes[0]
        symbol = syntax.symbol
    else:
        match token.kind:
            case Identifier:
                symbol = string(token)
            case Symbol:
                symbol = string(token)
            case _:
                return error(parser_fail(parser, "expected a registered operator symbol"))
    syntax = model_syntax_function_syntax.OperatorSyntax(symbol, syntax.fixity, syntax.precedence, syntax.associativity, definition=syntax.definition)
    # Operator parameters use the same parameter:constraint grammar as other
    # declarations. Whether a constraint denotes compiler grammar is resolved
    # later, through its actual definition and inherited contracts.
    generic_parts = parser_type_parameters(parser)
    type_parameters = generic_parts[0]
    operator_constraints = generic_parts[1]
    parser_expect_symbol(parser, "(", "expected operator parameters")
    parameters: list[model_syntax_function_syntax.OperatorParameter] = []
    while not parser_at_symbol(parser, ")"):
        prefix_mode = parser_ownership_mode(parser)
        parameter = parser_identifier(parser, "expected operator parameter")
        annotation := model_syntax_type_annotation.named_type("Self", [], parameter[1])
        mode := prefix_mode
        if parser_take_symbol(parser, ":") != None:
            mode = parser_ownership_mode(parser)
            annotation = parser_type_annotation(parser)
        elif parameter[0] != "self":
            return error(parser_fail(parser, "expected operator parameter type"))
        parameters.append(model_syntax_function_syntax.OperatorParameter(parameter[0], annotation, parameter[1], mode=mode))
        if parser_take_symbol(parser, ",") == None:
            break
    close = parser_expect_symbol(parser, ")", "expected closing operator parenthesis")
    result := model_syntax_type_annotation.named_type("unit", [], close.span)
    result_mode := ""
    if parser_take_symbol(parser, "->") != None:
        result_mode = parser_ownership_mode(parser)
        result = parser_type_annotation(parser)
    constraints = operator_constraints
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    body: model_syntax_block_block.Block | None := None
    if parser_take_symbol(parser, ":") != None:
        body = parser_indented_block(parser, "operator")[0]
    receiver := len(parameters) < 2
    if len(parameters) == 1 and parameters[0].name == "self":
        syntax = model_syntax_function_syntax.OperatorSyntax(symbol, model_syntax_function_syntax.Fixity.Prefix, 10, model_syntax_function_syntax.Associativity.Right, domain=syntax.domain, grammar_name=syntax.grammar_name)
        receiver = false
    return model_syntax_function_syntax.OperatorDeclaration(syntax, parameters, result, source.Span(start.source, start.start, parser_peek(parser).span.start), type_parameters=type_parameters, constraints=constraints, body=body, receiver=receiver, result_mode=result_mode)


def parser_destructor(operation: model_syntax_function_syntax.OperatorDeclaration) -> model_syntax_function_function.FunctionDeclaration | diagnostics.Diagnostic:
    if len(operation.parameters) != 1 or operation.parameters[0].name != "self" or operation.parameters[0].mode != "move":
        return error(diagnostics.diagnostic_at("E000117", "destructor requires operator drop(move self) -> unit", operation.span))
    if len(operation.type_parameters) != 0 or len(operation.constraints) != 0 or operation.result_mode != "" or operation.body == None:
        return error(diagnostics.diagnostic_at("E000117", "destructor requires a non-generic cleanup body", operation.span))
    parameter = operation.parameters[0]
    receiver = model_syntax_function_function.FunctionParameter("self", parameter.annotation, None, parameter.span, modifiers=[model_syntax_function_function.BoundaryModifier("move")])
    return model_syntax_function_function.FunctionDeclaration(name="drop", parameters=[receiver], result=operation.result, body=operation.body, span=operation.span)


def parser_test_declaration(parser: Parser) -> model_syntax_function_syntax.TestDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    if parser_at_simple(parser, Newline):
        parser_separators(parser)
    if parser_at_symbol(parser, "[") or (not parser_at_identifier(parser, "with") and parser_peek(parser).kind == Identifier):
        return parser_case_test(parser, start)
    modes: list[string] = []
    mode_arguments: list[model_syntax_function_syntax.TestModeArguments] = []
    if parser_at_identifier(parser, "with"):
        parser_next(parser)
        while true:
            mode = parser_identifier(parser, "expected test mode")[0]
            modes.append(mode)
            values: list[model_syntax_function_function.Expression] = []
            if parser_take_symbol(parser, "(") != None:
                while not parser_at_symbol(parser, ")"):
                    values.append(parser_expression(parser, 0))
                    if parser_take_symbol(parser, ",") == None:
                        break
                parser_expect_symbol(parser, ")", "expected closing test mode parenthesis")
            mode_arguments.append(model_syntax_function_syntax.TestModeArguments(mode, values))
            if not parser_at_identifier(parser, "and"):
                break
            parser_next(parser)
    name: string | None := None
    match parser_peek(parser).kind:
        case String:
            name = string(parser_next(parser))
        case _:
            throw diagnostics.diagnostic("E000113", "unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    contracts: list[model_syntax_function_function.Expression] = []
    if parser_at_identifier(parser, "with"):
        if "profile" not in modes:
            return error(parser_fail(parser, "test resource contracts require profile mode"))
        parser_next(parser)
        parser_delimited_layout(parser)
        parser_expect_symbol(parser, "{", "expected resource contracts")
        parser_delimited_layout(parser)
        while not parser_at_symbol(parser, "}"):
            if parser_at_identifier(parser, "defer"):
                parser_next(parser)
            contracts.append(parser_expression(parser, 0))
            parser_take_symbol(parser, ",")
            parser_delimited_layout(parser)
        parser_next(parser)
    parser_expect_symbol(parser, ":", "expected colon after test")
    if "compiler" in modes:
        parser_expect(parser, Newline, "expected newline after compiler test")
        parser_separators(parser)
        parser_expect(parser, Indent, "expected compiler test body")
        cases: list[model_syntax_function_syntax.CompilerTestCase] = []
        setup: list[model_syntax_sentence_sentence.Statement] = []
        parser_separators(parser)
        while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
            case_start = parser_peek(parser).span
            expectation: CompilerExpectation := Accept
            if parser_at_identifier(parser, "reject"):
                expectation = Reject
            elif not parser_at_identifier(parser, "accept"):
                setup.append(parser_block_statement(parser))
                parser_separators(parser)
                continue
            parser_next(parser)
            parser_expect_symbol(parser, ":", "expected colon after compiler expectation")
            parser_expect(parser, Newline, "expected newline after compiler case")
            parser_separators(parser)
            parser_expect(parser, Indent, "expected compiler case body")
            tokens: list[lexer.Token] = []
            depth := 1
            delimiters := 0
            # A dedented closing delimiter still belongs to this case. An
            # unclosed expression must not swallow the following test case.
            while depth > 0 or (delimiters > 0 and (parser_at_simple(parser, Newline) or parser_at_symbol(parser, ")") or parser_at_symbol(parser, "]") or parser_at_symbol(parser, "}"))):
                token = parser_next(parser)
                if token.kind == Eof:
                    return error(parser_fail(parser, "unterminated compiler case"))
                if lexer.token_is_symbol(token, "(") or lexer.token_is_symbol(token, "[") or lexer.token_is_symbol(token, "{"):
                    delimiters += 1
                elif lexer.token_is_symbol(token, ")") or lexer.token_is_symbol(token, "]") or lexer.token_is_symbol(token, "}"):
                    delimiters -= 1
                if token.kind == Indent:
                    depth += 1
                elif token.kind == Dedent:
                    depth -= 1
                if depth > 0 or delimiters > 0 or token.kind != Dedent:
                    tokens.append(token)
            end = parser_peek(parser).span
            tokens.append(lexer.token_from_lexeme(Eof, lexer.Lexeme("", source.Span(end.source, end.start, end.start))))
            if len(setup) != 0:
                cases.append(model_syntax_function_syntax.CompilerTestCase(Accept, None, model_syntax_block_block.Block(setup[:]), case_start))
            parsed ?= parser_compiler_case(Parser(tokens), expectation, setup, case_start)
            if parsed is Diagnostic:
                cases.append(model_syntax_function_syntax.CompilerTestCase(expectation, None, model_syntax_block_block.Block(), case_start, parse_error=parsed.message))
            if parsed is CompilerTestCase:
                cases.append(parsed)
            parser_separators(parser)
        end = parser_expect(parser, Dedent, "expected end of compiler test").span.end
        return model_syntax_function_syntax.TestDeclaration(name, modes, model_syntax_block_block.Block(), cases, source.Span(start.source, start.start, end), mode_arguments=mode_arguments)
    block = parser_indented_block(parser, "test")
    return model_syntax_function_syntax.TestDeclaration(name, modes, block[0], [], source.Span(start.source, start.start, block[1]), mode_arguments=mode_arguments, contracts=contracts)


def parser_case_test(parser: Parser, start: source.Span) -> model_syntax_function_syntax.TestDeclaration | diagnostics.Diagnostic:
    names: list[string] = []
    rows: list[model_syntax_function_syntax.TestCaseRow] := []
    product = parser_take_symbol(parser, "[") != None
    label := "cases"
    if product:
        initial: list[model_syntax_function_function.Expression] = []
        rows.append(model_syntax_function_syntax.TestCaseRow(initial))
        parser_delimited_layout(parser)
        while not parser_at_symbol(parser, "]"):
            parameter = parser_identifier(parser, "expected case parameter")[0]
            if parameter in names:
                return error(parser_fail(parser, "duplicate case parameter"))
            names.append(parameter)
            if not parser_at_identifier(parser, "in"):
                return error(parser_fail(parser, "expected in after case parameter"))
            parser_next(parser)
            values = parser_expression(parser, 0)
            expanded: list[model_syntax_function_syntax.TestCaseRow] = []
            match values.kind:
                case ListLiteral:
                    for row in rows:
                        for element in elements:
                            next = row.values[:]
                            next.append(element)
                            expanded.append(model_syntax_function_syntax.TestCaseRow(next))
                case _:
                    return error(parser_fail(parser, "Cartesian cases require literal lists"))
            rows = expanded
            parser_delimited_layout(parser)
            if parser_take_symbol(parser, ",") == None:
                break
            parser_delimited_layout(parser)
        parser_expect_symbol(parser, "]", "expected closing case bracket")
    else:
        label = parser_identifier(parser, "expected case subject")[0]
        parser_expect_symbol(parser, "(", "expected case parameter list")
        parser_delimited_layout(parser)
        while not parser_at_symbol(parser, ")"):
            name = parser_identifier(parser, "expected case parameter")[0]
            if name in names:
                return error(parser_fail(parser, "duplicate case parameter"))
            names.append(name)
            parser_delimited_layout(parser)
            if parser_take_symbol(parser, ",") == None:
                break
            parser_delimited_layout(parser)
        parser_expect_symbol(parser, ")", "expected closing case parameter list")
    if not parser_at_identifier(parser, "with"):
        return error(parser_fail(parser, "expected with cases"))
    parser_next(parser)
    if not parser_at_identifier(parser, "cases"):
        return error(parser_fail(parser, "expected cases mode"))
    parser_next(parser)
    if parser_peek(parser).kind == String:
        label = string(parser_next(parser))
    if not product:
        parser_delimited_layout(parser)
        parser_expect_symbol(parser, "{", "expected case table")
        parser_delimited_layout(parser)
        while not parser_at_symbol(parser, "}"):
            parser_expect_symbol(parser, "(", "expected case row")
            parser_delimited_layout(parser)
            values: list[model_syntax_function_function.Expression] = []
            while not parser_at_symbol(parser, ")"):
                values.append(parser_expression(parser, 0))
                parser_delimited_layout(parser)
                if parser_take_symbol(parser, ",") == None:
                    break
                parser_delimited_layout(parser)
            parser_expect_symbol(parser, ")", "expected closing case row")
            if len(values) != len(names):
                return error(parser_fail(parser, "case row does not match parameter count"))
            rows.append(model_syntax_function_syntax.TestCaseRow(values))
            parser_delimited_layout(parser)
            if parser_take_symbol(parser, ",") == None:
                break
            parser_delimited_layout(parser)
        parser_expect_symbol(parser, "}", "expected closing case table")
    if len(rows) == 0:
        return error(parser_fail(parser, "case table must contain at least one case"))
    parser_expect_symbol(parser, ":", "expected colon after cases")
    body = parser_indented_block(parser, "cases")
    return model_syntax_function_syntax.TestDeclaration(label, [], body[0], [], source.Span(start.source, start.start, body[1]), case_names=names, case_rows=rows)


def parser_compiler_case(parser: Parser, expectation: model_syntax_function_syntax.CompilerExpectation, setup: list[model_syntax_sentence_sentence.Statement], span: source.Span) -> model_syntax_function_syntax.CompilerTestCase | diagnostics.Diagnostic:
    statements = setup[:]
    declarations: list[model_hir_module_module.Item] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Eof):
        if parser_declaration_syntax(parser).grammar_form == "Declaration":
            declarations.append(model_hir_module_module.Record(parser_named_declaration(parser, parser_declaration_syntax(parser))))
        elif parser_at_identifier(parser, "class"):
            declarations.append(model_hir_module_module.Record(parser_record_declaration(parser)))
        elif parser_at_identifier(parser, "extend"):
            declarations.append(model_hir_module_module.Record(parser_record_declaration(parser, true)))
        elif parser_at_identifier(parser, "trait"):
            declarations.append(model_hir_module_module.Trait(parser_trait_declaration(parser, [])))
        elif parser_at_identifier(parser, "def"):
            declarations.append(model_hir_module_module.Function(parser_function_declaration(parser, [])))
        elif parser_at_symbol(parser, "@"):
            decorators: list[model_syntax_function_syntax.Decorator] = []
            while parser_at_symbol(parser, "@"):
                decorators.append(parser_scalar_decorator(parser))
            if parser_at_identifier(parser, "class"):
                declaration = parser_record_declaration(parser)
                declaration.decorators = decorators
                declarations.append(model_hir_module_module.Record(declaration))
            elif parser_at_identifier(parser, "trait"):
                declarations.append(model_hir_module_module.Trait(parser_trait_declaration(parser, decorators)))
            elif parser_at_identifier(parser, "def"):
                declarations.append(model_hir_module_module.Function(parser_function_declaration(parser, decorators)))
            else:
                return error(parser_fail(parser, "expected class, trait, or function after decorator"))
        elif parser_at_identifier(parser, "operator"):
            operation = parser_operator_declaration(parser)
            operation.receiver = false
            declarations.append(model_hir_module_module.OperatorItem(operation))
        elif parser_at_identifier(parser, "union"):
            declarations.append(model_hir_module_module.Item.Type(parser_family_declaration(parser)))
        elif parser_at_identifier(parser, "type") and parser.cursor[0] + 1 < len(parser.tokens) and not lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "("):
            declarations.append(model_hir_module_module.Item.Type(parser_type_declaration(parser, [])))
        elif parser_at_type_alias(parser):
            declarations.append(model_hir_module_module.Item.Type(parser_type_alias(parser, [])))
        else:
            statements.append(parser_block_statement(parser))
        parser_separators(parser)
    return model_syntax_function_syntax.CompilerTestCase(expectation, None, model_syntax_block_block.Block(statements), span, declarations=declarations)

def parser_indented_block(parser: Parser, owner: string) -> tuple[model_syntax_block_block.Block, u32] | diagnostics.Diagnostic:
    parser_expect(parser, Newline, "expected newline after " + owner)
    while parser_take(parser, Newline) != None:
        throw diagnostics.diagnostic("E000113", "unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    start = parser_expect(parser, Indent, "expected indented " + owner + " body").span
    statements: list[model_syntax_sentence_sentence.Statement] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        statements.append(parser_block_statement(parser))
        parser_separators(parser)
    end = parser_expect(parser, Dedent, "expected end of " + owner + " body").span.end
    return (model_syntax_block_block.Block(statements, [], [], source.Span(start.source, start.start, end)), end)


class LoopInitializer:
    binding: model_syntax_sentence_sentence.Binding | None = None


def parser_loop_initializer(parser: Parser) -> LoopInitializer | diagnostics.Diagnostic:
    if parser_at_identifier(parser, "with"):
        parser_next(parser)
        return LoopInitializer(parser_binding(parser))
    return LoopInitializer()


def parser_initialized_loop(loop: model_syntax_sentence_sentence.Statement, initializer: LoopInitializer, span: source.Span) -> model_syntax_sentence_sentence.Statement:
    binding ?= initializer.binding
    if binding != None:
        # The initializer runs once in a scope enclosing the whole loop.
        scope = model_syntax_block_block.Block([model_syntax_sentence_sentence.BindingStatement(binding), loop], span=span)
        taken = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), span)
        return model_syntax_sentence_sentence.Statement.If(taken, scope, model_syntax_block_block.Block(), span)
    return loop


def parser_block_statement(parser: Parser) -> model_syntax_sentence_sentence.Statement | diagnostics.Diagnostic:
    if parser_at_identifier(parser, "defer"):
        start = parser_next(parser).span
        value = parser_expression(parser, 0)
        match value.kind:
            case Call:
                return model_syntax_sentence_sentence.Defer(value, source.Span(start.source, start.start, value.span.end))
            case _:
                return error(parser_fail(parser, "defer requires a call"))
    if parser_at_identifier(parser, "unsafe"):
        start = parser_next(parser).span
        parser_expect_symbol(parser, ":", "expected colon after unsafe")
        body = parser_indented_block(parser, "unsafe")
        return model_syntax_sentence_sentence.Unsafe(body[0], source.Span(start.source, start.start, body[1]))
    if parser_at_identifier(parser, "reject") or parser_at_identifier(parser, "accept"):
        rejected = parser_at_identifier(parser, "reject")
        start = parser_next(parser).span
        parser_expect_symbol(parser, ":", "expected colon after compiler expectation")
        body = parser_indented_block(parser, "compiler expectation")
        return model_syntax_sentence_sentence.CompilerCheck(rejected, body[0], source.Span(start.source, start.start, body[1]))
    if parser_at_identifier(parser, "drop"):
        start = parser_next(parser).span
        value = parser_expression(parser, 0)
        return model_syntax_sentence_sentence.Drop(value, source.Span(start.source, start.start, value.span.end))
    for syntax in parser_peek(parser).syntaxes:
        if syntax.grammar_form in ["Body", "ConditionBody"]:
            start = parser_next(parser).span
            operands: list[model_syntax_function_function.Expression] = []
            if syntax.grammar_form == "ConditionBody":
                operands.append(parser_expression(parser, 0))
            parser_expect_symbol(parser, ":", "expected colon after grammar operands")
            body = parser_indented_block(parser, syntax.grammar_name)
            return model_syntax_sentence_sentence.GrammarApply(syntax, operands, [body[0]], source.Span(start.source, start.start, body[1]), false)
    if parser_at_identifier(parser, "match"):
        return parser_match_statement(parser)
    if parser_at_identifier(parser, "while"):
        start = parser_next(parser).span
        condition = parser_expression(parser, 0)
        initializer = parser_loop_initializer(parser)
        parser_expect_symbol(parser, ":", "expected colon after while condition")
        body = parser_indented_block(parser, "while")
        span = source.Span(start.source, start.start, body[1])
        loop: model_syntax_sentence_sentence.Statement = model_syntax_sentence_sentence.Statement.While(condition, body[0], span)
        return parser_initialized_loop(loop, initializer, span)
    if parser_at_identifier(parser, "break"):
        return model_syntax_sentence_sentence.Statement.Break(parser_next(parser).span)
    if parser_at_identifier(parser, "continue"):
        return model_syntax_sentence_sentence.Statement.Continue(parser_next(parser).span)
    if parser_at_identifier(parser, "for"):
        start = parser_next(parser).span
        name = parser_identifier(parser, "expected iteration binding")[0]
        if not parser_at_identifier(parser, "in"):
            return error(parser_fail(parser, "expected in after iteration binding"))
        parser_next(parser)
        iterable = parser_expression(parser, 0)
        initializer = parser_loop_initializer(parser)
        parser_expect_symbol(parser, ":", "expected colon after iterable")
        body = parser_indented_block(parser, "for")
        span = source.Span(start.source, start.start, body[1])
        return parser_initialized_loop(model_syntax_sentence_sentence.ForEach(name, iterable, body[0], span), initializer, span)
    if parser_at_identifier(parser, "if"):
        return parser_conditional(parser)
    if parser_at_identifier(parser, "throw"):
        start = parser_next(parser).span
        value = parser_expression(parser, 0)
        return model_syntax_sentence_sentence.Statement.Throw(value, source.Span(start.source, start.start, value.span.end))
    if parser_at_identifier(parser, "return"):
        start = parser_next(parser).span
        if parser_at_simple(parser, Newline) or parser_at_simple(parser, Dedent):
            return model_syntax_sentence_sentence.Statement.Return(None, start)
        value = parser_expression(parser, 0)
        return model_syntax_sentence_sentence.Statement.Return(value, source.Span(start.source, start.start, value.span.end))
    if parser_at_identifier(parser, "assert"):
        start = parser_next(parser).span
        if parser_at_symbol(parser, "("):
            parser.cursor[0] -= 1
            invocation = parser_postfix(parser)
            return model_syntax_sentence_sentence.ExpressionStatement(invocation)
        condition = parser_expression(parser, 0)
        message: model_syntax_function_function.Expression | None := None
        if parser_take_symbol(parser, ",") != None:
            message = parser_expression(parser, 0)
        return model_syntax_sentence_sentence.Assert(condition, message, source.Span(start.source, start.start, condition.span.end), condition.span)
    return parser_simple_statement(parser)

def parser_match_statement(parser: Parser) -> model_syntax_sentence_sentence.Statement | diagnostics.Diagnostic:
    start = parser_next(parser).span
    subject = parser_expression(parser, 0)
    parser_expect_symbol(parser, ":", "expected colon after match subject")
    parser_expect(parser, Newline, "expected newline after match subject")
    parser_separators(parser)
    parser_expect(parser, Indent, "expected indented match arms")
    arms: list[model_syntax_sentence_sentence.MatchArm] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        arm_start = parser_peek(parser).span
        if not parser_at_identifier(parser, "case"):
            return error(parser_fail(parser, "expected case before match pattern"))
        parser_next(parser)
        capture: string | None := None
        annotation: model_syntax_type_annotation.TypeAnnotation | None := None
        pattern: model_syntax_function_function.Expression | None := None
        if parser_at_identifier(parser, "_"):
            parser_next(parser)
        else:
            pattern = parser_expression(parser, 0)
        parser_expect_symbol(parser, ":", "expected colon after match pattern")
        if not parser_at_simple(parser, Newline):
            capture = "_"
            supplied ?= pattern
            if supplied != None:
                match supplied.kind:
                    case Name:
                        capture = name
                    case _:
                        return error(parser_fail(parser, "typed capture requires a binding name"))
            annotation = parser_type_annotation(parser)
            pattern = None
            parser_expect_symbol(parser, ":", "expected colon after capture type")
        body = parser_indented_block(parser, "match arm")
        arms.append(model_syntax_sentence_sentence.MatchArm(body[0], binding_name=capture, annotation=annotation, span=arm_start, pattern=pattern))
        parser_separators(parser)
    end = parser_expect(parser, Dedent, "expected end of match").span.end
    return model_syntax_sentence_sentence.Match(subject, arms, source.Span(start.source, start.start, end))

def parser_simple_statement(parser: Parser) -> model_syntax_sentence_sentence.Statement | diagnostics.Diagnostic:
    if parser_looks_like_binding(parser):
        return model_syntax_sentence_sentence.BindingStatement(parser_binding(parser))
    value = parser_expression(parser, 0)
    assignment = parser_peek(parser)
    update: model_syntax_function_syntax.OperatorSyntax | None := None
    for syntax in assignment.syntaxes:
        if syntax.grammar_form == "Assignment":
            update = syntax
    if lexer.token_is_symbol(assignment, "=") or update != None:
        parser_next(parser)
        rhs = parser_expression(parser, 0)
        return model_syntax_sentence_sentence.FieldSet(value, rhs, value.span, update)
    if parser_take_symbol(parser, ":") != None:
        parser_expect(parser, Newline, "expected newline after call block")
        statements: list[model_syntax_sentence_sentence.Statement] = [model_syntax_sentence_sentence.ExpressionStatement(value)]
        if parser_take(parser, Indent) != None:
            parser_separators(parser)
            while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
                statements.append(parser_block_statement(parser))
                parser_separators(parser)
            parser_expect(parser, Dedent, "expected end of call block")
        condition = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), value.span)
        return model_syntax_sentence_sentence.Statement.If(condition, model_syntax_block_block.Block(statements), model_syntax_block_block.Block(), value.span)
    return model_syntax_sentence_sentence.ExpressionStatement(value)

def parser_looks_like_binding(parser: Parser) -> bool:
    if parser.cursor[0] + 1 >= len(parser.tokens):
        return false
    match parser.tokens[parser.cursor[0]].kind:
        case Identifier:
            next = parser.tokens[parser.cursor[0] + 1]
            match next.kind:
                case Identifier:
                    if parser.cursor[0] + 2 < len(parser.tokens):
                        return lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 2], "=")
                case _:
                    throw Error("unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
            return lexer.token_is_symbol(next, "=") or lexer.token_is_symbol(next, "?=") or lexer.token_is_symbol(next, ":=") or lexer.token_is_symbol(next, ":")
        case _:
            throw Error("unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    return false

def parser_binding(parser: Parser) -> model_syntax_sentence_sentence.Binding | diagnostics.Diagnostic:
    start = parser_peek(parser).span
    name := parser_identifier(parser, "expected binding name")[0]
    annotation: model_syntax_type_annotation.TypeAnnotation | None := None
    match parser_peek(parser).kind:
        case Identifier:
            annotation = model_syntax_type_annotation.named_type(name, [], start)
            name = parser_identifier(parser, "expected binding name after type")[0]
        case _:
            throw diagnostics.diagnostic("E000113", "unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    if parser_take_symbol(parser, ":") != None:
        annotation = parser_type_annotation(parser)
    inferred = parser_take_symbol(parser, ":=") != None
    preserve_error = not inferred and parser_take_symbol(parser, "?=") != None
    if not inferred and not preserve_error:
        parser_expect_symbol(parser, "=", "expected `=`, `?=`, or `:=` after binding name")
    value = parser_expression(parser, 0)
    return model_syntax_sentence_sentence.Binding(name, annotation, value, false, preserve_error, source.Span(start.source, start.start, value.span.end), mutable=inferred)

def parser_expression(parser: Parser, minimum: int) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    return parse_expression(parser, minimum)

def parser_unary(parser: Parser) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    return parse_unary(parser)

def parser_postfix(parser: Parser) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    return parse_postfix(parser)

def parser_primary(parser: Parser) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    return parse_primary(parser)

def parser_type_annotation(parser: Parser) -> model_syntax_type_annotation.TypeAnnotation | diagnostics.Diagnostic:
    return parse_type_annotation(parser)

def parser_type_primary(parser: Parser) -> model_syntax_type_annotation.TypeAnnotation | diagnostics.Diagnostic:
    return parse_type_primary(parser)

def parse_expression(parser: Parser, minimum: int) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    left := parser_unary(parser)
    while true:
        if parser_at_identifier(parser, "not") and parser.cursor[0] + 1 < len(parser.tokens):
            following = parser.tokens[parser.cursor[0] + 1]
            if string(following) == "in" and is_binary_operator(following):
                operator = binary_operator(following)
                if precedence(operator) < minimum:
                    break
                negation = parser_next(parser)
                parser_next(parser)
                prefix ?= token_operator(negation, model_syntax_function_syntax.Fixity.Prefix)
                if prefix != None:
                    right = parse_expression(parser, precedence(operator) + 1)
                    span = source.Span(left.span.source, left.span.start, right.span.end)
                    membership = model_syntax_function_function.Expression(model_syntax_function_function.Binary(operator, left, right), span)
                    left = model_syntax_function_function.Expression(model_syntax_function_function.Unary(prefix, membership), span)
                    continue
                return error(parser_fail(parser, "not in requires a negation operator"))
        if not is_binary_operator(parser_peek(parser)):
            break
        operator = binary_operator(parser_peek(parser))
        operator_precedence = precedence(operator)
        if operator_precedence < minimum:
            break
        token = parser_next(parser)
        next_minimum := operator_precedence
        if operator.associativity != model_syntax_function_syntax.Associativity.Right:
            next_minimum += 1
        right = parse_expression(parser, next_minimum)
        if operator.symbol in ["<", "<=", ">", ">=", "==", "!="]:
            operands = [left, right]
            operators = [operator]
            while is_binary_operator(parser_peek(parser)):
                following = binary_operator(parser_peek(parser))
                if following.symbol not in ["<", "<=", ">", ">=", "==", "!="] or precedence(following) != operator_precedence:
                    break
                parser_next(parser)
                operands.append(parse_expression(parser, operator_precedence + 1))
                operators.append(following)
            if len(operators) > 1:
                left = model_syntax_function_function.Expression(model_syntax_function_function.ComparisonChain(operands, operators), source.Span(token.span.source, left.span.start, operands[-1].span.end))
                continue
        left = model_syntax_function_function.Expression(model_syntax_function_function.Binary(operator, left, right), source.Span(token.span.source, left.span.start, right.span.end))
    if minimum == 0 and parser_at_identifier(parser, "if"):
        parser_next(parser)
        condition = parse_expression(parser, 1)
        if not parser_at_identifier(parser, "else"):
            return error(parser_fail(parser, "conditional expression requires else"))
        parser_next(parser)
        otherwise = parse_expression(parser, 0)
        return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Conditional(condition, left, otherwise), source.Span(left.span.source, left.span.start, otherwise.span.end))
    if minimum == 0 and parser_at_identifier(parser, "else"):
        parser_next(parser)
        otherwise = parse_expression(parser, 0)
        return model_syntax_function_function.Expression(model_syntax_function_function.Fallback(left, otherwise), source.Span(left.span.source, left.span.start, otherwise.span.end))
    return left


def parse_unary(parser: Parser) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    token = parser_peek(parser)
    if parser_at_identifier(parser, "lambda"):
        parser_next(parser)
        parameters: list[string] = []
        while not parser_at_symbol(parser, ":"):
            parameter = parser_identifier(parser, "expected lambda parameter")[0]
            if parameter in parameters:
                return error(parser_fail(parser, "duplicate lambda parameter"))
            parameters.append(parameter)
            if parser_take_symbol(parser, ",") == None:
                break
        parser_expect_symbol(parser, ":", "expected : before lambda body")
        body = parse_expression(parser, 0)
        return model_syntax_function_function.Expression(model_syntax_function_function.Lambda(parameters, body), source.Span(token.span.source, token.span.start, body.span.end))
    # Parenthesized calls keep ordinary callable lookup; prefix ownership forms
    # carry their operation explicitly through parsing and semantic analysis.
    if parser_at_identifier(parser, "view") or parser_at_identifier(parser, "borrow") or parser_at_identifier(parser, "move") or parser_at_identifier(parser, "copy") or parser_at_identifier(parser, "clone") or parser_at_identifier(parser, "mirror"):
        if parser.cursor[0] + 1 < len(parser.tokens) and not lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "("):
            mode := string(parser_next(parser))
            if mode == "view":
                mode = "borrow"
            elif mode == "borrow":
                if parser_at_identifier(parser, "mut"):
                    parser_next(parser)
                mode = "borrow mut"
            elif mode == "copy":
                mode = "clone"
            value = parse_unary(parser)
            return model_syntax_function_function.Expression(model_syntax_function_function.Ownership(mode, value), source.Span(token.span.source, token.span.start, value.span.end))
    if parser_take_symbol(parser, "&") != None:
        value = parse_unary(parser)
        return model_syntax_function_function.Expression(model_syntax_function_function.AddressOf(value), source.Span(token.span.source, token.span.start, value.span.end))
    operator = token_operator(token, model_syntax_function_syntax.Fixity.Prefix)
    selected ?= operator
    if selected != None:
        parser_next(parser)
        operand = parse_unary(parser)
        return model_syntax_function_function.Expression(model_syntax_function_function.Unary(selected, operand), source.Span(token.span.source, token.span.start, operand.span.end))
    return parser_postfix(parser)


def parse_postfix(parser: Parser) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    value := parser_primary(parser)
    continuation := false
    while true:
        if parser_at_simple(parser, Newline):
            cursor := parser.cursor[0] + 1
            if cursor < len(parser.tokens) and parser.tokens[cursor].kind == Indent:
                cursor += 1
            if cursor < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[cursor], "."):
                continuation = continuation or cursor > parser.cursor[0] + 1
                parser.cursor[0] = cursor
        if parser_take_symbol(parser, "(") != None:
            throws_call := false
            mock_call := false
            match value.kind:
                case Name:
                    throws_call = name == "throws"
                    mock_call = name == "mock"
                case _:
                    throw diagnostics.diagnostic("E000113", "unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
            if mock_call:
                calls: list[model_syntax_function_function.Expression] = []
                results: list[model_syntax_function_function.Expression] = []
                parser_delimited_layout(parser)
                while not parser_at_identifier(parser, "else"):
                    if parser_at_symbol(parser, ")"):
                        return error(parser_fail(parser, "mock requires an else fallback"))
                    calls.append(parse_expression(parser, 0))
                    parser_expect_symbol(parser, "->", "expected -> after mocked invocation")
                    results.append(parse_expression(parser, 0))
                    parser_delimited_layout(parser)
                    parser_take_symbol(parser, ",")
                    parser_delimited_layout(parser)
                parser_next(parser)
                fallback = parse_expression(parser, 0)
                parser_delimited_layout(parser)
                end = parser_expect_symbol(parser, ")", "expected ) after mock rules").span.end
                value = model_syntax_function_function.Expression(model_syntax_function_function.MockValue(calls, results, fallback), source.Span(value.span.source, value.span.start, end))
                continue
            arguments: list[model_syntax_function_function.CallArgument] = []
            parser_delimited_layout(parser)
            while not parser_at_symbol(parser, ")"):
                start = parser_peek(parser).span
                argument_name: string | absent := absent
                if parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "="):
                    argument_name = parser_identifier(parser, "expected argument name")[0]
                    parser_expect_symbol(parser, "=", "expected = after argument name")
                spread = parser_take_symbol(parser, "...") != None
                argument = parse_expression(parser, 0)
                arguments.append(model_syntax_function_function.CallArgument(argument_name, argument, source.Span(start.source, start.start, argument.span.end), spread=spread))
                parser_delimited_layout(parser)
                if throws_call and parser_take_symbol(parser, "->") != None:
                    expected = parse_expression(parser, 0)
                    arguments.append(model_syntax_function_function.CallArgument("$error", expected, expected.span))
                    parser_delimited_layout(parser)
                if parser_take_symbol(parser, ",") == None:
                    break
                parser_delimited_layout(parser)
            end = parser_expect_symbol(parser, ")", "expected closing parenthesis").span.end
            value = model_syntax_function_function.Expression(model_syntax_function_function.Call(value, arguments), source.Span(value.span.source, value.span.start, end))
        elif parser_take_symbol(parser, "[") != None:
            # Commas distinguish a generic application from an index or slice.
            # A single colon remains a slice syntactically; declaration lookup
            # disambiguates it when the receiver is a type constructor.
            if parser_multiple_type_arguments(parser):
                types = parser_type_arguments(parser)
                end = parser_expect_symbol(parser, "]", "expected closing type bracket").span.end
                value = model_syntax_function_function.Expression(model_syntax_function_function.TypeApplication(value, types), source.Span(value.span.source, value.span.start, end))
                continue
            first: model_syntax_function_function.Expression | None := None
            if parser_at_symbol(parser, "]"):
                first = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.IntegerValue("0")), parser_peek(parser).span)
            elif not parser_at_symbol(parser, ":"):
                first = parse_expression(parser, 0)
            if parser_take_symbol(parser, ":") != None:
                stop: model_syntax_function_function.Expression | None := None
                step: model_syntax_function_function.Expression | None := None
                if not parser_at_symbol(parser, ":") and not parser_at_symbol(parser, "]"):
                    stop = parse_expression(parser, 0)
                if parser_take_symbol(parser, ":") != None:
                    if not parser_at_symbol(parser, "]"):
                        step = parse_expression(parser, 0)
                end = parser_expect_symbol(parser, "]", "expected closing slice bracket").span.end
                value = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Slice(value, first, stop, step), source.Span(value.span.source, value.span.start, end))
                continue
            index ?= first
            if index != None:
                end = parser_expect_symbol(parser, "]", "expected closing subscript bracket").span.end
                value = model_syntax_function_function.Expression(model_syntax_function_function.Subscript(value, index), source.Span(value.span.source, value.span.start, end))
            else:
                return error(parser_fail(parser, "expected a subscript index"))
        elif parser_take_symbol(parser, ".") != None:
            member = parser_identifier(parser, "expected member name")
            value = model_syntax_function_function.Expression(model_syntax_function_function.Member(value, member[0]), source.Span(value.span.source, value.span.start, member[1].end))
        else:
            break
    if continuation:
        cursor := parser.cursor[0]
        while cursor < len(parser.tokens) and parser.tokens[cursor].kind == Newline:
            cursor += 1
        if cursor < len(parser.tokens) and parser.tokens[cursor].kind == Dedent:
            parser.cursor[0] = cursor + 1
    return value


def parse_primary(parser: Parser) -> model_syntax_function_function.Expression | diagnostics.Diagnostic:
    if parser_at_identifier(parser, "match"):
        statement = parser_match_statement(parser)
        match statement:
            case Match:
                return model_syntax_function_function.Expression(model_syntax_function_function.MatchExpression(subject, arms), span)
            case _:
                return error(parser_fail(parser, "expected match expression"))
    token = parser_next(parser)
    for syntax in token.syntaxes:
        if syntax.grammar_form == "Delimited" and lexer.token_is_symbol(token, syntax.symbol):
            arguments: list[model_syntax_function_function.CallArgument] = []
            separated := false
            parser_delimited_layout(parser)
            while not parser_at_symbol(parser, syntax.closing):
                value = parse_expression(parser, 0)
                arguments.append(model_syntax_function_function.CallArgument(None, value, value.span))
                parser_delimited_layout(parser)
                if parser_take_symbol(parser, syntax.separator) == None:
                    break
                separated = true
                parser_delimited_layout(parser)
            end = parser_expect_symbol(parser, syntax.closing, "expected closing " + syntax.closing).span.end
            span = source.Span(token.span.source, token.span.start, end)
            if syntax.grouping and len(arguments) == 1 and not separated:
                grouped := arguments[0].value
                grouped.span = span
                grouped.grammar = syntax.definition
                return grouped
            callee := model_syntax_function_function.Expression(model_syntax_function_function.SourceSymbol(syntax.grammar_name, syntax.definition), token.span)
            if syntax.constructor != "":
                callee = model_syntax_function_function.Expression(model_syntax_function_function.Name(syntax.constructor), token.span)
            return model_syntax_function_function.Expression(model_syntax_function_function.Call(callee, arguments), span, grammar=syntax.definition)
    match token.kind:
        case Identifier:
            value = string(token)
            if value == "throw":
                raised = parse_expression(parser, 0)
                return model_syntax_function_function.Expression(model_syntax_function_function.ThrowValue(raised), source.Span(token.span.source, token.span.start, raised.span.end))
            if value == "true":
                return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(true)), token.span, literal=lexer.token_literal(token))
            if value == "false":
                return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.BooleanValue(false)), token.span, literal=lexer.token_literal(token))
            if value == "None":
                return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.LiteralValue.NoneValue), token.span, literal=lexer.token_literal(token))
            if value == "absent":
                return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.LiteralValue.AbsentValue), token.span, literal=lexer.token_literal(token))
            return model_syntax_function_function.Expression(model_syntax_function_function.Name(value), token.span)
        case Integer:
            value = lexer.token_number(token)
            return parser_numeric_suffix(parser, token, model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.IntegerValue(value)), token.span, literal=lexer.token_literal(token)))
        case Float:
            value = lexer.token_number(token)
            return parser_numeric_suffix(parser, token, model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.FloatValue(value)), token.span, literal=lexer.token_literal(token)))
        case Character:
            value = lexer.literal_codepoint(string(token))
            return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.CharacterValue(value)), token.span, literal=lexer.token_literal(token))
        case String:
            value = string(token)
            return model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_literal_value.StringValue(value)), token.span, literal=lexer.token_literal(token))
        case FormattedString:
            value = string(token)
            return formatted_string_expression(value, token.span, token.syntaxes, token.lexical_rules)
        case _:
            throw diagnostics.diagnostic("E000113", "unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    if lexer.token_is_symbol(token, "["):
        elements: list[model_syntax_function_function.Expression] = []
        parser_delimited_layout(parser)
        while not parser_at_symbol(parser, "]"):
            elements.append(parse_expression(parser, 0))
            parser_delimited_layout(parser)
            if parser_take_symbol(parser, ",") == None:
                break
            parser_delimited_layout(parser)
        end = parser_expect_symbol(parser, "]", "expected closing list bracket").span.end
        return model_syntax_function_function.Expression(model_syntax_function_function.ListLiteral(elements), source.Span(token.span.source, token.span.start, end))
    if lexer.token_is_symbol(token, "{"):
        keys: list[model_syntax_function_function.Expression] = []
        values: list[model_syntax_function_function.Expression] = []
        parser_delimited_layout(parser)
        while not parser_at_symbol(parser, "}"):
            keys.append(parse_expression(parser, 0))
            parser_expect_symbol(parser, ":", "expected colon after map key")
            values.append(parse_expression(parser, 0))
            parser_delimited_layout(parser)
            if parser_take_symbol(parser, ",") == None:
                break
            parser_delimited_layout(parser)
        end = parser_expect_symbol(parser, "}", "expected closing map brace").span.end
        return model_syntax_function_function.Expression(model_syntax_function_function.MapLiteral(keys, values), source.Span(token.span.source, token.span.start, end))
    if lexer.token_is_symbol(token, "("):
        expression = parse_expression(parser, 0)
        parser_expect_symbol(parser, ")", "expected closing parenthesis")
        return expression
    return error(diagnostics.Diagnostic("E000120", "expected an expression", token.span))


def parser_numeric_suffix(parser: Parser, number: lexer.Token, value: model_syntax_function_function.Expression) -> model_syntax_function_function.Expression:
    suffix = parser_peek(parser)
    if suffix.kind == TokenKind.Identifier and suffix.span.start == number.span.end:
        parser_next(parser)
        name = model_syntax_function_function.Expression(model_syntax_function_function.Name("literal_" + string(suffix)), suffix.span)
        span = source.Span(number.span.source, number.span.start, suffix.span.end)
        return model_syntax_function_function.Expression(model_syntax_function_function.Call(name, [model_syntax_function_function.CallArgument(None, value, value.span)]), span)
    return value


def parse_type_annotation(parser: Parser) -> model_syntax_type_annotation.TypeAnnotation | diagnostics.Diagnostic:
    first = parser_type_primary(parser)
    if parser_take_symbol(parser, "|") == None:
        return first
    members: list[model_syntax_type_annotation.TypeAnnotation] = [first]
    while true:
        members.append(parser_type_primary(parser))
        if parser_take_symbol(parser, "|") == None:
            break
    return model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Union(members), source.Span(first.span.source, first.span.start, members[-1].span.end))


def parser_multiple_type_arguments(parser: Parser) -> bool:
    depth := 0
    cursor := parser.cursor[0]
    while cursor < len(parser.tokens):
        token = parser.tokens[cursor]
        if lexer.token_is_symbol(token, "]") and depth == 0:
            return false
        if lexer.token_is_symbol(token, ",") and depth == 0:
            return true
        if lexer.token_is_symbol(token, "[") or lexer.token_is_symbol(token, "(") or lexer.token_is_symbol(token, "{"):
            depth += 1
        elif lexer.token_is_symbol(token, "]") or lexer.token_is_symbol(token, ")") or lexer.token_is_symbol(token, "}"):
            depth -= 1
        cursor += 1
    return false


def parser_type_arguments(parser: Parser) -> list[model_syntax_type_annotation.TypeAnnotation] | diagnostics.Diagnostic:
    arguments: list[model_syntax_type_annotation.TypeAnnotation] = []
    parser_delimited_layout(parser)
    while not parser_at_symbol(parser, "]"):
        binding := ""
        if parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], ":"):
            binding = parser_identifier(parser, "expected type parameter name")[0]
            parser_next(parser)
        argument = parse_type_annotation(parser)
        argument.binding = binding
        arguments.append(argument)
        parser_delimited_layout(parser)
        if parser_take_symbol(parser, ",") == None:
            break
        parser_delimited_layout(parser)
    return arguments


def parse_type_primary(parser: Parser) -> model_syntax_type_annotation.TypeAnnotation | diagnostics.Diagnostic:
    if parser_at_simple(parser, Integer):
        token = parser_next(parser)
        return model_syntax_type_annotation.named_type(lexer.token_number(token), [], token.span)
    if parser_at_symbol(parser, "{"):
        start = parser_next(parser).span
        key = parse_type_annotation(parser)
        parser_expect_symbol(parser, ":", "expected colon in map type")
        value = parse_type_annotation(parser)
        end = parser_expect_symbol(parser, "}", "expected closing map type brace").span.end
        return model_syntax_type_annotation.named_type("map", [key, value], source.Span(start.source, start.start, end))
    name = parser_identifier(parser, "expected a type name")
    qualified := name[0]
    while parser_take_symbol(parser, ".") != None:
        qualified += "." + parser_identifier(parser, "expected qualified type name")[0]
    arguments: list[model_syntax_type_annotation.TypeAnnotation] := []
    end := name[1].end
    if parser_take_symbol(parser, "[") != None:
        arguments = parser_type_arguments(parser)
        end = parser_expect_symbol(parser, "]", "expected closing type bracket").span.end
    return model_syntax_type_annotation.named_type(qualified, arguments, source.Span(name[1].source, name[1].start, end))


def token_operator(token: lexer.Token, fixity: model_syntax_function_syntax.Fixity) -> model_syntax_function_syntax.OperatorSyntax | None:
    # Formatted literals carry the registry for their embedded expressions;
    # that registry does not make the literal itself an operator.
    match token.kind:
        case FormattedString:
            return None
        case _:
            throw Error("unimplemented (sev_compiler/frontend/parser/parser/src/statement/mod.sev)")
    for syntax in token.syntaxes:
        if syntax.fixity == fixity and (syntax.grammar_form == "" or syntax.grammar_form == "Infix" or syntax.grammar_form == "Prefix" or syntax.grammar_form == "Postfix"):
            return syntax
    return None


def is_binary_operator(token: lexer.Token) -> bool:
    return token_operator(token, model_syntax_function_syntax.Fixity.Infix) != None


def binary_operator(token: lexer.Token) -> model_syntax_function_syntax.OperatorSyntax:
    syntax ?= token_operator(token, model_syntax_function_syntax.Fixity.Infix)
    if syntax != None:
        return syntax
    throw Error("token has no registered infix operator")


def precedence(operator: model_syntax_function_syntax.OperatorSyntax) -> int:
    return int(operator.precedence)


def parse(tokens: list[lexer.Token]) -> model_hir_module_module.Module | diagnostics.Diagnostic:
    return parser_module(Parser(tokens))


# Named declaration syntax is supplied by a G contract. The structural parser
# only distinguishes typed fields from named callable signatures.
def parser_declaration_syntax(parser: Parser) -> model_syntax_function_syntax.OperatorSyntax:
    token = parser_peek(parser)
    for syntax in token.syntaxes:
        if syntax.grammar_form == "Declaration" and string(token) == syntax.symbol and (token.kind == Identifier or token.kind == Symbol):
            return syntax
    return model_syntax_function_syntax.OperatorSyntax("", model_syntax_function_syntax.Fixity.Prefix, 0, model_syntax_function_syntax.Associativity.None)


def parser_named_declaration(parser: Parser, syntax: model_syntax_function_syntax.OperatorSyntax) -> model_syntax_function_function.RecordDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a declaration name")[0]
    parser_expect_symbol(parser, ":", "expected colon after declaration name")
    parser_expect(parser, Newline, "expected newline after declaration name")
    parser_separators(parser)
    parser_expect(parser, Indent, "expected indented declaration members")
    alternatives: list[model_syntax_function_function.CallableAlternative] = []
    fields: list[model_syntax_function_function.FunctionParameter] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        member = parser_identifier(parser, "expected a declaration member")
        if syntax.declaration_members == "Fields":
            fields.append(parser_named_field(parser, member))
        else:
            parameters: list[model_syntax_function_function.FunctionParameter] = []
            if parser_take_symbol(parser, "(") != None:
                parser_delimited_layout(parser)
                while not parser_at_symbol(parser, ")"):
                    field = parser_identifier(parser, "expected a parameter name")
                    parameters.append(parser_named_field(parser, field))
                    parser_delimited_layout(parser)
                    if parser_take_symbol(parser, ",") == None:
                        break
                    parser_delimited_layout(parser)
                parser_expect_symbol(parser, ")", "expected closing parameter parenthesis")
            transitions: list[string] = []
            if parser_take_symbol(parser, "->") != None:
                while true:
                    transitions.append(parser_identifier(parser, "expected transition destination")[0])
                    if parser_take_symbol(parser, "|") == None:
                        break
            alternatives.append(model_syntax_function_function.CallableAlternative(member[0], parameters, member[1], transitions=transitions))
        parser_expect(parser, Newline, "expected newline after declaration member")
        parser_separators(parser)
    end = parser_expect(parser, Dedent, "expected end of declaration").span.end
    if syntax.representation == "TaggedAggregate" and len(alternatives) == 0:
        return error(parser_fail(parser, "tagged type requires at least one alternative"))
    return model_syntax_function_function.RecordDeclaration(name, fields, [], source.Span(start.source, start.start, end), alternatives=alternatives, representation=syntax.representation, declaration_grammar=syntax.definition)


def parser_named_field(parser: Parser, field: tuple[string, source.Span]) -> model_syntax_function_function.FunctionParameter | diagnostics.Diagnostic:
    parser_expect_symbol(parser, ":", "expected field annotation")
    annotation = parser_type_annotation(parser)
    default: model_syntax_function_function.Expression | absent := absent
    if parser_take_symbol(parser, "=") != None:
        default = parser_expression(parser, 0)
    return model_syntax_function_function.FunctionParameter(field[0], annotation, default, field[1])


def parser_field_constraints(parser: Parser) -> list[model_syntax_function_function.FieldConstraint] | diagnostics.Diagnostic:
    constraints: list[model_syntax_function_function.FieldConstraint] = []
    saved = parser.cursor[0]
    while parser_at_simple(parser, Newline):
        parser_next(parser)
    if parser_take_symbol(parser, "{") == None:
        parser.cursor[0] = saved
        return constraints
    parser_delimited_layout(parser)
    while not parser_at_symbol(parser, "}"):
        if parser_at_simple(parser, Eof):
            return error(parser_fail(parser, "expected } to close field constraints"))
        condition = parser_expression(parser, 0)
        parser_delimited_layout(parser)
        failure: model_syntax_function_function.Expression | None := None
        if parser_take_symbol(parser, "->") != None:
            failure = parser_expression(parser, 0)
        constraints.append(model_syntax_function_function.FieldConstraint(condition, failure))
        parser_delimited_layout(parser)
        if parser_take_symbol(parser, ",") == None and not parser_at_symbol(parser, "}"):
            return error(parser_fail(parser, "expected , or } after field constraint"))
        parser_delimited_layout(parser)
    parser_expect_symbol(parser, "}", "expected } after field constraints")
    return constraints


def parser_record_declaration(parser: Parser, extension: bool = false) -> model_syntax_function_function.RecordDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    record_name := ""
    pack: list[string] = []
    defaults: list[model_syntax_type_annotation.TypeAnnotation] = []
    parameters: list[string] := []
    generic_constraints: list[model_syntax_function_syntax.GenericConstraint] := []
    extension_target: model_syntax_type_annotation.TypeAnnotation | None := None
    if extension:
        generic_parts = parser_type_parameters(parser, pack, defaults)
        parameters = generic_parts[0]
        generic_constraints = generic_parts[1]
        for constraint in parser_declaration_constraints(parser):
            generic_constraints.append(constraint)
        target = parser_type_annotation(parser)
        extension_target = target
        match target.kind:
            case Named:
                record_name = name
            case _:
                return error(parser_fail(parser, "expected a named extension target"))
    else:
        record_name = parser_identifier(parser, "expected a class name")[0]
        generic_parts = parser_type_parameters(parser, pack, defaults)
        parameters = generic_parts[0]
        generic_constraints = generic_parts[1]
    parser_expect_symbol(parser, ":", "expected colon after class name")
    traits: list[model_syntax_type_annotation.TypeAnnotation] = []
    if not parser_at_simple(parser, Newline):
        while true:
            traits.append(parser_type_annotation(parser))
            if parser_take_symbol(parser, "+") == None:
                break
        parser_take_symbol(parser, ":")
    parser_separators(parser)
    fields: list[model_syntax_function_function.FunctionParameter] = []
    methods: list[model_syntax_function_function.FunctionDeclaration] = []
    operators: list[model_syntax_function_syntax.OperatorDeclaration] = []
    if parser_take(parser, Indent) != None:
        while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
            if parser_at_identifier(parser, "def"):
                methods.append(parser_function_declaration(parser, []))
            elif parser_at_identifier(parser, "operator"):
                operation = parser_operator_declaration(parser)
                if operation.syntax.symbol == "drop":
                    methods.append(parser_destructor(operation))
                else:
                    operators.append(operation)
            elif parser_at_identifier(parser, "trait"):
                parser_next(parser)
                traits.append(parser_type_annotation(parser))
            else:
                field = parser_identifier(parser, "expected a field or method")
                parser_expect_symbol(parser, ":", "expected field annotation")
                packed = parser_take_symbol(parser, "...") != None
                annotation = parser_type_annotation(parser)
                constraints = parser_field_constraints(parser)
                default: model_syntax_function_function.Expression | None := None
                if parser_take_symbol(parser, "=") != None:
                    default = parser_expression(parser, 0)
                fields.append(model_syntax_function_function.FunctionParameter(field[0], annotation, default, field[1], variadic=packed, field_constraints=constraints))
            parser_separators(parser)
        parser_expect(parser, Dedent, "expected end of class")
    return model_syntax_function_function.RecordDeclaration(record_name, fields, methods, source.Span(start.source, start.start, parser_peek(parser).span.start), traits=traits, operators=operators, type_parameters=parameters, constraints=generic_constraints, extension=extension, type_pack=pack[0] if len(pack) != 0 else "", type_defaults=defaults, extension_target=extension_target)


def parser_family_declaration(parser: Parser) -> model_syntax_function_syntax.TypeDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected family name")[0]
    parser_expect_symbol(parser, ":", "expected family body")
    parser_expect(parser, Newline, "expected family members")
    parser_expect(parser, Indent, "expected indented family")
    members: list[model_syntax_type_annotation.TypeAnnotation] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        members.append(parser_type_annotation(parser))
        parser_separators(parser)
    parser_expect(parser, Dedent, "expected end of family")
    return model_syntax_function_syntax.TypeDeclaration([], name, [], [], model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Union(members), start), start)


def parser_grammar_declaration(parser: Parser) -> model_syntax_grammar_grammar.GrammarDeclaration | diagnostics.Diagnostic:
    start = parser_peek(parser)
    declaration = parser_function_declaration(parser, [])
    if len(declaration.type_parameters) != 1 or declaration.type_parameters[0] != "G" or len(declaration.constraints) != 0:
        return error(parser_fail(parser, "grammar declaration requires [G]"))
    body ?= declaration.body
    if body == None:
        return error(parser_fail(parser, "grammar requires a lowering body"))
    if len(start.syntaxes) != 1:
        return error(parser_fail(parser, "grammar requires registered symbol and form metadata"))
    if body != None:
        syntax = start.syntaxes[0]
        return model_syntax_grammar_grammar.GrammarDeclaration(declaration.name, declaration.parameters, body, start.span, syntax=syntax, definition=syntax.definition, result=declaration.result)
    return error(parser_fail(parser, "grammar requires a lowering body"))


def parser_conditional(parser: Parser) -> model_syntax_sentence_sentence.Statement | diagnostics.Diagnostic:
    start = parser_next(parser).span
    condition = parser_expression(parser, 0)
    parser_expect_symbol(parser, ":", "expected colon after if condition")
    taken = parser_indented_block(parser, "if")
    otherwise := model_syntax_block_block.Block()
    end := taken[1]
    if parser_at_identifier(parser, "elif"):
        otherwise.statements.append(parser_conditional(parser))
        end = parser_peek(parser).span.start
    elif parser_at_identifier(parser, "else"):
        parser_next(parser)
        parser_expect_symbol(parser, ":", "expected colon after else")
        rejected = parser_indented_block(parser, "else")
        otherwise = rejected[0]
        end = rejected[1]
    return model_syntax_sentence_sentence.Statement.If(condition, taken[0], otherwise, source.Span(start.source, start.start, end))


test "MLIR type annotations survive class parsing":
    input = source.virtual_source("type.sev", "@mlir(\"!example.handle\")\nclass Handle:\n    value: int\n")
    parsed = parser_module(Parser(lexer.scan_bootstrap(input)))
    assert(len(parsed.items) == 1)
    match parsed.items[0]:
        case Record:
            binding ?= model_syntax_function_function.record_mlir_binding(declaration)
            assert(binding != None)
            if binding != None:
                assert(binding.spelling == "!example.handle")
        case _:
            assert(false)
