import ProofResult from "../../syntax/constraint/model.sev"
import TokenTerm from "../../syntax/generic/token.sev"
import Block from "../../syntax/block/block.sev"
import TypeDeclaration from "../../syntax/function/syntax.sev"
import Diagnostic from "../../syntax/primitive/error/diagnostic.sev"
import Expression from "../../syntax/function/function.sev"


class GrammarResolution:
    blocks: list[Block] = []
    types: list[TypeDeclaration] = []
    expressions: list[Expression] = []
    nodes: list[ResolvedGrammarNode] = []


class GrammarMatch:
    consumed: int
    # Only the selected candidate may construct HIR.
    construct: () -> GrammarResolution | Diagnostic
    cached: GrammarResolution | Diagnostic | None = None
    check: (() -> ProofResult | Diagnostic) | None = None
    captures: list[CapturedGrammar] = []
    selected: bool = false
    resolving: bool = false
    identity: string = ""

    def admissible() -> ProofResult | Diagnostic:
        if check == None:
            return ProofResult.Proven
        return check()

    def resolve() -> GrammarResolution | Diagnostic:
        if cached != None:
            return cached
        if not selected:
            throw Error("grammar construction requires a selected interpretation")
        if resolving:
            throw Error("cyclic grammar construction")
        resolving = true
        resolved = construct()
        cached = resolved
        resolving = false
        return resolved


((list[TokenTerm]) -> GrammarMatch | None | Diagnostic) as GrammarMatcher


import LiteralValue, ResolvedGrammarNode from "../../syntax/grammar/resolution.sev"

import CapturedGrammar from "sequence.sev"
