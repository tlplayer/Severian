import lexer
from lexer import TokenKind
import diagnostics
import source
import universal
from universal import CompilerExpectation

def formatted_string_expression(value: string, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    characters = value.characters()
    cursor := 0
    literal := ""
    parts: list[universal.Expression] = []
    while cursor < len(characters):
        if characters[cursor] == "{" and cursor + 1 < len(characters) and characters[cursor + 1] == "{":
            literal += "{"
            cursor += 2
            continue
        if characters[cursor] == "}" and cursor + 1 < len(characters) and characters[cursor + 1] == "}":
            literal += "}"
            cursor += 2
            continue
        if characters[cursor] == "}":
            return error(diagnostics.Diagnostic("E000113", "single } in formatted string; write }} for a literal brace", span))
        if characters[cursor] != "{":
            literal += string(characters[cursor])
            cursor += 1
            continue
        if len(literal) > 0:
            parts.append(universal.Expression(universal.LiteralValue(universal.StringValue(literal)), span))
            literal = ""
        expression_start = cursor + 1
        cursor = expression_start
        nesting := 0
        while cursor < len(characters):
            if characters[cursor] == "(" or characters[cursor] == "[":
                nesting += 1
            elif characters[cursor] == ")" or characters[cursor] == "]":
                nesting -= 1
            elif characters[cursor] == "}" and nesting == 0:
                break
            cursor += 1
        if cursor >= len(characters):
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation is missing }", span))
        expression_source = characters[expression_start:cursor].join("").strip()
        if len(expression_source) == 0:
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation may not be empty", span))
        interpolation = source.SourceFile(span.source, "<formatted-string>", expression_source)
        interpolation_tokens = lexer.scan(interpolation)
        expression_parser = Parser(interpolation_tokens)
        parsed_expression = parser_expression(expression_parser, 0)
        parser_separators(expression_parser)
        if not parser_at_simple(expression_parser, Eof):
            return error(diagnostics.Diagnostic("E000113", "unexpected token in formatted string interpolation", span))
        parts.append(universal.Expression(universal.Stringify(parsed_expression), span))
        cursor += 1
    if len(literal) > 0:
        parts.append(universal.Expression(universal.LiteralValue(universal.StringValue(literal)), span))
    if len(parts) == 0:
        return universal.Expression(universal.LiteralValue(universal.StringValue("")), span)
    result := parts[0]
    for part in parts[1:]:
        result = universal.Expression(universal.Binary(universal.operator_syntax(universal.Add()), result, part), span)
    return result

class Parser:
    tokens: list[lexer.Token]
    cursor: list[int] = [0]


# The shared cursor belongs to the parser state. Recursive parsing uses
# ordinary functions so every advance remains an executable mutation.
def parser_peek(parser: Parser) -> lexer.Token:
    return parser.tokens[parser.cursor[0]]

def parser_next(parser: Parser) -> lexer.Token:
    token = parser.tokens[parser.cursor[0]]
    parser.cursor[0] += 1
    return token

def parser_at_identifier(parser: Parser, expected: string) -> bool:
    match parser_peek(parser).kind:
        case Identifier:
            return value == expected
        case _:
            pass
    return false

def parser_at_simple(parser: Parser, expected: lexer.TokenKind) -> bool:
    return parser_peek(parser).kind == expected

def parser_take(parser: Parser, expected: lexer.TokenKind) -> lexer.Token | None:
    if parser_at_simple(parser, expected):
        return parser_next(parser)
    return None

def parser_fail(parser: Parser, message: string) -> diagnostics.Diagnostic:
    return diagnostics.Diagnostic("E000120", message, parser_peek(parser).span)

def parser_identifier(parser: Parser, message: string) -> tuple[string, source.Span] | diagnostics.Diagnostic:
    token = parser_next(parser)
    match token.kind:
        case Identifier:
            return (value, token.span)
        case _:
            pass
    return error(diagnostics.Diagnostic("E000120", message, token.span))

def parser_expect(parser: Parser, expected: lexer.TokenKind, message: string) -> lexer.Token | diagnostics.Diagnostic:
    token ?= parser_take(parser, expected)
    if token != None:
        return token
    return error(parser_fail(parser, message))

def parser_separators(parser: Parser):
    while parser_at_simple(parser, Newline) or parser_at_simple(parser, Comma):
        parser_next(parser)

def parser_module(parser: Parser) -> universal.Module | diagnostics.Diagnostic:
    result = universal.Module([])
    parser_separators(parser)
    while not parser_at_simple(parser, Eof):
        if parser_at_simple(parser, At):
            decorators: list[universal.Decorator] = []
            while parser_at_simple(parser, At):
                decorators.append(parser_scalar_decorator(parser))
            if not parser_at_identifier(parser, "def"):
                return error(parser_fail(parser, "expected function after decorator"))
            result.items.append(universal.Function(parser_function_declaration(parser, decorators)))
        elif parser_at_identifier(parser, "import"):
            result.items.append(universal.Import(parser_import_declaration(parser)))
        elif parser_at_identifier(parser, "trait"):
            result.items.append(universal.Trait(parser_trait_declaration(parser, [])))
        elif parser_at_identifier(parser, "def"):
            result.items.append(universal.Function(parser_function_declaration(parser, [])))
        elif parser_at_identifier(parser, "type"):
            result.items.append(universal.Type(parser_type_declaration(parser, [])))
        elif parser_at_identifier(parser, "test"):
            result.items.append(universal.Test(parser_test_declaration(parser)))
        elif parser_at_identifier(parser, "return") or parser_at_identifier(parser, "break") or parser_at_identifier(parser, "continue"):
            return error(diagnostics.Diagnostic("E000121", "control flow is not valid at module scope", parser_peek(parser).span))
        else:
            statement = parser_simple_statement(parser)
            match statement:
                case BindingStatement:
                    result.items.append(universal.BindingItem(binding))
                case ExpressionStatement:
                    result.items.append(universal.ExpressionItem(expression))
                case _:
                    return error(parser_fail(parser, "expected a module declaration"))
        parser_separators(parser)
    return result

def parser_scalar_decorator(parser: Parser) -> universal.Decorator | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected decorator name")[0]
    parser_expect(parser, LeftParen, "expected decorator arguments")
    arguments: list[universal.DecoratorArgument] = []
    while not parser_at_simple(parser, RightParen):
        argument_name := ""
        if parser.cursor[0] + 1 < len(parser.tokens) and parser.tokens[parser.cursor[0] + 1].kind == Equal:
            argument_name = parser_identifier(parser, "expected argument name")[0]
            parser_next(parser)
        token = parser_next(parser)
        match token.kind:
            case String:
                arguments.append(universal.DecoratorArgument(argument_name, universal.DecoratorValue.String(value), token.span))
            case _:
                return error(parser_fail(parser, "decorator requires string arguments"))
        if parser_take(parser, Comma) == None:
            break
    end = parser_expect(parser, RightParen, "expected closing decorator parenthesis").span
    parser_expect(parser, Newline, "expected newline after decorator")
    return universal.Decorator(name, arguments, source.Span(start.source, start.start, end.end))

def parser_import_declaration(parser: Parser) -> universal.ImportDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    match parser_peek(parser).kind:
        case String:
            parser_next(parser)
            alias: string | None := None
            if parser_at_identifier(parser, "as"):
                parser_next(parser)
                alias = parser_identifier(parser, "expected an import alias")[0]
            return universal.ImportDeclaration(universal.Locator(value), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
        case _:
            pass
    first = parser_identifier(parser, "expected an import name")
    if parser_at_identifier(parser, "from"):
        parser_next(parser)
        source_name = parser_identifier(parser, "expected an import source")[0]
        alias: string | None := None
        if parser_at_identifier(parser, "as"):
            parser_next(parser)
            alias = parser_identifier(parser, "expected an import alias")[0]
        return universal.ImportDeclaration(universal.Name(first[0]), source_name, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
    alias: string | None := None
    if parser_at_identifier(parser, "as"):
        parser_next(parser)
        alias = parser_identifier(parser, "expected an import alias")[0]
    return universal.ImportDeclaration(universal.Name(first[0]), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))

def parser_type_parameters(parser: Parser) -> tuple[list[string], list[universal.GenericConstraint]] | diagnostics.Diagnostic:
    parameters: list[string] = []
    constraints: list[universal.GenericConstraint] = []
    if parser_take(parser, LeftBracket) == None:
        return (parameters, constraints)
    if not parser_at_simple(parser, RightBracket):
        while true:
            parameter = parser_identifier(parser, "expected a generic parameter")
            parameters.append(parameter[0])
            if parser_take(parser, Colon) != None:
                bound = parser_type_annotation(parser)
                constraints.append(universal.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
            if parser_take(parser, Comma) == None:
                break
    parser_expect(parser, RightBracket, "expected closing type parameter bracket")
    return (parameters, constraints)

def parser_declaration_constraints(parser: Parser) -> list[universal.GenericConstraint] | diagnostics.Diagnostic:
    constraints: list[universal.GenericConstraint] = []
    if not parser_at_identifier(parser, "with"):
        return constraints
    parser_next(parser)
    parser_expect(parser, LeftBrace, "expected { after declaration with")
    multiline = parser_take(parser, Newline) != None
    if multiline:
        parser_expect(parser, Indent, "expected indented declaration constraints")
    parser_separators(parser)
    while not parser_at_simple(parser, RightBrace) and not parser_at_simple(parser, Dedent):
        if parser.cursor[0] + 1 < len(parser.tokens) and parser.tokens[parser.cursor[0] + 1].kind == Colon:
            parameter = parser_identifier(parser, "expected constrained parameter")
            parser_expect(parser, Colon, "expected colon after constrained parameter")
            bound = parser_type_annotation(parser)
            constraints.append(universal.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
        else:
            constraints.append(universal.Predicate(parser_expression(parser, 0)))
        parser_take(parser, Comma)
        parser_separators(parser)
    if multiline:
        parser_expect(parser, Dedent, "expected end of declaration constraints")
    parser_expect(parser, RightBrace, "expected } after declaration constraints")
    return constraints

def parser_function_declaration(parser: Parser, decorators: list[universal.Decorator]) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a function name")[0]
    generic_parts = parser_type_parameters(parser)
    generics = generic_parts[0]
    constraints := generic_parts[1]
    parser_expect(parser, LeftParen, "expected opening parenthesis")
    parameters: list[universal.FunctionParameter] = []
    keyword_only := false
    while not parser_at_simple(parser, RightParen):
        variadic = parser_take(parser, Star) != None
        if variadic:
            if keyword_only:
                return error(parser_fail(parser, "only one variadic parameter is supported"))
            keyword_only = true
        parameter = parser_identifier(parser, "expected a parameter name")
        parser_expect(parser, Colon, "expected colon after parameter")
        annotation = parser_type_annotation(parser)
        default: universal.Expression | absent := absent
        parameter_end := annotation.span.end
        if parser_take(parser, Equal) != absent:
            parsed_default = parser_expression(parser, 0)
            default = parsed_default
            parameter_end = parsed_default.span.end
        parameters.append(universal.FunctionParameter(parameter[0], annotation, default, source.Span(parameter[1].source, parameter[1].start, parameter_end), variadic=variadic, keyword_only=keyword_only and not variadic))
        if parser_take(parser, Comma) == None:
            break
    close = parser_expect(parser, RightParen, "expected closing parenthesis").span
    result := universal.named_type("unit", [], close)
    if parser_take(parser, Arrow) != None:
        result = parser_type_annotation(parser)
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    body: universal.Block | None := None
    end := result.span.end
    if parser_take(parser, Colon) != None:
        block = parser_indented_block(parser, "function")
        body = block[0]
        end = block[1]
    return universal.FunctionDeclaration(decorators, name, generics, constraints, parameters, result, body, source.Span(start.source, start.start, end))

def parser_type_declaration(parser: Parser, decorators: list[universal.Decorator]) -> universal.TypeDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a type name")[0]
    generic_parts = parser_type_parameters(parser)
    parameters = generic_parts[0]
    constraints := generic_parts[1]
    definition: universal.TypeAnnotation | None := None
    if parser_take(parser, Equal) != None:
        definition = parser_type_annotation(parser)
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    return universal.TypeDeclaration(decorators, name, parameters, constraints, definition, source.Span(start.source, start.start, parser_peek(parser).span.start))

def parser_trait_declaration(parser: Parser, decorators: list[universal.Decorator]) -> universal.TraitDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a trait name")[0]
    generic_parts = parser_type_parameters(parser)
    parameters = generic_parts[0]
    constraints := generic_parts[1]
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    bases: list[universal.TypeAnnotation] = []
    if parser_take(parser, Colon) != None and not parser_at_simple(parser, Newline):
        while true:
            bases.append(parser_type_annotation(parser))
            if parser_take(parser, Plus) == None:
                break
        parser_expect(parser, Colon, "expected colon before trait body")
    properties: list[universal.PropertyDeclaration] = []
    operators: list[universal.OperatorDeclaration] = []
    if parser_at_simple(parser, Newline):
        parser_expect(parser, Newline, "expected trait body")
        parser_expect(parser, Indent, "expected indented trait body")
        parser_separators(parser)
        while not parser_at_simple(parser, Dedent):
            if parser_at_identifier(parser, "property"):
                property_start = parser_next(parser).span
                property_name = parser_identifier(parser, "expected property name")[0]
                parser_expect(parser, Colon, "expected property type")
                annotation = parser_type_annotation(parser)
                default: universal.Expression | None := None
                if parser_take(parser, Equal) != None:
                    default = parser_expression(parser, 0)
                properties.append(universal.PropertyDeclaration(property_name, annotation, default, property_start))
            else:
                parser_next(parser)
            parser_separators(parser)
        parser_expect(parser, Dedent, "expected end of trait")
    return universal.TraitDeclaration(decorators, name, parameters, constraints, bases, properties, operators, source.Span(start.source, start.start, parser_peek(parser).span.start))

def parser_test_declaration(parser: Parser) -> universal.TestDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    modes: list[string] = []
    if parser_at_identifier(parser, "with"):
        parser_next(parser)
        while true:
            modes.append(parser_identifier(parser, "expected test mode")[0])
            if not parser_at_identifier(parser, "and"):
                break
            parser_next(parser)
    name: string | None := None
    match parser_peek(parser).kind:
        case String:
            name = value
            parser_next(parser)
        case _:
            pass
    parser_expect(parser, Colon, "expected colon after test")
    if "compiler" in modes:
        parser_expect(parser, Newline, "expected newline after compiler test")
        parser_separators(parser)
        parser_expect(parser, Indent, "expected compiler test body")
        cases: list[universal.CompilerTestCase] = []
        parser_separators(parser)
        while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
            case_start = parser_peek(parser).span
            expectation: CompilerExpectation := Accept
            if parser_at_identifier(parser, "reject"):
                expectation = Reject
            elif not parser_at_identifier(parser, "accept"):
                return error(parser_fail(parser, "compiler tests require accept or reject cases"))
            parser_next(parser)
            parser_expect(parser, Colon, "expected colon after compiler expectation")
            case_block = parser_indented_block(parser, "compiler case")
            cases.append(universal.CompilerTestCase(expectation, None, case_block[0], case_start))
            parser_separators(parser)
        end = parser_expect(parser, Dedent, "expected end of compiler test").span.end
        return universal.TestDeclaration(name, modes, universal.empty_block(), cases, source.Span(start.source, start.start, end))
    block = parser_indented_block(parser, "test")
    return universal.TestDeclaration(name, modes, block[0], [], source.Span(start.source, start.start, block[1]))

def parser_indented_block(parser: Parser, owner: string) -> tuple[universal.Block, u32] | diagnostics.Diagnostic:
    parser_expect(parser, Newline, "expected newline after " + owner)
    while parser_take(parser, Newline) != None:
        pass
    parser_expect(parser, Indent, "expected indented " + owner + " body")
    statements: list[universal.Statement] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        if parser_at_identifier(parser, "pass"):
            parser_next(parser)
        else:
            statements.append(parser_block_statement(parser))
        parser_separators(parser)
    end = parser_expect(parser, Dedent, "expected end of " + owner + " body").span.end
    return (universal.Block(statements, [], []), end)

def parser_block_statement(parser: Parser) -> universal.Statement | diagnostics.Diagnostic:
    if parser_at_identifier(parser, "for"):
        start = parser_next(parser).span
        name = parser_identifier(parser, "expected iteration binding")[0]
        if not parser_at_identifier(parser, "in"):
            return error(parser_fail(parser, "expected in after iteration binding"))
        parser_next(parser)
        iterable = parser_expression(parser, 0)
        parser_expect(parser, Colon, "expected colon after iterable")
        body = parser_indented_block(parser, "for")
        return universal.ForEach(name, iterable, body[0], source.Span(start.source, start.start, body[1]))
    if parser_at_identifier(parser, "if"):
        start = parser_next(parser).span
        condition = parser_expression(parser, 0)
        parser_expect(parser, Colon, "expected colon after if condition")
        taken = parser_indented_block(parser, "if")
        otherwise := universal.empty_block()
        end := taken[1]
        if parser_at_identifier(parser, "else"):
            parser_next(parser)
            parser_expect(parser, Colon, "expected colon after else")
            rejected = parser_indented_block(parser, "else")
            otherwise = rejected[0]
            end = rejected[1]
        return universal.If(condition, taken[0], otherwise, source.Span(start.source, start.start, end))
    if parser_at_identifier(parser, "return"):
        start = parser_next(parser).span
        if parser_at_simple(parser, Newline) or parser_at_simple(parser, Dedent):
            return universal.Return(None, start)
        value = parser_expression(parser, 0)
        return universal.Return(value, source.Span(start.source, start.start, value.span.end))
    if parser_at_identifier(parser, "assert"):
        start = parser_next(parser).span
        condition = parser_expression(parser, 0)
        message: universal.Expression | None := None
        if parser_take(parser, Comma) != None:
            message = parser_expression(parser, 0)
        return universal.Assert(condition, message, source.Span(start.source, start.start, condition.span.end), condition.span)
    return parser_simple_statement(parser)

def parser_simple_statement(parser: Parser) -> universal.Statement | diagnostics.Diagnostic:
    if parser_looks_like_binding(parser):
        return universal.BindingStatement(parser_binding(parser))
    return universal.ExpressionStatement(parser_expression(parser, 0))

def parser_looks_like_binding(parser: Parser) -> bool:
    if parser.cursor[0] + 1 >= len(parser.tokens):
        return false
    match parser.tokens[parser.cursor[0]].kind:
        case Identifier:
            next = parser.tokens[parser.cursor[0] + 1].kind
            match next:
                case Identifier:
                    if parser.cursor[0] + 2 < len(parser.tokens):
                        return parser.tokens[parser.cursor[0] + 2].kind == Equal
                case _:
                    pass
            return next == Equal or next == QuestionEqual or next == ColonEqual or next == Colon or next == PlusEqual or next == MinusEqual or next == StarEqual
        case _:
            pass
    return false

def parser_binding(parser: Parser) -> universal.Binding | diagnostics.Diagnostic:
    start = parser_peek(parser).span
    name := parser_identifier(parser, "expected binding name")[0]
    annotation: universal.TypeAnnotation | None := None
    match parser_peek(parser).kind:
        case Identifier:
            annotation = universal.named_type(name, [], start)
            name = parser_identifier(parser, "expected binding name after type")[0]
        case _:
            pass
    if parser_take(parser, Colon) != None:
        annotation = parser_type_annotation(parser)
    assignment = parser_peek(parser).kind
    if assignment == PlusEqual or assignment == MinusEqual or assignment == StarEqual:
        parser_next(parser)
        rhs = parser_expression(parser, 0)
        operator := universal.operator_syntax(universal.Add())
        if assignment == MinusEqual:
            operator = universal.operator_syntax(universal.Subtract())
        elif assignment == StarEqual:
            operator = universal.operator_syntax(universal.Multiply())
        combined = universal.Expression(universal.Binary(operator, universal.Expression(universal.Name(name), start), rhs), source.Span(start.source, start.start, rhs.span.end))
        return universal.Binding(name, annotation, combined, true, false, combined.span)
    inferred = parser_take(parser, ColonEqual) != None
    preserve_error = not inferred and parser_take(parser, QuestionEqual) != None
    if not inferred and not preserve_error:
        parser_expect(parser, Equal, "expected `=`, `?=`, or `:=` after binding name")
    value = parser_expression(parser, 0)
    return universal.Binding(name, annotation, value, false, preserve_error, source.Span(start.source, start.start, value.span.end), mutable=inferred)

def parser_expression(parser: Parser, minimum: int) -> universal.Expression | diagnostics.Diagnostic:
    return parse_expression(parser, minimum)

def parser_unary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    return parse_unary(parser)

def parser_postfix(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    return parse_postfix(parser)

def parser_primary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    return parse_primary(parser)

def parser_type_annotation(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    return parse_type_annotation(parser)

def parser_type_primary(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    return parse_type_primary(parser)

def parse_expression(parser: Parser, minimum: int) -> universal.Expression | diagnostics.Diagnostic:
    left := parser_unary(parser)
    while true:
        if not is_binary_operator(parser_peek(parser).kind):
            break
        operator = binary_operator(parser_peek(parser).kind)
        operator_precedence = precedence(operator)
        if operator_precedence < minimum:
            break
        token = parser_next(parser)
        next_minimum := operator_precedence
        if operator.associativity != universal.Associativity.Right:
            next_minimum += 1
        right = parse_expression(parser, next_minimum)
        left = universal.Expression(universal.Binary(operator, left, right), source.Span(token.span.source, left.span.start, right.span.end))
    if minimum == 0 and parser_at_identifier(parser, "if"):
        parser_next(parser)
        condition = parse_expression(parser, 1)
        if not parser_at_identifier(parser, "else"):
            return error(parser_fail(parser, "conditional expression requires else"))
        parser_next(parser)
        otherwise = parse_expression(parser, 0)
        return universal.Expression(universal.Conditional(condition, left, otherwise), source.Span(left.span.source, left.span.start, otherwise.span.end))
    return left


def parse_unary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    token = parser_peek(parser)
    operator: universal.OperatorSyntax | None := None
    if token.kind == Plus:
        operator = universal.operator_syntax(universal.Positive())
    elif token.kind == Minus:
        operator = universal.operator_syntax(universal.Negative())
    elif parser_at_identifier(parser, "not"):
        operator = universal.operator_syntax(universal.Not())
    elif parser_at_identifier(parser, "move"):
        operator = universal.operator_syntax(universal.Move())
    selected ?= operator
    if selected != None:
        parser_next(parser)
        operand = parse_unary(parser)
        return universal.Expression(universal.Unary(selected, operand), source.Span(token.span.source, token.span.start, operand.span.end))
    return parser_postfix(parser)


def parse_postfix(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    value := parser_primary(parser)
    while true:
        if parser_take(parser, LeftParen) != None:
            arguments: list[universal.CallArgument] = []
            while not parser_at_simple(parser, RightParen):
                start = parser_peek(parser).span
                argument_name: string | absent := absent
                if parser.cursor[0] + 1 < len(parser.tokens) and parser.tokens[parser.cursor[0] + 1].kind == Equal:
                    argument_name = parser_identifier(parser, "expected argument name")[0]
                    parser_expect(parser, Equal, "expected = after argument name")
                argument = parse_expression(parser, 0)
                arguments.append(universal.CallArgument(argument_name, argument, source.Span(start.source, start.start, argument.span.end)))
                if parser_take(parser, Comma) == None:
                    break
            end = parser_expect(parser, RightParen, "expected closing parenthesis").span.end
            value = universal.Expression(universal.Call(value, arguments), source.Span(value.span.source, value.span.start, end))
        elif parser_take(parser, Dot) != None:
            member = parser_identifier(parser, "expected member name")
            value = universal.Expression(universal.Member(value, member[0]), source.Span(value.span.source, value.span.start, member[1].end))
        else:
            break
    return value


def parse_primary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    token = parser_next(parser)
    match token.kind:
        case Identifier:
            if value == "true":
                return universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), token.span)
            if value == "false":
                return universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), token.span)
            if value == "None":
                return universal.Expression(universal.LiteralValue(universal.LiteralValue.NoneValue), token.span)
            return universal.Expression(universal.Name(value), token.span)
        case Integer:
            return universal.Expression(universal.LiteralValue(universal.IntegerValue(value)), token.span)
        case Float:
            return universal.Expression(universal.LiteralValue(universal.FloatValue(value)), token.span)
        case Character:
            return universal.Expression(universal.LiteralValue(universal.CharacterValue(value)), token.span)
        case String:
            return universal.Expression(universal.LiteralValue(universal.StringValue(value)), token.span)
        case FormattedString:
            return formatted_string_expression(value, token.span)
        case LeftParen:
            value = parse_expression(parser, 0)
            parser_expect(parser, RightParen, "expected closing parenthesis")
            return value
        case _:
            pass
    return error(diagnostics.Diagnostic("E000120", "expected an expression", token.span))


def parse_type_annotation(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    first = parser_type_primary(parser)
    if parser_take(parser, Pipe) == None:
        return first
    members: list[universal.TypeAnnotation] = [first]
    while true:
        members.append(parser_type_primary(parser))
        if parser_take(parser, Pipe) == None:
            break
    return universal.TypeAnnotation(universal.Union(members), source.Span(first.span.source, first.span.start, members[-1].span.end))


def parse_type_primary(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    name = parser_identifier(parser, "expected a type name")
    arguments: list[universal.TypeAnnotation] = []
    end := name[1].end
    if parser_take(parser, LeftBracket) != None:
        while not parser_at_simple(parser, RightBracket):
            arguments.append(parse_type_annotation(parser))
            if parser_take(parser, Comma) == None:
                break
        end = parser_expect(parser, RightBracket, "expected closing type bracket").span.end
    return universal.named_type(name[0], arguments, source.Span(name[1].source, name[1].start, end))


def is_binary_operator(kind: lexer.TokenKind) -> bool:
    match kind:
        case Identifier:
            return value == "in" or value == "and" or value == "or"
        case _:
            pass
    return kind == Plus or kind == Minus or kind == Star or kind == Slash or kind == Percent or kind == Power or kind == EqualEqual or kind == NotEqual or kind == Less or kind == LessEqual or kind == Greater or kind == GreaterEqual


def binary_operator(kind: lexer.TokenKind) -> universal.OperatorSyntax:
    match kind:
        case Identifier:
            if value == "in":
                return universal.operator_syntax(universal.Contains())
            if value == "and":
                return universal.operator_syntax(universal.LogicalAnd())
            return universal.operator_syntax(universal.LogicalOr())
        case _:
            pass
    if kind == Plus:
        return universal.operator_syntax(universal.Add())
    if kind == Minus:
        return universal.operator_syntax(universal.Subtract())
    if kind == Star:
        return universal.operator_syntax(universal.Multiply())
    if kind == Slash:
        return universal.operator_syntax(universal.Divide())
    if kind == Percent:
        return universal.operator_syntax(universal.Remainder())
    if kind == Power:
        return universal.operator_syntax(universal.Power())
    if kind == EqualEqual:
        return universal.operator_syntax(universal.Equal())
    if kind == NotEqual:
        return universal.operator_syntax(universal.NotEqual())
    if kind == Less:
        return universal.operator_syntax(universal.Less())
    if kind == LessEqual:
        return universal.operator_syntax(universal.LessEqual())
    if kind == Greater:
        return universal.operator_syntax(universal.Greater())
    if kind == GreaterEqual:
        return universal.operator_syntax(universal.GreaterEqual())
    # Callers prove the token is binary with `is_binary_operator` first.
    return universal.operator_syntax(universal.Add())


def precedence(operator: universal.OperatorSyntax) -> int:
    return int(operator.precedence)


def parse(tokens: list[lexer.Token]) -> universal.Module | diagnostics.Diagnostic:
    return parser_module(Parser(tokens))
