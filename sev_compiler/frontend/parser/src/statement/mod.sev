import lexer
from lexer import TokenKind
import diagnostics
import source
import universal
from universal import CompilerExpectation

def formatted_string_expression(value: string, span: source.Span, syntaxes: list[universal.OperatorSyntax], lexical_rules: list[universal.RecordDeclaration] = []) -> universal.Expression | diagnostics.Diagnostic:
    rules: list[lexer.SourceLexicalRule] = []
    for declaration in lexical_rules:
        rules.append(lexer.source_lexical_rule(declaration))
    characters = value.characters()
    cursor := 0
    literal := ""
    parts: list[universal.Expression] = []
    while cursor < len(characters):
        if characters[cursor] == "{" and cursor + 1 < len(characters) and characters[cursor + 1] == "{":
            literal += "{"
            cursor += 2
            continue
        if characters[cursor] == "}" and cursor + 1 < len(characters) and characters[cursor + 1] == "}":
            literal += "}"
            cursor += 2
            continue
        if characters[cursor] == "}":
            return error(diagnostics.Diagnostic("E000113", "single } in formatted string; write }} for a literal brace", span))
        if characters[cursor] != "{":
            literal += string(characters[cursor])
            cursor += 1
            continue
        if len(literal) > 0:
            parts.append(universal.Expression(universal.LiteralValue(universal.StringValue(literal)), span))
            literal = ""
        expression_start = cursor + 1
        cursor = expression_start
        nesting := 0
        while cursor < len(characters):
            if characters[cursor] == "(" or characters[cursor] == "[":
                nesting += 1
            elif characters[cursor] == ")" or characters[cursor] == "]":
                nesting -= 1
            elif characters[cursor] == "}" and nesting == 0:
                break
            cursor += 1
        if cursor >= len(characters):
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation is missing }", span))
        expression_source = characters[expression_start:cursor].join("").strip()
        if len(expression_source) == 0:
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation may not be empty", span))
        interpolation = source.SourceFile(span.source, "<formatted-string>", expression_source)
        interpolation_tokens = lexer.scan_tokens(interpolation, syntaxes, rules=rules)
        expression_parser = Parser(interpolation_tokens)
        parsed_expression = parser_expression(expression_parser, 0)
        parser_separators(expression_parser)
        if not parser_at_simple(expression_parser, Eof):
            return error(diagnostics.Diagnostic("E000113", "unexpected token in formatted string interpolation", span))
        parts.append(universal.Expression(universal.Stringify(parsed_expression), span))
        cursor += 1
    if len(literal) > 0:
        parts.append(universal.Expression(universal.LiteralValue(universal.StringValue(literal)), span))
    if len(parts) == 0:
        return universal.Expression(universal.LiteralValue(universal.StringValue("")), span)
    result := parts[0]
    for part in parts[1:]:
        result = universal.Expression(universal.Binary(universal.operator_syntax(universal.Add()), result, part), span)
    return result

class Parser:
    tokens: list[lexer.Token]
    cursor: list[int] = [0]


# The shared cursor belongs to the parser state. Recursive parsing uses
# ordinary functions so every advance remains an executable mutation.
def parser_peek(parser: Parser) -> lexer.Token:
    return parser.tokens[parser.cursor[0]]

def parser_next(parser: Parser) -> lexer.Token:
    token = parser.tokens[parser.cursor[0]]
    parser.cursor[0] += 1
    return token

def parser_at_identifier(parser: Parser, expected: string) -> bool:
    match parser_peek(parser).kind:
        case Identifier:
            return string(parser_peek(parser)) == expected
        case _:
            pass
    return false

def parser_at_simple(parser: Parser, expected: lexer.TokenKind) -> bool:
    return parser_peek(parser).kind == expected

def parser_take(parser: Parser, expected: lexer.TokenKind) -> lexer.Token | None:
    if parser_at_simple(parser, expected):
        return parser_next(parser)
    return None

def parser_fail(parser: Parser, message: string) -> diagnostics.Diagnostic:
    return diagnostics.Diagnostic("E000120", message, parser_peek(parser).span)

def parser_identifier(parser: Parser, message: string) -> tuple[string, source.Span] | diagnostics.Diagnostic:
    token = parser_next(parser)
    match token.kind:
        case Identifier:
            return (string(token), token.span)
        case _:
            pass
    return error(diagnostics.Diagnostic("E000120", message, token.span))

def parser_expect(parser: Parser, expected: lexer.TokenKind, message: string) -> lexer.Token | diagnostics.Diagnostic:
    token ?= parser_take(parser, expected)
    if token != None:
        return token
    return error(parser_fail(parser, message))

def parser_at_symbol(parser: Parser, spelling: string) -> bool:
    return lexer.token_is_symbol(parser_peek(parser), spelling)


def parser_take_symbol(parser: Parser, spelling: string) -> lexer.Token | None:
    if parser_at_symbol(parser, spelling):
        return parser_next(parser)
    return None


def parser_expect_symbol(parser: Parser, spelling: string, message: string) -> lexer.Token | diagnostics.Diagnostic:
    token ?= parser_take_symbol(parser, spelling)
    if token != None:
        return token
    return error(parser_fail(parser, message))


def parser_separators(parser: Parser):
    while parser_at_simple(parser, Newline) or parser_at_symbol(parser, ","):
        parser_next(parser)

def parser_module(parser: Parser) -> universal.Module | diagnostics.Diagnostic:
    result = universal.Module([])
    parser_separators(parser)
    while not parser_at_simple(parser, Eof):
        if parser_at_symbol(parser, "@"):
            decorators: list[universal.Decorator] = []
            while parser_at_symbol(parser, "@"):
                decorators.append(parser_scalar_decorator(parser))
            if not parser_at_identifier(parser, "def"):
                return error(parser_fail(parser, "expected function after decorator"))
            result.items.append(universal.Function(parser_function_declaration(parser, decorators)))
        elif parser_at_identifier(parser, "import"):
            result.items.append(universal.Import(parser_import_declaration(parser)))
        elif parser_at_identifier(parser, "trait"):
            result.items.append(universal.Trait(parser_trait_declaration(parser, [])))
        elif parser_at_identifier(parser, "grammar"):
            result.items.append(universal.GrammarItem(parser_grammar_declaration(parser)))
        elif parser_at_identifier(parser, "operator"):
            operation = parser_operator_declaration(parser)
            operation.receiver = false
            result.items.append(universal.OperatorItem(operation))
        elif parser_at_identifier(parser, "def"):
            result.items.append(universal.Function(parser_function_declaration(parser, [])))
        elif parser_at_identifier(parser, "class"):
            result.items.append(universal.Record(parser_record_declaration(parser)))
        elif parser_at_identifier(parser, "extend"):
            result.items.append(universal.Record(parser_record_declaration(parser, true)))
        elif parser_at_identifier(parser, "union"):
            result.items.append(universal.Type(parser_family_declaration(parser)))
        elif parser_at_identifier(parser, "type") and parser.cursor[0] + 1 < len(parser.tokens) and not lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "("):
            result.items.append(universal.Type(parser_type_declaration(parser, [])))
        elif parser_at_identifier(parser, "test"):
            result.items.append(universal.Test(parser_test_declaration(parser)))
        elif parser_at_identifier(parser, "return") or parser_at_identifier(parser, "break") or parser_at_identifier(parser, "continue"):
            return error(diagnostics.Diagnostic("E000121", "control flow is not valid at module scope", parser_peek(parser).span))
        else:
            statement = parser_simple_statement(parser)
            match statement:
                case BindingStatement:
                    result.items.append(universal.BindingItem(binding))
                case ExpressionStatement:
                    result.items.append(universal.ExpressionItem(expression))
                case _:
                    return error(parser_fail(parser, "expected a module declaration"))
        parser_separators(parser)
    return result

def parser_scalar_decorator(parser: Parser) -> universal.Decorator | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected decorator name")[0]
    parser_expect_symbol(parser, "(", "expected decorator arguments")
    arguments: list[universal.DecoratorArgument] = []
    while not parser_at_symbol(parser, ")"):
        argument_name := ""
        if parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "="):
            argument_name = parser_identifier(parser, "expected argument name")[0]
            parser_next(parser)
        token = parser_next(parser)
        match token.kind:
            case String:
                arguments.append(universal.DecoratorArgument(argument_name, universal.DecoratorValue.String(string(token)), token.span))
            case _:
                return error(parser_fail(parser, "decorator requires string arguments"))
        if parser_take_symbol(parser, ",") == None:
            break
    end = parser_expect_symbol(parser, ")", "expected closing decorator parenthesis").span
    parser_expect(parser, Newline, "expected newline after decorator")
    return universal.Decorator(name, arguments, source.Span(start.source, start.start, end.end))

def parser_import_declaration(parser: Parser) -> universal.ImportDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    match parser_peek(parser).kind:
        case String:
            value = string(parser_next(parser))
            alias: string | None := None
            if parser_at_identifier(parser, "as"):
                parser_next(parser)
                alias = parser_identifier(parser, "expected an import alias")[0]
            return universal.ImportDeclaration(universal.Locator(value), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
        case _:
            pass
    first = parser_identifier(parser, "expected an import name")
    if parser_at_identifier(parser, "from"):
        parser_next(parser)
        source_name = parser_identifier(parser, "expected an import source")[0]
        alias: string | None := None
        if parser_at_identifier(parser, "as"):
            parser_next(parser)
            alias = parser_identifier(parser, "expected an import alias")[0]
        return universal.ImportDeclaration(universal.Name(first[0]), source_name, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))
    alias: string | None := None
    if parser_at_identifier(parser, "as"):
        parser_next(parser)
        alias = parser_identifier(parser, "expected an import alias")[0]
    return universal.ImportDeclaration(universal.Name(first[0]), None, alias, source.Span(start.source, start.start, parser_peek(parser).span.start))

def parser_type_parameters(parser: Parser) -> tuple[list[string], list[universal.GenericConstraint]] | diagnostics.Diagnostic:
    parameters: list[string] = []
    constraints: list[universal.GenericConstraint] = []
    if parser_take_symbol(parser, "[") == None:
        return (parameters, constraints)
    if not parser_at_symbol(parser, "]"):
        while true:
            parameter = parser_identifier(parser, "expected a generic parameter")
            parameters.append(parameter[0])
            if parser_take_symbol(parser, ":") != None:
                bound = parser_type_annotation(parser)
                constraints.append(universal.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
            if parser_take_symbol(parser, ",") == None:
                break
    parser_expect_symbol(parser, "]", "expected closing type parameter bracket")
    return (parameters, constraints)

def parser_declaration_constraints(parser: Parser) -> list[universal.GenericConstraint] | diagnostics.Diagnostic:
    constraints: list[universal.GenericConstraint] = []
    if not parser_at_identifier(parser, "with"):
        return constraints
    parser_next(parser)
    parser_expect_symbol(parser, "{", "expected { after declaration with")
    multiline = parser_take(parser, Newline) != None
    if multiline:
        parser_expect(parser, Indent, "expected indented declaration constraints")
    parser_separators(parser)
    while not parser_at_symbol(parser, "}") and not parser_at_simple(parser, Dedent):
        if parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], ":"):
            parameter = parser_identifier(parser, "expected constrained parameter")
            parser_expect_symbol(parser, ":", "expected colon after constrained parameter")
            bound = parser_type_annotation(parser)
            constraints.append(universal.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
        else:
            constraints.append(universal.Predicate(parser_expression(parser, 0)))
        parser_take_symbol(parser, ",")
        parser_separators(parser)
    if multiline:
        parser_expect(parser, Dedent, "expected end of declaration constraints")
    parser_expect_symbol(parser, "}", "expected } after declaration constraints")
    return constraints

def parser_function_declaration(parser: Parser, decorators: list[universal.Decorator]) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a function name")[0]
    generic_parts = parser_type_parameters(parser)
    generics = generic_parts[0]
    constraints := generic_parts[1]
    parser_expect_symbol(parser, "(", "expected opening parenthesis")
    parameters: list[universal.FunctionParameter] = []
    keyword_only := false
    while not parser_at_symbol(parser, ")"):
        variadic = parser_take_symbol(parser, "*") != None
        if variadic:
            if keyword_only:
                return error(parser_fail(parser, "only one variadic parameter is supported"))
            keyword_only = true
        parameter = parser_identifier(parser, "expected a parameter name")
        parser_expect_symbol(parser, ":", "expected colon after parameter")
        annotation = parser_type_annotation(parser)
        default: universal.Expression | absent := absent
        parameter_end := annotation.span.end
        if parser_take_symbol(parser, "=") != absent:
            parsed_default = parser_expression(parser, 0)
            default = parsed_default
            parameter_end = parsed_default.span.end
        parameters.append(universal.FunctionParameter(parameter[0], annotation, default, source.Span(parameter[1].source, parameter[1].start, parameter_end), variadic=variadic, keyword_only=keyword_only and not variadic))
        if parser_take_symbol(parser, ",") == None:
            break
    close = parser_expect_symbol(parser, ")", "expected closing parenthesis").span
    result := universal.named_type("unit", [], close)
    if parser_take_symbol(parser, "->") != None:
        result = parser_type_annotation(parser)
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    body: universal.Block | None := None
    end := result.span.end
    if parser_take_symbol(parser, ":") != None:
        block = parser_indented_block(parser, "function")
        body = block[0]
        end = block[1]
    return universal.FunctionDeclaration(decorators, name, generics, constraints, parameters, result, body, source.Span(start.source, start.start, end))

def parser_type_declaration(parser: Parser, decorators: list[universal.Decorator]) -> universal.TypeDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a type name")[0]
    generic_parts = parser_type_parameters(parser)
    parameters = generic_parts[0]
    constraints := generic_parts[1]
    definition: universal.TypeAnnotation | None := None
    if parser_take_symbol(parser, "=") != None:
        definition = parser_type_annotation(parser)
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    return universal.TypeDeclaration(decorators, name, parameters, constraints, definition, source.Span(start.source, start.start, parser_peek(parser).span.start))

def parser_trait_declaration(parser: Parser, decorators: list[universal.Decorator]) -> universal.TraitDeclaration | diagnostics.Diagnostic:
    start_token = parser_next(parser)
    start = start_token.span
    name = parser_identifier(parser, "expected a trait name")[0]
    generic_parts = parser_type_parameters(parser)
    constraints := generic_parts[1]
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    bases: list[universal.TypeAnnotation] = []
    parser_expect_symbol(parser, ":", "expected trait bases or body")
    if not parser_at_simple(parser, Newline):
        while true:
            bases.append(parser_type_annotation(parser))
            if parser_take_symbol(parser, "+") == None:
                break
        parser_take_symbol(parser, ":")
    properties: list[universal.PropertyDeclaration] = []
    operators: list[universal.OperatorDeclaration] = []
    methods: list[universal.FunctionDeclaration] = []
    parser_separators(parser)
    if parser_take(parser, Indent) != None:
        parser_separators(parser)
        while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
            if parser_at_identifier(parser, "def"):
                methods.append(parser_function_declaration(parser, []))
            elif parser_at_identifier(parser, "operator"):
                operators.append(parser_operator_declaration(parser))
            elif parser_at_identifier(parser, "pass"):
                parser_next(parser)
            elif parser_at_identifier(parser, "property") or (parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], ":")):
                property_start = parser_peek(parser).span
                if parser_at_identifier(parser, "property"):
                    parser_next(parser)
                property_name = parser_identifier(parser, "expected property name")[0]
                parser_expect_symbol(parser, ":", "expected property type")
                annotation = parser_type_annotation(parser)
                default: universal.Expression | None := None
                if parser_take_symbol(parser, "=") != None:
                    if start_token.grammar and property_name == "symbol":
                        symbol_token = parser_next(parser)
                        if len(symbol_token.syntaxes) == 0:
                            return error(parser_fail(parser, "expected a registered source symbol"))
                        syntax = start_token.syntaxes[0] if len(start_token.syntaxes) != 0 else symbol_token.syntaxes[0]
                        default = universal.Expression(universal.SourceSymbol(syntax.symbol, syntax.definition), symbol_token.span)
                    elif start_token.grammar and property_name in ["left", "right"]:
                        term = parser_type_primary(parser)
                        match term.kind:
                            case Named:
                                default = universal.Expression(universal.CompilerTerm(name, arguments), term.span)
                            case _:
                                return error(parser_fail(parser, "expected an operand requirement"))
                    else:
                        default = parser_expression(parser, 0)
                properties.append(universal.PropertyDeclaration(property_name, annotation, default, property_start))
            else:
                # A bare type in a trait body is an inherited contract.
                bases.append(parser_type_annotation(parser))
            parser_separators(parser)
        parser_expect(parser, Dedent, "expected end of trait")
    return universal.TraitDeclaration(decorators, name, generic_parts[0], constraints, bases, properties, operators, source.Span(start.source, start.start, parser_peek(parser).span.start), methods=methods, compiler_descriptor=start_token.descriptor, grammar=start_token.grammar)


def parser_operator_declaration(parser: Parser) -> universal.OperatorDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    token = parser_next(parser)
    symbol := ""
    syntax := universal.operator_syntax(universal.Add())
    if len(token.syntaxes) != 0:
        syntax = token.syntaxes[0]
        symbol = syntax.symbol
    else:
        match token.kind:
            case Identifier:
                symbol = string(token)
            case Symbol:
                symbol = string(token)
            case _:
                return error(parser_fail(parser, "expected a registered operator symbol"))
    syntax = universal.OperatorSyntax(symbol, syntax.fixity, syntax.precedence, syntax.associativity, definition=syntax.definition)
    # Operator parameters use the same parameter:constraint grammar as other
    # declarations. Whether a constraint denotes compiler grammar is resolved
    # later, through its actual definition and inherited contracts.
    generic_parts = parser_type_parameters(parser)
    type_parameters = generic_parts[0]
    operator_constraints = generic_parts[1]
    parser_expect_symbol(parser, "(", "expected operator parameters")
    parameters: list[universal.OperatorParameter] = []
    while not parser_at_symbol(parser, ")"):
        parameter = parser_identifier(parser, "expected operator parameter")
        annotation := universal.named_type("Self", [], parameter[1])
        if parser_take_symbol(parser, ":") != None:
            annotation = parser_type_annotation(parser)
        elif parameter[0] != "self":
            return error(parser_fail(parser, "expected operator parameter type"))
        parameters.append(universal.OperatorParameter(parameter[0], annotation, parameter[1]))
        if parser_take_symbol(parser, ",") == None:
            break
    close = parser_expect_symbol(parser, ")", "expected closing operator parenthesis")
    result := universal.named_type("unit", [], close.span)
    if parser_take_symbol(parser, "->") != None:
        result = parser_type_annotation(parser)
    constraints = operator_constraints
    for constraint in parser_declaration_constraints(parser):
        constraints.append(constraint)
    body: universal.Block | None := None
    if parser_take_symbol(parser, ":") != None:
        body = parser_indented_block(parser, "operator")[0]
    receiver := len(parameters) < 2
    if len(parameters) == 1 and parameters[0].name == "self":
        syntax = universal.OperatorSyntax(symbol, universal.Fixity.Prefix, 10, universal.Associativity.Right, domain=syntax.domain, grammar_name=syntax.grammar_name)
        receiver = false
    return universal.OperatorDeclaration(syntax, parameters, result, source.Span(start.source, start.start, parser_peek(parser).span.start), type_parameters=type_parameters, constraints=constraints, body=body, receiver=receiver)


def parser_test_declaration(parser: Parser) -> universal.TestDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    modes: list[string] = []
    if parser_at_identifier(parser, "with"):
        parser_next(parser)
        while true:
            modes.append(parser_identifier(parser, "expected test mode")[0])
            if not parser_at_identifier(parser, "and"):
                break
            parser_next(parser)
    name: string | None := None
    match parser_peek(parser).kind:
        case String:
            name = string(parser_next(parser))
        case _:
            pass
    parser_expect_symbol(parser, ":", "expected colon after test")
    if "compiler" in modes:
        parser_expect(parser, Newline, "expected newline after compiler test")
        parser_separators(parser)
        parser_expect(parser, Indent, "expected compiler test body")
        cases: list[universal.CompilerTestCase] = []
        parser_separators(parser)
        while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
            case_start = parser_peek(parser).span
            expectation: CompilerExpectation := Accept
            if parser_at_identifier(parser, "reject"):
                expectation = Reject
            elif not parser_at_identifier(parser, "accept"):
                return error(parser_fail(parser, "compiler tests require accept or reject cases"))
            parser_next(parser)
            parser_expect_symbol(parser, ":", "expected colon after compiler expectation")
            case_block = parser_indented_block(parser, "compiler case")
            cases.append(universal.CompilerTestCase(expectation, None, case_block[0], case_start))
            parser_separators(parser)
        end = parser_expect(parser, Dedent, "expected end of compiler test").span.end
        return universal.TestDeclaration(name, modes, universal.empty_block(), cases, source.Span(start.source, start.start, end))
    block = parser_indented_block(parser, "test")
    return universal.TestDeclaration(name, modes, block[0], [], source.Span(start.source, start.start, block[1]))

def parser_indented_block(parser: Parser, owner: string) -> tuple[universal.Block, u32] | diagnostics.Diagnostic:
    parser_expect(parser, Newline, "expected newline after " + owner)
    while parser_take(parser, Newline) != None:
        pass
    parser_expect(parser, Indent, "expected indented " + owner + " body")
    statements: list[universal.Statement] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        if parser_at_identifier(parser, "pass"):
            parser_next(parser)
        else:
            statements.append(parser_block_statement(parser))
        parser_separators(parser)
    end = parser_expect(parser, Dedent, "expected end of " + owner + " body").span.end
    return (universal.Block(statements, [], []), end)

def parser_block_statement(parser: Parser) -> universal.Statement | diagnostics.Diagnostic:
    for syntax in parser_peek(parser).syntaxes:
        if syntax.grammar_form in ["Body", "ConditionBody"]:
            start = parser_next(parser).span
            operands: list[universal.Expression] = []
            if syntax.grammar_form == "ConditionBody":
                operands.append(parser_expression(parser, 0))
            parser_expect_symbol(parser, ":", "expected colon after grammar operands")
            body = parser_indented_block(parser, syntax.grammar_name)
            return universal.GrammarApply(syntax, operands, [body[0]], source.Span(start.source, start.start, body[1]), false)
    if parser_at_identifier(parser, "match"):
        return parser_match_statement(parser)
    if parser_at_identifier(parser, "while"):
        start = parser_next(parser).span
        condition = parser_expression(parser, 0)
        initializer: universal.Binding | None := None
        if parser_at_identifier(parser, "with"):
            parser_next(parser)
            initializer = parser_binding(parser)
        parser_expect_symbol(parser, ":", "expected colon after while condition")
        body = parser_indented_block(parser, "while")
        span = source.Span(start.source, start.start, body[1])
        loop: universal.Statement = universal.While(condition, body[0], span)
        binding ?= initializer
        if binding != None:
            # The initializer runs once in a scope enclosing the whole loop.
            scope = universal.Block([universal.BindingStatement(binding), loop])
            taken = universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), span)
            return universal.If(taken, scope, universal.empty_block(), span)
        return loop
    if parser_at_identifier(parser, "break"):
        return universal.Break(parser_next(parser).span)
    if parser_at_identifier(parser, "continue"):
        return universal.Continue(parser_next(parser).span)
    if parser_at_identifier(parser, "for"):
        start = parser_next(parser).span
        name = parser_identifier(parser, "expected iteration binding")[0]
        if not parser_at_identifier(parser, "in"):
            return error(parser_fail(parser, "expected in after iteration binding"))
        parser_next(parser)
        iterable = parser_expression(parser, 0)
        parser_expect_symbol(parser, ":", "expected colon after iterable")
        body = parser_indented_block(parser, "for")
        return universal.ForEach(name, iterable, body[0], source.Span(start.source, start.start, body[1]))
    if parser_at_identifier(parser, "if"):
        start = parser_next(parser).span
        condition = parser_expression(parser, 0)
        parser_expect_symbol(parser, ":", "expected colon after if condition")
        taken = parser_indented_block(parser, "if")
        otherwise := universal.empty_block()
        end := taken[1]
        if parser_at_identifier(parser, "else"):
            parser_next(parser)
            parser_expect_symbol(parser, ":", "expected colon after else")
            rejected = parser_indented_block(parser, "else")
            otherwise = rejected[0]
            end = rejected[1]
        return universal.If(condition, taken[0], otherwise, source.Span(start.source, start.start, end))
    if parser_at_identifier(parser, "throw"):
        start = parser_next(parser).span
        value = parser_expression(parser, 0)
        return universal.Throw(value, source.Span(start.source, start.start, value.span.end))
    if parser_at_identifier(parser, "return"):
        start = parser_next(parser).span
        if parser_at_simple(parser, Newline) or parser_at_simple(parser, Dedent):
            return universal.Return(None, start)
        value = parser_expression(parser, 0)
        return universal.Return(value, source.Span(start.source, start.start, value.span.end))
    if parser_at_identifier(parser, "assert"):
        start = parser_next(parser).span
        condition = parser_expression(parser, 0)
        message: universal.Expression | None := None
        if parser_take_symbol(parser, ",") != None:
            message = parser_expression(parser, 0)
        return universal.Assert(condition, message, source.Span(start.source, start.start, condition.span.end), condition.span)
    return parser_simple_statement(parser)

def parser_match_statement(parser: Parser) -> universal.Statement | diagnostics.Diagnostic:
    start = parser_next(parser).span
    subject = parser_expression(parser, 0)
    parser_expect_symbol(parser, ":", "expected colon after match subject")
    parser_expect(parser, Newline, "expected newline after match subject")
    parser_separators(parser)
    parser_expect(parser, Indent, "expected indented match arms")
    arms: list[universal.MatchArm] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        arm_start = parser_peek(parser).span
        if not parser_at_identifier(parser, "case"):
            return error(parser_fail(parser, "expected case before match pattern"))
        parser_next(parser)
        pattern: universal.Expression | None := None
        if parser_at_identifier(parser, "_"):
            parser_next(parser)
        else:
            pattern = parser_expression(parser, 0)
        parser_expect_symbol(parser, ":", "expected colon after match pattern")
        body = parser_indented_block(parser, "match arm")
        arms.append(universal.MatchArm(body[0], span=arm_start, pattern=pattern))
        parser_separators(parser)
    end = parser_expect(parser, Dedent, "expected end of match").span.end
    return universal.Match(subject, arms, source.Span(start.source, start.start, end))

def parser_simple_statement(parser: Parser) -> universal.Statement | diagnostics.Diagnostic:
    if parser_looks_like_binding(parser):
        return universal.BindingStatement(parser_binding(parser))
    value = parser_expression(parser, 0)
    assignment = parser_peek(parser)
    update: universal.OperatorSyntax | None := None
    for syntax in assignment.syntaxes:
        if syntax.grammar_form == "Assignment":
            update = syntax
    if lexer.token_is_symbol(assignment, "=") or update != None:
        parser_next(parser)
        rhs = parser_expression(parser, 0)
        return universal.FieldSet(value, rhs, value.span, update)
    return universal.ExpressionStatement(value)

def parser_looks_like_binding(parser: Parser) -> bool:
    if parser.cursor[0] + 1 >= len(parser.tokens):
        return false
    match parser.tokens[parser.cursor[0]].kind:
        case Identifier:
            next = parser.tokens[parser.cursor[0] + 1]
            match next.kind:
                case Identifier:
                    if parser.cursor[0] + 2 < len(parser.tokens):
                        return lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 2], "=")
                case _:
                    pass
            return lexer.token_is_symbol(next, "=") or lexer.token_is_symbol(next, "?=") or lexer.token_is_symbol(next, ":=") or lexer.token_is_symbol(next, ":")
        case _:
            pass
    return false

def parser_binding(parser: Parser) -> universal.Binding | diagnostics.Diagnostic:
    start = parser_peek(parser).span
    name := parser_identifier(parser, "expected binding name")[0]
    annotation: universal.TypeAnnotation | None := None
    match parser_peek(parser).kind:
        case Identifier:
            annotation = universal.named_type(name, [], start)
            name = parser_identifier(parser, "expected binding name after type")[0]
        case _:
            pass
    if parser_take_symbol(parser, ":") != None:
        annotation = parser_type_annotation(parser)
    inferred = parser_take_symbol(parser, ":=") != None
    preserve_error = not inferred and parser_take_symbol(parser, "?=") != None
    if not inferred and not preserve_error:
        parser_expect_symbol(parser, "=", "expected `=`, `?=`, or `:=` after binding name")
    value = parser_expression(parser, 0)
    return universal.Binding(name, annotation, value, false, preserve_error, source.Span(start.source, start.start, value.span.end), mutable=inferred)

def parser_expression(parser: Parser, minimum: int) -> universal.Expression | diagnostics.Diagnostic:
    return parse_expression(parser, minimum)

def parser_unary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    return parse_unary(parser)

def parser_postfix(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    return parse_postfix(parser)

def parser_primary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    return parse_primary(parser)

def parser_type_annotation(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    return parse_type_annotation(parser)

def parser_type_primary(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    return parse_type_primary(parser)

def parse_expression(parser: Parser, minimum: int) -> universal.Expression | diagnostics.Diagnostic:
    left := parser_unary(parser)
    while true:
        if parser_at_identifier(parser, "not") and parser.cursor[0] + 1 < len(parser.tokens):
            following = parser.tokens[parser.cursor[0] + 1]
            if string(following) == "in" and is_binary_operator(following):
                operator = binary_operator(following)
                if precedence(operator) < minimum:
                    break
                negation = parser_next(parser)
                parser_next(parser)
                prefix ?= token_operator(negation, universal.Fixity.Prefix)
                if prefix != None:
                    right = parse_expression(parser, precedence(operator) + 1)
                    span = source.Span(left.span.source, left.span.start, right.span.end)
                    membership = universal.Expression(universal.Binary(operator, left, right), span)
                    left = universal.Expression(universal.Unary(prefix, membership), span)
                    continue
                return error(parser_fail(parser, "not in requires a negation operator"))
        if not is_binary_operator(parser_peek(parser)):
            break
        operator = binary_operator(parser_peek(parser))
        operator_precedence = precedence(operator)
        if operator_precedence < minimum:
            break
        token = parser_next(parser)
        next_minimum := operator_precedence
        if operator.associativity != universal.Associativity.Right:
            next_minimum += 1
        right = parse_expression(parser, next_minimum)
        left = universal.Expression(universal.Binary(operator, left, right), source.Span(token.span.source, left.span.start, right.span.end))
    if minimum == 0 and parser_at_identifier(parser, "if"):
        parser_next(parser)
        condition = parse_expression(parser, 1)
        if not parser_at_identifier(parser, "else"):
            return error(parser_fail(parser, "conditional expression requires else"))
        parser_next(parser)
        otherwise = parse_expression(parser, 0)
        return universal.Expression(universal.Conditional(condition, left, otherwise), source.Span(left.span.source, left.span.start, otherwise.span.end))
    if minimum == 0 and parser_at_identifier(parser, "else"):
        parser_next(parser)
        otherwise = parse_expression(parser, 0)
        return universal.Expression(universal.Fallback(left, otherwise), source.Span(left.span.source, left.span.start, otherwise.span.end))
    return left


def parse_unary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    token = parser_peek(parser)
    operator = token_operator(token, universal.Fixity.Prefix)
    selected ?= operator
    if selected != None:
        parser_next(parser)
        operand = parse_unary(parser)
        return universal.Expression(universal.Unary(selected, operand), source.Span(token.span.source, token.span.start, operand.span.end))
    return parser_postfix(parser)


def parse_postfix(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    value := parser_primary(parser)
    while true:
        if parser_take_symbol(parser, "(") != None:
            arguments: list[universal.CallArgument] = []
            while not parser_at_symbol(parser, ")"):
                start = parser_peek(parser).span
                argument_name: string | absent := absent
                if parser.cursor[0] + 1 < len(parser.tokens) and lexer.token_is_symbol(parser.tokens[parser.cursor[0] + 1], "="):
                    argument_name = parser_identifier(parser, "expected argument name")[0]
                    parser_expect_symbol(parser, "=", "expected = after argument name")
                argument = parse_expression(parser, 0)
                arguments.append(universal.CallArgument(argument_name, argument, source.Span(start.source, start.start, argument.span.end)))
                if parser_take_symbol(parser, ",") == None:
                    break
            end = parser_expect_symbol(parser, ")", "expected closing parenthesis").span.end
            value = universal.Expression(universal.Call(value, arguments), source.Span(value.span.source, value.span.start, end))
        elif parser_take_symbol(parser, "[") != None:
            first: universal.Expression | None := None
            if not parser_at_symbol(parser, ":"):
                first = parse_expression(parser, 0)
            if parser_take_symbol(parser, ":") != None:
                stop: universal.Expression | None := None
                step: universal.Expression | None := None
                if not parser_at_symbol(parser, ":") and not parser_at_symbol(parser, "]"):
                    stop = parse_expression(parser, 0)
                if parser_take_symbol(parser, ":") != None:
                    if not parser_at_symbol(parser, "]"):
                        step = parse_expression(parser, 0)
                end = parser_expect_symbol(parser, "]", "expected closing slice bracket").span.end
                value = universal.Expression(universal.Slice(value, first, stop, step), source.Span(value.span.source, value.span.start, end))
                continue
            index ?= first
            if index != None:
                end = parser_expect_symbol(parser, "]", "expected closing subscript bracket").span.end
                value = universal.Expression(universal.Subscript(value, index), source.Span(value.span.source, value.span.start, end))
            else:
                return error(parser_fail(parser, "expected a subscript index"))
        elif parser_take_symbol(parser, ".") != None:
            member = parser_identifier(parser, "expected member name")
            value = universal.Expression(universal.Member(value, member[0]), source.Span(value.span.source, value.span.start, member[1].end))
        else:
            break
    return value


def parse_primary(parser: Parser) -> universal.Expression | diagnostics.Diagnostic:
    token = parser_next(parser)
    match token.kind:
        case Identifier:
            value = string(token)
            if value == "throw":
                raised = parse_expression(parser, 0)
                return universal.Expression(universal.ThrowValue(raised), source.Span(token.span.source, token.span.start, raised.span.end))
            if value == "true":
                return universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), token.span)
            if value == "false":
                return universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), token.span)
            if value == "None":
                return universal.Expression(universal.LiteralValue(universal.LiteralValue.NoneValue), token.span)
            if value == "absent":
                return universal.Expression(universal.LiteralValue(universal.LiteralValue.AbsentValue), token.span)
            return universal.Expression(universal.Name(value), token.span)
        case Integer:
            value = lexer.token_number(token)
            return parser_numeric_suffix(parser, token, universal.Expression(universal.LiteralValue(universal.IntegerValue(value)), token.span))
        case Float:
            value = lexer.token_number(token)
            return parser_numeric_suffix(parser, token, universal.Expression(universal.LiteralValue(universal.FloatValue(value)), token.span))
        case Character:
            value = lexer.literal_codepoint(string(token))
            return universal.Expression(universal.LiteralValue(universal.CharacterValue(value)), token.span)
        case String:
            value = string(token)
            return universal.Expression(universal.LiteralValue(universal.StringValue(value)), token.span)
        case FormattedString:
            value = string(token)
            return formatted_string_expression(value, token.span, token.syntaxes, token.lexical_rules)
        case _:
            pass
    if lexer.token_is_symbol(token, "["):
        elements: list[universal.Expression] = []
        while not parser_at_symbol(parser, "]"):
            elements.append(parse_expression(parser, 0))
            if parser_take_symbol(parser, ",") == None:
                break
        end = parser_expect_symbol(parser, "]", "expected closing list bracket").span.end
        return universal.Expression(universal.ListLiteral(elements), source.Span(token.span.source, token.span.start, end))
    if lexer.token_is_symbol(token, "{"):
        keys: list[universal.Expression] = []
        values: list[universal.Expression] = []
        multiline = parser_take(parser, Newline) != None
        if multiline:
            parser_expect(parser, Indent, "expected indented map entries")
        parser_separators(parser)
        while not parser_at_symbol(parser, "}") and not parser_at_simple(parser, Dedent):
            keys.append(parse_expression(parser, 0))
            parser_expect_symbol(parser, ":", "expected colon after map key")
            values.append(parse_expression(parser, 0))
            if parser_take_symbol(parser, ",") == None:
                break
            parser_separators(parser)
        parser_separators(parser)
        if multiline:
            parser_expect(parser, Dedent, "expected end of map entries")
        end = parser_expect_symbol(parser, "}", "expected closing map brace").span.end
        return universal.Expression(universal.MapLiteral(keys, values), source.Span(token.span.source, token.span.start, end))
    if lexer.token_is_symbol(token, "("):
        if parser_take_symbol(parser, ")") != None:
            return universal.Expression(universal.TupleLiteral([]), token.span)
        expression = parse_expression(parser, 0)
        if parser_take_symbol(parser, ",") != None:
            elements = [expression]
            while not parser_at_symbol(parser, ")"):
                elements.append(parse_expression(parser, 0))
                if parser_take_symbol(parser, ",") == None:
                    break
            end = parser_expect_symbol(parser, ")", "expected closing tuple parenthesis").span.end
            return universal.Expression(universal.TupleLiteral(elements), source.Span(token.span.source, token.span.start, end))
        parser_expect_symbol(parser, ")", "expected closing parenthesis")
        return expression
    return error(diagnostics.Diagnostic("E000120", "expected an expression", token.span))


def parser_numeric_suffix(parser: Parser, number: lexer.Token, value: universal.Expression) -> universal.Expression:
    suffix = parser_peek(parser)
    if suffix.kind == TokenKind.Identifier and suffix.span.start == number.span.end:
        parser_next(parser)
        name = universal.Expression(universal.Name("literal_" + string(suffix)), suffix.span)
        span = source.Span(number.span.source, number.span.start, suffix.span.end)
        return universal.Expression(universal.Call(name, [universal.CallArgument(None, value, value.span)]), span)
    return value


def parse_type_annotation(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    first = parser_type_primary(parser)
    if parser_take_symbol(parser, "|") == None:
        return first
    members: list[universal.TypeAnnotation] = [first]
    while true:
        members.append(parser_type_primary(parser))
        if parser_take_symbol(parser, "|") == None:
            break
    return universal.TypeAnnotation(universal.Union(members), source.Span(first.span.source, first.span.start, members[-1].span.end))


def parse_type_primary(parser: Parser) -> universal.TypeAnnotation | diagnostics.Diagnostic:
    if parser_at_symbol(parser, "{"):
        start = parser_next(parser).span
        key = parse_type_annotation(parser)
        parser_expect_symbol(parser, ":", "expected colon in map type")
        value = parse_type_annotation(parser)
        end = parser_expect_symbol(parser, "}", "expected closing map type brace").span.end
        return universal.named_type("map", [key, value], source.Span(start.source, start.start, end))
    name = parser_identifier(parser, "expected a type name")
    qualified := name[0]
    while parser_take_symbol(parser, ".") != None:
        qualified += "." + parser_identifier(parser, "expected qualified type name")[0]
    arguments: list[universal.TypeAnnotation] = []
    end := name[1].end
    if parser_take_symbol(parser, "[") != None:
        while not parser_at_symbol(parser, "]"):
            arguments.append(parse_type_annotation(parser))
            if parser_take_symbol(parser, ",") == None:
                break
        end = parser_expect_symbol(parser, "]", "expected closing type bracket").span.end
    return universal.named_type(qualified, arguments, source.Span(name[1].source, name[1].start, end))


def token_operator(token: lexer.Token, fixity: universal.Fixity) -> universal.OperatorSyntax | None:
    # Formatted literals carry the registry for their embedded expressions;
    # that registry does not make the literal itself an operator.
    match token.kind:
        case FormattedString:
            return None
        case _:
            pass
    for syntax in token.syntaxes:
        if syntax.fixity == fixity and (syntax.grammar_form == "" or syntax.grammar_form == "Infix" or syntax.grammar_form == "Prefix" or syntax.grammar_form == "Postfix"):
            return syntax
    return None


def is_binary_operator(token: lexer.Token) -> bool:
    return token_operator(token, universal.Fixity.Infix) != None


def binary_operator(token: lexer.Token) -> universal.OperatorSyntax:
    syntax ?= token_operator(token, universal.Fixity.Infix)
    if syntax != None:
        return syntax
    throw Error("token has no registered infix operator")


def precedence(operator: universal.OperatorSyntax) -> int:
    return int(operator.precedence)


def parse(tokens: list[lexer.Token]) -> universal.Module | diagnostics.Diagnostic:
    return parser_module(Parser(tokens))


def parser_record_declaration(parser: Parser, extension: bool = false) -> universal.RecordDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected a class name")[0]
    generic_parts = parser_type_parameters(parser)
    parser_expect_symbol(parser, ":", "expected colon after class name")
    traits: list[universal.TypeAnnotation] = []
    if not parser_at_simple(parser, Newline):
        while true:
            traits.append(parser_type_annotation(parser))
            if parser_take_symbol(parser, "+") == None:
                break
        parser_take_symbol(parser, ":")
    parser_separators(parser)
    fields: list[universal.FunctionParameter] = []
    methods: list[universal.FunctionDeclaration] = []
    operators: list[universal.OperatorDeclaration] = []
    if parser_take(parser, Indent) != None:
        while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
            if parser_at_identifier(parser, "def"):
                methods.append(parser_function_declaration(parser, []))
            elif parser_at_identifier(parser, "operator"):
                operators.append(parser_operator_declaration(parser))
            elif parser_at_identifier(parser, "trait"):
                parser_next(parser)
                traits.append(parser_type_annotation(parser))
            elif parser_at_identifier(parser, "pass"):
                parser_next(parser)
            else:
                field = parser_identifier(parser, "expected a field or method")
                parser_expect_symbol(parser, ":", "expected field annotation")
                annotation = parser_type_annotation(parser)
                default: universal.Expression | None := None
                if parser_take_symbol(parser, "=") != None:
                    default = parser_expression(parser, 0)
                fields.append(universal.FunctionParameter(field[0], annotation, default, field[1]))
            parser_separators(parser)
        parser_expect(parser, Dedent, "expected end of class")
    return universal.RecordDeclaration(name, fields, methods, source.Span(start.source, start.start, parser_peek(parser).span.start), traits=traits, operators=operators, type_parameters=generic_parts[0], constraints=generic_parts[1], extension=extension)


def parser_family_declaration(parser: Parser) -> universal.TypeDeclaration | diagnostics.Diagnostic:
    start = parser_next(parser).span
    name = parser_identifier(parser, "expected family name")[0]
    parser_expect_symbol(parser, ":", "expected family body")
    parser_expect(parser, Newline, "expected family members")
    parser_expect(parser, Indent, "expected indented family")
    members: list[universal.TypeAnnotation] = []
    parser_separators(parser)
    while not parser_at_simple(parser, Dedent) and not parser_at_simple(parser, Eof):
        members.append(parser_type_annotation(parser))
        parser_separators(parser)
    parser_expect(parser, Dedent, "expected end of family")
    return universal.TypeDeclaration([], name, [], [], universal.TypeAnnotation(universal.Union(members), start), start)


def parser_grammar_declaration(parser: Parser) -> universal.GrammarDeclaration | diagnostics.Diagnostic:
    start = parser_peek(parser)
    declaration = parser_function_declaration(parser, [])
    if len(declaration.type_parameters) != 1 or declaration.type_parameters[0] != "G" or len(declaration.constraints) != 0:
        return error(parser_fail(parser, "grammar declaration requires [G]"))
    body ?= declaration.body
    if body == None:
        return error(parser_fail(parser, "grammar requires a lowering body"))
    if len(start.syntaxes) != 1:
        return error(parser_fail(parser, "grammar requires registered symbol and form metadata"))
    if body != None:
        syntax = start.syntaxes[0]
        return universal.GrammarDeclaration(declaration.name, declaration.parameters, body, start.span, syntax=syntax, definition=syntax.definition, result=declaration.result)
    return error(parser_fail(parser, "grammar requires a lowering body"))
