import lexer
import diagnostics
import source
import universal

def formatted_string_expression(value: string, span: source.Span) -> universal.Expression | diagnostics.Diagnostic:
    characters = value.characters()
    cursor := 0
    literal := ""
    parts: list[universal.Expression] = []
    while cursor < len(characters):
        if characters[cursor] == "{" and cursor + 1 < len(characters) and characters[cursor + 1] == "{":
            literal += "{"
            cursor += 2
            continue
        if characters[cursor] == "}" and cursor + 1 < len(characters) and characters[cursor + 1] == "}":
            literal += "}"
            cursor += 2
            continue
        if characters[cursor] == "}":
            return error(diagnostics.Diagnostic("E000113", "single } in formatted string; write }} for a literal brace", span))
        if characters[cursor] != "{":
            literal += string(characters[cursor])
            cursor += 1
            continue
        if len(literal) > 0:
            parts.append(universal.Expression(universal.LiteralValue(universal.StringValue(literal)), span))
            literal = ""
        expression_start = cursor + 1
        cursor = expression_start
        nesting := 0
        while cursor < len(characters):
            if characters[cursor] == "(" or characters[cursor] == "[":
                nesting += 1
            elif characters[cursor] == ")" or characters[cursor] == "]":
                nesting -= 1
            elif characters[cursor] == "}" and nesting == 0:
                break
            cursor += 1
        if cursor >= len(characters):
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation is missing }", span))
        expression_source = characters[expression_start:cursor].join("").trim()
        if len(expression_source) == 0:
            return error(diagnostics.Diagnostic("E000113", "formatted string interpolation may not be empty", span))
        interpolation = source.SourceFile(span.source, "<formatted-string>", expression_source)
        expression_parser = Parser(lexer.scan(interpolation))
        parts.append(expression_parser.expression(0))
        cursor += 1
    if len(literal) > 0:
        parts.append(universal.Expression(universal.LiteralValue(universal.StringValue(literal)), span))
    if len(parts) == 0:
        return universal.Expression(universal.LiteralValue(universal.StringValue("")), span)
    result := parts[0]
    for part in parts[1:]:
        result = universal.Expression(universal.Binary(universal.Add, result, part), span)
    return result

class Parser:
    tokens: list[lexer.Token]
    cursor: int

    def Parser(tokens: list[lexer.Token]):
        self.tokens = tokens
        cursor = 0

    def peek() -> lexer.Token:
        return tokens[cursor]

    def next() -> lexer.Token:
        token = tokens[cursor]
        cursor += 1
        return token

    def at_identifier(expected: string) -> bool:
        match peek().kind:
            case Identifier:
                return value == expected
        return false

    def at_simple(expected: lexer.TokenKind) -> bool:
        return peek().kind == expected

    def take(expected: lexer.TokenKind) -> lexer.Token | None:
        if at_simple(expected):
            return next()
        return None

    def fail(message: string) -> diagnostics.Diagnostic:
        return diagnostics.Diagnostic("E000120", message, peek().span)

    def identifier(message: string) -> tuple[string, source.Span] | diagnostics.Diagnostic:
        token = next()
        match token.kind:
            case Identifier:
                return (value, token.span)
        return error(diagnostics.Diagnostic("E000120", message, token.span))

    def expect(expected: lexer.TokenKind, message: string) -> lexer.Token | diagnostics.Diagnostic:
        token = take(expected)
        if token == None:
            return error(fail(message))
        return token

    def separators():
        while at_simple(Newline) or at_simple(Comma):
            next()

    def module() -> universal.Module | diagnostics.Diagnostic:
        result = universal.Module([])
        separators()
        while not at_simple(Eof):
            if at_identifier("import"):
                result.items.append(universal.Import(import_declaration()))
            elif at_identifier("trait"):
                result.items.append(universal.Trait(trait_declaration([])))
            elif at_identifier("def"):
                result.items.append(universal.Function(function_declaration([])))
            elif at_identifier("type"):
                result.items.append(universal.Type(type_declaration([])))
            elif at_identifier("test"):
                result.items.append(universal.Test(test_declaration()))
            elif at_identifier("return") or at_identifier("break") or at_identifier("continue"):
                return error(diagnostics.Diagnostic("E000121", "control flow is not valid at module scope", peek().span))
            else:
                statement = simple_statement()
                match statement:
                    case BindingStatement:
                        result.items.append(universal.BindingItem(binding))
                    case ExpressionStatement:
                        result.items.append(universal.ExpressionItem(expression))
                    else:
                        return error(fail("expected a module declaration"))
            separators()
        return result

    def import_declaration() -> universal.ImportDeclaration | diagnostics.Diagnostic:
        start = next().span
        first = identifier("expected an import name")
        if at_identifier("from"):
            next()
            source_name = identifier("expected an import source")[0]
            alias: string | None = None
            if at_identifier("as"):
                next()
                alias = identifier("expected an import alias")[0]
            return universal.ImportDeclaration(universal.Name(first[0]), source_name, alias, source.Span(start.source, start.start, peek().span.start))
        alias: string | None = None
        if at_identifier("as"):
            next()
            alias = identifier("expected an import alias")[0]
        return universal.ImportDeclaration(universal.Name(first[0]), None, alias, source.Span(start.source, start.start, peek().span.start))

    def type_parameters() -> tuple[list[string], list[universal.GenericConstraint]] | diagnostics.Diagnostic:
        parameters: list[string] = []
        constraints: list[universal.GenericConstraint] = []
        if take(LeftBracket) == None:
            return (parameters, constraints)
        if not at_simple(RightBracket):
            while true:
                parameter = identifier("expected a generic parameter")
                parameters.append(parameter[0])
                if take(Colon) != None:
                    bound = type_annotation()
                    constraints.append(universal.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
                if take(Comma) == None:
                    break
        expect(RightBracket, "expected closing type parameter bracket")
        return (parameters, constraints)

    def declaration_constraints() -> list[universal.GenericConstraint] | diagnostics.Diagnostic:
        constraints: list[universal.GenericConstraint] = []
        if not at_identifier("with"):
            return constraints
        next()
        expect(LeftBrace, "expected { after declaration with")
        multiline = take(Newline) != None
        if multiline:
            expect(Indent, "expected indented declaration constraints")
        separators()
        while not at_simple(RightBrace) and not at_simple(Dedent):
            if cursor + 1 < len(tokens) and tokens[cursor + 1].kind == Colon:
                parameter = identifier("expected constrained parameter")
                expect(Colon, "expected colon after constrained parameter")
                bound = type_annotation()
                constraints.append(universal.Parameter(parameter[0], bound, source.Span(parameter[1].source, parameter[1].start, bound.span.end)))
            else:
                constraints.append(universal.Predicate(expression(0)))
            take(Comma)
            separators()
        if multiline:
            expect(Dedent, "expected end of declaration constraints")
        expect(RightBrace, "expected } after declaration constraints")
        return constraints

    def function_declaration(decorators: list[universal.Decorator]) -> universal.FunctionDeclaration | diagnostics.Diagnostic:
        start = next().span
        name = identifier("expected a function name")[0]
        generic_parts = type_parameters()
        generics = generic_parts[0]
        constraints = generic_parts[1]
        expect(LeftParen, "expected opening parenthesis")
        parameters: list[universal.FunctionParameter] = []
        while not at_simple(RightParen):
            parameter = identifier("expected a parameter name")
            expect(Colon, "expected colon after parameter")
            annotation = type_annotation()
            default: universal.Expression | absent = absent
            if take(Equal) != absent:
                default = expression(0)
            parameter_end = annotation.span.end if default is absent else default.span.end
            parameters.append(universal.FunctionParameter(parameter[0], annotation, default, source.Span(parameter[1].source, parameter[1].start, parameter_end)))
            if take(Comma) == None:
                break
        close = expect(RightParen, "expected closing parenthesis").span
        result = universal.named_type("unit", [], close)
        if take(Arrow) != None:
            result = type_annotation()
        constraints += declaration_constraints()
        body: universal.Block | None = None
        end = result.span.end
        if take(Colon) != None:
            block = indented_block("function")
            body = block[0]
            end = block[1]
        return universal.FunctionDeclaration(decorators, name, generics, constraints, parameters, result, body, source.Span(start.source, start.start, end))

    def type_declaration(decorators: list[universal.Decorator]) -> universal.TypeDeclaration | diagnostics.Diagnostic:
        start = next().span
        name = identifier("expected a type name")[0]
        generic_parts = type_parameters()
        parameters = generic_parts[0]
        constraints = generic_parts[1]
        definition: universal.TypeAnnotation | None = None
        if take(Equal) != None:
            definition = type_annotation()
        constraints += declaration_constraints()
        return universal.TypeDeclaration(decorators, name, parameters, constraints, definition, source.Span(start.source, start.start, peek().span.start))

    def trait_declaration(decorators: list[universal.Decorator]) -> universal.TraitDeclaration | diagnostics.Diagnostic:
        start = next().span
        name = identifier("expected a trait name")[0]
        generic_parts = type_parameters()
        parameters = generic_parts[0]
        constraints = generic_parts[1]
        constraints += declaration_constraints()
        bases: list[universal.TypeAnnotation] = []
        if take(Colon) != None and not at_simple(Newline):
            while true:
                bases.append(type_annotation())
                if take(Plus) == None:
                    break
            expect(Colon, "expected colon before trait body")
        properties: list[universal.PropertyDeclaration] = []
        operators: list[universal.OperatorDeclaration] = []
        if at_simple(Newline):
            expect(Newline, "expected trait body")
            expect(Indent, "expected indented trait body")
            separators()
            while not at_simple(Dedent):
                if at_identifier("property"):
                    property_start = next().span
                    property_name = identifier("expected property name")[0]
                    expect(Colon, "expected property type")
                    annotation = type_annotation()
                    default: universal.Expression | None = None
                    if take(Equal) != None:
                        default = expression(0)
                    properties.append(universal.PropertyDeclaration(property_name, annotation, default, property_start))
                else:
                    next()
                separators()
            expect(Dedent, "expected end of trait")
        return universal.TraitDeclaration(decorators, name, parameters, constraints, bases, properties, operators, source.Span(start.source, start.start, peek().span.start))

    def test_declaration() -> universal.TestDeclaration | diagnostics.Diagnostic:
        start = next().span
        modes: list[string] = []
        if at_identifier("with"):
            next()
            while true:
                modes.append(identifier("expected test mode")[0])
                if not at_identifier("and"):
                    break
                next()
        name: string | None = None
        match peek().kind:
            case String:
                name = value
                next()
        expect(Colon, "expected colon after test")
        block = indented_block("test")
        return universal.TestDeclaration(name, modes, block[0], [], source.Span(start.source, start.start, block[1]))

    def indented_block(owner: string) -> tuple[universal.Block, u32] | diagnostics.Diagnostic:
        expect(Newline, "expected newline after " + owner)
        while take(Newline) != None:
            pass
        expect(Indent, "expected indented " + owner + " body")
        statements: list[universal.Statement] = []
        separators()
        while not at_simple(Dedent) and not at_simple(Eof):
            if at_identifier("pass"):
                next()
            else:
                statements.append(block_statement())
            separators()
        end = expect(Dedent, "expected end of " + owner + " body").span.end
        return (universal.Block(statements, [], []), end)

    def block_statement() -> universal.Statement | diagnostics.Diagnostic:
        if at_identifier("return"):
            start = next().span
            if at_simple(Newline) or at_simple(Dedent):
                return universal.Return(None, start)
            value = expression(0)
            return universal.Return(value, source.Span(start.source, start.start, value.span.end))
        if at_identifier("assert"):
            start = next().span
            condition = expression(0)
            message: universal.Expression | None = None
            if take(Comma) != None:
                message = expression(0)
            return universal.Assert(condition, message, source.Span(start.source, start.start, condition.span.end), condition.span)
        return simple_statement()

    def simple_statement() -> universal.Statement | diagnostics.Diagnostic:
        if looks_like_binding():
            return universal.BindingStatement(binding())
        return universal.ExpressionStatement(expression(0))

    def looks_like_binding() -> bool:
        if cursor + 1 >= len(tokens):
            return false
        match tokens[cursor].kind:
            case Identifier:
                return tokens[cursor + 1].kind == Equal or tokens[cursor + 1].kind == QuestionEqual or tokens[cursor + 1].kind == ColonEqual or tokens[cursor + 1].kind == Colon
        return false

    def binding() -> universal.Binding | diagnostics.Diagnostic:
        start = peek().span
        name = identifier("expected binding name")[0]
        annotation: universal.TypeAnnotation | None = None
        if take(Colon) != None:
            annotation = type_annotation()
        inferred = take(ColonEqual) != None
        preserve_error = not inferred and take(QuestionEqual) != None
        if not inferred and not preserve_error:
            expect(Equal, "expected `=`, `?=`, or `:=` after binding name")
        value = expression(0)
        return universal.Binding(name, annotation, value, false, preserve_error, source.Span(start.source, start.start, value.span.end))

    def expression(minimum: int) -> universal.Expression | diagnostics.Diagnostic:
        left = unary()
        while true:
            if not is_binary_operator(peek().kind):
                break
            operator = binary_operator(peek().kind)
            operator_precedence = precedence(operator)
            if operator_precedence < minimum:
                break
            token = next()
            next_minimum := operator_precedence
            if operator.associativity != universal.Associativity.Right:
                next_minimum += 1
            right = expression(next_minimum)
            left = universal.Expression(universal.Binary(operator, left, right), source.Span(token.span.source, left.span.start, right.span.end))
        return left

    def unary() -> universal.Expression | diagnostics.Diagnostic:
        token = peek()
        operator: universal.UnaryOperator | None = None
        if token.kind == Plus:
            operator = universal.Positive
        elif token.kind == Minus:
            operator = universal.Negative
        elif at_identifier("not"):
            operator = universal.Not
        elif at_identifier("move"):
            operator = universal.Move
        if operator != None:
            next()
            operand = unary()
            return universal.Expression(universal.Unary(operator, operand), source.Span(token.span.source, token.span.start, operand.span.end))
        return postfix()

    def postfix() -> universal.Expression | diagnostics.Diagnostic:
        value = primary()
        while true:
            if take(LeftParen) != None:
                arguments: list[universal.CallArgument] = []
                while not at_simple(RightParen):
                    start = peek().span
                    argument_name: string | absent = absent
                    if cursor + 1 < len(tokens) and tokens[cursor + 1].kind == Equal:
                        argument_name = identifier("expected argument name")[0]
                        expect(Equal, "expected = after argument name")
                    argument = expression(0)
                    arguments.append(universal.CallArgument(argument_name, argument, source.Span(start.source, start.start, argument.span.end)))
                    if take(Comma) == None:
                        break
                end = expect(RightParen, "expected closing parenthesis").span.end
                value = universal.Expression(universal.Call(value, arguments), source.Span(value.span.source, value.span.start, end))
            elif take(Dot) != None:
                member = identifier("expected member name")
                value = universal.Expression(universal.Member(value, member[0]), source.Span(value.span.source, value.span.start, member[1].end))
            else:
                break
        return value

    def primary() -> universal.Expression | diagnostics.Diagnostic:
        token = next()
        match token.kind:
            case Identifier:
                if value == "true":
                    return universal.Expression(universal.LiteralValue(universal.BooleanValue(true)), token.span)
                if value == "false":
                    return universal.Expression(universal.LiteralValue(universal.BooleanValue(false)), token.span)
                if value == "None":
                    return universal.Expression(universal.LiteralValue(universal.NoneValue), token.span)
                return universal.Expression(universal.Name(value), token.span)
            case Integer:
                return universal.Expression(universal.LiteralValue(universal.IntegerValue(value)), token.span)
            case Float:
                return universal.Expression(universal.LiteralValue(universal.FloatValue(value)), token.span)
            case Character:
                return universal.Expression(universal.LiteralValue(universal.CharacterValue(value)), token.span)
            case String:
                return universal.Expression(universal.LiteralValue(universal.StringValue(value)), token.span)
            case FormattedString:
                return formatted_string_expression(value, token.span)
            case LeftParen:
                value = expression(0)
                expect(RightParen, "expected closing parenthesis")
                return value
        return error(diagnostics.Diagnostic("E000120", "expected an expression", token.span))

    def type_annotation() -> universal.TypeAnnotation | diagnostics.Diagnostic:
        first = type_primary()
        if take(Pipe) == None:
            return first
        members: list[universal.TypeAnnotation] = [first]
        while true:
            members.append(type_primary())
            if take(Pipe) == None:
                break
        return universal.TypeAnnotation(universal.Union(members), source.Span(first.span.source, first.span.start, members[-1].span.end))

    def type_primary() -> universal.TypeAnnotation | diagnostics.Diagnostic:
        name = identifier("expected a type name")
        arguments: list[universal.TypeAnnotation] = []
        end = name[1].end
        if take(LeftBracket) != None:
            while not at_simple(RightBracket):
                arguments.append(type_annotation())
                if take(Comma) == None:
                    break
            end = expect(RightBracket, "expected closing type bracket").span.end
        return universal.named_type(name[0], arguments, source.Span(name[1].source, name[1].start, end))


def is_binary_operator(kind: lexer.TokenKind) -> bool:
    return kind == Plus or kind == Minus or kind == Star or kind == Slash or kind == Percent or kind == Power or kind == EqualEqual or kind == NotEqual or kind == Less or kind == LessEqual or kind == Greater or kind == GreaterEqual


def binary_operator(kind: lexer.TokenKind) -> universal.BinaryOperator:
    if kind == Plus:
        return universal.Add
    if kind == Minus:
        return universal.Subtract
    if kind == Star:
        return universal.Multiply
    if kind == Slash:
        return universal.Divide
    if kind == Percent:
        return universal.Remainder
    if kind == Power:
        return universal.Power
    if kind == EqualEqual:
        return universal.Equal
    if kind == NotEqual:
        return universal.NotEqual
    if kind == Less:
        return universal.Less
    if kind == LessEqual:
        return universal.LessEqual
    if kind == Greater:
        return universal.Greater
    if kind == GreaterEqual:
        return universal.GreaterEqual
    # Callers prove the token is binary with `is_binary_operator` first.
    return universal.Add


def precedence(operator: universal.BinaryOperator) -> int:
    return int(operator.precedence)


def parse(tokens: list[lexer.Token]) -> universal.Module | diagnostics.Diagnostic:
    return Parser(tokens).module()
