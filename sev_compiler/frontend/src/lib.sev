import SourceFile from "../source/source.sev"
import TokenStream from "../lexer/stream.sev"
import RegistryLexer from "../lexer/lexer.sev"
import parser from "../parser/parser.sev"
import BlockGraph from "../../hir/hir/src/dependencies.sev"
import Program, partition from "../../hir/hir/src/program.sev"
import Diagnostic from "../../syntax/primitive/error/diagnostic.sev"
import "../../syntax/recognition.sev" as syntax
import PointerPrimitive from "../../syntax/primitive/pointer/declarations.sev"
import MlirTypeBinding, TypeMapping, DeclaredTypeMapping from "../../mlir/src/types.sev"
import TypedProgram, TypingProvider, RealizationRequest, prepare from "../../thir/src/lib.sev"
import TyInterner from "../../syntax/type/system.sev"
import MirState, register from "../../mir/src/lib.sev"

class FrontendState:
    source: SourceFile
    package: string = ""
    module: string = "main"
    tokens: TokenStream | None = None
    graph: BlockGraph | None = None
    program: Program | None = None
    diagnostics: list[Diagnostic] = []
    pointer: MlirTypeBinding | None = None
    types: TypeMapping | None = None
    typed: TypedProgram | None = None
    mir: MirState | None = None

trait FrontendStage:
    name: string
    provider: string
    def apply(state: FrontendState) -> absent | Error

class MlirStage: FrontendStage
    name: string = "mlir"
    provider: string = "sev-compiler-mlir"
    def apply(state: FrontendState) -> absent | Error:
        state.types = DeclaredTypeMapping()

class SyntaxStage: FrontendStage
    name: string = "syntax"
    provider: string = "sev-compiler-syntax"
    def apply(state: FrontendState) -> absent | Error:
        types ?= state.types
        if types == None:
            throw Error("syntax requires MLIR type mapping")
        pointer = PointerPrimitive()
        types.resolve(pointer)
        state.pointer = pointer.mlir
        syntax.registry()

class LexerStage: FrontendStage
    name: string = "lexer"
    provider: string = "sev-compiler-lexer"
    def apply(state: FrontendState) -> absent | Error:
        result = RegistryLexer().lex(state.source)
        if result is list[Diagnostic]:
            state.diagnostics = result
            throw Error("lexer rejected source")
        state.tokens = result

class ParserStage: FrontendStage
    name: string = "parser"
    provider: string = "sev-compiler-parser"
    def apply(state: FrontendState) -> absent | Error:
        tokens ?= state.tokens
        if tokens == None:
            throw Error("parser requires lexer output")
        result = parser(tokens, state.package, state.module)
        if result is list[Diagnostic]:
            state.diagnostics = result
            throw Error("parser rejected source")
        state.graph = result

class HirStage: FrontendStage
    name: string = "hir"
    provider: string = "sev-compiler-hir"
    def apply(state: FrontendState) -> absent | Error:
        graph ?= state.graph
        if graph == None:
            throw Error("HIR requires parser output")
        state.program = partition(graph)


class ThirStage: FrontendStage
    typing: TypingProvider
    interner: TyInterner
    roots: list[RealizationRequest]
    name: string = "thir"
    provider: string = "sev-compiler-thir"

    def apply(state: FrontendState) -> absent | Error:
        state.typed = None
        state.mir = None
        program ?= state.program
        if program == None:
            throw Error("THIR requires HIR output")
        state.typed = prepare(program, self.interner, self.typing, self.roots)


class MirRegistrationStage: FrontendStage
    name: string = "mir-registration"
    provider: string = "sev-compiler-mir"

    def apply(state: FrontendState) -> absent | Error:
        state.mir = None
        typed ?= state.typed
        if typed == None:
            throw Error("MIR registration requires typed submodules")
        if state.program != typed.source:
            throw Error("MIR registration requires the current HIR program")
        state.mir = register(typed)


def stages() -> list[FrontendStage]:
    return [MlirStage(), SyntaxStage(), LexerStage(), ParserStage(), HirStage()]


def typed_stages(typing: TypingProvider, interner: TyInterner, roots: list[RealizationRequest]) -> list[FrontendStage]:
    result = stages()
    result.append(ThirStage(typing, interner, roots))
    result.append(MirRegistrationStage())
    return result


def inspect(state: FrontendState) -> string | Error:
    program ?= state.program
    if program == None:
        throw Error("frontend has no realized Program")
    return "Program: " + string(len(program.modules)) + " modules, " + string(len(program.submodules)) + " submodules\n" + program.graph.print()


test "parser stage requires actual lexer output":
    state = FrontendState(SourceFile(0, "missing.sev", "true"))
    result ?= ParserStage().apply(state)
    assert(result is Error)
    assert(state.graph == None and state.program == None)


import hash_typing_fixture from "../../thir/src/lib.sev"


test "frontend hands typed hash submodules to MIR and clears rejected output":
    types = TyInterner()
    program, typing, inputs = hash_typing_fixture(types)
    state = FrontendState(SourceFile(0, "hash.sev", ""), program=program)
    roots = [RealizationRequest(typing.template.definition, [value]) for value in inputs]
    stage = ThirStage(typing, types, roots)
    stage.apply(state)
    MirRegistrationStage().apply(state)
    mir ?= state.mir
    assert(mir != None)
    assert(len(mir.interfaces[0].modules[0].submodules) == 3)
    typing.reject = true
    failure ?= stage.apply(state)
    assert(failure is Error)
    assert(state.typed == None and state.mir == None)
