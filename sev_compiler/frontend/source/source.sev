import file
import Y from "../../syntax/generic/symbol.sev"
import TokenForm from "../../syntax/generic/token.sev"

# End boundary has no character payload.
class EOF: Y
    token_forms: list[TokenForm] = [TokenForm("EOF", "", boundary=true)]


class SourceId:
    index: u32

class Span:
    # Internal coordinates are half-open Unicode scalar indices. Serialized
    # tooling interfaces use UTF-8 bytes; convert explicitly at that boundary.
    source: SourceId
    start: u32
    end: u32



class SourceFile:
    id: SourceId
    path: string
    text: string
    #Know what files and symbols are coming from outside the file
    imports: dict[string, list[string]] = dict[string, list[string]]()
    characters: list[string]
    # Derived lazily, shared by repeated tooling span queries, never archived.
    byte_offsets: list[int] = []

    def SourceFile(id: SourceId, path: string, text: string):
        self.id = id
        self.path = path
        self.text = text
        self.characters = text.characters()

def source_id(index: u32) -> SourceId:
    return SourceId(index)

def span(source: SourceId, start: u32, end: u32) -> Span:
    return Span(source, start, end)

def virtual_source(path: string, text: string) -> SourceFile:
    return SourceFile(SourceId(0), path, text)

#UTF-8 offset
def offset(file: SourceFile, offset: u32) -> u32 | Error:
    if offset > len(file.characters):
        throw Error("source offset is out of bounds")
    if len(file.byte_offsets) == 0:
        cursor := 0
        for byte in file.text.bytes():
            if byte < 128 or byte >= 192:
                file.byte_offsets.append(cursor)
            cursor += 1
        file.byte_offsets.append(cursor)
    return u32(file.byte_offsets[offset])

def load(path: string) -> SourceFile | Error:
    return virtual_source(path, file.read_checked(path))

class SourceMap:
    files: list[SourceFile] = []

    def add_virtual(path: string, text: string) -> SourceId:
        id = SourceId(u32(len(files)))
        files.append(SourceFile(id, path, text))
        return id

    def load(path: string) -> SourceId | Error:
        return add_virtual(path, file.read_checked(path))

    def get(id: SourceId) -> SourceFile:
        return files[id.index]
