import * from "../../../hir/module/module.sev" as model_hir_module_module
import * from "../../../syntax/block/block.sev" as model_syntax_block_block
import * from "../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../syntax/sentence/sentence.sev" as model_syntax_sentence_sentence
import source
import * from "../modules/src/imports.sev" as imports


test "automatic import selection retains function implementation dependencies":
    span = source.Span(source.SourceId(0), 0, 1)
    reference = model_syntax_function_function.Expression(model_syntax_function_function.Name("helper"), span)
    call = model_syntax_function_function.Expression(model_syntax_function_function.Call(reference, []), span)
    needed = model_syntax_function_function.FunctionDeclaration(name="lib.needed", lookup="lib.", body=model_syntax_block_block.Block([model_syntax_sentence_sentence.ExpressionStatement(call)]))
    helper = model_syntax_function_function.FunctionDeclaration(name="lib.helper", lookup="lib.", body=model_syntax_block_block.empty_block())
    unused = model_syntax_function_function.FunctionDeclaration(name="lib.unused", lookup="lib.", body=model_syntax_block_block.empty_block())
    child = model_hir_module_module.Module([model_hir_module_module.Function(needed), model_hir_module_module.Function(helper), model_hir_module_module.Function(unused)])
    selected = imports.select_imported_items(child, "lib.", ["needed"], true)
    assert(len(selected) == 2)
    assert(imports.item_name(selected[0]) == "lib.needed")
    assert(imports.item_name(selected[1]) == "lib.helper")
    assert(len(imports.select_imported_items(child, "lib.", ["needed"], false)) == 3)


test "downstream namespace requirements survive a selective alias":
    required = imports.imported_requirements(["renamed.nested.run"], "renamed", "api")
    assert("api" in required)
    assert("api.nested.run" in required)
    leaf = imports.imported_requirements(required, "api", None)
    assert("nested.run" in leaf)


test "unsupported reference forms retain the original dependency":
    span = source.Span(source.SourceId(0), 0, 1)
    unknown = model_syntax_function_function.Expression(model_syntax_function_function.UpdateOperand(0), span)
    needed = model_syntax_function_function.FunctionDeclaration(name="lib.needed", lookup="lib.", body=model_syntax_block_block.Block([model_syntax_sentence_sentence.ExpressionStatement(unknown)]))
    unused = model_syntax_function_function.FunctionDeclaration(name="lib.unused", lookup="lib.", body=model_syntax_block_block.empty_block())
    child = model_hir_module_module.Module([model_hir_module_module.Function(needed), model_hir_module_module.Function(unused)])
    assert(len(imports.select_imported_items(child, "lib.", ["needed"], true)) == 2)
