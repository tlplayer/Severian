import * from "../../../../hir/module/module.sev" as model_hir_module_module
import * from "../../../../syntax/function/function.sev" as model_syntax_function_function
import * from "../../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import * from "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol


def operator_key(operation: model_syntax_function_syntax.OperatorDeclaration, owner: string) -> string:
    parts = [owner, "operator", operation.syntax.symbol]
    for parameter in operation.parameters:
        parts.append(model_syntax_function_function.annotation_key(parameter.annotation, operation.type_parameters))
        parts.append(parameter.mode)
    return model_syntax_symbol_symbol.semantic_key(parts)


def stamp_function(function: model_syntax_function_function.FunctionDeclaration, owner: string) -> model_syntax_function_function.FunctionDeclaration:
    function.semantic_key = model_syntax_function_function.callable_key(function, owner)
    function.definition = model_syntax_symbol_symbol.definition_from_key(function.semantic_key)
    return function


# Stamp before import aliases are introduced. Membership is supplied exclusively
# by library/package; no path, discovery ordinal or source span enters these IDs.
def stamp_module(module: model_hir_module_module.Module, owner: string) -> model_hir_module_module.Module:
    items: list[model_hir_module_module.Item] = []
    for item in module.items:
        match item:
            case Function:
                items.append(model_hir_module_module.Function(stamp_function(declaration, owner)))
            case Trait:
                declaration.definition = model_syntax_symbol_symbol.named_definition(owner, "trait", declaration.name)
                member_owner = model_syntax_symbol_symbol.semantic_key([owner, "trait", declaration.name])
                properties: list[model_syntax_function_syntax.PropertyDeclaration] = []
                for property in declaration.properties:
                    property.definition = model_syntax_symbol_symbol.named_definition(member_owner, "property", property.name)
                    properties.append(property)
                methods: list[model_syntax_function_function.FunctionDeclaration] = []
                for method in declaration.methods:
                    methods.append(stamp_function(method, member_owner))
                operations: list[model_syntax_function_syntax.OperatorDeclaration] = []
                for operation in declaration.operators:
                    operation.definition = model_syntax_symbol_symbol.definition_from_key(operator_key(operation, member_owner))
                    operations.append(operation)
                declaration.properties = properties
                declaration.methods = methods
                declaration.operators = operations
                items.append(model_hir_module_module.Trait(declaration))
            case OperatorItem:
                declaration.definition = model_syntax_symbol_symbol.definition_from_key(operator_key(declaration, owner))
                items.append(model_hir_module_module.OperatorItem(declaration))
            case Record:
                member_owner = model_syntax_symbol_symbol.semantic_key([owner, "extension" if declaration.extension else "record", declaration.name])
                declaration.definition = model_syntax_symbol_symbol.definition_from_key(member_owner)
                methods: list[model_syntax_function_function.FunctionDeclaration] = []
                for method in declaration.methods:
                    methods.append(stamp_function(method, member_owner))
                operations: list[model_syntax_function_syntax.OperatorDeclaration] = []
                for operation in declaration.operators:
                    operation.definition = model_syntax_symbol_symbol.definition_from_key(operator_key(operation, member_owner))
                    operations.append(operation)
                declaration.methods = methods
                declaration.operators = operations
                items.append(model_hir_module_module.Record(declaration))
            case _:
                items.append(item)
    module.items = items
    return module
