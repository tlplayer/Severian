import lexer
import diagnostics
import source
from source import SourceFile
import universal
import package
from io import IOError
import * from "../../semantic/src/macros.sev" as macros
import * from "lexical.sev"

def read_source(path: string) -> source.SourceFile | diagnostics.Diagnostic:
    # Normalize IO failures before entering a Diagnostic-only result. Passing
    # the IOError payload through that result gives render the wrong layout.
    result ?= source.load(path)
    if result is SourceFile:
        return result
    if result is IOError:
        return error(diagnostics.diagnostic("E000120", result.message))
    return error(diagnostics.diagnostic("E000120", "could not read source file: " + path))

def package_dependency(resolution: package.Resolution, importer: string, alias: string) -> string | diagnostics.Diagnostic:
    result ?= package.dependency_source(resolution, importer, alias)
    if result is string:
        return result
    if result is Error:
        return error(diagnostics.diagnostic("E000124", result.message))
    return error(diagnostics.diagnostic("E000124", "package dependency lookup failed"))

def package_module(resolution: package.Resolution, importer: string, locator: string) -> string | diagnostics.Diagnostic:
    result ?= package.module_source(resolution, importer, locator)
    if result is string:
        return result
    if result is Error:
        return error(diagnostics.diagnostic("E000124", result.message))
    return error(diagnostics.diagnostic("E000124", "package source lookup failed"))


# Standalone files resolve standard-library imports from the selected sysroot.
# Package builds continue to use their explicit dependency graph.
def standard_source(root: string, name: string, importer: string) -> string | diagnostics.Diagnostic:
    if root == "":
        return error(diagnostics.diagnostic("E000124", "named import requires a sysroot or resolved package: " + name))
    selected ?= package.standalone_dependency(root + "/library", importer, name)
    if selected is string:
        return selected
    if selected is Error:
        return error(diagnostics.diagnostic("E000124", selected.message))
    return error(diagnostics.diagnostic("E000124", "unknown standard library: " + name))


def dependency_source(resolution: package.Resolution, importer: string, name: string, sysroot: string) -> string | diagnostics.Diagnostic:
    if len(resolution.packages) > 0:
        return package_dependency(resolution, importer, name)
    return standard_source(sysroot, name, importer)


def normalized_path(path: string) -> string:
    components: list[string] = []
    for component in path.split("/"):
        if component == "..":
            if len(components) == 0:
                if path.starts_with("/"):
                    throw Error("module path escapes its root")
                components.append("..")
            elif components[-1] == "..":
                components.append("..")
            else:
                components.pop()
        elif component != "" and component != ".":
            components.append(component)
    prefix = "/" if path.starts_with("/") else ""
    return prefix + components.join("/")


def parent_path(path: string) -> string:
    components = path.split("/")
    if len(components) == 1:
        return "."
    if len(components) == 2 and components[0] == "":
        return "/"
    return components[:int(len(components)) - 1].join("/")


def registered_source(input: source.SourceFile, files: list[source.SourceFile]) -> source.SourceFile:
    path = normalized_path(input.path)
    for file in files:
        if file.path == path:
            return file
    # SourceFile already owns decoded characters. Register the same snapshot;
    # changing its identity must not decode the entire file a second time.
    registered := input
    registered.id = source.SourceId(u32(len(files)))
    registered.path = path
    files.append(registered)
    return registered


def read_known_source(path: string, files: list[source.SourceFile]) -> source.SourceFile | diagnostics.Diagnostic:
    normalized = normalized_path(path)
    for file in files:
        if file.path == normalized:
            return file
    return read_source(normalized)


def discover_source_syntax(input: source.SourceFile, active: list[string], files: list[source.SourceFile], registry: lexer.SyntaxRegistry, resolution: package.Resolution = package.Resolution([], [], ""), sysroot: string = "") -> unit | diagnostics.Diagnostic:
    file = registered_source(input, files)
    if file.path in active:
        return error(diagnostics.diagnostic("E000120", "cyclic source import: " + file.path))
    if file.path in registry.discovered:
        return
    if len(active) >= 64:
        return error(diagnostics.diagnostic("E000120", "source import depth exceeds 64 modules"))
    stack = active[:]
    stack.append(file.path)
    tokens = lexer.scan_bootstrap(file)
    depth := 0
    index := 0
    for token in tokens:
        if token.kind == lexer.TokenKind.Indent:
            depth += 1
        elif token.kind == lexer.TokenKind.Dedent:
            depth -= 1
        if depth == 0 and lexer.token_word(token) == "from" and index + 2 < len(tokens) and lexer.token_word(tokens[index + 2]) == "import":
            child = dependency_source(resolution, file.path, lexer.token_word(tokens[index + 1]), sysroot)
            discover_source_syntax(read_known_source(child, files), stack, files, registry, resolution, sysroot)
        from_import = index >= 2 and lexer.token_word(tokens[index - 2]) == "from"
        if depth == 0 and lexer.token_word(token) == "import" and not from_import and index + 1 < len(tokens):
            subject := index + 1
            if lexer.token_is_symbol(tokens[subject], "*"):
                if subject + 2 >= len(tokens) or lexer.token_word(tokens[subject + 1]) != "from":
                    return error(diagnostics.diagnostic("E000120", "expected `from` after `import *`"))
                subject += 2
                match tokens[subject].kind:
                    case String:
                        pass
                    case _:
                        return error(diagnostics.diagnostic("E000120", "expected a locator string after `import * from`"))
            elif tokens[subject].kind == lexer.TokenKind.String:
                return error(diagnostics.diagnostic("E000120", "file imports require explicit `import * from` followed by a locator string"))
            match tokens[subject].kind:
                case String:
                    child := normalized_path(parent_path(file.path) + "/" + string(tokens[subject]))
                    if len(resolution.packages) > 0:
                        child = package_module(resolution, file.path, string(tokens[subject]))
                    discover_source_syntax(read_known_source(child, files), stack, files, registry, resolution, sysroot)
                case _:
                    name := lexer.token_word(tokens[subject])
                    # `import member from package` chooses the source package.
                    if subject + 2 < len(tokens) and lexer.token_word(tokens[subject + 1]) == "from":
                        name = lexer.token_word(tokens[subject + 2])
                    child = dependency_source(resolution, file.path, name, sysroot)
                    discover_source_syntax(read_known_source(child, files), stack, files, registry, resolution, sysroot)
        index += 1
    lexer.discover_operator_descriptors(tokens, registry)
    registry.discovered.append(file.path)


def load_source_module(input: source.SourceFile, prefix: string, active: list[string], root: bool, files: list[source.SourceFile], registry: lexer.SyntaxRegistry, resolution: package.Resolution = package.Resolution([], [], ""), sysroot: string = "") -> universal.Module | diagnostics.Diagnostic:
    path = normalized_path(input.path)
    if path in active:
        return error(diagnostics.diagnostic("E000120", "cyclic source import: " + path))
    if len(active) >= 64:
        return error(diagnostics.diagnostic("E000120", "source import depth exceeds 64 modules"))
    stack = active[:]
    stack.append(path)
    discover_source_syntax(input, [], files, registry, resolution, sysroot)
    lexer.resolve_operator_descriptors(registry)
    discover_lexical_rules(files, registry)
    registered = registered_source(input, files)
    parsed = macros.parse_module(lexer.scan_registered(lexical_source(registered, registry, false), registry))
    result = universal.empty_module()
    aliases: list[string] = []
    named_modules: list[string] = []
    for item in parsed.items:
        match item:
            case Import:
                match declaration.subject:
                    case Locator:
                        if locator.starts_with("/"):
                            return error(diagnostics.diagnostic("E000120", "bootstrap imports require a relative source locator"))
                        if declaration.source_name != None:
                            return error(diagnostics.diagnostic("E000120", "selective imports are not supported by bootstrap source loading"))
                        alias ?= declaration.alias
                        child_prefix := prefix
                        if alias != None:
                            if alias in aliases:
                                return error(diagnostics.diagnostic("E000120", "duplicate import alias: " + alias))
                            aliases.append(alias)
                            child_prefix += alias + "."
                        child_path := normalized_path(parent_path(path) + "/" + locator)
                        if len(resolution.packages) > 0:
                            child_path = package_module(resolution, path, locator)
                        child = load_source_module(read_known_source(child_path, files), child_prefix, stack, false, files, registry, resolution, sysroot)
                        for child_item in child.items:
                            append_imported_item(result, child_item)
                    case Name:
                        source_name ?= declaration.source_name
                        package_name := name
                        if source_name != None:
                            package_name = source_name
                        child_path = dependency_source(resolution, path, package_name, sysroot)
                        alias ?= declaration.alias
                        imported_name := name
                        if alias != None:
                            imported_name = alias
                        child_prefix := prefix + package_name + "."
                        if alias != None and source_name == None:
                            child_prefix = prefix + imported_name + "."
                        child = load_source_module(read_known_source(child_path, files), child_prefix, stack, false, files, registry, resolution, sysroot)
                        selected := source_name == None
                        module_key = child_path + ":" + child_prefix
                        for child_item in child.items:
                            if module_key not in named_modules:
                                append_imported_item(result, child_item)
                            if source_name != None:
                                match child_item:
                                    case Function:
                                        if declaration.name == child_prefix + name:
                                            # An alias needs fresh lowering metadata. Sharing
                                            # the values list appends both functions' ABI
                                            # parameters to the same declaration.
                                            imported = universal.FunctionDeclaration(name=prefix + imported_name, decorators=declaration.decorators[:], type_parameters=declaration.type_parameters[:], constraints=declaration.constraints[:], parameters=declaration.parameters[:], result=declaration.result, body=declaration.body, span=declaration.span, lookup=declaration.lookup, result_mode=declaration.result_mode, type_defaults=declaration.type_defaults[:])
                                            result.items.append(universal.Function(imported))
                                            selected = true
                                    case Record:
                                        imported_record: universal.RecordDeclaration = declaration
                                        if imported_record.name == child_prefix + name:
                                            if len(imported_record.type_parameters) == 0:
                                                target = universal.named_type(imported_record.name, [], imported_record.span)
                                                result.items.append(universal.Type(universal.TypeDeclaration([], prefix + imported_name, [], [], target, imported_record.span, lookup=imported_record.lookup)))
                                            else:
                                                imported_record.name = prefix + imported_name
                                                result.items.append(universal.Record(imported_record))
                                            selected = true
                                    case Trait:
                                        imported_trait: universal.TraitDeclaration = declaration
                                        if imported_trait.name == child_prefix + name:
                                            imported_trait.name = prefix + imported_name
                                            result.items.append(universal.Trait(imported_trait))
                                            selected = true
                                    case Type:
                                        imported_type: universal.TypeDeclaration = declaration
                                        if imported_type.name == child_prefix + name:
                                            imported_type.name = prefix + imported_name
                                            result.items.append(universal.Type(imported_type))
                                            selected = true
                                    case BindingItem:
                                        if binding.name == child_prefix + name:
                                            imported := binding
                                            imported.name = prefix + imported_name
                                            result.items.append(universal.BindingItem(imported))
                                            selected = true
                                    case _:
                                        pass
                        if not selected:
                            return error(diagnostics.diagnostic("E000124", "missing or unsupported imported declaration: " + name))
                        named_modules.append(module_key)
                    case _:
                        return error(diagnostics.diagnostic("E000120", "bootstrap imports require a relative source locator"))
            case Trait:
                trait_declaration := declaration
                trait_declaration.source_name = declaration.name
                trait_declaration.name = prefix + declaration.name
                trait_declaration.lookup = prefix
                result.items.append(universal.Trait(trait_declaration))
            case Type:
                type_declaration := declaration
                type_declaration.name = prefix + declaration.name
                type_declaration.lookup = prefix
                result.items.append(universal.Type(type_declaration))
            case Record:
                record_declaration := declaration
                record_declaration.source_name = declaration.name
                record_declaration.name = declaration.name if declaration.extension else prefix + declaration.name
                record_declaration.lookup = prefix
                result.items.append(universal.Record(record_declaration))
            case Function:
                function := declaration
                function.name = prefix + declaration.name
                function.lookup = prefix
                result.items.append(universal.Function(function))
            case Test:
                if root:
                    test_declaration := declaration
                    test_declaration.lookup = prefix
                    result.items.append(universal.Test(test_declaration))
            case BindingItem:
                if not root:
                    if binding.mutable or binding.update:
                        return error(diagnostics.diagnostic("E000120", "imported globals must be immutable literals"))
                    match binding.value.kind:
                        case LiteralValue:
                            constant := binding
                            constant.name = prefix + binding.name
                            result.items.append(universal.BindingItem(constant))
                        case _:
                            return error(diagnostics.diagnostic("E000120", "imported globals must be immutable literals"))
                else:
                    result.items.append(item)
            case ExpressionItem:
                # Standalone string literals document modules. Their contents
                # are data, including examples that are not declarations.
                match expression.kind:
                    case LiteralValue:
                        match value:
                            case StringValue:
                                continue
                            case _:
                                pass
                    case _:
                        pass
                if not root:
                    return error(diagnostics.diagnostic("E000120", "imported modules cannot execute module initializers"))
                result.items.append(item)
            case _:
                result.items.append(item)
    return result


# Diamond imports share declarations; distinct source declarations still reach
# semantic duplicate checking, even if their visible names are identical.
def imported_item_key(item: universal.Item) -> string:
    match item:
        case Record:
            return "record:" + declaration.name + ":" + string(declaration.span.source.index) + ":" + string(declaration.span.start)
        case Trait:
            return "trait:" + declaration.name + ":" + string(declaration.span.source.index) + ":" + string(declaration.span.start)
        case Type:
            return "type:" + declaration.name + ":" + string(declaration.span.source.index) + ":" + string(declaration.span.start)
        case Function:
            span ?= declaration.span
            if span != None:
                return "function:" + declaration.name + ":" + string(span.source.index) + ":" + string(span.start)
            return ""
        case BindingItem:
            return "binding:" + binding.name + ":" + string(binding.span.source.index) + ":" + string(binding.span.start)
        case _:
            return ""


def append_imported_item(module: universal.Module, item: universal.Item):
    key = imported_item_key(item)
    if key != "":
        for previous in module.items:
            if imported_item_key(previous) == key:
                return
    module.items.append(item)
