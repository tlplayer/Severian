import lexer
import diagnostics
import source
import universal
import "../../semantic/src/macros.sev" as macros


def normalized_path(path: string) -> string:
    components: list[string] = []
    for component in path.split("/"):
        if component == "..":
            if len(components) == 0:
                if path.starts_with("/"):
                    throw Error("module path escapes its root")
                components.append("..")
            elif components[-1] == "..":
                components.append("..")
            else:
                components.pop()
        elif component != "" and component != ".":
            components.append(component)
    prefix = "/" if path.starts_with("/") else ""
    return prefix + components.join("/")


def parent_path(path: string) -> string:
    components = path.split("/")
    if len(components) == 1:
        return "."
    if len(components) == 2 and components[0] == "":
        return "/"
    return components[:int(len(components)) - 1].join("/")


def registered_source(input: source.SourceFile, files: list[source.SourceFile]) -> source.SourceFile:
    path = normalized_path(input.path)
    for file in files:
        if file.path == path:
            return file
    registered = source.SourceFile(source.SourceId(u32(len(files))), path, input.text)
    files.append(registered)
    return registered


def discover_source_syntax(input: source.SourceFile, active: list[string], files: list[source.SourceFile], registry: lexer.SyntaxRegistry) -> unit | diagnostics.Diagnostic:
    file = registered_source(input, files)
    if file.path in active:
        return error(diagnostics.diagnostic("E000120", "cyclic source import: " + file.path))
    if file.path in registry.discovered:
        return
    if len(active) >= 64:
        return error(diagnostics.diagnostic("E000120", "source import depth exceeds 64 modules"))
    stack = active[:]
    stack.append(file.path)
    tokens = lexer.scan_bootstrap(file)
    depth := 0
    index := 0
    for token in tokens:
        if token.kind == lexer.TokenKind.Indent:
            depth += 1
        elif token.kind == lexer.TokenKind.Dedent:
            depth -= 1
        if depth == 0 and lexer.token_word(token) == "import" and index + 1 < len(tokens):
            match tokens[index + 1].kind:
                case String:
                    child = normalized_path(parent_path(file.path) + "/" + value)
                    discover_source_syntax(source.load(child), stack, files, registry)
                case _:
                    pass
        index += 1
    lexer.discover_operator_descriptors(tokens, registry)
    registry.discovered.append(file.path)


def load_source_module(input: source.SourceFile, prefix: string, active: list[string], root: bool, files: list[source.SourceFile], registry: lexer.SyntaxRegistry) -> universal.Module | diagnostics.Diagnostic:
    path = normalized_path(input.path)
    if path in active:
        return error(diagnostics.diagnostic("E000120", "cyclic source import: " + path))
    if len(active) >= 64:
        return error(diagnostics.diagnostic("E000120", "source import depth exceeds 64 modules"))
    stack = active[:]
    stack.append(path)
    discover_source_syntax(input, [], files, registry)
    lexer.resolve_operator_descriptors(registry)
    registered = registered_source(input, files)
    parsed = macros.parse_module(lexer.scan_registered(registered, registry))
    result = universal.empty_module()
    aliases: list[string] = []
    for item in parsed.items:
        match item:
            case Import:
                match declaration.subject:
                    case Locator:
                        if locator.starts_with("/"):
                            return error(diagnostics.diagnostic("E000120", "bootstrap imports require a relative source locator"))
                        if declaration.source_name != None:
                            return error(diagnostics.diagnostic("E000120", "selective imports are not supported by bootstrap source loading"))
                        alias ?= declaration.alias
                        child_prefix := prefix
                        if alias != None:
                            if alias in aliases:
                                return error(diagnostics.diagnostic("E000120", "duplicate import alias: " + alias))
                            aliases.append(alias)
                            child_prefix += alias + "."
                        child_path = normalized_path(parent_path(path) + "/" + locator)
                        child = load_source_module(source.load(child_path), child_prefix, stack, false, files, registry)
                        for child_item in child.items:
                            result.items.append(child_item)
                    case _:
                        return error(diagnostics.diagnostic("E000120", "bootstrap imports require a relative source locator"))
            case Trait:
                trait_declaration := declaration
                trait_declaration.name = prefix + declaration.name
                trait_declaration.lookup = prefix
                result.items.append(universal.Trait(trait_declaration))
            case Type:
                type_declaration := declaration
                type_declaration.name = prefix + declaration.name
                type_declaration.lookup = prefix
                result.items.append(universal.Type(type_declaration))
            case Record:
                record_declaration := declaration
                record_declaration.name = declaration.name if declaration.extension else prefix + declaration.name
                record_declaration.lookup = prefix
                result.items.append(universal.Record(record_declaration))
            case Function:
                function := declaration
                function.name = prefix + declaration.name
                function.lookup = prefix
                result.items.append(universal.Function(function))
            case Test:
                if root:
                    test_declaration := declaration
                    test_declaration.lookup = prefix
                    result.items.append(universal.Test(test_declaration))
            case BindingItem:
                if not root:
                    if binding.mutable or binding.update:
                        return error(diagnostics.diagnostic("E000120", "imported globals must be immutable literals"))
                    match binding.value.kind:
                        case LiteralValue:
                            constant := binding
                            constant.name = prefix + binding.name
                            result.items.append(universal.BindingItem(constant))
                        case _:
                            return error(diagnostics.diagnostic("E000120", "imported globals must be immutable literals"))
                else:
                    result.items.append(item)
            case ExpressionItem:
                if not root:
                    return error(diagnostics.diagnostic("E000120", "imported modules cannot execute module initializers"))
                result.items.append(item)
            case _:
                result.items.append(item)
    return result
