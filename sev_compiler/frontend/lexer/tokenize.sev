import SourceFile, Span, virtual_source from "../source/source.sev"
import SourceWindow from "window.sev"
import TokenStream from "stream.sev"
import Token, TokenForm from "../../syntax/generic/token.sev"
import Lexeme from "../../syntax/generic/lexeme.sev"
import Diagnostic from "../../syntax/primitive/error/diagnostic.sev"
import LexicalDiagnostic from "diagnostic.sev"
import SentenceField from "../../syntax/sentence/sentence.sev"
import "../../syntax/recognition.sev" as syntax


def lexer(input: SourceFile) -> TokenStream | list[Diagnostic]:
    grammars = syntax.registry()
    tokens: list[Token] = []
    cursor: u32 = 0
    end = u32(len(input.characters))
    while cursor <= end:
        candidates: list[Token] = []
        longest := cursor
        for label, grammar in grammars:
            name = label.name if label is syntax.SyntaxDeclaration else "Y"
            forms = label.token_forms[:]
            if not grammar.token_form:
                if grammar.declaration != None:
                    for field in grammar.declaration.sequence:
                        match field:
                            case Literal:
                                forms.append(TokenForm(spelling, spelling))
                            case Capture:
                                continue
                else:
                    for field in grammar.sequence:
                        match field:
                            case Literal:
                                forms.append(TokenForm(spelling, spelling))
                            case Capture:
                                continue
            matches: list[Token] = []
            for form in forms:
                if form.boundary != (cursor == end):
                    continue
                if form.recognize != None:
                    stop = form.recognize(input, cursor)
                    if stop is Diagnostic:
                        return [stop]
                    if stop != None:
                        if stop < cursor or stop > end or (stop == cursor and not form.boundary):
                            return [LexicalDiagnostic("token form returned an invalid source range", Span(input.id, cursor, cursor), "lexer.tokens")]
                        span = Span(input.id, cursor, stop)
                        matches.append(Token(form.kind, Lexeme(input.text[cursor:stop], span), span, [name]))
                    continue
                if form.boundary:
                    span = Span(input.id, cursor, cursor)
                    matches.append(Token(form.kind, Lexeme("", span), span, [name]))
                    continue
                stop := end if form.spelling == None else cursor + u32(len(form.spelling))
                while stop > cursor and stop <= end:
                    span = Span(input.id, cursor, stop)
                    lexeme = Lexeme(input.text[cursor:stop], span)
                    if (form.spelling == None or lexeme.text == form.spelling) and (form.accepts == None or form.accepts(lexeme)):
                        matches.append(Token(form.kind, lexeme, span, [name]))
                        break
                    if form.spelling != None:
                        break
                    stop -= 1
            # Compiler-generated lexical declarations include quoted captures;
            # their delimiters and contents form one atomic token.
            if cursor < end and grammar.token_form and grammar.recognize != None:
                probe = SourceWindow(input, 0, end, cursor)
                matched = grammar.recognize(probe)
                if matched is Diagnostic:
                    return [matched]
                if probe.cursor != cursor:
                    return [LexicalDiagnostic("token recognition changed the source cursor", Span(input.id, cursor, cursor), "lexer.tokens")]
                if matched != None:
                    matches.append(Token(name, matched.lexeme, matched.lexeme.span, [name]))
            for token in matches:
                span = token.span
                if span.source_id != input.id or span.start != cursor or (span.end < cursor or (span.end == cursor and cursor != end)) or span.end > end or token.lexeme.text != input.text[cursor:span.end]:
                    return [LexicalDiagnostic("token form returned an invalid source range", Span(input.id, cursor, cursor), "lexer.tokens")]
                if span.end > longest:
                    candidates = [token]
                    longest = span.end
                elif span.end == longest:
                    candidates.append(token)
        if len(candidates) == 0:
            return [LexicalDiagnostic("no declared token form recognizes this source", Span(input.id, cursor, cursor + 1), "lexer.tokens")]
        selected = candidates[0]
        for candidate in candidates[1:]:
            for declaration in candidate.declarations:
                if declaration not in selected.declarations:
                    selected.declarations.append(declaration)
        if cursor == end:
            stream = TokenStream(input, tokens)
            stream.end.lexeme = selected.lexeme
            stream.end.token = selected
            return stream
        tokens.append(selected)
        cursor = longest
    return TokenStream(input, tokens)


test "lexer emits the equal symbol declared by syntax":

    source = virtual_source("equal.sev", "=")
    result = lexer(source)
    assert(result is TokenStream)
    assert(len(result.tokens) == 1)

    token = result.tokens[0]
    assert(token.kind == "EQUAL")
    assert(token.lexeme.text == "=")
    assert(token.span.source_id == source.id)
    assert(token.span.start == 0 and token.span.end == 1)
    assert(token.lexeme.span == token.span)
    assert(result.print() == "equal.sev:1:1  [0] EQUAL \"=\"\nequal.sev:1:2  [1,2) EOF \"\"\n")
    print(token.kind + " " + token.lexeme.text)
    print(result.print())


test "lexer emits every fixed symbol with its longest spelling":

    examples = [
        ("=", "EQUAL"),
        (":=", "COLON_EQUAL"),
        ("?=", "QUESTION_EQUAL"),
        ("==", "EQUALITY"),
        ("!=", "NOT_EQUAL"),
        ("<", "LESS"),
        ("<=", "LESS_EQUAL"),
        (">", "GREATER"),
        (">=", "GREATER_EQUAL"),
        ("+", "PLUS"),
        ("-", "MINUS"),
        ("*", "STAR"),
        ("/", "SLASH"),
        ("//", "FLOOR_DIVIDE"),
        ("%", "PERCENT"),
        ("**", "POWER"),
        ("+=", "PLUS_EQUAL"),
        ("-=", "MINUS_EQUAL"),
        ("*=", "STAR_EQUAL"),
        ("/=", "SLASH_EQUAL"),
        ("//=", "FLOOR_DIVIDE_EQUAL"),
        ("%=", "PERCENT_EQUAL"),
        ("&", "AMPERSAND"),
        ("|", "PIPE"),
        ("^", "CARET"),
        ("!", "BANG"),
        ("<<", "LEFT_SHIFT"),
        (">>", "RIGHT_SHIFT"),
        ("&=", "AMPERSAND_EQUAL"),
        ("|=", "PIPE_EQUAL"),
        ("^=", "CARET_EQUAL"),
        ("<<=", "LEFT_SHIFT_EQUAL"),
        (">>=", "RIGHT_SHIFT_EQUAL"),
        ("->", "ARROW"),
        ("~>", "APPROX_ARROW"),
        ("<=>", "CONVERSION"),
        ("(", "LEFT_PAREN"),
        (")", "RIGHT_PAREN"),
        ("[", "LEFT_BRACKET"),
        ("]", "RIGHT_BRACKET"),
        ("{", "LEFT_BRACE"),
        ("}", "RIGHT_BRACE"),
        (":", "COLON"),
        (",", "COMMA"),
        (".", "DOT"),
        ("..", "RANGE"),
        ("...", "ELLIPSIS"),
        ("@", "AT"),
    ]
    for spelling, kind in examples:
        source = virtual_source("symbols.sev", spelling)
        result = lexer(source)
        assert(result is TokenStream)
        assert(len(result.tokens) == 1)
        token = result.tokens[0]
        assert(token.kind == kind)
        assert(token.lexeme.text == spelling)
        assert(token.span.source_id == source.id)
        assert(token.span.start == 0 and token.span.end == len(spelling))
        assert(result.end.token.kind == "EOF")
        assert(result.end.token.span.start == len(spelling))
        assert(result.end.token.span.end == len(spelling))
        print(token.kind + " " + token.lexeme.text)


test "quoted and structural forms retain their complete source":

    examples = [
        ("\"a # += λ\"", "STRING"),
        ("\"a\\\"b\"", "STRING"),
        ("'λ'", "CHARACTER"),
        ("'\\n'", "CHARACTER"),
        ("\"\"\"a\nb\"\"\"", "BLOCK_STRING"),
        ("'''a\nb'''", "BLOCK_STRING"),
        ("f\"{value}\"", "FORMATTED_STRING"),
        ("f\"{\"inner\"}\"", "FORMATTED_STRING"),
        ("f\"\"\"a\n{value}\"\"\"", "FORMATTED_BLOCK_STRING"),
        ("# += \"still a comment\"", "COMMENT"),
        (" \t ", "INDENT"),
        ("\n", "NEWLINE"),
        ("\r\n", "NEWLINE"),
        ("\r", "NEWLINE"),
    ]
    for spelling, kind in examples:
        source = virtual_source("forms.sev", spelling)
        result = lexer(source)
        assert(result is TokenStream)
        assert(len(result.tokens) == 1)
        assert(result.tokens[0].kind == kind)
        assert(result.tokens[0].lexeme.text == spelling)
        assert(result.tokens[0].span.source_id == source.id)
        assert(result.tokens[0].span.start == 0)
        assert(result.tokens[0].span.end == len(spelling))
        print(kind + " " + result.print())


test "spacing does not merge symbols and comments end at the newline":

    result = lexer(virtual_source("spacing.sev", "  > =\t# comment\r\n\t+=..."))
    assert(result is TokenStream)
    expected = ["INDENT", "GREATER", "SPACE", "EQUAL", "SPACE", "COMMENT", "NEWLINE", "INDENT", "PLUS_EQUAL", "ELLIPSIS"]
    assert(len(result.tokens) == len(expected))
    for index, kind in enumerate(expected):
        assert(result.tokens[index].kind == kind)
    assert(result.tokens[0].lexeme.text == "  ")
    assert(result.tokens[6].lexeme.text == "\r\n")


test "adjacent quoted literals stop at their own closing delimiter":

    result = lexer(virtual_source("adjacent.sev", "\"a\"\"b\""))
    assert(result is TokenStream)
    assert(len(result.tokens) == 2)
    assert(result.tokens[0].lexeme.text == "\"a\"")
    assert(result.tokens[1].lexeme.text == "\"b\"")


test "unterminated literals and invalid character widths report diagnostics":

    for spelling in ["\"open", "'open", "\"\"\"open", "'''open", "f\"open", "f\"\"\"open", "''", "'ab'", "\"line\nbreak\""]:
        assert(lexer(virtual_source("invalid.sev", spelling)) is list[Diagnostic])


test "empty input has one classified end boundary":

    source = virtual_source("empty.sev", "")
    result = lexer(source)
    assert(result is TokenStream)
    assert(len(result.tokens) == 0)
    assert(result.end.token.kind == "EOF")
    assert(result.end.lexeme.text == "")
    assert(result.end.token.span.source_id == source.id)
    assert(result.end.token.span.start == 0 and result.end.token.span.end == 0)
    assert(result.print() == "empty.sev:1:1  [0,1) EOF \"\"\n")
    print(result.print())
