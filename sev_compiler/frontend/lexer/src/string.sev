import diagnostics
import "token/mod.sev"
import "lexeme.sev"
import "indentation.sev"
import "../../../universal/primitive/char/encoding.sev" as utf8


def literal_escape(value: string) -> string | None:
    if value == "n":
        return "\n"
    if value == "r":
        return "\r"
    if value == "t":
        return "\t"
    if value == "\\" or value == "\"" or value == "'":
        return value
    return None


def literal_codepoint(value: string) -> u32:
    bytes = value.bytes()
    if len(bytes) == 1:
        return u32(bytes[0])
    if len(bytes) == 2:
        return u32(utf8.decode_two(int(bytes[0]), int(bytes[1])))
    if len(bytes) == 3:
        return u32(utf8.decode_three(int(bytes[0]), int(bytes[1]), int(bytes[2])))
    return u32(utf8.decode_four(int(bytes[0]), int(bytes[1]), int(bytes[2]), int(bytes[3])))

def block_string(raw: string) -> string:
    content := raw
    if content.starts_with("\n"):
        content = content[1:]
    lines = content.split("\n")
    common := -1
    for line in lines:
        if contains_non_whitespace(line):
            width = indentation_width(line)
            if common < 0 or width < common:
                common = width
    if common < 0:
        common = 0
    result: list[string] = []
    for line in lines:
        result.append(strip_indentation(line, common))
    return result.join("\n")


class StringLexeme: Lexeme
    def scan(input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
        characters = input.characters
        character = characters[start]
        cursor := start
        formatted = character == "f" and cursor + 1 < len(characters) and characters[cursor + 1] == "\""
        if character == "\"" or character == "'" or formatted:
            if formatted:
                cursor += 1
            quote = characters[cursor]
            block = quote == "\"" and cursor + 2 < len(characters) and characters[cursor + 1] == "\"" and characters[cursor + 2] == "\""
            cursor += 3 if block else 1
            content_start = cursor
            value := ""
            if block:
                while cursor + 2 < len(characters) and not (characters[cursor] == "\"" and characters[cursor + 1] == "\"" and characters[cursor + 2] == "\""):
                    cursor += 1
                if cursor + 2 >= len(characters):
                    return error(diagnostics.Diagnostic("E000101", "unterminated block string literal", lexeme_span(input, start, cursor)))
                value = block_string(characters[content_start:cursor].join(""))
                cursor += 3
            else:
                while cursor < len(characters) and characters[cursor] != quote:
                    if characters[cursor] == "\n":
                        return error(diagnostics.Diagnostic("E000101", "unterminated string literal", lexeme_span(input, start, cursor)))
                    if characters[cursor] == "\\":
                        cursor += 1
                        if cursor >= len(characters):
                            return error(diagnostics.Diagnostic("E000101", "unterminated escape", lexeme_span(input, start, cursor)))
                        escaped ?= literal_escape(characters[cursor])
                        if escaped != None:
                            value += escaped
                        else:
                            return error(diagnostics.Diagnostic("E000101", "unsupported literal escape", lexeme_span(input, start, cursor + 1)))
                    else:
                        value += characters[cursor]
                    cursor += 1
                if cursor >= len(characters):
                    return error(diagnostics.Diagnostic("E000101", "unterminated string literal", lexeme_span(input, start, cursor)))
                cursor += 1
            if quote == "'":
                if len(value.characters()) != 1:
                    return error(diagnostics.Diagnostic("E000101", "character literal requires one Unicode scalar", lexeme_span(input, start, cursor)))
                return LexemeMatch(cursor, TokenKind.Character(literal_codepoint(value)))
            elif formatted:
                kind: TokenKind = TokenKind.FormattedString(value)
                return LexemeMatch(cursor, kind)
            else:
                kind: TokenKind = TokenKind.String(value)
                return LexemeMatch(cursor, kind)
        return LexemeMatch(start, None, false)

