import source
import diagnostics
import "../token/mod.sev"
import "../../../../universal/primitive/char/encoding.sev" as utf8


def literal_escape(value: string) -> string | None:
    if value == "n":
        return "\n"
    if value == "r":
        return "\r"
    if value == "t":
        return "\t"
    if value == "\\" or value == "\"" or value == "'":
        return value
    return None


def literal_codepoint(value: string) -> u32:
    bytes = value.bytes()
    if len(bytes) == 1:
        return u32(bytes[0])
    if len(bytes) == 2:
        return u32(utf8.decode_two(int(bytes[0]), int(bytes[1])))
    if len(bytes) == 3:
        return u32(utf8.decode_three(int(bytes[0]), int(bytes[1]), int(bytes[2])))
    return u32(utf8.decode_four(int(bytes[0]), int(bytes[1]), int(bytes[2]), int(bytes[3])))

def make_token(file: source.SourceFile, kind: TokenKind, start: int, end: int) -> Token:
    return Token(kind, source.Span(file.id, u32(start), u32(end)))


def indentation_width(line: string) -> int:
    width := 0
    for character in line.characters():
        if character == " ":
            width += 1
        elif character == "\t":
            width += 4
        else:
            break
    return width


def strip_indentation(line: string, width: int) -> string:
    consumed := 0
    offset := 0
    characters = line.characters()
    while offset < len(characters) and consumed < width:
        if characters[offset] == " ":
            consumed += 1
        elif characters[offset] == "\t":
            consumed += 4
        else:
            break
        offset += 1
    return characters[offset:].join("")


def contains_non_whitespace(line: string) -> bool:
    for character in line.characters():
        if character != " " and character != "\t" and character != "\r":
            return true
    return false


def is_digit(character: string) -> bool:
    return character >= "0" and character <= "9"


def is_alphabetic(character: string) -> bool:
    return (character >= "a" and character <= "z") or (character >= "A" and character <= "Z")


def is_alphanumeric(character: string) -> bool:
    return is_alphabetic(character) or is_digit(character)


def block_string(raw: string) -> string:
    content := raw
    if content.starts_with("\n"):
        content = content[1:]
    lines = content.split("\n")
    common := -1
    for line in lines:
        if contains_non_whitespace(line):
            width = indentation_width(line)
            if common < 0 or width < common:
                common = width
    if common < 0:
        common = 0
    result: list[string] = []
    for line in lines:
        result.append(strip_indentation(line, common))
    return result.join("\n")


def punctuation(character: string, following: string | None) -> tuple[TokenKind, int] | None:
    if character == "@":
        return (TokenKind.At, 1)
    if character == ",":
        return (TokenKind.Comma, 1)
    if character == ".":
        return (TokenKind.Dot, 1)
    if character == "(":
        return (TokenKind.LeftParen, 1)
    if character == ")":
        return (TokenKind.RightParen, 1)
    if character == "[":
        return (TokenKind.LeftBracket, 1)
    if character == "]":
        return (TokenKind.RightBracket, 1)
    if character == "{":
        return (TokenKind.LeftBrace, 1)
    if character == "}":
        return (TokenKind.RightBrace, 1)
    if character == "|":
        return (TokenKind.Pipe, 1)
    if character == ":" and following == "=":
        return (TokenKind.ColonEqual, 2)
    if character == ":":
        return (TokenKind.Colon, 1)
    if character == "?" and following == "=":
        return (TokenKind.QuestionEqual, 2)
    if character == "+" and following == "=":
        return (TokenKind.PlusEqual, 2)
    if character == "+":
        return (TokenKind.Plus, 1)
    if character == "-" and following == ">":
        return (TokenKind.Arrow, 2)
    if character == "-" and following == "=":
        return (TokenKind.MinusEqual, 2)
    if character == "-":
        return (TokenKind.Minus, 1)
    if character == "*" and following == "*":
        return (TokenKind.Power, 2)
    if character == "*" and following == "=":
        return (TokenKind.StarEqual, 2)
    if character == "*":
        return (TokenKind.Star, 1)
    if character == "/" and following == "=":
        return (TokenKind.SlashEqual, 2)
    if character == "/":
        return (TokenKind.Slash, 1)
    if character == "%" and following == "=":
        return (TokenKind.PercentEqual, 2)
    if character == "%":
        return (TokenKind.Percent, 1)
    if character == "=" and following == "=":
        return (TokenKind.EqualEqual, 2)
    if character == "=":
        return (TokenKind.Equal, 1)
    if character == "!" and following == "=":
        return (TokenKind.NotEqual, 2)
    if character == "<" and following == "=":
        return (TokenKind.LessEqual, 2)
    if character == "<":
        return (TokenKind.Less, 1)
    if character == ">" and following == "=":
        return (TokenKind.GreaterEqual, 2)
    if character == ">":
        return (TokenKind.Greater, 1)
    return None


def scan(file: source.SourceFile) -> list[Token] | diagnostics.Diagnostic:
    characters = file.text.characters()
    cursor := 0
    line_start := true
    indents: list[int] = [0]
    tokens: list[Token] = []

    while cursor < len(characters):
        if line_start:
            start = cursor
            while cursor < len(characters) and (characters[cursor] == " " or characters[cursor] == "\t"):
                cursor += 1
            if cursor >= len(characters):
                break
            if characters[cursor] == "\n" or characters[cursor] == "#":
                while cursor < len(characters) and characters[cursor] != "\n":
                    cursor += 1
                if cursor < len(characters):
                    tokens.append(make_token(file, TokenKind.Newline, cursor, cursor + 1))
                    cursor += 1
                continue
            width = indentation_width(characters[start:cursor].join(""))
            if width > indents[-1]:
                indents.append(width)
                tokens.append(make_token(file, TokenKind.Indent, start, cursor))
            elif width < indents[-1]:
                while width < indents[-1]:
                    indents.pop()
                    tokens.append(make_token(file, TokenKind.Dedent, start, cursor))
                if width != indents[-1]:
                    return error(diagnostics.Diagnostic("E000102", "inconsistent indentation", source.Span(file.id, u32(start), u32(cursor))))
            line_start = false

        start = cursor
        character = characters[cursor]
        if character == " " or character == "\t" or character == "\r":
            cursor += 1
            continue
        if character == "\n" or character == ";":
            tokens.append(make_token(file, TokenKind.Newline, cursor, cursor + 1))
            cursor += 1
            line_start = character == "\n"
            continue
        if character == "#":
            while cursor < len(characters) and characters[cursor] != "\n":
                cursor += 1
            continue

        following: string | None := None
        if cursor + 1 < len(characters):
            following = characters[cursor + 1]
        symbol = punctuation(character, following)
        if symbol != None:
            tokens.append(make_token(file, symbol[0], start, start + symbol[1]))
            cursor += symbol[1]
            continue

        formatted = character == "f" and cursor + 1 < len(characters) and characters[cursor + 1] == "\""
        if character == "\"" or character == "'" or formatted:
            if formatted:
                cursor += 1
            quote = characters[cursor]
            block = quote == "\"" and cursor + 2 < len(characters) and characters[cursor + 1] == "\"" and characters[cursor + 2] == "\""
            cursor += 3 if block else 1
            content_start = cursor
            value := ""
            if block:
                while cursor + 2 < len(characters) and not (characters[cursor] == "\"" and characters[cursor + 1] == "\"" and characters[cursor + 2] == "\""):
                    cursor += 1
                if cursor + 2 >= len(characters):
                    return error(diagnostics.Diagnostic("E000101", "unterminated block string literal", source.Span(file.id, u32(start), u32(cursor))))
                value = block_string(characters[content_start:cursor].join(""))
                cursor += 3
            else:
                while cursor < len(characters) and characters[cursor] != quote:
                    if characters[cursor] == "\n":
                        return error(diagnostics.Diagnostic("E000101", "unterminated string literal", source.Span(file.id, u32(start), u32(cursor))))
                    if characters[cursor] == "\\":
                        cursor += 1
                        if cursor >= len(characters):
                            return error(diagnostics.Diagnostic("E000101", "unterminated escape", source.Span(file.id, u32(start), u32(cursor))))
                        escaped ?= literal_escape(characters[cursor])
                        if escaped != None:
                            value += escaped
                        else:
                            return error(diagnostics.Diagnostic("E000101", "unsupported literal escape", source.Span(file.id, u32(start), u32(cursor + 1))))
                    else:
                        value += characters[cursor]
                    cursor += 1
                if cursor >= len(characters):
                    return error(diagnostics.Diagnostic("E000101", "unterminated string literal", source.Span(file.id, u32(start), u32(cursor))))
                cursor += 1
            if quote == "'":
                if len(value.characters()) != 1:
                    return error(diagnostics.Diagnostic("E000101", "character literal requires one Unicode scalar", source.Span(file.id, u32(start), u32(cursor))))
                tokens.append(make_token(file, TokenKind.Character(literal_codepoint(value)), start, cursor))
            elif formatted:
                kind: TokenKind = TokenKind.FormattedString(value)
                tokens.append(make_token(file, kind, start, cursor))
            else:
                kind: TokenKind = TokenKind.String(value)
                tokens.append(make_token(file, kind, start, cursor))
            continue

        if is_digit(character):
            cursor += 1
            while cursor < len(characters) and (is_digit(characters[cursor]) or characters[cursor] == "_"):
                cursor += 1
            floating = cursor + 1 < len(characters) and characters[cursor] == "." and is_digit(characters[cursor + 1])
            if floating:
                cursor += 1
                while cursor < len(characters) and (is_digit(characters[cursor]) or characters[cursor] == "_"):
                    cursor += 1
            spelling = characters[start:cursor].join("").replace("_", "")
            if floating:
                tokens.append(make_token(file, TokenKind.Float(spelling), start, cursor))
            else:
                tokens.append(make_token(file, TokenKind.Integer(spelling), start, cursor))
            continue

        if is_alphabetic(character) or character == "_":
            cursor += 1
            while cursor < len(characters) and (is_alphanumeric(characters[cursor]) or characters[cursor] == "_"):
                cursor += 1
            tokens.append(make_token(file, TokenKind.Identifier(characters[start:cursor].join("")), start, cursor))
            continue

        return error(diagnostics.Diagnostic("E000100", "unexpected character " + string(character), source.Span(file.id, u32(start), u32(start + 1))))

    while len(indents) > 1:
        indents.pop()
        tokens.append(make_token(file, TokenKind.Dedent, cursor, cursor))
    tokens.append(make_token(file, TokenKind.Eof, cursor, cursor))
    return tokens
