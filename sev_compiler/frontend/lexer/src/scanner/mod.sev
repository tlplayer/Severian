import source
import diagnostics
from diagnostics import Diagnostic
import universal
import * from "../token/mod.sev"
import * from "../lexer.sev"
import * from "../indentation.sev"
import * from "../syntax/mod.sev"


def make_token(input: LexemeInput, kind: TokenKind, start: int, end: int) -> Token:
    matched = Lexeme(input.characters[start:end].join(""), lexeme_span(input, start, end))
    return token_from_lexeme(kind, matched)


def scan_bootstrap(file: source.SourceFile) -> list[Token] | diagnostics.Diagnostic:
    return scan_with(file, StandardLexemes(lexical_symbols([])), [], true)


def scan_tokens(file: source.SourceFile, syntaxes: list[universal.OperatorSyntax], discovery: bool = false, rules: list[SourceLexicalRule] = []) -> list[Token] | diagnostics.Diagnostic:
    if discovery:
        return scan_bootstrap(file)
    tokens = scan_with(file, StandardLexemes(lexical_symbols(syntaxes), rules), syntaxes)
    declarations: list[universal.RecordDeclaration] = []
    for rule in rules:
        declaration ?= rule.declaration
        if declaration != None:
            declarations.append(declaration)
    index := 0
    for token in tokens:
        if token.kind == TokenKind.FormattedString:
            token.lexical_rules = declarations
            tokens[index] = token
        index += 1
    return tokens


def scan_with[Rule: LexicalRule](file: source.SourceFile, rule: Rule, syntaxes: list[universal.OperatorSyntax], discovery: bool = false) -> list[Token] | diagnostics.Diagnostic:
    input = lexeme_input(file)
    characters = input.characters
    cursor := 0
    line_start := true
    indents: list[int] = [0]
    tokens: list[Token] = []

    while cursor < len(characters):
        if line_start:
            start = cursor
            while cursor < len(characters) and (characters[cursor] == " " or characters[cursor] == "\t"):
                cursor += 1
            if cursor >= len(characters):
                break
            if characters[cursor] == "\n" or characters[cursor] == "#":
                while cursor < len(characters) and characters[cursor] != "\n":
                    cursor += 1
                if cursor < len(characters):
                    tokens.append(make_token(input, TokenKind.Newline, cursor, cursor + 1))
                    cursor += 1
                continue
            width = indentation_width(characters[start:cursor].join(""))
            if width > indents[-1]:
                indents.append(width)
                tokens.append(make_token(input, TokenKind.Indent, start, cursor))
            elif width < indents[-1]:
                while width < indents[-1]:
                    indents.pop()
                    tokens.append(make_token(input, TokenKind.Dedent, start, cursor))
                if width != indents[-1]:
                    return error(diagnostics.Diagnostic("E000102", "inconsistent indentation", lexeme_span(input, start, cursor)))
            line_start = false

        start = cursor
        character = characters[cursor]
        result := LexemeMatch(start, None, false)
        if discovery:
            # Source may contain a package-defined literal whose contents are
            # invalid in the bootstrap language. Validate it only after imports
            # have installed their rules; discovery still retains every span.
            candidate ?= lex(rule, input, start)
            if candidate is LexemeMatch:
                result = candidate
            else:
                result = LexemeMatch(start + 1, TokenKind.Symbol)
        else:
            result = lex(rule, input, start)
        if result.matched:
            cursor = result.end
            kind ?= result.kind
            if kind != None:
                metadata := symbol_syntaxes(syntaxes, characters[start:cursor].join(""))
                if kind == TokenKind.Symbol or kind == TokenKind.Identifier:
                    normalized ?= result.value
                    if normalized != None:
                        metadata = symbol_syntaxes(syntaxes, normalized)
                match kind:
                    case FormattedString:
                        metadata = syntaxes
                    case _:
                        pass
                token = make_token(input, kind, start, cursor)
                token.syntaxes = metadata
                token.value = result.value
                tokens.append(token)
                if kind == TokenKind.Newline:
                    line_start = character == "\n"
            continue

        if discovery:
            tokens.append(make_token(input, TokenKind.Symbol, start, start + 1))
            cursor += 1
            continue
        return error(diagnostics.Diagnostic("E000100", "unexpected character " + string(character), lexeme_span(input, start, start + 1)))

    while len(indents) > 1:
        indents.pop()
        tokens.append(make_token(input, TokenKind.Dedent, cursor, cursor))
    tokens.append(make_token(input, TokenKind.Eof, cursor, cursor))
    return tokens


def scan(file: source.SourceFile, operators: list[universal.OperatorSyntax] = []) -> list[Token] | diagnostics.Diagnostic:
    registry = SyntaxRegistry(operators[:])
    discover_operator_descriptors(scan_bootstrap(file), registry)
    resolve_operator_descriptors(registry)
    return scan_registered(file, registry)


def scan_registered(file: source.SourceFile, registry: SyntaxRegistry) -> list[Token] | diagnostics.Diagnostic:
    tokens = scan_tokens(file, registry.operators, rules=registry.rules)
    for descriptor in registry.descriptors:
        if descriptor.resolved and descriptor.span.source.index == file.id.index:
            index := 0
            for token in tokens:
                if token.span.start == descriptor.span.start:
                    token.descriptor = true
                    token.grammar = descriptor.grammar
                    syntax ?= descriptor.syntax
                    if descriptor.grammar:
                        if syntax != None:
                            token.syntaxes = [syntax]
                    tokens[index] = token
                index += 1
    return tokens


test "lexical classes preserve numeric forms and identifier boundaries":
    input = source.virtual_source("lexemes.sev", "12 12.5 .5 1_024 2e-3 foo_2 fuse_count")
    tokens = scan_tokens(input, [])
    assert(tokens[0].kind == TokenKind.Integer)
    assert(token_number(tokens[0]) == "12")
    assert(tokens[1].kind == TokenKind.Float)
    assert(token_number(tokens[1]) == "12.5")
    assert(tokens[2].kind == TokenKind.Float)
    assert(token_number(tokens[2]) == "0.5")
    assert(tokens[3].kind == TokenKind.Integer)
    assert(token_number(tokens[3]) == "1024")
    assert(tokens[4].kind == TokenKind.Float)
    assert(token_number(tokens[4]) == "2.0e-3")
    assert(tokens[5].kind == TokenKind.Identifier)
    assert(string(tokens[5]) == "foo_2")
    assert(tokens[6].kind == TokenKind.Identifier)
    assert(string(tokens[6]) == "fuse_count")
    assert(tokens[7].kind == TokenKind.Eof)


test "one symbol rule matches the longest registered spelling":
    operators = [universal.operator_syntax(universal.Add()),
        universal.OperatorSyntax("+=", universal.Fixity.Infix, 1, universal.Associativity.Left),
        universal.OperatorSyntax("+==", universal.Fixity.Infix, 1, universal.Associativity.Left),
        universal.OperatorSyntax("|>", universal.Fixity.Infix, 7, universal.Associativity.Left),
        universal.OperatorSyntax("fuse", universal.Fixity.Infix, 7, universal.Associativity.Left)]
    input = source.virtual_source("symbols.sev", "+== += + |> fuse fuse_count")
    tokens = scan_tokens(input, operators)
    assert(token_is_symbol(tokens[0], "+=="))
    assert(token_is_symbol(tokens[1], "+="))
    assert(token_is_symbol(tokens[2], "+"))
    assert(token_is_symbol(tokens[3], "|>"))
    assert(len(tokens[4].syntaxes) == 1)
    assert(len(tokens[5].syntaxes) == 0)
    assert(tokens[3].span.start == 9)
    assert(tokens[3].span.end == 11)


test "bootstrap discovery does not activate value symbols":
    input = source.virtual_source("bootstrap.sev", "|> +==")
    tokens = scan_bootstrap(input)
    assert(token_is_symbol(tokens[0], "|"))
    assert(token_is_symbol(tokens[1], ">"))
    assert(token_is_symbol(tokens[2], "+"))
    assert(token_is_symbol(tokens[3], "="))
    assert(token_is_symbol(tokens[4], "="))
    for token in tokens:
        assert(len(token.syntaxes) == 0)


test "strings characters and interpolation retain decoding and syntax":
    input = source.virtual_source("strings.sev", "\"hi\\n\" 'λ' f\"{1 + 2}\" \"\"\"\n    block\n    text\n\"\"\"")
    operators = [universal.operator_syntax(universal.Add())]
    tokens = scan_tokens(input, operators)
    assert(tokens[0].kind == TokenKind.String)
    assert(string(tokens[0]) == "hi\n")
    assert(tokens[1].kind == TokenKind.Character)
    assert(literal_codepoint(string(tokens[1])) == 955)
    assert(tokens[2].kind == TokenKind.FormattedString)
    assert(string(tokens[2]) == "{1 + 2}")
    assert(len(tokens[2].syntaxes) == 1)
    assert(tokens[3].kind == TokenKind.String)
    assert(string(tokens[3]) == "block\ntext\n")


test "comments blank lines and indentation share structural state":
    input = source.virtual_source("indent.sev", "root\n    # comment\n    first; second\n\nlast")
    tokens = scan_tokens(input, [])
    assert(tokens[0].kind == TokenKind.Identifier)
    assert(string(tokens[0]) == "root")
    assert(tokens[1].kind == TokenKind.Newline)
    assert(tokens[2].kind == TokenKind.Newline)
    assert(tokens[3].kind == TokenKind.Indent)
    assert(tokens[4].kind == TokenKind.Identifier)
    assert(string(tokens[4]) == "first")
    assert(tokens[5].kind == TokenKind.Newline)
    assert(tokens[6].kind == TokenKind.Identifier)
    assert(string(tokens[6]) == "second")
    assert(tokens[7].kind == TokenKind.Newline)
    assert(tokens[8].kind == TokenKind.Newline)
    assert(tokens[9].kind == TokenKind.Dedent)
    assert(tokens[10].kind == TokenKind.Identifier)
    assert(string(tokens[10]) == "last")
    assert(tokens[11].kind == TokenKind.Eof)


def expect_lexical_error(text: string, code: string):
    result ?= scan_tokens(source.virtual_source("invalid.sev", text), [])
    if result is Diagnostic:
        assert(result.code == code)
    else:
        assert(false)


test "committed literal prefixes preserve diagnostics":
    expect_lexical_error("1e+", "E000101")
    expect_lexical_error("\"unterminated", "E000101")
    expect_lexical_error("\"\\q\"", "E000101")
    expect_lexical_error("'ab'", "E000101")
    expect_lexical_error("a\n    b\n  c", "E000102")
    expect_lexical_error("$", "E000100")


test "tokens preserve matched spelling separately from classified payload":
    input = source.virtual_source("tokens.sev", "total += 1_024 .5 \"a\\n\"")
    operators = [universal.OperatorSyntax("+=", universal.Fixity.Infix, 1, universal.Associativity.Left)]
    tokens = scan_tokens(input, operators)
    assert(tokens[0].lexeme.text == "total")
    assert(tokens[0].kind == TokenKind.Identifier)
    assert(string(tokens[0]) == "total")
    assert(tokens[1].lexeme.text == "+=")
    assert(token_is_symbol(tokens[1], "+="))
    assert(tokens[2].lexeme.text == "1_024")
    assert(tokens[2].kind == TokenKind.Integer)
    assert(token_number(tokens[2]) == "1024")
    assert(tokens[3].lexeme.text == ".5")
    assert(tokens[3].kind == TokenKind.Float)
    assert(token_number(tokens[3]) == "0.5")
    assert(tokens[4].lexeme.text == "\"a\\n\"")
    assert(tokens[4].kind == TokenKind.String)
    assert(string(tokens[4]) == "a\n")
    for token in tokens:
        assert(token.lexeme.span.source.index == token.span.source.index)
        assert(token.lexeme.span.start == token.span.start)
        assert(token.lexeme.span.end == token.span.end)
        assert(token.lexeme.text == input.text.characters()[int(token.span.start):int(token.span.end)].join(""))
    assert(tokens[5].kind == TokenKind.Eof)
    assert(tokens[5].lexeme.text == "")
    assert(string(tokens[5]) == "")
    replacement = token_from_lexeme(TokenKind.Identifier, tokens[0].lexeme, "expanded")
    assert(string(replacement) == "expanded")
    assert(replacement.lexeme.text == "total")
    empty = token_from_lexeme(TokenKind.String, tokens[4].lexeme, "")
    assert(string(empty) == "")


test "structural tokens retain indentation and zero-width EOF origins":
    tokens = scan_tokens(source.virtual_source("structure.sev", "root\n  child"), [])
    assert(tokens[1].kind == TokenKind.Newline)
    assert(tokens[1].lexeme.text == "\n")
    assert(tokens[2].kind == TokenKind.Indent)
    assert(tokens[2].lexeme.text == "  ")
    assert(tokens[4].kind == TokenKind.Dedent)
    assert(tokens[4].lexeme.text == "")
    assert(tokens[4].span.start == tokens[4].span.end)
    assert(tokens[5].kind == TokenKind.Eof)
    assert(tokens[5].lexeme.text == "")


test "all bootstrap punctuation uses the open symbol category":
    spellings = ["@", ":", ":=", "?=", "=", "->", "(", ")", "[", "]", "{", "}", "|", ",", "."]
    tokens = scan_tokens(source.virtual_source("punctuation.sev", spellings.join(" ")), [])
    assert(len(tokens) == len(spellings) + 1)
    index := 0
    for spelling in spellings:
        assert(tokens[index].kind == TokenKind.Symbol)
        assert(string(tokens[index]) == spelling)
        assert(token_is_symbol(tokens[index], spelling))
        assert(tokens[index].value == None)
        index += 1


test "identifier and numeric tokens store only their source spelling":
    tokens = scan_tokens(source.virtual_source("spelling.sev", "count 1_024 .5 2e-3"), [])
    for token in tokens:
        assert(token.value == None)
    assert(string(tokens[0]) == "count")
    assert(string(tokens[1]) == "1_024")
    assert(string(tokens[2]) == ".5")
    assert(string(tokens[3]) == "2e-3")
    assert(token_number(tokens[1]) == "1024")
    assert(token_number(tokens[2]) == "0.5")
    assert(token_number(tokens[3]) == "2.0e-3")
