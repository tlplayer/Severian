import diagnostics
import "token/mod.sev"
import "rule.sev"
import "identifier.sev"


# Integer and float share one recognizer, including exponent validation.
class NumericLexeme: LexicalRule
    def scan(input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
        characters = input.characters
        character = characters[start]
        cursor := start
        leading_fraction = character == "." and cursor + 1 < len(characters) and is_digit(characters[cursor + 1])
        if is_digit(character) or leading_fraction:
            cursor += 1
            while cursor < len(characters) and (is_digit(characters[cursor]) or characters[cursor] == "_"):
                cursor += 1
            floating := cursor + 1 < len(characters) and characters[cursor] == "." and is_digit(characters[cursor + 1])
            if floating:
                cursor += 1
                while cursor < len(characters) and (is_digit(characters[cursor]) or characters[cursor] == "_"):
                    cursor += 1
            if leading_fraction:
                floating = true
            if cursor < len(characters) and (characters[cursor] == "e" or characters[cursor] == "E"):
                floating = true
                cursor += 1
                if cursor < len(characters) and (characters[cursor] == "+" or characters[cursor] == "-"):
                    cursor += 1
                exponent_start = cursor
                while cursor < len(characters) and is_digit(characters[cursor]):
                    cursor += 1
                if cursor == exponent_start:
                    return error(diagnostics.Diagnostic("E000101", "floating exponent requires digits", lexeme_span(input, start, cursor)))
            spelling := characters[start:cursor].join("").replace("_", "")
            if leading_fraction:
                spelling = "0" + spelling
            if floating and "." not in spelling:
                spelling = spelling.replace("e", ".0e").replace("E", ".0E")
            if floating:
                return LexemeMatch(cursor, TokenKind.Float(spelling))
            else:
                return LexemeMatch(cursor, TokenKind.Integer(spelling))
        return LexemeMatch(start, None, false)

