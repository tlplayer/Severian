import source

enum TokenKind:
    Identifier(value: string)
    Integer(value: string)
    Float(value: string)
    Character(value: char)
    String(value: string)
    FormattedString(value: string)
    At
    Colon
    ColonEqual
    QuestionEqual
    Equal
    Plus
    PlusEqual
    Minus
    MinusEqual
    Star
    StarEqual
    Slash
    SlashEqual
    Percent
    PercentEqual
    Power
    EqualEqual
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    Arrow
    LeftParen
    RightParen
    LeftBracket
    RightBracket
    LeftBrace
    RightBrace
    Pipe
    Comma
    Dot
    Newline
    Indent
    Dedent
    Eof


class Token:
    kind: TokenKind
    span: source.Span
