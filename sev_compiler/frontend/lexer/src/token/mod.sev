# Bootstrap counterpart of compiler/frontend/lexer/src/token/mod.rs.
# Token identities stay textual until source enums land, but the classification
# behavior is executable now and follows the host token inventory.

def token_model_ready() -> bool:
    return true

def is_compound_assignment(kind: string) -> bool:
    if kind == "plus-equal":
        return true
    if kind == "minus-equal":
        return true
    if kind == "star-equal":
        return true
    if kind == "slash-equal":
        return true
    return kind == "percent-equal"

def compound_operator(kind: string) -> string:
    if kind == "plus-equal":
        return "+"
    if kind == "minus-equal":
        return "-"
    if kind == "star-equal":
        return "*"
    if kind == "slash-equal":
        return "/"
    if kind == "percent-equal":
        return "%"
    return ""

test "compound token inventory mirrors stage zero":
    assert(is_compound_assignment("plus-equal"))
    assert(compound_operator("percent-equal") == "%")
    assert(not is_compound_assignment("equal"))
