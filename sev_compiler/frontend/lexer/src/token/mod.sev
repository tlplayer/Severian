import source
import universal
import "../lexeme.sev"

enum TokenKind:
    Identifier
    Integer
    Float
    Character
    String
    FormattedString
    Symbol
    Newline
    Indent
    Dedent
    Eof


# To is the classified lexical object handed to the parser. Its original
# spelling remains available even when its literal payload is normalized.
trait TokenTerm:
    property lexeme: Lexeme
    property span: source.Span


class Token: TokenTerm
    kind: TokenKind
    span: source.Span
    lexeme: Lexeme
    syntaxes: list[universal.OperatorSyntax] = []
    descriptor: bool = false
    grammar: bool = false
    value: string | None = None


def validate_token_origin(span: source.Span, lexeme: Lexeme):
    assert(span.source.index == lexeme.span.source.index)
    assert(span.start == lexeme.span.start)
    assert(span.end == lexeme.span.end)
    assert(span.start <= span.end)


def checked_token[To: TokenTerm](token: To) -> To:
    validate_token_origin(token.span, token.lexeme)
    return token


def token_from_lexeme(kind: TokenKind, lexeme: Lexeme, value: string | None = None) -> Token:
    return checked_token(Token(kind, lexeme.span, lexeme, value=value))


def token_text(token: Token) -> string:
    # Only decoded text and macro replacements need an override. Ordinary
    # identifiers, symbols and numeric tokens retain a single source spelling.
    supplied ?= token.value
    if supplied != None:
        return supplied
    return token.lexeme.text


def token_number(token: Token) -> string:
    # Numeric spelling becomes a literal payload at the parser boundary.
    spelling := token_text(token).replace("_", "")
    if token.kind == TokenKind.Float:
        if spelling.starts_with("."):
            spelling = "0" + spelling
        if "." not in spelling:
            spelling = spelling.replace("e", ".0e").replace("E", ".0E")
    return spelling


def token_is_symbol(token: Token, spelling: string) -> bool:
    return token.kind == TokenKind.Symbol and token_text(token) == spelling
