import source
import diagnostics
import "token/mod.sev"


class LexemeInput:
    file: source.SourceFile
    characters: list[string]


def lexeme_input(file: source.SourceFile) -> LexemeInput:
    return LexemeInput(file, file.text.characters())


def lexeme_span(input: LexemeInput, start: int, end: int) -> source.Span:
    # Source spans currently use character offsets throughout the source
    # compiler (including diagnostic rendering and interpolation).
    return source.Span(input.file.id, u32(start), u32(end))


def lexeme_text(input: LexemeInput, start: int, end: int) -> string | diagnostics.Diagnostic:
    if start < 0 or end < start or end > len(input.characters):
        return error(diagnostics.diagnostic_at("E000104", "lexeme source slice is out of bounds", lexeme_span(input, 0, 0)))
    return input.characters[start:end].join("")


class LexemeMatch:
    end: int
    kind: TokenKind | None
    matched: bool = true
    value: string | None = None


# A rule recognizes source. Lx denotes its matched lexeme, To its classified
# token, and G owns grammar/CFG behavior.
trait LexicalRule:
    def scan(input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic
