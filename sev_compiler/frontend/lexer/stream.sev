import EOF, SourceFile from "../source/source.sev"
import Token from "../../syntax/generic/token.sev"


class TokenStream:
    source: SourceFile
    tokens: list[Token]
    end: EOF = EOF()

    def print() -> string:
        result := ""
        line := 1
        cursor := 0
        for token in self.tokens:
            while cursor < token.span.start:
                if self.source.characters[cursor] == "\n":
                    line += 1
                cursor += 1
            spelling := ""
            for character in token.lexeme.text:
                if character == '\n':
                    spelling += "\\n"
                elif character == '\r':
                    spelling += "\\r"
                elif character == '\t':
                    spelling += "\\t"
                elif character == '<':
                    spelling += "\\<"
                elif character == '>':
                    spelling += "\\>"
                else:
                    spelling += string(character)
            result += "<line:" + string(line) + "." + spelling + ">"
        return result + "<EOF>"


test "token printing retains lines without inventing symbol resolution":
    import virtual_source, Span from "../source/source.sev"
    import Lexeme from "../../syntax/generic/lexeme.sev"
    source = virtual_source("tokens.sev", "x\nλ")
    first = Span(source.id, 0, 1)
    second = Span(source.id, 2, 3)
    stream = TokenStream(source, [Token("Identifier", Lexeme("x", first), first), Token("Identifier", Lexeme("λ", second), second)])
    assert(stream.print() == "<line:1.x><line:2.λ><EOF>")
