import SourceFile, Span from "../source/source.sev"
import Diagnostic from "../../syntax/primitive/error/diagnostic.sev"
import LexicalDiagnostic from "diagnostic.sev"


trait Window:
    source: SourceFile
    # Absolute Unicode scalar offsets into the original source snapshot.
    # Maintain start <= cursor <= end <= source length.
    start: u32
    end: u32
    cursor: u32

    # Return None when the requested character is outside this window.
    def peek(distance: u32 = 0) -> string | None
    def advance(count: u32) -> absent | Diagnostic
    def finished() -> bool

    # Capture a child within this window without copying or modifying source.
    # The child starts at its own start; the parent cursor remains unchanged.
    def capture(capture_start: u32, capture_end: u32) -> Window | Diagnostic
    # Describe the full window [start, end), independently of the cursor.
    def span() -> Span
    def text() -> string


class SourceWindow: Window
    source: SourceFile
    start: u32
    end: u32
    cursor: u32

    def peek(distance: u32 = 0) -> string | None:
        if self.cursor >= self.end or distance >= self.end - self.cursor:
            return None
        return self.source.characters[self.cursor + distance]

    def advance(count: u32) -> absent | Diagnostic:
        if count > self.end - self.cursor:
            return LexicalDiagnostic("cursor would escape source window", self.span(), "lexer.window")
        self.cursor += count
        return absent

    def finished() -> bool:
        return self.cursor == self.end

    def capture(capture_start: u32, capture_end: u32) -> Window | Diagnostic:
        if capture_start < self.start or capture_start > capture_end or capture_end > self.end:
            return LexicalDiagnostic("capture would escape source window", self.span(), "lexer.window")
        return SourceWindow(self.source, capture_start, capture_end, capture_start)

    def span() -> Span:
        return Span(self.source.source_id, self.start, self.end)

    def text() -> string:
        return self.source.text[self.start:self.end]


def source_window(source: SourceFile) -> SourceWindow:
    return SourceWindow(source, 0, u32(len(source.characters)), 0)


import virtual_source from "../source/source.sev"


test "source windows preserve Unicode positions and independent cursors":
    source = virtual_source("unicode.sev", "λ>=世界")
    window = source_window(source)
    assert(window.peek() == "λ")
    window.advance(1)
    child = window.capture(1, 3)
    assert(child is Window)
    assert(child.text() == ">=")
    assert(child.span().start == 1 and child.span().end == 3)
    child.advance(2)
    assert(child.finished())
    assert(window.cursor == 1)
    assert(window.advance(5) is Diagnostic)
    assert(window.cursor == 1)
    assert(window.capture(0, 6) is Diagnostic)
    assert(window.peek(100) == None)


test "empty source is a finished bounded window":
    window = source_window(virtual_source("empty.sev", ""))
    assert(window.finished())
    assert(window.peek() == None)
    assert(window.text() == "")
