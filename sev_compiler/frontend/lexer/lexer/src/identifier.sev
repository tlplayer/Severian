import diagnostics
import callable from "token/mod.sev"
import AbiId, ArtifactId, AssertionLocation, AssertionOrigin, AttrValue, AttributeId, BindingId, BlockId, CompiledRegionId, CompilerId, CoverageKind, CoveragePoint, DeclarationId, DefId, FfiId, FunctionId, GenericParamId, HirId, IndexedId, InferVarId, InterfaceId, Lexeme, LexemeInput, LexemeMatch, LexemeTerm, LexicalRule, LocalId, ModuleId, NamedId, OpId, PackageId, PrimitiveId, ProviderId, QualityRegion, RegionId, ScopeId, SourceFile, SourceId, SourceMap, Span, StableId, Substitution, Symbol, SymbolId, SymbolKind, SymbolName, TokenTerm, TypeBinding, TypeConstructorBinding, TypeId, ValueId, VariantId, definition_from_key, load, named_definition, same_definition, semantic_digest, semantic_key, source_id, span, utf8_offset, virtual_source from "rule.sev"


class IdentifierLexeme: LexicalRule
    def scan(input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
        characters = input.characters
        character = characters[start]
        if not character.is_alphabetic() and character != "_":
            return LexemeMatch(start, None, false)
        cursor := start + 1
        while cursor < len(characters) and (characters[cursor].is_alphanumeric() or characters[cursor] == "_"):
            cursor += 1
        return LexemeMatch(cursor, "Identifier")
