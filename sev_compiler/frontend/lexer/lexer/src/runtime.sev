import primitive_descriptors from "../../../../syntax/primitive/catalog.sev"
import SymbolLexeme from "symbol.sev"
import StringLexeme from "string.sev"
import "../../../../syntax/block/block.sev" as model_syntax_block_block
import "../../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import source
import diagnostics
import LexemeInput, LexemeMatch, LexicalRule, lexeme_span, lexeme_text from "rule.sev"
import Symbol, TokenKind, callable, span from "identifier.sev"
import "../../../../syntax/constraint/model.sev" as constraints
import admissible_dispatch_candidates from "../../../../syntax/constraint/dispatch.sev"
import BlockCaptureValue, BlockFieldValue from "../../../../syntax/generic/block.sev"


# Imported rules retain universal source bodies. This evaluator has no parser
# dependency and grants no filesystem, process, or CFG capability to a rule.
enum LexicalValue:
    Capture(value: BlockCaptureValue)
    Sequence(values: list[LexicalValue])
    BlockReference(block: model_syntax_block_block.Block)
    Syntax(expression: model_syntax_function_function.Expression)
    Number(number: int)
    Text(text: string)
    Truth(truth: bool)
    Characters(characters: list[string])
    Input(input: LexemeInput)
    Category(kind: TokenKind)
    Result(result: LexemeMatch)
    Location(span: source.Span)
    Failure(diagnostic: diagnostics.Diagnostic)
    Nothing


class SourceLexicalRule: LexicalRule
    name: string
    methods: list[model_syntax_function_function.FunctionDeclaration]
    span: source.Span
    priority: int = 0
    declaration: model_syntax_function_function.RecordDeclaration | None = None

    def scan(input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
        frame = LexicalFrame(self, [10000])
        value = lexical_invoke(frame, "scan", [LexicalValue.Input(input), LexicalValue.Number(start)], span)
        match value:
            case Result:
                return result
            case Failure:
                return error(diagnostic)
            case _:
                return error(lexical_error("scan must return LexemeMatch", span))


def source_lexical_rule(declaration: model_syntax_function_function.RecordDeclaration) -> SourceLexicalRule | diagnostics.Diagnostic:
    if len(declaration.type_parameters) != 0:
        return error(lexical_error("rule classes must be concrete", declaration.span))
    priority := 0
    for field in declaration.fields:
        if field.name != "priority":
            return error(lexical_error("rule instances are stateless; only priority may be declared", field.span))
        default_expression ?= field.default
        if default_expression != None:
            match default_expression.kind:
                case LiteralValue:
                    match value:
                        case IntegerValue:
                            priority = int(spelling)
                        case _:
                            return error(lexical_error("priority requires a constant integer", field.span))
                case _:
                    return error(lexical_error("priority requires a constant integer", field.span))
        else:
            return error(lexical_error("priority requires a constant integer", field.span))
    names: list[string] = []
    found := false
    for method in declaration.methods:
        if method.name in names:
            return error(lexical_error("duplicate lexical method " + method.name, declaration.span))
        names.append(method.name)
        if method.body == None or len(method.type_parameters) != 0:
            return error(lexical_error("lexical methods require concrete bodies", declaration.span))
        if method.name == "scan":
            found = true
            if len(method.parameters) != 2:
                return error(lexical_error("scan requires input: LexemeInput and start: int", declaration.span))
            if model_syntax_type_annotation.simple_type_name(method.parameters[0].annotation) != "LexemeInput" or model_syntax_type_annotation.simple_type_name(method.parameters[1].annotation) != "int":
                return error(lexical_error("scan requires input: LexemeInput and start: int", declaration.span))
    if not found:
        return error(lexical_error("missing scan implementation", declaration.span))
    return SourceLexicalRule(declaration.name, declaration.methods, declaration.span, priority, declaration)


class LexicalFrame:
    rule: SourceLexicalRule
    budget: list[int]
    names: list[string] = []
    values: list[LexicalValue] = []
    depth: int = 0
    type_names: list[string] = []
    type_values: list[string] = []
    receiver: model_syntax_block_block.Block | None = None
    read_only: bool = false


class LexicalFlow:
    value: LexicalValue = LexicalValue.Nothing
    returned: bool = false
    breaking: bool = false
    continuing: bool = false


def lexical_error(message: string, span: source.Span) -> diagnostics.Diagnostic:
    return diagnostics.Diagnostic("E000105", "lexical rule: " + message, span)


def lexical_tick(frame: LexicalFrame, span: source.Span) -> unit | diagnostics.Diagnostic:
    budget = frame.budget
    budget[0] -= 1
    if budget[0] < 0:
        return error(lexical_error("execution budget exceeded", span))


def lexical_number(value: LexicalValue, span: source.Span) -> int | diagnostics.Diagnostic:
    match value:
        case Number:
            return number
        case _:
            return error(lexical_error("expected an integer", span))


def lexical_text(value: LexicalValue, span: source.Span) -> string | diagnostics.Diagnostic:
    match value:
        case Text:
            return text
        case _:
            return error(lexical_error("expected text", span))


def lexical_truth(value: LexicalValue, span: source.Span) -> bool | diagnostics.Diagnostic:
    match value:
        case Capture:
            if len(value.expressions) == 1 and not value.variadic:
                match value.expressions[0].kind:
                    case LiteralValue:
                        match value:
                            case BooleanValue:
                                return value
                            case _:
                                return error(lexical_error("capture is not a boolean constant", span))
                    case _:
                        return error(lexical_error("dispatch value is not available at compile time", span))
            return error(lexical_error("expected one boolean capture", span))
        case Truth:
            return truth
        case _:
            return error(lexical_error("expected a boolean", span))


def lexical_get(frame: LexicalFrame, name: string, span: source.Span) -> LexicalValue | diagnostics.Diagnostic:
    receiver ?= frame.receiver
    if name == "self" and receiver != None:
        return LexicalValue.BlockReference(receiver)
    index := 0
    for known in frame.names:
        if known == name:
            return frame.values[index]
        index += 1
    return error(lexical_error("unknown binding " + name, span))


def lexical_set(frame: LexicalFrame, name: string, value: LexicalValue):
    index := 0
    for known in frame.names:
        if known == name:
            frame.values[index] = value
            return
        index += 1
    frame.names.append(name)
    frame.values.append(value)


def lexical_path(expression: model_syntax_function_function.Expression) -> string:
    match expression.kind:
        case Name:
            return name
        case Member:
            return lexical_path(object) + "." + name
        case _:
            return ""




def lexical_equal(left: LexicalValue, right: LexicalValue) -> bool:
    match left:
        case Number:
            first = number
            match right:
                case Number:
                    return first == number
                case _:
                    return false
        case Text:
            first = text
            match right:
                case Text:
                    return first == text
                case _:
                    return false
        case Truth:
            first = truth
            match right:
                case Truth:
                    return first == truth
                case _:
                    return false
        case Nothing:
            match right:
                case Nothing:
                    return true
                case _:
                    return false
        case _:
            return false

# TODO: This should be handled on the primitive types in sentences not in the lexer
def lexical_binary(symbol: string, left: LexicalValue, right: LexicalValue, span: source.Span) -> LexicalValue | diagnostics.Diagnostic:
    if symbol == "==" or symbol == "!=":
        equal = lexical_equal(left, right)
        return LexicalValue.Truth(equal if symbol == "==" else not equal)
    match left:
        case Text:
            lhs = text
            rhs = lexical_text(right, span)
            if symbol == "+":
                return LexicalValue.Text(lhs + rhs)
            if symbol == "in":
                return LexicalValue.Truth(lhs in rhs)
            if symbol == "not in":
                return LexicalValue.Truth(lhs not in rhs)
            if symbol == "<":
                return LexicalValue.Truth(lhs < rhs)
            if symbol == "<=":
                return LexicalValue.Truth(lhs <= rhs)
            if symbol == ">":
                return LexicalValue.Truth(lhs > rhs)
            if symbol == ">=":
                return LexicalValue.Truth(lhs >= rhs)
        case Number:
            lhs = number
            rhs = lexical_number(right, span)
            if symbol == "+":
                return LexicalValue.Number(lhs + rhs)
            if symbol == "-":
                return LexicalValue.Number(lhs - rhs)
            if symbol == "*":
                return LexicalValue.Number(lhs * rhs)
            if symbol == "/" or symbol == "//" or symbol == "%":
                if rhs == 0:
                    return error(lexical_error("division by zero", span))
                return LexicalValue.Number(lhs % rhs if symbol == "%" else lhs // rhs)
            if symbol == "<":
                return LexicalValue.Truth(lhs < rhs)
            if symbol == "<=":
                return LexicalValue.Truth(lhs <= rhs)
            if symbol == ">":
                return LexicalValue.Truth(lhs > rhs)
            if symbol == ">=":
                return LexicalValue.Truth(lhs >= rhs)
        case _:
            throw diagnostics.diagnostic("E000105", "unimplemented (sev_compiler/frontend/lexer/lexer/src/runtime.sev)")
    return error(lexical_error("unsupported binary operation " + symbol, span))


def lexical_invoke(parent: LexicalFrame, name: string, arguments: list[LexicalValue], span: source.Span) -> LexicalValue | diagnostics.Diagnostic:
    if parent.depth >= 64:
        return error(lexical_error("call depth exceeded", span))
    for method in parent.rule.methods:
        if method.name == name:
            if len(method.parameters) != len(arguments):
                return error(lexical_error("wrong argument count for " + name, span))
            frame = LexicalFrame(parent.rule, parent.budget, depth=parent.depth + 1, type_names=parent.type_names, type_values=parent.type_values, receiver=parent.receiver, read_only=parent.read_only)
            inherited_index := 0
            for inherited_name in parent.names:
                if inherited_name.starts_with("self."):
                    lexical_set(frame, inherited_name, parent.values[inherited_index])
                inherited_index += 1
            index := 0
            for parameter in method.parameters:
                lexical_set(frame, parameter.name, arguments[index])
                index += 1
            body ?= method.body
            if body != None:
                result = lexical_block(frame, body)
                if result.breaking or result.continuing:
                    return error(lexical_error("loop control escaped a method", span))
                return result.value
            return error(lexical_error("method has no body: " + name, span))
    return error(lexical_error("unknown callable " + name, span))

#TODO: This function is a fucking mess. Clean it up
def lexical_call(frame: LexicalFrame, callee: model_syntax_function_function.Expression, arguments: list[model_syntax_function_function.CallArgument], span: source.Span) -> LexicalValue | diagnostics.Diagnostic:
    path = lexical_path(callee)
    values: list[LexicalValue] = []
    for argument in arguments:
        values.append(lexical_expression(frame, argument.value))
        if argument.name != None and path != "LexemeMatch":
            return error(lexical_error("named arguments are only supported for LexemeMatch", span))
    if path == "LexemeMatch":
        slots: list[LexicalValue] = [LexicalValue.Number(0), LexicalValue.Nothing, LexicalValue.Truth(true), LexicalValue.Nothing]
        supplied: list[bool] = [false, false, false, false]
        index := 0
        for argument in arguments:
            position := index
            name ?= argument.name
            if name != None:
                position = 0 if name == "end" else 1 if name == "kind" else 2 if name == "matched" else 3 if name == "value" else -1
            if position < 0 or position >= 4:
                return error(lexical_error("unknown LexemeMatch argument", span))
            if supplied[position]:
                return error(lexical_error("duplicate LexemeMatch argument", span))
            supplied[position] = true
            slots[position] = values[index]
            index += 1
        if not supplied[0] or not supplied[1]:
            return error(lexical_error("LexemeMatch requires end and kind", span))
        token_kind: TokenKind | None := None
        match slots[1]:
            case Category:
                token_kind = kind
            case Nothing:
                throw diagnostics.diagnostic("E000105", "unimplemented (sev_compiler/frontend/lexer/lexer/src/runtime.sev)")
            case _:
                return error(lexical_error("LexemeMatch kind must be TokenKind or None", span))
        normalized: string | None := None
        match slots[3]:
            case Text:
                normalized = text
            case Nothing:
                throw diagnostics.diagnostic("E000105", "unimplemented (sev_compiler/frontend/lexer/lexer/src/runtime.sev)")
            case _:
                return error(lexical_error("LexemeMatch value must be string or None", span))
        return LexicalValue.Result(LexemeMatch(lexical_number(slots[0], span), token_kind, lexical_truth(slots[2], span), normalized))
    if path == "len" and len(values) == 1:
        match values[0]:
            case Capture:
                return LexicalValue.Number(int(len(value.spans)))
            case Sequence:
                return LexicalValue.Number(int(len(values)))
            case Text:
                return LexicalValue.Number(int(len(text.characters())))
            case Characters:
                return LexicalValue.Number(int(len(characters)))
            case _:
                return error(lexical_error("len requires source text or characters", span))
    if path == "string" and len(values) == 1:
        match values[0]:
            case Number:
                return LexicalValue.Text(string(number))
            case Text:
                return values[0]
            case _:
                return error(lexical_error("string requires an integer or text", span))
    if path == "Error" and len(values) == 1:
        return LexicalValue.Failure(diagnostics.Diagnostic("E000105", lexical_text(values[0], span), span))
    if path == "error" and len(values) == 1:
        match values[0]:
            case Failure:
                return values[0]
            case _:
                return error(lexical_error("error requires a diagnostic", span))
    if path == "lexeme_span" and len(values) == 3:
        match values[0]:
            case Input:
                start = lexical_number(values[1], span)
                end = lexical_number(values[2], span)
                if start < 0 or end < start or end > len(input.characters):
                    return error(lexical_error("source span is out of bounds", span))
                return LexicalValue.Location(lexeme_span(input, start, end))
            case _:
                return error(lexical_error("lexeme_span requires LexemeInput", span))
    if (path == "Diagnostic" or path == "diagnostics.Diagnostic") and len(values) == 3:
        match values[2]:
            case Location:
                return LexicalValue.Failure(diagnostics.Diagnostic(lexical_text(values[0], span), lexical_text(values[1], span), span))
            case _:
                return error(lexical_error("Diagnostic requires a source span", span))
    if path == "lexeme_text" and len(values) == 3:
        match values[0]:
            case Input:
                start = lexical_number(values[1], span)
                end = lexical_number(values[2], span)
                if start < 0 or end < start or end > len(input.characters):
                    return error(lexical_error("source slice is out of bounds", span))
                return LexicalValue.Text(input.characters[start:end].join(""))
            case _:
                return error(lexical_error("lexeme_text requires LexemeInput", span))
    match callee.kind:
        case Member:
            if lexical_path(object) == "self":
                return lexical_invoke(frame, name, values, span)
            receiver = lexical_expression(frame, object)
            match receiver:
                case Text:
                    if name == "is_digit" and len(values) == 0:
                        return LexicalValue.Truth(text.is_digit())
                    if name == "is_alphabetic" and len(values) == 0:
                        return LexicalValue.Truth(text.is_alphabetic())
                    if name == "is_alphanumeric" and len(values) == 0:
                        return LexicalValue.Truth(text.is_alphanumeric())
                    if name == "characters" and len(values) == 0:
                        return LexicalValue.Characters(text.characters())
                    if name == "starts_with" and len(values) == 1:
                        return LexicalValue.Truth(text.starts_with(lexical_text(values[0], span)))
                    if name == "ends_with" and len(values) == 1:
                        return LexicalValue.Truth(text.ends_with(lexical_text(values[0], span)))
                    if name == "replace" and len(values) == 2:
                        return LexicalValue.Text(text.replace(lexical_text(values[0], span), lexical_text(values[1], span)))
                case Characters:
                    if name == "join" and len(values) == 1:
                        return LexicalValue.Text(characters.join(lexical_text(values[0], span)))
                case _:
                    throw diagnostics.diagnostic("E000105", "unimplemented (sev_compiler/frontend/lexer/lexer/src/runtime.sev)")
            return error(lexical_error("unsupported lexical method " + name, span))
        case _:
            return lexical_invoke(frame, path, values, span)

#TODO: What's the difference between lexical call and lexical expression?
def lexical_expression(frame: LexicalFrame, expression: model_syntax_function_function.Expression) -> LexicalValue | diagnostics.Diagnostic:
    lexical_tick(frame, expression.span)
    span = expression.span
    path = lexical_path(expression)
    if path != "" and path in frame.names:
        return lexical_get(frame, path, span)
    match expression.kind:
        case LiteralValue:
            match value:
                case IntegerValue:
                    return LexicalValue.Number(int(spelling))
                case StringValue:
                    return LexicalValue.Text(value)
                case BooleanValue:
                    return LexicalValue.Truth(value)
                case NoneValue:
                    return LexicalValue.Nothing
                case _:
                    return error(lexical_error("unsupported literal", span))
        case Name:
            return lexical_get(frame, name, span)
        case Member:
            if lexical_path(object) == "TokenKind":
                for primitive in primitive_descriptors():
                    kind ?= primitive.token_kind
                    if kind != None and primitive.token_name == name:
                        return LexicalValue.Category(kind)
                symbol = SymbolLexeme([])
                if symbol.token_name == name:
                    return LexicalValue.Category(symbol.token_kind)
                text = StringLexeme()
                if text.formatted_token_name == name:
                    return LexicalValue.Category(text.formatted_token_kind)
                return error(lexical_error("unknown or structural token category " + name, span))
            receiver = lexical_expression(frame, object)
            match receiver:
                case BlockReference:
                    for field in block.context.fields:
                        if field.name == name:
                            return LexicalValue.Capture(field.value)
                    return error(lexical_error("uninitialized block field " + name, span))
                case Input:
                    if name == "characters":
                        return LexicalValue.Characters(input.characters)
                case Result:
                    if name == "end":
                        return LexicalValue.Number(result.end)
                    if name == "matched":
                        return LexicalValue.Truth(result.matched)
                case _:
                    throw diagnostics.diagnostic("E000105", "unimplemented (sev_compiler/frontend/lexer/lexer/src/runtime.sev)")
            return error(lexical_error("unsupported member " + name, span))
        case Call:
            return lexical_call(frame, callee, arguments, span)
        case Subscript:
            receiver = lexical_expression(frame, object)
            position := lexical_number(lexical_expression(frame, index), span)
            match receiver:
                case Sequence:
                    if position < 0:
                        position += len(values)
                    if position < 0 or position >= len(values):
                        return error(lexical_error("sequence index is out of bounds", span))
                    return values[position]
                case _:
                    position = position
            sequence: list[string] := []
            match receiver:
                case Characters:
                    sequence = characters
                case Text:
                    sequence = text.characters()
                case _:
                    return error(lexical_error("indexing requires text or characters", span))
            if position < 0:
                position += int(len(sequence))
            if position < 0 or position >= len(sequence):
                return error(lexical_error("character index is out of bounds", span))
            return LexicalValue.Text(sequence[position])
        case Unary:
            value = lexical_expression(frame, operand)
            if operator.symbol == "not":
                return LexicalValue.Truth(not lexical_truth(value, span))
            if operator.symbol == "-":
                return LexicalValue.Number(-lexical_number(value, span))
            if operator.symbol == "+":
                return LexicalValue.Number(lexical_number(value, span))
            return error(lexical_error("unsupported unary operator", span))
        case Binary:
            if operator.symbol == "is" or operator.symbol == "is not":
                subject = lexical_path(left)
                expected = lexical_path(right)
                index := 0
                for name in frame.type_names:
                    if name == subject:
                        accepted = frame.type_values[index] == expected
                        return LexicalValue.Truth(accepted if operator.symbol == "is" else not accepted)
                    index += 1
                return error(lexical_error("type predicate requires a resolved subject", span))
            lhs = lexical_expression(frame, left)
            if operator.symbol == "and":
                return LexicalValue.Truth(lexical_truth(lhs, span) and lexical_truth(lexical_expression(frame, right), span))
            if operator.symbol == "or":
                return LexicalValue.Truth(lexical_truth(lhs, span) or lexical_truth(lexical_expression(frame, right), span))
            return lexical_binary(operator.symbol, lhs, lexical_expression(frame, right), span)
        case Conditional:
            if lexical_truth(lexical_expression(frame, condition), span):
                return lexical_expression(frame, then_value)
            return lexical_expression(frame, else_value)
        case ListLiteral:
            values: list[LexicalValue] = []
            for element in elements:
                values.append(lexical_expression(frame, element))
            return LexicalValue.Sequence(values)
        case _:
            return error(lexical_error("unsupported expression", span))

#TODO: we should consolidate these into using whatever block defines itself as
def lexical_block(frame: LexicalFrame, block: model_syntax_block_block.Block) -> LexicalFlow | diagnostics.Diagnostic:
    for statement in block.statements:
        lexical_tick(frame, frame.rule.span)
        match statement:
            case BindingStatement:
                lexical_set(frame, binding.name, lexical_expression(frame, binding.value))
            case FieldSet:
                name = lexical_path(target)
                receiver ?= frame.receiver
                if name.starts_with("self.") and receiver != None:
                    if frame.read_only:
                        return error(lexical_error("dispatch predicates cannot mutate a block", span))
                    replacement = lexical_expression(frame, value)
                    if update != None:
                        return error(lexical_error("compound block field updates require a resolved operation", span))
                    field_value = lexical_capture_value(frame, name[5:], replacement, span)
                    found := false
                    index := 0
                    for field in receiver.context.fields:
                        if field.name == name[5:]:
                            receiver.context.fields[index] = BlockFieldValue(name[5:], field_value)
                            found = true
                        index += 1
                    if not found:
                        receiver.context.fields.append(BlockFieldValue(name[5:], field_value))
                    continue
                if name == "" or "." in name:
                    return error(lexical_error("only local bindings can be updated", span))
                replacement := lexical_expression(frame, value)
                operation ?= update
                if operation != None:
                    symbol = operation.symbol.replace("=", "")
                    replacement = lexical_binary(symbol, lexical_get(frame, name, span), replacement, span)
                lexical_set(frame, name, replacement)
            case ExpressionStatement:
                lexical_expression(frame, expression)
            case Return:
                returned ?= value
                if returned != None:
                    return LexicalFlow(lexical_expression(frame, returned), true)
                return LexicalFlow(returned=true)
            case If:
                chosen = then_block if lexical_truth(lexical_expression(frame, condition), span) else else_block
                flow = lexical_block(frame, chosen)
                if flow.returned or flow.breaking or flow.continuing:
                    return flow
            case While:
                while lexical_truth(lexical_expression(frame, condition), span):
                    lexical_tick(frame, span)
                    flow = lexical_block(frame, body)
                    if flow.returned:
                        return flow
                    if flow.breaking:
                        break
            case ForEach:
                sequence = lexical_sequence(lexical_expression(frame, iterable), span)
                for item in sequence:
                    lexical_tick(frame, span)
                    lexical_set(frame, name, item)
                    flow = lexical_block(frame, body)
                    if flow.returned:
                        return flow
                    if flow.breaking:
                        break
            case Break:
                return LexicalFlow(breaking=true)
            case Continue:
                return LexicalFlow(continuing=true)
            case Assert:
                if not lexical_truth(lexical_expression(frame, condition), span):
                    return error(lexical_error("assertion failed", span))
            case Throw:
                failure = lexical_expression(frame, value)
                match failure:
                    case Failure:
                        return error(diagnostic)
                    case _:
                        return error(lexical_error(lexical_text(failure, span), span))
            case _:
                return error(lexical_error("unsupported statement", frame.rule.span))
    return LexicalFlow()

#TODO: WTF IS THIS? 
def has_lexical_constraints(rule: SourceLexicalRule) -> bool:
    for method in rule.methods:
        if method.name == "scan":
            for attachment in method.attachments:
                if attachment.role == constraints.AttachmentRole.Dispatch:
                    return true
    return false


# Evaluate declared acceptance before executing any candidate's scan body.
# Preserve predicate order; no reordering or sharing is inferred here.
def constrained_source_rules(rules: list[SourceLexicalRule], input: LexemeInput, start: int) -> list[SourceLexicalRule] | diagnostics.Diagnostic:
    graph = constraints.ConstraintGraph()
    family = constraints.DispatchFamily("lexical.scan", [])
    candidates: list[SourceLexicalRule] = []
    for rule in rules:
        if not has_lexical_constraints(rule):
            continue
        for method in rule.methods:
            if method.name != "scan":
                continue
            if len(method.parameters) != 2:
                return error(lexical_error("scan requires input: LexemeInput and start: int", rule.span))
            frame = LexicalFrame(rule, [10000])
            lexical_set(frame, method.parameters[0].name, LexicalValue.Input(input))
            lexical_set(frame, method.parameters[1].name, LexicalValue.Number(start))
            requirements: list[constraints.ConstraintId] = []
            for attachment in method.attachments:
                if attachment.role != constraints.AttachmentRole.Dispatch:
                    continue
                accepted = lexical_truth(lexical_expression(frame, attachment.condition), rule.span)
                id = constraints.ConstraintId(u32(len(graph.requirements)))
                proof = constraints.ProofResult.Proven if accepted else constraints.ProofResult.Refuted
                graph.requirements.append(constraints.ConstraintRequirement(id, attachment.condition, result=proof))
                requirements.append(id)
                if not accepted:
                    break
            family.candidates.append(constraints.DispatchCandidate(method.definition, requirements))
            candidates.append(rule)
    result: list[SourceLexicalRule] = []
    for index in admissible_dispatch_candidates(family, graph):
        result.append(candidates[index])
    return result


def match_source_rules(rules: list[SourceLexicalRule], input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
    candidates = constrained_source_rules(rules, input, start)
    if len(candidates) > 1:
        return error(diagnostics.diagnostic_at("E000106", "ambiguous lexical with constraints: " + candidates[0].name + " and " + candidates[1].name, lexeme_span(input, start, start)))
    if len(candidates) == 1:
        selected = candidates[0].scan(input, start)
        if not selected.matched:
            return error(lexical_error("selected lexical implementation rejected its accepted source window", candidates[0].span))
        if selected.end <= start or selected.end > len(input.characters):
            return error(diagnostics.diagnostic_at("E000104", "lexical rule must consume a nonempty source range: " + candidates[0].name, lexeme_span(input, start, start)))
        return selected
    # Compatibility path until all legacy recognizers declare acceptance.
    selected := LexemeMatch(start, None, false)
    priority := 0
    owner := ""
    ambiguous := false
    for rule in rules:
        if has_lexical_constraints(rule):
            continue
        result = rule.scan(input, start)
        if result.matched:
            if result.end <= start or result.end > len(input.characters):
                return error(diagnostics.diagnostic_at("E000104", "lexical rule must consume a nonempty source range: " + rule.name, lexeme_span(input, start, start)))
            if not selected.matched or result.end > selected.end or (result.end == selected.end and rule.priority > priority):
                selected = result
                priority = rule.priority
                owner = rule.name
                ambiguous = false
            elif result.end == selected.end and rule.priority == priority:
                ambiguous = true
    if ambiguous:
        return error(diagnostics.diagnostic_at("E000106", "ambiguous lexical rules at " + owner, lexeme_span(input, start, selected.end)))
    return selected


def lexical_constraint_fixture(name: string, accepted: bool, location: source.Span) -> SourceLexicalRule:
    condition = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_function_function.LiteralValue.BooleanValue(accepted)), location)
    parameters = [
        model_syntax_function_function.FunctionParameter("input", model_syntax_type_annotation.named_type("LexemeInput", [], location), absent, location),
        model_syntax_function_function.FunctionParameter("start", model_syntax_type_annotation.named_type("int", [], location), absent, location),
    ]
    # Deliberately invalid result: tests detect any premature body execution.
    method = model_syntax_function_function.FunctionDeclaration(name="scan", parameters=parameters, body=model_syntax_block_block.Block(), attachments=[constraints.WithAttachment(constraints.AttachmentRole.Dispatch, condition)])
    return SourceLexicalRule(name, [method], location)


test "refuted lexical with never executes its body":
    file = source.virtual_source("rejected.sev", "0")
    input = LexemeInput(file, file.characters)
    rule = lexical_constraint_fixture("Rejected", false, lexeme_span(input, 0, 1))
    result = match_source_rules([rule], input, 0)
    assert(not result.matched)


test "lexical overlap is diagnosed before bodies regardless of priority":
    file = source.virtual_source("overlap.sev", "0")
    input = LexemeInput(file, file.characters)
    first = lexical_constraint_fixture("First", true, lexeme_span(input, 0, 1))
    second = lexical_constraint_fixture("Second", true, lexeme_span(input, 0, 1))
    second.priority = 100
    result ?= match_source_rules([first, second], input, 0)
    if result is diagnostics.Diagnostic:
        assert(result.code == "E000106")
    else:
        assert(false)


test "selected lexical body failure is not a dispatch retry":
    file = source.virtual_source("selected.sev", "0")
    input = LexemeInput(file, file.characters)
    rule = lexical_constraint_fixture("Selected", true, lexeme_span(input, 0, 1))
    result ?= match_source_rules([rule], input, 0)
    if result is diagnostics.Diagnostic:
        assert(result.code == "E000105")
    else:
        assert(false)


test "unique lexical with selects a body within a source window":
    file = source.virtual_source("accepted.sev", "x0y")
    input = LexemeInput(file, ["0"], 1)
    location = lexeme_span(input, 0, 1)
    rule = lexical_constraint_fixture("Accepted", true, location)
    end = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_function_function.LiteralValue.IntegerValue("1")), location)
    category = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Name("TokenKind"), location)
    kind = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Member(category, "Integer"), location)
    constructor = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Name("LexemeMatch"), location)
    call = model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.Call(constructor, [model_syntax_function_function.CallArgument(None, end, location), model_syntax_function_function.CallArgument(None, kind, location)]), location)
    rule.methods[0].body = model_syntax_block_block.Block([model_syntax_block_block.Statement.Return(call, location)])
    result = match_source_rules([rule], input, 0)
    assert(result.matched and result.kind == TokenKind.Integer)
    assert(result.end == 1)
    assert(lexeme_span(input, 0, result.end).start == 1)


def lexical_sequence(value: LexicalValue, span: source.Span) -> list[LexicalValue] | diagnostics.Diagnostic:
    match value:
        case Sequence:
            return values
        case Capture:
            result: list[LexicalValue] = []
            for index in range(int(len(value.spans))):
                item = BlockCaptureValue(value.name, value.annotation, spans=[value.spans[index]])
                if len(value.expressions) > index:
                    item.expressions.append(value.expressions[index])
                if len(value.types) > index:
                    item.types.append(value.types[index])
                if len(value.parameters) > index:
                    item.parameters.append(value.parameters[index])
                if len(value.symbols) > index:
                    item.symbols.append(value.symbols[index])
                result.append(LexicalValue.Capture(item))
            return result
        case _:
            return error(lexical_error("expected a sequence", span))


def lexical_capture_value(frame: LexicalFrame, name: string, value: LexicalValue, span: source.Span) -> BlockCaptureValue | diagnostics.Diagnostic:
    annotation = model_syntax_type_annotation.named_type("Expression", [], span)
    declaration ?= frame.rule.declaration
    if declaration != None:
        found := false
        for field in declaration.fields:
            if field.name == name:
                annotation = field.annotation
                found = true
        if not found:
            return error(lexical_error("undeclared block field " + name, span))
    result = BlockCaptureValue(name, annotation)
    match value:
        case Capture:
            return value
        case Sequence:
            for item in values:
                part = lexical_capture_value(frame, name, item, span)
                for expression in part.expressions:
                    result.expressions.append(expression)
                for typ in part.types:
                    result.types.append(typ)
                for parameter in part.parameters:
                    result.parameters.append(parameter)
                for symbol in part.symbols:
                    result.symbols.append(symbol)
                for location in part.spans:
                    result.spans.append(location)
            return result
        case Syntax:
            result.expressions.append(expression)
        case Number:
            result.expressions.append(model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_function_function.LiteralValue.IntegerValue(string(number))), span))
        case Truth:
            result.expressions.append(model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_function_function.LiteralValue.BooleanValue(truth)), span))
        case Text:
            result.expressions.append(model_syntax_function_function.Expression(model_syntax_function_function.ExpressionKind.LiteralValue(model_syntax_function_function.LiteralValue.StringValue(text)), span))
        case _:
            return error(lexical_error("value cannot initialize a block field", span))
    result.spans.append(span)
    return result
