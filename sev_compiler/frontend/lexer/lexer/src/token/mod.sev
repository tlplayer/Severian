import source
import * from "package:syntax/function/function.sev" as callable
import * from "../../../../../syntax/lexeme.sev"

import * from "package:syntax/token.sev"
import primitives
import syntax

# To is the classified lexical object handed to the parser. Its original
# spelling remains available even when its literal payload is normalized.
class Token: TokenTerm
    kind: TokenKind
    span: source.Span
    lexeme: Lexeme
    syntaxes: list[syntax.OperatorSyntax] = []
    descriptor: bool = false
    grammar: bool = false
    value: string | None = None
    lexical_rules: list[callable.RecordDeclaration] = []
    literal: syntax.LiteralConstruction | None = None

    operator <=>(self) -> string:
        # Only decoded text and macro replacements need an override. Ordinary
        # identifiers, symbols and numeric tokens retain one source spelling.
        supplied ?= self.value
        if supplied != None:
            return supplied
        return self.lexeme.text


def validate_token_origin(span: source.Span, lexeme: Lexeme):
    assert(span.source.index == lexeme.span.source.index)
    assert(span.start == lexeme.span.start)
    assert(span.end == lexeme.span.end)
    assert(span.start <= span.end)


def checked_token[To: TokenTerm](token: To) -> To:
    validate_token_origin(token.span, token.lexeme)
    return token


def token_from_lexeme(kind: TokenKind, lexeme: Lexeme, value: string | None = None, providers: list[primitives.PrimitiveDescriptor] | None = None) -> Token:
    token = checked_token(Token(kind, lexeme.span, lexeme, value=value))
    available ?= providers
    if available != None:
        token.literal = primitives.literal_from_providers(kind, string(token), token.span, available)
    else:
        token.literal = primitives.literal_from_providers(kind, string(token), token.span, primitives.primitive_descriptors())
    return token


def token_literal(token: Token) -> syntax.LiteralConstruction:
    literal ?= token.literal
    if literal != None:
        return literal
    throw Error("literal token has no primitive construction descriptor")


def token_number(token: Token) -> string:
    return token_literal(token).spelling


def token_is_symbol(token: Token, spelling: string) -> bool:
    return token.kind == TokenKind.Symbol and string(token) == spelling
