# Built-in rules are specialized; imported rules execute source bodies through
# the same LexicalRule contract. G/Y spellings share one symbol matcher.
class StandardLexemes: LexicalRule
    symbols: list[LexicalSymbol]
    rules: list[SourceLexicalRule] = []

    def scan(input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
        trivia = lex(TriviaLexeme(), input, start)
        if trivia.matched:
            return trivia
        contributed = match_source_rules(rules, input, start)
        if contributed.matched:
            return contributed
        characters = input.characters
        leading_fraction = characters[start] == "." and start + 1 < len(characters) and is_digit(characters[start + 1])
        if not leading_fraction:
            symbol = lex(SymbolLexeme(symbols), input, start)
            if symbol.matched:
                return symbol
        literal = lex(StringLexeme(), input, start)
        if literal.matched:
            return literal
        number = lex(NumericLexeme(), input, start)
        if number.matched:
            return number
        identifier = lex(IdentifierLexeme(), input, start)
        if identifier.matched:
            return identifier
        return LexemeMatch(start, None, false)


def lex[Rule: LexicalRule](rule: Rule, input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
    if start < 0 or start >= len(input.characters):
        return LexemeMatch(start, None, false)
    result = rule.scan(input, start)
    if result.matched:
        if result.end <= start or result.end > len(input.characters):
            return error(diagnostics.Diagnostic("E000104", "lexical rule must consume a nonempty source range", lexeme_span(input, start, start)))
    return result


test "generic lexical rule entry preserves concrete token values":
    input = lexeme_input(source.virtual_source("generic.sev", "42 name"))
    number = lex(NumericLexeme(), input, 0)
    assert(number.matched)
    if number.matched:
        assert(number.end == 2)
        assert(number.kind == TokenKind.Integer)
    identifier = lex(IdentifierLexeme(), input, 3)
    assert(identifier.matched)
    if identifier.matched:
        assert(identifier.end == 7)
        assert(identifier.kind == TokenKind.Identifier)
    assert(not lex(NumericLexeme(), input, 3).matched)
    assert(not lex(IdentifierLexeme(), input, 7).matched)
