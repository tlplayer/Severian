import diagnostics
import primitives
import syntax
import "token/mod.sev" as _dependency_mod
import LexemeInput, LexemeMatch, LexicalRule, TokenKind, lexeme_span from "rule.sev"


class NumericLexeme: LexicalRule
    def scan(input: LexemeInput, start: int) -> LexemeMatch | diagnostics.Diagnostic:
        result = primitives.scan_number(input.characters, start)
        if result.error != "":
            return error(diagnostics.Diagnostic("E000101", result.error, lexeme_span(input, start, result.end)))
        if not result.matched:
            return LexemeMatch(start, None, false)
        return LexemeMatch(result.end, TokenKind.Float if result.syntax == syntax.LiteralSyntax.Float else TokenKind.Integer)
