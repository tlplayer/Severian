import source
import universal
import "../expression/mod.sev"
import "../statement/mod.sev"

enum ImportSubject:
    Name(name: string)
    Locator(locator: string)


class ImportDeclaration:
    subject: ImportSubject
    source_name: string | None
    alias: string | None
    span: source.Span


enum DecoratorValue:
    Name(value: string)
    String(value: string)
    Integer(value: string)
    Boolean(value: bool)


class DecoratorArgument:
    name: string | None
    value: DecoratorValue
    span: source.Span


class Decorator:
    name: string
    arguments: list[DecoratorArgument]
    span: source.Span


class FunctionParameter:
    name: string
    annotation: universal.TypeAnnotation
    default: Expression | absent
    span: source.Span


enum GenericConstraint:
    Parameter(parameter: string, bound: universal.TypeAnnotation, span: source.Span)
    Predicate(expression: Expression)


class FunctionDeclaration:
    decorators: list[Decorator]
    name: string
    type_parameters: list[string]
    constraints: list[GenericConstraint]
    parameters: list[FunctionParameter]
    result: universal.TypeAnnotation
    body: list[Statement] | None
    span: source.Span


class TypeDeclaration:
    decorators: list[Decorator]
    name: string
    type_parameters: list[string]
    constraints: list[GenericConstraint]
    definition: universal.TypeAnnotation | None
    span: source.Span


enum CompilerExpectation:
    Accept
    Reject


class CompilerTestCase:
    expectation: CompilerExpectation
    diagnostic_name: string | None
    body: list[Statement]
    span: source.Span


class TestDeclaration:
    name: string | None
    modes: list[string]
    body: list[Statement]
    compiler_cases: list[CompilerTestCase]
    span: source.Span


class PropertyDeclaration:
    name: string
    annotation: universal.TypeAnnotation
    default: Expression | None
    span: source.Span


class OperatorParameter:
    name: string
    annotation: universal.TypeAnnotation
    span: source.Span


class OperatorDeclaration:
    operator: universal.OperatorSyntax
    parameters: list[OperatorParameter]
    result: universal.TypeAnnotation
    span: source.Span


class TraitDeclaration:
    decorators: list[Decorator]
    name: string
    type_parameters: list[string]
    constraints: list[GenericConstraint]
    bases: list[universal.TypeAnnotation]
    properties: list[PropertyDeclaration]
    operators: list[OperatorDeclaration]
    span: source.Span
