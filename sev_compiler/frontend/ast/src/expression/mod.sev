import source
import universal


class Expression:
    kind: ExpressionKind
    span: source.Span


class CallArgument:
    name: string | absent
    value: Expression
    span: source.Span


enum ExpressionKind:
    LiteralValue(value: universal.LiteralValue)
    Name(name: string)
    Member(object: Expression, name: string)
    Call(callee: Expression, arguments: list[CallArgument])
    Unary(operator: universal.UnaryOperator, operand: Expression)
    Binary(operator: universal.BinaryOperator, left: Expression, right: Expression)
