import source

enum Literal:
    Integer(spelling: string)
    Float(spelling: string)
    Boolean(value: bool)
    Character(value: char)
    String(value: string)
    Bytes(value: list[u8])
    NoneValue
    Unit


enum UnaryOperator:
    Positive
    Negative
    Not
    Move


enum BinaryOperator:
    Add
    Subtract
    Multiply
    Divide
    Remainder
    Power
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    Contains
    And
    Or


class Expression:
    kind: ExpressionKind
    span: source.Span


class CallArgument:
    name: string | None
    value: Expression
    span: source.Span


enum ExpressionKind:
    LiteralValue(value: Literal)
    Name(name: string)
    Member(object: Expression, name: string)
    Call(callee: Expression, arguments: list[CallArgument])
    Unary(operator: UnaryOperator, operand: Expression)
    Binary(operator: BinaryOperator, left: Expression, right: Expression)
