import source

class CallFrame:
    package: string
    callable: string
    source: string
    line: int = 0
    column: int = 0

class Diagnostic: Error
    code: string
    message: string
    span: source.Span | None
    callstack: list[CallFrame] = []

    def display() -> string:
        return code + ": " + message + render_callstack(callstack)


def render_callstack(frames: list[CallFrame]) -> string:
    if len(frames) == 0:
        return ""
    lines: list[string] = ["\nCall stack (innermost first):"]
    for frame in frames:
        location = frame.source + (":" + string(frame.line) + ":" + string(frame.column) if frame.line > 0 else "")
        lines.append("  at " + frame.package + "." + frame.callable + " (" + location + ")")
    return lines.join("\n")


def with_frame(value: Diagnostic, frame: CallFrame) -> Diagnostic:
    frames = value.callstack[:]
    frames.append(frame)
    return Diagnostic(value.code, value.message, value.span, frames)


def diagnostic(code: string, message: string) -> Diagnostic:
    return Diagnostic(code, message, None)


def diagnostic_at(code: string, message: string, span: source.Span) -> Diagnostic:
    return Diagnostic(code, message, span)


def render(value: Diagnostic, files: list[source.SourceFile]) -> string:
    heading = value.code + ": " + value.message
    location ?= value.span
    if location != None:
        return heading + render_location(location, files) + render_callstack(value.callstack)
    return heading + render_callstack(value.callstack)


def render_location(location: source.Span, files: list[source.SourceFile]) -> string:
    if int(location.source.index) < len(files):
        input = files[location.source.index]
        characters = input.characters
        offset = int(location.start)
        if offset <= len(characters):
            line := 1
            line_start := 0
            cursor := 0
            while cursor < offset:
                if characters[cursor] == "\n":
                    line += 1
                    line_start = cursor + 1
                cursor += 1
            line_end := offset
            while line_end < len(characters) and characters[line_end] != "\n" and characters[line_end] != "\r":
                line_end += 1
            padding := ""
            cursor = line_start
            while cursor < offset:
                padding += "\t" if characters[cursor] == "\t" else " "
                cursor += 1
            number = string(line)
            gutter := ""
            for character in number.characters():
                gutter += " "
            column = offset - line_start + 1
            output := "\n --> " + input.path
            output += ":" + number + ":" + string(column)
            output += "\n" + gutter + " |\n"
            output += string(line) + " | " + characters[line_start:line_end].join("")
            output += "\n" + gutter + " | " + padding + "^"
            return output
    return ""
