import * from "package:syntax/block/block.sev"
import source
import * from "../../syntax/symbol/symbol.sev"
import * from "../../syntax/sentence/sentence.sev"
import * from "../../syntax/function/function.sev"
import * from "../../syntax/constraint/model.sev"


enum RegionKind:
    Callable
    Lexical
    Task


class SemanticLibrary:
    key: string


class SemanticModule:
    key: string
    library: int


class SemanticSubmodule:
    key: string
    module: int


class SemanticRegion:
    id: RegionId
    definition: DefId
    kind: RegionKind
    parent: RegionId | None = None
    introduced_by: SentenceId | None = None
    span: source.Span | None = None


class SemanticSentence:
    id: SentenceId
    region: RegionId
    span: source.Span | None
    ordinal: int


class SemanticHierarchy:
    libraries: list[SemanticLibrary] = []
    modules: list[SemanticModule] = []
    submodules: list[SemanticSubmodule] = []
    regions: list[SemanticRegion] = []
    sentences: list[SemanticSentence] = []
    blocks: list[BlockLayout] = []


def hierarchy_expression(hierarchy: SemanticHierarchy, definition: DefId, expression: Expression, parent: RegionId, sentence: SentenceId):
    expressions: list[Expression] := []
    blocks: list[Block] := []
    match expression.kind:
        case BlockValue:
            # The result is evaluated in the body's lexical scope.
            child = hierarchy_region(hierarchy, definition, body, parent, sentence, expression.span)
            result_sentence = SentenceId(u32(len(hierarchy.sentences)))
            hierarchy.sentences.append(SemanticSentence(result_sentence, child, value.span, int(len(body.statements))))
            hierarchy_expression(hierarchy, definition, value, child, result_sentence)
            return
        case Lambda:
            child = hierarchy_region(hierarchy, definition, Block([ExpressionStatement(body)], span=expression.span), parent, sentence, expression.span)
            hierarchy.blocks[child.index].kind = BlockKind.Callable
            return
        case MatchExpression:
            expressions = [subject]
            for arm in arms:
                pattern ?= arm.pattern
                if pattern != None:
                    expressions.append(pattern)
                blocks.append(arm.body)
        case MockValue:
            expressions = calls[:] + results[:] + [fallback]
        case Ownership:
            expressions = [value]
        case AddressOf:
            expressions = [value]
        case TypeApplication:
            expressions = [target]
        case Member:
            expressions = [object]
        case RequiredMember:
            expressions = [object]
        case Call:
            expressions = [callee]
            for argument in arguments:
                expressions.append(argument.value)
        case ResolvedCall:
            match callee:
                case FunctionValue:
                    expressions.append(expression)
                case Method:
                    expressions.append(receiver)
                case _:
                    expressions = []
            for argument in arguments:
                expressions.append(argument.value)
        case ListLiteral:
            expressions = elements
        case ListValue:
            expressions = elements[:] + [construction, storage]
        case MapLiteral:
            expressions = keys[:] + values[:]
        case Evaluate:
            expressions = [value, body]
        case Fallback:
            expressions = [value, alternative]
        case ThrowValue:
            expressions = [value]
        case ErrorExpectation:
            expected ?= value
            compared ?= comparison
            if expected != None:
                expressions.append(expected)
            if compared != None:
                expressions.append(compared)
        case Subscript:
            expressions = [object, index]
        case Slice:
            expressions = [object]
            for optional in [start, stop, step]:
                bound ?= optional
                if bound != None:
                    expressions.append(bound)
        case IndexReference:
            expressions = [object, index, access]
            stored ?= storage
            if stored != None:
                expressions.append(stored)
        case OutcomeValue:
            expressions = [value]
        case OutcomeTest:
            expressions = [value]
        case OutcomeUnwrap:
            expressions = [value]
        case Convert:
            expressions = [operand]
        case Unary:
            expressions = [operand]
        case Binary:
            expressions = [left, right]
        case ComparisonChain:
            expressions = operands
        case Conditional:
            expressions = [condition, then_value, else_value]
        case Stringify:
            expressions = [value]
        case TypeName:
            expressions = [value]
        case RecordValue:
            for field in fields:
                expressions.append(field.value)
        case FieldReference:
            expressions = [object]
        case _:
            return
    for nested in expressions:
        hierarchy_expression(hierarchy, definition, nested, parent, sentence)
    for body in blocks:
        hierarchy_region(hierarchy, definition, body, parent, sentence, expression.span)


def hierarchy_region(hierarchy: SemanticHierarchy, definition: DefId, body: Block, parent: RegionId | None = None, introduced_by: SentenceId | None = None, origin: source.Span | None = None) -> RegionId:
    region = RegionId(u32(len(hierarchy.regions)))
    kind = RegionKind.Callable if parent == None else RegionKind.Lexical
    block_origin ?= body.span
    if block_origin != None:
        origin = block_origin
    else:
        body.span = origin
    hierarchy.regions.append(SemanticRegion(region, definition, kind, parent, introduced_by, origin))
    parent_block: SourceBlockId | None := None
    enclosing ?= parent
    if enclosing != None:
        parent_block = SourceBlockId(enclosing.index)
    layout = BlockLayout(SourceBlockId(region.index), BlockKind.Callable if parent == None else BlockKind.Lexical, definition, origin, parent_block, introduced_by)
    body.layout = layout
    body.id = layout.id
    body.parent = layout.parent
    body.kind = layout.kind
    body.sentences = []
    hierarchy.blocks.append(layout)
    if enclosing != None:
        hierarchy.blocks[enclosing.index].children.append(layout.id)
    ordinal := 0
    for statement in body.statements:
        sentence = SentenceId(u32(len(hierarchy.sentences)))
        location: source.Span | None := None
        children: list[Block] := []
        expressions: list[Expression] := []
        match statement:
            case BindingStatement:
                location = binding.span
                expressions = [binding.value]
            case ExpressionStatement:
                location = expression.span
                expressions = [expression]
            case If:
                location = span
                children = [then_block, else_block]
                expressions = [condition]
            case While:
                location = span
                children = [body]
                expressions = [condition]
            case ForEach:
                location = span
                children = [body]
                expressions = [iterable]
            case Unsafe:
                location = span
                children = [body]
            case CompilerCheck:
                location = span
                children = [body]
            case GrammarApply:
                location = span
                children = bodies
                expressions = operands
            case Match:
                location = span
                expressions = [subject]
                for arm in arms:
                    children.append(arm.body)
                    pattern ?= arm.pattern
                    if pattern != None:
                        expressions.append(pattern)
            case Return:
                location = span
                returned ?= value
                if returned != None:
                    expressions = [returned]
            case Throw:
                location = span
                expressions = [value]
            case Assert:
                location = span
                expressions = [condition]
                detail ?= message
                if detail != None:
                    expressions.append(detail)
            case FieldSet:
                location = span
                expressions = [target, value]
            case Defer:
                location = span
                expressions = [value]
            case Drop:
                location = span
                expressions = [value]
            case Break:
                location = span
            case Continue:
                location = span
        hierarchy.sentences.append(SemanticSentence(sentence, region, location, ordinal))
        sentence_span ?= location
        if sentence_span != None:
            body.sentences.append(BlockSentence(sentence, sentence_span, []))
        ordinal += 1
        for expression in expressions:
            hierarchy_expression(hierarchy, definition, expression, region, sentence)
        for child in children:
            hierarchy_region(hierarchy, definition, child, region, sentence, location)
    body.subblocks = hierarchy.blocks[region.index].children[:]
    return region


def verify_hierarchy(hierarchy: SemanticHierarchy) -> unit | Error:
    if len(hierarchy.blocks) != len(hierarchy.regions):
        throw Error("semantic blocks and regions disagree")
    for block in hierarchy.blocks:
        if block.id.index >= len(hierarchy.regions):
            throw Error("dangling source block identity")
        for child in block.children:
            if child.index >= len(hierarchy.blocks):
                throw Error("dangling source block child")
            parent ?= hierarchy.blocks[child.index].parent
            if parent == None:
                throw Error("source block child has no parent")
            if parent != None and parent.index != block.id.index:
                throw Error("source block child belongs to another parent")
    for module in hierarchy.modules:
        if module.library < 0 or module.library >= len(hierarchy.libraries):
            throw Error("semantic module has no owning library")
    for submodule in hierarchy.submodules:
        if submodule.module < 0 or submodule.module >= len(hierarchy.modules):
            throw Error("semantic submodule has no owning module")
    index := 0
    for region in hierarchy.regions:
        if region.id.index != index:
            throw Error("invalid semantic region identity")
        parent ?= region.parent
        sentence ?= region.introduced_by
        if parent != None:
            if parent.index >= region.id.index:
                throw Error("cyclic or dangling semantic region owner")
            if sentence == None:
                throw Error("nested region requires an introducing sentence")
        if sentence != None:
            if sentence.index >= len(hierarchy.sentences):
                throw Error("dangling introducing sentence")
            if parent != None:
                if hierarchy.sentences[sentence.index].region.index != parent.index:
                    throw Error("introducing sentence belongs to another region")
        index += 1
    index = 0
    for sentence in hierarchy.sentences:
        if sentence.id.index != index or sentence.region.index >= len(hierarchy.regions):
            throw Error("invalid semantic sentence identity or owner")
        index += 1
