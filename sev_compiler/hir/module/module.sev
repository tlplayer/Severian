import Block, BlockBindingKind, BlockGraph, source_id from "../block/dependencies.sev"
import source
import AttrValue, BindingId, FunctionId, ModuleId, PackageId, ValueId from "../../syntax/symbol/symbol.sev"
import Associativity, ImportDeclaration, OperatorDeclaration, TestDeclaration, TraitDeclaration, TypeDeclaration from "../../syntax/function/syntax.sev"
import Expression, FunctionDeclaration, RecordDeclaration from "../../syntax/function/function.sev"
import Binding from "../../syntax/sentence/sentence.sev"
import CfgBody, Operand from "../../mir/cfg/cfg.sev"
import Value from "../../mir/value.sev"
import G, GrammarDeclaration, GrammarInstruction, GrammarPrimitive, GrammarSlotKind from "../../syntax/grammar/grammar.sev"
import QualityRegion from "../../syntax/source.sev"
import SemanticHierarchy from "hierarchy.sev"
import ConstraintObligation from "../../syntax/constraint/model.sev"


enum Item:
    Import(declaration: ImportDeclaration)
    Trait(declaration: TraitDeclaration)
    BindingItem(binding: Binding)
    ExpressionItem(expression: Expression)
    Function(declaration: FunctionDeclaration)
    Type(declaration: TypeDeclaration)
    Record(declaration: RecordDeclaration)
    Test(declaration: TestDeclaration)
    OperatorItem(declaration: OperatorDeclaration)
    GrammarItem(declaration: GrammarDeclaration)


class Module:
    items: list[Item]
    id: ModuleId = ModuleId(0)
    package: PackageId = PackageId(0)
    path: string = ""
    source_file: source.SourceFile | None = None
    resolved_imports: list[ModuleId] = []
    bindings: list[Binding] = []
    initializer: Block = Block([], [], [])
    # Preserve the seed record ABI; executable initializers occupy cfg_bodies[0].
    initializer_cfg: CfgBody | None = None
    cfg_bodies: list[CfgBody] = []
    functions: list[FunctionDeclaration] = []
    generic_functions: list[FunctionDeclaration] = []
    entry: FunctionId | None = None
    tests: list[TestDeclaration] = []
    types: list[TypeDeclaration] = []
    values: list[Value] = []
    globals: list[ValueId] = []
    records: list[RecordDeclaration] = []
    traits: list[TraitDeclaration] = []
    binding_values: list[tuple[BindingId, ValueId]] = []
    grammars: list[GrammarDeclaration] = []
    reserved_functions: list[string] = []
    excluded_functions: list[string] = []
    prelude_sources: list[int] = []
    quality_files: list[source.SourceFile] = []
    quality_exclusions: list[source.Span] = []
    quality_regions: list[QualityRegion] = []
    debug_files: list[source.SourceFile] = []
    hierarchy: SemanticHierarchy = SemanticHierarchy()
    obligations: list[ConstraintObligation] = []


class Program:
    modules: list[Module]
    blocks: BlockGraph = BlockGraph()


def empty_module() -> Module:
    return Module([])


def empty_program() -> Program:
    return Program([])


# Shared graph data is independent of loading and semantic analysis.
class ModuleGraph:
    modules: list[Module]
