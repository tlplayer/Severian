import lexer
import parser
import source
import diagnostics
import "package:syntax/function/syntax.sev" as syntax
import block_contract from "package:syntax/block/contract.sev"


def lexical_definition(descriptor: lexer.OperatorDescriptor) -> bool:
    return "LexicalRule" in descriptor.bases


# Preserve every source offset while separating the compiler definitions from
# source that can use them. Definitions always use the bootstrap language.
def lexical_source(file: source.SourceFile, registry: lexer.SyntaxRegistry, definitions: bool, blocks: bool = false) -> source.SourceFile:
    ranges: list[lexer.OperatorDescriptor] = []
    for descriptor in registry.descriptors:
        eligible = block_definition(descriptor, registry) if blocks else lexical_definition(descriptor)
        if descriptor.span.source.index == file.id.index and eligible:
            ranges.append(descriptor)
    if len(ranges) == 0 and not definitions:
        return file
    characters = file.characters
    index := 0
    for character in characters:
        included := false
        for descriptor in ranges:
            if index >= int(descriptor.span.start) and index < int(descriptor.end):
                included = true
        if included != definitions and character != "\n" and character != "\r":
            characters[index] = " "
        index += 1
    return source.SourceFile(file.id, file.path, characters.join(""))


def discover_lexical_rules(files: list[source.SourceFile], registry: lexer.SyntaxRegistry) -> unit | diagnostics.Diagnostic:
    for file in files:
        if file.path in registry.lexical_discovered:
            continue
        registry.lexical_discovered.append(file.path)
        found := false
        for descriptor in registry.descriptors:
            if descriptor.span.source.index == file.id.index and lexical_definition(descriptor):
                found = true
        if found:
            definitions = lexical_source(file, registry, true)
            parsed = parser.parse(lexer.scan_tokens(definitions, registry.operators[:]))
            for item in parsed.items:
                match item:
                    case Record:
                        registry.rules.append(lexer.source_lexical_rule(declaration))
                    case _:
                        return error(diagnostics.diagnostic("E000105", "lexical rules must be classes implementing LexicalRule"))


# Discover contracts through declared inheritance, without a block-name table.
def block_definition(descriptor: lexer.OperatorDescriptor, registry: lexer.SyntaxRegistry) -> bool:
    return block_implements(descriptor, registry, "Y") and block_implements(descriptor, registry, "B")


def block_implements(descriptor: lexer.OperatorDescriptor, registry: lexer.SyntaxRegistry, contract: string) -> bool:
    pending = descriptor.bases[:]
    seen: list[string] = []
    while len(pending) > 0:
        base = pending.pop()
        if base in seen:
            continue
        seen.append(base)
        for parent in registry.descriptors:
            if parent.name == base:
                for inherited in parent.bases:
                    pending.append(inherited)
    return contract in seen


def discover_block_declarations(files: list[source.SourceFile], registry: lexer.SyntaxRegistry) -> unit | diagnostics.Diagnostic:
    for file in files:
        if file.path in registry.blocks_discovered:
            continue
        found := false
        for descriptor in registry.descriptors:
            if descriptor.span.source.index == file.id.index and block_definition(descriptor, registry):
                found = true
        if found:
            definitions = lexical_source(file, registry, true, blocks=true)
            parsed = parser.parse(lexer.scan_tokens(definitions, registry.operators[:]))
            for item in parsed.items:
                match item:
                    case Record:
                        try:
                            contract = block_contract(declaration)
                            for descriptor in registry.descriptors:
                                if descriptor.name == declaration.name and descriptor.span.source.index == declaration.span.source.index:
                                    if block_implements(descriptor, registry, "ExecutableBlock"):
                                        contract.require_lowering()
                        catch failure: Error:
                            return error(diagnostics.diagnostic_at("E000105", failure.message, declaration.span))
                        registry.block_declarations.append(declaration)
                    case Trait:
                        continue
                    case _:
                        return error(diagnostics.diagnostic("E000105", "block syntax must belong to a Y + B declaration"))
        registry.blocks_discovered.append(file.path)


test "block sentence discovery follows contracts rather than keyword names":
    file = source.virtual_source("custom-block.sev", "class unless: Y + B\n    context: BlockContext = BlockContext()\n    span: Span | None = None\n    sentences: list[BlockSentence] = []\n    subblocks: list[SourceBlockId] = []\n    sentence unless[\"unless\", conditions...: bool, \":\"]() -> B:\n        return self\n")
    registry = lexer.SyntaxRegistry([syntax.OperatorSyntax("+", syntax.Fixity.Infix, 1, syntax.Associativity.Left)])
    lexer.discover_operator_descriptors(lexer.scan_bootstrap(file), registry)
    discover_block_declarations([file], registry)
    assert(len(registry.block_declarations) == 1)
    assert(registry.block_declarations[0].name == "unless")
    assert(len(registry.block_declarations[0].sentences) == 1)
    discover_block_declarations([file], registry)
    assert(len(registry.block_declarations) == 1)


test "block discovery rejects incomplete compiler contracts at the declaration":
    for text in [
        "class incomplete: Y + B\n    span: Span | None = None\n",
        "class incomplete: Y + B\n    context: BlockContext = BlockContext()\n    span: Span | None = None\n    sentences: list[BlockSentence] = []\n    subblocks: list[SourceBlockId] = []\n    sentence incomplete[\"incomplete\"]():\n        return\n",
        "class incomplete: Y + B + ExecutableBlock\n    context: BlockContext = BlockContext()\n    span: Span | None = None\n    sentences: list[BlockSentence] = []\n    subblocks: list[SourceBlockId] = []\n    sentence incomplete[\"incomplete\"]() -> B:\n        return self\n",
    ]:
        file = source.virtual_source("incomplete-block.sev", text)
        registry = lexer.SyntaxRegistry([syntax.OperatorSyntax("+", syntax.Fixity.Infix, 1, syntax.Associativity.Left)])
        lexer.discover_operator_descriptors(lexer.scan_bootstrap(file), registry)
        result ?= discover_block_declarations([file], registry)
        assert(result is diagnostics.Diagnostic)
        assert(len(registry.block_declarations) == 0)
