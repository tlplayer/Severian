tion, ProviderId, QualityRegion, RecordDeclaration, RegionId, RegisteredOperation, Remainder, ResolvedCallee, RightShift, RuntimeId, ScalarOperation, ScopeId, SemanticObject, Sentence, SentenceDefinition, SentenceField, SentenceId, SentenceMatch, Signature, Size, SourceBlockId, SourceFile, SourceMap, Span, StableId, Statement, Substitution, Subtract, Symbol, SymbolId, SymbolKind, SymbolName, Term, TermRole, TestCaseRow, TestDeclaration, TestExpectation, TestMode, TestModeArguments, TestStream, TokenTerm, TraitDeclaration, TraitRef, TyInterner, Type, TypeAnnotation, TypeAnnotationKind, TypeBinding, TypeConstraint, TypeConstructorBinding, TypeDeclaration, TypeId, TypeKind, TypePattern, TypeRef, UnaryOperation, UnaryOperator, UnifyError, ValueId, VariantId, WithAttachment, Y, accepts_shape, allocate_effect, annotation_key, array_mlir, attribute_id, backend_id, byte_view_mlir, callable_key, control_flow, declared_mlir_binding, definition_from_key, dialect_id, free_effect, hashing, index_mlir, insert_type, io_effect, iteration_sentences, load, match_sentence, memref_mlir, named_definition, named_operation, named_type, no_effects, operation_id, operator_syntax, outcome_variants, provider_id, ranked_memref_storage, read_effect, record_mlir_binding, resolve_expression, resolve_sentence, resolved_function, runtime_id, same_constructor, same_definition, same_parameters, scalar_boundary, scalar_mlir, scalar_operand_segments, scalar_requirement_names, scalar_requirements, semantic_digest, semantic_key, simple_type_name, span, standard_block_syntax, struct_mlir, tensor_mlir, test_mode_name, throw_effect, type_children, union_variants, unranked_memref_mlir, unranked_tensor_mlir, utf8_offset, virtual_source, write_effect from "../../../syntax/block/block.sev"
