import "../../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../../syntax/function/syntax.sev" as model_syntax_function_syntax
import "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import "../../../../syntax/type/annotation.sev" as model_syntax_type_annotation
import diagnostics
import "definitions.sev" as definitions
import "../../../../syntax/primitive/catalog.sev" as scalar


def path(expression: model_syntax_function_function.Expression) -> string:
    match expression.kind:
        case Name:
            return name
        case Member:
            return path(object) + "." + name
        case _:
            return ""


def key_type(expression: model_syntax_function_function.Expression) -> model_syntax_type_annotation.TypeAnnotation | diagnostics.Diagnostic:
    match expression.kind:
        case Binary:
            if operator.symbol == "|":
                return model_syntax_type_annotation.TypeAnnotation(model_syntax_type_annotation.Union([key_type(left), key_type(right)]), expression.span)
        case _:
            throw diagnostics.diagnostic("E000212", "unimplemented (sev_compiler/frontend/semantic/semantic/src/grammar_scalar.sev)")
    name = path(expression)
    if name == "":
        return error(diagnostics.diagnostic_at("E000212", "scalar operation map keys must be types", expression.span))
    return model_syntax_type_annotation.named_type(name, [], expression.span)


def descriptor(expression: model_syntax_function_function.Expression) -> model_syntax_function_syntax.ScalarOperation | diagnostics.Diagnostic:
    result = model_syntax_function_syntax.ScalarOperation("")
    match expression.kind:
        case Call:
            if path(callee) != "ScalarOperation":
                return error(diagnostics.diagnostic_at("E000212", "expected ScalarOperation in grammar map", expression.span))
            fields = ["mnemonic", "predicate", "identity", "direct"]
            seen: list[string] = []
            positional := 0
            keyword := false
            for argument in arguments:
                name := ""
                supplied ?= argument.name
                if supplied != None:
                    name = supplied
                    keyword = true
                else:
                    if keyword or positional >= len(fields):
                        return error(diagnostics.diagnostic_at("E000212", "invalid ScalarOperation arguments", argument.span))
                    name = fields[positional]
                    positional += 1
                if name not in fields or name in seen:
                    return error(diagnostics.diagnostic_at("E000212", "unknown or duplicate ScalarOperation field " + name, argument.span))
                seen.append(name)
                accepted := false
                match argument.value.kind:
                    case LiteralValue:
                        match value:
                            case StringValue:
                                if name == "mnemonic" and value != "":
                                    result.mnemonic = value
                                    accepted = true
                            case IntegerValue:
                                if name == "predicate":
                                    result.predicate = int(spelling)
                                    accepted = true
                                elif name == "identity":
                                    result.identity = int(spelling)
                                    accepted = true
                            case BooleanValue:
                                if name == "direct":
                                    result.direct = value
                                    accepted = true
                            case _:
                                throw diagnostics.diagnostic("E000212", "unimplemented (sev_compiler/frontend/semantic/semantic/src/grammar_scalar.sev)")
                    case _:
                        throw diagnostics.diagnostic("E000212", "unimplemented (sev_compiler/frontend/semantic/semantic/src/grammar_scalar.sev)")
                if not accepted:
                    return error(diagnostics.diagnostic_at("E000212", "invalid literal for ScalarOperation." + name, argument.span))
            if result.mnemonic != "":
                return result
        case _:
            throw diagnostics.diagnostic("E000212", "unimplemented (sev_compiler/frontend/semantic/semantic/src/grammar_scalar.sev)")
    return error(diagnostics.diagnostic_at("E000212", "grammar map requires ScalarOperation with a mnemonic", expression.span))


def resolve(environment: definitions.SemanticDefinitions, records: list[model_syntax_function_function.RecordDeclaration]) -> unit | diagnostics.Diagnostic:
    ordinal := 0
    for declaration in environment.traits:
        if declaration.grammar:
            syntax = model_syntax_function_syntax.OperatorSyntax("", model_syntax_function_syntax.Fixity.Infix, 0, model_syntax_function_syntax.Associativity.None, domain=model_syntax_function_syntax.OperatorDomain.GrammarOperator, definition=declaration.definition, grammar_name=declaration.name)
            properties: list[string] = []
            operations: list[model_syntax_function_syntax.ScalarOperation] = []
            for inherited in definitions.inherited_traits(environment, declaration):
                for property in inherited.properties:
                    if property.name in properties:
                        continue
                    supplied ?= property.default
                    if supplied == None:
                        continue
                    if supplied != None:
                        properties.append(property.name)
                        if property.name == "symbol":
                            match supplied.kind:
                                case SourceSymbol:
                                    syntax.symbol = spelling
                                case _:
                                    throw diagnostics.diagnostic("E000212", "unimplemented (sev_compiler/frontend/semantic/semantic/src/grammar_scalar.sev)")
                        elif property.name == "fixity":
                            if path(supplied).split(".")[-1] == "Prefix":
                                syntax.fixity = model_syntax_function_syntax.Fixity.Prefix
                        elif property.name == "operations":
                            match property.annotation.kind:
                                case Named:
                                    if name != "map" or len(arguments) != 2:
                                        return error(diagnostics.diagnostic_at("E000212", "grammar operations require {T: ScalarOperation}", property.span))
                                    if model_syntax_type_annotation.simple_type_name(arguments[0]) != "T" or model_syntax_type_annotation.simple_type_name(arguments[1]) != "ScalarOperation":
                                        return error(diagnostics.diagnostic_at("E000212", "grammar operations require {T: ScalarOperation}", property.span))
                                case _:
                                    return error(diagnostics.diagnostic_at("E000212", "grammar operations require {T: ScalarOperation}", property.span))
                            match supplied.kind:
                                case MapLiteral:
                                    entry := 0
                                    for key in keys:
                                        operation = descriptor(values[entry])
                                        for operand in definitions.family_members(environment, key_type(key), records, inherited.lookup):
                                            known ?= scalar.scalar_type(operand)
                                            if known == None:
                                                return error(diagnostics.diagnostic_at("E000212", "scalar operation key requires a scalar type", key.span))
                                            for previous in operations:
                                                if previous.operand_type.index == operand.index:
                                                    return error(diagnostics.diagnostic_at("E000212", "duplicate scalar operation type key", key.span))
                                            operations.append(model_syntax_function_syntax.ScalarOperation(operation.mnemonic, operation.predicate, operation.identity, operation.direct, operand))
                                        entry += 1
                                case _:
                                    return error(diagnostics.diagnostic_at("E000212", "grammar operations require a map literal", supplied.span))
            if "operations" in properties:
                if syntax.symbol == "":
                    return error(diagnostics.diagnostic_at("E000212", "scalar operation grammar requires a symbol", declaration.span))
                declaration.scalar_syntax = syntax
                declaration.scalar_operations = operations
                environment.traits[ordinal] = declaration
        ordinal += 1


class Selection:
    syntax: model_syntax_function_syntax.OperatorSyntax | None = None


def lookup(environment: definitions.SemanticDefinitions, symbol: string, arity: int, operand: model_syntax_symbol_symbol.TypeId) -> Selection | diagnostics.Diagnostic:
    selected: model_syntax_function_syntax.OperatorSyntax | None := None
    for declaration in environment.traits:
        syntax ?= declaration.scalar_syntax
        if syntax != None:
            count = 1 if syntax.fixity == model_syntax_function_syntax.Fixity.Prefix else 2
            if syntax.symbol == symbol and count == arity:
                for operation in declaration.scalar_operations:
                    if operation.operand_type.index == operand.index:
                        if selected != None:
                            return error(diagnostics.diagnostic_at("E000212", "ambiguous scalar grammar operation " + symbol, declaration.span))
                        selected = model_syntax_function_syntax.OperatorSyntax(syntax.symbol, syntax.fixity, syntax.precedence, syntax.associativity, domain=syntax.domain, definition=syntax.definition, grammar_name=syntax.grammar_name, scalar_operation=operation)
    return Selection(selected)


def comparison(environment: definitions.SemanticDefinitions, symbol: string) -> bool:
    for declaration in environment.traits:
        syntax ?= declaration.scalar_syntax
        if syntax != None:
            if syntax.symbol == symbol and syntax.fixity == model_syntax_function_syntax.Fixity.Infix:
                for operation in declaration.scalar_operations:
                    if operation.predicate >= 0:
                        return true
    return false
