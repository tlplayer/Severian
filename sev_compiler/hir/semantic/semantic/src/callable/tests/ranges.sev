class Counter:
    value: int = 0

    def sum() -> int:
        for index in range(1, 6):
            if index == 2:
                continue
            value += index
            if value > 10:
                break
        return value


def backwards() -> int:
    value := 0
    for index in range(4, 0, -1):
        value += index
    return value


test "range loops use ordinary callable control flow":
    counter = Counter()
    assert(counter.sum() == 13)
    assert(counter.value == 13)
    assert(backwards() == 10)
    print("ranges complete")
