import "../../../../hir/module/module.sev" as model_hir_module_module
import "../../../../syntax/function/function.sev" as model_syntax_function_function
import "../../../../syntax/symbol/symbol.sev" as model_syntax_symbol_symbol
import diagnostics
import "callable.sev" as callable
import "definitions.sev" as definitions


# Both compiler entries use the same declaration environment and typed body
# analysis. The former TypeContext-based analyzer was disconnected from the
# executable type model and silently ignored most source declarations.
enum AnalysisMode:
    Build
    Test


class AnalysisContext:
    mode: AnalysisMode
    module_name: string


def analyze_with_package_functions(
    module_ast: model_hir_module_module.Module,
    types: definitions.SemanticDefinitions,
    context: AnalysisContext,
    visible: list[model_syntax_function_function.FunctionDeclaration],
    own_ids: list[model_syntax_symbol_symbol.FunctionId],
    test_ids: list[model_syntax_symbol_symbol.FunctionId],
) -> model_hir_module_module.Program | diagnostics.Diagnostic:
    include_tests = context.mode == Test
    typed = callable.analyze_registered_callables(module_ast, include_tests, visible, own_ids, test_ids, types)
    typed.path = context.module_name
    return model_hir_module_module.Program([typed])


def analyze_with_context(module: model_hir_module_module.Module, types: definitions.SemanticDefinitions, context: AnalysisContext) -> model_hir_module_module.Program | diagnostics.Diagnostic:
    return analyze_with_package_functions(module, types, context, [], [], [])


def analyze(module: model_hir_module_module.Module) -> model_hir_module_module.Program | diagnostics.Diagnostic:
    return analyze_with_context(module, definitions.SemanticDefinitions(), AnalysisContext(Build, "memory"))


def analyze_tests(module: model_hir_module_module.Module) -> model_hir_module_module.Program | diagnostics.Diagnostic:
    return analyze_with_package_functions(module, definitions.SemanticDefinitions(), AnalysisContext(Test, "memory"), [], [], [])

import "macros.sev" as _dependency_macros
import "callable.sev" as _dependency_callable
import "definitions.sev" as _dependency_definitions

# Public module interfaces.
import "macros.sev" as macros
