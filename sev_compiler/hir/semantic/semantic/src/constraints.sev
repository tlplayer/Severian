import "../../../../syntax/constraint/model.sev" as model_syntax_constraint_model
import "../../../../syntax/function/function.sev" as model_syntax_function_function


# The bounded evaluator never executes user code. Unsupported predicates remain
# Unknown and must retain their runtime check or fail a static-only requirement.
def prove_condition(expression: model_syntax_function_function.Expression) -> model_syntax_constraint_model.ProofResult:
    match expression.kind:
        case LiteralValue:
            match value:
                case BooleanValue:
                    return model_syntax_constraint_model.ProofResult.Proven if value else model_syntax_constraint_model.ProofResult.Refuted
                case _:
                    return model_syntax_constraint_model.ProofResult.Unknown
        case Unary:
            if operator.symbol == "not":
                result = prove_condition(operand)
                if result == model_syntax_constraint_model.ProofResult.Proven:
                    return model_syntax_constraint_model.ProofResult.Refuted
                if result == model_syntax_constraint_model.ProofResult.Refuted:
                    return model_syntax_constraint_model.ProofResult.Proven
        case Binary:
            first = prove_condition(left)
            second = prove_condition(right)
            if operator.symbol == "and":
                if first == model_syntax_constraint_model.ProofResult.Refuted or second == model_syntax_constraint_model.ProofResult.Refuted:
                    return model_syntax_constraint_model.ProofResult.Refuted
                if first == model_syntax_constraint_model.ProofResult.Proven and second == model_syntax_constraint_model.ProofResult.Proven:
                    return model_syntax_constraint_model.ProofResult.Proven
            if operator.symbol == "or":
                if first == model_syntax_constraint_model.ProofResult.Proven or second == model_syntax_constraint_model.ProofResult.Proven:
                    return model_syntax_constraint_model.ProofResult.Proven
                if first == model_syntax_constraint_model.ProofResult.Refuted and second == model_syntax_constraint_model.ProofResult.Refuted:
                    return model_syntax_constraint_model.ProofResult.Refuted
        case _:
            return model_syntax_constraint_model.ProofResult.Unknown
    return model_syntax_constraint_model.ProofResult.Unknown
