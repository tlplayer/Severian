import package

test "pipeline retains failures and continues independent steps":
    stage = package.temporary("/tmp")
    steps = [
        package.Step("pass", ["printf", "%s", "literal '$HOME;\n"], stage),
        package.Step("failure", ["sh", "-c", "echo 'error: deliberate failure' >&2; exit 7"], stage),
        package.Step("blocked", ["touch", stage + "/unexpected"], stage, ["failure"]),
        package.Step("absent", [], stage, enabled=false),
        package.Step("later", ["printf", "later"], stage),
    ]
    report = package.pipeline(steps, stage)
    assert(report.passed == 2)
    assert(report.failed == 1)
    assert(report.blocked == 1)
    assert(report.absent == 1)
    assert(report.pending == 0)
    assert(report.results[1].exit_code == 7)
    assert(report.results[1].diagnostic == "error: deliberate failure")
    assert(package.read_text(report.results[0].stdout) == "literal '$HOME;\n")
    assert(not package.exists(stage + "/unexpected"))
    package.require_command(["python3", "-c", "import json,sys; r=json.load(open(sys.argv[1])); assert len(r['results'])==5; assert r['failed']==1; assert r['stages']['command']['eligible']==4; assert r['stages']['command']['success_percent']==50", report.directory + "/results.json"])
    assert(package.read_text(report.directory + "/REPORT.md").contains("failure"))
    package.remove_tree(stage)

test "pipeline validates dependencies before running commands":
    stage = package.temporary("/tmp")
    rejected := false
    try:
        package.pipeline([package.Step("bad", ["touch", stage + "/unexpected"], stage, ["missing"])], stage)
    catch error: Error:
        rejected = true
    assert(rejected)
    assert(not package.exists(stage + "/unexpected"))
    package.remove_tree(stage)

test "pipeline reports timeouts and output mismatches":
    stage = package.temporary("/tmp")
    package.write_text(stage + "/expected", "expected")
    report = package.pipeline([
        package.Step("timeout", ["sleep", "10"], stage, timeout=1),
        package.Step("mismatch", ["printf", "actual"], stage, stdout_fixture=stage + "/expected"),
        package.Step("missing fixture", ["true"], stage, stdout_fixture=stage + "/missing"),
    ], stage)
    assert(report.failed == 3)
    assert(report.results[0].status == "timeout")
    assert(report.results[1].status == "fail")
    assert(report.results[2].diagnostic.contains("missing stdout fixture"))
    package.remove_tree(stage)
