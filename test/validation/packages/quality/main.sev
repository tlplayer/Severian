import package


def metrics(text: string, policy: string = "{}") -> list[package.LintDiagnostic] | Error:
    input = package.lint_source("example.sev", text)
    package.lint_declarations(input, false, [])
    output: list[package.LintDiagnostic] = []
    entries = package.parse_document(policy)
    package.validate_lint(entries)
    package.lint_metrics(input, entries, output)
    return output

def occurrences(values: list[package.LintDiagnostic], rule: string) -> int:
    count := 0
    for value in values:
        if value.rule == rule:
            count += 1
    return count

test "JSON5 comments, strings, arrays and nested package policy":
    entries = package.parse_document("{ package: {name: 'demo', version: '0.1.0',}, /*ok*/ bin: [{name:'demo', path:'main.sev'}], dependencies: { foo: {path: '../foo'} } }")
    assert(package.text_setting(entries, "package", "name") == "demo")
    assert(package.text_setting(entries, "bin.0", "path") == "main.sev")
    assert(package.parse_dependency("foo", package.setting(entries, "dependencies", "foo"), false).reference.location == "../foo")
    rendered = package.entries_json(entries)
    assert(package.text_setting(package.parse_document(rendered), "package", "name") == "demo")
    escaped = package.parse_document("{name:'a\\u03bb\\ud83d\\ude00', text:'a\\n\\tb', count:0x10}")
    assert(package.text_setting(escaped, "", "name") == "aλ😀")
    assert(package.setting(escaped, "", "count") == "16")
    assert(package.text_setting(package.parse_document(package.entries_json(escaped)), "", "text") == "a\n\tb")

test "JSON5 rejects malformed, duplicate and trailing input":
    for text in ["{x:1,x:2}", "{x:}", "{x:'unterminated}", "{x:01}", "{x:1} junk", "/* open", "{x:[1 2]}", "{x:1e}"]:
        failed := false
        try:
            package.parse_document(text)
        catch failure: Error:
            failed = true
        assert(failed, text)

test "file and callable limits have passing and boundary cases":
    text = "def main():\n    print(1)\n"
    assert(occurrences(metrics(text, "{lint:{'file-lines':2,'function-lines':2}}"), "L0001") == 0)
    assert(occurrences(metrics(text, "{lint:{'file-lines':1}}"), "L0001") == 1)
    assert(occurrences(metrics(text, "{lint:{'function-lines':1}}"), "L0002") == 1)
    assert(occurrences(metrics(text, "{lint:{'file-lines':3,'function-lines':3}}"), "L0002") == 0)

test "parameters use syntax nesting and exclude the receiver":
    text = "def helper(a: tuple[int, int], b: int = min(1, 2)):\n    print(a, b)\n"
    assert(occurrences(metrics(text, "{lint:{parameters:2}}"), "L0003") == 0)
    assert(occurrences(metrics(text, "{lint:{parameters:1}}"), "L0003") == 1)
    method = "class Example:\n    def method(self, value: int):\n        print(value)\n"
    assert(occurrences(metrics(method, "{lint:{parameters:1}}"), "L0003") == 0)

test "unused locals exclude strings, comments and other scopes":
    text = "def a(unused: int):\n    value = 1\n    _ignored = 2\n    print(\"value unused\") # value\ndef b(value: int):\n    print(value)\n"
    assert(occurrences(metrics(text), "L0004") == 2)
    assert(occurrences(metrics("def a(value: int):\n    print(value)\n"), "L0004") == 0)

test "class, match and conditional structural metrics":
    text = "class Example:\n    def a():\n        throw Error("Unimplemented")    def b():\n        throw Error("Unimplemented")def choose(value: int):\n    match value:\n        case 1:\n            print(1)\n        case _:\n            print(2)\n    if value == 1:\n        print(1)\n    elif value == 2:\n        print(2)\n"
    values = metrics(text, "{lint:{'class-methods':1,'match-arms':1,'conditional-branches':1}}")
    assert(occurrences(values, "L0006") == 1)
    assert(occurrences(values, "L0007") == 1)
    assert(occurrences(values, "L0008") == 1)
    boundary = metrics(text, "{lint:{'class-methods':2,'match-arms':2,'conditional-branches':2}}")
    assert(occurrences(boundary, "L0006") == 0)
    assert(occurrences(boundary, "L0007") == 0)
    assert(occurrences(boundary, "L0008") == 0)

test "dead callable reachability includes callbacks and excludes dead cycles":
    input = package.lint_source("example.sev", "def main():\n    use(callback)\ndef callback():\n    throw Error("Unimplemented")def dead():\n    other()\ndef other():\n    dead()\n")
    package.lint_declarations(input, false, [])
    live = package.lint_reachable([input])
    assert("callback" in live)
    assert("dead" not in live)
    assert("other" not in live)
    library = package.lint_source("lib.sev", "def exported():\n    private()\ndef private():\n    throw Error("Unimplemented")")
    package.lint_declarations(library, true, [])
    assert("exported" in package.lint_reachable([library]))

test "every rule supports override and explicit suppression":
    for rule in package.lint_rules():
        entries = [package.Entry("lint", rule.option, "0"), package.Entry("lint.rules", rule.id, "\"error\"")]
        input = package.lint_source("example.sev", "print(1)\n")
        values: list[package.LintDiagnostic] = []
        index := 0
        for candidate in package.lint_rules():
            if candidate.id == rule.id:
                break
            index += 1
        package.lint_measure(input, 0, 0, index, entries, values)
        assert(len(values) == 0)
        package.lint_measure(input, 0, 1, index, entries, values)
        assert(len(values) == 1)
        assert(values[0].level == "error")
        assert(values[0].line == 1 and values[0].column == 1)
        assert(values[0].measured == 1 and values[0].threshold == 0)
        assert(values[0].remediation != "")
        suppressed = package.lint_source("example.sev", "# sev-lint: allow " + rule.id + "\nprint(1)\n")
        muted: list[package.LintDiagnostic] = []
        package.lint_measure(suppressed, 0, 1, index, entries, muted)
        assert(len(muted) == 0)
        disabled = [package.Entry("lint.rules", rule.id, "\"off\"")]
        package.lint_measure(input, 0, rule.limit + 1, index, disabled, muted)
        assert(len(muted) == 0)

test "invalid package lint options fail closed":
    for text in ["{lint:false}", "{lint:{enabled:false,exclude:[2]}}", "{lint:{exclude:['../secret']}}", "{lint:{enabled:'yes'}}", "{lint:{parameters:-1}}", "{lint:{rules:{L9999:'warning'}}}", "{lint:{rules:{L0001:'fatal'}}}", "{lint:{typo:3}}"]:
        failed := false
        try:
            package.parse_manifest("{package:{name:'demo'}," + text[1:])
        catch failure: Error:
            failed = true
        assert(failed, text)

test "unreachable statements stop at the enclosing block":
    values = metrics("def main():\n    if true:\n        return\n        print(1)\n    print(2)\n")
    assert(occurrences(values, "L0005") == 1)
    for value in values:
        if value.rule == "L0005":
            assert(value.line == 4)

test "package options and lock documents round trip as JSON":
    manifest = package.parse_manifest("{package:{name:'demo'},bin:[{name:'demo',path:'main.sev'}]}")
    generated = package.options(manifest.entries)
    roundtrip = package.parse_manifest(generated)
    assert(package.setting(roundtrip.entries, "lint", "enabled") == "true")
    for rule in package.lint_rules():
        assert(package.text_setting(roundtrip.entries, "lint.rules", rule.id) == rule.level)
    graph = package.Resolution([package.ResolvedPackage(package.PackageIdentity("demo", "0.1.0", "root"), "/tmp/demo", manifest, "sha256:test")], [], "")
    encoded = package.encode_resolution(graph)
    assert(encoded.starts_with("{"))
    assert(package.decode_resolution(encoded).packages[0].manifest.name == "demo")
    lock = package.render_lock(graph.packages, graph.edges)
    assert(lock.starts_with("{"))
    package.validate_lock(package.parse_document(lock), graph.packages)

test "next line suppression and string contents are distinct":
    assert(occurrences(metrics("# sev-lint-next-line: allow L0003\ndef f(a: int, b: int):\n    print(a,b)\n", "{lint:{parameters:1}}"), "L0003") == 0)
    failed := false
    try:
        metrics("# sev-lint: allow L9999\nprint(1)\n")
    catch failure: Error:
        failed = true
    assert(failed)

test "documentation tracks current parameter names and required sections":
    text = "# Computes a magnitude.\n# Parameters:\n# - value: Input integer.\n# Returns:\n# - Input without its sign.\n# Errors:\n# - None.\n# Complexity:\n# - Runtime O(1), space O(1).\ndef magnitude(value: int) -> int:\n    return abs(value)\n"
    input = package.lint_source("api.sev", text)
    package.lint_declarations(input, true, [])
    findings: list[package.LintDiagnostic] = []
    package.lint_documentation(input, [], findings)
    assert(occurrences(findings, "L0011") == 0)
    changed = package.lint_source("api.sev", text.replace("def magnitude(value:", "def magnitude(number:"))
    package.lint_declarations(changed, true, [])
    package.lint_documentation(changed, [], findings)
    assert(occurrences(findings, "L0011") == 1)
    assert(findings[0].line == 10)

test "runtime records attribute actual regions to individual tests":
    map = "{regions:{'123':{kind:'Statement',span:{file:'/tmp/main.sev',start:{line:2,column:5}}}},tests:{'7':'production result'}}"
    run = package.CoverageRun()
    package.coverage_collect(run, map, "B:7\nH:123\nA:2\nM:32\nL:0\nE:7\n")
    assert(run.tests == 1)
    assert(run.allocations == 2 and run.allocated_bytes == 32)
    measured = package.coverage_metric(run, "Statement")
    assert(measured.covered == 1 and measured.total == 1)
    assert(len(run.failures) == 0)
    empty = package.CoverageRun()
    package.coverage_collect(empty, map, "B:7\nE:7\n")
    assert(len(empty.failures) == 1)
    assert(empty.failures[0].contains("no production coverage"))

test "test bodies do not make production cycles reachable":
    input = package.lint_source("main.sev", "def dead(value: int):\n    other(value)\ndef other(value: int):\n    dead(value)\ndef main():\n    print(1)\ntest \"cycle\":\n    dead(1)\n")
    package.lint_declarations(input, false, [])
    assert("dead" in package.lint_reachable([input]))
    assert("dead" not in package.lint_reachable([input], false))
    assert("other" not in package.lint_reachable([input], false))


test "typed documentation invalidates stale contracts":
    original = "# Doubles a number.\n# Parameters:\n# - value [int]: Number to double.\n# Returns [int]:\n# - Doubled number.\n# Errors [None]:\n# - None.\n# Complexity:\n# - Runtime O(1), space O(1).\ndef doubled(value: int) -> int:\n    return value * 2\n"
    input = package.lint_source("lib.sev", original)
    package.lint_declarations(input, true, [])
    findings: list[package.LintDiagnostic] = []
    package.lint_documentation(input, [], findings)
    assert(len(findings) == 0)
    stale = package.lint_source("lib.sev", original.replace("value: int", "value: float"))
    package.lint_declarations(stale, true, [])
    package.lint_documentation(stale, [], findings)
    assert(len(findings) == 1)
    assert(findings[0].rule == "L0011")


test "duplicate callable index compares normalized production bodies":
    input = package.lint_source("api.sev", "def doubled(value: int) -> int:\n    result = value + value + value + value\n    return result * 2\ndef repeated(number: int) -> int:\n    result = number + number + number + number\n    return result * 2\n")
    package.lint_declarations(input, true, [])
    findings: list[package.LintDiagnostic] = []
    package.lint_duplicates([input], [], findings)
    assert(len(findings) == 1)
    assert(findings[0].rule == "L0013")
    assert(findings[0].line == 4)


test "a constant assertion cannot validate an exercised callable":
    input = package.lint_source("api.sev", "def doubled(value: int) -> int:\n    return value * 2\ntest \"placeholder assertion\":\n    doubled(3)\n    assert(true)\n")
    package.lint_declarations(input, true, [])
    findings: list[package.LintDiagnostic] = []
    package.lint_tests(input, [input], [], findings)
    assert(len(findings) == 1)
    assert(findings[0].rule == "L0009")
