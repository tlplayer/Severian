import * from "../../../../library/system/file/src/text.sev" as file

test with profile "small source reads have bounded interop overhead" with
{
    defer time < 1s,
    defer memory < 16MB,
    defer allocations < 50000,
}:
    path = file.temporary()
    contents = "helloλ😀\n"
    assert(file.write(path, contents) == 0)
    for index in range(128):
        loaded = file.read_checked(path)
        assert(loaded.error == 0)
        assert(loaded.contents == contents)
    assert(file.remove(path) == 0)

test "text reads distinguish empty files from failures":
    path = file.temporary()
    empty = file.read_checked(path)
    assert(empty.error == 0)
    assert(empty.contents == "")
    assert(file.write(path, "aλ😀z\n") == 0)
    loaded = file.read_checked(path)
    assert(loaded.error == 0)
    assert(loaded.contents == "aλ😀z\n")
    assert(file.remove(path) == 0)
    result = file.read_checked(path)
    assert(result.error != 0)
