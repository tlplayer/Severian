+
+fn resolve_config(
+    catalog: &Catalog,
+    manifest: Option<&Manifest>,
+    options: &CommonOptions,
+) -> Result<ResolvedConfig, String> {
+    let mut profile = catalog.default("build.profile")?;
+    let mut backend = catalog.default("build.backend")?;
+    let mut target = catalog.default("build.target")?;
+    let mut origins = vec![
+        ("build.profile", "central default"),
+        ("build.backend", "central default"),
+        ("build.target", "central default"),
+    ];
+    if let Some(manifest) = manifest {
+        if let Some(value) = manifest.values.get("build.profile") {
+            catalog.validate("build.profile", value)?;
+            profile = value.clone();
+            origins[0].1 = "package.toml";
+        }
+        if let Some(value) = manifest.values.get("build.backend") {
+            catalog.validate("build.backend", value)?;
+            backend = value.clone();
+            origins[1].1 = "package.toml";
+        }
+        if let Some(value) = manifest.values.get("build.target") {
+            catalog.validate("build.target", value)?;
+            target = value.clone();
+            origins[2].1 = "package.toml";
+        }
+    }
+    if let Some(value) = &options.profile {
+        catalog.validate("build.profile", value)?;
+        profile = value.clone();
+        origins[0].1 = "command line";
+    }
+    if let Some(value) = &options.backend {
+        catalog.validate("build.backend", value)?;
+        backend = value.clone();
+        origins[1].1 = "command line";
+    }
+    if let Some(value) = &options.target {
+        catalog.validate("build.target", value)?;
+        target = value.clone();
+        origins[2].1 = "command line";
+    }
+    Ok(ResolvedConfig {
+        profile,
+        backend,
+        target,
+        origins,
+    })
+}
