import model
from model import neuralnet as nn
from platform import monotonicNs

def main():
    tokens = model.tensor([0.2, -0.4, 0.7, 0.1, -0.3, 0.8], [3, 2])
    identity = model.tensor([1.0, 0.0, 0.0, 1.0], [2, 2])
    attention = nn.MultiheadAttention(identity, identity, identity, identity, 0.7071067811865476)
    linear1 = nn.Linear(model.tensor([0.5, -0.25, 0.75, 0.1, -0.4, 0.6, 0.2, 0.3], [2, 4]), model.tensor([0.01, -0.02, 0.03, 0.04], [4]))
    linear2 = nn.Linear(model.tensor([0.4, -0.2, 0.1, 0.5, -0.3, 0.7, 0.6, 0.2], [4, 2]), model.tensor([0.0, 0.0], [2]))
    encoder = nn.TransformerEncoderLayer(attention, linear1, linear2, nn.LayerNorm(), nn.LayerNorm())

    output := encoder.forward(tokens)
    for warmup in range(0, 20):
        output = encoder.forward(tokens)

    started = monotonicNs()
    for iteration in range(0, 500):
        output = encoder.forward(tokens)
    elapsed = monotonicNs() - started

    values = model.values(output)
    print(elapsed)
    print(values[0] + values[1] + values[2] + values[3] + values[4] + values[5])
    print(model.shape(output))
