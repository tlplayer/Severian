import model

def build_input(count: int) -> list[float]:
    x := []
    for index in range(0, count):
        x.append(float(index % 17 - 8))
    return x

def sum_values(values: list[float]) -> float:
    total := 0.0
    for value in values:
        total += value
    return total

@model(Relu, FastTanh, Swish)
def forward(x: list[float]) -> list[float]:
    active = Relu(x)
    curved = FastTanh(active)
    return Swish(curved)

def main():
    x = build_input(262144)
    output = forward(x)
    print(size(output))
    print(sum_values(output))
