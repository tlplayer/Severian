import * from "../src/lib.sev" as package

test "native provider discovery ignores workspace-only ancestors":
    root = package.temporary("/tmp", "sev-native-workspace-")
    package.write_text(root + "/package.toml", "[workspace]\nmembers = []\n[build]\npipeline = [\"compile\"]\n")
    package.write_text(root + "/main.sev", "def main():\n    pass\n")
    arguments = package.native_arguments(package.Resolution([], [], ""), [root + "/main.sev"])
    assert(len(arguments) == 0)
    package.write_text(root + "/package.toml", "[package]\nname = \"invalid\"\n[workspace]\nmembers = []\n[build]\npipeline = [\"compile\"]\n")
    invalid ?= package.native_arguments(package.Resolution([], [], ""), [root + "/main.sev"])
    assert(invalid is Error)
    package.remove_tree(root)

test "build provenance captures source archives and validates C symbols":
    root = package.temporary("/tmp", "sev-build-info-")
    output = package.native_build_info(root, "probe_build_info")
    contents = package.read_text(output)
    assert(contents.contains("const char *probe_build_info(void)"))
    assert(contents.contains("source: " + root))
    assert(contents.contains("unknown (source archive)"))
    assert(contents.contains("built: "))
    invalid ?= package.native_build_info(root, "bad;symbol")
    assert(invalid is Error)
    package.remove_tree(root)
