import file
import string
from collections import list
import os
import path
import process

def link_digest(location: string) -> string | Error:
    result = process.execute(["sha256sum", "--", location])
    if result.status != 0:
        throw Error("could not hash link input: " + location)
    # GNU sha256sum prefixes a backslash for escaped filenames.
    value = result.stdout
    return "sha256:" + (value[1:65] if link_starts(value, "\\") else value[:64])

def link_quote(value: string) -> string:
    result = "\""
    index = 0
    while index < len(value):
        item = value[index:index + 1]
        code = int(value[index])
        if item == "\"" or item == "\\":
            result = result + "\\" + item
        elif code < 32:
            result = result + "\\u00" + "0123456789abcdef"[code / 16:code / 16 + 1] + "0123456789abcdef"[code % 16:code % 16 + 1]
        else:
            result = result + item
        index += 1
    return result + "\""

def link_mkdir(location: string) -> absent | Error:
    os.make_directories(location)
    return absent

def link_write(location: string, contents: string) -> absent | Error:
    if file.write.default(location, contents) != len(contents):
        throw Error("could not write link record: " + location)
    return absent


def link_starts(value: string, beginning: string) -> bool:
    return len(value) >= len(beginning) and value[:len(beginning)] == beginning

def link_join(values: list[string]) -> string:
    result = ""
    index = 0
    while index < values.len():
        if index > 0:
            result = result + ","
        result = result + values[index]
        index += 1
    return result
