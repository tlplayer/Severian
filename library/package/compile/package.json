{
  "package": {
    "name": "package.compile",
    "version": "0.1.0",
    "edition": "2026",
    "description": "Package compilation adapters for the current Severian compiler"
  },
  "lib": {
    "path": "src/lib.sev"
  },
  "language": {
    "explicit-imports": true
  },
  "dependencies": {
    "compiler_lexer": {
