import * from "model.sev"
import * from "manifest.sev"
import * from "host.sev"
import os
import path
import process

@c(symbol="__sev_compiler_build_info")
def compiler_build_info() -> string


# Capture provenance while linking, so moving the executable or changing the
# checkout never changes its version report. Missing Git data is explicit.
def native_build_info(root: string, symbol: string) -> string | Error:
    if symbol == "" or symbol[0] in "0123456789":
        throw Error("invalid build-info C symbol")
    for character in symbol.characters():
        if character not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_":
            throw Error("invalid build-info C symbol")
    revision = process.execute(["git", "-C", root, "rev-parse", "HEAD"])
    commit := revision.stdout.strip() if revision.status == 0 else "unknown (source archive)"
    status = process.execute(["git", "-C", root, "status", "--porcelain", "--untracked-files=normal"])
    if status.status == 0 and status.stdout.strip() != "":
        commit += " (local changes)"
    built = capture(["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"])
    report = "built: " + built + "\nsource: " + root + "\ncommit: " + commit
    literal = report.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    output = temporary(root + "/package.pkg/cache/build-info", "run-") + "/build_info.c"
    write_text(output, "const char *" + symbol + "(void) { return \"" + literal + "\"; }\n")
    return output

# Native providers are package assets. Backends consume these arguments and
# do not own a second catalog of system-library implementations.
def native_package(root: string, seen: list[string], arguments: list[string], follow_paths: bool) -> unit | Error:
    root = canonical(root)
    if root in seen:
        return
    seen.append(root)
    text = read_text(root + "/package.toml")
    entries = parse_document(text)
    # Standalone sources can live beneath a workspace rather than a package.
    # A workspace supplies no native provider of its own; its build pipeline
    # settings are not the configuration of every source file below it.
    if text_setting(entries, "package", "name", "") == "":
        for entry in entries:
            if entry.table == "workspace" and entry.key == "members":
                return
    manifest = parse_manifest(text)
    symbol = text_setting(manifest.entries, "xxi.c", "build-info", "")
    if symbol != "":
        arguments.append(native_build_info(root, symbol))
    for entry in manifest.entries:
        if entry.table == "xxi.c" and entry.key == "sources":
            for value in string_array(entry.value):
                location = inside(root, value)
                if location not in arguments:
                    arguments.append(location)
    if follow_paths:
        for dependency in manifest.dependencies:
            if not dependency.development and dependency.reference.source == "path":
                native_package(root + "/" + dependency.reference.location, seen, arguments, true)

def native_arguments(resolution: Resolution, sources: list[string]) -> list[string] | Error:
    seen: list[string] = []
    arguments: list[string] = []
    for package in resolution.packages:
        native_package(package.root, seen, arguments, false)
    for source in sources:
        directory := path.dirname(canonical(source))
        while directory != "/" and not os.is_file(directory + "/package.toml"):
            directory = path.dirname(directory)
        if os.is_file(directory + "/package.toml"):
            native_package(directory, seen, arguments, len(resolution.packages) == 0)
    return arguments
