import * from "model.sev"
import * from "host.sev"
import * from "manifest.sev"
import * from "lint_policy.sev"
import lexer
import source
import process

class LintDiagnostic:
    rule: string
    file: string
    line: int
    column: int
    end_line: int
    end_column: int
    level: string
    message: string
    measured: int
    threshold: int
    remediation: string

class LintCallable:
    name: string
    start: int
    body: int
    end: int
    parameters: list[int]
    root: bool
    method: bool

class LintSuppression:
    rule: string
    line: int

class LintSource:
    path: string
    text: string
    tokens: list[lexer.Token]
    lines: list[int]
    columns: list[int]
    depths: list[int]
    callables: list[LintCallable]
    suppressions: list[LintSuppression] = []

# Metrics consume classified lexer tokens: comments and string contents cannot
# create declarations or uses. Offsets are Unicode character offsets, like Span.
def lint_source(location: string, text: string) -> LintSource | Error:
    input = source.SourceFile(source.SourceId(0), location, text)
    tokens = lexer.scan_bootstrap(input)
    lines: list[int] = []
    columns: list[int] = []
    depths: list[int] = []
    line := 1
    column := 1
    cursor := 0
    depth := 0
    for token in tokens:
        while cursor < int(token.span.start):
            if input.characters[cursor] == "\n":
                line += 1
                column = 1
            else:
                column += 1
            cursor += 1
        if token.kind == lexer.TokenKind.Dedent:
            depth -= 1
        lines.append(line)
        columns.append(column)
        depths.append(depth)
        if token.kind == lexer.TokenKind.Indent:
            depth += 1
    result = LintSource(location, text, tokens, lines, columns, depths, [])
    lint_suppressions(result)
    return result

def lint_block_end(input: LintSource, start: int) -> int:
    header := start
    while header < int(len(input.tokens)) and input.tokens[header].kind != lexer.TokenKind.Newline:
        header += 1
    following := header + 1
    while following < int(len(input.tokens)) and input.tokens[following].kind == lexer.TokenKind.Newline:
        following += 1
    if following >= int(len(input.tokens)) or input.tokens[following].kind != lexer.TokenKind.Indent:
        return min(header + 1, int(len(input.tokens)) - 1)
    cursor := start
    entered := false
    while cursor < int(len(input.tokens)):
        if input.depths[cursor] > input.depths[start]:
            entered = true
        if entered and input.depths[cursor] <= input.depths[start]:
            return cursor
        cursor += 1
    return cursor - 1

def lint_declarations(input: LintSource, library: bool, exports: list[string]):
    for index in range(int(len(input.tokens)) - 1):
        token = input.tokens[index]
        if token.kind != lexer.TokenKind.Identifier or string(token) != "def":
            continue
        name = string(input.tokens[index + 1])
        cursor := index + 2
        while cursor < int(len(input.tokens)) and string(input.tokens[cursor]) != "(" and input.tokens[cursor].kind != lexer.TokenKind.Newline:
            cursor += 1
        parameters: list[int] = []
        nested := 0
        expecting := true
        cursor += 1
        while cursor < int(len(input.tokens)):
            spelling = string(input.tokens[cursor])
            if spelling == ")" and nested == 0:
                break
            if expecting and nested == 0 and input.tokens[cursor].kind == lexer.TokenKind.Identifier:
                if spelling != "self":
                    parameters.append(cursor)
                expecting = false
            if spelling in ["(", "[", "{"]:
                nested += 1
            elif spelling in [")", "]", "}"]:
                nested -= 1
            elif spelling == "," and nested == 0:
                expecting = true
            cursor += 1
        while cursor < int(len(input.tokens)) and input.tokens[cursor].kind != lexer.TokenKind.Newline:
            cursor += 1
        method = input.depths[index] > 0
        decorated := false
        previous = input.lines[index] - 2
        source_lines = input.text.split("\n")
        if previous >= 0:
            decorated = source_lines[previous].strip().starts_with("@")
        root = name == "main" or name in exports or method or decorated or (library and not name.starts_with("_"))
        input.callables.append(LintCallable(name, index, cursor, lint_block_end(input, index), parameters, root, method))

# Suppressions are explicit file directives or next-line directives. They never
# rewrite source. Unknown IDs are configuration errors, including disabled rules.
def lint_suppressions(input: LintSource) -> unit | Error:
    offset := 0
    lines = input.text.split("\n")
    for index in range(int(len(lines))):
        raw = lines[index]
        text := raw.strip()
        if text.starts_with("# sev-lint"):
            for token in input.tokens:
                if int(token.span.start) <= offset and int(token.span.end) > offset and token.kind in [lexer.TokenKind.String, lexer.TokenKind.FormattedString]:
                    text = ""
            whole = text.starts_with("# sev-lint: allow ")
            next_line = text.starts_with("# sev-lint-next-line: allow ")
            if whole or next_line:
                prefix = "# sev-lint: allow " if whole else "# sev-lint-next-line: allow "
                for raw_rule in text[int(len(prefix)):].split(","):
                    selected = raw_rule.strip()
                    valid := false
                    for candidate in lint_rules():
                        valid = valid or candidate.id == selected
                    if not valid:
                        throw Error(input.path + ":" + string(index + 1) + ": unknown lint suppression " + selected)
                    input.suppressions.append(LintSuppression(selected, 0 if whole else index + 2))
        offset += int(len(raw.characters())) + 1

def lint_suppressed(input: LintSource, line: int, rule: string) -> bool:
    for suppression in input.suppressions:
        if suppression.rule == rule and suppression.line in [0, line]:
            return true
    return false

def lint_measure(input: LintSource, index: int, measured: int, rule_index: int, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    rule = lint_rules()[rule_index]
    level = lint_level(entries, rule)
    limit = int(lint_entry(entries, "lint", rule.option, string(rule.limit)))
    suppressed = lint_suppressed(input, input.lines[index], rule.id)
    if measured <= limit or level == "off" or suppressed:
        return
    token = input.tokens[index]
    end_line := input.lines[index]
    end_column := input.columns[index]
    characters = input.text.characters()
    for offset in range(int(token.span.start), int(token.span.end)):
        if characters[offset] == "\n":
            end_line += 1
            end_column = 1
        else:
            end_column += 1
    output.append(LintDiagnostic(rule.id, input.path, input.lines[index], input.columns[index], end_line, end_column, level, rule.message, measured, limit, rule.remediation))

def lint_read(input: LintSource, index: int) -> bool:
    if input.tokens[index].kind != lexer.TokenKind.Identifier:
        return false
    before = string(input.tokens[index - 1]) if index > 0 else ""
    after = string(input.tokens[index + 1]) if index + 1 < int(len(input.tokens)) else ""
    return before not in [".", "def", "class", "trait", "enum"] and after not in ["=", ":=", "?=", ":"]

def lint_unused(input: LintSource, callable: LintCallable, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    bindings = callable.parameters[:]
    for index in range(callable.body, callable.end):
        if input.tokens[index].kind != lexer.TokenKind.Identifier:
            continue
        before = string(input.tokens[index - 1]) if index > 0 else ""
        after = string(input.tokens[index + 1]) if index + 1 < int(len(input.tokens)) else ""
        if before != "." and string(input.tokens[index]) not in ["else", "try", "finally", "pass", "break", "continue"] and after in ["=", ":=", "?=", ":"]:
            if index > 0 and input.tokens[index - 1].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent]:
                bindings.append(index)
    names: list[string] = []
    for binding in bindings:
        name = string(input.tokens[binding])
        if name.starts_with("_") or name in names:
            continue
        names.append(name)
        used := false
        for index in range(callable.body, callable.end):
            used = used or (string(input.tokens[index]) == name and lint_read(input, index))
        if not used:
            lint_measure(input, binding, 1, 3, entries, output)

def lint_metrics(input: LintSource, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    file_count = int(len(input.text.split("\n"))) - (1 if input.text.ends_with("\n") else 0)
    lint_measure(input, 0, file_count, 0, entries, output)
    for callable in input.callables:
        last := callable.end - 1
        while last > callable.start and input.tokens[last].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent, lexer.TokenKind.Eof]:
            last -= 1
        lint_measure(input, callable.start, input.lines[last] - input.lines[callable.start] + 1, 1, entries, output)
        lint_measure(input, callable.start, int(len(callable.parameters)), 2, entries, output)
        lint_unused(input, callable, entries, output)
        lint_unreachable(input, callable, entries, output)
    for index in range(int(len(input.tokens))):
        if input.tokens[index].kind != lexer.TokenKind.Identifier:
            continue
        spelling = string(input.tokens[index])
        if spelling not in ["class", "match", "if"]:
            continue
        if index > 0 and input.tokens[index - 1].kind not in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent]:
            continue
        end = lint_block_end(input, index)
        count := 0
        if spelling == "class":
            for callable in input.callables:
                if callable.start > index and callable.start < end and input.depths[callable.start] == input.depths[index] + 1:
                    count += 1
            lint_measure(input, index, count, 5, entries, output)
        elif spelling == "match":
            for child in range(index + 1, end):
                if string(input.tokens[child]) == "case" and input.tokens[child].kind == lexer.TokenKind.Identifier and input.depths[child] == input.depths[index] + 1:
                    count += 1
            lint_measure(input, index, count, 6, entries, output)
        else:
            count = 1
            cursor := end
            while cursor < int(len(input.tokens)):
                if input.tokens[cursor].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Dedent]:
                    cursor += 1
                elif input.depths[cursor] == input.depths[index] and string(input.tokens[cursor]) == "elif":
                    count += 1
                    cursor = lint_block_end(input, cursor)
                else:
                    break
            lint_measure(input, index, count, 7, entries, output)

# Name matching is intentionally conservative for overloads, callbacks and
# dynamic dispatch: all candidates of a referenced name remain live.
def lint_reachable(inputs: list[LintSource]) -> list[string]:
    live: list[string] = []
    for input in inputs:
        for callable in input.callables:
            if callable.root and callable.name not in live:
                live.append(callable.name)
    changed := true
    while changed:
        changed = false
        for input in inputs:
            for index in range(int(len(input.tokens))):
                member = index > 0 and string(input.tokens[index - 1]) == "."
                if not lint_read(input, index) and not (member and input.tokens[index].kind == lexer.TokenKind.Identifier):
                    continue
                active := true
                for callable in input.callables:
                    if index >= callable.start and index < callable.end:
                        active = callable.name in live and index >= callable.body
                if active:
                    name = string(input.tokens[index])
                    if name not in live:
                        live.append(name)
                        changed = true
    return live

def lint(project: Project, force: bool = false) -> list[LintDiagnostic] | Error:
    entries = project.manifest.entries
    validate_lint(entries)
    output: list[LintDiagnostic] = []
    if not force and setting(entries, "lint", "enabled", "true") == "false":
        return output
    excluded = string_array(setting(entries, "lint", "exclude", "[]"))
    for value in excluded:
        relative_path(value[:int(len(value)) - 1] if value.ends_with("/") else value)
    exports = string_array(setting(entries, "package", "export", "[]"))
    library := false
    for target in project.manifest.targets:
        library = library or target.kind == "library"
    inputs: list[LintSource] = []
    for location in files(project.root):
        if not location.ends_with(".sev"):
            continue
        relative = location[int(len(project.root)) + 1:]
        skip := false
        for value in excluded:
            skip = skip or relative == value or (value.ends_with("/") and relative.starts_with(value))
        if skip:
            continue
        input = lint_source(relative, read_text(location))
        lint_declarations(input, library, exports)
        lint_metrics(input, entries, output)
        inputs.append(input)
    for input in inputs:
        lint_top_level(input, library, entries, output, inputs)
    live = lint_reachable(inputs)
    for input in inputs:
        for callable in input.callables:
            if callable.name not in live:
                lint_measure(input, callable.start, 1, 4, entries, output)
    # Sort by numeric source position, then stable rule ID, independently of pass order.
    for i in range(int(len(output))):
        for j in range(i + 1, int(len(output))):
            a = output[i]
            b = output[j]
            if b.file < a.file or (b.file == a.file and (b.line < a.line or (b.line == a.line and (b.column < a.column or (b.column == a.column and b.rule < a.rule))))):
                output[i] = b
                output[j] = a
    return output

def lint_json(diagnostic: LintDiagnostic) -> string:
    d = diagnostic
    return "{\"rule\":" + document_quote(d.rule) + ",\"file\":" + document_quote(d.file) + ",\"line\":" + string(d.line) + ",\"column\":" + string(d.column) + ",\"end_line\":" + string(d.end_line) + ",\"end_column\":" + string(d.end_column) + ",\"severity\":" + document_quote(d.level) + ",\"message\":" + document_quote(d.message) + ",\"measured\":" + string(d.measured) + ",\"threshold\":" + string(d.threshold) + ",\"remediation\":" + document_quote(d.remediation) + "}"

def enforce_lint(project: Project, force: bool = false) -> unit | Error:
    failed := false
    json = text_setting(project.manifest.entries, "diagnostics", "message-format", "text") == "json"
    for d in lint(project, force):
        message = lint_json(d) if json else d.file + ":" + string(d.line) + ":" + string(d.column) + ": " + d.level + "[" + d.rule + "]: " + d.message + " (" + string(d.measured) + " > " + string(d.threshold) + "). " + d.remediation
        process.write_error(message + "\n")
        failed = failed or d.level == "error"
    if failed:
        throw Error("package lint policy failed")

# Only explicit imports and private globals can be proven unused locally.
# Wildcard exports and public library globals stay available to consumers.
def lint_top_level(input: LintSource, library: bool, entries: list[Entry], output: list[LintDiagnostic], peers: list[LintSource] = []) -> unit | Error:
    candidates: list[int] = []
    for index in range(int(len(input.tokens)) - 1):
        if input.depths[index] != 0 or input.tokens[index].kind != lexer.TokenKind.Identifier:
            continue
        spelling = string(input.tokens[index])
        if spelling == "import" and input.tokens[index + 1].kind == lexer.TokenKind.Identifier:
            end := index + 1
            while end < int(len(input.tokens)) and input.tokens[end].kind != lexer.TokenKind.Newline:
                end += 1
            candidate := index + 1
            selective := false
            for cursor in range(index + 1, end):
                if string(input.tokens[cursor]) == "from" or string(input.tokens[cursor]) == ",":
                    selective = true
                if string(input.tokens[cursor]) == "as" and cursor + 1 < end:
                    candidate = cursor + 1
            if not selective:
                candidates.append(candidate)
        elif spelling.starts_with("_") or not library:
            previous = input.tokens[index - 1].kind if index > 0 else lexer.TokenKind.Newline
            if previous in [lexer.TokenKind.Newline, lexer.TokenKind.Dedent] and string(input.tokens[index + 1]) in ["=", ":=", "?=", ":"] and spelling not in ["else", "try", "finally"]:
                candidates.append(index)
    for index in candidates:
        name = string(input.tokens[index])
        if name.starts_with("_"):
            continue
        used := false
        for other in range(int(len(input.tokens))):
            used = used or (other != index and string(input.tokens[other]) == name and lint_read(input, other))
        for peer in peers:
            if peer.path == input.path:
                continue
            for other in range(int(len(peer.tokens))):
                used = used or (string(peer.tokens[other]) == name and lint_read(peer, other))
        if not used:
            lint_measure(input, index, 1, 3, entries, output)


# A terminator makes the remaining statements in its indentation block dead.
# This deliberately does not infer termination across conditions or loops.
def lint_unreachable(input: LintSource, callable: LintCallable, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    dead_depth := -1
    statement_start := true
    for index in range(callable.body, callable.end):
        token = input.tokens[index]
        if token.kind == lexer.TokenKind.Dedent:
            if input.depths[index] <= dead_depth:
                dead_depth = -1
            statement_start = true
        elif token.kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent]:
            statement_start = true
        elif statement_start and token.kind != lexer.TokenKind.Eof:
            if dead_depth >= 0:
                lint_measure(input, index, 1, 4, entries, output)
            elif token.kind == lexer.TokenKind.Identifier and string(token) in ["return", "throw", "break", "continue"]:
                dead_depth = input.depths[index]
            statement_start = false
