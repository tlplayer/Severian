def lint(project: Project, force: bool = false, testing: bool = false) -> list[LintDiagnostic] | Error:
    if not published_project(project.root):
        diagnostic.format_sources(project)
    return diagnostic.lint(project, lint_identity(project, force, testing), force, testing, published_project(project.root))

def lint_identity(project: Project, force: bool, testing: bool) -> string | Error:
    revision := ""
    if setting(project.manifest.entries, "quality", "revision-window", "0") != "0":
        revision = capture(["git", "-C", project.root, "rev-parse", "HEAD"])
    identity = "quality-2\n" + source_checksum(project.root) + "\n" + entries_json(project.manifest.entries) + "\n" + digest(process.executable()) + "\n" + revision + "\n" + string(force) + "\n" + string(testing)
    return identity

def enforce_lint(project: Project, force: bool = false, testing: bool = false) -> unit | Error:
    if not published_project(project.root):
        diagnostic.format_sources(project)
    diagnostic.enforce(project, lint_identity(project, force, testing), force, testing, published_project(project.root))
