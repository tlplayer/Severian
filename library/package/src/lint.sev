import * from "document.sev"
import diagnostic
import * from "model.sev"
import * from "host.sev"
import * from "manifest.sev"
import * from "resolve.sev"
import process
from diagnostic import
{
    LintDiagnostic,
    LintCallable,
    LintSuppression,
    LintTest,
    LintSource,
    lint_source,
    lint_block_end,
    lint_declarations,
    lint_suppressions,
    lint_suppressed,
    lint_measure,
    lint_read,
    lint_unused,
    lint_metrics,
    lint_test_file,
    lint_in_test,
    lint_reachable,
    lint_constant,
    lint_tests,
    lint_uncached,
    lint_json,
    lint_top_level,
    lint_unreachable,
    lint_doc,
    lint_doc_section,
    lint_documented_type,
    lint_signature_type,
    lint_documentation,
    lint_duplicates,
    lint_churn,
}

def lint(project: Project, force: bool = false, testing: bool = false) -> list[LintDiagnostic] | Error:
    if not published_project(project.root):
        diagnostic.format_sources(project)
    revision := ""
    if setting(project.manifest.entries, "quality", "revision-window", "0") != "0":
        revision = capture(["git", "-C", project.root, "rev-parse", "HEAD"])
    identity = "quality-2\n" + source_checksum(project.root) + "\n" + entries_json(project.manifest.entries) + "\n" + digest(process.executable()) + "\n" + revision + "\n" + string(force) + "\n" + string(testing)
    return diagnostic.lint(project, identity, force, testing, published_project(project.root))

def enforce_lint(project: Project, force: bool = false, testing: bool = false) -> unit | Error:
    failed := false
    json = text_setting(project.manifest.entries, "diagnostics", "message-format", "text") == "json"
    for d in lint(project, force, testing):
        message = lint_json(d) if json else d.file + ":" + string(d.line) + ":" + string(d.column) + ": " + d.level + "[" + d.rule + "]: " + d.message + " (" + string(d.measured) + " > " + string(d.threshold) + "). " + d.remediation
        process.write_error(message + "\n")
        failed = failed or d.level == "error" or (testing and d.rule in ["L0004", "L0005", "L0009", "L0010"])
    if failed:
        throw Error("package lint policy failed")
