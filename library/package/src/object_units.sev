import Build, BuildUnit, Check, Clean, Compiler, Entry, Install, Publish, Resolution, Resolve, Run, SemanticPlan, Target, Test, canonical, capture, copy_file, digest, document_quote, exists, files, inside, manifest_file, mkdir, open, parse_document, prelude_exclusions, read_bytes, read_text, reference, semantic_plan, semantic_plan_json, semantic_source_unit, semantic_unit_key, setting, sorted_strings, string_array, temporary, text_setting, toml_quote, unquote, write_bytes, write_text from "semantic_dependencies.sev"


class ObjectUnit:
    key: string
    submodules: list[int]
    entry: bool = false


# The first realization policy is one object per semantic submodule. The model
# permits grouping without changing declaration identity or source membership.
def object_units(plan: SemanticPlan, root: int) -> list[ObjectUnit] | Error:
    if root < 0 or root >= len(plan.units):
        throw Error("object plan has no root semantic submodule")
    result = [ObjectUnit(semantic_unit_key(plan.units[root]), [root], true)]
    index := 0
    for unit in plan.units:
        if index != root:
            result.append(ObjectUnit(semantic_unit_key(unit), [index]))
        index += 1
    return result
