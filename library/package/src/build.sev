import * from "document.sev"
import diagnostic
import * from "stages.sev"
import dependency
import * from "dependency.sev"
import * from "lint.sev"
from diagnostic import
{
    coverage_sources,
    CoverageRegion,
    CoverageTest,
    coverage_map,
    CoverageRun,
    coverage_collect,
    CoverageMetric,
    coverage_metric,
    coverage_finish,
}
import * from "compiler.sev"
import * from "host.sev"
import * from "model.sev"
import * from "manifest.sev"
import * from "resolve.sev"
import * from "archive.sev"
import os
import path
import process
import file

def output_root(project: Project, platform: string, profile: string) -> string | Error:
    return build_root() + "/bin"

def test_output_root(project: Project, platform: string, profile: string) -> string | Error:
    return build_root() + "/debug/test/" + safe_name(platform) + "/" + safe_name(profile)

def plan(project: Project, request: Build, mode: string = "build") -> BuildPlan | Error:
    mutable_project(project.root)
    diagnostic.format_sources(project)
    resolution = resolve(project, Resolve("test" if mode == "test" else "build", request.locked, ""))
    if not request.locked and project.lock_text != resolution.lock:
        lock = file.native_lock(project.root + "/.sev-edit.lock")
        if lock < 0:
            throw Error("could not lock package resolution")
        try:
            destination = project_lock_file(project.root)
            current = read_text(destination) if os.is_file(destination) else ""
            if current != project.lock_text or read_text(manifest_file(project.root)) != project.manifest_text:
                throw Error("package changed while resolving; retry the build")
            staged = project.root + "/.sev-build.lock.new"
            write_text(staged, resolution.lock)
            replace_file(staged, destination)
            file.unlock(lock)
        catch error: Error:
            file.unlock(lock)
            throw Error(error.message)
    platform = request.platform if request.platform != "" else text_setting(project.manifest.entries, "build", "target", "host")
    profile = request.profile if request.profile != "" else text_setting(project.manifest.entries, "build", "profile", "dev")
    root = output_root(project, platform, profile)
    units: list[BuildUnit] = []
    # A dependency unit produces a linkable archive and an explicit interface.
    ordered = dependency.build_order(dependency_graph(resolution), [0])
    for index in ordered:
        if index == 0:
            continue
        dependency = resolution.packages[index]
        target = library_target(dependency.manifest)
        units.append(BuildUnit(index, target, platform, profile, "", false))
    selected := request.target
    if mode == "run" and selected == "":
        selected = project.manifest.default_run
    found := false
    for target in project.manifest.targets:
        if selected != "" and target.name != selected:
            continue
        if mode == "run" and target.kind != "binary":
            continue
        destination := root + "/" + target.name if target.kind == "binary" else ""
        if mode == "test":
            destination = test_output_root(project, platform, profile) + "/bin/" + target.name
        elif request.emit != "":
            destination = build_root() + "/cache/emit/" + target.name + (".json" if request.emit == "agent-ir" else "." + request.emit)
        if request.output != "":
            destination = request.output
        units.append(BuildUnit(0, target, platform, profile, destination, mode == "test"))
        found = true
    if not found:
        throw Error("no matching declared target: " + selected)
    root_count := 0
    for unit in units:
        if unit.package_index == 0:
            root_count += 1
    if (request.output != "" or mode == "run") and root_count != 1:
        throw Error("operation requires exactly one declared target; select it by name")
    if mode == "test" and os.is_dir(project.root + "/tests"):
        for location in files(project.root + "/tests"):
            if location.ends_with(".sev"):
                relative = location[int(len(project.root)) + 1:]
                units.append(BuildUnit(0, Target(relative, "test", relative), platform, profile, test_output_root(project, platform, profile) + "/bin/" + relative.replace("/", "_").replace(".sev", ""), true))
    return BuildPlan(project, resolution, units, mode, request.emit, request.lint)

# The compilation-unit protocol is the only compiler execution boundary.
def execute(plan: BuildPlan, compiler: Compiler) -> BuildResult | Error:
    enforce_lint(plan.project, plan.lint, plan.mode == "test")
    artifacts: list[Artifact] = []
    consumed: list[string] = []
    for unit in plan.units:
        if unit.package_index != 0:
            dependency = plan.resolution.packages[unit.package_index]
            # Source-only contracts are checked with their consumer. Building a
            # source listing here previously repeated the full semantic pass.
            if setting(dependency.manifest.entries, "package", "export", "[]") == "[]":
                continue
            artifact = installed_realization(dependency, unit, compiler) if published_project(dependency.root) else compile_unit(compiler, unit, plan.resolution, "library", guard_tests=plan.mode == "test")
            if artifact.interface_path != "":
                dependency.interface_path = artifact.interface_path
                dependency.archive_path = artifact.path
                dependency.build_id = artifact.build_id
                plan.resolution.packages[unit.package_index] = dependency
        elif plan.mode == "check" and plan.emit == "":
            compile_unit(compiler, unit, plan.resolution, "check", guard_tests=plan.mode == "test")
        elif unit.target.kind == "library" and not unit.include_tests and plan.emit == "":
            artifacts.append(compile_unit(compiler, unit, plan.resolution, "library"))
        else:
            mkdir(path.dirname(unit.output))
            artifacts.append(compile_unit(compiler, unit, plan.resolution, plan.emit))
    report_resolution = unit_resolution(plan.resolution, 0)
    for artifact in artifacts:
        location = artifact.package_root + "/build/" + artifact.build_id + "/inputs"
        if artifact.build_id != "" and os.is_file(location):
            for entry in parse_document(read_text(location)):
                if unquote(entry.value) == "missing":
                    continue
                source = relocated_path(entry.key, report_resolution, plan.project.root, compiler.sysroot)
                if source not in consumed:
                    consumed.append(source)
    if len(consumed) > 0:
        diagnostic.report_contributions(plan.project.root, consumed, build_root() + "/debug/quality", plan.mode == "test")
    return BuildResult(plan, artifacts)

def build(project: Project, compiler: Compiler, request: Build) -> BuildResult | Error:
    return execute(plan(project, request), compiler)

def check(project: Project, compiler: Compiler, request: Check) -> BuildResult | Error:
    return execute(plan(project, Build(request.target, request.platform, request.profile, request.emit, request.output, request.locked), "check"), compiler)

def test(project: Project, compiler: Compiler, request: Test) -> TestReport | Error:
    planned = plan(project, Build("", request.platform, request.profile, request.emit, request.output, request.locked), "test")
    # Each invocation owns its executables, including simultaneous test runs.
    stage = temporary(test_output_root(project, planned.units[-1].platform, planned.units[-1].profile), "run-")
    for index in range(int(len(planned.units))):
        unit := planned.units[index]
        if unit.package_index == 0:
            unit.output = stage + "/bin/test-" + string(index)
            planned.units[index] = unit
    result = execute(planned, compiler)
    memory = process.memory_budget(text_setting(project.manifest.entries, "test", "memory-max", "4GB"))
    seconds = int(setting(project.manifest.entries, "test", "timeout-seconds", "60"))
    tests: list[TestResult] = []
    coverage = CoverageRun()
    covered = setting(project.manifest.entries, "test", "coverage", "true") != "false" and request.emit == ""
    reports = temporary(build_root() + "/debug/coverage", "run-")
    failed := 0
    for artifact in result.artifacts:
        if request.filter != "" and not artifact.target.name.contains(request.filter):
            continue
        if request.emit != "":
            continue
        arguments := [artifact.path]
        hits = reports + "/" + string(len(tests)) + ".records"
        if covered:
            arguments = ["env", "SEV_COVERAGE_FILE=" + hits, artifact.path]
        status = command(process.guarded_command(arguments, seconds, memory))
        if covered:
            if not os.is_file(artifact.path + ".coverage.json"):
                throw Error("compiler omitted the coverage map for " + artifact.target.name)
            coverage_collect(coverage, read_text(artifact.path + ".coverage.json"), read_text(hits) if os.is_file(hits) else "")
        tests.append(TestResult(artifact.target.name, status))
        if status != 0:
            failed += 1
    if covered:
        failed += coverage_finish(project, coverage, reports)
        process.write_error("quality report: " + reports + "/summary.json\n")
    return TestReport(tests, failed)

def run(project: Project, compiler: Compiler, request: Run) -> int | Error:
    result = execute(plan(project, Build(request.target, request.platform, request.profile, "", "", request.locked), "run"), compiler)
    artifact: Artifact = result.artifacts[0]
    arguments: list[string] = [artifact.path]
    for argument in request.arguments:
        arguments.append(argument)
    return command(arguments)

def clean(project: Project, request: Clean) -> unit | Error:
    mutable_project(project.root)
    destination := build_root()
    if request.profile != "" and request.platform == "":
        throw Error("clean profile requires a platform")
    if request.platform != "":
        destination += "/artifacts/" + safe_name(request.platform)
    if request.profile != "":
        destination += "/" + safe_name(request.profile)
    if os.exists(destination):
        resolved = canonical(destination)
        if resolved != build_root() and not resolved.starts_with(build_root() + "/"):
            throw Error("artifact directory escapes project root")
        remove_tree(destination)

def metadata(project: Project) -> Resolution | Error:
    return resolve(project)

def tree(resolution: Resolution) -> string:
    lines: list[string] = []
    for edge in resolution.edges:
        parent = resolution.packages[edge.parent].identity
        child = resolution.packages[edge.child].identity
        lines.append(parent.name + "@" + parent.version + " -> " + edge.alias + " = " + child.name + "@" + child.version)
    return sorted_strings(lines).join("\n")

def plan(project: Project) -> BuildPlan | Error:
    return plan(project, Build())

def build(project: Project, compiler: Compiler) -> BuildResult | Error:
    return build(project, compiler, Build())

def check(project: Project, compiler: Compiler) -> BuildResult | Error:
    return check(project, compiler, Check())

def test(project: Project, compiler: Compiler) -> TestReport | Error:
    return test(project, compiler, Test())

def run(project: Project, compiler: Compiler) -> int | Error:
    return run(project, compiler, Run())

def clean(project: Project) -> unit | Error:
    return clean(project, Clean())
