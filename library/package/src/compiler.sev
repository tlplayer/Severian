import * from "model.sev"
import * from "host.sev"
import * from "manifest.sev"
import * from "edit.sev"
import * from "reuse.sev"
import * from "realization.sev"
import * from "generators.sev"
import path
import os
import environment
import process
import file


# Package sessions own the lifetime of shared provider state. A worker may
# mutate its snapshot, while the parent retains the original for the next unit.
def fork_compilation_unit() -> int | Error:
    child = process.fork_snapshot()
    if child < 0:
        throw Error("could not create an isolated compilation worker")
    return child


def wait_compilation_unit(child: int) -> int | Error:
    status = process.wait(child)
    if status < 0:
        throw Error("could not wait for a compilation worker")
    return status

# A versioned compilation-unit protocol keeps package orchestration independent
# of the concrete compiler and does not recursively invoke package commands.
def encode_resolution(resolution: Resolution) -> string:
    text := "format = 1\n"
    for resolved in resolution.packages:
        text += "\n[[package]]\nname = " + toml_quote(resolved.identity.name) + "\nversion = " + toml_quote(resolved.identity.version) + "\nsource = " + toml_quote(resolved.identity.source) + "\nroot = " + toml_quote(resolved.root) + "\nchecksum = " + toml_quote(resolved.checksum) + "\nmanifest = " + toml_quote(render_manifest(resolved.manifest.entries)) + "\n"
        text += "interface = " + toml_quote(resolved.interface_path) + "\narchive = " + toml_quote(resolved.archive_path) + "\nbuild-id = " + toml_quote(resolved.build_id) + "\n"
    for edge in resolution.edges:
        text += "\n[[edge]]\nparent = " + string(edge.parent) + "\nchild = " + string(edge.child) + "\nalias = " + toml_quote(edge.alias) + "\ndevelopment = " + ("true" if edge.development else "false") + "\n"
    return entries_json(parse_document(text))

def decode_resolution(text: string) -> Resolution | Error:
    entries = parse_document(text)
    if setting(entries, "", "format") != "1":
        throw Error("unsupported compilation graph format")
    packages: list[ResolvedPackage] = []
    edges: list[DependencyEdge] = []
    seen: list[string] = []
    for entry in entries:
        table = entry.table
        if table in seen:
            continue
        seen.append(table)
        if table.starts_with("package."):
            identity = PackageIdentity(text_setting(entries, table, "name"), text_setting(entries, table, "version"), text_setting(entries, table, "source"))
            packages.append(ResolvedPackage(identity, text_setting(entries, table, "root"), parse_manifest(text_setting(entries, table, "manifest")), text_setting(entries, table, "checksum"), text_setting(entries, table, "interface", ""), text_setting(entries, table, "archive", ""), text_setting(entries, table, "build-id", "")))
        elif table.starts_with("edge."):
            edges.append(DependencyEdge(int(setting(entries, table, "parent")), int(setting(entries, table, "child")), text_setting(entries, table, "alias"), setting(entries, table, "development") == "true"))
    for edge in edges:
        if edge.parent < 0 or edge.child < 0 or edge.parent >= int(len(packages)) or edge.child >= int(len(packages)):
            throw Error("compilation graph edge has an invalid package identity")
    return Resolution(packages, edges, "")

# Re-root a unit's graph so its identity is independent of consumers and of
# their package indices. Only the transitive dependencies of this unit matter.
def unit_packages(resolution: Resolution, index: int, indices: list[int]) -> unit:
    if index in indices:
        return
    indices.append(index)
    aliases: list[string] = []
    for edge in resolution.edges:
        if edge.parent == index:
            aliases.append(edge.alias)
    for alias in sorted_strings(aliases):
        for edge in resolution.edges:
            if edge.parent == index and edge.alias == alias:
                unit_packages(resolution, edge.child, indices)


def unit_resolution(resolution: Resolution, index: int) -> Resolution:
    indices: list[int] = []
    unit_packages(resolution, index, indices)
    packages: list[ResolvedPackage] = []
    edges: list[DependencyEdge] = []
    for original in indices:
        resolved = resolution.packages[original]
        identity = resolved.identity
        # A checkout has the same identity when built directly or as a path dep.
        packages.append(ResolvedPackage(PackageIdentity(identity.name, identity.version, "path:" + resolved.root if identity.source == "root" else identity.source), resolved.root, resolved.manifest, resolved.checksum, resolved.interface_path, resolved.archive_path, resolved.build_id))
    for parent in range(int(len(indices))):
        for child in range(int(len(indices))):
            for edge in resolution.edges:
                if edge.parent == indices[parent] and edge.child == indices[child]:
                    edges.append(DependencyEdge(parent, child, edge.alias, edge.development))
    return Resolution(packages, edges, "")


def cached_inputs_match(location: string) -> bool:
    try:
        if not os.is_file(location):
            return false
        entries = parse_document(read_text(location))
        if len(entries) == 0:
            return false
        for entry in entries:
            expected = unquote(entry.value)
            if expected == "missing":
                if os.exists(entry.key):
                    return false
            elif not os.is_file(entry.key) or digest(entry.key) != expected:
                return false
        return true
    catch error: Error:
        # Mutable build state is disposable; a damaged cache requests a build.
        return false


def source_cache_root(input: string) -> string:
    directory := path.dirname(input)
    while directory != "/":
        if os.is_file(manifest_file(directory)):
            return directory
        directory = path.dirname(directory)
    return path.dirname(input)


def unit_cache_root(root: string) -> string | Error:
    if not published_project(root):
        return root + "/package.pkg/build"
    # Published realizations are immutable. Their local compiler state is shared
    # across consumers, outside the verified publication.
    return package_home() + "/packages/cache/" + source_checksum(root).replace(":", "-") + "/package.pkg/build"


def compile_unit(compiler: Compiler, unit: BuildUnit, resolution: Resolution, emit: string, guard_tests: bool = false, source_path: string = "") -> Artifact | Error:
    if unit.output != "":
        mkdir(path.dirname(unit.output))
    stage = temporary("/tmp")
    cache_lock := -1
    result := Artifact(unit.target, unit.platform, unit.profile, emit if emit != "" else "native", unit.output)
    try:
        scoped = unit_resolution(resolution, unit.package_index) if len(resolution.packages) > 0 else resolution
        prepare_generators(scoped)
        graph = encode_resolution(scoped)
        write_document(stage + "/resolution.json", graph)
        input = canonical(source_path) if source_path != "" else inside(scoped.packages[0].root, unit.target.path)
        root = source_cache_root(input) if source_path != "" else scoped.packages[0].root
        sysroot = canonical(compiler.sysroot)
        identity := "unit-cache-5\n" + portable_graph(scoped) + "\n" + digest(compiler.executable) + "\n" + portable_path(input, scoped, root, sysroot) + "\n" + emit + "\n" + unit.platform + "\n" + unit.profile + "\n" + string(unit.include_tests)
        identity += "\n" + registry_discovery_state()
        for tool in [environment.get("SEVERIAN_CLANG", "clang-21"), environment.get("SEVERIAN_MLIR_OPT", "mlir-opt-21"), environment.get("SEVERIAN_MLIR_TRANSLATE", "mlir-translate-21"), environment.get("SEVERIAN_LLVM_OPT", "opt-21"), environment.get("SEVERIAN_AR", "llvm-ar-21")]:
            identity += "\n" + tool + "\n" + capture([tool, "--version"])
        if len(scoped.packages) > 0:
            entries = scoped.packages[0].manifest.entries
            if setting(entries, "xxi.rust", "sources", "[]") != "[]":
                identity += "\n" + capture([environment.get("SEVERIAN_RUSTC", "rustc"), "-vV"])
            if setting(entries, "xxi.c", "targets", "[]") != "[]":
                for tool in [environment.get("SEVERIAN_LLD_LINK", "lld-link-21"), environment.get("SEVERIAN_LD64_LLD", "ld64.lld-21"), environment.get("SEVERIAN_DSYMUTIL", "dsymutil-21")]:
                    identity += "\n" + tool + "\n" + capture([tool, "--version"])
        write_text(stage + "/key", identity)
        build_id = digest(stage + "/key").replace(":", "-")
        cache = unit_cache_root(root) + "/" + build_id
        mkdir(cache)
        cache_lock = file.native_lock(cache + "/lock")
        if cache_lock < 0:
            throw Error("could not lock compilation cache")
        if not os.is_file(cache + "/output") and published_project(root):
            restore_realization(path.dirname(root), cache, build_id, emit)
        incremental := true
        if len(scoped.packages) > 0:
            incremental = setting(scoped.packages[0].manifest.entries, "build", "incremental", "true") != "false"
        reused := false
        if incremental and reusable_inputs(cache + "/inputs", scoped, root, sysroot) and os.is_file(cache + "/output"):
            recorded = read_text(cache + "/output")
            reused = recorded == "check" if emit == "check" else os.is_file(cache + "/artifact") and digest(cache + "/artifact") == recorded
            if reused and emit == "library":
                reused = sidecars_match(cache)
            if reused and unit.include_tests and len(scoped.packages) > 0 and setting(scoped.packages[0].manifest.entries, "test", "coverage", "true") != "false":
                reused = os.is_file(cache + "/artifact.coverage.json") and os.is_file(cache + "/coverage.digest") and digest(cache + "/artifact.coverage.json") == read_text(cache + "/coverage.digest")
        if not reused:
            process.write_error("compiling " + input + "\n")
            # Never let a failed compilation validate a previous artifact.
            if os.is_file(cache + "/output"):
                os.remove(cache + "/output")
            arguments := [compiler.executable, "__compile-unit", input, stage + "/artifact", emit, compiler.sysroot, stage + "/resolution.json", "test" if unit.include_tests else "build", unit.platform, unit.profile]
            memory := 0
            seconds := 0
            if (unit.include_tests or guard_tests) and len(resolution.packages) > 0:
                config = resolution.packages[0].manifest.entries
                memory = process.memory_budget(text_setting(config, "test", "memory-max", "4GB"))
                seconds = int(setting(config, "test", "timeout-seconds", "60"))
                if seconds <= 0:
                    throw Error("test timeout must be positive")
            status := 0
            if process.session_available() and compiler.executable == process.executable():
                encoded: list[string] = []
                for argument in arguments:
                    encoded.append(toml_quote(argument))
                request = stage + "/request.json"
                write_document(request, "arguments = [" + encoded.join(", ") + "]\nseconds = " + string(seconds) + "\nbytes = " + string(memory) + "\n")
                status = process.session_submit(request)
            else:
                if seconds > 0:
                    arguments = process.guarded_command(arguments, seconds, memory)
                status = command(arguments)
            if status != 0:
                diagnostic = stage + "/artifact.diagnostic"
                if os.is_file(diagnostic):
                    throw Error("compilation failed for " + unit.target.name + ":\n" + read_text(diagnostic).strip())
                throw Error("compiler process failed for " + unit.target.name + " (exit status " + string(status) + "); no source diagnostic was produced. Check the compiler/tool output above for a crash, resource limit, or native tool failure.")
            if emit != "check":
                if emit == "sources":
                    paths: list[string] = []
                    for location in read_text(stage + "/artifact").split("\n"):
                        if location != "":
                            paths.append(portable_path(canonical(location), scoped, root, sysroot))
                    write_text(cache + "/artifact", paths.join("\n"))
                else:
                    copy_file(stage + "/artifact", cache + "/artifact")
                if os.is_file(stage + "/artifact.link.json"):
                    copy_file(stage + "/artifact.link.json", cache + "/link.json")
                if os.is_file(stage + "/artifact.coverage.json"):
                    copy_file(stage + "/artifact.coverage.json", cache + "/artifact.coverage.json")
                    write_text(cache + "/coverage.digest", digest(cache + "/artifact.coverage.json"))
                if emit == "library":
                    sidecars: list[string] = []
                    for suffix in library_sidecars():
                        copy_file(stage + "/artifact" + suffix, cache + "/artifact" + suffix)
                        sidecars.append(toml_quote("artifact" + suffix) + " = " + toml_quote(digest(cache + "/artifact" + suffix)))
                    if os.is_dir(stage + "/artifact.providers"):
                        for provider in files(stage + "/artifact.providers", true):
                            copy_file(provider, cache + "/artifact.providers/" + path.basename(provider))
                    write_document(cache + "/sidecars.json", sidecars.join("\n"))
            if cached_inputs_match(stage + "/resolution.json.inputs"):
                portable_inputs(stage + "/resolution.json.inputs", cache + "/inputs", scoped, root, sysroot)
                write_text(cache + "/output", "check" if emit == "check" else digest(cache + "/artifact"))
        if len(scoped.packages) > 0 and emit in ["", "library"]:
            result = retain_realization(scoped, unit, compiler, cache, build_id, emit)
            if unit.output == "":
                unit.output = result.path
        if emit != "check" and unit.output != "":
            if unit.include_tests and os.is_file(cache + "/artifact.coverage.json"):
                copy_file(cache + "/artifact.coverage.json", unit.output + ".coverage.json")
            if not reused or not os.is_file(unit.output) or digest(unit.output) != digest(cache + "/artifact"):
                delivery = temporary(path.dirname(unit.output))
                if emit == "sources":
                    paths: list[string] = []
                    for location in read_text(cache + "/artifact").split("\n"):
                        if location != "":
                            paths.append(relocated_path(location, scoped, root, sysroot))
                    write_text(delivery + "/artifact", paths.join("\n"))
                else:
                    copy_file(cache + "/artifact", delivery + "/artifact")
                if emit == "":
                    require_command(["chmod", "755", "--", delivery + "/artifact"])
                replace_file(delivery + "/artifact", unit.output)
                remove_tree(delivery)
        file.unlock(cache_lock)
        cache_lock = -1
    catch error: Error:
        if cache_lock >= 0:
            file.unlock(cache_lock)
        remove_tree(stage)
        throw Error(error.message)
    remove_tree(stage)
    if result.path == "":
        result.path = unit.output
    return result
