import environment
import file
import path
import process
import os

import time

def process_id() -> int:
    return process.id()

def monotonic() -> float:
    return time.monotonic()

def quote(value: string) -> string:
    return "'" + value.replace("'", "'\"'\"'") + "'"

def command(arguments: list[string]) -> int | Error:
    return process.run(arguments)

def require_command(arguments: list[string]) -> unit | Error:
    if command(arguments) != 0:
        throw Error("host operation failed: " + arguments[0])

def capture(arguments: list[string]) -> string | Error:
    result = process.execute(arguments)
    if result.status != 0:
        throw Error("host operation failed: " + arguments[0] + ": " + result.stderr)
    return result.stdout.strip()

def canonical(value: string) -> string | Error:
    return os.canonical(value)

def exists(value: string) -> bool:
    return os.exists(value)

def mkdir(value: string) -> unit | Error:
    if not os.make_directories(value):
        throw Error("could not create directory " + value)

def write_text(destination: string, contents: string) -> unit | Error:
    mkdir(path.dirname(destination))
    if file.write(destination, contents) != 0:
        throw Error("could not write " + destination)

def read_text(location: string) -> string | Error:
    return file.read_checked(location)

def temporary(parent: string, prefix: string = ".sev-") -> string | Error:
    mkdir(parent)
    return os.temporary(parent, prefix)

def replace_file(source: string, destination: string) -> unit | Error:
    if os.rename(source, destination) != 0:
        throw Error("could not replace " + destination)

def remove_tree(location: string) -> unit | Error:
    os.remove_tree(location)

def copy_file(source: string, destination: string) -> unit | Error:
    mkdir(path.dirname(destination))
    if not os.copy(source, destination):
        throw Error("could not copy " + source)

def sorted_strings(values: list[string]) -> list[string]:
    result: list[string] = []
    for value in values:
        result.append(value)
    for i in range(int(len(result))):
        for j in range(i + 1, int(len(result))):
            if result[j] < result[i]:
                previous = result[i]
                result[i] = result[j]
                result[j] = previous
    return result

def collect_files(root: string, directory: string, result: list[string], nested_packages: bool) -> unit | Error:
    for name in os.list(directory):
        if name == "package.pkg" or name == ".git" or name.starts_with(".sev-"):
            continue
        location = directory + "/" + name
        if os.is_symlink(location):
            throw Error("package content may not contain symlinks: " + location)
        if os.is_dir(location):
            # Nested manifests introduce separate packages, not source folders.
            if nested_packages or not os.is_file(location + "/package.toml"):
                collect_files(root, location, result, nested_packages)
        elif os.is_file(location):
            result.append(location)
        else:
            throw Error("package content must be a regular file: " + location)

def files(root: string, nested_packages: bool = false) -> list[string] | Error:
    result: list[string] = []
    collect_files(root, root, result, nested_packages)
    return sorted_strings(result)

def digest(location: string) -> string | Error:
    return "sha256:" + capture(["sha256sum", "--", location]).split(" ")[0]

def read_bytes(location: string) -> list[u8] | Error:
    if not os.is_file(location):
        throw Error("could not read " + location)
    return file.map(location)

def write_bytes(location: string, contents: list[u8]) -> unit | Error:
    mkdir(path.dirname(location))
    if file.write(location, contents) != 0:
        throw Error("could not write " + location)

def project_lock_file(root: string) -> string:
    if os.is_file(root + "/package.lock"):
        return root + "/package.lock"
    if os.is_file(root + "/sev.lock"):
        return root + "/sev.lock"
    return root + "/package.lock"

def recover_edit(root: string) -> unit | Error:
    stage = root + "/.sev-transaction"
    if not os.is_file(stage + "/ready"):
        return
    copy_file(stage + "/manifest.old", root + "/package.toml")
    previous = read_text(stage + "/lock.old")
    lock_name = read_text(stage + "/lock.name") if os.is_file(stage + "/lock.name") else "sev.lock"
    if lock_name not in ["package.lock", "sev.lock"]:
        throw Error("invalid package transaction lock name")
    lock_path = root + "/" + lock_name
    if previous == "":
        if os.is_file(lock_path):
            os.remove(lock_path)
    else:
        write_text(lock_path, previous)
    remove_tree(stage)

# Published project reads need no recovery lock or writable build directory.
def published_project(root: string) -> bool:
    directory := canonical(root)
    while directory != "/":
        if os.is_file(directory + "/metadata/publication.toml"):
            return true
        directory = path.dirname(directory)
    return false

def mutable_project(root: string) -> unit | Error:
    if published_project(root):
        throw Error("published packages are immutable: " + root)
