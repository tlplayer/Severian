import file

def select(root: string, requirements: Requirements) -> Selection | Error:
    manifest = parse_manifest(read_text(manifest_file(root + "/metadata")))
    selected := requirements.target
    if selected == "":
        selected = manifest.default_run
    if selected == "":
        for target in manifest.targets:
            if target.kind == "binary":
                selected = target.name
    declared := false
    for target in manifest.targets:
        declared = declared or (target.kind == "binary" and target.name == selected)
    if not declared:
        return Selection("unavailable", "", ["unknown binary: " + selected])
    native = root + "/artifacts/" + safe_name(requirements.platform) + "/" + safe_name(requirements.profile) + "/bin/" + safe_name(selected)
    rejected: list[string] = []
    compatible := false
    if os.is_file(root + "/metadata/build.json"):
        provenance = parse_document(read_text(root + "/metadata/build.json"))
        compatible = text_setting(provenance, "", "architecture") == capture(["uname", "-m"]) and text_setting(provenance, "", "os") == capture(["uname", "-s"]) and text_setting(provenance, "", "runtime-abi") == "severian-source-1"
    if os.is_file(native) and requirements.platform == "host" and compatible:
        return Selection("native", native, rejected)
    if requirements.platform == "host" and compatible and os.is_dir(root + "/metadata/build-records"):
        for location in files(root + "/metadata/build-records"):
            if not location.ends_with(".json") or location.ends_with(".inputs.json"):
                continue
            realization = parse_document(read_text(location))
            if text_setting(realization, "", "kind", "") == "native" and text_setting(realization, "", "profile", "") == requirements.profile:
                output = relative_path(text_setting(realization, "", "output"))
                if path.basename(output) == selected and (output.starts_with("bin/") or output.starts_with("artifacts/")) and os.is_file(root + "/" + output):
                    return Selection("native", root + "/" + output, rejected)
    rejected.append("no compatible native artifact for " + requirements.platform + "/" + requirements.profile)
    if os.is_file(manifest_file(root + "/source")):
        return Selection("source", root + "/source", rejected)
    rejected.append("distribution contains no source fallback")
    rejected.append("container execution is not supported by this compiler")
    return Selection("unavailable", "", rejected)

def frozen_manifest(project: Project, resolution: Resolution) -> string | Error:
    entries: list[Entry] = []
    for entry in project.manifest.entries:
        if entry.table != "dependencies" and entry.table != "dev-dependencies" and not (entry.table == "publish" and entry.key == "registry"):
            entries.append(entry)
    for edge in resolution.edges:
        if edge.parent == 0 and not edge.development:
            identity = resolution.packages[edge.child].identity
            value = "{ package = " + toml_quote(identity.name) + ", version = " + toml_quote(identity.version) + " }"
            entries.append(Entry("dependencies", edge.alias, value))
    return render_manifest(entries)

def publish(project: Project, compiler: Compiler, request: Publish) -> string | Error:
    if setting(project.manifest.entries, "package", "publish") == "false":
        throw Error("package is marked publish = false")
    mutable_project(project.root)
    root = registry_root(request.registry)
    release := registry_release(project.manifest.name, project.manifest.version, request.registry)
    version_root = root + "/" + safe_name(project.manifest.name) + "/" + safe_name(project.manifest.version)
    name = project.manifest.name + "-" + project.manifest.version + ".pkg"
    include_source = request.include_source and setting(project.manifest.entries, "publish", "include-source") != "false"
    resolved = resolve(project, Resolve("publish", false, request.registry))
    frozen = frozen_manifest(project, resolved)
    # Resolve the frozen graph before building: sibling checkouts cannot satisfy
    # an unpublished release dependency.
    published = resolve(Project(project.root, parse_manifest(frozen), frozen, ""), Resolve("publish", false, request.registry))
    checksum = source_checksum(project.root, frozen)
    identity := "source = " + toml_quote(checksum) + "\ncompiler = " + toml_quote(digest(compiler.executable)) + "\nprofile = " + toml_quote(request.profile) + "\nplatform = " + toml_quote(request.platform) + "\ninclude-source = " + ("true" if include_source else "false") + "\n" + render_legacy_manifest(parse_document(published.lock))
    identity = entries_json(parse_document(identity))
    if os.exists(release) or os.is_symlink(release):
        if not os.is_file(release + "/metadata/publication.json"):
            throw Error("PackageVersionConflict: release already exists with different content: " + release)
        verify_publication(release, name)
        previous = read_text(release + "/metadata/publication.json")
        if previous == identity:
            return release + "/" + name
        if text_setting(parse_document(previous), "", "source") != checksum:
            throw Error("PackageVersionConflict: release already exists with different source: " + release)
    stage = temporary(root)
    try:
        write_text(stage + "/identity", identity)
        relative_release = checksum.replace(":", "-") + "/realizations/" + digest(stage + "/identity").replace(":", "-") + "/package.pkg"
        release = version_root + "/" + relative_release
        if source_checksum(project.root, frozen) != checksum:
            throw Error("package source changed during publication")
        distribution = stage + "/distribution"
        mkdir(distribution)
        write_document(distribution + "/metadata/build.json", "architecture = " + toml_quote(capture(["uname", "-m"])) + "\nos = " + toml_quote(capture(["uname", "-s"])) + "\nruntime-abi = \"severian-source-1\"\n")
        write_text(distribution + "/metadata/package.json", frozen)
        write_text(distribution + "/metadata/package.lock", published.lock)
        if true:
            for location in files(project.root):
                relative = location[int(len(project.root)) + 1:]
                if relative in ["package.json", "package.toml", "sev.lock", "package.lock"]:
                    continue
                # Include native providers, headers and other package assets.
                copy_file(location, distribution + "/source/" + relative_path(relative))
            write_text(distribution + "/source/package.json", frozen)
            if source_checksum(distribution + "/source") != checksum:
                throw Error("package source changed while staging publication")
            source_project = Project(distribution + "/source", parse_manifest(frozen), frozen, "")
            source_resolution = resolve(source_project, Resolve("publish", false, request.registry))
            write_text(distribution + "/source/package.lock", source_resolution.lock)
            write_text(distribution + "/metadata/package.lock", source_resolution.lock)
        # Build the exact frozen source shipped to clients. Its content identity
        # and relative inputs then match a client on any checkout path.
        artifacts: list[Artifact] := []
        prelude_role = text_setting(project.manifest.entries, "package.metadata.prelude", "role", "")
        if prelude_role == "root":
            require_command([compiler.executable, "__precompile-prelude", distribution + "/source", distribution + "/package.pkgi/prelude", compiler.sysroot])
        elif prelude_role != "provider":
            result = build(open(distribution + "/source"), compiler, Build("", request.platform, request.profile, "", "", true))
            artifacts = result.artifacts
        for artifact in artifacts:
            for directory in ["package.pkgi", "metadata", "artifacts", "bin", "container"]:
                selected = artifact.package_root + "/" + directory
                if os.is_dir(selected):
                    for location in files(selected, true):
                        if location.ends_with(".inputs.json"):
                            continue
                        destination = distribution + "/" + directory + location[int(len(selected)):]
                        copy_file(location, destination)
                        if directory == "bin":
                            require_command(["chmod", "755", "--", destination])
            retain_file(artifact.package_root + "/metadata/source-index.json", distribution + "/metadata/source-index.json")
            retain_file(artifact.package_root + "/metadata/artifacts.json", distribution + "/metadata/artifacts.json")
        # Worker state exists only while staging, never in the publication.
        remove_tree(distribution + "/source/package.pkg")
        if not include_source:
            for artifact in artifacts:
                if artifact.target.kind == "library" and artifact.interface_path == "":
                    throw Error("source-free publication requires a complete exported interface")
            remove_tree(distribution + "/source")
        write_document(distribution + "/metadata/publication.json", identity)
        entries: list[ArchiveEntry] = []
        for location in files(distribution, true):
            relative = location[int(len(distribution)) + 1:]
            entries.append(ArchiveEntry(relative, (relative.starts_with("bin/") or relative.starts_with("artifacts/")), read_bytes(location)))
        write_archive(distribution + "/" + name, Archive(2, project.manifest.name, entries))
        write_text(distribution + "/metadata/archive.sha256", digest(distribution + "/" + name) + "\n")
        write_text(distribution + "/metadata/content.sha256", publication_files(distribution, name))
        verify_publication(distribution, name)
        mkdir(path.dirname(release))
        lock = file.native_lock(root + "/.sev-publish.lock")
        if lock < 0:
            throw Error("could not lock registry publication")
        try:
            current = registry_release(project.manifest.name, project.manifest.version, request.registry)
            if os.is_file(current + "/metadata/publication.json"):
                previous = parse_document(read_text(current + "/metadata/publication.json"))
                if text_setting(previous, "", "source") != checksum:
                    throw Error("PackageVersionConflict: another revision already owns this version")
            if os.exists(release) or os.is_symlink(release):
                if not os.is_file(release + "/metadata/publication.json") or read_text(release + "/metadata/publication.json") != identity:
                    throw Error("PackageVersionConflict: release already exists with different content: " + release)
                verify_publication(release, name)
            else:
                os.publish_directory(distribution, release)
                write_document(stage + "/index.json", "format = 1\npackage = " + toml_quote(relative_release) + "\n")
                # A legacy flat payload's inventory must remain valid. Its
                # discovery marker uses the already-excluded local prefix.
                marker = ".sev-index.json" if os.is_file(version_root + "/metadata/publication.json") else "index.json"
                replace_file(stage + "/index.json", version_root + "/" + marker)
            file.unlock(lock)
        catch error: Error:
            file.unlock(lock)
            throw Error(error.message)
    catch error: Error:
        remove_tree(stage)
        throw Error(error.message)
    remove_tree(stage)
    return release + "/" + name

def materialize(value: string, compiler: Compiler, request: Run) -> string | Error:
    ref = reference(value)
    platform = request.platform if request.platform != "" else "host"
    profile = request.profile if request.profile != "" else "release"
    location = fetch(ref)
    if ref.source == "git":
        result = execute(plan(open(location), Build(request.target, request.platform, request.profile, "", "", request.locked), "run"), compiler)
        return result.artifacts[0].path
    selected = select(path.dirname(location), Requirements(request.target, platform, profile, false))
    if selected.kind == "native":
        return selected.path
    if selected.kind == "source":
        stage = registry_root() + "/cache/build/" + source_checksum(selected.path).replace(":", "-")
        mkdir(stage)
        lock = file.native_lock(stage + "/.sev-build.lock")
        if lock < 0:
            throw Error("could not lock installed source realization")
        try:
            if not os.is_dir(stage + "/source"):
                staging = temporary(stage)
                require_command(["cp", "-R", "--", selected.path, staging + "/source"])
                replace_file(staging + "/source", stage + "/source")
                remove_tree(staging)
            file.unlock(lock)
        catch failure: Error:
            file.unlock(lock)
            throw Error(failure.message)
        result = execute(plan(open(stage + "/source"), Build(request.target, platform, profile, "", "", true), "run"), compiler)
        return result.artifacts[0].path
    throw Error(selected.rejections.join("; "))

def run_reference(value: string, compiler: Compiler, request: Run) -> int | Error:
    executable: string = materialize(value, compiler, request)
    arguments: list[string] = [executable]
    for argument in request.arguments:
        arguments.append(argument)
    return command(arguments)

def install(value: string, compiler: Compiler, request: Install) -> string | Error:
    executable = materialize(value, compiler, Run(request.target, request.platform, request.profile, [], false))
    directory := request.directory
    if directory == "":
        home = environment.get("HOME", "")
        if home == "":
            throw Error("install needs a directory or HOME")
        directory = home + "/.local/bin"
    mkdir(directory)
    destination = directory + "/" + safe_name(path.basename(executable))
    if os.exists(destination):
        throw Error("installed command already exists: " + destination)
    stage = temporary(directory)
    copy_file(executable, stage + "/binary")
    require_command(["chmod", "755", "--", stage + "/binary"])
    require_command(["ln", "--", stage + "/binary", destination])
    remove_tree(stage)
    return destination

def select(root: string) -> Selection | Error:
    return select(root, Requirements())

def publish(project: Project, compiler: Compiler) -> string | Error:
    return publish(project, compiler, Publish())

def install(value: string, compiler: Compiler) -> string | Error:
    return install(value, compiler, Install())

def materialize(value: string, compiler: Compiler) -> string | Error:
    return materialize(value, compiler, Run())

def run_reference(value: string, compiler: Compiler) -> int | Error:
    return run_reference(value, compiler, Run())
