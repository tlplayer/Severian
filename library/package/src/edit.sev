import * from "document.sev"
import * from "host.sev"
import * from "model.sev"
import * from "manifest.sev"
import * from "resolve.sev"
import file
import path
import os

class Edit:
    project: Project
    entries: list[Entry]

    def add(value: string, alias: string = "", development: bool = false) -> unit | Error:
        ref = reference(value)
        if ref.source != "registry":
            throw Error("edit.add currently requires a registry reference")
        key = alias if alias != "" else ref.name
        table = "dev-dependencies" if development else "dependencies"
        remove(key, development)
        raw := toml_quote(ref.selector)
        if key != ref.name:
            raw = "{ package = " + toml_quote(ref.name) + ", version = " + raw + " }"
        entries.append(Entry(table, safe_name(key), raw))

    def remove(alias: string, development: bool = false) -> unit | Error:
        table = "dev-dependencies" if development else "dependencies"
        replacement: list[Entry] = []
        for entry in entries:
            if entry.table != table or entry.key != alias:
                replacement.append(entry)
        entries = replacement

    def update(alias: string) -> unit | Error:
        # Existing selectors remain desired state; commit refreshes resolution.
        for entry in entries:
            if entry.table in ["dependencies", "dev-dependencies"] and entry.key == alias:
                return
        throw Error("unknown dependency alias: " + alias)

    def commit() -> Project | Error:
        mutable_project(project.root)
        original = project
        text = render_manifest(entries)
        candidate = Project(original.root, parse_manifest(text), text, "")
        resolution = resolve(candidate, Resolve("edit", false, ""))
        lock = file.native_lock(original.root + "/.sev-edit.lock")
        if lock < 0:
            throw Error("could not lock package edit")
        try:
            recover_edit(original.root)
            if read_text(manifest_file(original.root)) != original.manifest_text:
                throw Error("package manifest changed while editing; reopen the project")
            lock_path = project_lock_file(original.root)
            current_lock = read_text(lock_path) if os.is_file(lock_path) else ""
            if current_lock != original.lock_text:
                throw Error("package lock changed while editing; reopen the project")
            stage = original.root + "/.sev-transaction"
            mkdir(stage)
            write_text(stage + "/manifest.old", original.manifest_text)
            write_text(stage + "/lock.old", current_lock)
            write_text(stage + "/lock.name", path.basename(lock_path))
            write_text(stage + "/manifest.new", text)
            write_text(stage + "/lock.new", resolution.lock)
            require_command(["sync", "-f", stage])
            write_text(stage + "/ready", "rollback")
            require_command(["sync", "-f", stage])
            replace_file(stage + "/manifest.new", manifest_file(original.root))
            replace_file(stage + "/lock.new", lock_path)
            require_command(["sync", "-f", original.root])
            remove_tree(stage)
            file.unlock(lock)
        catch error: Error:
            recover_edit(original.root)
            file.unlock(lock)
            throw Error(error.message)
        return open(original.root)

def render_manifest(entries: list[Entry]) -> string:
    return entries_json(entries)

def render_legacy_manifest(entries: list[Entry]) -> string:
    tables: list[string] = []
    for entry in entries:
        if entry.table not in tables:
            tables.append(entry.table)
    output := ""
    for table in tables:
        array := false
        for entry in entries:
            if entry.table == table:
                array = entry.array
        if array:
            components = table.split(".")
            output += "\n[[" + components[:int(len(components)) - 1].join(".") + "]]\n"
        elif table != "":
            output += "\n[" + table + "]\n"
        for entry in entries:
            if entry.table == table:
                output += toml_quote(entry.key) + " = " + entry.value + "\n"
    return output


def edit(project: Project) -> Edit:
    return Edit(project, project.manifest.entries[:])

def add(project: Project, value: string, alias: string = "", development: bool = false) -> Project | Error:
    transaction = edit(project)
    transaction.add(value, alias, development)
    return transaction.commit()

def remove(project: Project, alias: string, development: bool = false) -> Project | Error:
    transaction = edit(project)
    transaction.remove(alias, development)
    return transaction.commit()

def update(project: Project, alias: string) -> Project | Error:
    transaction = edit(project)
    transaction.update(alias)
    return transaction.commit()

def new(location: string, name: string = "", library: bool = false) -> Project | Error:
    if os.exists(location):
        throw Error("new package destination already exists")
    selected = safe_name(name if name != "" else path.basename(location))
    stage = temporary(path.dirname(location))
    header := "[package]\nname = " + toml_quote(selected) + "\nversion = \"0.1.0\"\nedition = \"2026\"\n"
    target = "lib" if library else "main"
    header += "\n[lib]\n" if library else "\n[[bin]]\n"
    header += "name = " + toml_quote(selected) + "\npath = \"src/" + target + ".sev\"\n"
    write_text(stage + "/package.json", options(parse_document(header)))
    example := "# Doubles a supplied integer.\n# Parameters:\n# - value [int]: Number to double.\n# Returns [int]:\n# - Twice the supplied number.\n# Errors [None]:\n# - None.\n# Complexity:\n# - Runtime: O(1). Space: O(1).\ndef doubled(value: int) -> int:\n    return value * 2\n\ntest \"doubles positive and negative values\":\n    assert(doubled(3) == 6)\n    assert(doubled(-2) == -4)\n"
    if not library:
        example += "\n# Displays the example result.\n# Returns [unit]:\n# - None.\n# Errors [None]:\n# - None.\n# Complexity:\n# - Runtime: O(1). Space: O(1).\ndef main():\n    print(doubled(3))\n"
    write_text(stage + "/src/" + target + ".sev", example)
    write_text(stage + "/package.lock", resolve(open(stage)).lock)
    replace_file(stage, location)
    return open(location)

# init also supports an existing empty directory, without overwriting files.
def init(location: string = ".", name: string = "", library: bool = false) -> Project | Error:
    if not os.exists(location):
        return new(location, name, library)
    root = canonical(location)
    if not os.is_dir(root) or len(os.list(root)) != 0:
        throw Error("init requires an empty directory: " + root)
    stage = temporary(path.dirname(root))
    try:
        project = new(stage + "/project", name if name != "" else path.basename(root), library)
        for entry in os.list(project.root):
            replace_file(project.root + "/" + entry, root + "/" + entry)
    catch failure: Error:
        remove_tree(stage)
        throw Error(failure.message)
    remove_tree(stage)
    return open(root)

# package.options is the generator used by new/init and explicit policy sync.
# Existing values win; catalog comments enumerate defaults and legal severities.
def options(entries: list[Entry]) -> string | Error:
    result = entries[:]
    comments := "// Severian package. Generated options; existing values are preserved.\n"
    for option in default_catalog():
        components = option.path.split(".")
        table = components[:int(len(components)) - 1].join(".")
        key = components[-1]
        if setting(result, table, key) == "":
            raw = document_quote(option.default) if option.kind in ["string", "enum"] else option.default
            result.append(Entry(table, key, raw))
        comments += "// " + option.path + ": " + option.kind + "; default " + option.default + ("; values " + option.values.join(", ") if int(len(option.values)) > 0 else "") + "\n"
    if setting(result, "lint", "enabled") == "":
        result.append(Entry("lint", "enabled", "true"))
    for rule in lint_rules():
        if setting(result, "lint", rule.option) == "":
            result.append(Entry("lint", rule.option, string(rule.limit)))
        if setting(result, "lint.rules", rule.id) == "":
            result.append(Entry("lint.rules", rule.id, document_quote(rule.level)))
        comments += "// " + rule.id + ": " + rule.message + "; levels off, info, hint, warning, error; default " + rule.level + "; limit " + string(rule.limit) + "\n"
    return comments + entries_json(result)
