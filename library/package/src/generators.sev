import document_quote, entries_json, parse_document, relative_path, setting, string_array, text_setting, toml_quote, unquote from "document.sev"
import canonical, capture, command, copy_file, digest, exists, files, manifest_file, mkdir, mutable_project, project_lock_file, published_project, read_bytes, read_text, remove_tree, replace_file, require_command, sorted_strings, temporary, write_bytes, write_text from "host.sev"
import Archive, ArchiveEntry, Artifact, Build, BuildPlan, BuildResult, BuildUnit, Check, Clean, Compiler, DependencyEdge, Entry, Install, PackageIdentity, Project, Publish, Requirements, Resolution, Resolve, ResolvedPackage, Run, Selection, Target, Test, TestReport, TestResult, inside, open, parse_manifest, prelude_exclusions, reference, safe_name, write_document from "manifest.sev"
import "model.sev" as _dependency_83
import environment

# A build session executes each package-owned recipe once before unit lookup.
# Reset at the public build boundary so later builds can observe changed inputs.
PreparedGenerators: list[string] = []

def reset_generators():
    PreparedGenerators.clear()

# Severian recipes use the configured host compiler. Python remains a migration
# compatibility path until its corresponding source recipe has been replaced.
def prepare_generators(resolution: Resolution) -> unit | Error:
    if environment.get("SEVERIAN_ACTIVE_GENERATOR", "") != "":
        return
    for resolved in resolution.packages:
        for recipe in string_array(setting(resolved.manifest.entries, "build", "generators", "[]")):
            location = inside(resolved.root, recipe)
            if location in PreparedGenerators:
                continue
            if location.ends_with(".sev"):
                require_command(["env", "SEVERIAN_ACTIVE_GENERATOR=" + location, environment.get("SEVERIAN_GENERATOR_COMPILER", "sev"), location])
            elif location.ends_with(".py"):
                require_command(["python3", location])
            else:
                throw Error("unsupported build recipe: " + recipe)
            PreparedGenerators.append(location)
