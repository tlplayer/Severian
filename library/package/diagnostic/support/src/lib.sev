# Tooling consumes the registry's classified tokens and original spans. Trivia
# and newlines inside delimiters do not introduce logical statements.
def source_tokens(input: source.SourceFile, include_comments: bool = false) -> list[lexer.Token] | Error:
    stream = lexer.lexer(input)
    if stream is list[lexer.Diagnostic]:
        for diagnostic in stream:
            throw Error(diagnostic.note)
        throw Error("lexing failed without a diagnostic")
    tokens: list[lexer.Token] = []
    nesting := 0
    for token in stream.tokens:
        if token.kind in ["SPACE", "INDENT"] or (token.kind == "COMMENT" and not include_comments):
            continue
        if token.kind == "NEWLINE" and nesting > 0:
            continue
        if token.kind in ["LEFT_PAREN", "LEFT_BRACKET", "LEFT_BRACE"]:
            nesting += 1
        elif token.kind in ["RIGHT_PAREN", "RIGHT_BRACKET", "RIGHT_BRACE"]:
            nesting = max(0, nesting - 1)
        # Keywords also carry the identifier classification; metrics inspect
        # their spelling without depending on registry declaration order.
        if "IDENTIFIER" in token.kinds:
            tokens.append(lexer.Token("IDENTIFIER", token.lexeme, token.span, token.declarations, token.kinds))
        else:
            tokens.append(token)
    end = u32(len(input.characters))
    location = source.Span(input.source_id, end, end)
    tokens.append(lexer.Token("EOF", lexer.Lexeme("", location), location))
    return tokens

def sorted_strings(values: list[string]) -> list[string]:
    result: list[string] = []
    for value in values:
        result.append(value)
    for i in range(int(len(result))):
        for j in range(i + 1, int(len(result))):
            if result[j] < result[i]:
                previous = result[i]
                result[i] = result[j]
                result[j] = previous
    return result


def collect_files(root: string, directory: string, result: list[string], nested_packages: bool) -> unit | Error:
    for name in os.list(directory):
        if name == "package.pkg" or name == ".git" or name.starts_with(".sev-"):
            continue
        location = directory + "/" + name
        if os.is_symlink(location):
            throw Error("package content may not contain symlinks: " + location)
        if os.is_dir(location):
            # Nested manifests introduce separate packages, not source folders.
            if nested_packages or not os.is_file(manifest_file(location)):
                collect_files(root, location, result, nested_packages)
        elif os.is_file(location):
            result.append(location)
        else:
            throw Error("package content must be a regular file: " + location)


def files(root: string, nested_packages: bool = false) -> list[string] | Error:
    result: list[string] = []
    collect_files(root, root, result, nested_packages)
    return sorted_strings(result)


def manifest_file(root: string) -> string:
    if os.is_file(root + "/package.json") or not os.is_file(root + "/package.toml"):
        return root + "/package.json"
    return root + "/package.toml"



def exists(value: string) -> bool:
    return os.exists(value)


def monotonic() -> float:
    return time.monotonic()


test "diagnostic tokens retain keywords literal spans and the source boundary":
    input = source.virtual_source("tokens.sev", "if ready:\n    call(\n        \"(# λ)\", # ignored\n    )\n")
    tokens = source_tokens(input)
    assert(tokens[0].kind == "IDENTIFIER")
    assert(tokens[0].lexeme.text == "if")
    newlines := 0
    literals := 0
    for token in tokens:
        assert(token.kind not in ["SPACE", "INDENT", "COMMENT"])
        assert(token.lexeme.text == input.text[token.span.start:token.span.end])
        if token.kind == "NEWLINE":
            newlines += 1
        if token.kind == "STRING":
            literals += 1
            assert(token.lexeme.text == "\"(# λ)\"")
    assert(newlines == 2)
    assert(literals == 1)
    assert(tokens[-1].kind == "EOF")
    assert(tokens[-1].span.start == len(input.characters))
