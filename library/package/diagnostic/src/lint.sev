from build_flow import
{
    Entry,
    Project,
    setting,
    text_setting,
    unquote,
    string_array,
    relative_path,
    parse_document,
    entries_json,
    document_quote,
    build_root,
}
from cache import
{
    capture,
    canonical,
    digest,
    temporary,
    mkdir,
    write_text,
    read_text,
    copy_file,
    replace_file,
    remove_tree,
}
import file
import os
import path
import process
import time

import * from "host.sev"
import * from "lint_policy.sev"
import lexer
import source

class LintDiagnostic:
    rule: string
    file: string
    line: int
    column: int
    end_line: int
    end_column: int
    level: string
    message: string
    measured: int
    threshold: int
    remediation: string

class LintCallable:
    name: string
    start: int
    body: int
    end: int
    parameters: list[int]
    root: bool
    method: bool

class LintSuppression:
    rule: string
    line: int

class LintTest:
    start: int
    end: int

class LintSource:
    path: string
    text: string
    tokens: list[lexer.Token]
    lines: list[int]
    columns: list[int]
    depths: list[int]
    callables: list[LintCallable]
    suppressions: list[LintSuppression] = []
    tests: list[LintTest] = []

# Metrics consume classified lexer tokens: comments and string contents cannot
# create declarations or uses. Offsets are Unicode character offsets, like Span.
def lint_source(location: string, text: string) -> LintSource | Error:
    input = source.SourceFile(source.SourceId(0), location, text)
    tokens = lexer.scan_bootstrap(input)
    lines: list[int] = []
    columns: list[int] = []
    depths: list[int] = []
    line := 1
    column := 1
    cursor := 0
    depth := 0
    for token in tokens:
        while cursor < int(token.span.start):
            if input.characters[cursor] == "\n":
                line += 1
                column = 1
            else:
                column += 1
            cursor += 1
        if token.kind == lexer.TokenKind.Dedent:
            depth -= 1
        lines.append(line)
        columns.append(column)
        depths.append(depth)
        if token.kind == lexer.TokenKind.Indent:
            depth += 1
    result = LintSource(location, text, tokens, lines, columns, depths, [])
    lint_suppressions(result)
    return result

def lint_block_end(input: LintSource, start: int) -> int:
    header := start
    while header < int(len(input.tokens)) and input.tokens[header].kind != lexer.TokenKind.Newline:
        header += 1
    following := header + 1
    while following < int(len(input.tokens)) and input.tokens[following].kind == lexer.TokenKind.Newline:
        following += 1
    if following >= int(len(input.tokens)) or input.tokens[following].kind != lexer.TokenKind.Indent:
        return min(header + 1, int(len(input.tokens)) - 1)
    cursor := start
    entered := false
    while cursor < int(len(input.tokens)):
        if input.depths[cursor] > input.depths[start]:
            entered = true
        if entered and input.depths[cursor] <= input.depths[start]:
            return cursor
        cursor += 1
    return cursor - 1

def lint_declarations(input: LintSource, library: bool, exports: list[string]):
    for index in range(int(len(input.tokens)) - 1):
        token = input.tokens[index]
        if token.kind == lexer.TokenKind.Identifier and string(token) == "test" and (index == 0 or input.tokens[index - 1].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent]):
            input.tests.append(LintTest(index, lint_block_end(input, index)))
        if token.kind != lexer.TokenKind.Identifier or string(token) != "def":
            continue
        name = string(input.tokens[index + 1])
        cursor := index + 2
        while cursor < int(len(input.tokens)) and string(input.tokens[cursor]) != "(" and input.tokens[cursor].kind != lexer.TokenKind.Newline:
            cursor += 1
        parameters: list[int] = []
        nested := 0
        expecting := true
        cursor += 1
        while cursor < int(len(input.tokens)):
            spelling = string(input.tokens[cursor])
            if spelling == ")" and nested == 0:
                break
            if expecting and nested == 0 and input.tokens[cursor].kind == lexer.TokenKind.Identifier:
                if spelling != "self":
                    parameters.append(cursor)
                expecting = false
            if spelling in ["(", "[", "{"]:
                nested += 1
            elif spelling in [")", "]", "}"]:
                nested -= 1
            elif spelling == "," and nested == 0:
                expecting = true
            cursor += 1
        while cursor < int(len(input.tokens)) and input.tokens[cursor].kind != lexer.TokenKind.Newline:
            cursor += 1
        method := false
        for parent in range(index):
            if input.tokens[parent].kind == lexer.TokenKind.Identifier and string(input.tokens[parent]) in ["class", "trait"] and input.depths[parent] + 1 == input.depths[index] and lint_block_end(input, parent) > index:
                method = true
        decorated := false
        previous = input.lines[index] - 2
        source_lines = input.text.split("\n")
        if previous >= 0:
            decorated = source_lines[previous].strip().starts_with("@")
        root = method or decorated or (input.depths[index] == 0 and (name == "main" or name in exports or (library and not name.starts_with("_"))))
        input.callables.append(LintCallable(name, index, cursor, lint_block_end(input, index), parameters, root, method))

# Suppressions are explicit file directives or next-line directives. They never
# rewrite source. Unknown IDs are configuration errors, including disabled rules.
def lint_suppressions(input: LintSource) -> unit | Error:
    offset := 0
    lines = input.text.split("\n")
    for index in range(int(len(lines))):
        raw = lines[index]
        text := raw.strip()
        if text.starts_with("# sev-lint"):
            for token in input.tokens:
                if int(token.span.start) <= offset and int(token.span.end) > offset and token.kind in [lexer.TokenKind.String, lexer.TokenKind.FormattedString]:
                    text = ""
            whole = text.starts_with("# sev-lint: allow ")
            next_line = text.starts_with("# sev-lint-next-line: allow ")
            if whole or next_line:
                prefix = "# sev-lint: allow " if whole else "# sev-lint-next-line: allow "
                for raw_rule in text[int(len(prefix)):].split(","):
                    selected = raw_rule.strip()
                    valid := false
                    for candidate in lint_rules():
                        valid = valid or candidate.id == selected
                    if not valid:
                        throw Error(input.path + ":" + string(index + 1) + ": unknown lint suppression " + selected)
                    input.suppressions.append(LintSuppression(selected, 0 if whole else index + 2))
        offset += int(len(raw.characters())) + 1

def lint_suppressed(input: LintSource, line: int, rule: string) -> bool:
    for suppression in input.suppressions:
        if suppression.rule == rule and suppression.line in [0, line]:
            return true
    return false

def lint_measure(input: LintSource, index: int, measured: int, rule_index: int, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    rule = lint_rules()[rule_index]
    level = lint_level(entries, rule)
    limit = int(lint_entry(entries, "lint", rule.option, string(rule.limit)))
    suppressed = lint_suppressed(input, input.lines[index], rule.id)
    if measured <= limit or level == "off" or suppressed:
        return
    token = input.tokens[index]
    end_line := input.lines[index]
    end_column := input.columns[index]
    characters = input.text.characters()
    for offset in range(int(token.span.start), int(token.span.end)):
        if characters[offset] == "\n":
            end_line += 1
            end_column = 1
        else:
            end_column += 1
    output.append(LintDiagnostic(rule.id, input.path, input.lines[index], input.columns[index], end_line, end_column, level, rule.message, measured, limit, rule.remediation))

def lint_read(input: LintSource, index: int) -> bool:
    if input.tokens[index].kind != lexer.TokenKind.Identifier:
        return false
    before = string(input.tokens[index - 1]) if index > 0 else ""
    after = string(input.tokens[index + 1]) if index + 1 < int(len(input.tokens)) else ""
    declaration = after == ":" and (index == 0 or input.tokens[index - 1].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent])
    return before not in [".", "def", "class", "trait", "enum"] and after not in ["=", ":=", "?="] and not declaration

def lint_unused(input: LintSource, callable: LintCallable, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    bindings = callable.parameters[:]
    for index in range(callable.body, callable.end):
        if input.tokens[index].kind != lexer.TokenKind.Identifier:
            continue
        before = string(input.tokens[index - 1]) if index > 0 else ""
        after = string(input.tokens[index + 1]) if index + 1 < int(len(input.tokens)) else ""
        if before != "." and string(input.tokens[index]) not in ["else", "try", "finally", "pass", "break", "continue"] and after in ["=", ":=", "?=", ":"]:
            if index > 0 and input.tokens[index - 1].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent]:
                bindings.append(index)
    names: list[string] = []
    for binding in bindings:
        name = string(input.tokens[binding])
        if name.starts_with("_") or name in names:
            continue
        names.append(name)
        used := false
        for index in range(callable.body, callable.end):
            used = used or (string(input.tokens[index]) == name and lint_read(input, index))
        if not used:
            lint_measure(input, binding, 1, 3, entries, output)

def lint_metrics(input: LintSource, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    file_count = int(len(input.text.split("\n"))) - (1 if input.text.ends_with("\n") else 0)
    lint_measure(input, 0, file_count, 0, entries, output)
    for callable in input.callables:
        last := callable.end - 1
        while last > callable.start and input.tokens[last].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent, lexer.TokenKind.Eof]:
            last -= 1
        lint_measure(input, callable.start, input.lines[last] - input.lines[callable.start] + 1, 1, entries, output)
        lint_measure(input, callable.start, int(len(callable.parameters)), 2, entries, output)
        lint_unused(input, callable, entries, output)
        lint_unreachable(input, callable, entries, output)
    for index in range(int(len(input.tokens))):
        if input.tokens[index].kind != lexer.TokenKind.Identifier:
            continue
        spelling = string(input.tokens[index])
        if spelling not in ["class", "match", "if"]:
            continue
        if index > 0 and input.tokens[index - 1].kind not in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent]:
            continue
        end = lint_block_end(input, index)
        count := 0
        if spelling == "class":
            for callable in input.callables:
                if callable.start > index and callable.start < end and input.depths[callable.start] == input.depths[index] + 1:
                    count += 1
            lint_measure(input, index, count, 5, entries, output)
        elif spelling == "match":
            for child in range(index + 1, end):
                if string(input.tokens[child]) == "case" and input.tokens[child].kind == lexer.TokenKind.Identifier and input.depths[child] == input.depths[index] + 1:
                    count += 1
            lint_measure(input, index, count, 6, entries, output)
        else:
            count = 1
            cursor := end
            while cursor < int(len(input.tokens)):
                if input.tokens[cursor].kind in [lexer.TokenKind.Newline, lexer.TokenKind.Dedent]:
                    cursor += 1
                elif input.depths[cursor] == input.depths[index] and string(input.tokens[cursor]) == "elif":
                    count += 1
                    cursor = lint_block_end(input, cursor)
                else:
                    break
            lint_measure(input, index, count, 7, entries, output)

# Name matching is intentionally conservative for overloads, callbacks and
# dynamic dispatch: all candidates of a referenced name remain live.
def lint_test_file(input: LintSource) -> bool:
    return input.path.starts_with("tests/") or input.path.starts_with("test/")

def lint_in_test(input: LintSource, index: int) -> bool:
    for test in input.tests:
        if index >= test.start and index < test.end:
            return true
    return false

def lint_reachable(inputs: list[LintSource], include_tests: bool = true) -> list[string]:
    live: list[string] = []
    for input in inputs:
        if not include_tests and lint_test_file(input):
            continue
        for callable in input.callables:
            if callable.root and callable.name not in live and (include_tests or not lint_in_test(input, callable.start)):
                live.append(callable.name)
    changed := true
    while changed:
        changed = false
        for input in inputs:
            if not include_tests and lint_test_file(input):
                continue
            for index in range(int(len(input.tokens))):
                if not include_tests and lint_in_test(input, index):
                    continue
                member = index > 0 and string(input.tokens[index - 1]) == "."
                if not lint_read(input, index) and not (member and input.tokens[index].kind == lexer.TokenKind.Identifier):
                    continue
                active := true
                for callable in input.callables:
                    if index >= callable.start and index < callable.end:
                        active = callable.name in live and index >= callable.body
                if active:
                    name = string(input.tokens[index])
                    if name not in live:
                        live.append(name)
                        changed = true
    return live

# A literal-only return cannot exercise an operation. Keep this deliberately
# narrower than constant folding: constructors, properties and expressions may
# have effects even when their arguments are literals.
def lint_constant(input: LintSource, callable: LintCallable) -> bool:
    body: list[int] = []
    for index in range(callable.body, callable.end):
        if input.tokens[index].kind not in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent, lexer.TokenKind.Eof]:
            body.append(index)
    if len(body) == 1:
        return string(input.tokens[body[0]]) in ["pass", "return", "..."]
    if len(body) < 2 or len(body) > 3 or string(input.tokens[body[0]]) != "return":
        return false
    value = input.tokens[body[-1]]
    if len(body) == 3:
        return string(input.tokens[body[1]]) in ["+", "-"] and value.kind in [lexer.TokenKind.Integer, lexer.TokenKind.Float]
    return value.kind in [lexer.TokenKind.Integer, lexer.TokenKind.Float, lexer.TokenKind.String, lexer.TokenKind.Character] or (value.kind == lexer.TokenKind.Identifier and string(value) in ["true", "false", "None"])

# Follow helper calls so moving assert(true) into a helper cannot satisfy the
# check. Imported operations count as external behavior; this source pass does
# not claim to measure dynamic execution or resolve arbitrary dynamic dispatch.
def lint_tests(input: LintSource, inputs: list[LintSource], entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    for test in input.tests:
        sources: list[LintSource] = [input]
        starts: list[int] = [test.start]
        ends: list[int] = [test.end]
        visited: list[string] = []
        checked := false
        behavior := false
        cursor := 0
        while cursor < int(len(sources)):
            current = sources[cursor]
            for index in range(starts[cursor], ends[cursor]):
                token = current.tokens[index]
                if token.kind != lexer.TokenKind.Identifier:
                    continue
                name = string(token)
                if name == "assert" and index + 1 < ends[cursor] and string(current.tokens[index + 1]) == "(":
                    depth := 1
                    for argument in range(index + 2, ends[cursor]):
                        value = string(current.tokens[argument])
                        if value in ["(", "["]:
                            depth += 1
                        elif value in [")", "]"]:
                            depth -= 1
                        if depth == 0 or (depth == 1 and value == ","):
                            break
                        if current.tokens[argument].kind == lexer.TokenKind.Identifier and value not in ["true", "false", "None", "and", "or", "not", "is", "in"]:
                            checked = true
                if name in ["accept", "reject"] and index + 1 < ends[cursor] and string(current.tokens[index + 1]) == ":":
                    checked = true
                    behavior = true
                if not lint_read(current, index):
                    continue
                for peer in inputs:
                    for callable in peer.callables:
                        if callable.name != name:
                            continue
                        if not lint_test_file(peer) and not lint_in_test(peer, callable.start) and not lint_constant(peer, callable):
                            behavior = true
                        identity = peer.path + ":" + string(callable.start)
                        if identity not in visited:
                            visited.append(identity)
                            sources.append(peer)
                            starts.append(callable.body)
                            ends.append(callable.end)
                # A namespace use must originate in a real import, never text
                # in a string or an arbitrary object with the same spelling.
                if index + 3 < ends[cursor] and string(current.tokens[index + 1]) == "." and string(current.tokens[index + 3]) == "(":
                    for imported in range(int(len(current.tokens)) - 1):
                        if string(current.tokens[imported]) == "import" and current.tokens[imported].kind == lexer.TokenKind.Identifier and string(current.tokens[imported + 1]) == name:
                            behavior = true
            cursor += 1
        if not checked or not behavior:
            lint_measure(input, test.start, 1, 8, entries, output)

def lint_uncached(project: Project, force: bool = false, testing: bool = false) -> list[LintDiagnostic] | Error:
    entries = project.manifest.entries[:]
    if testing:
        for id in ["L0004", "L0005", "L0009", "L0010"]:
            if lint_entry(entries, "lint.rules", id, "") == "":
                entries.append(Entry("lint.rules", id, "\"error\""))
    validate_lint(entries)
    output: list[LintDiagnostic] = []
    if not force and setting(entries, "lint", "enabled", "true") == "false":
        return output
    excluded = string_array(setting(entries, "lint", "exclude", "[]"))
    for value in excluded:
        relative_path(value[:int(len(value)) - 1] if value.ends_with("/") else value)
    exports = string_array(setting(entries, "package", "export", "[]"))
    library := false
    for target in project.manifest.targets:
        library = library or target.kind == "library"
    inputs: list[LintSource] = []
    for location in files(project.root):
        if not location.ends_with(".sev"):
            continue
        relative = location[int(len(project.root)) + 1:]
        skip := false
        for value in excluded:
            skip = skip or relative == value or (value.ends_with("/") and relative.starts_with(value))
        if skip:
            continue
        input = lint_source(relative, read_text(location))
        lint_declarations(input, library, exports)
        lint_metrics(input, entries, output)
        inputs.append(input)
    for input in inputs:
        lint_top_level(input, library, entries, output, inputs)
    live = lint_reachable(inputs, false)
    tested = lint_reachable(inputs)
    lint_duplicates(inputs, entries, output)
    lint_churn(project, inputs, entries, output)
    for input in inputs:
        for callable in input.callables:
            reachable = tested if lint_test_file(input) or lint_in_test(input, callable.start) else live
            if callable.name not in reachable:
                lint_measure(input, callable.start, 1, 4, entries, output)
            if lint_constant(input, callable):
                lint_measure(input, callable.start, 1, 9, entries, output)
        lint_tests(input, inputs, entries, output)
        lint_documentation(input, entries, output)
    # Sort by numeric source position, then stable rule ID, independently of pass order.
    for i in range(int(len(output))):
        for j in range(i + 1, int(len(output))):
            a = output[i]
            b = output[j]
            if b.file < a.file or (b.file == a.file and (b.line < a.line or (b.line == a.line and (b.column < a.column or (b.column == a.column and b.rule < a.rule))))):
                output[i] = b
                output[j] = a
    return output

def lint(project: Project, identity: string, force: bool = false, testing: bool = false, immutable: bool = false) -> list[LintDiagnostic] | Error:
    validate_lint(project.manifest.entries)
    if immutable:
        return lint_uncached(project, force, testing)
    started = monotonic()
    directory = build_root() + "/debug/quality"
    stage = temporary(directory, "run-")
    write_text(stage + "/key", identity)
    key = digest(stage + "/key").replace(":", "-")
    cached = directory + "/" + key + ".jsonl"
    try:
        if exists(cached) and exists(cached + ".digest") and digest(cached) == read_text(cached + ".digest"):
            output: list[LintDiagnostic] = []
            for line in read_text(cached).split("\n"):
                if line == "":
                    continue
                fields = parse_document(line)
                output.append(LintDiagnostic(text_setting(fields, "", "rule"), text_setting(fields, "", "file"), int(setting(fields, "", "line")), int(setting(fields, "", "column")), int(setting(fields, "", "end_line")), int(setting(fields, "", "end_column")), text_setting(fields, "", "severity"), text_setting(fields, "", "message"), int(setting(fields, "", "measured")), int(setting(fields, "", "threshold")), text_setting(fields, "", "remediation")))
            write_text(directory + "/analysis.json", "{\"cache_hit\":true,\"wall_seconds\":" + string(monotonic() - started) + "}")
            remove_tree(stage)
            return output
    catch failure: Error:
        # Incomplete or damaged generated state cannot waive package policy.
        pass
    output = lint_uncached(project, force, testing)
    lines: list[string] = []
    for diagnostic in output:
        lines.append(lint_json(diagnostic))
    write_text(stage + "/diagnostics", lines.join("\n") + "\n")
    write_text(stage + "/digest", digest(stage + "/diagnostics"))
    replace_file(stage + "/diagnostics", cached)
    replace_file(stage + "/digest", cached + ".digest")
    write_text(directory + "/analysis.json", "{\"cache_hit\":false,\"wall_seconds\":" + string(monotonic() - started) + "}")
    remove_tree(stage)
    return output

def lint_json(diagnostic: LintDiagnostic) -> string:
    d = diagnostic
    return "{\"rule\":" + document_quote(d.rule) + ",\"file\":" + document_quote(d.file) + ",\"line\":" + string(d.line) + ",\"column\":" + string(d.column) + ",\"end_line\":" + string(d.end_line) + ",\"end_column\":" + string(d.end_column) + ",\"severity\":" + document_quote(d.level) + ",\"message\":" + document_quote(d.message) + ",\"measured\":" + string(d.measured) + ",\"threshold\":" + string(d.threshold) + ",\"remediation\":" + document_quote(d.remediation) + "}"


# Only explicit imports and private globals can be proven unused locally.
# Wildcard exports and public library globals stay available to consumers.
def lint_top_level(input: LintSource, library: bool, entries: list[Entry], output: list[LintDiagnostic], peers: list[LintSource] = []) -> unit | Error:
    candidates: list[int] = []
    for index in range(int(len(input.tokens)) - 1):
        if input.depths[index] != 0 or input.tokens[index].kind != lexer.TokenKind.Identifier:
            continue
        spelling = string(input.tokens[index])
        if spelling == "import" and input.tokens[index + 1].kind == lexer.TokenKind.Identifier:
            end := index + 1
            while end < int(len(input.tokens)) and input.tokens[end].kind != lexer.TokenKind.Newline:
                end += 1
            candidate := index + 1
            selective := false
            for cursor in range(index + 1, end):
                if string(input.tokens[cursor]) == "from" or string(input.tokens[cursor]) == ",":
                    selective = true
                if string(input.tokens[cursor]) == "as" and cursor + 1 < end:
                    candidate = cursor + 1
            if not selective:
                candidates.append(candidate)
        elif spelling.starts_with("_") or not library:
            previous = input.tokens[index - 1].kind if index > 0 else lexer.TokenKind.Newline
            if previous in [lexer.TokenKind.Newline, lexer.TokenKind.Dedent] and string(input.tokens[index + 1]) in ["=", ":=", "?=", ":"] and spelling not in ["else", "try", "finally"]:
                candidates.append(index)
    for index in candidates:
        name = string(input.tokens[index])
        if name.starts_with("_"):
            continue
        used := false
        for other in range(int(len(input.tokens))):
            used = used or (other != index and string(input.tokens[other]) == name and lint_read(input, other))
        for peer in peers:
            if peer.path == input.path:
                continue
            for other in range(int(len(peer.tokens))):
                used = used or (string(peer.tokens[other]) == name and lint_read(peer, other))
        if not used:
            lint_measure(input, index, 1, 3, entries, output)


# A terminator makes the remaining statements in its indentation block dead.
# This deliberately does not infer termination across conditions or loops.
def lint_unreachable(input: LintSource, callable: LintCallable, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    dead_depth := -1
    statement_start := true
    for index in range(callable.body, callable.end):
        token = input.tokens[index]
        if token.kind == lexer.TokenKind.Dedent:
            if input.depths[index] <= dead_depth:
                dead_depth = -1
            statement_start = true
        elif token.kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent]:
            statement_start = true
        elif statement_start and token.kind != lexer.TokenKind.Eof:
            if dead_depth >= 0:
                lint_measure(input, index, 1, 4, entries, output)
            elif token.kind == lexer.TokenKind.Identifier and string(token) in ["return", "throw", "break", "continue"]:
                dead_depth = input.depths[index]
            statement_start = false

# Documentation stays attached to the current declaration by source position;
# parameter names are compared on every pass, so signature edits invalidate it.
def lint_doc(input: LintSource, index: int) -> string:
    lines = input.text.split("\n")
    cursor := input.lines[index] - 2
    result := ""
    while cursor >= 0:
        text = lines[cursor].strip()
        if text.starts_with("@"):
            cursor -= 1
            continue
        if not text.starts_with("#") and text != "":
            break
        if text.starts_with("#"):
            result = text[1:].strip() + "\n" + result
        cursor -= 1
    return result.strip()

def lint_doc_section(document: string, heading: string) -> string:
    active := false
    lines: list[string] = []
    for line in document.split("\n"):
        if line.ends_with(":") and not line.starts_with("-"):
            if active:
                break
            active = line == heading + ":" or (line.starts_with(heading + " [") and line.ends_with("]:"))
        elif active and line != "":
            lines.append(line)
    return lines.join("\n")

# Bracketed documentation types are compared to the classified signature.
def lint_documented_type(label: string) -> string:
    if " [" in label and "]" in label:
        value = label.split(" [")[1:].join(" [")
        if value.ends_with("]:"):
            return value[:int(len(value)) - 2].replace(" ", "")
        if value.ends_with("]"):
            return value[:int(len(value)) - 1].replace(" ", "")
    return ""

def lint_signature_type(input: LintSource, start: int, end: int) -> string:
    result := ""
    depth := 0
    for cursor in range(start, end):
        token = string(input.tokens[cursor])
        if depth == 0 and token in [",", "=", ")", ":"]:
            break
        if token in ["[", "("]:
            depth += 1
        elif token in ["]", ")"]:
            depth -= 1
        result += token
    return result

def lint_documentation(input: LintSource, entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    for callable in input.callables:
        if callable.name.starts_with("_") or lint_test_file(input) or lint_in_test(input, callable.start):
            continue
        document = lint_doc(input, callable.start)
        complete := document != "" and not document.split("\n")[0].ends_with(":")
        for heading in ["Returns", "Errors", "Complexity"]:
            complete = complete and lint_doc_section(document, heading) != ""
        complete = complete and lint_doc_section(document, "Complexity").contains("O(")
        documented: list[string] = []
        for line in lint_doc_section(document, "Parameters").split("\n"):
            if line.starts_with("- ") and line.contains(":"):
                label = line[2:].split(":")[0].strip()
                name = label.split(" [")[0]
                documented_type = lint_documented_type(label)
                for parameter in callable.parameters:
                    if string(input.tokens[parameter]) == name and documented_type != "":
                        complete = complete and documented_type == lint_signature_type(input, parameter + 2, callable.body)
                complete = complete and name not in documented and line.split(":")[1:].join(":").strip() != ""
                documented.append(name)
        expected: list[string] = []
        for parameter in callable.parameters:
            expected.append(string(input.tokens[parameter]))
        for name in expected:
            complete = complete and name in documented
        for name in documented:
            complete = complete and name in expected
        result_type := "unit"
        for cursor in range(callable.start, callable.body):
            if string(input.tokens[cursor]) == "->":
                result_type = lint_signature_type(input, cursor + 1, callable.body)
        for line in document.split("\n"):
            if line.starts_with("Returns ["):
                complete = complete and lint_documented_type(line) == result_type
            elif line.starts_with("Errors ["):
                errors = lint_documented_type(line)
                for error_type in errors.split("|"):
                    complete = complete and (error_type == "None" or error_type in result_type.split("|"))
            elif line.starts_with("- @ref "):
                reference = line[7:].strip()
                known := false
                for token in input.tokens:
                    known = known or (token.kind == lexer.TokenKind.Identifier and string(token) == reference)
                complete = complete and known
        if not complete:
            lint_measure(input, callable.start, 1, 10, entries, output)
    for index in range(int(len(input.tokens)) - 1):
        if input.tokens[index].kind == lexer.TokenKind.Identifier and string(input.tokens[index]) == "class" and not string(input.tokens[index + 1]).starts_with("_") and not lint_test_file(input):
            document = lint_doc(input, index)
            if document == "" or lint_doc_section(document, "Responsibilities") == "" or lint_doc_section(document, "Invariants") == "":
                lint_measure(input, index, 1, 11, entries, output)

def lint_duplicates(inputs: list[LintSource], entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    implementations: list[string] = []
    for input in inputs:
        for callable in input.callables:
            body: list[string] = []
            for index in range(callable.body, callable.end):
                token = input.tokens[index]
                if token.kind in [lexer.TokenKind.Newline, lexer.TokenKind.Indent, lexer.TokenKind.Dedent, lexer.TokenKind.Eof]:
                    continue
                spelling := string(token)
                for parameter in range(int(len(callable.parameters))):
                    if token.kind == lexer.TokenKind.Identifier and spelling == string(input.tokens[callable.parameters[parameter]]):
                        spelling = "$parameter" + string(parameter)
                kind = "identifier" if token.kind == lexer.TokenKind.Identifier else "string" if token.kind == lexer.TokenKind.String else "token"
                body.append(kind + ":" + document_quote(spelling))
            if len(body) < 12:
                continue
            key = body.join(" ")
            low := 0
            high := int(len(implementations))
            while low < high:
                middle = (low + high) / 2
                if implementations[middle] < key:
                    low = middle + 1
                else:
                    high = middle
            if low < int(len(implementations)) and implementations[low] == key:
                lint_measure(input, callable.start, 1, 12, entries, output)
            else:
                implementations.append(key)
                cursor := int(len(implementations)) - 1
                while cursor > low:
                    implementations[cursor] = implementations[cursor - 1]
                    cursor -= 1
                implementations[low] = key

def lint_churn(project: Project, inputs: list[LintSource], entries: list[Entry], output: list[LintDiagnostic]) -> unit | Error:
    window = int(setting(entries, "quality", "revision-window", "0"))
    if window == 0:
        return
    if window > 10000:
        throw Error("quality revision window must be at most 10000 commits")
    history = capture(["git", "-C", project.root, "log", "-" + string(window), "--format=", "--name-only", "--relative", "--", "."])
    for input in inputs:
        count := 0
        for location in history.split("\n"):
            if location == input.path:
                count += 1
        lint_measure(input, 0, count, 13, entries, output)
