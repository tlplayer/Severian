import ffi
import "src/ffi.sev" as externs

def run(command: string) -> int:
    return externs.run(ffi.StringView(command))

def spawn(command: string) -> int:
    return externs.spawn(ffi.StringView(command))

def wait(process: int) -> int:
    return externs.wait(process)

def kill(process: int) -> bool:
    return externs.kill(process)

def exit(status: int = 0):
    externs.exit(status)

def native_handle(value: isize) -> ffi.Handle:
    return ffi.Handle(value)

def arguments() -> list[string]:
    output = ffi.OutHandle(0)
    if externs.arguments(output) != 0:
        return []
    values := []
    handle = native_handle(output.value)
    length = externs.arguments_length(handle)
    for index in range(length):
        values.append(externs.arguments_at(handle, index))
    externs.arguments_release(handle)
    return values

test "exit propagates status through an isolated child process":
    current = arguments()
    assert(size(current) > 0)
    if size(current) > 1 and current[1] == "--severian-process-exit-probe":
        exit(7)
    command = "\"" + current[0] + "\" --severian-process-exit-probe"
    assert(run(command) == 7)

test "commands spawn wait terminate and expose arguments":
    assert(run("exit 3") == 3)
    completed = spawn("exit 9")
    assert(completed > 0)
    assert(wait(completed) == 9)
    sleeping = spawn("exec sleep 30")
    assert(sleeping > 0)
    assert(kill(sleeping))
    assert(wait(sleeping) == 128)
    assert(size(arguments()) > 0)
