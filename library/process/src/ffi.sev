import ffi

unsafe:
    extern("sev_abi_v1_process_run") def run(command: ffi.StringView) -> i64
    extern("sev_abi_v1_process_spawn") def spawn(command: ffi.StringView) -> i64
    extern("sev_abi_v1_process_wait") def wait(process: i64) -> i64
    extern("sev_abi_v1_process_kill") def kill(process: i64) -> bool
    extern("sev_abi_v1_process_exit") def exit(status: i64)
    extern("sev_abi_v1_process_arguments") def arguments(output: ffi.OutHandle) -> i32
    extern("sev_abi_v1_process_arguments_length") def arguments_length(arguments: ffi.Handle) -> usize
    extern("sev_abi_v1_process_arguments_at") def arguments_at(arguments: ffi.Handle, index: usize) -> string
    extern("sev_abi_v1_process_arguments_release") def arguments_release(arguments: ffi.Handle)
