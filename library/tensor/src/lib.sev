import matrix

def tensor(values: list[float]) -> list[float]:
    return values

@matrix(X)
def matrixProduct(left: Matrix[f32], right: Matrix[f32]) -> Matrix[f32]:
    return left X right

def relu(values: list[float]) -> list[float]:
    output := []
    for value in values:
        if value > 0.0:
            output.append(value)
        else:
            output.append(0.0)
    return output

test "relu clips negative values":
    assert(relu([-2.0, 0.0, 3.0]) == [0.0, 0.0, 3.0])

def reluChunk(values: list[float], start: int, end: int) -> list[float]:
    output := []
    for index in range(start, end):
        value = values[index]
        if value > 0.0:
            output.append(value)
        else:
            output.append(0.0)
    return output

def parallelRelu(values: list[float]) -> list[float]:
    middle = size(values) / 2
    leftTask = async reluChunk(values, 0, middle) with self
    rightTask = async reluChunk(values, middle, size(values)) with self
    left = await leftTask
    right = await rightTask

    output := []
    for value in left:
        output.append(value)
    for value in right:
        output.append(value)
    return output

test "parallel relu preserves element order":
    assert(parallelRelu([-2.0, 3.0, -4.0, 5.0]) == [0.0, 3.0, 0.0, 5.0])

def matVec(
    weights: list[float],
    rows: int,
    columns: int,
    input: list[float],
) -> list[float]:
    output := []
    for row in range(0, rows):
        total := 0.0
        for column in range(0, columns):
            total += weights[row * columns + column] * input[column]
        output.append(total)
    return output

test "matrix vector product":
    result = matVec([1.0, 2.0, 3.0, 4.0], 2, 2, [5.0, 6.0])
    assert(result == [17.0, 39.0])

def add(left: list[float], right: list[float]) -> list[float]:
    output := []
    for index in indices(left):
        output.append(left[index] + right[index])
    return output

def reluJacobian(values: list[float]) -> list[float]:
    width = size(values)
    jacobian := []
    for row in range(0, width):
        for column in range(0, width):
            if row == column and values[row] > 0.0:
                jacobian.append(1.0)
            else:
                jacobian.append(0.0)
    return jacobian

test "relu jacobian is a flattened diagonal matrix":
    assert(reluJacobian([2.0, -1.0]) == [1.0, 0.0, 0.0, 0.0])

def absValue(value: float) -> float:
    if value < 0.0:
        return -value
    return value

def leakyRelu(values: list[float], slope: float = 0.01) -> list[float]:
    output := []
    for value in values:
        if value > 0.0:
            output.append(value)
        else:
            output.append(value * slope)
    return output

test "leaky relu retains a negative gradient":
    assert(leakyRelu([-2.0, 3.0], 0.5) == [-1.0, 3.0])

def fastSigmoidScalar(value: float) -> float:
    return 0.5 + value / (2.0 * (1.0 + absValue(value)))

def fastSigmoid(values: list[float]) -> list[float]:
    output := []
    for value in values:
        output.append(fastSigmoidScalar(value))
    return output

test "fast sigmoid is centered at one half":
    assert(fastSigmoid([0.0]) == [0.5])

def fastTanhScalar(value: float) -> float:
    return value / (1.0 + absValue(value))

def fastTanh(values: list[float]) -> list[float]:
    output := []
    for value in values:
        output.append(fastTanhScalar(value))
    return output

test "fast tanh is centered at zero":
    assert(fastTanh([0.0]) == [0.0])

def geluScalar(value: float) -> float:
    cubic = value ** 3
    curved = 0.7978845608 * (value + 0.044715 * cubic)
    return 0.5 * value * (1.0 + fastTanhScalar(curved))

def gelu(values: list[float]) -> list[float]:
    output := []
    for value in values:
        output.append(geluScalar(value))
    return output

test "gelu preserves the origin":
    assert(gelu([0.0]) == [0.0])

def swish(values: list[float]) -> list[float]:
    output := []
    for value in values:
        output.append(value * fastSigmoidScalar(value))
    return output

test "swish preserves the origin":
    assert(swish([0.0]) == [0.0])

def reluBackward(input: list[float], upstream: list[float]) -> list[float]:
    gradient := []
    for index in indices(input):
        if input[index] > 0.0:
            gradient.append(upstream[index])
        else:
            gradient.append(0.0)
    return gradient

def reluBackwardChunk(
    input: list[float],
    upstream: list[float],
    start: int,
    end: int,
) -> list[float]:
    gradient := []
    for index in range(start, end):
        if input[index] > 0.0:
            gradient.append(upstream[index])
        else:
            gradient.append(0.0)
    return gradient

test "relu backward masks inactive values":
    assert(reluBackward([-2.0, 3.0], [1.0, 1.0]) == [0.0, 1.0])

def leakyReluBackward(
    input: list[float],
    upstream: list[float],
    slope: float = 0.01,
) -> list[float]:
    gradient := []
    for index in indices(input):
        if input[index] > 0.0:
            gradient.append(upstream[index])
        else:
            gradient.append(upstream[index] * slope)
    return gradient

def fastSigmoidJacobian(values: list[float]) -> list[float]:
    width = size(values)
    jacobian := []
    for row in range(0, width):
        for column in range(0, width):
            if row == column:
                scale = 1.0 + absValue(values[row])
                jacobian.append(1.0 / (2.0 * scale * scale))
            else:
                jacobian.append(0.0)
    return jacobian

test "sigmoid jacobian contains the centered derivative":
    assert(fastSigmoidJacobian([0.0, 0.0]) == [0.5, 0.0, 0.0, 0.5])
