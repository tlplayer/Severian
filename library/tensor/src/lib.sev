import path

class Tensor[T]:
    handle: string

def element_count(shape: list[int]) -> int:
    count := 1
    for dimension in shape:
        assert(dimension >= 0)
        count *= dimension
    return count

class SafeTensorEntry:
    store_handle: int
    name: string
    dtype: string
    shape: list[int]
    byte_start: int
    byte_end: int
    shard: string

    def elements() -> int:
        return element_count(shape)

    def bytes() -> int:
        return byte_end - byte_start

class SafeTensorStore:
    path: string
    handle: int

@c(symbol = "__sev_safetensor_open")
def safetensor_open(path: string) -> int

@c(symbol = "__sev_safetensor_close")
def safetensor_close(handle: int) -> i32

@c(symbol = "__sev_safetensor_dtype")
def safetensor_dtype(handle: int, name: string) -> string

@compile(mlir, stablehlo, xla)
def safetensor_shape(handle: int, name: string) -> list[int]

@c(symbol = "__sev_safetensor_byte_start")
def safetensor_byte_start(handle: int, name: string) -> int

@c(symbol = "__sev_safetensor_byte_end")
def safetensor_byte_end(handle: int, name: string) -> int

def open_safetensors(location: string) -> SafeTensorStore:
    selected = location if location.ends_with(".safetensors") else location + "/model.safetensors"
    assert(path.exists(selected), "SafeTensor artifact does not exist: " + selected)
    handle = safetensor_open(selected)
    assert(handle != 0, "SafeTensor artifact is invalid: " + selected)
    return SafeTensorStore(selected, handle)

def close_safetensors(store: SafeTensorStore) -> bool:
    return safetensor_close(store.handle) == 0

def entry(store: SafeTensorStore, name: string) -> SafeTensorEntry:
    dtype = safetensor_dtype(store.handle, name)
    assert(dtype != "", "SafeTensor has no tensor named " + name)
    shape = safetensor_shape(store.handle, name)
    byte_start = safetensor_byte_start(store.handle, name)
    byte_end = safetensor_byte_end(store.handle, name)
    assert(byte_start >= 0 and byte_end >= byte_start, "SafeTensor offsets are invalid for " + name)
    return SafeTensorEntry(store.handle, name, dtype, shape, byte_start, byte_end, store.path)

def validate_entry(value: SafeTensorEntry, expected: string, width: int):
    assert(value.dtype == expected or (expected == "F8_E4M3FN" and value.dtype == "F8_E4M3"), "SafeTensor dtype mismatch for " + value.name)
    assert(value.byte_end - value.byte_start == element_count(value.shape) * width, "SafeTensor byte length does not match its shape")

@compile(mlir, stablehlo, xla)
def mapped_i8(handle: int, name: string) -> Tensor[i8]
@compile(mlir, stablehlo, xla)
def mapped_i16(handle: int, name: string) -> Tensor[i16]
