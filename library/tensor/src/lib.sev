import file
import json

class SafeTensorEntry:
    name: string
    dtype: string
    shape: list[int]
    byteStart: int
    byteEnd: int
    shard: string
    mapping: Any

    def bf16() -> Tensor[bf16]:
        assert(dtype == "BF16")
        elements := 1
        for dimension in shape:
            assert(dimension >= 0)
            elements *= dimension
        assert(byteEnd - byteStart == elements * 2)
        return mappedBf16(mapping, byteStart, shape)

    def bytes() -> int:
        return byteEnd - byteStart

class SafeTensorStore:
    modelDirectory: string
    weightMap: Any
    loadedShardNames: list[string]
    loadedMappings: list[Any]
    loadedHeaders: list[Any]
    loadedDataStarts: list[int]

    def keys() -> list[string]:
        return json.objectKeys(weightMap)

    def get(name: string) -> Result[SafeTensorEntry, IOError]:
        shard = json.asString(json.objectGet(weightMap, name))
        shardIndex := -1
        for index in indices(loadedShardNames):
            if loadedShardNames[index] == shard:
                shardIndex = index
        if shardIndex < 0:
            path = modelDirectory + "/" + shard
            handle ?= file.open(path)
            prefix ?= file.readExact(handle, 8)
            headerLength = file.littleEndianU64(prefix)
            headerBytes ?= file.readExact(handle, headerLength)
            headerText ?= file.utf8(headerBytes)
            closed ?= file.close(handle)
            header ?= json.decode[Any](headerText)
            mapping ?= file.map(path)
            loadedShardNames.append(shard)
            loadedMappings.append(mapping)
            loadedHeaders.append(header)
            loadedDataStarts.append(8 + headerLength)
            shardIndex = size(loadedShardNames) - 1
        header = loadedHeaders[shardIndex]
        mapping = loadedMappings[shardIndex]
        metadata = json.objectGet(header, name)
        dtype = json.asString(json.objectGet(metadata, "dtype"))
        shape = json.asIntList(json.objectGet(metadata, "shape"))
        offsets = json.asIntList(json.objectGet(metadata, "data_offsets"))
        assert(size(offsets) == 2)
        dataStart = loadedDataStarts[shardIndex]
        byteStart = dataStart + offsets[0]
        byteEnd = dataStart + offsets[1]
        assert(byteStart >= dataStart)
        assert(byteEnd >= byteStart)
        assert(byteEnd <= file.mappedBytes(mapping))
        return SafeTensorEntry(name, dtype, shape, byteStart, byteEnd, shard, mapping)

def openSafetensors(modelDirectory: string) -> Result[SafeTensorStore, IOError]:
    indexText ?= file.read(modelDirectory + "/model.safetensors.index.json")
    index ?= json.decode[Any](indexText)
    weightMap = json.objectGet(index, "weight_map")
    return SafeTensorStore(modelDirectory, weightMap, [], [], [], [])

