def mapped_f64(handle: int, name: string) -> Tensor[f64]
@compile(mlir, stablehlo, xla)
def mapped_f128(handle: int, name: string) -> Tensor[f128]

def load_i8(value: SafeTensorEntry) -> Tensor[i8]:
    validate_entry(value, "I8", 1)
    return mapped_i8(value.store_handle, value.name)
def load_i16(value: SafeTensorEntry) -> Tensor[i16]:
    validate_entry(value, "I16", 2)
    return mapped_i16(value.store_handle, value.name)
def load_i32(value: SafeTensorEntry) -> Tensor[i32]:
    validate_entry(value, "I32", 4)
    return mapped_i32(value.store_handle, value.name)
def load_i64(value: SafeTensorEntry) -> Tensor[i64]:
    validate_entry(value, "I64", 8)
    return mapped_i64(value.store_handle, value.name)
def load_i128(value: SafeTensorEntry) -> Tensor[i128]:
    validate_entry(value, "I128", 16)
    return mapped_i128(value.store_handle, value.name)
def load_u8(value: SafeTensorEntry) -> Tensor[u8]:
    validate_entry(value, "U8", 1)
    return mapped_u8(value.store_handle, value.name)
def load_u16(value: SafeTensorEntry) -> Tensor[u16]:
    validate_entry(value, "U16", 2)
    return mapped_u16(value.store_handle, value.name)
def load_u32(value: SafeTensorEntry) -> Tensor[u32]:
    validate_entry(value, "U32", 4)
    return mapped_u32(value.store_handle, value.name)
def load_u64(value: SafeTensorEntry) -> Tensor[u64]:
    validate_entry(value, "U64", 8)
    return mapped_u64(value.store_handle, value.name)
def load_u128(value: SafeTensorEntry) -> Tensor[u128]:
    validate_entry(value, "U128", 16)
    return mapped_u128(value.store_handle, value.name)
def load_f8e4m3fn(value: SafeTensorEntry) -> Tensor[f8e4m3fn]:
    validate_entry(value, "F8_E4M3FN", 1)
    return mapped_f8e4m3fn(value.store_handle, value.name)
def load_f8e5m2(value: SafeTensorEntry) -> Tensor[f8e5m2]:
    validate_entry(value, "F8_E5M2", 1)
    return mapped_f8e5m2(value.store_handle, value.name)
def load_f16(value: SafeTensorEntry) -> Tensor[f16]:
    validate_entry(value, "F16", 2)
    return mapped_f16(value.store_handle, value.name)
def load_bf16(value: SafeTensorEntry) -> Tensor[bf16]:
    validate_entry(value, "BF16", 2)
    return mapped_bf16(value.store_handle, value.name)
def load_f32(value: SafeTensorEntry) -> Tensor[f32]:
    validate_entry(value, "F32", 4)
    return mapped_f32(value.store_handle, value.name)
def load_f64(value: SafeTensorEntry) -> Tensor[f64]:
    validate_entry(value, "F64", 8)
    return mapped_f64(value.store_handle, value.name)
def load_f128(value: SafeTensorEntry) -> Tensor[f128]:
    validate_entry(value, "F128", 16)
    return mapped_f128(value.store_handle, value.name)

