import file
import json

class SafeTensorEntry:
    name: string
    dtype: string
    shape: list[int]
    byte_start: int
    byte_end: int
    shard: string
    mapping: Any

    def bf16() -> Tensor[bf16]:
        assert(dtype == "BF16")
        elements := 1
        for dimension in shape:
            assert(dimension >= 0)
            elements *= dimension
        assert(byte_end - byte_start == elements * 2)
        return mapped_bf_16(mapping, byte_start, shape)

    def bytes() -> int:
        return byte_end - byte_start

class SafeTensorStore:
    model_directory: string
    weight_map: Any
    loaded_shard_names: list[string]
    loaded_mappings: list[Any]
    loaded_headers: list[Any]
    loaded_data_starts: list[int]

    def keys() -> list[string]:
        return json.object_keys(weight_map)

    def get(name: string) -> Result[SafeTensorEntry, IOError]:
        shard = json.as_string(json.object_get(weight_map, name))
        shard_index := -1
        for index in indices(loaded_shard_names):
            if loaded_shard_names[index] == shard:
                shard_index = index
        if shard_index < 0:
            path = model_directory + "/" + shard
            handle = file.open(path)
            prefix = file.read_exact(handle, 8)
            header_length = file.little_endian_u64(prefix)
            header_bytes = file.read_exact(handle, header_length)
            header_text = file.utf8(header_bytes)
            closed = file.close(handle)
            header = json.decode[Any](header_text)
            mapping = file.map(path)
            loaded_shard_names.append(shard)
            loaded_mappings.append(mapping)
            loaded_headers.append(header)
            loaded_data_starts.append(8 + header_length)
            shard_index = size(loaded_shard_names) - 1
        header = loaded_headers[shard_index]
        mapping = loaded_mappings[shard_index]
        metadata = json.object_get(header, name)
        dtype = json.as_string(json.object_get(metadata, "dtype"))
        shape = json.as_int_list(json.object_get(metadata, "shape"))
        offsets = json.as_int_list(json.object_get(metadata, "data_offsets"))
        assert(size(offsets) == 2)
        data_start = loaded_data_starts[shard_index]
        byte_start = data_start + offsets[0]
        byte_end = data_start + offsets[1]
        assert(byte_start >= data_start)
        assert(byte_end >= byte_start)
        assert(byte_end <= file.mapped_bytes(mapping))
        return SafeTensorEntry(name, dtype, shape, byte_start, byte_end, shard, mapping)

def open_safetensors(model_directory: string) -> Result[SafeTensorStore, IOError]:
    index_file = file.read(model_directory + "/model.safetensors.index.json")
    index = index_file.value()
    weight_map = json.object_get(index, "weight_map")
    return SafeTensorStore(model_directory, weight_map, [], [], [], [])

unsafe:
    # Backend handle construction and lifetime live at the tensor boundary.
    # Consumers use these typed APIs and never redeclare XLA symbols.
    native("__sev_xla_i64_token") def from_i64_token(value: int) -> Tensor[i64, 1, 1]
