@compile(mlir, stablehlo, xla)
def mapped_u8(handle: int, name: string) -> Tensor[u8]
@compile(mlir, stablehlo, xla)
def mapped_u16(handle: int, name: string) -> Tensor[u16]
@compile(mlir, stablehlo, xla)
def mapped_u32(handle: int, name: string) -> Tensor[u32]
@compile(mlir, stablehlo, xla)
def mapped_u64(handle: int, name: string) -> Tensor[u64]
@compile(mlir, stablehlo, xla)
def mapped_u128(handle: int, name: string) -> Tensor[u128]
