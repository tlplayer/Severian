class Tensor[T]:
    handle: string


@compile(mlir, stablehlo, xla)
def tensor(values: list[float], shape: list[int]) -> Tensor[f64]

@compile(mlir, stablehlo, xla)
def shape[T](value: Tensor[T]) -> list[int]
@compile(mlir, stablehlo, xla)
def values[T](value: Tensor[T]) -> list[float]
@compile(mlir, stablehlo, xla)
def strides[T](value: Tensor[T]) -> list[int]

@compile(mlir, stablehlo, xla)
def slice[T](value: Tensor[T], starts: list[int], ends: list[int], steps: list[int]) -> Tensor[T]
@compile(mlir, stablehlo, xla)
def materialize[T](value: Tensor[T]) -> Tensor[T]

@compile(mlir, stablehlo, xla)
def add[T](left: Tensor[T], right: Tensor[T]) -> Tensor[T]
@compile(mlir, stablehlo, xla)
def subtract[T](left: Tensor[T], right: Tensor[T]) -> Tensor[T]
@compile(mlir, stablehlo, xla)
def multiply[T](left: Tensor[T], right: Tensor[T]) -> Tensor[T]
@compile(mlir, stablehlo, xla)
def divide[T](left: Tensor[T], right: Tensor[T]) -> Tensor[T]
@compile(mlir, stablehlo, xla)
def sum[T](value: Tensor[T]) -> Tensor[T]
@compile(mlir, stablehlo, xla)
def matmul[T](left: Tensor[T], right: Tensor[T]) -> Tensor[T]
@compile(mlir, stablehlo, xla)
def transpose[T](value: Tensor[T]) -> Tensor[T]

