class Handle:
    opaque: Any

class BytesView:
    data: list[int]

class OutHandle:
    value: Any

class OutError:
    code: int
    message: string

class OutUsize:
    value: int

unsafe:
    native("sev_abi_v1_network_connect") def connect_raw(host: string, port: u16, connection: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_listen") def listen_raw(host: string, port: u16, listener: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_accept") def accept(listener: Handle, connection: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_read") def read(connection: Handle, count: usize, bytes: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_write") def write(connection: Handle, data: BytesView, written: OutUsize, error: OutError) -> i32
    native("sev_abi_v1_network_close") def close(connection: Handle, error: OutError) -> i32
    native("sev_abi_v1_network_descriptor") def descriptor(connection: Handle) -> i32
    native("sev_abi_v1_network_listener_close") def listener_close(listener: Handle, error: OutError) -> i32
    native("sev_abi_v1_network_local_address") def local_address(connection: Handle, address: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_remote_address") def remote_address(connection: Handle, address: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_listener_address") def listener_address(listener: Handle, address: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_set_read_timeout") def set_read_timeout(connection: Handle, milliseconds: u64, error: OutError) -> i32
    native("sev_abi_v1_network_set_write_timeout") def set_write_timeout(connection: Handle, milliseconds: u64, error: OutError) -> i32
    native("sev_abi_v1_network_set_keep_alive") def set_keep_alive(connection: Handle, enabled: bool, error: OutError) -> i32
    native("sev_abi_v1_network_shutdown") def shutdown(connection: Handle, direction: i32, error: OutError) -> i32

    native("sev_abi_v1_network_address_host") def address_host(address: Handle) -> string
    native("sev_abi_v1_network_address_port") def address_port(address: Handle) -> u16
    native("sev_abi_v1_network_address_family") def address_family(address: Handle) -> i32
    native("sev_abi_v1_network_address_release") def address_release(address: Handle)

    native("sev_abi_v1_network_bytes_length") def bytes_length(bytes: Handle) -> usize
    native("sev_abi_v1_network_bytes_at") def bytes_at(bytes: Handle, index: usize) -> u8
    native("sev_abi_v1_network_bytes_release") def bytes_release(bytes: Handle)

    native("sev_abi_v1_network_resolve") def resolve_raw(host: string, addresses: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_address_list_length") def address_list_length(addresses: Handle) -> usize
    native("sev_abi_v1_network_address_list_at") def address_list_at(addresses: Handle, index: usize) -> string
    native("sev_abi_v1_network_address_list_release") def address_list_release(addresses: Handle)
    native("sev_abi_v1_network_parse_ip") def parse_ip_raw(value: string, address: OutHandle, error: OutError) -> i32

    native("sev_abi_v1_network_udp_bind") def udp_bind_raw(host: string, port: u16, socket: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_udp_send_to") def udp_send_to(socket: Handle, data: BytesView, host: string, port: u16, sent: OutUsize, error: OutError) -> i32
    native("sev_abi_v1_network_udp_receive_from") def udp_receive_from(socket: Handle, count: usize, packet: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_udp_close") def udp_close(socket: Handle, error: OutError) -> i32
    native("sev_abi_v1_network_packet_length") def packet_length(packet: Handle) -> usize
    native("sev_abi_v1_network_packet_at") def packet_at(packet: Handle, index: usize) -> u8
    native("sev_abi_v1_network_packet_host") def packet_host(packet: Handle) -> string
    native("sev_abi_v1_network_packet_port") def packet_port(packet: Handle) -> u16
    native("sev_abi_v1_network_packet_release") def packet_release(packet: Handle)

    native("sev_abi_v1_network_loopback_echo") def loopback_echo_raw(message: string, text: OutHandle, error: OutError) -> i32
    native("sev_abi_v1_network_text_value") def text_value(text: Handle) -> string
    native("sev_abi_v1_network_text_release") def text_release(text: Handle)
