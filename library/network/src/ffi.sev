class Handle:
    opaque: isize

class StringView:
    data: string

class BytesView:
    data: list[int]

class OutHandle:
    value: isize

class OutError:
    code: i32
    message: string

class OutUsize:
    value: usize
def connect_raw(host: StringView, port: u16, connection: OutHandle, error: OutError) -> i32
def listen_raw(host: StringView, port: u16, listener: OutHandle, error: OutError) -> i32
def accept(listener: Handle, connection: OutHandle, error: OutError) -> i32
def read(connection: Handle, count: usize, bytes: OutHandle, error: OutError) -> i32
def write(connection: Handle, data: BytesView, written: OutUsize, error: OutError) -> i32
def close(connection: Handle, error: OutError) -> i32
def descriptor(connection: Handle) -> i32
def listener_close(listener: Handle, error: OutError) -> i32
def local_address(connection: Handle, address: OutHandle, error: OutError) -> i32
def remote_address(connection: Handle, address: OutHandle, error: OutError) -> i32
def listener_address(listener: Handle, address: OutHandle, error: OutError) -> i32
def set_read_timeout(connection: Handle, milliseconds: u64, error: OutError) -> i32
def set_write_timeout(connection: Handle, milliseconds: u64, error: OutError) -> i32
def set_keep_alive(connection: Handle, enabled: bool, error: OutError) -> i32
def shutdown(connection: Handle, direction: i32, error: OutError) -> i32

def address_host(address: Handle) -> string
def address_port(address: Handle) -> u16
def address_family(address: Handle) -> i32
def address_release(address: Handle)

def bytes_length(bytes: Handle) -> usize
def bytes_at(bytes: Handle, index: usize) -> u8
def bytes_release(bytes: Handle)

def resolve_raw(host: StringView, addresses: OutHandle, error: OutError) -> i32
def address_list_length(addresses: Handle) -> usize
def address_list_at(addresses: Handle, index: usize) -> string
def address_list_release(addresses: Handle)
def parse_ip_raw(value: StringView, address: OutHandle, error: OutError) -> i32

def udp_bind_raw(host: StringView, port: u16, socket: OutHandle, error: OutError) -> i32
def udp_send_to(socket: Handle, data: BytesView, host: StringView, port: u16, sent: OutUsize, error: OutError) -> i32
def udp_receive_from(socket: Handle, count: usize, packet: OutHandle, error: OutError) -> i32
def udp_close(socket: Handle, error: OutError) -> i32
def packet_length(packet: Handle) -> usize
def packet_at(packet: Handle, index: usize) -> u8
def packet_host(packet: Handle) -> string
def packet_port(packet: Handle) -> u16
def packet_release(packet: Handle)

def loopback_echo_raw(message: StringView, text: OutHandle, error: OutError) -> i32
def text_value(text: Handle) -> string
def text_release(text: Handle)

@c(symbol = "sev_abi_v1_network_connect_simple")
def connect_simple(host: string, port: int) -> isize

@c(symbol = "sev_abi_v1_network_listen_simple")
def listen_simple(host: string, port: int) -> isize

@c(symbol = "sev_abi_v1_network_accept_simple")
def accept_simple(listener: isize) -> isize

@c(symbol = "sev_abi_v1_network_read_text_simple")
def read_text_simple(connection: isize, count: int) -> string

@c(symbol = "sev_abi_v1_network_write_text_simple")
def write_text_simple(connection: isize, data: string) -> int

@c(symbol = "sev_abi_v1_network_shutdown_simple")
def shutdown_simple(connection: isize, direction: int) -> int

@c(symbol = "sev_abi_v1_network_close_simple")
def close_simple(handle: isize) -> int

@c(symbol = "sev_abi_v1_network_loopback_echo_simple")
def loopback_echo_simple(message: string) -> string
