import ffi
import io
import "src/ffi.sev" as externs

class NetworkError:
    message: string
    code: int = -1

class Ip:
    value: string
    family: int

    def string() -> string:
        return value

class Address:
    host: string
    port: int

    def display() -> string:
        return "[" + host + "]:" + string(port) if host.contains(":") else host + ":" + string(port)

def new_error() -> ffi.OutError:
    return ffi.OutError(0, "")

def network_error(error: ffi.OutError) -> NetworkError:
    return NetworkError(error.message, error.code)

def stream_error(error: ffi.OutError) -> io.StreamError:
    return io.StreamError(error.message)

def valid_port(port: int) -> bool:
    return port >= 0 and port <= 65535

def native_handle(value: isize) -> ffi.Handle:
    return ffi.Handle(value)

def bytes_from(handle: isize) -> list[int]:
    output := []
    length = externs.bytes_length(native_handle(handle))
    for index in range(length):
        output.append(externs.bytes_at(native_handle(handle), index))
    externs.bytes_release(native_handle(handle))
    return output

def address_from(handle: isize) -> Address:
    address = Address(externs.address_host(native_handle(handle)), externs.address_port(native_handle(handle)))
    externs.address_release(native_handle(handle))
    return address

def parse_ip(value: string) -> Ip | NetworkError:
    output = ffi.OutHandle(0)
    error = new_error()
    if externs.parse_ip_raw(ffi.StringView(value), output, error) != 0:
        return error(network_error(error))
    parsed = Ip(externs.address_host(native_handle(output.value)), externs.address_family(native_handle(output.value)))
    externs.address_release(native_handle(output.value))
    return parsed

class TcpConnection:
    handle: isize

    def read(count: int) -> Result[list[int], io.StreamError]:
        if count < 0:
            return error(io.StreamError("read count cannot be negative"))
        output = ffi.OutHandle(0)
        error = new_error()
        if externs.read(native_handle(handle), count, output, error) != 0:
            return error(stream_error(error))
        return bytes_from(output.value)

    def write(data: list[int]) -> int | io.StreamError:
        for value in data:
            if value < 0 or value > 255:
                return error(io.StreamError("network bytes must be between 0 and 255"))
        written = ffi.OutUsize(0)
        error = new_error()
        if externs.write(native_handle(handle), ffi.BytesView(data), written, error) != 0:
            return error(stream_error(error))
        return written.value

    def read_exact(count: int) -> Result[list[int], io.StreamError]:
        if count < 0:
            return error(io.StreamError("read count cannot be negative"))
        output := []
        while size(output) < count:
            chunk = self.read(count - size(output))
            if size(chunk) == 0:
                return error(io.StreamError("stream ended before the requested byte count"))
            output.extend(chunk)
        return output

    def write_all(data: list[int]) -> int | io.StreamError:
        offset := 0
        while offset < size(data):
            written = self.write(data[offset:size(data)])
            if written <= 0:
                return error(io.StreamError("stream accepted no bytes"))
            offset += written
        return offset

    def close() -> unit | io.StreamError:
        error = new_error()
        if externs.close(native_handle(handle), error) != 0:
            return error(stream_error(error))
        handle = 0
        return

    def local_address() -> Address | NetworkError:
        output = ffi.OutHandle(0)
        error = new_error()
        if externs.local_address(native_handle(handle), output, error) != 0:
            return error(network_error(error))
        return address_from(output.value)

    def remote_address() -> Address | NetworkError:
        output = ffi.OutHandle(0)
        error = new_error()
        if externs.remote_address(native_handle(handle), output, error) != 0:
            return error(network_error(error))
        return address_from(output.value)

    def set_read_timeout(milliseconds: int) -> unit | NetworkError:
        if milliseconds < 0:
            return error(NetworkError("timeout cannot be negative"))
        error = new_error()
        if externs.set_read_timeout(native_handle(handle), milliseconds, error) != 0:
            return error(network_error(error))
        return

    def set_write_timeout(milliseconds: int) -> unit | NetworkError:
        if milliseconds < 0:
            return error(NetworkError("timeout cannot be negative"))
        error = new_error()
        if externs.set_write_timeout(native_handle(handle), milliseconds, error) != 0:
            return error(network_error(error))
        return

    def set_keep_alive(enabled: bool) -> unit | NetworkError:
        error = new_error()
        if externs.set_keep_alive(native_handle(handle), enabled, error) != 0:
            return error(network_error(error))
        return

    def shutdown_read() -> unit | NetworkError:
        error = new_error()
        if externs.shutdown(native_handle(handle), 0, error) != 0:
            return error(network_error(error))
        return

    def shutdown_write() -> unit | NetworkError:
        error = new_error()
        if externs.shutdown(native_handle(handle), 1, error) != 0:
            return error(network_error(error))
        return

    def native_handle() -> isize:
        return handle

class TcpListener:
    handle: isize

    def accept() -> TcpConnection | NetworkError:
        output = ffi.OutHandle(0)
        error = new_error()
        if externs.accept(native_handle(handle), output, error) != 0:
            return error(network_error(error))
        return TcpConnection(output.value)

    def local_address() -> Address | NetworkError:
        output = ffi.OutHandle(0)
        error = new_error()
        if externs.listener_address(native_handle(handle), output, error) != 0:
            return error(network_error(error))
        return address_from(output.value)

    def close() -> unit | NetworkError:
        error = new_error()
        if externs.listener_close(native_handle(handle), error) != 0:
            return error(network_error(error))
        handle = 0
        return

class Datagram:
    data: list[int]
    address: Address

class UdpConnection:
    handle: isize

    def send_to(data: list[int], host: string, port: int) -> int | NetworkError:
        if not valid_port(port):
            return error(NetworkError("invalid network port"))
        for value in data:
            if value < 0 or value > 255:
                return error(NetworkError("network bytes must be between 0 and 255"))
        sent = ffi.OutUsize(0)
        error = new_error()
        if externs.udp_send_to(native_handle(handle), ffi.BytesView(data), ffi.StringView(host), port, sent, error) != 0:
            return error(network_error(error))
        return sent.value

    def receive_from(count: int) -> Datagram | NetworkError:
        if count < 0:
            return error(NetworkError("receive count cannot be negative"))
        output = ffi.OutHandle(0)
        error = new_error()
        if externs.udp_receive_from(native_handle(handle), count, output, error) != 0:
            return error(network_error(error))
        data := []
        length = externs.packet_length(native_handle(output.value))
        for index in range(length):
            data.append(externs.packet_at(native_handle(output.value), index))
        address = Address(externs.packet_host(native_handle(output.value)), externs.packet_port(native_handle(output.value)))
        externs.packet_release(native_handle(output.value))
        return Datagram(data, address)

    def close() -> unit | NetworkError:
        error = new_error()
        if externs.udp_close(native_handle(handle), error) != 0:
            return error(network_error(error))
        handle = 0
        return

def connect(host: string, port: int) -> TcpConnection | NetworkError:
    if not valid_port(port):
        return error(NetworkError("invalid network port"))
    output = ffi.OutHandle(0)
    error = new_error()
    if externs.connect_raw(ffi.StringView(host), port, output, error) != 0:
        return error(network_error(error))
    return TcpConnection(output.value)

def listen(host: string, port: int) -> TcpListener | NetworkError:
    if not valid_port(port):
        return error(NetworkError("invalid network port"))
    output = ffi.OutHandle(0)
    error = new_error()
    if externs.listen_raw(ffi.StringView(host), port, output, error) != 0:
        return error(network_error(error))
    return TcpListener(output.value)

def resolve(host: string) -> Result[list[Ip], NetworkError]:
    output = ffi.OutHandle(0)
    error = new_error()
    if externs.resolve_raw(ffi.StringView(host), output, error) != 0:
        return error(network_error(error))
    values := []
    length = externs.address_list_length(native_handle(output.value))
    for index in range(length):
        value = externs.address_list_at(native_handle(output.value), index)
        parsed = parse_ip(value)
        values.append(parsed)
    externs.address_list_release(native_handle(output.value))
    return values

def udp_bind(host: string, port: int) -> UdpConnection | NetworkError:
    if not valid_port(port):
        return error(NetworkError("invalid network port"))
    output = ffi.OutHandle(0)
    error = new_error()
    if externs.udp_bind_raw(ffi.StringView(host), port, output, error) != 0:
        return error(network_error(error))
    return UdpConnection(output.value)

def loopback_echo(message: string) -> string | IOError:
    output = ffi.OutHandle(0)
    error = new_error()
    if externs.loopback_echo_raw(ffi.StringView(message), output, error) != 0:
        return error(IOError(error.message))
    echoed = externs.text_value(native_handle(output.value))
    externs.text_release(native_handle(output.value))
    return echoed

def echo_once(listener: TcpListener) -> unit | Any:
    match listener.accept():
        case connection:
            match connection.read_exact(2):
                case first:
                    match connection.read_exact(3):
                        case second:
                            match connection.write_all(first):
                                case first_written:
                                    assert(first_written == 2)
                                    match connection.write_all(second):
                                        case second_written:
                                            assert(second_written == 3)
                                            _closed = connection.close()
                                            _listener_closed = listener.close()
                                            return
                                        case error:
                                            return error(error)
                                case error:
                                    return error(error)
                        case error:
                            return error(error)
                case error:
                    return error(error)
        case error:
            return error(error)

test "IP and address values distinguish IPv4 and IPv6":
    ipv4 = parse_ip("127.0.0.1")
    ipv6 = parse_ip("::1")
    assert(ipv4.family == 4)
    assert(ipv6.family == 6)
    assert(Address("::1", 443).display() == "[::1]:443")

test with integ "native TCP loopback":
    match loopback_echo("severian network runtime"):
        case echoed:
            assert(echoed == "severian network runtime")
        case error:
            assert(false, error.message)

test with integ "TCP handles partial reads writes addresses timeouts and cleanup":
    listener = listen("127.0.0.1", 0)
    local = listener.local_address()
    server = async echo_once(listener) with self
    connection = connect(local.host, local.port)
    _read_timeout = connection.set_read_timeout(2000)
    _write_timeout = connection.set_write_timeout(2000)
    _keep_alive = connection.set_keep_alive(true)
    remote = connection.remote_address()
    assert(remote.port == local.port)
    sent = connection.write_all([1, 2, 3, 4, 5])
    assert(sent == 5)
    echoed = connection.read_exact(5)
    assert(echoed == [1, 2, 3, 4, 5])
    _closed = connection.close()
    await server

test with integ "DNS failures remain typed":
    match resolve(""):
        case _addresses:
            assert(false)
        case error:
            assert(error.code != 0)
