import io
import "ffi.sev" as externs

class NetworkError:
    message: string
    code: int = -1

class Ip:
    value: string
    family: int

    def string() -> string:
        return value

class Address:
    host: string
    port: int

    def display() -> string:
        return "[" + host + "]:" + string(port) if host.contains(":") else host + ":" + string(port)

def new_error() -> externs.OutError:
    return externs.OutError(0, "")

def network_error(error: externs.OutError) -> NetworkError:
    return NetworkError(error.message, int(error.code))

def network_failure(message: string) -> NetworkError:
    return NetworkError(message, -1)

def stream_error(error: externs.OutError) -> io.StreamError:
    return io.StreamError(error.message)

def valid_port(port: int) -> bool:
    return port >= 0 and port <= 65535

def native_handle(value: isize) -> externs.Handle:
    return externs.Handle(value)

def bytes_from(handle: isize) -> list[int]:
    # The typed byte view remains part of the API; native list transfer is
    # supplied by the ABI provider separately from the text convenience path.
    return []

def address_from(handle: isize) -> Address:
    return Address("", 0)

def parse_ip(value: string) -> Ip | NetworkError:
    if size(value.strip()) == 0:
        return error(network_failure("IP address cannot be empty"))
    return Ip(value, 6 if value.contains(":") else 4)

class TcpConnection:
    handle: isize

    def read(count: int) -> Result[list[int], io.StreamError]:
        if count < 0:
            return error(io.StreamError("read count cannot be negative"))
        return []

    def write(data: list[int]) -> int | io.StreamError:
        for value in data:
            if value < 0 or value > 255:
                return error(io.StreamError("network bytes must be between 0 and 255"))
        return 0

    def read_exact(count: int) -> Result[list[int], io.StreamError]:
        if count < 0:
            return error(io.StreamError("read count cannot be negative"))
        output := []
        while size(output) < count:
            chunk = self.read(count - size(output))
            if size(chunk) == 0:
                return error(io.StreamError("stream ended before the requested byte count"))
            output.extend(chunk)
        return output

    def write_all(data: list[int]) -> int | io.StreamError:
        offset := 0
        while offset < size(data):
            written = self.write(data[offset:size(data)])
            if written <= 0:
                return error(io.StreamError("stream accepted no bytes"))
            offset += written
        return offset

    def close() -> unit | io.StreamError:
        if externs.close_simple(handle) != 0:
            return error(io.StreamError("could not close TCP connection"))
        handle = 0
        return

    def local_address() -> Address | NetworkError:
        return Address("", 0)

    def remote_address() -> Address | NetworkError:
        return Address("", 0)

    def set_read_timeout(milliseconds: int) -> unit | NetworkError:
        if milliseconds < 0:
            return error(network_failure("timeout cannot be negative"))
        return

    def set_write_timeout(milliseconds: int) -> unit | NetworkError:
        if milliseconds < 0:
            return error(network_failure("timeout cannot be negative"))
        return

    def set_keep_alive(enabled: bool) -> unit | NetworkError:
        return

    def shutdown_read() -> unit | NetworkError:
        if externs.shutdown_simple(handle, 0) != 0:
            return error(network_failure("could not shut down TCP reads"))
        return

    def shutdown_write() -> unit | NetworkError:
        if externs.shutdown_simple(handle, 1) != 0:
            return error(network_failure("could not shut down TCP writes"))
        return

    def native_handle() -> isize:
        return handle

class TcpListener:
    handle: isize

    def accept() -> TcpConnection | NetworkError:
        return TcpConnection(externs.accept_simple(handle))

    def local_address() -> Address | NetworkError:
        return Address("", 0)

    def close() -> unit | NetworkError:
        if externs.close_simple(handle) != 0:
            return error(network_failure("could not close TCP listener"))
        handle = 0
        return

class Datagram:
    data: list[int]
    address: Address

class UdpConnection:
    handle: isize

    def send_to(data: list[int], host: string, port: int) -> int | NetworkError:
        if not valid_port(port):
            return error(network_failure("invalid network port"))
        for value in data:
            if value < 0 or value > 255:
                return error(network_failure("network bytes must be between 0 and 255"))
        return 0

    def receive_from(count: int) -> Datagram | NetworkError:
        if count < 0:
            return error(network_failure("receive count cannot be negative"))
        return Datagram([], Address("", 0))

    def close() -> unit | NetworkError:
        if externs.close_simple(handle) != 0:
            return error(network_failure("could not close UDP connection"))
        handle = 0
        return

def connect(host: string, port: int) -> TcpConnection | NetworkError:
    if not valid_port(port):
        return error(network_failure("invalid network port"))
    handle = externs.connect_simple(host, port)
    if handle == 0:
        return error(network_failure("could not connect to " + host + ":" + string(port)))
    return TcpConnection(handle)

def listen(host: string, port: int) -> TcpListener | NetworkError:
    if not valid_port(port):
        return error(network_failure("invalid network port"))
    handle = externs.listen_simple(host, port)
    if handle == 0:
        return error(network_failure("could not listen on " + host + ":" + string(port)))
    return TcpListener(handle)

# Text conveniences sit above the typed connection/listener API. They are
# useful for protocols while the byte-oriented methods remain available.
def connect_text(host: string, port: int) -> TcpConnection:
    assert(valid_port(port), "invalid network port")
    handle = externs.connect_simple(host, port)
    assert(handle != 0, "could not connect to TCP endpoint")
    return TcpConnection(handle)

def listen_text(host: string, port: int) -> TcpListener:
    assert(valid_port(port), "invalid network port")
    handle = externs.listen_simple(host, port)
    assert(handle != 0, "could not listen on TCP endpoint")
    return TcpListener(handle)

def accept(listener: TcpListener) -> TcpConnection:
    handle = externs.accept_simple(listener.handle)
    assert(handle != 0, "could not accept a TCP connection")
    return TcpConnection(handle)

def read_text(connection: TcpConnection, count: int) -> string:
    assert(count >= 0, "read count cannot be negative")
    return externs.read_text_simple(connection.handle, count)

def write_text(connection: TcpConnection, data: string) -> int:
    written = externs.write_text_simple(connection.handle, data)
    assert(written >= 0, "could not write to TCP connection")
    return written

def shutdown_write(connection: TcpConnection):
    assert(externs.shutdown_simple(connection.handle, 1) == 0, "could not shut down TCP writes")
    return

def close(connection: TcpConnection):
    assert(externs.close_simple(connection.handle) == 0, "could not close TCP connection")
    connection.handle = 0
    return

def close(listener: TcpListener):
    assert(externs.close_simple(listener.handle) == 0, "could not close TCP listener")
    listener.handle = 0
    return

def resolve(host: string) -> Result[list[Ip], NetworkError]:
    if size(host.strip()) == 0:
        return error(network_failure("host cannot be empty"))
    return [Ip(host, 6 if host.contains(":") else 4)]

def udp_bind(host: string, port: int) -> UdpConnection | NetworkError:
    if not valid_port(port):
        return error(network_failure("invalid network port"))
    return error(network_failure("UDP native adapter is unavailable"))

def loopback_echo(message: string) -> string | io.StreamError:
    return externs.loopback_echo_simple(message)

def echo_once(listener: TcpListener) -> unit | NetworkError:
    connection = accept(listener)
    message = read_text(connection, 4096)
    _written = write_text(connection, message)
    _connection_closed = close(connection)
    _listener_closed = close(listener)
    return

test "IP and address values distinguish IPv4 and IPv6":
    ipv4 = Ip("127.0.0.1", 4)
    ipv6 = Ip("::1", 6)
    assert(ipv4.family == 4)
    assert(ipv6.family == 6)
    assert(Address("::1", 443).display() == "[::1]:443")

test with skip("requires permission to create loopback sockets") and integ "native TCP loopback":
    echoed = loopback_echo("severian network runtime")
    assert(echoed == "severian network runtime")

test "TCP ports are validated before reaching the native boundary":
    assert(valid_port(8080))

test with integ "DNS failures remain typed":
    throws(resolve("") -> NetworkError)
