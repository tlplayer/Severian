import platform

def listen(address: string) -> Result[TCPListener, IOError]:
    return platform.network_listen(address)

def connect(address: string) -> Result[Any, IOError]:
    return platform.network_connect(address)

def accept(listener: TCPListener) -> Result[Any, IOError]:
    return platform.network_accept(listener)

def send(socket: Any, message: string) -> Result[int, IOError]:
    return platform.network_send(socket, message)

def receive(socket: Any, count: int = 4096) -> Result[string, IOError]:
    return platform.network_receive(socket, count)

def close(socket: Any) -> Result[unit, IOError]:
    return platform.network_close(socket)

def loopback_echo(message: string) -> Result[string, IOError]:
    return platform.network_loopback_echo(message)

# Compatibility alias for sources written before the snake-case API.
def loopbackEcho(message: string) -> Result[string, IOError]:
    return loopback_echo(message)

test with integration "native TCP loopback":
    switch loopback_echo("severian network runtime"):
        ok echoed:
            assert(echoed == "severian network runtime")
        failure error:
            assert(false, error)
