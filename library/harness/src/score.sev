def score_context(
    nodes,
    goal: str,
    task_id: int
):
    scored := []

    for node in nodes:
        goal_score := similarity(node, goal)
        task_score := task_similarity(node, task_id)
        graph_score := node.graph_weight()
        recency_score := node.recency()

        score := (
            goal_score * 0.40 +
            task_score * 0.30 +
            graph_score * 0.20 +
            recency_score * 0.10
        )

        scored.append((node, score))

    return scored.sort(reverse=True)