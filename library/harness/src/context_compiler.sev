def compile_context(
    goal: str,
    task_id: int,
    tasks,
    graph
) -> list[str]:

    path := tasks.path(task_id)

    dependencies := graph.dependencies(task_id)
    constraints := graph.constraints(task_id)
    evidence := graph.evidence(task_id)

    candidates := []

    candidates.append(goal)

    for node in path:
        candidates.append(node)

    for node in dependencies:
        candidates.append(node)

    for node in constraints:
        candidates.append(node)

    for node in evidence:
        candidates.append(node)

    ranked := score_context(
        candidates,
        goal,
        task_id
    )

    return fit_context(ranked, 32768)

def fit_context(nodes, max_tokens: int) -> list[str]:
    context := []
    used := 0

    for node, score in nodes:
        cost := token_count(node.content())

        if used + cost <= max_tokens:
            context.append(node.content())
            used += cost

    return context