import agent

class HarnessConfig:
    workspace: string
    goal: string
    verification_command: string
    state_path: string
    attempts: int

class HarnessStep:
    iteration: int
    action: string
    passed: bool
    output: string

class HarnessResult:
    passed: bool
    iterations: int
    message: string
    steps: list[HarnessStep]

def config(
    workspace: string,
    goal: string,
    verification_command: string,
    state_path: string,
    attempts: int,
) -> HarnessConfig:
    assert(workspace != "")
    assert(goal != "")
    assert(verification_command != "")
    assert(state_path != "")
    assert(attempts > 0)

    return HarnessConfig(
        workspace,
        goal,
        verification_command,
        state_path,
        attempts,
    )

def step(
    iteration: int,
    action: string,
    passed: bool,
    output: string,
) -> HarnessStep:
    return HarnessStep(
        iteration,
        action,
        passed,
        output,
    )

def successful(
    iterations: int,
    message: string,
    steps: list[HarnessStep],
) -> HarnessResult:
    return HarnessResult(
        true,
        iterations,
        message,
        steps,
    )

def failed(
    iterations: int,
    message: string,
    steps: list[HarnessStep],
) -> HarnessResult:
    return HarnessResult(
        false,
        iterations,
        message,
        steps,
    )

def verification_passed(result: agent.CommandResult) -> bool:
    return result.exit_code == 0 and not result.timed_out

def verification_error(result: agent.CommandResult) -> string:
    message := "verification failed"

    if result.timed_out:
        message = message + ": timeout"

    if result.exit_code != 0:
        message = message + ": exit " + string(result.exit_code)

    if result.stderr != "":
        message = message + "\n" + result.stderr

    if result.stdout != "":
        message = message + "\n" + result.stdout

    return message

def run_verification(
    harness: HarnessConfig,
    limits: agent.AgentLimits,
) -> agent.CommandResult:
    return agent.verify(
        harness.workspace,
        harness.verification_command,
        limits,
    )

def run_iteration(
    harness: HarnessConfig,
    iteration: int,
    model_config: agent.ModelConfig,
    limits: agent.AgentLimits,
) -> HarnessStep:
    result = agent.run_agent(
        harness.workspace,
        harness.goal,
        harness.verification_command,
        harness.state_path,
        model_config,
        limits,
    )

    if result.success:
        return step(
            iteration,
            "agent",
            true,
            result.message,
        )

    return step(
        iteration,
        "agent",
        false,
        result.message,
    )

def run(
    harness: HarnessConfig,
    model_config: agent.ModelConfig,
    limits: agent.AgentLimits,
) -> HarnessResult:
    steps := []

    initial = run_verification(harness, limits)

    if verification_passed(initial):
        steps.append(
            step(
                0,
                "initial verification",
                true,
                initial.stdout,
            )
        )

        return successful(
            0,
            "verification already passes",
            steps,
        )

    steps.append(
        step(
            0,
            "initial verification",
            false,
            verification_error(initial),
        )
    )

    for iteration in range(1, harness.attempts + 1):
        current = run_iteration(
            harness,
            iteration,
            model_config,
            limits,
        )

        steps.append(current)

        verification = run_verification(harness, limits)

        if verification_passed(verification):
            steps.append(
                step(
                    iteration,
                    "verification",
                    true,
                    verification.stdout,
                )
            )

            return successful(
                iteration,
                "harness completed successfully",
                steps,
            )

        steps.append(
            step(
                iteration,
                "verification",
                false,
                verification_error(verification),
            )
        )

    return failed(
        harness.attempts,
        "harness attempt limit reached",
        steps,
    )

def default_config(
    workspace: string,
    goal: string,
    verification_command: string,
) -> HarnessConfig:
    return config(
        workspace,
        goal,
        verification_command,
        workspace + "/.sev/harness-state.json",
        20,
    )

def run_default(
    workspace: string,
    goal: string,
    verification_command: string,
) -> HarnessResult:
    harness = default_config(
        workspace,
        goal,
        verification_command,
    )

    model_config = agent.default_model_config()
    limits = agent.default_agent_limits()

    return run(
        harness,
        model_config,
        limits,
    )

def summary(result: HarnessResult) -> string:
    text := "passed: " + string(result.passed)
    text = text + "\niterations: " + string(result.iterations)
    text = text + "\nmessage: " + result.message

    for current in result.steps:
        text = text + "\n"
        text = text + string(current.iteration)
        text = text + " "
        text = text + current.action
        text = text + " passed="
        text = text + string(current.passed)

        if current.output != "":
            text = text + "\n" + current.output

    return text

test "harness configuration preserves limits":
    harness = config(
        ".",
        "implement agent support",
        "sev test",
        ".sev/harness-state.json",
        5,
    )

    assert(harness.workspace == ".")
    assert(harness.goal == "implement agent support")
    assert(harness.verification_command == "sev test")
    assert(harness.attempts == 5)

test "successful harness result is explicit":
    steps = [
        step(
            1,
            "verification",
            true,
            "tests passed",
        )
    ]

    result = successful(
        1,
        "complete",
        steps,
    )

    assert(result.passed)
    assert(result.iterations == 1)
    assert(size(result.steps) == 1)

test "failed harness result is explicit":
    result = failed(
        3,
        "attempt limit reached",
        [],
    )

    assert(not result.passed)
    assert(result.iterations == 3)

test "verification requires zero exit and no timeout":
    passed = agent.CommandResult(
        "sev test",
        0,
        "passed",
        "",
        false,
    )

    failed_exit = agent.CommandResult(
        "sev test",
        1,
        "",
        "failed",
        false,
    )

    timed_out = agent.CommandResult(
        "sev test",
        0,
        "",
        "",
        true,
    )

    assert(verification_passed(passed))
    assert(not verification_passed(failed_exit))
    assert(not verification_passed(timed_out))
