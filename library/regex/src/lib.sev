import platform

def matches(text: string, pattern: string) -> bool:
    return platform.regex_matches(text, pattern)

def compile(pattern: string) -> string:
    return pattern

def match(pattern: string, text: string) -> bool:
    return platform.regex_matches(text, "^" + pattern)

def search(pattern: string, text: string) -> bool:
    return platform.regex_matches(text, pattern)

def findall(pattern: string, text: string) -> list[string]:
    return platform.regex_findall(text, pattern)

def split(pattern: string, text: string) -> list[string]:
    return platform.regex_split(text, pattern)

def sub(pattern: string, replacement: string, text: string) -> string:
    return platform.regex_sub(text, pattern, replacement)

test "POSIX extended matching":
    assert(matches("release-42", "^[a-z]+-[0-9]+$"))
    assert(not matches("release", "^[a-z]+-[0-9]+$"))

test "regex facade preserves pattern order and replacement behavior":
    assert(compile("[0-9]+") == "[0-9]+")
    assert(match("[a-z]+", "abc123"))
    assert(not match("[0-9]+", "abc123"))
    assert(search("[0-9]+", "abc123"))
    assert(findall("[0-9]+", "a12b34") == ["12", "34"])
    assert(split("[,:]", "a,b:c") == ["a", "b", "c"])
    assert(sub("[0-9]+", "#", "a12b34") == "a#b#")
