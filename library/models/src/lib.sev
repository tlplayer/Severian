import tensor

# A graph value has the same public tensor type as its eventual result, but it
# is only a symbolic node until runGraph crosses the execution boundary.
native("__sev_model_graph_input") def graphInput(value: Tensor[f64]) -> Tensor[f64]

native("__sev_model_graph_relu") def graphRelu(value: Tensor[f64]) -> Tensor[f64]

native("__sev_model_graph_add") def graphAdd(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]

native("__sev_model_graph_matmul") def graphMatmul(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]

native("__sev_model_graph_transpose") def graphTranspose(value: Tensor[f64]) -> Tensor[f64]

native("__sev_model_graph_scale") def graphScale(value: Tensor[f64], scale: float) -> Tensor[f64]

native("__sev_model_graph_softmax_rows") def graphSoftmaxRows(value: Tensor[f64]) -> Tensor[f64]

native("__sev_model_graph_layer_norm") def graphLayerNorm(value: Tensor[f64], epsilon: float = 0.00001) -> Tensor[f64]

native("__sev_model_graph_run") def runGraph(output: Tensor[f64]) -> Tensor[f64]

def transformerEncoderGraph(
    input: Tensor[f64],
    queryWeights: Tensor[f64],
    keyWeights: Tensor[f64],
    valueWeights: Tensor[f64],
    attentionOutputWeights: Tensor[f64],
    feedForwardInputWeights: Tensor[f64],
    feedForwardOutputWeights: Tensor[f64],
    attentionScale: float,
    epsilon: float = 0.00001,
) -> Tensor[f64]:
    X = graphInput(input)
    Wq = graphInput(queryWeights)
    Wk = graphInput(keyWeights)
    Wv = graphInput(valueWeights)
    Wo = graphInput(attentionOutputWeights)
    W1 = graphInput(feedForwardInputWeights)
    W2 = graphInput(feedForwardOutputWeights)

    queries = graphMatmul(X, Wq)
    keys = graphMatmul(X, Wk)
    values = graphMatmul(X, Wv)
    scores = graphScale(graphMatmul(queries, graphTranspose(keys)), attentionScale)
    attention = graphSoftmaxRows(scores)
    context = graphMatmul(attention, values)
    attentionOutput = graphMatmul(context, Wo)
    normalized = graphLayerNorm(graphAdd(X, attentionOutput), epsilon)
    hidden = graphRelu(graphMatmul(normalized, W1))
    projected = graphMatmul(hidden, W2)
    return graphLayerNorm(graphAdd(normalized, projected), epsilon)

test "model graphs execute shared tensor structure":
    input = ranked([1.0, 2.0, 3.0, 4.0], [2, 2])
    weights = ranked([1.0, 0.0, 0.0, 1.0], [2, 2])
    X = graphInput(input)
    W = graphInput(weights)
    output = runGraph(graphAdd(graphMatmul(X, W), X))
    assert(rankedValues(output) == [2.0, 4.0, 6.0, 8.0])

def reluValue(x: float) -> float:
    return 0.0 if x < 0.0 else x

test "scalar ReLU follows its piecewise definition":
    assert(reluValue(-2.0) == 0.0)
    assert(reluValue(3.0) == 3.0)

def reluDerivative(x: float) -> float:
    return 0.0 if x <= 0.0 else 1.0

test "ReLU derivative chooses zero at the origin":
    assert(reluDerivative(-2.0) == 0.0)
    assert(reluDerivative(0.0) == 0.0)
    assert(reluDerivative(3.0) == 1.0)

def activation(X: list[float]) -> list[float]:
    values := []
    for x in X:
        values.append(reluValue(x))
    return values

test "activation applies the mathematical ReLU definition":
    assert(activation([-2.0, 0.0, 3.0]) == [0.0, 0.0, 3.0])

def leakyActivation(X: list[float], slope: float = 0.01) -> list[float]:
    return leakyRelu(X, slope)

def sigmoidActivation(X: list[float]) -> list[float]:
    return fastSigmoid(X)

def tanhActivation(X: list[float]) -> list[float]:
    return fastTanh(X)

def geluActivation(X: list[float]) -> list[float]:
    return gelu(X)

def swishActivation(X: list[float]) -> list[float]:
    return swish(X)

def activationStack(X: list[float]) -> list[float]:
    return swish(fastTanh(relu(X)))

test "named activation symbols retain the tensor behavior":
    assert(leakyActivation([-2.0], 0.5) == [-1.0])
    assert(sigmoidActivation([0.0]) == [0.5])
    assert(tanhActivation([0.0]) == [0.0])
    assert(geluActivation([0.0]) == [0.0])
    assert(swishActivation([0.0]) == [0.0])
    assert(activationStack([0.0]) == [0.0])

def activationJacobian(X: list[float]) -> list[float]:
    width = size(X)
    J := []
    for row in range(0, width):
        for column in range(0, width):
            J.append(reluDerivative(X[row]) if row == column else 0.0)
    return J

test "J is a flattened diagonal activation Jacobian":
    assert(activationJacobian([-2.0, 3.0]) == [0.0, 0.0, 0.0, 1.0])
