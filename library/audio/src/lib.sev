import file
import tensor

class AudioError:
    message: string

# Samples are always frame-major [frames, channels] and normalized to [-1, 1].
# Keeping the rate and channel layout beside Tensor[f32] prevents untyped audio
# tensors from crossing model and codec boundaries.
class Audio:
    samples: Tensor[f32]
    sample_rate: int
    channels: int

    def frames() -> int:
        shape = tensor.ranked_shape(samples)
        assert(size(shape) == 2)
        return shape[0]

    def duration_seconds() -> float:
        return float(frames()) / float(sample_rate)

    def values() -> list[float]:
        return tensor.ranked_values(tensor.to_f_64(samples))

    def resample(target_rate: int) -> Audio:
        return resample(self, target_rate)

    def write_wav(path: string) -> Result[unit, IOError | AudioError]:
        return write_wav(path, self)

class AudioTokens:
    codes: Tensor[i32]
    codebooks: int
    frames: int
    sample_rate: int

def from_samples(values: list[float], sample_rate: int, channels: int = 1) -> Audio:
    assert(sample_rate > 0)
    assert(channels > 0)
    assert(size(values) % channels == 0)
    shaped = tensor.ranked(values, [size(values) / channels, channels])
    return Audio(tensor.to_f_32(shaped), sample_rate, channels)

def little_u_16(bytes: list[int], offset: int) -> int:
    return bytes[offset] + bytes[offset + 1] * 256

def little_u_32(bytes: list[int], offset: int) -> int:
    return little_u_16(bytes, offset) + little_u_16(bytes, offset + 2) * 65536

def four_cc(bytes: list[int], offset: int) -> string:
    return string(bytes[offset]) + ":" + string(bytes[offset + 1]) + ":" + string(bytes[offset + 2]) + ":" + string(bytes[offset + 3])

def read_wav(path: string) -> Result[Audio, IOError | AudioError]:
    handle = file.open(path)
    length = file.byte_length(handle)
    bytes = file.read_exact(handle, length)
    _closed = file.close(handle)
    if length < 12 or four_cc(bytes, 0) != "82:73:70:70" or four_cc(bytes, 8) != "87:65:86:69":
        return failure(AudioError("audio.read_wav expected a RIFF/WAVE file"))

    format := 0
    channels := 0
    sample_rate := 0
    bits_per_sample := 0
    data_start := -1
    data_bytes := 0
    cursor := 12
    while cursor + 8 <= length:
        chunk = four_cc(bytes, cursor)
        chunk_size = little_u_32(bytes, cursor + 4)
        payload = cursor + 8
        if payload + chunk_size > length:
            return failure(AudioError("WAV chunk extends beyond the input file"))
        if chunk == "102:109:116:32":
            if chunk_size < 16:
                return failure(AudioError("WAV fmt chunk is too short"))
            format = little_u_16(bytes, payload)
            channels = little_u_16(bytes, payload + 2)
            sample_rate = little_u_32(bytes, payload + 4)
            bits_per_sample = little_u_16(bytes, payload + 14)
        else if chunk == "100:97:116:97":
            data_start = payload
            data_bytes = chunk_size
        cursor = payload + chunk_size + (chunk_size % 2)

    if format != 1 or bits_per_sample != 16:
        return failure(AudioError("WAV reader currently accepts signed PCM16 input"))
    if channels <= 0 or sample_rate <= 0 or data_start < 0:
        return failure(AudioError("WAV file is missing typed format or sample data"))
    if data_bytes % (channels * 2) != 0:
        return failure(AudioError("WAV sample data is not frame aligned"))

    values := []
    cursor = data_start
    while cursor < data_start + data_bytes:
        raw := little_u_16(bytes, cursor)
        signed := raw if raw < 32768 else raw - 65536
        values.append(float(signed) / 32768.0)
        cursor += 2
    return from_samples(values, sample_rate, channels)

def byte(value: int) -> int:
    return value % 256

def append_u_16(bytes: list[int], value: int):
    bytes.append(byte(value))
    bytes.append(byte(value / 256))

def append_u_32(bytes: list[int], value: int):
    append_u_16(bytes, value)
    append_u_16(bytes, value / 65536)

def append_ascii(bytes: list[int], values: list[int]):
    bytes.extend(values)

def clamp_sample(value: float) -> float:
    return max(-1.0, min(1.0, value))

def write_wav(path: string, audio: Audio) -> Result[unit, IOError | AudioError]:
    if audio.sample_rate <= 0 or audio.channels <= 0:
        return failure(AudioError("audio metadata must have a positive rate and channel count"))
    values = audio.values()
    if size(values) % audio.channels != 0:
        return failure(AudioError("audio sample count is not frame aligned"))
    data_size = size(values) * 2
    bytes := []
    append_ascii(bytes, [82, 73, 70, 70])
    append_u_32(bytes, 36 + data_size)
    append_ascii(bytes, [87, 65, 86, 69, 102, 109, 116, 32])
    append_u_32(bytes, 16)
    append_u_16(bytes, 1)
    append_u_16(bytes, audio.channels)
    append_u_32(bytes, audio.sample_rate)
    append_u_32(bytes, audio.sample_rate * audio.channels * 2)
    append_u_16(bytes, audio.channels * 2)
    append_u_16(bytes, 16)
    append_ascii(bytes, [100, 97, 116, 97])
    append_u_32(bytes, data_size)
    for value in values:
        scaled = int(clamp_sample(value) * 32767.0)
        encoded = scaled if scaled >= 0 else scaled + 65536
        append_u_16(bytes, encoded)
    return file.write_bytes(path, bytes)

# Linear interpolation is the portable baseline. Higher-quality polyphase
# resamplers can implement this same typed boundary without changing callers.
def resample(input: Audio, target_rate: int) -> Audio:
    assert(target_rate > 0)
    if target_rate == input.sample_rate:
        return input
    source = input.values()
    source_frames = input.frames()
    target_frames = max(1, int(float(source_frames) * float(target_rate) / float(input.sample_rate)))
    output := []
    for target_frame in range(0, target_frames):
        source_position = float(target_frame) * float(input.sample_rate) / float(target_rate)
        lower = min(source_frames - 1, int(source_position))
        upper = min(source_frames - 1, lower + 1)
        fraction = source_position - float(lower)
        for channel in range(0, input.channels):
            left = source[lower * input.channels + channel]
            right = source[upper * input.channels + channel]
            output.append(left + (right - left) * fraction)
    return from_samples(output, target_rate, input.channels)

def read(path: string) -> Result[Audio, IOError | AudioError]:
    if not path.lower().ends_with(".wav"):
        return failure(AudioError("audio.read currently supports WAV input"))
    return read_wav(path)

def write(path: string, value: Audio) -> Result[unit, IOError | AudioError]:
    if not path.lower().ends_with(".wav"):
        return failure(AudioError("audio.write currently supports WAV output"))
    return write_wav(path, value)

