class StreamError:
    message: string

enum SeekOrigin:
    Start
    Current
    End

trait Reader:
    read(count: int) -> Result[list[int], StreamError]

trait Writer:
    write(data: list[int]) -> int | StreamError

trait Seeker:
    seek(offset: int, origin: SeekOrigin) -> int | StreamError

trait Closer:
    close() -> unit | StreamError

class MemoryStream:
    data: list[int]
    position: int = 0
    closed: bool = false

    def read(count: int) -> Result[list[int], StreamError]:
        if closed:
            return error(StreamError("stream is closed"))
        if count < 0:
            return error(StreamError("read count cannot be negative"))
        if position >= size(data) or count == 0:
            return []
        stop = [position + count, size(data)].minimum()
        output = data[position:stop]
        position = stop
        return output

    def read_exact(count: int) -> Result[list[int], StreamError]:
        if closed:
            return error(StreamError("stream is closed"))
        if count < 0:
            return error(StreamError("read count cannot be negative"))
        if position + count > size(data):
            return error(StreamError("stream ended before the requested byte count"))
        output = data[position:position + count]
        position += count
        return output

    def write(input: list[int]) -> int | StreamError:
        if closed:
            return error(StreamError("stream is closed"))
        for byte in input:
            if byte < 0 or byte > 255:
                return error(StreamError("byte values must be between 0 and 255"))
        while size(data) < position:
            data.append(0)
        for byte in input:
            if position < size(data):
                data[position] = byte
            else:
                data.append(byte)
            position += 1
        return size(input)

    def seek(offset: int, origin: SeekOrigin) -> int | StreamError:
        target := 0
        match origin:
            Start:
                target = offset
            Current:
                target = position + offset
            End:
                target = size(data) + offset
        if target < 0:
            return error(StreamError("seek position cannot be negative"))
        position = target
        return position

    def tell() -> int:
        return position

    def length() -> int:
        return size(data)

    def remaining() -> int:
        return [0, size(data) - position].maximum()

    def truncate(length: int) -> unit | StreamError:
        if closed:
            return error(StreamError("stream is closed"))
        if length < 0:
            return error(StreamError("stream length cannot be negative"))
        if length < size(data):
            data = data[0:length]
        else:
            while size(data) < length:
                data.append(0)
        if position > length:
            position = length
        return

    def snapshot() -> list[int]:
        return data[0:size(data)]

    def close() -> unit | StreamError:
        closed = true
        return

class LimitedWriter:
    destination: Writer
    maximum_bytes_per_write: int

    def write(input: list[int]) -> int | StreamError:
        count = [size(input), maximum_bytes_per_write].minimum()
        return destination.write(input[0:count])

def read_all(reader: Reader, chunk_size: int = 4096) -> Result[list[int], StreamError]:
    if chunk_size < 1:
        return error(StreamError("chunk size must be positive"))
    output := []
    while true:
        chunk = reader.read(chunk_size)
        if size(chunk) == 0:
            return output
        output.extend(chunk)

def copy(source: Reader, destination: Writer, chunk_size: int = 4096) -> int | StreamError:
    if chunk_size < 1:
        return error(StreamError("chunk size must be positive"))
    copied := 0
    while true:
        chunk = source.read(chunk_size)
        if size(chunk) == 0:
            return copied
        written = destination.write(chunk)
        if written != size(chunk):
            return error(StreamError("writer accepted only part of a stream chunk"))
        copied += written

test "memory streams read seek overwrite and zero-fill gaps":
    stream = MemoryStream([1, 2, 3, 4])
    first = stream.read(2)
    assert(first == [1, 2])
    assert(stream.tell() == 2)
    assert(stream.remaining() == 2)
    end_position = stream.seek(-1, End)
    assert(end_position == 3)
    written = stream.write([9, 10])
    assert(written == 2)
    assert(stream.snapshot() == [1, 2, 3, 9, 10])
    gap_position = stream.seek(7, Start)
    assert(gap_position == 7)
    gap_written = stream.write([11])
    assert(gap_written == 1)
    assert(stream.snapshot() == [1, 2, 3, 9, 10, 0, 0, 11])

test "stream failures are atomic and EOF is explicit":
    stream = MemoryStream([1, 2, 3])
    match stream.read_exact(4):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "stream ended before the requested byte count")
    assert(stream.tell() == 0)
    match stream.write([4, 256, 5]):
        ok _count:
            assert(false)
        failure error:
            assert(error.message == "byte values must be between 0 and 255")
    assert(stream.snapshot() == [1, 2, 3])
    match stream.seek(-1, Start):
        ok _position:
            assert(false)
        failure error:
            assert(error.message == "seek position cannot be negative")
    empty = stream.read(0)
    assert(empty == [])
    eof_position = stream.seek(0, End)
    assert(eof_position == 3)
    eof = stream.read(1)
    assert(eof == [])

test "structural stream traits compose copy and read all":
    source = MemoryStream([1, 2, 3, 4, 5])
    destination = MemoryStream([])
    copied = copy(source, destination, 2)
    assert(copied == 5)
    start = destination.seek(0, Start)
    assert(start == 0)
    all = read_all(destination, 3)
    assert(all == [1, 2, 3, 4, 5])
    match destination.truncate(3):
        ok _value:
            assert(true)
        failure _error:
            assert(false)
    assert(destination.snapshot() == [1, 2, 3])
    match destination.truncate(5):
        ok _value:
            assert(true)
        failure _error:
            assert(false)
    assert(destination.snapshot() == [1, 2, 3, 0, 0])

test "closed streams reject I/O consistently":
    stream = MemoryStream([1])
    match stream.close():
        ok _value:
            assert(true)
        failure _error:
            assert(false)
    match stream.read(1):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "stream is closed")
    match stream.read_exact(1):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "stream is closed")
    match stream.write([2]):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "stream is closed")
    match stream.truncate(0):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "stream is closed")

test "stream boundary errors and exact reads are explicit":
    stream = MemoryStream([1, 2, 3, 4])
    match stream.read(-1):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "read count cannot be negative")
    match stream.read_exact(-1):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "read count cannot be negative")
    exact = stream.read_exact(2)
    assert(exact == [1, 2])
    current = stream.seek(1, Current)
    assert(current == 3)
    match stream.truncate(-1):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "stream length cannot be negative")
    match read_all(stream, 0):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "chunk size must be positive")
    match copy(stream, MemoryStream([]), 0):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "chunk size must be positive")
    limited = LimitedWriter(MemoryStream([]), 1)
    match copy(MemoryStream([1, 2]), limited, 2):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "writer accepted only part of a stream chunk")

test with profile "memory stream copying remains bounded" -> TestResult with
{
    defer time < 1s,
    defer memory < 16mb,
    defer allocations < 50000,
}:
    input := []
    for value in range(0, 4096):
        input.append(value % 256)
    source = MemoryStream(input)
    destination = MemoryStream([])
    copied = copy(source, destination, 128)
    assert(copied == 4096)
    assert(destination.length() == 4096)
