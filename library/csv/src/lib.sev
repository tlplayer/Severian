import data
import platform

def parse_records(text: string) -> list[list[string]]:
    rows: list[list[string]] := []
    row: list[string] := []
    field := ""
    quoted := false
    index := 0
    while index < size(text):
        character = text[index]
        if quoted:
            if character == "\"":
                if index + 1 < size(text) and text[index + 1] == "\"":
                    field += "\""
                    index += 1
                else:
                    quoted = false
            else:
                field += character
        elif character == "\"":
            quoted = true
        elif character == ",":
            row.append(field)
            field = ""
        elif character == "\n":
            row.append(field)
            rows.append(row)
            row = []
            field = ""
        elif character != "\r":
            field += character
        index += 1
    if size(field) > 0 or size(row) > 0:
        row.append(field)
        rows.append(row)
    return rows

def encode_field(field: string) -> string:
    quoted = field.contains(",") or field.contains("\"") or field.contains("\n") or field.contains("\r")
    escaped = field.replace("\"", "\"\"")
    return "\"" + escaped + "\"" if quoted else escaped

def encode_records(rows: list[list[string]]) -> string:
    output := ""
    for row in rows:
        fields: list[string] := []
        for field in row:
            fields.append(encode_field(field))
        output += fields.join(",") + "\n"
    return output

class CsvError:
    message: string

class CsvRow:
    headers_data: list[string]
    cells: list[string]

    def get(name: string) -> string:
        for index in range(size(headers_data)):
            if headers_data[index] == name:
                return cells[index] if index < size(cells) else ""
        return ""

    def values() -> list[string]:
        return cells

    def as_map() -> map[string, string]:
        result := {}
        for index in range(size(headers_data)):
            result[headers_data[index]] = cells[index] if index < size(cells) else ""
        return result

def headers_of(records: list[list[string]]) -> list[string]:
    return records[0] if size(records) > 0 else []

def records_of(records: list[list[string]]) -> list[list[string]]:
    return records[1:] if size(records) > 1 else []

def column_index_of(records: list[list[string]], name: string) -> int:
    for index, field in enumerate(headers_of(records)):
        if field == name:
            return index
    return -1

class CSV: data.Source
    source_path: string
    records_data: list[list[string]]

    def path() -> string:
        return source_path

    def name() -> string:
        return platform.path_basename(source_path)

    def extension() -> string:
        return platform.path_extension(source_path).lower()

    def kind() -> string:
        return "csv"

    def media_type() -> string:
        return "text/csv"

    def size() -> int:
        return size(platform.string_encode(encode_records(records_data)))

    def bytes() -> int:
        return size(platform.string_encode(encode_records(records_data)))

    def raw() -> list[int]:
        return platform.string_encode(encode_records(records_data))

    def text() -> Result[string, IOError]:
        return encode_records(records_data)

    def value() -> Any:
        return records_data

    def data() -> data.Data:
        return data.Data(headers_of(records_data), records_of(records_data))

    def set_data(value: data.Data):
        records_data = value.records()

    def write() -> Result[unit, IOError]:
        if size(source_path) == 0:
            return failure(IOError("in-memory CSV has no path; use encode() or write_to(path)"))
        return platform.file_write(source_path, encode_records(records_data))

    def write_to(path: string) -> Result[unit, IOError]:
        return platform.file_write(path, encode_records(records_data))

    def encode() -> string:
        return encode_records(records_data)

    def headers() -> list[string]:
        return headers_of(records_data)

    def header() -> list[string]:
        return headers_of(records_data)

    def rows() -> list[CsvRow]:
        result: list[CsvRow] = []
        fields = headers_of(records_data)
        for cells in records_of(records_data):
            result.append(CsvRow(fields, cells))
        return result

    def records() -> list[list[string]]:
        return records_of(records_data)

    def columns() -> list[string]:
        return headers_of(records_data)

    def row_count() -> int:
        return max(0, size(records_data) - 1)

    def column_index(name: string) -> int:
        return column_index_of(records_data, name)

    def column(name: string) -> list[string]:
        position = column_index_of(records_data, name)
        if position < 0:
            return []
        values := []
        for row in records_of(records_data):
            values.append(row[position] if position < size(row) else "")
        return values

    def get(row: int, column: string) -> string:
        position = column_index_of(records_data, column)
        values = records_of(records_data)
        if position < 0 or row < 0 or row >= size(values) or position >= size(values[row]):
            return ""
        return values[row][position]

    def cell(row: int, column: string) -> Result[string, CsvError]:
        position = column_index_of(records_data, column)
        values = records_of(records_data)
        if position < 0:
            return failure(CsvError("CSV column does not exist: " + column))
        if row < 0 or row >= size(values):
            return failure(CsvError("CSV row is outside the document"))
        return values[row][position] if position < size(values[row]) else ""

    def set(row: int, column: string, value: string) -> Result[unit, CsvError]:
        position = column_index_of(records_data, column)
        record = row + 1
        if position < 0:
            return failure(CsvError("CSV column does not exist: " + column))
        if record < 1 or record >= size(records_data):
            return failure(CsvError("CSV row is outside the document"))
        while size(records_data[record]) <= position:
            records_data[record].append("")
        records_data[record][position] = value
        return

def document(text: string) -> CSV:
    return CSV("", parse_records(text))

def file_document(path: string, text: string) -> CSV:
    return CSV(path, parse_records(text))

test "CSV documents support rows, quoting, and mutation":
    value := document("name,note\nAda,\"compiler, author\"\n")
    assert(value.rows()[0].get("name") == "Ada")
    assert(value.get(0, "note") == "compiler, author")
    _changed = value.set(0, "note", "language designer")
    assert(value.encode() == "name,note\nAda,language designer\n")
    table = value.data().require_columns(["id", "name"])
    assert(table.columns() == ["id", "name", "note"])

test "CSV metadata and row views handle sparse records":
    empty = document("")
    assert(empty.headers().is_empty())
    assert(empty.records().is_empty())
    assert(empty.row_count() == 0)
    value = document("name,score,note\nAda,10\nGrace,20,compiler\n")
    assert(value.path().is_empty())
    assert(value.name().is_empty())
    assert(value.extension().is_empty())
    assert(value.kind() == "csv")
    assert(value.media_type() == "text/csv")
    assert(value.size() == value.bytes())
    assert(value.raw() == platform.string_encode(value.encode()))
    switch value.text():
        ok text_value:
            assert(text_value == value.encode())
        failure error:
            assert(false, error)
    assert(value.value() == [["name", "score", "note"], ["Ada", "10"], ["Grace", "20", "compiler"]])
    assert(value.headers() == value.header())
    assert(value.columns() == ["name", "score", "note"])
    assert(value.records() == [["Ada", "10"], ["Grace", "20", "compiler"]])
    assert(value.row_count() == 2)
    assert(value.column_index("score") == 1)
    assert(value.column_index("missing") == -1)
    assert(value.column("note") == ["", "compiler"])
    assert(value.column("missing").is_empty())
    rows = value.rows()
    first: CsvRow = rows[0]
    assert(first.get("name") == "Ada")
    assert(first.get("note").is_empty())
    assert(first.get("missing").is_empty())
    assert(CsvRow(["name", "score"], ["Ada", "10"]).values() == ["Ada", "10"])
    assert(CsvRow(["name", "score", "note"], ["Ada", "10"]).as_map() == {"name": "Ada", "score": "10", "note": ""})

test "CSV cell access and mutation report every boundary":
    value := document("left,right\na\nb,c\n")
    assert(value.get(0, "left") == "a")
    assert(value.get(0, "right").is_empty())
    assert(value.get(-1, "left").is_empty())
    assert(value.get(4, "left").is_empty())
    assert(value.get(0, "missing").is_empty())
    switch value.cell(0, "right"):
        ok cell_value:
            assert(cell_value.is_empty())
        failure error:
            assert(false, error)
    switch value.cell(0, "missing"):
        ok _cell_value:
            assert(false, "missing column unexpectedly succeeded")
        failure error:
            assert(error.message.contains("does not exist"))
    switch value.cell(4, "left"):
        ok _cell_value:
            assert(false, "missing row unexpectedly succeeded")
        failure error:
            assert(error.message.contains("outside"))
    _extended = value.set(0, "right", "extended")
    assert(value.get(0, "right") == "extended")
    switch value.set(0, "missing", "value"):
        ok:
            assert(false, "missing column unexpectedly succeeded")
        failure error:
            assert(error.message.contains("does not exist"))
    switch value.set(4, "left", "value"):
        ok:
            assert(false, "missing row unexpectedly succeeded")
        failure error:
            assert(error.message.contains("outside"))

test "CSV data replacement and file writes preserve encoded content":
    in_memory := document("old\nvalue\n")
    in_memory.set_data(data.Data(["id", "name"], [["1", "Ada"], ["2", "Grace"]]))
    assert(in_memory.encode() == "id,name\n1,Ada\n2,Grace\n")
    switch in_memory.write():
        ok:
            assert(false, "an in-memory document unexpectedly wrote without a path")
        failure error:
            assert(error.message.contains("no path"))
    destination = "/tmp/severian-csv-write-to.csv"
    _written = in_memory.write_to(destination)
    attached := file_document("/tmp/severian-csv-attached.CSV", in_memory.encode())
    assert(attached.name() == "severian-csv-attached.CSV")
    assert(attached.extension() == ".csv")
    _saved = attached.write()
    assert(attached.encode() == in_memory.encode())
