import "src/artifact.sev" as artifact_api
import "src/capabilities.sev" as capability_api
import "src/executable.sev" as executable_api
import "src/plan.sev" as plan_api
import "src/session.sev" as session_api
import "src/weights.sev" as weight_api

class LoadOptions:
    revision: string = "main"
    device: string = "auto"
    backend: string = "xla"
    dtype: string = "auto"
    sha256: string = ""
    offline: bool = false
    compile_cache: string = ""

# LoadedModel is immutable model state: artifact identity, lazy typed weights,
# and compiled programs. Generation state never lives here.
class LoadedModel:
    artifact: artifact_api.Artifact
    weights: weight_api.WeightStore
    executables: executable_api.ExecutableBundle
    capabilities: capability_api.CapabilitySet

    def supports(name: string, minimum_version: int = 1) -> bool:
        return capabilities.supports(name, minimum_version)

    def new_session(input_tokens: list[int]) -> session_api.GenerationSession:
        return session_api.GenerationSession(
            executables,
            session_api.SessionState([], 0),
            input_tokens,
            [],
            false,
        )

def static_dimension(value: int) -> plan_api.Dimension:
    return plan_api.Dimension(value, "")

def dynamic_dimension(symbol: string) -> plan_api.Dimension:
    return plan_api.Dimension(-1, symbol)

def tensor_spec(dtype: string, dimensions: list[plan_api.Dimension]) -> plan_api.TensorSpec:
    return plan_api.TensorSpec(dtype, dimensions)

