import file
import json
import "src/types.sev" as types

def tensor_document(value: types.TensorValue) -> map[string, Any]:
    return {"name": value.name, "dtype": value.dtype, "shape": value.shape, "values": value.values}

def node_document(value: types.GraphNode) -> map[string, Any]:
    return {"name": value.name, "operation": value.operation, "inputs": value.inputs, "outputs": value.outputs, "attributes": value.attributes}

def graph_document(value: types.ModelGraph) -> map[string, Any]:
    return {
        "name": value.name,
        "inputs": value.inputs.map(|item| tensor_document(item)),
        "outputs": value.outputs,
        "nodes": value.nodes.map(|item| node_document(item)),
        "initializers": value.initializers.map(|item| tensor_document(item)),
    }

def save_artifact(artifact: types.ModelArtifact, destination: string) -> unit | IOError:
    document = {
        "format": "severian",
        "version": 1,
        "architecture": artifact.architecture,
        "device": artifact.device,
        "dtype": artifact.dtype,
        "config": artifact.config,
        "graph": graph_document(artifact.graph),
        "source_sha256": artifact.content_sha256,
    }
    return file.write_text(destination, json.encode(document))

def tensor_from_document(document: Any) -> types.TensorValue:
    return types.TensorValue(
        json.as_string(json.object_get(document, "name")),
        json.as_string(json.object_get(document, "dtype")),
        json.as_int_list(json.object_get(document, "shape")),
        json.as_list(json.object_get(document, "values")).map(|value| json.as_float(value)),
    )

def graph_from_document(document: Any) -> types.ModelGraph:
    inputs = json.as_list(json.object_get(document, "inputs")).map(|value| tensor_from_document(value))
    initializers = json.as_list(json.object_get(document, "initializers")).map(|value| tensor_from_document(value))
    nodes := []
    for value in json.as_list(json.object_get(document, "nodes")):
        nodes.append(types.GraphNode(
            json.as_string(json.object_get(value, "name")),
            json.as_string(json.object_get(value, "operation")),
            json.as_string_list(json.object_get(value, "inputs")),
            json.as_string_list(json.object_get(value, "outputs")),
            json.object_get(value, "attributes"),
        ))
    return types.ModelGraph(
        json.as_string(json.object_get(document, "name")),
        inputs,
        json.as_string_list(json.object_get(document, "outputs")),
        nodes,
        initializers,
    )

def load_artifact(source: string) -> types.ModelArtifact | IOError | JsonError:
    text = file.read_text(source)
    document: Any = json.decode[Any](text)
    assert(json.as_string(json.object_get(document, "format")) == "severian")
    return types.ModelArtifact(
        source, source, "severian",
        json.as_string(json.object_get(document, "architecture")),
        json.as_string(json.object_get(document, "device")),
        json.as_string(json.object_get(document, "dtype")),
        json.object_get(document, "config"), [],
        graph_from_document(json.object_get(document, "graph")),
        json.as_string(json.object_get(document, "source_sha256")),
    )

