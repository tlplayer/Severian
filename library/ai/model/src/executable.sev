import "src/plan.sev" as plan_api

# Device buffers and executable handles stay opaque to source model code, but
# their metadata is typed rather than stored in map[string, Any].
class DeviceBuffer:
    handle: int
    tensor: plan_api.TensorSpec
    device: string

class Executable:
    handle: int
    program: plan_api.Program
    cache_key: string
    backend: string
    device: string

class ExecutableBundle:
    plan: plan_api.ModelPlan
    programs: list[Executable]

    def executable(id: string) -> Executable | ExecutableError:
        for candidate in programs:
            if candidate.program.id == id:
                return candidate
        return error(ExecutableError("model has no compiled program `" + id + "`"))

    def executable_for(role: string) -> Executable | ExecutableError:
        for candidate in programs:
            if candidate.program.role == role:
                return candidate
        return error(ExecutableError("model has no compiled `" + role + "` program"))

class ExecutableError:
    message: string

class CompileOptions:
    backend: string = "xla"
    device: string = "auto"
    cache_directory: string = ""

