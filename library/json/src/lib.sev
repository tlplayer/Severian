import platform
import file

def loads[type](text: string) -> Result[type, JsonError]:
    return decode[type](text)

def dumps[type](value: type) -> string:
    return encode(value)

def load[type](path: string) -> Result[type, Error]:
    switch file.read_text(path):
        ok text:
            return loads[type](text)
        failure error:
            return failure(error)

def dump[type](value: type, path: string) -> Result[unit, IOError]:
    return file.write_text(path, dumps(value))

def decode[type](text: string) -> Result[type, JsonError]:
    return platform.jsonDecode(text)

def encode[type](value: type) -> string:
    return platform.jsonEncode(value)

def objectGet(value: Any, key: string) -> Any:
    return platform.jsonObjectGet(value, key)

def objectKeys(value: Any) -> list[string]:
    return platform.jsonObjectKeys(value)

def asString(value: Any) -> string:
    return platform.jsonAsString(value)

def asInt(value: Any) -> int:
    return platform.jsonAsInt(value)

def asFloat(value: Any) -> float:
    return platform.jsonAsFloat(value)

def asBool(value: Any) -> bool:
    return platform.jsonAsBool(value)

def asIntList(value: Any) -> list[int]:
    return platform.jsonAsIntList(value)

def asStringList(value: Any) -> list[string]:
    return platform.jsonAsStringList(value)

test "integer decoding":
    switch decode[int]("42"):
        ok value:
            assert(value == 42)
        failure error:
            assert(false, error)

test "compact list encoding":
    assert(encode([1, 2, 3]) == "[1,2,3]")

test "object decoding produces ordinary maps":
    switch decode[map]("{\"hidden_size\":2048,\"torch_dtype\":\"bfloat16\"}"):
        ok value:
            assert(objectGet(value, "hidden_size") == 2048)
            assert(objectGet(value, "torch_dtype") == "bfloat16")
        failure error:
            assert(false, error)

test "typed object accessors decode model configuration fields":
    document ?= decode[Any]("{\"architectures\":[\"Qwen2ForCausalLM\"],\"layers\":36,\"epsilon\":1e-6,\"tied\":true}")
    architectures = asStringList(objectGet(document, "architectures"))
    assert(architectures == ["Qwen2ForCausalLM"])
    assert(asInt(objectGet(document, "layers")) == 36)
    assert(asFloat(objectGet(document, "epsilon")) == 0.000001)
    assert(asBool(objectGet(document, "tied")))
