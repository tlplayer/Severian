import platform

class Parser:
    source: string
    position: int

    def skip_whitespace():
        while position < size(source) and (source[position] == " " or source[position] == "\n" or source[position] == "\r" or source[position] == "\t"):
            position += 1

    def parse() -> Any | JsonError:
        value = self.parse_value()
        self.skip_whitespace()
        if position != size(source):
            return error(JsonError("unexpected content after JSON value"))
        return value

    def parse_value() -> Any | JsonError:
        self.skip_whitespace()
        if position >= size(source):
            return error(JsonError("unexpected end of JSON input"))
        character = source[position]
        if character == "\"":
            return self.parse_string()
        if character == "{":
            return self.parse_object()
        if character == "[":
            return self.parse_array()
        if source[position:position + 4] == "true":
            position += 4
            return true
        if source[position:position + 5] == "false":
            position += 5
            return false
        if source[position:position + 4] == "null":
            position += 4
            return platform.value_null()
        return self.parse_number()

    def parse_string() -> string | JsonError:
        position += 1
        value := ""
        while position < size(source):
            character = source[position]
            position += 1
            if character == "\"":
                return value
            if character != "\\":
                value += character
                continue
            if position >= size(source):
                return error(JsonError("unterminated JSON escape"))
            escaped = source[position]
            position += 1
            if escaped == "\"" or escaped == "\\" or escaped == "/":
                value += escaped
            elif escaped == "n":
                value += "\n"
            elif escaped == "r":
                value += "\r"
            elif escaped == "t":
                value += "\t"
            else:
                return error(JsonError("unsupported JSON escape: \\" + escaped))
        return error(JsonError("unterminated JSON string"))

    def parse_array() -> Any | JsonError:
        position += 1
        values: list[Any] := []
        self.skip_whitespace()
        if position < size(source) and source[position] == "]":
            position += 1
            return values
        while position < size(source):
            value = self.parse_value()
            values.append(value)
            self.skip_whitespace()
            if position < size(source) and source[position] == "]":
                position += 1
                return values
            if position >= size(source) or source[position] != ",":
                return error(JsonError("JSON array requires `,` or `]`"))
            position += 1
        return error(JsonError("unterminated JSON array"))

    def parse_object() -> Any | JsonError:
        position += 1
        values: map[string, Any] := {}
        self.skip_whitespace()
        if position < size(source) and source[position] == "}":
            position += 1
            return values
        while position < size(source):
            self.skip_whitespace()
            if position >= size(source) or source[position] != "\"":
                return error(JsonError("JSON object keys must be strings"))
            key = self.parse_string()
            self.skip_whitespace()
            if position >= size(source) or source[position] != ":":
                return error(JsonError("JSON object key requires `:`"))
            position += 1
            value = self.parse_value()
            values[key] = value
            self.skip_whitespace()
            if position < size(source) and source[position] == "}":
                position += 1
                return values
            if position >= size(source) or source[position] != ",":
                return error(JsonError("JSON object requires `,` or `}`"))
            position += 1
        return error(JsonError("unterminated JSON object"))

    def parse_number() -> Any | JsonError:
        start = position
        while position < size(source) and "-+0123456789.eE".contains(source[position]):
            position += 1
        if start == position:
            return error(JsonError("invalid JSON value"))
        token = source[start:position]
        if token.contains(".") or token.contains("e") or token.contains("E"):
            parsed ?= float.parse(token)
            match parsed:
                case value:
                    return value
                failure _error:
                    return error(JsonError("invalid JSON number: " + token))
        parsed ?= int.parse(token)
        match parsed:
            case value:
                return value
            failure _error:
                return error(JsonError("invalid JSON number: " + token))

def decode_value(text: string) -> Any | JsonError:
    return Parser(text, 0).parse()

def escaped_string(value: string) -> string:
    return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")

def encode_value(value: Any) -> string:
    value_kind = platform.value_kind_name(value)
    if value_kind == "null":
        return "null"
    if value_kind == "boolean":
        return "true" if platform.value_as_bool(value) else "false"
    if value_kind == "integer":
        return string(platform.value_as_int(value))
    if value_kind == "float":
        return string(platform.value_as_float(value))
    if value_kind == "string":
        return "\"" + escaped_string(platform.value_as_string(value)) + "\""
    if value_kind == "array":
        encoded: list[string] := []
        for item in platform.value_as_list(value):
            encoded.append(encode_value(item))
        return "[" + encoded.join(",") + "]"
    if value_kind == "object":
        encoded: list[string] := []
        for key in platform.value_map_keys(value):
            encoded.append("\"" + escaped_string(key) + "\":" + encode_value(platform.value_map_get(value, key)))
        return "{" + encoded.join(",") + "}"
    return "null"

trait Document:
    keys() -> list[string]
    get(key: string) -> Any
    set(key: string, value: Any)
    values() -> list[Any]
    value() -> Any
    encode() -> string

class Json: Document
    source_path: string
    document: Any

    def path() -> string:
        return source_path

    def name() -> string:
        return platform.path_basename(source_path)

    def extension() -> string:
        return platform.path_extension(source_path).lower()

    def kind() -> string:
        return "json"

    def media_type() -> string:
        return "application/json"

    def size() -> int:
        return size(platform.string_encode(encode_value(document)))

    def bytes() -> int:
        return size(platform.string_encode(encode_value(document)))

    def raw() -> list[int]:
        return platform.string_encode(encode_value(document))

    def text() -> string | IOError:
        return encode_value(document)

    def write() -> unit | IOError:
        if size(source_path) == 0:
            return error(IOError("in-memory JSON has no path; use encode() or write_to(path)"))
        return platform.file_write(source_path, encode_value(document))

    def write_to(path: string) -> unit | IOError:
        return platform.file_write(path, encode_value(document))

    def keys() -> list[string]:
        return object_keys(document) if kind(document) == "object" else []

    def get(key: string) -> Any:
        return object_get(document, key)

    def set(key: string, value: Any):
        object_set(document, key, value)

    def values() -> list[Any]:
        return object_values(document) if kind(document) == "object" else []

    def value() -> Any:
        return document

    def encode() -> string:
        return encode(document)

def document(text: string) -> Json | JsonError:
    value = decode[Any](text)
    return Json("", value)

def file_document(path: string, text: string) -> Json | JsonError:
    value = decode[Any](text)
    return Json(path, value)

def loads[T](text: string) -> T | JsonError:
    return decode[T](text)

def dumps[T](value: T) -> string:
    return encode(value)

def decode[T](text: string) -> T | JsonError:
    return decode_value(text)

def encode[T](value: T) -> string:
    return encode_value(value)

def object_get(value: Any, key: string) -> Any:
    return platform.value_map_get(value, key)

def object_keys(value: Any) -> list[string]:
    return platform.value_map_keys(value)

def object_values(value: Any) -> list[Any]:
    return platform.value_map_values(value)

def object_set(value: Any, key: string, item: Any):
    platform.value_map_set(value, key, item)

def as_string(value: Any) -> string:
    return platform.value_as_string(value)

def as_int(value: Any) -> int:
    return platform.value_as_int(value)

def as_float(value: Any) -> float:
    return platform.value_as_float(value)

def as_bool(value: Any) -> bool:
    return platform.value_as_bool(value)

def as_int_list(value: Any) -> list[int]:
    return platform.value_as_int_list(value)

def as_string_list(value: Any) -> list[string]:
    return platform.value_as_string_list(value)

def as_list(value: Any) -> list[Any]:
    return platform.value_as_list(value)

def is_null(value: Any) -> bool:
    return platform.value_is_null(value)

def kind(value: Any) -> string:
    return platform.value_kind_name(value)

test "JSON document supports memory and mutation":
    decoded = decode[Any]("{\"name\":\"Ada\",\"languages\":2}")
    value := Json("", decoded)
    assert(value.keys() == ["name", "languages"])
    assert(as_string(value.get("name")) == "Ada")
    value.set("name", "Grace")
    assert(value.encode() == "{\"name\":\"Grace\",\"languages\":2}")

test "JSON scalar and collection adapters preserve runtime types":
    object = decode[Any]("{\"integer\":7,\"float\":2.5,\"truth\":true,\"strings\":[\"a\",\"b\"],\"integers\":[1,2],\"nothing\":null}")
    assert(kind(object) == "object")
    assert(object_keys(object) == ["integer", "float", "truth", "strings", "integers", "nothing"])
    assert(size(object_values(object)) == 6)
    assert(as_int(object_get(object, "integer")) == 7)
    assert(as_float(object_get(object, "float")) == 2.5)
    assert(as_bool(object_get(object, "truth")))
    assert(as_string_list(object_get(object, "strings")) == ["a", "b"])
    assert(as_int_list(object_get(object, "integers")) == [1, 2])
    assert(size(as_list(object_get(object, "strings"))) == 2)
    assert(is_null(object_get(object, "nothing")))
    assert(as_string("text") == "text")
    object_set(object, "added", 9)
    assert(as_int(object_get(object, "added")) == 9)
    match loads[int]("42"):
        case loaded:
            assert(loaded == 42)
        case error:
            assert(false, error)
    assert(dumps([1, 2]) == "[1,2]")

test "JSON documents expose metadata and typed write failures":
    match document("[1,2,3]"):
        case array_document:
            assert(array_document.path().is_empty())
            assert(array_document.name().is_empty())
            assert(array_document.extension().is_empty())
            assert(array_document.kind() == "json")
            assert(array_document.media_type() == "application/json")
            assert(array_document.size() == array_document.bytes())
            assert(array_document.raw() == platform.string_encode("[1,2,3]"))
            match array_document.text():
                case text_value:
                    assert(text_value == "[1,2,3]")
                case error:
                    assert(false, error)
            assert(array_document.keys().is_empty())
            assert(array_document.values().is_empty())
            assert(array_document.value() == [1, 2, 3])
            match array_document.write():
                ok:
                    assert(false, "an in-memory document unexpectedly wrote without a path")
                case error:
                    assert(error.message.contains("no path"))
        case error:
            assert(false, error)
    destination = "/tmp/severian-json-write-to.json"
    attached_path = "/tmp/severian-json-attached.JSON"
    match file_document(attached_path, "{\"ready\":true}"):
        case attached:
            assert(attached.name() == "severian-json-attached.JSON")
            assert(attached.extension() == ".json")
            _written_to = attached.write_to(destination)
            _written = attached.write()
            assert(attached.encode() == "{\"ready\":true}")
        case error:
            assert(false, error)

test "invalid JSON remains a typed parse failure":
    match decode[Any]("{"):
        case _value:
            assert(false, "invalid JSON unexpectedly decoded")
        failure _error:
            assert(true)
