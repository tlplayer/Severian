import os
import platform

Cpu = "cpu"
Gpu = "gpu"
Rocm = "rocm"

class Device:
    name: string
    kind: string
    architecture: string
    driver: string

class ResourceDevice:
    name: string
    kind: string
    architecture: string
    driver: string
    vendor: string
    memory_mi_b: int
    compute_units: int
    cdi_name: string
    healthy: bool

def rocm_available() -> bool:
    # ROCm exposes the HSA compute device and a DRM render node. Requiring
    # both avoids treating an ordinary display-only AMD device as executable.
    runtime = os.exists("/usr/bin/rocminfo") or os.exists("/opt/rocm/bin/rocminfo")
    return os.exists("/dev/kfd") and os.exists("/dev/dri/renderD128") and runtime

def rocm_cdi_available() -> bool:
    return os.exists("/etc/cdi/amd.json") or os.exists("/var/run/cdi/amd.json")

def discover() -> list[Device]:
    target = platform.current()
    devices := [Device("host-cpu", Cpu, target.architecture, "native")]
    if rocm_available():
        devices.append(Device("renderD128", Gpu, "amdgpu", Rocm))
    return devices

def inventory() -> list[ResourceDevice]:
    target = platform.current()
    devices := [ResourceDevice("host-cpu", Cpu, target.architecture, "native", "host", 0, 0, "", true)]
    if rocm_available():
        cdi_name = "amd.com/gpu=0" if rocm_cdi_available() else ""
        devices.append(ResourceDevice("renderD128", Gpu, "amdgpu", Rocm, "amd", 0, 0, cdi_name, true))
    return devices

def cdi_devices(devices: list[ResourceDevice]) -> list[string]:
    names: list[string] = []
    for current in devices:
        if current.healthy and current.cdi_name != "":
            names.append(current.cdi_name)
    return names

test "device inventory exposes portable CDI identities":
    gpu = ResourceDevice("gpu0", Gpu, "gfx942", Rocm, "amd", 24576, 304, "amd.com/gpu=0", true)
    assert(cdi_devices([gpu]) == ["amd.com/gpu=0"])
