import abi

# @c declarations are compiler syntax. This layer checks the results of calls;
# it does not generate adapters or choose a calling convention by language name.
class BoundaryError: Error
    message: string

class Budget:
    calls_remaining: int
    bytes_remaining: int

def c_target(architecture: abi.Architecture, system: abi.OperatingSystem) -> abi.Target:
    return abi.c_target(architecture, system)

def status(code: int) -> absent | BoundaryError:
    if code != 0:
        throw BoundaryError("external call returned an error status")
    return absent

def count(value: int, maximum: int) -> int | BoundaryError:
    if maximum < 0 or value < 0 or value > maximum:
        throw BoundaryError("external count is outside its limit")
    return value

def transfer(value: int, remaining: int, require_progress: bool = false) -> int | BoundaryError:
    checked = count(value, remaining)
    if require_progress and remaining > 0 and checked == 0:
        throw BoundaryError("external transfer made no progress")
    return checked

def budget(max_calls: int, max_bytes: int) -> Budget | BoundaryError:
    if max_calls < 0 or max_bytes < 0:
        throw BoundaryError("external call budget must be nonnegative")
    return Budget(max_calls, max_bytes)

def account(context: Budget, amount: int) -> Budget | BoundaryError:
    used = count(amount, context.bytes_remaining)
    return Budget(context.calls_remaining, context.bytes_remaining - used)

def step(context: Budget, amount: int = 0) -> Budget | BoundaryError:
    if context.calls_remaining <= 0:
        throw BoundaryError("external call budget exhausted")
    checked = account(context, amount)
    return Budget(checked.calls_remaining - 1, checked.bytes_remaining)

test "partial transfers retain the remaining budget":
    context = budget(2, 10)
    first = step(context, transfer(4, 10, true))
    assert(first.calls_remaining == 1)
    assert(first.bytes_remaining == 6)
    second = step(first, transfer(6, 6, true))
    assert(second.calls_remaining == 0)
    assert(second.bytes_remaining == 0)

test "empty completed transfers are allowed":
    assert(transfer(0, 0, true) == 0)
    assert(count(0, 0) == 0)


test "invalid statuses counts and progress are errors":
    failed_status ?= status(1)
    negative ?= count(-1, 10)
    oversized ?= transfer(11, 10)
    stalled ?= transfer(0, 10, true)
    exceeded ?= account(budget(2, 10), 11)
    exhausted ?= step(budget(0, 10))
    assert(failed_status is BoundaryError)
    assert(negative is BoundaryError)
    assert(oversized is BoundaryError)
    assert(stalled is BoundaryError)
    assert(exceeded is BoundaryError)
    assert(exhausted is BoundaryError)
