class Metadata:
    path: string
    is_file: bool
    is_directory: bool
    size: data_size

@c(symbol = "__sev_os_wait")
def wait(seconds: duration) -> unit

@c(symbol = "__sev_os_make_directories")
def make_directories(path: string) -> bool


@c(symbol = "__sev_path_exists")
def exists(path: string) -> bool

@c(symbol = "__sev_path_is_dir")
def is_dir(path: string) -> bool

@c(symbol = "__sev_os_is_file")
def is_file(path: string) -> bool

@c(symbol = "__sev_os_file_size")
def file_size(path: string) -> data_size

def stat(path: string) -> Metadata:
    return Metadata(path, is_file(path), is_dir(path), file_size(path))

@c(symbol = "__sev_os_copy")
def copy(source: string, destination: string) -> bool

@c(symbol = "__sev_os_rename")
def rename(source: string, destination: string) -> i32

@c(symbol = "__sev_os_remove")
def remove(path: string) -> i32

@c(symbol = "__sev_os_is_symlink")
def is_symlink(path: string) -> bool
@c(symbol = "__sev_os_temporary")
def c_temporary(parent: string, prefix: string) -> string
@c(symbol = "__sev_os_directory_open")
def c_directory_open(path: string) -> int
@c(symbol = "__sev_os_directory_next")
def c_directory_next(handle: int) -> string
@c(symbol = "__sev_os_directory_error")
def c_directory_error() -> i32
@c(symbol = "__sev_os_directory_close")
def c_directory_close(handle: int) -> i32
@c(symbol = "__sev_os_publish_directory")
def c_publish_directory(source: string, destination: string) -> i32
@c(symbol = "__sev_os_remove_tree")
def c_remove_tree(path: string) -> i32

def list(path: string) -> list[string] | Error:
    handle = c_directory_open(path)
    if handle == 0:
        throw Error("could not list directory: " + path)
    result: list[string] = []
    while true:
        entry = c_directory_next(handle)
        if entry == "":
            code = c_directory_error()
            closed = c_directory_close(handle)
            if code != 0 or closed != 0:
                throw Error("could not finish reading directory: " + path)
            return result
        if entry != "." and entry != "..":
            result.append(entry[:])
    return result

def temporary(parent: string, prefix: string = ".sev-") -> string | Error:
    if prefix == "" or prefix.contains("/") or prefix.contains("\\"):
        throw Error("temporary directory prefix must be a filename prefix")
    result = c_temporary(parent, prefix)
    if result == "":
        throw Error("could not create temporary directory in " + parent)
    return result

def publish_directory(source: string, destination: string) -> unit | Error:
    code = c_publish_directory(source, destination)
    if code != 0:
        throw Error("could not publish directory without replacement: " + destination + " (OS error " + string(code) + ")")

def remove_tree(path: string) -> unit | Error:
    if path == "" or path == "/" or path == "." or path == "..":
        throw Error("refusing to remove an unspecified directory tree")
    if c_remove_tree(path) != 0:
        throw Error("could not remove directory tree: " + path)

@c(symbol = "__sev_path_canonical")
def c_canonical(path: string) -> string

def canonical(path: string) -> string | Error:
    resolved = c_canonical(path)
    if resolved == "":
        throw Error("could not resolve path: " + path)
    return resolved
