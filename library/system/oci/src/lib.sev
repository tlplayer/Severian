import file
import os

class PortForward:
    host_port: int
    container_port: int

class Bundle:
    id: string
    path: string
    rootfs: string
    config: string
    ports: list[PortForward]

def quote(value: string) -> string:
    return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""

def runtime_config(
    executable: string,
    data: string,
    user_id: int = 1000,
    group_id: int = 1000,
) -> string:
    config := "{\"ociVersion\":\"1.0.2\","
    config += "\"process\":{\"terminal\":false,"
    config += "\"user\":{\"uid\":" + string(user_id) + ",\"gid\":" + string(group_id) + "},"
    config += "\"args\":[\"/app/server\",\"/data\"],"
    config += "\"env\":[\"PATH=/usr/bin:/bin\",\"SEVERIAN_CONTAINER=oci\"],"
    config += "\"cwd\":\"/\",\"noNewPrivileges\":true},"
    config += "\"root\":{\"path\":\"rootfs\",\"readonly\":true},"
    config += "\"hostname\":\"severian-container-database\","
    config += "\"mounts\":["
    config += "{\"destination\":\"/proc\",\"type\":\"proc\",\"source\":\"proc\"},"
    config += "{\"destination\":\"/tmp\",\"type\":\"tmpfs\",\"source\":\"tmpfs\"},"
    config += "{\"destination\":\"/app/server\",\"type\":\"bind\",\"source\":" + quote(executable) + ",\"options\":[\"rbind\",\"ro\"]},"
    config += "{\"destination\":\"/data\",\"type\":\"bind\",\"source\":" + quote(data) + ",\"options\":[\"rbind\",\"ro\"]},"
    config += "{\"destination\":\"/lib\",\"type\":\"bind\",\"source\":\"/lib\",\"options\":[\"rbind\",\"ro\"]},"
    config += "{\"destination\":\"/lib64\",\"type\":\"bind\",\"source\":\"/lib64\",\"options\":[\"rbind\",\"ro\"]},"
    config += "{\"destination\":\"/usr/lib\",\"type\":\"bind\",\"source\":\"/usr/lib\",\"options\":[\"rbind\",\"ro\"]},"
    config += "{\"destination\":\"/etc\",\"type\":\"bind\",\"source\":\"/etc\",\"options\":[\"rbind\",\"ro\"]}],"
    config += "\"linux\":{\"namespaces\":[{\"type\":\"pid\"},{\"type\":\"ipc\"},{\"type\":\"uts\"},{\"type\":\"mount\"}]}}"
    return config

def prepare_bundle(
    id: string,
    path: string,
    executable: string,
    data: string,
    ports: list[PortForward] = [],
) -> Bundle:
    rootfs = path + "/rootfs"
    os.make_directories(path)
    os.make_directories(rootfs)
    os.make_directories(rootfs + "/app")
    os.make_directories(rootfs + "/data")
    os.make_directories(rootfs + "/dev")
    os.make_directories(rootfs + "/proc")
    os.make_directories(rootfs + "/tmp")
    os.make_directories(rootfs + "/lib")
    os.make_directories(rootfs + "/lib64")
    os.make_directories(rootfs + "/usr/lib")
    os.make_directories(rootfs + "/sys")
    os.make_directories(rootfs + "/etc")
    file.write(rootfs + "/app/server", "")
    config = path + "/config.json"
    file.write(config, runtime_config(executable, data))
    return Bundle(id, path, rootfs, config, ports)

test "OCI bundle configuration preserves the executable and data mounts":
    config = runtime_config("/tmp/server", "/tmp/data")
    assert("\"ociVersion\":\"1.0.2\"" in config)
    assert("/tmp/server" in config)
    assert("/tmp/data" in config)
