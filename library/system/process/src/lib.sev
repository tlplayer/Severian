@c(symbol = "__sev_session_submit")
def session_submit(request: string) -> int
@c(symbol = "__sev_session_request")
def session_request() -> string
@c(symbol = "__sev_session_reply")
def session_reply(status: int) -> bool
@c(symbol = "__sev_session_detach")
def session_detach()
@c(symbol = "__sev_session_limits")
def session_limits(seconds: int, bytes: int) -> bool
@c(symbol = "__sev_session_wait")
def session_wait(worker: int) -> int

# Materialized by the runtime from the process entry boundary. The semantic
# layer lowers this list-valued native surface without exposing its storage.
def arguments() -> list[string]

# Hosted working-directory boundary; an empty result indicates an OS failure.
@c(symbol = "__sev_process_current_directory")
def current_directory() -> string

import * from "resources.sev"

@c(symbol = "__sev_process_id")
def id() -> int

# Hosted OS accounting: CPU totals include completed children when requested.
# Peak RSS is the largest process peak, not a sum of simultaneous process RSS.
@c(symbol = "__sev_process_user_seconds")
def user_seconds(children: int = 0) -> float
@c(symbol = "__sev_process_system_seconds")
def system_seconds(children: int = 0) -> float
@c(symbol = "__sev_process_peak_rss_kib")
def peak_rss_kib(children: int = 0) -> int
@c(symbol = "__sev_process_write_error")
def write_error(text: string)
@c(symbol = "__sev_process_executable")
def executable() -> string

@c(symbol = "__sev_profile_function_table")
def profile_function_table(allocations: string, peak: string, retained: string, output: string) -> int

@c(symbol = "__sev_hook_function_table")
def hook_function_table(records: string, output: string) -> int

@c(symbol = "__sev_command_create")
def native_command() -> int
@c(symbol = "__sev_command_argument")
def native_argument(command: int, argument: string)
@c(symbol = "__sev_command_execute")
def native_execute(command: int, capture: bool) -> int
@c(symbol = "__sev_command_stdout")
def native_stdout(command: int) -> string
@c(symbol = "__sev_command_stderr")
def native_stderr(command: int) -> string
@c(symbol = "__sev_command_drop")
def native_drop(command: int)

class Output:
    status: int
    stdout: string
    stderr: string

def command_handle(arguments: list[string]) -> int | Error:
    if len(arguments) == 0:
        throw Error("process requires an executable")
    command = native_command()
    for argument in arguments:
        native_argument(command, argument)
    return command

# Argument arrays preserve spaces, quotes and shell metacharacters literally.
def run(arguments: list[string]) -> int | Error:
    command = command_handle(arguments)
    status = native_execute(command, false)
    native_drop(command)
    if status < 0:
        throw Error("could not execute process: " + arguments[0])
    return status

def execute(arguments: list[string]) -> Output | Error:
    command = command_handle(arguments)
    status = native_execute(command, true)
    output = native_stdout(command)
    errors = native_stderr(command)
    native_drop(command)
    if status < 0:
        throw Error("could not execute process: " + arguments[0])
    return Output(status, output, errors)

# Structured with/without hook emissions. Zero tokens mean recording is disabled.
@c(symbol="__sev_hook_record_with")
def record_with(function: string, source_id: int, start: int, end: int) -> int

@c(symbol="__sev_hook_record_without")
def record_without(token: int, elapsed: float, failed: bool) -> int
