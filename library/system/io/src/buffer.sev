# Typed byte-buffer IO. Allocation remains with the caller's core.storage owner.
import * from "../../../interop/xxi/src/buffer.sev" as xxi
import "../../../core/memory/src/raw_intrinsics.sev" as raw
import "../../../core/string/src/storage.sev" as text

@c(symbol="__sev_io_read")
def __read(handle: int, destination: pointer, count: int) -> int
@c(symbol="__sev_io_write")
def __write(handle: int, source: pointer, count: int) -> int
@c(symbol="__sev_io_error")
def error() -> i32
@c(symbol="close")
def close(handle: i32) -> i32

def read(handle: int, data: borrow array[u8], offset: int, count: int) -> int:
    return xxi.transferred(__read(handle, xxi.address(data, len(data), offset, count), count), count)

def write(handle: int, data: view array[u8], offset: int, count: int) -> int:
    return xxi.transferred(__write(handle, xxi.address(data, len(data), offset, count), count), count)

def write_all(handle: int, data: view array[u8], count: int) -> int:
    assert(count >= 0 and count <= len(data))
    offset := 0
    while offset < count:
        written = write(handle, data, offset, count - offset)
        if written <= 0:
            return -1
        offset += written
    return offset


# Copy initialized UTF-8 bytes through the text API. A string is not an array
# descriptor; its physical representation belongs to the text implementation.
# Return the transferred byte count, or -1 if output cannot make progress.
def write_text(descriptor: i32, value: string) -> int:
    count = text.byte_count(value)
    if count == 0:
        return 0
    unsafe:
        data = raw.__raw_allocate(count, 1)
        position := 0
        while position < count:
            raw.__raw_store(text.read(value, position), raw.__raw_offset(data, position))
            position += 1
        offset := 0
        while offset < count:
            written = raw.__raw_write(descriptor, raw.__raw_offset(data, offset), count - offset)
            if written <= 0:
                raw.__raw_free(data)
                return -1
            offset += written
        raw.__raw_free(data)
        return offset


test "empty text output does not access the descriptor":
    assert(write_text(-1, "") == 0)


test "text output reports descriptor failures":
    assert(write_text(-1, "diagnostic λ") == -1)
