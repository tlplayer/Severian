# Typed byte-buffer IO. Allocation remains with the caller's core.storage owner.
import * from "../../../interop/xxi/src/buffer.sev" as xxi

@c(symbol="__sev_io_read")
def __read(handle: int, destination: native_ptr, count: int) -> int
@c(symbol="__sev_io_write")
def __write(handle: int, source: native_ptr, count: int) -> int
@c(symbol="__sev_io_error")
def error() -> i32
@c(symbol="close")
def close(handle: i32) -> i32

def read(handle: int, data: borrow array[u8], offset: int, count: int) -> int:
    return xxi.transferred(__read(handle, xxi.address(data, len(data), offset, count), count), count)

def write(handle: int, data: view array[u8], offset: int, count: int) -> int:
    return xxi.transferred(__write(handle, xxi.address(data, len(data), offset, count), count), count)

def write_all(handle: int, data: view array[u8], count: int) -> int:
    assert(count >= 0 and count <= len(data))
    offset := 0
    while offset < count:
        written = write(handle, data, offset, count - offset)
        if written <= 0:
            return -1
        offset += written
    return offset
