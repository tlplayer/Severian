# Typed byte-buffer IO. Allocation remains with the caller's core.memory.storage owner.
import "../../../interop/xxi/src/buffer.sev" as xxi

@c(symbol="__sev_io_read")
def __read(handle: int, destination: pointer, count: int) -> int
@c(symbol="__sev_io_write")
def __write(handle: int, source: pointer, count: int) -> int
@c(symbol="__sev_io_error")
def error() -> i32
@c(symbol="close")
def close(handle: i32) -> i32

def read(handle: int, data: borrow array[u8], offset: int, count: int) -> int:
    return xxi.transferred(__read(handle, xxi.address(data, len(data), offset, count), count), count)

def write(handle: int, data: view array[u8], offset: int, count: int) -> int:
    return xxi.transferred(__write(handle, xxi.address(data, len(data), offset, count), count), count)

@c(symbol="__sev_io_stdout_write")
def __write_stdout(data: pointer, count: int) -> i32

@c(symbol="__sev_io_stdout_flush")
def flush_stdout() -> i32

# Keep the typed loan alive across the entire foreign call.
def write_stdout(data: view array[u8], offset: int, count: int) -> i32:
    return __write_stdout(xxi.address(data, len(data), offset, count), count)
