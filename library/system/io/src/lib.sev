# Bootstrap implementation of the system IO boundary. The selected IO provider
# owns this native declaration; core and the compiler only see `io.print` as an
# ordinary function identity.
class IOError: Error
    message: string

    def IOError(value: string):
        message := value

class StreamError: Error
    message: string

    def StreamError(value: string):
        message := value

def stdout() -> int:
    return 1

def stderr() -> int:
    return 2

# XXI handles storage loans, ABI views, conversions and transfer limits.
import xxi

@c(symbol = "__sev_io_read_view")
def __read(reader: int, data: inout[list[u8]]) -> int
@c(symbol = "__sev_io_write_view")
def __write(writer: int, data: borrowed[list[u8]], offset: int) -> int

@c(symbol = "__sev_io_error")
def error() -> i32

@c(symbol = "close")
def close(handle: i32) -> i32

def read(reader: int, count: data_size = 1KiB) -> list[u8] | Error:
    requested = xxi.count(float(count), 67108864)
    data: list[u8] = []
    for index in range(requested):
        data.append(0)
    received = __read(reader, data)
    xxi.status(int(error()))
    used = xxi.transfer(received, requested)
    return data[:used]

def read_all(reader: int, max_bytes: int = 67108864, max_calls: int = 65536) -> list[u8] | Error:
    result: list[u8] = []
    context := xxi.budget(max_calls, max_bytes)
    while true:
        context = xxi.step(context, 0)
        chunk = read(reader)
        context = xxi.account(context, int(len(chunk)))
        if len(chunk) == 0:
            return result
        for byte in chunk:
            result.append(byte)
    return result

def write_all(writer: int, data: list[u8], max_calls: int = 65536) -> data_size | Error:
    offset := 0
    context := xxi.budget(max_calls, int(len(data)))
    while offset < len(data):
        context = xxi.step(context, 0)
        count = __write(writer, data, offset)
        xxi.status(int(error()))
        written = xxi.transfer(count, int(len(data)) - offset, true)
        context = xxi.account(context, written)
        offset += written
    return data_size(offset)


@c(symbol = "__sev_print_string")
def print(value: string) -> i32

@c(symbol = "__sev_print_int")
def print(value: int) -> i32

@c(symbol = "__sev_print_float")
def print(value: float) -> i32

@c(symbol = "__sev_print_i32")
def print(value: i32) -> i32

@c(symbol = "__sev_print_i8")
def print(value: i8) -> i32

@c(symbol = "__sev_print_i16")
def print(value: i16) -> i32

@c(symbol = "__sev_print_i128")
def print(value: i128) -> i32

@c(symbol = "__sev_print_isize")
def print(value: isize) -> i32

@c(symbol = "__sev_print_u8")
def print(value: u8) -> i32

@c(symbol = "__sev_print_u16")
def print(value: u16) -> i32

@c(symbol = "__sev_print_u32")
def print(value: u32) -> i32

@c(symbol = "__sev_print_u64")
def print(value: u64) -> i32

@c(symbol = "__sev_print_u128")
def print(value: u128) -> i32

@c(symbol = "__sev_print_usize")
def print(value: usize) -> i32

@c(symbol = "__sev_print_f32")
def print(value: f32) -> i32

@c(symbol = "__sev_print_f64")
def print(value: f64) -> i32

@c(symbol = "__sev_print_f128")
def print(value: f128) -> i32

@c(symbol = "__sev_print_bool")
def print(value: bool) -> i32

@c(symbol = "__sev_print_char")
def print(value: char) -> i32

def print(values: Any...) -> i32:
    first := true
    rendered := ""
    for value in values:
        if not first:
            rendered += " "
        rendered += string(value)
        first = false
    return print(rendered)

# Panic is a hosted diagnostic boundary. Unlike `throw`, it terminates the
# process immediately and does not participate in structured error unwinding.
@c(symbol = "__sev_panic")
def panic(message: string) -> unit
