# Bootstrap implementation of the system IO boundary. The selected IO provider
# owns this native declaration; core and the compiler only see `io.print` as an
# ordinary function identity.
@c(symbol = "puts")
def print(value: string) -> i32

@c(symbol = "__sev_print_int")
def print(value: int) -> i32

@c(symbol = "__sev_print_float")
def print(value: float) -> i32

@c(symbol = "__sev_print_i32")
def print(value: i32) -> i32

@c(symbol = "__sev_print_i64")
def print(value: i64) -> i32

@c(symbol = "__sev_print_f64")
def print(value: f64) -> i32

@c(symbol = "__sev_print_bool")
def print(value: bool) -> i32

@c(symbol = "__sev_print_char")
def print(value: char) -> i32
