import "src/file_interface.sev" as file_interface
import "src/io.sev" as file_io
import yaml

class YamlReader: file_interface.Reader
    extensions = {".yaml", ".yml"}
    document_class = "Yaml"

    def read(path: string) -> file_interface.File | IOError | file_interface.FormatError:
        content = file_io.read_text(path)
        return yaml.file_document(path, content)
