trait File:
    path() -> string
    name() -> string
    extension() -> string
    kind() -> string
    media_type() -> string
    size() -> int
    bytes() -> int
    raw() -> list[int]
    text() -> string | FormatError
    value() -> Any
    write() -> unit | IOError

class FormatError:
    message: string

trait Reader:
    property extensions: set[string]
    property document_class: string
    read(path: string) -> File | IOError | FormatError
