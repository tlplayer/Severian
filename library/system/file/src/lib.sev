from data import Data

trait File:
    @file
    def read(path: string) -> string | Data with { (path) -> bool }

class TextFile: File
    def read(path: string) -> string with { path.ends_with(".txt") }:
        return file.read_text(path)

@c(symbol = "__sev_file_write_text")
def write(path: string, contents: string) -> i32

def write(path: string, contents: list[u8]) -> i32


# The untyped storage boundary used by format packages and File dispatch
# implementations. Applications should normally call `file.read`.
@c(symbol = "__sev_file_read_text")
def raw(path: string) -> string

def open(path: string) -> int

def read(handle: int, count: data_size) -> list[u8]

def map(path: string) -> list[u8]

@c(symbol = "__sev_file_lock")
def native_lock(path: string) -> int

def lock(path: string) -> int | None:
    handle = native_lock(path)
    if handle < 0:
        return None
    return handle

@c(symbol = "__sev_file_unlock")
def unlock(lock: int) -> bool

@c(symbol = "__sev_file_error")
def native_error() -> i32

# Unlike raw(), this checked API distinguishes an empty file from failed IO.
def read_checked(path: string) -> string | Error:
    contents = raw(path)
    code = native_error()
    if code != 0:
        throw Error("could not read text file " + path + " (OS error " + string(code) + ")")
    return contents
