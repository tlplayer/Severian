import io
import os
from data import Data
import * from "text.sev" as text
import * from "streams.sev" as streams

trait File:
    @file
    def read(path: string) -> string | Data with { (path) -> bool }

class TextFile: File
    def read(path: string) -> string with { path[-4:] in [".txt", ".sev"] }:
        return text.read(path)

def write(path: string, contents: string) -> i32 | Error:
    return text.write(path, contents)

def write(path: string, contents: list[u8]) -> i32 | Error:
    return streams.write(path, contents)


# Compatibility entry point; codecs use system.file.text directly.
def raw(path: string) -> string | Error:
    return text.read(path)

def open(path: string) -> int:
    return int(streams.open_read(path))

def read(handle: int, count: data_size) -> list[u8] | Error:
    return io.read(handle, count)

def read_bytes(handle: int, count: data_size) -> list[u8] | Error:
    return io.read(handle, count)

def map(path: string) -> list[u8] | Error:
    return streams.read(path)

@c(symbol = "__sev_file_lock")
def native_lock(path: string) -> int

def lock(path: string) -> int | None:
    handle = native_lock(path)
    if handle < 0:
        return None
    return handle

@c(symbol = "__sev_file_unlock")
def unlock(lock: int) -> bool

# Compatibility API: ordinary callers use the constrained file.read dispatch.
def read_checked(path: string) -> string | Error:
    return text.read(path)

# File metadata and permissions are path operations, independent of encoding.
def metadata(path: string) -> os.Metadata:
    return streams.metadata(path)

def permissions(path: string) -> i32:
    return streams.permissions(path)

def set_permissions(path: string, mode: u32) -> i32:
    return streams.set_permissions(path, mode)
