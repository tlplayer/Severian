# Text is an encoding over file bytes. IO and ownership stay below this module.
import * from "streams.sev" as streams

def decode(data: list[u8]) -> string | Error:
    parts: list[string] = []
    offset := 0
    while offset < len(data):
        first = int(data[offset])
        width := 1
        value := first
        minimum := 0
        if first >= 194 and first <= 223:
            width = 2
            value = first - 192
            minimum = 128
        elif first >= 224 and first <= 239:
            width = 3
            value = first - 224
            minimum = 2048
        elif first >= 240 and first <= 244:
            width = 4
            value = first - 240
            minimum = 65536
        elif first >= 128:
            throw Error("invalid UTF-8 leading byte")
        if offset + width > len(data):
            throw Error("truncated UTF-8 sequence")
        for index in range(1, width):
            byte = int(data[offset + index])
            if byte < 128 or byte > 191:
                throw Error("invalid UTF-8 continuation byte")
            value = value * 64 + byte - 128
        if value < minimum or value > 1114111 or (value >= 55296 and value <= 57343):
            throw Error("invalid UTF-8 scalar")
        if value == 0:
            throw Error("text contains NUL; use file bytes for binary contents")
        parts.append(string(char(value)))
        offset += width
    return parts.join("")

def read(path: string) -> string | Error:
    return decode(streams.read(path))

def write(path: string, contents: string) -> i32 | Error:
    return streams.write(path, contents.bytes())
