import string
from collections import list

LittleEndian = "little"
BigEndian = "big"
Processes = "processes"
ProcessPipes = "process-pipes"

class Target:
    pointer_bits: byte
    byte_order: string
    architecture: string
    operating_system: string
    capabilities: list[string]

class FieldLayout:
    offset: byte
    alignment: byte

class Layout[T]:
    size: byte
    alignment: byte

    def field(name: string) -> FieldLayout:
        return FieldLayout(offset[T](name), alignment[T](name))

def pointer_bits() -> byte:
    return bytes[usize]()

def byte_order() -> string:
    return target("byte_order")

def architecture() -> string:
    return target("architecture")

def operating_system() -> string:
    return target("operating_system")

def current() -> Target:
    capabilities = list[string]()
    system = operating_system()
    if system == "linux" or system == "windows" or system == "win32" or system == "darwin" or system == "freebsd":
        capabilities.append(Processes)
        capabilities.append(ProcessPipes)
    return Target(pointer_bits(), byte_order(), architecture(), system, capabilities)

def layout[T](selected: Target) -> Layout[T]:
    return Layout[T](bytes[T](), alignment[T]())

test "target facts describe the selected compiler target":
    selected = current()
    assert(selected.pointer_bits == bytes[usize]())
    assert(selected.architecture == target("architecture"))
    assert(selected.byte_order == target("byte_order"))

test "generic field layout uses real field offsets and alignment":
    class Header:
        tag: u8
        length: u32
    selected = current()
    result = layout[Header](selected)
    assert(result.size == 8B)
    assert(result.alignment == 4B)
    name = "length"
    assert(result.field(name).offset == 4B)
    assert(result.field(name).alignment == 4B)
    assert(result.field("tag").alignment == 1B)
