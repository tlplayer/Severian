import process

# Bootstrap command surface used by package drivers. Argument specifications
# remain immutable strings until aggregate collection storage is part of the
# stable runtime ABI; this still preserves the public command/value workflow.
class Command:
    name: string
    about: string
    version: string
    arguments: list[string]

class Matches:
    arguments: list[string]

class CliError: Error
    message: string

    def CliError(value: string):
        message := value

def argument(
    name: string,
    help: string = "",
    required: bool = true,
    multiple: bool = false,
) -> string:
    return name

def command(
    name: string,
    about: string = "",
    version: string = "",
    arguments: list[string] = [],
) -> Command:
    return Command(name, about, version, arguments)

def parse_process(specification: Command) -> Matches:
    input = process.arguments()
    if size(input) > 0:
        return Matches(input[1:int(size(input))])
    return Matches([])

def values(matches: Matches, name: string) -> list[string]:
    input = process.arguments()
    if size(input) > 0:
        return input[1:int(size(input))]
    return []

def render_error(error: CliError) -> string:
    return "error: " + error.message
