import platform

class GraphicsError:
    detail: string

    def message() -> string:
        return detail

class Color:
    red: int
    green: int
    blue: int
    alpha: int

    def css() -> string:
        return "rgb(" + string(red) + "," + string(green) + "," + string(blue) + ")"

    def opacity() -> float:
        return float(alpha) / 255.0

def rgb(red: int, green: int, blue: int) -> Color:
    return Color(red, green, blue, 255)

def rgba(red: int, green: int, blue: int, alpha: int) -> Color:
    return Color(red, green, blue, alpha)

def black() -> Color:
    return rgb(0, 0, 0)

def white() -> Color:
    return rgb(255, 255, 255)

def red() -> Color:
    return rgb(220, 38, 38)

def green() -> Color:
    return rgb(22, 163, 74)

def blue() -> Color:
    return rgb(37, 99, 235)

def gray() -> Color:
    return rgb(107, 114, 128)

def escape_text(value: string) -> string:
    return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

def style(color: Color) -> string:
    return " opacity=\"" + string(color.opacity()) + "\""

def svg_document(width: int, height: int, background: Color, elements: list[string]) -> string:
    output := (
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + string(width) +
        "\" height=\"" + string(height) + "\" viewBox=\"0 0 " +
        string(width) + " " + string(height) + "\">\n"
    )
    output += (
        "<rect width=\"100%\" height=\"100%\" fill=\"" + background.css() +
        "\"" + style(background) + "/>\n"
    )
    for element in elements:
        output += element + "\n"
    return output + "</svg>\n"

class Canvas:
    width_data: int
    height_data: int
    background: Color
    elements: list[string]

    def Canvas(width: int, height: int, background_color: Color):
        assert(width > 0, "canvas width must be positive")
        assert(height > 0, "canvas height must be positive")
        width_data = width
        height_data = height
        background = background_color
        elements = []

    def width() -> int:
        return width_data

    def height() -> int:
        return height_data

    def clear(color: Color):
        background = color
        elements = []

    def line(x1: int, y1: int, x2: int, y2: int, color: Color):
        elements.append(
            "<line x1=\"" + string(x1) + "\" y1=\"" + string(y1) +
            "\" x2=\"" + string(x2) + "\" y2=\"" + string(y2) +
            "\" stroke=\"" + color.css() + "\" stroke-width=\"1\"" +
            style(color) + "/>"
        )

    def line_width(x1: int, y1: int, x2: int, y2: int, color: Color, stroke_width: int):
        elements.append(
            "<line x1=\"" + string(x1) + "\" y1=\"" + string(y1) +
            "\" x2=\"" + string(x2) + "\" y2=\"" + string(y2) +
            "\" stroke=\"" + color.css() + "\" stroke-width=\"" + string(stroke_width) + "\"" +
            style(color) + "/>"
        )

    def rectangle(x: int, y: int, width: int, height: int, color: Color):
        elements.append(
            "<rect x=\"" + string(x) + "\" y=\"" + string(y) +
            "\" width=\"" + string(width) + "\" height=\"" + string(height) +
            "\" fill=\"" + color.css() + "\" stroke=\"none\"" + style(color) + "/>"
        )

    def rectangle_outline(x: int, y: int, width: int, height: int, color: Color, stroke_width: int):
        elements.append(
            "<rect x=\"" + string(x) + "\" y=\"" + string(y) +
            "\" width=\"" + string(width) + "\" height=\"" + string(height) +
            "\" fill=\"none\" stroke=\"" + color.css() + "\" stroke-width=\"" +
            string(stroke_width) + "\"" + style(color) + "/>"
        )

    def circle(x: int, y: int, radius: int, color: Color):
        elements.append(
            "<circle cx=\"" + string(x) + "\" cy=\"" + string(y) +
            "\" r=\"" + string(radius) + "\" fill=\"" + color.css() +
            "\" stroke=\"none\"" + style(color) + "/>"
        )

    def circle_outline(x: int, y: int, radius: int, color: Color, stroke_width: int):
        elements.append(
            "<circle cx=\"" + string(x) + "\" cy=\"" + string(y) +
            "\" r=\"" + string(radius) + "\" fill=\"none\" stroke=\"" + color.css() +
            "\" stroke-width=\"" + string(stroke_width) + "\"" + style(color) + "/>"
        )

    def text(x: int, y: int, value: string, color: Color):
        elements.append(
            "<text x=\"" + string(x) + "\" y=\"" + string(y) +
            "\" fill=\"" + color.css() + "\" font-family=\"sans-serif\" font-size=\"14\"" +
            " text-anchor=\"start\"" + style(color) + ">" + escape_text(value) + "</text>"
        )

    def text_styled(x: int, y: int, value: string, color: Color, size: int, anchor: string):
        elements.append(
            "<text x=\"" + string(x) + "\" y=\"" + string(y) +
            "\" fill=\"" + color.css() + "\" font-family=\"sans-serif\" font-size=\"" +
            string(size) + "\" text-anchor=\"" + anchor + "\"" + style(color) + ">" +
            escape_text(value) + "</text>"
        )

    def svg() -> string:
        return svg_document(width_data, height_data, background, elements)

    def save(path: string) -> unit | IOError:
        return platform.file_write(path, svg_document(width_data, height_data, background, elements))

def canvas(width: int, height: int, background: Color) -> Canvas | GraphicsError:
    if width <= 0 or height <= 0:
        return error(GraphicsError("canvas dimensions must be positive"))
    return Canvas(width, height, background)

test "headless canvas records explicit drawing commands":
    target = canvas(320, 200, white())
    target.line_width(1, 2, 30, 40, black(), 2)
    target.rectangle(10, 20, 50, 25, blue())
    target.circle_outline(100, 80, 12, red(), 3)
    target.text_styled(160, 190, "Severian & SVG", black(), 12, "middle")
    document = target.svg()
    assert(document.contains("<line x1=\"1\" y1=\"2\""))
    assert(document.contains("<rect x=\"10\" y=\"20\""))
    assert(document.contains("<circle cx=\"100\" cy=\"80\""))
    assert(document.contains("Severian &amp; SVG"))

test "clear replaces the background and prior frame commands":
    target = canvas(20, 20, black())
    target.circle(10, 10, 4, white())
    target.clear(blue())
    document = target.svg()
    assert(document.contains("rgb(37,99,235)"))
    assert(not document.contains("<circle"))
