import json
import platform

def strip_scalar(value: string) -> string:
    cleaned := value.strip()
    if cleaned.starts_with("[") and cleaned.ends_with("]"):
        cleaned = cleaned[1:-1].strip()
    if size(cleaned) >= 2 and ((cleaned.starts_with("\"") and cleaned.ends_with("\"")) or (cleaned.starts_with("'") and cleaned.ends_with("'"))):
        cleaned = cleaned[1:-1]
    return cleaned.strip()

def append_values(destination: list[string], source: string) -> list[string]:
    content := source.strip()
    if content.starts_with("[") and content.ends_with("]"):
        content = content[1:-1]
    for raw in content.split(","):
        value = strip_scalar(raw)
        if size(value) > 0:
            destination.append(value)
    return destination

def parse_mapping(content: string) -> map[string, list[string]]:
    values := {}
    current := [""]
    for raw_line in content.split("\n"):
        line = raw_line.strip()
        if size(line) == 0 or line.starts_with("#"):
            continue
        if line.starts_with("- "):
            existing := values.get(current[0], [])
            existing = append_values(existing, line[2:])
            values[current[0]] = existing
        else:
            separator = line.find(":")
            if separator >= 0:
                current[0] = strip_scalar(line[0:separator])
                existing := values.get(current[0], [])
                inline = line[separator + 1:].strip()
                if size(inline) > 0:
                    existing = append_values(existing, inline)
                values[current[0]] = existing
    return values

def encode_mapping(mapping: map[string, list[string]]) -> string:
    output := ""
    for key in mapping.keys():
        values = mapping[key]
        if size(values) == 1:
            output += key + ": " + values[0] + "\n"
        else:
            output += key + ":\n"
            for value in values:
                output += "- " + value + "\n"
    return output

def mapping_values(mapping: map[string, list[string]], key: string) -> list[string]:
    return mapping.get(key, [])

class Yaml: json.Document
    source_path: string
    mapping: map[string, list[string]]

    def path() -> string:
        return source_path

    def name() -> string:
        return platform.path_basename(source_path)

    def extension() -> string:
        return platform.path_extension(source_path).lower()

    def kind() -> string:
        return "yaml"

    def media_type() -> string:
        return "application/yaml"

    def size() -> int:
        return size(platform.string_encode(encode_mapping(mapping)))

    def bytes() -> int:
        return size(platform.string_encode(encode_mapping(mapping)))

    def raw() -> list[int]:
        return platform.string_encode(encode_mapping(mapping))

    def text() -> string | IOError:
        return encode_mapping(mapping)

    def value() -> Any:
        return mapping

    def write() -> unit | IOError:
        if size(source_path) == 0:
            return error(IOError("in-memory YAML has no path; use encode() or write_to(path)"))
        return platform.file_write(source_path, encode_mapping(mapping))

    def write_to(path: string) -> unit | IOError:
        return platform.file_write(path, encode_mapping(mapping))

    def encode() -> string:
        return encode_mapping(mapping)

    def keys() -> list[string]:
        return mapping.keys()

    def get(key: string) -> Any:
        return mapping_values(mapping, key)

    def set(key: string, value: Any):
        if json.kind(value) == "array":
            mapping[key] = json.as_string_list(value)
        else json.kind(value) == "string":
            mapping[key] = [json.as_string(value)]
        else:
            mapping[key] = [json.encode(value)]

    def values() -> list[Any]:
        result: list[Any] = []
        for key in mapping.keys():
            result.append(mapping[key])
        return result

    def values_for(key: string) -> list[string]:
        return mapping_values(mapping, key)

    def scalar(key: string) -> string:
        values = mapping_values(mapping, key)
        return values[0] if size(values) > 0 else ""

    def scalar_or(key: string, fallback: string) -> string:
        values = mapping_values(mapping, key)
        return values[0] if size(values) > 0 else fallback

def document(text: string) -> Yaml:
    return Yaml("", parse_mapping(text))

def file_document(path: string, text: string) -> Yaml:
    return Yaml(path, parse_mapping(text))

test "YAML mapping documents support lists and scalars":
    value := document("engineers:\n- Ada\n- Grace\nstatus: ready\n")
    assert(value.values_for("engineers") == ["Ada", "Grace"])
    assert(value.scalar("status") == "ready")
    value.set("status", "complete")
    assert(value.scalar("status") == "complete")

test "YAML parsing handles comments, inline lists, quotes, and empty values":
    value := document("# heading\n\nengineers: [\"Ada\", 'Grace']\nstatus: 'ready'\nempty:\n")
    assert(value.keys() == ["engineers", "status", "empty"])
    assert(value.values_for("engineers") == ["Ada", "Grace"])
    assert(value.scalar("status") == "ready")
    assert(value.scalar("empty").is_empty())
    assert(value.scalar("missing").is_empty())
    assert(value.scalar_or("missing", "fallback") == "fallback")
    assert(value.scalar_or("status", "fallback") == "ready")
    assert(value.get("missing") == [])
    assert(size(value.values()) == 3)
    assert(value.value() == {"engineers": ["Ada", "Grace"], "status": ["ready"], "empty": []})
    assert(strip_scalar(" [ value ] ") == "value")
    assert(strip_scalar("\"quoted\"") == "quoted")
    assert(strip_scalar("'quoted'") == "quoted")
    assert(append_values([], "one, ,two") == ["one", "two"])

test "YAML mutation encodes arrays, strings, and scalar JSON values":
    value := document("")
    value.set("array", ["one", "two"])
    value.set("string", "ready")
    value.set("integer", 7)
    assert(value.values_for("array") == ["one", "two"])
    assert(value.values_for("string") == ["ready"])
    assert(value.values_for("integer") == ["7"])
    assert(value.encode() == "array:\n- one\n- two\nstring: ready\ninteger: 7\n")

test "YAML documents expose metadata and file persistence":
    value := document("status: ready\n")
    assert(value.path().is_empty())
    assert(value.name().is_empty())
    assert(value.extension().is_empty())
    assert(value.kind() == "yaml")
    assert(value.media_type() == "application/yaml")
    assert(value.size() == value.bytes())
    assert(value.raw() == platform.string_encode(value.encode()))
    match value.text():
        case text_value:
            assert(text_value == value.encode())
        case error:
            assert(false, error)
    match value.write():
        ok:
            assert(false, "an in-memory document unexpectedly wrote without a path")
        case error:
            assert(error.message.contains("no path"))
    destination = "/tmp/severian-yaml-write-to.yaml"
    _written_to = value.write_to(destination)
    attached := file_document("/tmp/severian-yaml-attached.YML", value.encode())
    assert(attached.name() == "severian-yaml-attached.YML")
    assert(attached.extension() == ".yml")
    _written = attached.write()
    assert(attached.encode() == value.encode())
