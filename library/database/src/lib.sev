import platform
import pql
import storage

def open(path: string) -> Database | DatabaseError:
    return platform.database_open(path)

def memory() -> Database | DatabaseError:
    return open(":memory:")

def execute(database: Database, statement: string) -> int | DatabaseError:
    return platform.database_execute(database, statement)

def query(database: Database, statement: string) -> Result[list[list[string]], DatabaseError]:
    return platform.database_query(database, statement)

def close(database: Database) -> unit | DatabaseError:
    return platform.database_close(database)

def begin(database: Database) -> int | DatabaseError:
    return execute(database, "BEGIN")

def commit(database: Database) -> int | DatabaseError:
    return execute(database, "COMMIT")

def rollback(database: Database) -> int | DatabaseError:
    return execute(database, "ROLLBACK")

def query_pql(database: Database, schema: pql.Schema, statement: pql.Query) -> Result[list[list[string]], DatabaseError]:
    assert(pql.valid(schema, statement))
    return query(database, pql.sql(schema, statement, "sqlite"))

def start(path: string) -> DatabaseServer | DatabaseError:
    return platform.database_server_start(path)

def address(server: DatabaseServer) -> string:
    return platform.database_server_address(server)

def connect(server_address: string) -> DatabaseConnection | DatabaseError:
    return platform.database_server_connect(server_address)

def remote_execute(connection: DatabaseConnection, statement: string) -> int | DatabaseError:
    return platform.database_server_execute(connection, statement)

def remote_query(connection: DatabaseConnection, statement: string) -> Result[list[list[string]], DatabaseError]:
    return platform.database_server_query(connection, statement)

def disconnect(connection: DatabaseConnection) -> unit | DatabaseError:
    return platform.database_server_close(connection)

def stop(server: DatabaseServer) -> unit | DatabaseError:
    return platform.database_server_stop(server)

def must_execute(database: Database, statement: string) -> int:
    match execute(database, statement):
        case changed:
            return changed
        case error:
            assert(false, error)
            return -1

def must_close(database: Database):
    match close(database):
        ok:
            return
        case error:
            assert(false, error)

def must_remote_execute(connection: DatabaseConnection, statement: string) -> int:
    match remote_execute(connection, statement):
        case changed:
            return changed
        case error:
            assert(false, error)
            return -1

def must_disconnect(connection: DatabaseConnection):
    match disconnect(connection):
        ok:
            return
        case error:
            assert(false, error)

def must_stop(server: DatabaseServer):
    match stop(server):
        ok:
            return
        case error:
            assert(false, error)

test "executes SQL and iterates real result rows":
    match memory():
        case database:
            match execute(database, "CREATE TABLE people(id INTEGER PRIMARY KEY, name TEXT NOT NULL)"):
                case _:
                    match execute(database, "INSERT INTO people(id, name) VALUES (1, 'Ada'), (2, 'Grace'), (3, 'Linus')"):
                        case changed:
                            assert(changed == 3)
                            match query(database, "SELECT id, name FROM people ORDER BY id"):
                                case rows:
                                    names := []
                                    for row in rows:
                                        names.append(row[1])
                                    assert(names == ["Ada", "Grace", "Linus"])
                                    assert(rows[0][0] == "1")
                                    assert(rows[0][1] == "Ada")
                                case error:
                                    assert(false, error)
                        case error:
                            assert(false, error)
                case error:
                    assert(false, error)
        case error:
            assert(false, error)

test "transactions roll back mutations":
    match memory():
        case database:
            match execute(database, "CREATE TABLE events(id INTEGER PRIMARY KEY, name TEXT)"):
                case _:
                    must_execute(database, "BEGIN")
                    must_execute(database, "INSERT INTO events(id, name) VALUES (1, 'temporary')")
                    must_execute(database, "ROLLBACK")
                    match query(database, "SELECT COUNT(*) FROM events"):
                        case rows:
                            assert(rows[0][0] == "0")
                        case error:
                            assert(false, error)
                case error:
                    assert(false, error)
        case error:
            assert(false, error)

test "PQL validation feeds executable SQL":
    match memory():
        case database:
            must_execute(database, "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)")
            must_execute(database, "INSERT INTO users(id, name) VALUES (1, 'Ada'), (2, 'Grace')")
            schema = pql.Schema("users", ["id", "name"], ["int", "string"], [false, true], "id")
            statement = pql.Query("users", ["id", "name"], ["id", "name"], [false, false], "", "", [])
            match query_pql(database, schema, statement):
                case rows:
                    assert(size(rows) == 2)
                    assert(rows[0][0] == "1")
                    assert(rows[0][1] == "Ada")
                    assert(rows[1][0] == "2")
                    assert(rows[1][1] == "Grace")
                case error:
                    assert(false, error)
        case error:
            assert(false, error)

test "persistent databases survive reconnect":
    path = "/tmp/severian-database-persistence.sqlite"
    match open(path):
        case database:
            must_execute(database, "CREATE TABLE IF NOT EXISTS settings(id INTEGER PRIMARY KEY, value TEXT)")
            must_execute(database, "DELETE FROM settings")
            must_execute(database, "INSERT INTO settings(id, value) VALUES (1, 'durable')")
            must_close(database)
        case error:
            assert(false, error)
    match open(path):
        case database:
            match query(database, "SELECT id, value FROM settings ORDER BY id"):
                case rows:
                    assert(size(rows) == 1)
                    assert(rows[0][0] == "1")
                    assert(rows[0][1] == "durable")
                case error:
                    assert(false, error)
            must_close(database)
        case error:
            assert(false, error)

test with integ "database server accepts remote execute and query clients":
    match start(":memory:"):
        case server:
            match connect(address(server)):
                case connection:
                    must_remote_execute(connection, "CREATE TABLE jobs(id INTEGER PRIMARY KEY, state TEXT)")
                    must_remote_execute(connection, "INSERT INTO jobs(id, state) VALUES (1, 'queued'), (2, 'running')")
                    match remote_query(connection, "SELECT id, state FROM jobs ORDER BY id"):
                        case rows:
                            assert(size(rows) == 2)
                            assert(rows[0][0] == "1")
                            assert(rows[0][1] == "queued")
                            assert(rows[1][0] == "2")
                            assert(rows[1][1] == "running")
                        case error:
                            assert(false, error)
                    must_disconnect(connection)
                case error:
                    assert(false, error)
            must_stop(server)
        case error:
            assert(false, error)
