import os
import platform
import regex

def join(left: string, right: string) -> string:
    return platform.path_join(left, right)

def exists(value: string) -> bool:
    return os.exists(value)

def is_file(value: string) -> bool:
    match os.stat(value):
        ok information:
            return information.is_file
        failure _error:
            return false

def is_dir(value: string) -> bool:
    match os.stat(value):
        ok information:
            return information.is_directory
        failure _error:
            return false

def basename(value: string) -> string:
    return platform.path_basename(value)

def dirname(value: string) -> string:
    return platform.path_dirname(value)

def extension(value: string) -> string:
    return platform.path_extension(value)

def absolute(value: string) -> string:
    return platform.path_absolute(value)

def sanitize_name(value: string) -> string:
    words := []
    for word in value.strip().lower().words():
        cleaned = regex.sub("[^[:alnum:]_-]", "", word)
        if not cleaned.is_empty():
            words.append(cleaned)
    return "_".join(words)

test "path names are safe and stable":
    assert(sanitize_name("High  Overlord Saurfang!") == "high_overlord_saurfang")
    assert(sanitize_name("  !!! keep-me  ") == "keep-me")

test "path inspection handles files, directories, and missing paths":
    file_path = "/tmp/severian-library-path.txt"
    match platform.file_write(file_path, "path coverage"):
        ok:
            assert(exists(file_path))
            assert(is_file(file_path))
            assert(not is_dir(file_path))
            assert(basename(file_path) == "severian-library-path.txt")
            assert(dirname(file_path) == "/tmp")
            assert(extension(file_path) == ".txt")
            assert(absolute(file_path) == file_path)
        failure error:
            assert(false, error)
    assert(join("/tmp", "child") == "/tmp/child")
    assert(is_dir("/tmp"))
    assert(not is_file("/tmp"))
    missing = "/tmp/severian-path-does-not-exist/child"
    assert(not exists(missing))
    assert(not is_file(missing))
    assert(not is_dir(missing))
