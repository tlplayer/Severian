import pql

class StoragePlan:
    model: string
    resource: string
    operations: list[string]

def storage_copied(values: list[string]) -> list[string]:
    output := []
    for value in values:
        output.append(value)
    return output

def relational_scan(table: string) -> StoragePlan:
    return StoragePlan("relational", table, ["scan"])

def document_get(collection: string, key: string) -> StoragePlan:
    return StoragePlan("document", collection, ["get " + key])

def key_value_get(table: string, key: string) -> StoragePlan:
    return StoragePlan("key-value", table, ["get " + key])

def dynamo_query(table: string, partition_key: string, sort_condition: string) -> StoragePlan:
    return StoragePlan("dynamo", table, ["partition " + partition_key, "sort " + sort_condition])

def append_operation(plan: StoragePlan, operation: string) -> StoragePlan:
    operations = storage_copied(plan.operations)
    operations.append(operation)
    return StoragePlan(plan.model, plan.resource, operations)

def transaction(plans: list[StoragePlan]) -> list[string]:
    operations := ["begin"]
    for plan in plans:
        operations.append(plan.model + ":" + plan.resource)
        for operation in plan.operations:
            operations.append("  " + string(operation))
    operations.append("commit")
    return operations

def inspect_plan(plan: StoragePlan) -> list[string]:
    output := ["model=" + plan.model, "resource=" + plan.resource]
    for operation in plan.operations:
        output.append("operation=" + string(operation))
    return output

def storage_field_position(fields: list[string], expected: string) -> int:
    for index in indices(fields):
        if fields[index] == expected:
            return index
    return -1

def migration_errors(
    old_fields: list[string],
    old_types: list[string],
    new_fields: list[string],
    new_types: list[string],
) -> list[string]:
    errors := []
    if size(old_fields) != size(old_types) or size(new_fields) != size(new_types):
        errors.append("migration schema arity mismatch")
        return errors
    for index in indices(old_fields):
        next = storage_field_position(new_fields, old_fields[index])
        if next < 0:
            errors.append("removed field: " + string(old_fields[index]))
        else:
            if old_types[index] != new_types[next]:
                errors.append("changed field T: " + string(old_fields[index]))
    return errors

def schema_compatible(
    old_fields: list[string],
    old_types: list[string],
    new_fields: list[string],
    new_types: list[string],
) -> bool:
    return size(migration_errors(old_fields, old_types, new_fields, new_types)) == 0

def sql_adapter(dialect: string, statement: string) -> list[string]:
    return ["adapter=" + dialect, "statement=" + statement]

def dynamo_adapter(plan: StoragePlan) -> list[string]:
    assert(plan.model == "dynamo")
    return ["TableName=" + plan.resource, string(plan.operations[0]), string(plan.operations[1])]

test "relational plans compose and remain inspectable":
    plan = append_operation(append_operation(relational_scan("users"), "filter tenantId:int"), "project id,name")
    assert(inspect_plan(plan) == ["model=relational", "resource=users", "operation=scan", "operation=filter tenantId:int", "operation=project id,name"])

test "document key-value and Dynamo plans retain their models":
    assert(inspect_plan(document_get("sessions", "abc"))[0] == "model=document")
    assert(inspect_plan(key_value_get("cache", "answer"))[0] == "model=key-value")
    assert(dynamo_adapter(dynamo_query("events", "tenant=7", "time>100")) == ["TableName=events", "partition tenant=7", "sort time>100"])

test "transactions preserve operation order":
    plans = [append_operation(relational_scan("users"), "update id=1"), document_get("sessions", "abc")]
    assert(transaction(plans) == ["begin", "relational:users", "  scan", "  update id=1", "document:sessions", "  get abc", "commit"])

test "migrations reject removal and T changes":
    assert(migration_errors(["id", "name"], ["int", "string"], ["id"], ["string"]) == ["changed field T: id", "removed field: name"])
    assert(schema_compatible(["id"], ["int"], ["id", "name"], ["int", "string"]))

test "migrations reject either side of an arity mismatch before indexing":
    assert(migration_errors(["id"], [], ["id"], ["int"]) == ["migration schema arity mismatch"])
    assert(migration_errors(["id"], ["int"], ["id", "name"], ["int"]) == ["migration schema arity mismatch"])
    assert(not schema_compatible(["id"], [], ["id"], ["int"]))

test "SQL adapters consume PQL output":
    users = pql.Schema("users", ["id"], ["int"], [false], "id")
    query = pql.Query("users", ["id"], ["id"], [false], "", "", [])
    assert(sql_adapter("postgres", pql.sql(users, query, "postgres")) == ["adapter=postgres", "statement=SELECT id FROM users"])
