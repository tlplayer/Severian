import container
import database
import pql

class Workload:
    namespace: string
    name: string
    image: string
    replicas: int
    cpumillis: int
    memory_mi_b: int
    port: int
    volume: string
    version: string

class Node:
    name: string
    cpumillis: int
    memory_mi_b: int
    healthy: bool

class ObservedWorkload:
    replicas: int
    ready: int
    version: string

def workload_errors(workload: Workload) -> list[string]:
    failures := []
    if workload.namespace == "":
        failures.append("namespace is empty")
    if workload.name == "":
        failures.append("workload name is empty")
    if workload.image == "":
        failures.append("workload image is empty")
    if workload.replicas < 0:
        failures.append("replicas cannot be negative")
    if workload.cpumillis < 1 or workload.memory_mi_b < 1:
        failures.append("resource requests must be positive")
    if workload.port < 1 or workload.port > 65535:
        failures.append("service port is invalid")
    return failures

def workload_valid(workload: Workload) -> bool:
    return size(workload_errors(workload)) == 0

def schedule(workload: Workload, nodes: list[Node]) -> list[string]:
    assert(workload_valid(workload))
    placements := []
    if size(nodes) == 0:
        return ["unscheduled " + workload.name + ": no nodes"]
    for replica in range(0, workload.replicas):
        node = nodes[replica % size(nodes)]
        if node.healthy and node.cpumillis >= workload.cpumillis and node.memory_mi_b >= workload.memory_mi_b:
            placements.append(workload.name + "-" + string(replica) + " -> " + node.name)
        else:
            placements.append("unscheduled " + workload.name + "-" + string(replica))
    return placements

def reconcile(workload: Workload, observed: ObservedWorkload) -> list[string]:
    assert(workload_valid(workload))
    actions := []
    if observed.replicas < 0:
        actions.append("create " + workload.namespace + "/" + workload.name)
        actions.append("scale 0->" + string(workload.replicas))
        return actions
    if observed.version != workload.version:
        actions.append("rollout " + observed.version + "->" + workload.version)
    if observed.replicas != workload.replicas:
        actions.append("scale " + string(observed.replicas) + "->" + string(workload.replicas))
    if observed.ready < observed.replicas:
        actions.append("repair " + string(observed.replicas - observed.ready))
    if size(actions) == 0:
        actions.append("stable")
    return actions

def health_status(successes: int, failures: int, healthy_threshold: int, failure_threshold: int) -> string:
    if failures >= failure_threshold:
        return "unhealthy"
    if successes >= healthy_threshold:
        return "healthy"
    return "probing"

def queue_pressure(queued: int, capacity: int) -> string:
    assert(queued >= 0)
    assert(capacity > 0)
    if queued >= capacity:
        return "saturated"
    if queued * 4 >= capacity * 3:
        return "high"
    if queued * 2 >= capacity:
        return "moderate"
    return "low"

def inference_health(ready_workers: int, desired_workers: int, completed: int, accepted: int) -> string:
    if ready_workers < desired_workers:
        return "degraded"
    if completed < accepted:
        return "draining"
    return "ready"

def worker_recovery(worker_id: int, generation: int, healthy: bool) -> string:
    if healthy:
        return "worker " + string(worker_id) + " healthy generation " + string(generation)
    return "restart worker " + string(worker_id) + " generation " + string(generation + 1)

def service_address(workload: Workload, domain: string) -> string:
    return workload.name + "." + workload.namespace + ".svc." + domain + ":" + string(workload.port)

def rollout_plan(workload: Workload, from_version: string, max_unavailable: int) -> list[string]:
    assert(max_unavailable >= 0)
    return ["rollout " + workload.name, "from " + from_version, "to " + workload.version, "maxUnavailable " + string(max_unavailable), "health before promote", "rollback on failure"]

def volume_claim(workload: Workload, size_gi_b: int, storage_class: string) -> list[string]:
    assert(size_gi_b > 0)
    return ["claim " + workload.namespace + "/" + workload.volume, "sizeGiB " + string(size_gi_b), "class " + storage_class, "mount /var/lib/" + workload.name]

def initialize_controller_history(connection: Database) -> int:
    return database.must_execute(connection, "CREATE TABLE controller_events(id INTEGER PRIMARY KEY, namespace TEXT, workload TEXT, action TEXT)")

def record_controller_event(connection: Database, workload: Workload, action: string) -> int:
    statement = "INSERT INTO controller_events(namespace, workload, action) VALUES ('" + workload.namespace + "', '" + workload.name + "', '" + action + "')"
    return database.must_execute(connection, statement)

def controller_history(connection: Database) -> Result[list[list[string]], DatabaseError]:
    return database.query(connection, "SELECT namespace, workload, action FROM controller_events ORDER BY id")

def controller_sql() -> string:
    events = pql.Schema("controller_events", ["id", "namespace", "workload", "action"], ["int", "string", "string", "string"], [false, false, false, false], "id")
    query = pql.Query("controller_events", ["id", "action"], ["id", "action"], [false, false], "namespace", "string", [])
    return pql.sql(events, query, "postgres")

test "scheduler places replicas deterministically":
    workload = Workload("prod", "api", "sev://images/api:v2", 3, 250, 128, 8080, "api-state", "v2")
    nodes = [Node("node-a", 2000, 4096, true), Node("node-b", 2000, 4096, true)]
    assert(schedule(workload, nodes) == ["api-0 -> node-a", "api-1 -> node-b", "api-2 -> node-a"])

test "reconciliation handles rollout scale and repair":
    workload = Workload("prod", "api", "sev://images/api:v2", 4, 250, 128, 8080, "api-state", "v2")
    observed = ObservedWorkload(2, 1, "v1")
    assert(reconcile(workload, observed) == ["rollout v1->v2", "scale 2->4", "repair 1"])

test "health checks have explicit thresholds":
    assert(health_status(3, 0, 3, 2) == "healthy")
    assert(health_status(0, 2, 3, 2) == "unhealthy")
    assert(health_status(1, 0, 3, 2) == "probing")

test "inference pressure and recovery policy is deterministic":
    assert(queue_pressure(0, 8) == "low")
    assert(queue_pressure(4, 8) == "moderate")
    assert(queue_pressure(6, 8) == "high")
    assert(queue_pressure(8, 8) == "saturated")
    assert(inference_health(2, 2, 12, 12) == "ready")
    assert(inference_health(1, 2, 12, 12) == "degraded")
    assert(inference_health(2, 2, 10, 12) == "draining")
    assert(worker_recovery(3, 1, false) == "restart worker 3 generation 2")

test "service discovery and volumes are deterministic":
    workload = Workload("prod", "api", "sev://images/api:v2", 2, 250, 128, 8080, "api-state", "v2")
    assert(service_address(workload, "cluster.local") == "api.prod.svc.cluster.local:8080")
    assert(volume_claim(workload, 20, "fast") == ["claim prod/api-state", "sizeGiB 20", "class fast", "mount /var/lib/api"])

test "rollouts include promotion and rollback policy":
    workload = Workload("prod", "api", "sev://images/api:v2", 2, 250, 128, 8080, "api-state", "v2")
    assert(rollout_plan(workload, "v1", 1) == ["rollout api", "from v1", "to v2", "maxUnavailable 1", "health before promote", "rollback on failure"])

test "controller history executes against the database":
    workload = Workload("prod", "api", "sev://images/api:v2", 2, 250, 128, 8080, "api-state", "v2")
    match database.memory():
        case connection:
            initialize_controller_history(connection)
            assert(record_controller_event(connection, workload, "stable") == 1)
            match controller_history(connection):
                case rows:
                    assert(rows[0][0] == "prod")
                    assert(rows[0][1] == "api")
                    assert(rows[0][2] == "stable")
                case error:
                    assert(false, error)
        case error:
            assert(false, error)

test "controller queries are PQL validated before emission":
    assert(controller_sql() == "SELECT id, action FROM controller_events WHERE namespace = $1")
