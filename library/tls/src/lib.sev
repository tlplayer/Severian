import io
import network
import platform

class TlsError:
    message: string

class TlsConnection:
    handle: platform.TlsHandle

    def read(count: int) -> Result[list[int], io.StreamError]:
        match platform.tls_read(handle, count):
            ok data:
                return data
            failure error:
                return error(io.StreamError(string(error)))

    def write(data: list[int]) -> int | io.StreamError:
        match platform.tls_write(handle, data):
            ok count:
                return count
            failure error:
                return error(io.StreamError(string(error)))

    def close() -> unit | io.StreamError:
        match platform.tls_close(handle):
            ok _value:
                return
            failure error:
                return error(io.StreamError(string(error)))

def connect(connection: network.TcpConnection, server_name: string) -> TlsConnection | TlsError:
    match platform.tls_connect(connection.native_handle(), server_name):
        ok secure:
            return TlsConnection(secure)
        failure error:
            return error(TlsError(string(error)))
