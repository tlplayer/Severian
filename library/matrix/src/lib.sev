native("__sev_matrix_new") def matrix(rows: int, columns: int, fill: float = 0.0) -> Matrix[f32]

def random(rows: int, columns: int) -> Matrix[f32]:
    return matrix(rows, columns, 1.0)

def identity(size: int) -> Matrix[f32]:
    return matrix(size, size, 1.0)

native("__sev_matrix_multiply") def multiply(left: Matrix[f32], right: Matrix[f32]) -> Matrix[f32]

native("__sev_matrix_scale") def scale(value: Matrix[f32], factor: float) -> Matrix[f32]

def cross(left: list[float], right: list[float]) -> list[float]:
    return [
        left[1] * right[2] - left[2] * right[1],
        left[2] * right[0] - left[0] * right[2],
        left[0] * right[1] - left[1] * right[0],
    ]

def jacobianMatrix(values: list[float]) -> Matrix[f32]:
    return identity(size(values))
