import tensor

trait Module:
    forward(input: Tensor[f64]) -> Tensor[f64]

class Linear: Module
    weight: Tensor[f64]
    bias: Tensor[f64]

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        return tensor.ranked_add(tensor.ranked_matmul(input, weight), bias)

class LayerNorm: Module
    epsilon: float = 0.00001

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        return tensor.ranked_layer_norm(input, epsilon)

class MultiheadAttention: Module
    query_weight: Tensor[f64]
    key_weight: Tensor[f64]
    value_weight: Tensor[f64]
    output_weight: Tensor[f64]
    attention_scale: float

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        query = tensor.ranked_matmul(input, query_weight)
        key = tensor.ranked_matmul(input, key_weight)
        value = tensor.ranked_matmul(input, value_weight)
        scores = tensor.ranked_scale(tensor.ranked_matmul(query, tensor.ranked_transpose(key)), attention_scale)
        context = tensor.ranked_matmul(tensor.ranked_softmax_rows(scores), value)
        return tensor.ranked_matmul(context, output_weight)

class TransformerEncoderLayer: Module
    attention: MultiheadAttention
    linear1: Linear
    linear2: Linear
    norm1: LayerNorm
    norm2: LayerNorm

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        attended = attention.forward(input)
        attention_residual = tensor.ranked_add(input, attended)
        residual = norm1.forward(attention_residual)
        hidden = tensor.ranked_relu(linear1.forward(residual))
        projected = linear2.forward(hidden)
        combined = tensor.ranked_add(residual, projected)
        return norm2.forward(combined)

# The BF16 transformer path below is the extracted, compiler-visible kernel set
# used by the checkpoint-backed Qwen2.5 acceptance workload. Qwen-specific
# configuration and weight names live in model.architectures.qwen; these types
# describe reusable transformer operations and mutable KV state only.
class RopeValues:
    cosine: Tensor[f32]
    sine: Tensor[f32]

class AttentionProjectionWeights:
    query: Tensor[bf16]
    query_bias: Tensor[bf16]
    key: Tensor[bf16]
    key_bias: Tensor[bf16]
    value: Tensor[bf16]
    value_bias: Tensor[bf16]
    output: Tensor[bf16]

class GatedMlpWeights:
    gate: Tensor[bf16]
    up: Tensor[bf16]
    down: Tensor[bf16]

class TransformerDecoderWeights:
    input_norm: Tensor[bf16]
    attention: AttentionProjectionWeights
    post_attention_norm: Tensor[bf16]
    mlp: GatedMlpWeights

class KvCache:
    keys: Tensor[bf16]
    values: Tensor[bf16]

class AttentionResult:
    output: Tensor[bf16]
    cache: KvCache

class DecoderResult:
    hidden: Tensor[bf16]
    cache: KvCache

def rotary_values(position_frequencies: Tensor[f32]) -> RopeValues:
    return RopeValues(
        tensor.cosine_f_32(position_frequencies),
        tensor.sine_f_32(position_frequencies),
    )

def rotate_half(value: Tensor[f32], half_dimension: int) -> Tensor[f32]:
    first = tensor.slice_f_32(value, [0, 0, 0, 0], [-1, -1, -1, half_dimension], [1, 1, 1, 1])
    second = tensor.slice_f_32(value, [0, 0, 0, half_dimension], [-1, -1, -1, half_dimension * 2], [1, 1, 1, 1])
    return tensor.concatenate_f_32([tensor.scale_f_32(second, -1.0), first], 3)

def apply_rotary(value: Tensor[bf16], rope: RopeValues, half_dimension: int) -> Tensor[bf16]:
    value_f_32 = tensor.bf16_to_f_32(value)
    cosine = tensor.broadcast_like_f_32(rope.cosine, value_f_32)
    sine = tensor.broadcast_like_f_32(rope.sine, value_f_32)
    direct = tensor.multiply_f_32(value_f_32, cosine)
    rotated = tensor.multiply_f_32(rotate_half(value_f_32, half_dimension), sine)
    return tensor.f32_to_bf_16(tensor.add_f_32(direct, rotated))

def stable_softmax(scores: Tensor[f32]) -> Tensor[f32]:
    maximum := tensor.max_last_f_32(scores)
    maximum = tensor.broadcast_like_f_32(maximum, scores)
    shifted = tensor.subtract_f_32(scores, maximum)
    exponentials = tensor.exp_f_32(shifted)
    denominator := tensor.sum_last_f_32(exponentials)
    denominator = tensor.broadcast_like_f_32(denominator, scores)
    return tensor.divide_f_32(exponentials, denominator)

def repeat_key_value(value: Tensor[bf16], repeats: int) -> Tensor[bf16]:
    shape = tensor.shape_bf_16(value)
    assert(size(shape) == 4)
    expanded := tensor.reshape_bf_16(value, [shape[0], shape[1], 1, shape[2], shape[3]])
    expanded = tensor.broadcast_bf_16(expanded, [shape[0], shape[1], repeats, shape[2], shape[3]])
    return tensor.reshape_bf_16(expanded, [shape[0], shape[1] * repeats, shape[2], shape[3]])

def append_cache(cache: KvCache, key: Tensor[bf16], value: Tensor[bf16], position: int) -> KvCache:
    keys = tensor.dynamic_update_slice_bf_16(cache.keys, key, [0, 0, position, 0])
    values = tensor.dynamic_update_slice_bf_16(cache.values, value, [0, 0, position, 0])
    return KvCache(keys, values)

def grouped_query_attention(
    query: Tensor[bf16],
    key: Tensor[bf16],
    value: Tensor[bf16],
    causal_mask: Tensor[f32],
    kv_repeat: int,
    head_dimension: int,
) -> Tensor[bf16]:
    repeated_key = repeat_key_value(key, kv_repeat)
    repeated_value = repeat_key_value(value, kv_repeat)
    transposed_key = tensor.transpose_bf_16(repeated_key, [0, 1, 3, 2])
    scores := tensor.batched_matmul_f_32(tensor.bf16_to_f_32(query), tensor.bf16_to_f_32(transposed_key))
    scores = tensor.scale_f_32(scores, 1.0 / (float(head_dimension) ** 0.5))
    scores = tensor.add_f_32(scores, causal_mask)
    probabilities = stable_softmax(scores)
    context = tensor.batched_matmul_f_32(probabilities, tensor.bf16_to_f_32(repeated_value))
    return tensor.f32_to_bf_16(context)

def self_attention(
    input: Tensor[bf16],
    weights: AttentionProjectionWeights,
    cache: KvCache,
    rotary: RopeValues,
    causal_mask: Tensor[f32],
    position: int,
    num_heads: int,
    num_kv_heads: int,
    head_dimension: int,
) -> AttentionResult:
    query := tensor.matmul_bf_16(input, tensor.transpose_bf_16(weights.query, [1, 0]))
    key := tensor.matmul_bf_16(input, tensor.transpose_bf_16(weights.key, [1, 0]))
    value := tensor.matmul_bf_16(input, tensor.transpose_bf_16(weights.value, [1, 0]))
    query = tensor.add_bf_16(query, tensor.broadcast_like_bf_16(weights.query_bias, query))
    key = tensor.add_bf_16(key, tensor.broadcast_like_bf_16(weights.key_bias, key))
    value = tensor.add_bf_16(value, tensor.broadcast_like_bf_16(weights.value_bias, value))
    input_shape = tensor.shape_bf_16(input)
    query = tensor.reshape_bf_16(query, [input_shape[0], input_shape[1], num_heads, head_dimension])
    key = tensor.reshape_bf_16(key, [input_shape[0], input_shape[1], num_kv_heads, head_dimension])
    value = tensor.reshape_bf_16(value, [input_shape[0], input_shape[1], num_kv_heads, head_dimension])
    query = tensor.transpose_bf_16(query, [0, 2, 1, 3])
    key = tensor.transpose_bf_16(key, [0, 2, 1, 3])
    value = tensor.transpose_bf_16(value, [0, 2, 1, 3])
    query = apply_rotary(query, rotary, head_dimension / 2)
    key = apply_rotary(key, rotary, head_dimension / 2)
    updated_cache = append_cache(cache, key, value, position)
    attended := grouped_query_attention(
        query, updated_cache.keys, updated_cache.values, causal_mask,
        num_heads / num_kv_heads, head_dimension,
    )
    attended = tensor.transpose_bf_16(attended, [0, 2, 1, 3])
    attended = tensor.reshape_bf_16(attended, [-1, -1, num_heads * head_dimension])
    output = tensor.matmul_bf_16(attended, tensor.transpose_bf_16(weights.output, [1, 0]))
    return AttentionResult(output, updated_cache)

def silu_bf_16(value: Tensor[bf16]) -> Tensor[bf16]:
    return tensor.multiply_bf_16(value, tensor.sigmoid_bf_16(value))

def gated_mlp(input: Tensor[bf16], weights: GatedMlpWeights) -> Tensor[bf16]:
    gate = tensor.matmul_bf_16(input, tensor.transpose_bf_16(weights.gate, [1, 0]))
    up = tensor.matmul_bf_16(input, tensor.transpose_bf_16(weights.up, [1, 0]))
    hidden = tensor.multiply_bf_16(silu_bf_16(gate), up)
    return tensor.matmul_bf_16(hidden, tensor.transpose_bf_16(weights.down, [1, 0]))

def rms_norm_bf_16(input: Tensor[bf16], weight: Tensor[bf16], epsilon: float) -> Tensor[bf16]:
    input_f_32 = tensor.bf16_to_f_32(input)
    variance := tensor.mean_last_f_32(tensor.multiply_f_32(input_f_32, input_f_32))
    variance = tensor.add_scalar_f_32(variance, epsilon)
    inverse_rms := tensor.rsqrt_f_32(variance)
    inverse_rms = tensor.broadcast_like_f_32(inverse_rms, input_f_32)
    normalized = tensor.f32_to_bf_16(tensor.multiply_f_32(input_f_32, inverse_rms))
    return tensor.multiply_bf_16(normalized, tensor.broadcast_like_bf_16(weight, normalized))

def transformer_decoder_layer(
    hidden: Tensor[bf16],
    weights: TransformerDecoderWeights,
    cache: KvCache,
    rotary: RopeValues,
    causal_mask: Tensor[f32],
    position: int,
    epsilon: float,
    num_heads: int,
    num_kv_heads: int,
    head_dimension: int,
) -> DecoderResult:
    normalized = rms_norm_bf_16(hidden, weights.input_norm, epsilon)
    attended = self_attention(
        normalized, weights.attention, cache, rotary, causal_mask, position,
        num_heads, num_kv_heads, head_dimension,
    )
    current = tensor.add_bf_16(hidden, attended.output)
    feed_forward = gated_mlp(rms_norm_bf_16(current, weights.post_attention_norm, epsilon), weights.mlp)
    return DecoderResult(tensor.add_bf_16(current, feed_forward), attended.cache)

test "Linear follows the conventional input weight bias order":
    x = tensor.ranked([1.0, 2.0, 3.0, 4.0], [2, 2])
    weight = tensor.ranked([1.0, 0.0, 0.0, 1.0], [2, 2])
    bias = tensor.ranked([10.0, 20.0], [2])
    layer = Linear(weight, bias)
    assert(tensor.ranked_values(layer.forward(x)) == [11.0, 22.0, 13.0, 24.0])

test "TransformerEncoderLayer composes attention residuals and FFN":
    x = tensor.ranked([0.2, -0.4, 0.7, 0.1, -0.3, 0.8], [3, 2])
    identity = tensor.ranked([1.0, 0.0, 0.0, 1.0], [2, 2])
    attention = MultiheadAttention(identity, identity, identity, identity, 0.7071067811865476)
    linear1 = Linear(tensor.ranked([0.5, -0.25, 0.75, 0.1, -0.4, 0.6, 0.2, 0.3], [2, 4]), tensor.ranked([0.01, -0.02, 0.03, 0.04], [4]))
    linear2 = Linear(tensor.ranked([0.4, -0.2, 0.1, 0.5, -0.3, 0.7, 0.6, 0.2], [4, 2]), tensor.ranked([0.0, 0.0], [2]))
    layer = TransformerEncoderLayer(attention, linear1, linear2, LayerNorm(), LayerNorm())
    output = layer.forward(x)
    assert(tensor.ranked_shape(output) == [3, 2])
    assert(tensor.ranked_values(output)[0] > 0.99)
