import audio

class HiggsAudioV2Config:
    sample_rate: int
    codebooks: int
    codebook_size: int
    hop_length: int

class HiggsAudioV2Tokens:
    values: Tensor[i32]
    codebooks: int
    frames: int

trait Encoder:
    encode(input: audio.Audio) -> HiggsAudioV2Tokens

trait Decoder:
    decode(tokens: HiggsAudioV2Tokens) -> audio.Audio

# Encoder/decoder executable binding is added after Qwen generation parity. The
# typed contract is intentionally independent so codec parity can be tested from
# official reference tokens without loading OmniVoice.
class HiggsAudioV2Codec:
    config: HiggsAudioV2Config

