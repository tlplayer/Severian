import model

# Native Severian translation of the transformer sequence-classification
# workload. There is no Python process, PyTorch object, or framework runtime.

class Config:
    vocab_size: int = 8192
    sequence_length: int = 128
    num_classes: int = 8
    embedding_dim: int = 256
    num_heads: int = 8
    num_layers: int = 6
    feedforward_dim: int = 1024
    dropout: float = 0.1
    dataset_size: int = 20000
    batch_size: int = 64
    epochs: int = 10
    learning_rate: float = 0.0003
    weight_decay: float = 0.01
    warmup_steps: int = 200
    gradient_accumulation_steps: int = 2
    max_gradient_norm: float = 1.0
    validation_split: float = 0.1
    seed: int = 42

def example_config() -> Config:
    # Keeps the example fast under the native graph interpreter. Replacing
    # these values with Config() reproduces the production-sized workload.
    return Config(128, 12, 4, 16, 4, 2, 32, 0.1, 96, 8, 3, 0.003, 0.01, 4, 2, 1.0, 0.2, 42)

class PositionalEncoding:
    encoding: Tensor[f64]

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        return model.add(input, encoding)

def positional_encoding(embedding_dim: int, maximum_length: int) -> PositionalEncoding:
    assert(embedding_dim % 2 == 0)
    half = embedding_dim / 2
    positions = model.reshape(model.arange(0.0, float(maximum_length), 1.0), [maximum_length, 1])
    exponents = model.scale(
        model.arange(0.0, float(half), 1.0),
        -2.0 * 9.210340371976184 / float(embedding_dim),
    )
    divisors = model.reshape(model.exp(exponents), [1, half])
    angles = model.matmul(positions, divisors)
    sine = model.values(model.sin(angles))
    cosine = model.values(model.cos(angles))
    interleaved := []
    for position in range(0, maximum_length):
        for column in range(0, half):
            index = position * half + column
            interleaved.append(sine[index])
            interleaved.append(cosine[index])
    return PositionalEncoding(model.tensor(interleaved, [maximum_length, embedding_dim]))

class TransformerBlock:
    first_norm: model.LayerNorm
    attention_layer: model.MultiheadAttention
    second_norm: model.LayerNorm
    feedforward_input: model.Linear
    feedforward_output: model.Linear
    dropout_layer: model.Dropout
    embedding_dim: int

    def attention_map(input: Tensor[f64]) -> Tensor[f64]:
        normalized = first_norm.forward(input)
        query = attention_layer.query.forward(normalized)
        key = attention_layer.key.forward(normalized)
        scores = model.matmul(query, model.transpose(key))
        return model.softmax(model.scale(scores, 1.0 / scalar_sqrt(float(embedding_dim))))

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        normalized = first_norm.forward(input)
        attended = attention_layer.forward(normalized)
        first_residual = model.add(input, dropout_layer.forward(attended))
        normalized_residual = second_norm.forward(first_residual)
        hidden = model.gelu(feedforward_input.forward(normalized_residual))
        projected = feedforward_output.forward(dropout_layer.forward(hidden))
        return model.add(first_residual, dropout_layer.forward(projected))

    def parameters() -> list[Tensor[f64]]:
        return attention_layer.parameters() + feedforward_input.parameters() + feedforward_output.parameters()

def transformer_block(config: Config) -> TransformerBlock:
    return TransformerBlock(
        model.layer_norm(),
        model.multihead_attention(config.embedding_dim, config.num_heads),
        model.layer_norm(),
        model.linear(config.embedding_dim, config.feedforward_dim),
        model.linear(config.feedforward_dim, config.embedding_dim),
        model.dropout(config.dropout),
        config.embedding_dim,
    )

class TransformerClassifier:
    config: Config
    token_embedding: model.Embedding
    position: PositionalEncoding
    blocks: list[TransformerBlock]
    final_norm: model.LayerNorm
    head_hidden: model.Linear
    head_output: model.Linear
    training: bool = true

    def train():
        training = true
        for block in blocks:
            block.dropout_layer.training = true

    def eval():
        training = false
        for block in blocks:
            block.dropout_layer.training = false

    def encode(tokens: Tensor[f64]) -> Tensor[f64]:
        embedded = token_embedding.forward(tokens)
        hidden := position.forward(model.scale(embedded, scalar_sqrt(float(config.embedding_dim))))
        for block in blocks:
            hidden = block.forward(hidden)
        normalized = final_norm.forward(hidden)
        dimensions = model.shape(normalized)
        source = model.values(normalized)
        pooled := float_zeros(dimensions[1])
        token_values = model.values(tokens)
        valid := 0
        for row in range(0, dimensions[0]):
            if token_values[row] == 0.0:
                continue
            valid += 1
            for column in range(0, dimensions[1]):
                pooled[column] += source[row * dimensions[1] + column]
        for column in indices(pooled):
            pooled[column] /= max(1, valid)
        return model.tensor(pooled, [1, dimensions[1]])

    def hidden(tokens: Tensor[f64]) -> tuple[Tensor[f64], Tensor[f64]]:
        embedded = token_embedding.forward(tokens)
        encoded := position.forward(model.scale(embedded, scalar_sqrt(float(config.embedding_dim))))
        for block in blocks:
            encoded = block.forward(encoded)
        normalized = final_norm.forward(encoded)
        dimensions = model.shape(normalized)
        source = model.values(normalized)
        pooled := float_zeros(dimensions[1])
        token_values = model.values(tokens)
        valid := 0
        for row in range(0, dimensions[0]):
            if token_values[row] == 0.0:
                continue
            valid += 1
            for column in range(0, dimensions[1]):
                pooled[column] += source[row * dimensions[1] + column]
        for column in indices(pooled):
            pooled[column] /= max(1, valid)
        features = model.tensor(pooled, [1, dimensions[1]])
        preactivation = head_hidden.forward(features)
        activated = model.gelu(preactivation)
        return (features, activated)

    def forward(tokens: Tensor[f64]) -> Tensor[f64]:
        embedded = token_embedding.forward(tokens)
        encoded := position.forward(model.scale(embedded, scalar_sqrt(float(config.embedding_dim))))
        for block in blocks:
            encoded = block.forward(encoded)
        normalized = final_norm.forward(encoded)
        dimensions = model.shape(normalized)
        source = model.values(normalized)
        pooled := float_zeros(dimensions[1])
        token_values = model.values(tokens)
        valid := 0
        for row in range(0, dimensions[0]):
            if token_values[row] == 0.0:
                continue
            valid += 1
            for column in range(0, dimensions[1]):
                pooled[column] += source[row * dimensions[1] + column]
        for column in indices(pooled):
            pooled[column] /= max(1, valid)
        features = model.tensor(pooled, [1, dimensions[1]])
        activated = model.gelu(head_hidden.forward(features))
        return head_output.forward(activated)

    def predict(tokens: Tensor[f64]) -> int:
        embedded = token_embedding.forward(tokens)
        encoded := position.forward(model.scale(embedded, scalar_sqrt(float(config.embedding_dim))))
        for block in blocks:
            encoded = block.forward(encoded)
        normalized = final_norm.forward(encoded)
        dimensions = model.shape(normalized)
        source = model.values(normalized)
        pooled := float_zeros(dimensions[1])
        for row in range(0, dimensions[0]):
            for column in range(0, dimensions[1]):
                pooled[column] += source[row * dimensions[1] + column] / dimensions[0]
        features = model.tensor(pooled, [1, dimensions[1]])
        return model.argmax(head_output.forward(model.gelu(head_hidden.forward(features))))

    def parameters() -> list[Tensor[f64]]:
        output = token_embedding.parameters()
        for block in blocks:
            output.extend(block.parameters())
        output.extend(head_hidden.parameters())
        output.extend(head_output.parameters())
        return output

def transformer_classifier(config: Config) -> TransformerClassifier:
    blocks := []
    for _layer in range(0, config.num_layers):
        blocks.append(transformer_block(config))
    return TransformerClassifier(
        config,
        model.embedding(config.vocab_size, config.embedding_dim),
        positional_encoding(config.embedding_dim, config.sequence_length),
        blocks,
        model.layer_norm(),
        model.linear(config.embedding_dim, config.embedding_dim),
        model.linear(config.embedding_dim, config.num_classes),
    )

def scalar_sqrt(value: float) -> float:
    return model.values(model.sqrt(model.tensor([value], [1])))[0]

def float_zeros(count: int) -> list[float]:
    output := []
    for _index in range(0, count):
        output.append(0.0)
    return output

def maximum_value(values: list[float]) -> float:
    assert(size(values) > 0)
    best := values[0]
    for value in values[1:size(values)]:
        best = max(best, value)
    return best

def synthetic_dataset(config: Config) -> model.Dataset:
    samples := []
    labels := []
    for _sample in range(0, config.dataset_size):
        tokens = model.randint(1, config.vocab_size, [config.sequence_length])
        token_values = model.values(tokens)
        first := 0
        for index in range(0, min(16, config.sequence_length)):
            first += model.floor(token_values[index])
        middle_start = config.sequence_length / 3
        middle_stop = 2 * config.sequence_length / 3
        middle := 0.0
        for index in range(middle_start, middle_stop):
            middle += token_values[index]
        middle = middle / max(1, middle_stop - middle_start)
        last := 0.0
        for index in range(max(0, config.sequence_length - 16), config.sequence_length):
            last = max(last, token_values[index])
        samples.append(tokens)
        labels.append((first + model.floor(middle) + model.floor(last)) % config.num_classes)
    return model.dataset(samples, labels)

class WarmupCosineScheduler:
    base_learning_rate: float
    warmup_steps: int
    total_steps: int
    minimum_ratio: float = 0.1
    step_number: int = 0

    def ratio() -> float:
        if step_number < warmup_steps:
            return float(step_number) / float(max(1, warmup_steps))
        progress = float(step_number - warmup_steps) / float(max(1, total_steps - warmup_steps))
        cosine = model.values(model.cos(model.tensor([3.141592653589793 * progress], [1])))[0]
        return minimum_ratio + (1.0 - minimum_ratio) * 0.5 * (1.0 + cosine)

    def step() -> float:
        step_number += 1
        current_ratio := 0.0
        if step_number < warmup_steps:
            current_ratio = float(step_number) / float(max(1, warmup_steps))
        else:
            progress = float(step_number - warmup_steps) / float(max(1, total_steps - warmup_steps))
            cosine = model.values(model.cos(model.tensor([3.141592653589793 * progress], [1])))[0]
            current_ratio = minimum_ratio + (1.0 - minimum_ratio) * 0.5 * (1.0 + cosine)
        return base_learning_rate * current_ratio

class Checkpoint:
    epoch: int
    step: int
    validation_loss: float
    hidden_weight: Tensor[f64]
    hidden_bias: Tensor[f64]
    output_weight: Tensor[f64]
    output_bias: Tensor[f64]

def copied(value: Tensor[f64]) -> Tensor[f64]:
    return model.tensor(model.values(value), model.shape(value))

def save_checkpoint(network: TransformerClassifier, epoch: int, step: int, validation_loss: float) -> Checkpoint:
    return Checkpoint(
        epoch,
        step,
        validation_loss,
        copied(network.head_hidden.weight),
        copied(network.head_hidden.bias),
        copied(network.head_output.weight),
        copied(network.head_output.bias),
    )

def load_checkpoint(network: TransformerClassifier, checkpoint: Checkpoint):
    network.head_hidden.weight = copied(checkpoint.hidden_weight)
    network.head_hidden.bias = copied(checkpoint.hidden_bias)
    network.head_output.weight = copied(checkpoint.output_weight)
    network.head_output.bias = copied(checkpoint.output_bias)

def gelu_derivative(value: float) -> float:
    epsilon = 0.00001
    positive = model.values(model.gelu(model.tensor([value + epsilon], [1])))[0]
    negative = model.values(model.gelu(model.tensor([value - epsilon], [1])))[0]
    return (positive - negative) / (2.0 * epsilon)

def train_batch(
    network: TransformerClassifier,
    batch: model.Dataset,
    learning_rate: float,
    weight_decay: float,
    maximum_gradient_norm: float,
) -> tuple[float, int]:
    hidden_weight = model.values(network.head_hidden.weight)
    hidden_bias = model.values(network.head_hidden.bias)
    output_weight = model.values(network.head_output.weight)
    output_bias = model.values(network.head_output.bias)
    hidden_width = network.config.embedding_dim
    classes = network.config.num_classes
    hidden_weight_gradient = float_zeros(size(hidden_weight))
    hidden_bias_gradient = float_zeros(size(hidden_bias))
    output_weight_gradient = float_zeros(size(output_weight))
    output_bias_gradient = float_zeros(size(output_bias))
    total_loss := 0.0
    correct := 0
    for sample_index in indices(batch.features):
        features, activated = network.hidden(batch.features[sample_index])
        preactivation = model.values(network.head_hidden.forward(features))
        feature_values = model.values(features)
        activated_values = model.values(activated)
        logits = network.head_output.forward(activated)
        label = batch.targets[sample_index]
        total_loss += model.cross_entropy(logits, [label])
        probabilities = model.values(model.softmax(logits))
        if probabilities.index(maximum_value(probabilities)) == label:
            correct += 1
        probabilities[label] -= 1.0
        hidden_gradient := float_zeros(hidden_width)
        for hidden_index in range(0, hidden_width):
            for class_index in range(0, classes):
                output_index = hidden_index * classes + class_index
                output_weight_gradient[output_index] += activated_values[hidden_index] * probabilities[class_index]
                hidden_gradient[hidden_index] += output_weight[output_index] * probabilities[class_index]
        for class_index in range(0, classes):
            output_bias_gradient[class_index] += probabilities[class_index]
        for hidden_index in range(0, hidden_width):
            hidden_gradient[hidden_index] *= gelu_derivative(preactivation[hidden_index])
            hidden_bias_gradient[hidden_index] += hidden_gradient[hidden_index]
            for feature_index in range(0, hidden_width):
                hidden_weight_gradient[feature_index * hidden_width + hidden_index] += feature_values[feature_index] * hidden_gradient[hidden_index]
    gradients = hidden_weight_gradient + hidden_bias_gradient + output_weight_gradient + output_bias_gradient
    squared_norm = gradients.map(|gradient| gradient * gradient).reduce(|total, value| total + value, 0.0)
    gradient_norm = scalar_sqrt(squared_norm)
    batch_scale = 1.0 / float(size(batch.features))
    clip_scale = minimum(1.0, maximum_gradient_norm / max(0.000000001, gradient_norm * batch_scale))
    scale = batch_scale * clip_scale
    for index in indices(hidden_weight):
        hidden_weight[index] -= learning_rate * (scale * hidden_weight_gradient[index] + weight_decay * hidden_weight[index])
    for index in indices(hidden_bias):
        hidden_bias[index] -= learning_rate * scale * hidden_bias_gradient[index]
    for index in indices(output_weight):
        output_weight[index] -= learning_rate * (scale * output_weight_gradient[index] + weight_decay * output_weight[index])
    for index in indices(output_bias):
        output_bias[index] -= learning_rate * scale * output_bias_gradient[index]
    network.head_hidden.weight = model.tensor(hidden_weight, model.shape(network.head_hidden.weight))
    network.head_hidden.bias = model.tensor(hidden_bias, model.shape(network.head_hidden.bias))
    network.head_output.weight = model.tensor(output_weight, model.shape(network.head_output.weight))
    network.head_output.bias = model.tensor(output_bias, model.shape(network.head_output.bias))
    return (total_loss / float(size(batch.features)), correct)

def minimum(left: float, right: float) -> float:
    return left if left < right else right

def evaluate(network: TransformerClassifier, loader: model.DataLoader) -> map[string, float]:
    network.eval()
    total_loss := 0.0
    expected := []
    predicted := []
    for batch in loader.batches():
        for index in indices(batch.features):
            logits = network.forward(batch.features[index])
            total_loss += model.cross_entropy(logits, [batch.targets[index]])
            expected.append(batch.targets[index])
            predicted.append(model.argmax(logits))
    return {
        "loss": total_loss / float(size(expected)),
        "accuracy": model.accuracy(expected, predicted),
    }

def train(config: Config) -> tuple[TransformerClassifier, Checkpoint]:
    model.seed(config.seed)
    complete = synthetic_dataset(config)
    train_features, validation_features, train_targets, validation_targets = model.train_test_split(
        complete.features,
        complete.targets,
        config.validation_split,
        true,
        config.seed,
    )
    training = model.dataset(train_features, train_targets)
    validation = model.dataset(validation_features, validation_targets)
    training_loader = model.dataloader(training, config.batch_size, true)
    validation_loader = model.dataloader(validation, config.batch_size)
    network = transformer_classifier(config)
    steps_per_epoch = (size(training_loader.batches()) + config.gradient_accumulation_steps - 1) / config.gradient_accumulation_steps
    scheduler = WarmupCosineScheduler(config.learning_rate, config.warmup_steps, steps_per_epoch * config.epochs)
    best_loss := 999999999999.0
    global_step := 0
    checkpoint := save_checkpoint(network, 0, 0, best_loss)
    print("device: native Severian")
    print("parameters:", network.parameters().map(|parameter| model.size(parameter)).reduce(|total, count| total + count, 0))
    for epoch in range(0, config.epochs):
        network.train()
        epoch_loss := 0.0
        epoch_correct := 0
        epoch_samples := 0
        current_learning_rate := config.learning_rate
        for batch_index, batch in enumerate(training_loader.batches()):
            batch_loss, batch_correct = train_batch(
                network,
                batch,
                current_learning_rate,
                config.weight_decay,
                config.max_gradient_norm,
            )
            epoch_loss += batch_loss * size(batch.features)
            epoch_correct += batch_correct
            epoch_samples += size(batch.features)
            if (batch_index + 1) % config.gradient_accumulation_steps == 0:
                current_learning_rate = scheduler.step()
                global_step += 1
        validation_metrics = evaluate(network, validation_loader)
        print("epoch", epoch + 1, "train loss", epoch_loss / float(epoch_samples))
        print("train accuracy", float(epoch_correct) / float(epoch_samples))
        print("validation loss", validation_metrics["loss"])
        print("validation accuracy", validation_metrics["accuracy"])
        if validation_metrics["loss"] < best_loss:
            best_loss = validation_metrics["loss"]
            checkpoint = save_checkpoint(network, epoch, global_step, best_loss)
            print("checkpoint saved at step", global_step)
    return (network, checkpoint)

def run_inference(network: TransformerClassifier, config: Config):
    network.eval()
    tokens = model.randint(1, config.vocab_size, [config.sequence_length])
    logits = network.forward(tokens)
    probabilities = model.softmax(logits)
    attention = network.blocks[0].attention_map(network.position.forward(network.token_embedding.forward(tokens)))
    print("inference prediction:", model.argmax(probabilities))
    print("probabilities:", model.values(probabilities))
    print("attention layers:", size(network.blocks))
    print("attention shape:", model.shape(attention))

def main():
    config = example_config()
    network, checkpoint = train(config)
    load_checkpoint(network, checkpoint)
    print("restored checkpoint from epoch", checkpoint.epoch + 1)
    run_inference(network, config)

test "synthetic labels are deterministic after seeding":
    config = example_config()
    model.seed(config.seed)
    first = synthetic_dataset(config)
    model.seed(config.seed)
    second = synthetic_dataset(config)
    assert(first.targets == second.targets)
