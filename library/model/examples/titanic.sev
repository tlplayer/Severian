import data
import model
from model import preprocessing
from model import metrics
from model import linear

def main():
    train = data.read_csv("train.csv")
    test_data = data.read_csv("test.csv")

    features = [
        "Pclass",
        "Sex",
        "Age",
        "SibSp",
        "Parch",
        "Fare",
        "Embarked",
    ]

    pipeline = model.Pipeline([
        preprocessing.Select(features),
        preprocessing.Impute({
            "Age": preprocessing.median,
            "Fare": preprocessing.median,
            "Embarked": preprocessing.most_frequent,
        }),
        preprocessing.OneHot(["Sex", "Embarked"]),
        preprocessing.Standardize(["Age", "Fare"]),
        linear.LogisticRegression(
            learningRate=0.05,
            epochs=500,
            regularization=0.001,
        ),
    ])

    pipeline.fit(train, target="Survived")

    predictions = pipeline.predict(test_data)

    data.write_csv(
        "submission.csv",
        {
            "PassengerId": test_data["PassengerId"],
            "Survived": predictions,
        },
    )
