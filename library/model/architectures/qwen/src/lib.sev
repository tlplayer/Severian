import json
import layers as model_layers
import neuralnet
import tensor

class QwenConfigError:
    message: string

class Qwen2Config:
    architecture: string
    model_type: string
    vocab_size: int
    hidden_size: int
    intermediate_size: int
    num_hidden_layers: int
    num_attention_heads: int
    num_key_value_heads: int
    rms_norm_epsilon: float
    rope_theta: float
    max_position_embeddings: int
    tie_word_embeddings: bool
    dtype: string

    def head_dimension() -> int:
        return hidden_size / num_attention_heads

    def kv_repeat() -> int:
        return num_attention_heads / num_key_value_heads

    def validate() -> unit | QwenConfigError:
        if model_type != "qwen2" or architecture != "Qwen2ForCausalLM":
            return failure(QwenConfigError("configuration does not describe Qwen2ForCausalLM"))
        if dtype not in ["bfloat16", "bf16"]:
            return failure(QwenConfigError("the first Qwen2 execution plan requires BF16 weights"))
        if hidden_size <= 0 or num_attention_heads <= 0 or hidden_size % num_attention_heads != 0:
            return failure(QwenConfigError("Qwen hidden size must divide evenly across attention heads"))
        if num_key_value_heads <= 0 or num_attention_heads % num_key_value_heads != 0:
            return failure(QwenConfigError("Qwen attention heads must divide evenly across KV heads"))
        if num_hidden_layers <= 0 or vocab_size <= 0:
            return failure(QwenConfigError("Qwen layer and vocabulary counts must be positive"))
        return

def parse_qwen_2_config(text: string) -> Qwen2Config | JsonError | QwenConfigError:
    document = json.decode[Any](text)
    architectures = json.as_string_list(json.object_get(document, "architectures"))
    if size(architectures) == 0:
        return failure(QwenConfigError("Qwen config has no architecture declaration"))
    config = Qwen2Config(
        architectures[0],
        json.as_string(json.object_get(document, "model_type")),
        json.as_int(json.object_get(document, "vocab_size")),
        json.as_int(json.object_get(document, "hidden_size")),
        json.as_int(json.object_get(document, "intermediate_size")),
        json.as_int(json.object_get(document, "num_hidden_layers")),
        json.as_int(json.object_get(document, "num_attention_heads")),
        json.as_int(json.object_get(document, "num_key_value_heads")),
        json.as_float(json.object_get(document, "rms_norm_eps")),
        json.as_float(json.object_get(document, "rope_theta")),
        json.as_int(json.object_get(document, "max_position_embeddings")),
        json.as_bool(json.object_get(document, "tie_word_embeddings")),
        json.as_string(json.object_get(document, "torch_dtype")),
    )
    _valid = config.validate()
    return config

class Qwen3Config:
    architecture: string
    model_type: string
    vocab_size: int
    hidden_size: int
    intermediate_size: int
    num_hidden_layers: int
    num_attention_heads: int
    num_key_value_heads: int
    head_dimension: int
    rms_norm_epsilon: float
    rope_theta: float
    max_position_embeddings: int
    tie_word_embeddings: bool
    dtype: string

    def kv_repeat() -> int:
        return num_attention_heads / num_key_value_heads

    def validate() -> unit | QwenConfigError:
        if model_type != "qwen3" or architecture != "Qwen3ForCausalLM":
            return failure(QwenConfigError("configuration does not describe Qwen3ForCausalLM"))
        if dtype not in ["bfloat16", "bf16"]:
            return failure(QwenConfigError("the first Qwen3 decoder layer requires BF16 weights"))
        if hidden_size <= 0 or head_dimension <= 0 or num_attention_heads <= 0:
            return failure(QwenConfigError("Qwen3 hidden and attention dimensions must be positive"))
        if num_attention_heads * head_dimension != hidden_size:
            return failure(QwenConfigError("Qwen3 query heads do not reconstruct hidden_size"))
        if num_key_value_heads <= 0 or num_attention_heads % num_key_value_heads != 0:
            return failure(QwenConfigError("Qwen3 attention heads must divide evenly across KV heads"))
        if intermediate_size <= 0 or num_hidden_layers <= 0 or vocab_size <= 0:
            return failure(QwenConfigError("Qwen3 layer, intermediate, and vocabulary sizes must be positive"))
        if rms_norm_epsilon <= 0.0 or rope_theta <= 0.0 or max_position_embeddings <= 0:
            return failure(QwenConfigError("Qwen3 normalization and rotary configuration must be positive"))
        return

def parse_qwen_3_config(text: string) -> Qwen3Config | JsonError | QwenConfigError:
    document = json.decode[Any](text)
    architectures = json.as_string_list(json.object_get(document, "architectures"))
    if size(architectures) == 0:
        return failure(QwenConfigError("Qwen3 config has no architecture declaration"))
    keys = json.object_keys(document)
    hidden_size = json.as_int(json.object_get(document, "hidden_size"))
    attention_heads = json.as_int(json.object_get(document, "num_attention_heads"))
    derived_head_dimension = hidden_size / attention_heads if attention_heads > 0 else 0
    head_dimension = json.as_int(json.object_get(document, "head_dim")) if "head_dim" in keys else derived_head_dimension
    dtype = json.as_string(json.object_get(document, "torch_dtype")) if "torch_dtype" in keys else "bfloat16"
    config = Qwen3Config(
        architectures[0],
        json.as_string(json.object_get(document, "model_type")),
        json.as_int(json.object_get(document, "vocab_size")),
        hidden_size,
        json.as_int(json.object_get(document, "intermediate_size")),
        json.as_int(json.object_get(document, "num_hidden_layers")),
        attention_heads,
        json.as_int(json.object_get(document, "num_key_value_heads")),
        head_dimension,
        json.as_float(json.object_get(document, "rms_norm_eps")),
        json.as_float(json.object_get(document, "rope_theta")),
        json.as_int(json.object_get(document, "max_position_embeddings")),
        json.as_bool(json.object_get(document, "tie_word_embeddings")),
        dtype,
    )
    _valid = config.validate()
    return config

class AttentionOutput:
    hidden: Tensor[bf16]
    cache: neuralnet.KvCache

class DecoderLayerOutput[T: TensorDType]:
    hidden: Tensor[T]
    cache: neuralnet.KvCache

class Qwen3Attention:
    query: model_layers.Linear[bf16]
    key: model_layers.Linear[bf16]
    value: model_layers.Linear[bf16]
    output: model_layers.Linear[bf16]
    query_norm: model_layers.RMSNorm[bf16]
    key_norm: model_layers.RMSNorm[bf16]
    num_heads: int
    num_key_value_heads: int
    head_dimension: int
    rope: neuralnet.RotaryEmbedding

    def attend(
        hidden_states: Tensor[bf16],
        position_ids: Tensor[i64],
        mask: Tensor[f32],
        cache: neuralnet.KvCache,
        cache_position: int,
    ) -> AttentionOutput:
        input_shape = tensor.shape_bf_16(hidden_states)
        projected_query: Tensor[bf16] = query.forward(hidden_states)
        projected_key: Tensor[bf16] = key.forward(hidden_states)
        projected_value: Tensor[bf16] = value.forward(hidden_states)
        reshaped_query: Tensor[bf16] = tensor.reshape(
            projected_query,
            [input_shape[0], input_shape[1], num_heads, head_dimension],
        )
        reshaped_key: Tensor[bf16] = tensor.reshape(
            projected_key,
            [input_shape[0], input_shape[1], num_key_value_heads, head_dimension],
        )
        reshaped_value: Tensor[bf16] = tensor.reshape(
            projected_value,
            [input_shape[0], input_shape[1], num_key_value_heads, head_dimension],
        )
        query_heads = query_norm.forward(tensor.transpose_bf_16(reshaped_query, [0, 2, 1, 3]))
        key_heads = key_norm.forward(tensor.transpose_bf_16(reshaped_key, [0, 2, 1, 3]))
        value_heads = tensor.transpose_bf_16(reshaped_value, [0, 2, 1, 3])
        rotated = rope.apply(query_heads, key_heads, position_ids)
        updated_cache = neuralnet.append_cache(cache, rotated.key, value_heads, cache_position)
        context := neuralnet.grouped_query_attention(
            rotated.query,
            updated_cache.keys,
            updated_cache.values,
            mask,
            num_heads / num_key_value_heads,
            head_dimension,
        )
        context = tensor.transpose_bf_16(context, [0, 2, 1, 3])
        context = tensor.reshape(
            context,
            [input_shape[0], input_shape[1], num_heads * head_dimension],
        )
        return AttentionOutput(output.forward(context), updated_cache)

class Qwen3MLP[T: TensorDType + Float]:
    gate_proj: model_layers.Linear[T]
    up_proj: model_layers.Linear[T]
    down_proj: model_layers.Linear[T]

    def forward(hidden_states: Tensor[T]) -> Tensor[T]:
        gate = tensor.ranked_silu(gate_proj.forward(hidden_states))
        up = up_proj.forward(hidden_states)
        return down_proj.forward(tensor.ranked_multiply(gate, up))

class Qwen3DecoderLayer:
    input_norm: model_layers.RMSNorm[bf16]
    attention: Qwen3Attention
    post_attention_norm: model_layers.RMSNorm[bf16]
    mlp: Qwen3MLP[bf16]

    def forward(
        hidden_states: Tensor[bf16],
        position_ids: Tensor[i64],
        mask: Tensor[f32],
        cache: neuralnet.KvCache,
        cache_position: int,
    ) -> DecoderLayerOutput[bf16]:
        attended = attention.attend(
            input_norm.forward(hidden_states), position_ids, mask, cache, cache_position,
        )
        attention_residual = tensor.ranked_add(hidden_states, attended.hidden)
        feed_forward = mlp.forward(post_attention_norm.forward(attention_residual))
        return DecoderLayerOutput[bf16](
            tensor.ranked_add(attention_residual, feed_forward),
            attended.cache,
        )

def require_shape(value: tensor.SafeTensorEntry, expected: list[int]) -> unit | QwenConfigError:
    if value.dtype != "BF16":
        return failure(QwenConfigError(
            "Qwen3 tensor `" + value.name + "` uses unsupported dtype `" + value.dtype + "`; expected BF16",
        ))
    if value.shape != expected:
        return failure(QwenConfigError(
            "Qwen3 tensor `" + value.name + "` has shape " + string(value.shape) +
            "; expected " + string(expected),
        ))
    return

def load_qwen_3_decoder_layer(
    store: tensor.SafeTensorStore,
    config: Qwen3Config,
    layer: int,
    rope: neuralnet.RotaryEmbedding,
) -> Qwen3DecoderLayer | IOError | QwenConfigError:
    if layer < 0 or layer >= config.num_hidden_layers:
        return failure(QwenConfigError("Qwen3 decoder layer index is outside the configured model"))
    prefix = "model.layers." + string(layer)
    input_norm = store.get(prefix + ".input_layernorm.weight")
    query = store.get(prefix + ".self_attn.q_proj.weight")
    key = store.get(prefix + ".self_attn.k_proj.weight")
    value = store.get(prefix + ".self_attn.v_proj.weight")
    output = store.get(prefix + ".self_attn.o_proj.weight")
    query_norm = store.get(prefix + ".self_attn.q_norm.weight")
    key_norm = store.get(prefix + ".self_attn.k_norm.weight")
    post_norm = store.get(prefix + ".post_attention_layernorm.weight")
    gate = store.get(prefix + ".mlp.gate_proj.weight")
    up = store.get(prefix + ".mlp.up_proj.weight")
    down = store.get(prefix + ".mlp.down_proj.weight")
    hidden = config.hidden_size
    query_width = config.num_attention_heads * config.head_dimension
    kv_width = config.num_key_value_heads * config.head_dimension
    _input_shape = require_shape(input_norm, [hidden])
    _query_shape = require_shape(query, [query_width, hidden])
    _key_shape = require_shape(key, [kv_width, hidden])
    _value_shape = require_shape(value, [kv_width, hidden])
    _output_shape = require_shape(output, [hidden, query_width])
    _query_norm_shape = require_shape(query_norm, [config.head_dimension])
    _key_norm_shape = require_shape(key_norm, [config.head_dimension])
    _post_shape = require_shape(post_norm, [hidden])
    _gate_shape = require_shape(gate, [config.intermediate_size, hidden])
    _up_shape = require_shape(up, [config.intermediate_size, hidden])
    _down_shape = require_shape(down, [hidden, config.intermediate_size])
    attention = Qwen3Attention(
        model_layers.Linear[bf16](query.bf16()),
        model_layers.Linear[bf16](key.bf16()),
        model_layers.Linear[bf16](value.bf16()),
        model_layers.Linear[bf16](output.bf16()),
        model_layers.RMSNorm[bf16](query_norm.bf16(), config.rms_norm_epsilon),
        model_layers.RMSNorm[bf16](key_norm.bf16(), config.rms_norm_epsilon),
        config.num_attention_heads,
        config.num_key_value_heads,
        config.head_dimension,
        rope,
    )
    mlp = Qwen3MLP[bf16](
        model_layers.Linear[bf16](gate.bf16()),
        model_layers.Linear[bf16](up.bf16()),
        model_layers.Linear[bf16](down.bf16()),
    )
    return Qwen3DecoderLayer(
        model_layers.RMSNorm[bf16](input_norm.bf16(), config.rms_norm_epsilon),
        attention,
        model_layers.RMSNorm[bf16](post_norm.bf16(), config.rms_norm_epsilon),
        mlp,
    )

class Qwen2Attention:
    query: model_layers.LinearWithBias[bf16]
    key: model_layers.LinearWithBias[bf16]
    value: model_layers.LinearWithBias[bf16]
    output: model_layers.Linear[bf16]
    num_heads: int
    num_key_value_heads: int
    head_dimension: int
    rope: neuralnet.RotaryEmbedding

    def attend(
        hidden_states: Tensor[bf16],
        position_ids: Tensor[i64],
        mask: Tensor[f32],
        cache: neuralnet.KvCache,
        cache_position: int,
    ) -> AttentionOutput:
        input_shape = tensor.shape_bf_16(hidden_states)
        projected_query: Tensor[bf16] = query.forward(hidden_states)
        projected_key: Tensor[bf16] = key.forward(hidden_states)
        projected_value: Tensor[bf16] = value.forward(hidden_states)
        reshaped_query: Tensor[bf16] = tensor.reshape(
            projected_query,
            [input_shape[0], input_shape[1], num_heads, head_dimension],
        )
        reshaped_key: Tensor[bf16] = tensor.reshape(
            projected_key,
            [input_shape[0], input_shape[1], num_key_value_heads, head_dimension],
        )
        reshaped_value: Tensor[bf16] = tensor.reshape(
            projected_value,
            [input_shape[0], input_shape[1], num_key_value_heads, head_dimension],
        )
        query_heads = tensor.transpose_bf_16(reshaped_query, [0, 2, 1, 3])
        key_heads = tensor.transpose_bf_16(reshaped_key, [0, 2, 1, 3])
        value_heads = tensor.transpose_bf_16(reshaped_value, [0, 2, 1, 3])
        rotated = rope.apply(query_heads, key_heads, position_ids)
        updated_cache = neuralnet.append_cache(cache, rotated.key, value_heads, cache_position)
        context := neuralnet.grouped_query_attention(
            rotated.query,
            updated_cache.keys,
            updated_cache.values,
            mask,
            num_heads / num_key_value_heads,
            head_dimension,
        )
        context = tensor.transpose_bf_16(context, [0, 2, 1, 3])
        context = tensor.reshape(
            context,
            [input_shape[0], input_shape[1], num_heads * head_dimension],
        )
        return AttentionOutput(output.forward(context), updated_cache)

class Qwen2MLP[T: TensorDType + Float]:
    gate_proj: model_layers.Linear[T]
    up_proj: model_layers.Linear[T]
    down_proj: model_layers.Linear[T]

    def forward(hidden_states: Tensor[T]) -> Tensor[T]:
        gate = tensor.ranked_silu(gate_proj.forward(hidden_states))
        up = up_proj.forward(hidden_states)
        return down_proj.forward(tensor.ranked_multiply(gate, up))

class Qwen2DecoderLayer:
    input_norm: model_layers.RMSNorm[bf16]
    attention: Qwen2Attention
    post_attention_norm: model_layers.RMSNorm[bf16]
    mlp: Qwen2MLP[bf16]

    def forward(
        hidden_states: Tensor[bf16],
        position_ids: Tensor[i64],
        mask: Tensor[f32],
        cache: neuralnet.KvCache,
        cache_position: int,
    ) -> DecoderLayerOutput[bf16]:
        attended = attention.attend(
            input_norm.forward(hidden_states), position_ids, mask, cache, cache_position,
        )
        attention_residual = tensor.ranked_add(hidden_states, attended.hidden)
        feed_forward = mlp.forward(post_attention_norm.forward(attention_residual))
        return DecoderLayerOutput[bf16](
            tensor.ranked_add(attention_residual, feed_forward),
            attended.cache,
        )

def require_qwen_2_shape(
    value: tensor.SafeTensorEntry,
    expected: list[int],
) -> unit | QwenConfigError:
    if value.dtype != "BF16":
        return failure(QwenConfigError(
            "Qwen2 tensor `" + value.name + "` uses unsupported dtype `" + value.dtype + "`; expected BF16",
        ))
    if value.shape != expected:
        return failure(QwenConfigError(
            "Qwen2 tensor `" + value.name + "` has shape " + string(value.shape) +
            "; expected " + string(expected),
        ))
    return

def load_qwen_2_decoder_layer(
    store: tensor.SafeTensorStore,
    config: Qwen2Config,
    layer: int,
    rope: neuralnet.RotaryEmbedding,
) -> Qwen2DecoderLayer | IOError | QwenConfigError:
    if layer < 0 or layer >= config.num_hidden_layers:
        return failure(QwenConfigError("Qwen2 decoder layer index is outside the configured model"))
    prefix = "model.layers." + string(layer)
    input_norm = store.get(prefix + ".input_layernorm.weight")
    query = store.get(prefix + ".self_attn.q_proj.weight")
    query_bias = store.get(prefix + ".self_attn.q_proj.bias")
    key = store.get(prefix + ".self_attn.k_proj.weight")
    key_bias = store.get(prefix + ".self_attn.k_proj.bias")
    value = store.get(prefix + ".self_attn.v_proj.weight")
    value_bias = store.get(prefix + ".self_attn.v_proj.bias")
    output = store.get(prefix + ".self_attn.o_proj.weight")
    post_norm = store.get(prefix + ".post_attention_layernorm.weight")
    gate = store.get(prefix + ".mlp.gate_proj.weight")
    up = store.get(prefix + ".mlp.up_proj.weight")
    down = store.get(prefix + ".mlp.down_proj.weight")
    hidden = config.hidden_size
    query_width = config.num_attention_heads * config.head_dimension()
    kv_width = config.num_key_value_heads * config.head_dimension()
    _input_shape = require_qwen_2_shape(input_norm, [hidden])
    _query_shape = require_qwen_2_shape(query, [query_width, hidden])
    _query_bias_shape = require_qwen_2_shape(query_bias, [query_width])
    _key_shape = require_qwen_2_shape(key, [kv_width, hidden])
    _key_bias_shape = require_qwen_2_shape(key_bias, [kv_width])
    _value_shape = require_qwen_2_shape(value, [kv_width, hidden])
    _value_bias_shape = require_qwen_2_shape(value_bias, [kv_width])
    _output_shape = require_qwen_2_shape(output, [hidden, query_width])
    _post_shape = require_qwen_2_shape(post_norm, [hidden])
    _gate_shape = require_qwen_2_shape(gate, [config.intermediate_size, hidden])
    _up_shape = require_qwen_2_shape(up, [config.intermediate_size, hidden])
    _down_shape = require_qwen_2_shape(down, [hidden, config.intermediate_size])
    attention = Qwen2Attention(
        model_layers.LinearWithBias[bf16](query.bf16(), query_bias.bf16()),
        model_layers.LinearWithBias[bf16](key.bf16(), key_bias.bf16()),
        model_layers.LinearWithBias[bf16](value.bf16(), value_bias.bf16()),
        model_layers.Linear[bf16](output.bf16()),
        config.num_attention_heads,
        config.num_key_value_heads,
        config.head_dimension(),
        rope,
    )
    mlp = Qwen2MLP[bf16](
        model_layers.Linear[bf16](gate.bf16()),
        model_layers.Linear[bf16](up.bf16()),
        model_layers.Linear[bf16](down.bf16()),
    )
    return Qwen2DecoderLayer(
        model_layers.RMSNorm[bf16](input_norm.bf16(), config.rms_norm_epsilon),
        attention,
        model_layers.RMSNorm[bf16](post_norm.bf16(), config.rms_norm_epsilon),
        mlp,
    )

test "Qwen2.5 configuration derives grouped-query dimensions":
    text = "{\"architectures\":[\"Qwen2ForCausalLM\"],\"model_type\":\"qwen2\",\"vocab_size\":151936,\"hidden_size\":2048,\"intermediate_size\":11008,\"num_hidden_layers\":36,\"num_attention_heads\":16,\"num_key_value_heads\":2,\"rms_norm_eps\":0.000001,\"rope_theta\":1000000.0,\"max_position_embeddings\":32768,\"tie_word_embeddings\":true,\"torch_dtype\":\"bfloat16\"}"
    config = parse_qwen_2_config(text)
    assert(config.head_dimension() == 128)
    assert(config.kv_repeat() == 8)

test "Qwen3 configuration keeps query and KV head geometry separate":
    text = "{\"architectures\":[\"Qwen3ForCausalLM\"],\"model_type\":\"qwen3\",\"vocab_size\":151936,\"hidden_size\":32,\"intermediate_size\":64,\"num_hidden_layers\":1,\"num_attention_heads\":4,\"num_key_value_heads\":2,\"head_dim\":8,\"rms_norm_eps\":0.000001,\"rope_theta\":1000000.0,\"max_position_embeddings\":4096,\"tie_word_embeddings\":true,\"torch_dtype\":\"bfloat16\"}"
    config = parse_qwen_3_config(text)
    assert(config.head_dimension == 8)
    assert(config.kv_repeat() == 2)
