import tensor

# Qwen2.5-3B prefill uses a static XLA capacity of 32 while the tokenizer list
# controls the active sequence length, padding mask, and selected logits row.

def model_to_f_32(value: Tensor[bf16, 1, 32, 2048]) -> Tensor[f32, 1, 32, 2048]:
    return tensor.bf16_to_f_32(value)

def model_to_bf_16(value: Tensor[f32, 1, 32, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.f32_to_bf_16(value)

def model_multiply_f_32(left: Tensor[f32, 1, 32, 2048], right: Tensor[f32, 1, 32, 2048]) -> Tensor[f32, 1, 32, 2048]:
    return tensor.multiply_f_32(left, right)

def model_mean_last(value: Tensor[f32, 1, 32, 2048]) -> Tensor[f32, 1, 32]:
    return tensor.mean_last_f_32(value)

def stabilize_mean(value: Tensor[f32, 1, 32]) -> Tensor[f32, 1, 32]:
    return tensor.add_scalar_f_32(value, 0.000001)

def inverse_mean(value: Tensor[f32, 1, 32]) -> Tensor[f32, 1, 32]:
    return tensor.rsqrt_f_32(value)

def broadcast_mean(value: Tensor[f32, 1, 32], target: Tensor[f32, 1, 32, 2048]) -> Tensor[f32, 1, 32, 2048]:
    return tensor.broadcast_like_f_32(value, target)

def broadcast_norm(value: Tensor[bf16, 2048], target: Tensor[bf16, 1, 32, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.broadcast_like_bf_16(value, target)

def model_multiply_bf_16(left: Tensor[bf16, 1, 32, 2048], right: Tensor[bf16, 1, 32, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.multiply_bf_16(left, right)

def model_add_bf_16(left: Tensor[bf16, 1, 32, 2048], right: Tensor[bf16, 1, 32, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.add_bf_16(left, right)

def qwen_rms_norm(value: Tensor[bf16, 1, 32, 2048], weight: Tensor[bf16, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    value_f_32 = model_to_f_32(value)
    square = model_multiply_f_32(value_f_32, value_f_32)
    variance = model_mean_last(square)
    inverse = inverse_mean(stabilize_mean(variance))
    normalized_f_32 = model_multiply_f_32(value_f_32, broadcast_mean(inverse, value_f_32))
    normalized = model_to_bf_16(normalized_f_32)
    return model_multiply_bf_16(normalized, broadcast_norm(weight, normalized))

def transpose_model_weight(weight: Tensor[bf16, 2048, 2048]) -> Tensor[bf16, 2048, 2048]:
    return tensor.transpose_bf_16(weight, [1, 0])

def transpose_kv_weight(weight: Tensor[bf16, 256, 2048]) -> Tensor[bf16, 2048, 256]:
    return tensor.transpose_bf_16(weight, [1, 0])

def transpose_mlp_weight(weight: Tensor[bf16, 11008, 2048]) -> Tensor[bf16, 2048, 11008]:
    return tensor.transpose_bf_16(weight, [1, 0])

def transpose_down_weight(weight: Tensor[bf16, 2048, 11008]) -> Tensor[bf16, 11008, 2048]:
    return tensor.transpose_bf_16(weight, [1, 0])

def transpose_embedding(weight: Tensor[bf16, 151936, 2048]) -> Tensor[bf16, 2048, 151936]:
    return tensor.transpose_bf_16(weight, [1, 0])

def query_projection(value: Tensor[bf16, 1, 32, 2048], weight: Tensor[bf16, 2048, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.matmul_bf_16(value, weight)

def kv_projection(value: Tensor[bf16, 1, 32, 2048], weight: Tensor[bf16, 2048, 256]) -> Tensor[bf16, 1, 32, 256]:
    return tensor.matmul_bf_16(value, weight)

def broadcast_query_bias(value: Tensor[bf16, 2048], target: Tensor[bf16, 1, 32, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.broadcast_like_bf_16(value, target)

def broadcast_kv_bias(value: Tensor[bf16, 256], target: Tensor[bf16, 1, 32, 256]) -> Tensor[bf16, 1, 32, 256]:
    return tensor.broadcast_like_bf_16(value, target)

def add_kv(left: Tensor[bf16, 1, 32, 256], right: Tensor[bf16, 1, 32, 256]) -> Tensor[bf16, 1, 32, 256]:
    return tensor.add_bf_16(left, right)

def reshape_query(value: Tensor[bf16, 1, 32, 2048]) -> Tensor[bf16, 1, 32, 16, 128]:
    return tensor.reshape_bf_16(value, [1, 32, 16, 128])

def reshape_kv(value: Tensor[bf16, 1, 32, 256]) -> Tensor[bf16, 1, 32, 2, 128]:
    return tensor.reshape_bf_16(value, [1, 32, 2, 128])

def transpose_query(value: Tensor[bf16, 1, 32, 16, 128]) -> Tensor[bf16, 1, 16, 32, 128]:
    return tensor.transpose_bf_16(value, [0, 2, 1, 3])

def transpose_kv(value: Tensor[bf16, 1, 32, 2, 128]) -> Tensor[bf16, 1, 2, 32, 128]:
    return tensor.transpose_bf_16(value, [0, 2, 1, 3])

def query_heads_to_f_32(value: Tensor[bf16, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.bf16_to_f_32(value)

def kv_heads_to_f_32(value: Tensor[bf16, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    return tensor.bf16_to_f_32(value)

def query_scale_one(value: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.scale_f_32(value, 1.0)

def query_scale_zero(value: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.scale_f_32(value, 0.0)

def kv_scale_one(value: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    return tensor.scale_f_32(value, 1.0)

def kv_scale_zero(value: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    return tensor.scale_f_32(value, 0.0)

def query_add_f_32(left: Tensor[f32, 1, 16, 32, 128], right: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.add_f_32(left, right)

def kv_add_f_32(left: Tensor[f32, 1, 2, 32, 128], right: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    return tensor.add_f_32(left, right)

def query_multiply_f_32(left: Tensor[f32, 1, 16, 32, 128], right: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.multiply_f_32(left, right)

def kv_multiply_f_32(left: Tensor[f32, 1, 2, 32, 128], right: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    return tensor.multiply_f_32(left, right)

def broadcast_query_rope(value: Tensor[f32, 1, 1, 32, 128], target: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.broadcast_like_f_32(value, target)

def broadcast_kv_rope(value: Tensor[f32, 1, 1, 32, 128], target: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    return tensor.broadcast_like_f_32(value, target)

def query_first_half(value: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 64]:
    return tensor.slice_f_32(value, [0, 0, 0, 0], [1, 16, 32, 64], [1, 1, 1, 1])

def query_second_half(value: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 64]:
    return tensor.slice_f_32(value, [0, 0, 0, 64], [1, 16, 32, 128], [1, 1, 1, 1])

def kv_first_half(value: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 64]:
    return tensor.slice_f_32(value, [0, 0, 0, 0], [1, 2, 32, 64], [1, 1, 1, 1])

def kv_second_half(value: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 64]:
    return tensor.slice_f_32(value, [0, 0, 0, 64], [1, 2, 32, 128], [1, 1, 1, 1])

def negate_query_half(value: Tensor[f32, 1, 16, 32, 64]) -> Tensor[f32, 1, 16, 32, 64]:
    zero = query_half_zero(value)
    return tensor.subtract_f_32(zero, value)

def negate_kv_half(value: Tensor[f32, 1, 2, 32, 64]) -> Tensor[f32, 1, 2, 32, 64]:
    zero = kv_half_zero(value)
    return tensor.subtract_f_32(zero, value)

def query_half_zero(value: Tensor[f32, 1, 16, 32, 64]) -> Tensor[f32, 1, 16, 32, 64]:
    return tensor.scale_f_32(value, 0.0)

def kv_half_zero(value: Tensor[f32, 1, 2, 32, 64]) -> Tensor[f32, 1, 2, 32, 64]:
    return tensor.scale_f_32(value, 0.0)

def rotate_half_query(value: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    first = query_first_half(value)
    second = query_second_half(value)
    negative_second = negate_query_half(second)
    return tensor.concatenate_f_32([negative_second, first], 3)

def rotate_half_kv(value: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    first = kv_first_half(value)
    second = kv_second_half(value)
    negative_second = negate_kv_half(second)
    return tensor.concatenate_f_32([negative_second, first], 3)

def apply_query_rope(value: Tensor[f32, 1, 16, 32, 128], cosine: Tensor[f32, 1, 1, 32, 128], sine: Tensor[f32, 1, 1, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    cosine_values = broadcast_query_rope(cosine, value)
    sine_values = broadcast_query_rope(sine, value)
    rotated_value = rotate_half_query(value)
    direct = query_multiply_f_32(value, cosine_values)
    rotated = query_multiply_f_32(rotated_value, sine_values)
    return query_add_f_32(direct, rotated)

def apply_kv_rope(value: Tensor[f32, 1, 2, 32, 128], cosine: Tensor[f32, 1, 1, 32, 128], sine: Tensor[f32, 1, 1, 32, 128]) -> Tensor[f32, 1, 2, 32, 128]:
    cosine_values = broadcast_kv_rope(cosine, value)
    sine_values = broadcast_kv_rope(sine, value)
    rotated_value = rotate_half_kv(value)
    direct = kv_multiply_f_32(value, cosine_values)
    rotated = kv_multiply_f_32(rotated_value, sine_values)
    return kv_add_f_32(direct, rotated)

def expand_key(value: Tensor[f32, 1, 2, 32, 128]) -> Tensor[f32, 1, 2, 1, 32, 128]:
    return tensor.reshape_f_32(value, [1, 2, 1, 32, 128])

def expand_value(value: Tensor[bf16, 1, 2, 32, 128]) -> Tensor[bf16, 1, 2, 1, 32, 128]:
    return tensor.reshape_bf_16(value, [1, 2, 1, 32, 128])

def repeat_key(value: Tensor[f32, 1, 2, 1, 32, 128]) -> Tensor[f32, 1, 2, 8, 32, 128]:
    return tensor.broadcast_f_32(value, [1, 2, 8, 32, 128])

def repeat_value(value: Tensor[bf16, 1, 2, 1, 32, 128]) -> Tensor[bf16, 1, 2, 8, 32, 128]:
    return tensor.broadcast_bf_16(value, [1, 2, 8, 32, 128])

def merge_key_heads(value: Tensor[f32, 1, 2, 8, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.reshape_f_32(value, [1, 16, 32, 128])

def merge_value_heads(value: Tensor[bf16, 1, 2, 8, 32, 128]) -> Tensor[bf16, 1, 16, 32, 128]:
    return tensor.reshape_bf_16(value, [1, 16, 32, 128])

def value_heads_to_f_32(value: Tensor[bf16, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.bf16_to_f_32(value)

def transpose_key(value: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 128, 32]:
    return tensor.transpose_f_32(value, [0, 1, 3, 2])

def attention_scores(query: Tensor[f32, 1, 16, 32, 128], key: Tensor[f32, 1, 16, 128, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    return tensor.batched_matmul_f_32(query, key)

def scale_scores(value: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    return tensor.scale_f_32(value, 0.08838834764831845)

def broadcast_mask(value: Tensor[f32, 1, 1, 32, 32], target: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    return tensor.broadcast_like_f_32(value, target)

def apply_causal_mask(value: Tensor[f32, 1, 16, 32, 32], mask: Tensor[f32, 1, 1, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    expanded_mask = broadcast_mask(mask, value)
    return tensor.add_f_32(value, expanded_mask)

def scores_max(value: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32]:
    return tensor.max_last_f_32(value)

def broadcast_scores(value: Tensor[f32, 1, 16, 32], target: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    return tensor.broadcast_like_f_32(value, target)

def subtract_scores(left: Tensor[f32, 1, 16, 32, 32], right: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    return tensor.subtract_f_32(left, right)

def exp_scores(value: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    return tensor.exp_f_32(value)

def scores_sum(value: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32]:
    return tensor.sum_last_f_32(value)

def divide_scores(left: Tensor[f32, 1, 16, 32, 32], right: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    return tensor.divide_f_32(left, right)

def stable_softmax_single(value: Tensor[f32, 1, 16, 32, 32]) -> Tensor[f32, 1, 16, 32, 32]:
    maximum = scores_max(value)
    shifted = subtract_scores(value, broadcast_scores(maximum, value))
    exponentials = exp_scores(shifted)
    denominator = scores_sum(exponentials)
    return divide_scores(exponentials, broadcast_scores(denominator, exponentials))

def attention_context(probabilities: Tensor[f32, 1, 16, 32, 32], values: Tensor[f32, 1, 16, 32, 128]) -> Tensor[f32, 1, 16, 32, 128]:
    return tensor.batched_matmul_f_32(probabilities, values)

def context_to_bf_16(value: Tensor[f32, 1, 16, 32, 128]) -> Tensor[bf16, 1, 16, 32, 128]:
    return tensor.f32_to_bf_16(value)

def transpose_context(value: Tensor[bf16, 1, 16, 32, 128]) -> Tensor[bf16, 1, 32, 16, 128]:
    return tensor.transpose_bf_16(value, [0, 2, 1, 3])

def merge_context(value: Tensor[bf16, 1, 32, 16, 128]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.reshape_bf_16(value, [1, 32, 2048])

def output_projection(value: Tensor[bf16, 1, 32, 2048], weight: Tensor[bf16, 2048, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.matmul_bf_16(value, weight)

def mlp_projection(value: Tensor[bf16, 1, 32, 2048], weight: Tensor[bf16, 2048, 11008]) -> Tensor[bf16, 1, 32, 11008]:
    return tensor.matmul_bf_16(value, weight)

def mlp_sigmoid(value: Tensor[bf16, 1, 32, 11008]) -> Tensor[bf16, 1, 32, 11008]:
    return tensor.sigmoid_bf_16(value)

def mlp_multiply(left: Tensor[bf16, 1, 32, 11008], right: Tensor[bf16, 1, 32, 11008]) -> Tensor[bf16, 1, 32, 11008]:
    return tensor.multiply_bf_16(left, right)

def mlp_down(value: Tensor[bf16, 1, 32, 11008], weight: Tensor[bf16, 11008, 2048]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.matmul_bf_16(value, weight)

def qwen_mlp(value: Tensor[bf16, 1, 32, 2048], gate_weight: Tensor[bf16, 11008, 2048], up_weight: Tensor[bf16, 11008, 2048], down_weight: Tensor[bf16, 2048, 11008]) -> Tensor[bf16, 1, 32, 2048]:
    gate = mlp_projection(value, transpose_mlp_weight(gate_weight))
    up = mlp_projection(value, transpose_mlp_weight(up_weight))
    activated = mlp_multiply(gate, mlp_sigmoid(gate))
    return mlp_down(mlp_multiply(activated, up), transpose_down_weight(down_weight))

@tensor
def embedding_kernel(embedding: Tensor[bf16, 151936, 2048], input_ids: Tensor[i64, 1, 32]) -> Tensor[bf16, 1, 32, 2048]:
    return tensor.gather_bf_16(embedding, input_ids)

@tensor
def qwen2_layer_kernel(
    hidden: Tensor[bf16, 1, 32, 2048],
    input_norm: Tensor[bf16, 2048],
    query_weight: Tensor[bf16, 2048, 2048],
    query_bias: Tensor[bf16, 2048],
    key_weight: Tensor[bf16, 256, 2048],
    key_bias: Tensor[bf16, 256],
    value_weight: Tensor[bf16, 256, 2048],
    value_bias: Tensor[bf16, 256],
    output_weight: Tensor[bf16, 2048, 2048],
    post_norm: Tensor[bf16, 2048],
    gate_weight: Tensor[bf16, 11008, 2048],
    up_weight: Tensor[bf16, 11008, 2048],
    down_weight: Tensor[bf16, 2048, 11008],
    cosine: Tensor[f32, 1, 1, 32, 128],
    sine: Tensor[f32, 1, 1, 32, 128],
    mask: Tensor[f32, 1, 1, 32, 32],
) -> Tensor[bf16, 1, 32, 2048]:
    normalized = qwen_rms_norm(hidden, input_norm)
    projected_query = query_projection(normalized, transpose_model_weight(query_weight))
    projected_key = kv_projection(normalized, transpose_kv_weight(key_weight))
    projected_value = kv_projection(normalized, transpose_kv_weight(value_weight))
    query = model_add_bf_16(projected_query, broadcast_query_bias(query_bias, projected_query))
    key = add_kv(projected_key, broadcast_kv_bias(key_bias, projected_key))
    value = add_kv(projected_value, broadcast_kv_bias(value_bias, projected_value))
    query_heads = transpose_query(reshape_query(query))
    key_heads = transpose_kv(reshape_kv(key))
    value_heads = transpose_kv(reshape_kv(value))
    query_f_32 = query_heads_to_f_32(query_heads)
    key_f_32 = kv_heads_to_f_32(key_heads)
    query_rotary = apply_query_rope(query_f_32, cosine, sine)
    key_rotary = apply_kv_rope(key_f_32, cosine, sine)
    repeated_key = merge_key_heads(repeat_key(expand_key(key_rotary)))
    repeated_value = value_heads_to_f_32(merge_value_heads(repeat_value(expand_value(value_heads))))
    scores = apply_causal_mask(scale_scores(attention_scores(query_rotary, transpose_key(repeated_key))), mask)
    probabilities = stable_softmax_single(scores)
    context = merge_context(transpose_context(context_to_bf_16(attention_context(probabilities, repeated_value))))
    attended = output_projection(context, transpose_model_weight(output_weight))
    residual = model_add_bf_16(hidden, attended)
    feed_forward = qwen_mlp(qwen_rms_norm(residual, post_norm), gate_weight, up_weight, down_weight)
    return model_add_bf_16(residual, feed_forward)

def logits_projection(value: Tensor[bf16, 1, 32, 2048], embedding: Tensor[bf16, 2048, 151936]) -> Tensor[bf16, 1, 32, 151936]:
    return tensor.matmul_bf_16(value, embedding)

@tensor
def logits_kernel(hidden: Tensor[bf16, 1, 32, 2048], norm_weight: Tensor[bf16, 2048], embedding: Tensor[bf16, 151936, 2048]) -> Tensor[bf16, 1, 32, 151936]:
    return logits_projection(qwen_rms_norm(hidden, norm_weight), transpose_embedding(embedding))
