import file
import json
import math
import "src/artifacts.sev" as artifacts
import "src/types.sev" as types

class ProtoReader:
    data: list[int]
    position: int = 0

    def done() -> bool:
        return position >= size(data)

    def varint() -> int:
        value := 0
        multiplier := 1
        while true:
            assert(position < size(data), "truncated protobuf varint")
            byte = data[position]
            position += 1
            value += (byte % 128) * multiplier
            if byte < 128:
                return value
            multiplier *= 128
            assert(multiplier <= 72057594037927936, "protobuf varint is too long")

    def key() -> tuple[int, int]:
        encoded = varint()
        return (encoded / 8, encoded % 8)

    def take(count: int) -> list[int]:
        assert(count >= 0 and position + count <= size(data), "protobuf field exceeds message")
        output = data[position:position + count]
        position += count
        return output

    def bytes() -> list[int]:
        return take(varint())

    def skip(wire: int):
        if wire == 0:
            _value = varint()
        else if wire == 1:
            _value = take(8)
        else if wire == 2:
            _value = bytes()
        else if wire == 5:
            _value = take(4)
        else:
            assert(false, "unsupported protobuf wire type")

def utf8(data: list[int]) -> Result[string, IOError]:
    return file.utf8(data)

def unsigned_le(data: list[int]) -> int:
    value := 0
    multiplier := 1
    for byte in data:
        value += byte * multiplier
        multiplier *= 256
    return value

def ieee_float(data: list[int], exponent_bits: int, fraction_bits: int) -> float:
    encoded = unsigned_le(data)
    fraction_base := 1
    for _index in range(0, fraction_bits):
        fraction_base *= 2
    exponent_base := 1
    for _index in range(0, exponent_bits):
        exponent_base *= 2
    fraction = encoded % fraction_base
    encoded /= fraction_base
    exponent = encoded % exponent_base
    sign = -1.0 if encoded / exponent_base == 1 else 1.0
    bias = exponent_base / 2 - 1
    if exponent == 0:
        return sign * math.pow(2.0, 1 - bias) * fraction / fraction_base
    if exponent == exponent_base - 1:
        assert(false, "ONNX initializer contains non-finite floating point data")
    return sign * math.pow(2.0, exponent - bias) * (1.0 + fraction / fraction_base)

def packed_varints(data: list[int]) -> list[int]:
    reader = ProtoReader(data)
    output := []
    while not reader.done():
        output.append(reader.varint())
    return output

def parse_dimension(data: list[int]) -> int:
    reader = ProtoReader(data)
    dimension := -1
    while not reader.done():
        field, wire = reader.key()
        if field == 1:
            dimension = reader.varint()
        else if field == 2:
            _symbol = reader.bytes()
            dimension = -1
        else:
            reader.skip(wire)
    return dimension

def parse_shape(data: list[int]) -> list[int]:
    reader = ProtoReader(data)
    output := []
    while not reader.done():
        field, wire = reader.key()
        if field == 1 and wire == 2:
            output.append(parse_dimension(reader.bytes()))
        else:
            reader.skip(wire)
    return output

def parse_type(data: list[int]) -> tuple[string, list[int]]:
    reader = ProtoReader(data)
    dtype := "unknown"
    shape := []
    while not reader.done():
        field, wire = reader.key()
        if field != 1 or wire != 2:
            reader.skip(wire)
            continue
        tensor_reader = ProtoReader(reader.bytes())
        while not tensor_reader.done():
            tensor_field, tensor_wire = tensor_reader.key()
            if tensor_field == 1:
                dtype = onnx_dtype(tensor_reader.varint())
            else if tensor_field == 2:
                shape = parse_shape(tensor_reader.bytes())
            else:
                tensor_reader.skip(tensor_wire)
    return (dtype, shape)

def parse_value_info(data: list[int]) -> types.TensorValue:
    reader = ProtoReader(data)
    name := ""
    dtype := "unknown"
    shape := []
    while not reader.done():
        field, wire = reader.key()
        if field == 1:
            name = utf8(reader.bytes())
        else if field == 2:
            dtype, shape = parse_type(reader.bytes())
        else:
            reader.skip(wire)
    return types.TensorValue(name, dtype, shape, [])

def onnx_dtype(value: int) -> string:
    names = ["undefined", "f32", "u8", "i8", "u16", "i16", "i32", "i64", "string", "bool", "f16", "f64", "u32", "u64", "complex64", "complex128", "bf16"]
    assert(value >= 0 and value < size(names), "unsupported ONNX tensor dtype")
    return names[value]

def parse_tensor(data: list[int]) -> types.TensorValue:
    reader = ProtoReader(data)
    dimensions := []
    dtype_code := 0
    name := ""
    raw := []
    float_values := []
    double_values := []
    integer_values := []
    while not reader.done():
        field, wire = reader.key()
        if field == 1:
            if wire == 2:
                dimensions.extend(packed_varints(reader.bytes()))
            else:
                dimensions.append(reader.varint())
        else if field == 2:
            dtype_code = reader.varint()
        else if field == 4:
            bytes = reader.take(4) if wire == 5 else reader.bytes()
            for offset in range(0, size(bytes), 4):
                float_values.append(ieee_float(bytes[offset:offset + 4], 8, 23))
        else if field in [5, 7, 11]:
            if wire == 2:
                integer_values.extend(packed_varints(reader.bytes()))
            else:
                integer_values.append(reader.varint())
        else if field == 8:
            name = utf8(reader.bytes())
        else if field == 9:
            raw = reader.bytes()
        else if field == 10:
            bytes = reader.take(8) if wire == 1 else reader.bytes()
            for offset in range(0, size(bytes), 8):
                double_values.append(ieee_float(bytes[offset:offset + 8], 11, 52))
        else:
            reader.skip(wire)
    dtype = onnx_dtype(dtype_code)
    values := float_values if size(float_values) > 0 else double_values
    if size(values) == 0 and size(integer_values) > 0:
        values = integer_values.map(|value| float(value))
    if size(values) == 0 and size(raw) > 0:
        width = 8 if dtype in ["f64", "i64", "u64"] else 2 if dtype in ["f16", "bf16", "i16", "u16"] else 1 if dtype in ["i8", "u8", "bool"] else 4
        for offset in range(0, size(raw), width):
            if dtype == "f32":
                values.append(ieee_float(raw[offset:offset + 4], 8, 23))
            else if dtype == "f64":
                values.append(ieee_float(raw[offset:offset + 8], 11, 52))
            else:
                values.append(float(unsigned_le(raw[offset:offset + width])))
    return types.TensorValue(name, dtype, dimensions, values)

def parse_attribute(data: list[int]) -> tuple[string, Any]:
    reader = ProtoReader(data)
    name := ""
    value: Any = 0
    integers := []
    floats := []
    while not reader.done():
        field, wire = reader.key()
        if field == 1:
            name = utf8(reader.bytes())
        else if field == 2:
            value = ieee_float(reader.take(4), 8, 23)
        else if field == 3:
            value = reader.varint()
        else if field == 4:
            value = utf8(reader.bytes())
        else if field == 5:
            value = parse_tensor(reader.bytes())
        else if field == 7:
            bytes = reader.bytes()
            for offset in range(0, size(bytes), 4):
                floats.append(ieee_float(bytes[offset:offset + 4], 8, 23))
            value = floats
        else if field == 8:
            integers = packed_varints(reader.bytes()) if wire == 2 else integers + [reader.varint()]
            value = integers
        else:
            reader.skip(wire)
    return (name, value)

def normalize_operation(name: string) -> string:
    mappings = {
        "Identity": "identity", "Add": "add", "Sub": "subtract", "Mul": "multiply", "Div": "divide",
        "MatMul": "matmul", "Gemm": "gemm", "Relu": "relu", "Sigmoid": "sigmoid", "Tanh": "tanh",
        "Gelu": "gelu", "Swish": "silu", "Softmax": "softmax", "LogSoftmax": "log_softmax",
        "Reshape": "reshape", "Flatten": "flatten", "Transpose": "transpose", "Concat": "concat",
        "LayerNormalization": "layer_norm", "BatchNormalization": "batch_norm", "Conv": "conv2d",
        "MaxPool": "max_pool2d", "AveragePool": "avg_pool2d", "Dropout": "dropout", "Gather": "embedding",
    }
    return mappings.get(name, name.lower())

def parse_node(data: list[int], index: int) -> types.GraphNode:
    reader = ProtoReader(data)
    inputs := []
    outputs := []
    name := "node_" + string(index)
    operation := ""
    attributes: Any = json.decode[Any]("{}")
    while not reader.done():
        field, wire = reader.key()
        if field == 1:
            inputs.append(utf8(reader.bytes()))
        else if field == 2:
            outputs.append(utf8(reader.bytes()))
        else if field == 3:
            name = utf8(reader.bytes())
        else if field == 4:
            operation = normalize_operation(utf8(reader.bytes()))
        else if field == 5:
            attribute_name, value = parse_attribute(reader.bytes())
            json.object_set(attributes, attribute_name, value)
        else:
            reader.skip(wire)
    return types.GraphNode(name, operation, inputs, outputs, attributes)

def parse_graph(data: list[int]) -> types.ModelGraph:
    reader = ProtoReader(data)
    name := "onnx_graph"
    inputs := []
    outputs := []
    nodes := []
    initializers := []
    while not reader.done():
        field, wire = reader.key()
        if field == 1:
            nodes.append(parse_node(reader.bytes(), size(nodes)))
        else if field == 2:
            name = utf8(reader.bytes())
        else if field == 5:
            initializers.append(parse_tensor(reader.bytes()))
        else if field == 11:
            inputs.append(parse_value_info(reader.bytes()))
        else if field == 12:
            outputs.append(parse_value_info(reader.bytes()).name)
        else:
            reader.skip(wire)
    initializer_names = initializers.map(|value| value.name)
    inputs = inputs.filter(|value| value.name not in initializer_names)
    graph = types.ModelGraph(name, inputs, outputs, nodes, initializers)
    _valid = graph.validate()
    return graph

def import_model(path: string) -> Result[types.ModelGraph, types.ModelLoadError | IOError]:
    bytes = artifacts.read_bytes(path)
    reader = ProtoReader(bytes)
    graph: types.ModelGraph = types.ModelGraph("", [], [], [], [])
    found := false
    while not reader.done():
        field, wire = reader.key()
        if field == 7 and wire == 2:
            graph = parse_graph(reader.bytes())
            found = true
        else:
            reader.skip(wire)
    if not found:
        return failure(types.ModelLoadError("ONNX ModelProto contains no graph"))
    return graph
