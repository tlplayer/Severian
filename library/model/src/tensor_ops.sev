import math
import random
import tensor as tensor_runtime

def product(dimensions: list[int]) -> int:
    result := 1
    for dimension in dimensions:
        assert(dimension >= 0, "tensor dimensions cannot be negative")
        result *= dimension
    return result

def tensor(values: list[float], shape: list[int]) -> Tensor[f64]:
    assert(product(shape) == size(values), "tensor values do not match shape")
    return tensor_runtime.tensor(values, shape)

def values(input: Tensor[f64]) -> list[float]:
    return tensor_runtime.values(input)

def shape(input: Tensor[f64]) -> list[int]:
    return tensor_runtime.ranked_shape(input)

def size_of(input: Tensor[f64]) -> int:
    return product(shape(input))

def zeros(shape: list[int]) -> Tensor[f64]:
    return tensor_runtime.zeros(shape)

def ones(shape: list[int]) -> Tensor[f64]:
    return tensor_runtime.ones(shape)

def empty(shape: list[int]) -> Tensor[f64]:
    return tensor_runtime.empty(shape)

def full(shape: list[int], fill_value: float) -> Tensor[f64]:
    data := []
    for _index in range(0, product(shape)):
        data.append(fill_value)
    return tensor(data, shape)

def rand(shape: list[int]) -> Tensor[f64]:
    data := []
    for _index in range(0, product(shape)):
        data.append(random.random())
    return tensor(data, shape)

def randn(shape: list[int]) -> Tensor[f64]:
    # Box-Muller produces independent standard-normal pairs.
    data := []
    while size(data) < product(shape):
        u1 = max([random.random(), 0.000000000001])
        u2 = random.random()
        radius = math.sqrt(-2.0 * math.log(u1))
        data.append(radius * math.cos(6.283185307179586 * u2))
        if size(data) < product(shape):
            data.append(radius * math.sin(6.283185307179586 * u2))
    return tensor(data, shape)

def arange(start: float, stop: float = 0.0, step: float = 1.0) -> Tensor[f64]:
    actual_start := start
    actual_stop := stop
    if stop == 0.0:
        actual_start = 0.0
        actual_stop = start
    assert(step != 0.0, "arange step cannot be zero")
    data := []
    value := actual_start
    while (step > 0.0 and value < actual_stop) or (step < 0.0 and value > actual_stop):
        data.append(value)
        value += step
    return tensor(data, [size(data)])

def linspace(start: float, stop: float, steps: int) -> Tensor[f64]:
    assert(steps > 0, "linspace requires at least one step")
    if steps == 1:
        return tensor([start], [1])
    data := []
    stride = (stop - start) / (steps - 1)
    for index in range(0, steps):
        data.append(start + stride * index)
    return tensor(data, [steps])

def reshape(input: Tensor[f64], dimensions: list[int]) -> Tensor[f64]:
    inferred := -1
    known := 1
    result_shape := dimensions[0:size(dimensions)]
    for index, dimension in enumerate(result_shape):
        if dimension == -1:
            assert(inferred < 0, "reshape accepts one inferred dimension")
            inferred = index
        else:
            assert(dimension >= 0)
            known *= dimension
    if inferred >= 0:
        assert(known > 0 and size_of(input) % known == 0)
        result_shape[inferred] = size_of(input) / known
    assert(product(result_shape) == size_of(input), "reshape changes element count")
    return tensor_runtime.reshape(input, result_shape)

def view(input: Tensor[f64], dimensions: list[int]) -> Tensor[f64]:
    return reshape(input, dimensions)

def flatten(input: Tensor[f64], start_dimension: int = 0, end_dimension: int = -1) -> Tensor[f64]:
    dimensions = shape(input)
    end := end_dimension
    if end < 0:
        end += size(dimensions)
    assert(start_dimension >= 0 and end >= start_dimension and end < size(dimensions))
    flattened := []
    for index in range(0, start_dimension):
        flattened.append(dimensions[index])
    merged := 1
    for index in range(start_dimension, end + 1):
        merged *= dimensions[index]
    flattened.append(merged)
    for index in range(end + 1, size(dimensions)):
        flattened.append(dimensions[index])
    return reshape(input, flattened)

def squeeze(input: Tensor[f64], dimension: int = -1) -> Tensor[f64]:
    dimensions = shape(input)
    squeezed := []
    for index, extent in enumerate(dimensions):
        if extent != 1 or (dimension >= 0 and index != dimension):
            squeezed.append(extent)
    if dimension >= 0:
        assert(dimensions[dimension] == 1, "squeezed dimension must have extent one")
    return reshape(input, squeezed)

def unsqueeze(input: Tensor[f64], dimension: int) -> Tensor[f64]:
    dimensions = shape(input)
    axis := dimension
    if axis < 0:
        axis += size(dimensions) + 1
    assert(axis >= 0 and axis <= size(dimensions))
    output := []
    for index in range(0, size(dimensions) + 1):
        if index == axis:
            output.append(1)
        else:
            source = index if index < axis else index - 1
            output.append(dimensions[source])
    return reshape(input, output)

def transpose(input: Tensor[f64], first: int = -2, second: int = -1) -> Tensor[f64]:
    dimensions = shape(input)
    assert(size(dimensions) == 2, "current transpose implementation requires a matrix")
    rows = dimensions[0]
    columns = dimensions[1]
    source = values(input)
    output := []
    for column in range(0, columns):
        for row in range(0, rows):
            output.append(source[row * columns + column])
    return tensor(output, [columns, rows])

def permute(input: Tensor[f64], dimensions: list[int]) -> Tensor[f64]:
    assert(size(dimensions) == 2 and dimensions == [1, 0], "current permute supports matrix transposition")
    return transpose(input)

def concat(inputs: list[Tensor[f64]], dimension: int = 0) -> Tensor[f64]:
    assert(size(inputs) > 0)
    base_shape = shape(inputs[0])
    assert(size(base_shape) <= 2, "concat currently supports vectors and matrices")
    if size(base_shape) == 1 or dimension == 0:
        output := []
        result_shape = base_shape[0:size(base_shape)]
        result_shape[dimension] = 0
        for input in inputs:
            current_shape = shape(input)
            for axis in indices(base_shape):
                if axis != dimension:
                    assert(current_shape[axis] == base_shape[axis])
            output.extend(values(input))
            result_shape[dimension] += current_shape[dimension]
        return tensor(output, result_shape)
    rows = base_shape[0]
    result_columns := 0
    chunks := []
    for input in inputs:
        assert(shape(input)[0] == rows)
        chunks.append(values(input))
        result_columns += shape(input)[1]
    output := []
    for row in range(0, rows):
        for index, input in enumerate(inputs):
            columns = shape(input)[1]
            for column in range(0, columns):
                output.append(chunks[index][row * columns + column])
    return tensor(output, [rows, result_columns])

def stack(inputs: list[Tensor[f64]], dimension: int = 0) -> Tensor[f64]:
    expanded := []
    for input in inputs:
        expanded.append(unsqueeze(input, dimension))
    return concat(expanded, dimension)

def split(input: Tensor[f64], split_size: int, dimension: int = 0) -> list[Tensor[f64]]:
    assert(dimension == 0, "split currently operates on the leading dimension")
    dimensions = shape(input)
    row_size = product(dimensions[1:size(dimensions)])
    source = values(input)
    outputs := []
    start := 0
    while start < dimensions[0]:
        count = min([split_size, dimensions[0] - start])
        output_shape = dimensions[0:size(dimensions)]
        output_shape[0] = count
        outputs.append(tensor(source[start * row_size:(start + count) * row_size], output_shape))
        start += count
    return outputs

def chunk(input: Tensor[f64], chunks: int, dimension: int = 0) -> list[Tensor[f64]]:
    assert(chunks > 0)
    extent = shape(input)[dimension]
    return split(input, (extent + chunks - 1) / chunks, dimension)

def sum(input: Tensor[f64]) -> float:
    total := 0.0
    for value in values(input):
        total += value
    return total

def mean(input: Tensor[f64]) -> float:
    assert(size_of(input) > 0)
    return sum(input) / size_of(input)

def min(input: Tensor[f64]) -> float:
    return values(input).min()

def max(input: Tensor[f64]) -> float:
    return values(input).max()

def argmin(input: Tensor[f64]) -> int:
    source = values(input)
    best := 0
    for index in range(1, size(source)):
        if source[index] < source[best]:
            best = index
    return best

def argmax(input: Tensor[f64]) -> int:
    source = values(input)
    best := 0
    for index in range(1, size(source)):
        if source[index] > source[best]:
            best = index
    return best

def var(input: Tensor[f64], correction: int = 1) -> float:
    center = mean(input)
    total := 0.0
    for value in values(input):
        total += (value - center) * (value - center)
    divisor = max([1, size_of(input) - correction])
    return total / divisor

def std(input: Tensor[f64], correction: int = 1) -> float:
    return math.sqrt(var(input, correction))

def matmul(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return tensor_runtime.matmul(left, right)

def dot(left: Tensor[f64], right: Tensor[f64]) -> float:
    left_values = values(left)
    right_values = values(right)
    assert(size(left_values) == size(right_values))
    total := 0.0
    for index in indices(left_values):
        total += left_values[index] * right_values[index]
    return total

def einsum(equation: string, left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    if equation in ["ij,jk->ik", "...ij,...jk->...ik"]:
        return matmul(left, right)
    if equation in ["i,i->", "ij,ij->"]:
        return tensor([dot(left, right)], [1])
    assert(false, "unsupported einsum equation: " + equation)
    return tensor([], [0])

def where(condition: Tensor[f64], when_true: Tensor[f64], when_false: Tensor[f64]) -> Tensor[f64]:
    predicates = values(condition)
    true_values = values(when_true)
    false_values = values(when_false)
    assert(size(predicates) == size(true_values) and size(predicates) == size(false_values))
    output := []
    for index in indices(predicates):
        output.append(true_values[index] if predicates[index] != 0.0 else false_values[index])
    return tensor(output, shape(condition))

def clamp(input: Tensor[f64], minimum: float, maximum: float) -> Tensor[f64]:
    output := []
    for value in values(input):
        output.append(min([maximum, max([minimum, value])]))
    return tensor(output, shape(input))

def clip(input: Tensor[f64], minimum: float, maximum: float) -> Tensor[f64]:
    return clamp(input, minimum, maximum)

def argsort(input: Tensor[f64], descending: bool = false) -> list[int]:
    source = values(input)
    remaining := indices(source)
    output := []
    while size(remaining) > 0:
        best := 0
        for position in range(1, size(remaining)):
            left = source[remaining[position]]
            right = source[remaining[best]]
            if (descending and left > right) or (not descending and left < right):
                best = position
        output.append(remaining.pop(best))
    return output

def sort(input: Tensor[f64], descending: bool = false) -> Tensor[f64]:
    source = values(input)
    output := []
    for index in argsort(input, descending):
        output.append(source[index])
    return tensor(output, shape(input))

def topk(input: Tensor[f64], count: int) -> tuple[Tensor[f64], list[int]]:
    order = argsort(input, true)[0:count]
    source = values(input)
    output := []
    for index in order:
        output.append(source[index])
    return (tensor(output, [size(output)]), order)

def map_values(input: Tensor[f64], operation: Any) -> Tensor[f64]:
    output := []
    for value in values(input):
        output.append(operation(value))
    return tensor(output, shape(input))

def exp(input: Tensor[f64]) -> Tensor[f64]:
    return map_values(input, |value| math.exp(value))

def log(input: Tensor[f64]) -> Tensor[f64]:
    return map_values(input, |value| math.log(value))

def sqrt(input: Tensor[f64]) -> Tensor[f64]:
    return map_values(input, |value| math.sqrt(value))

def abs(input: Tensor[f64]) -> Tensor[f64]:
    return map_values(input, |value| value if value >= 0.0 else -value)

def pow(input: Tensor[f64], exponent: float) -> Tensor[f64]:
    return map_values(input, |value| math.pow(value, exponent))

def sigmoid(input: Tensor[f64]) -> Tensor[f64]:
    return map_values(input, |value| 1.0 / (1.0 + math.exp(-value)))

def scalar_tanh(value: float) -> float:
    positive = math.exp(2.0 * value)
    return (positive - 1.0) / (positive + 1.0)

def relu(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_runtime.ranked_relu(input)

def gelu(input: Tensor[f64]) -> Tensor[f64]:
    return map_values(input, |value| 0.5 * value * (1.0 + scalar_tanh(0.7978845608028654 * (value + 0.044715 * value * value * value))))

def silu(input: Tensor[f64]) -> Tensor[f64]:
    source = values(input)
    gates = values(sigmoid(input))
    output := []
    for index in indices(source):
        output.append(source[index] * gates[index])
    return tensor(output, shape(input))

def tanh(input: Tensor[f64]) -> Tensor[f64]:
    return map_values(input, |value| scalar_tanh(value))

def softmax(input: Tensor[f64], dimension: int = -1) -> Tensor[f64]:
    assert(dimension == -1 or dimension == size(shape(input)) - 1)
    return tensor_runtime.softmax(input)

def log_softmax(input: Tensor[f64], dimension: int = -1) -> Tensor[f64]:
    return log(softmax(input, dimension))
