import "src/executable.sev" as executable_api

class SamplingOptions:
    maximum_new_tokens: int = 128
    temperature: float = 1.0
    top_k: int = 0
    top_p: float = 1.0
    seed: int = 0
    end_tokens: list[int] = []

class TextGenerationRequest:
    prompt: string
    options: SamplingOptions = SamplingOptions()

class TextGenerationResult:
    text: string
    tokens: list[int]
    finish_reason: string

class SessionState:
    buffers: list[executable_api.DeviceBuffer]
    position: int = 0

# A session owns all mutable decode state. ExecutableBundle and bound weights
# remain immutable and can safely create many independent sessions.
class GenerationSession:
    executables: executable_api.ExecutableBundle
    state: SessionState
    input_tokens: list[int]
    generated_tokens: list[int]
    closed: bool = false

    def advance(token: int):
        assert(not closed)
        generated_tokens.append(token)
        state.position += 1

    def all_tokens() -> list[int]:
        return input_tokens + generated_tokens

    def close():
        state.buffers = []
        closed = true
        return

