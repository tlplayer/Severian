import json
import "src/types.sev" as types

# Architecture resolution is separate from checkpoint parsing. Safetensors
# supplies names and bytes; this registry decides which executable graph owns
# those names and which nested configuration describes it.
class Architecture:
    name: string
    family: string
    config: Any
    weight_prefix: string
    tokenizer: string
    audio_tokenizer: string

def object_member(value: Any, name: string) -> Any | types.ModelLoadError:
    if name not in json.object_keys(value):
        return failure(types.ModelLoadError("model config is missing `" + name + "`"))
    return json.object_get(value, name)

def model_type(config: Any) -> string | types.ModelLoadError:
    if "model_type" not in json.object_keys(config):
        return failure(types.ModelLoadError("model config does not declare `model_type`"))
    return json.as_string(json.object_get(config, "model_type")).lower()

def resolve(config: Any) -> Architecture | types.ModelLoadError:
    kind = model_type(config)
    if kind == "omnivoice":
        llm_config = object_member(config, "llm_config")
        family = model_type(llm_config)
        if family not in ["qwen2", "qwen3", "qwen2_moe"]:
            return failure(types.ModelLoadError(
                "OmniVoice declares unsupported language model family `" + family + "`",
            ))
        return Architecture(
            "omnivoice",
            family,
            llm_config,
            "",
            "transformers",
            "higgs-audio-v2",
        )
    if kind in ["qwen2", "qwen3", "qwen2_moe"]:
        return Architecture(kind, kind, config, "", "transformers", "")
    if kind in ["llama", "mistral"]:
        return Architecture(kind, kind, config, "", "transformers", "")
    return failure(types.ModelLoadError(
        "no registered Severian architecture for model_type `" + kind + "`",
    ))

def infer_weight_prefix(parameters: list[types.TensorValue], suffix: string) -> string | types.ModelLoadError:
    for parameter in parameters:
        if parameter.name.ends_with(suffix):
            return parameter.name[0:size(parameter.name) - size(suffix)]
    return failure(types.ModelLoadError(
        "checkpoint does not contain architecture sentinel weight `" + suffix + "`",
    ))
