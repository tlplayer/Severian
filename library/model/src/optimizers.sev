import math
import "src/tensor_ops.sev" as tensor_ops

class Parameter:
    value: Tensor[f64]
    gradient: Tensor[f64]
    requires_grad: bool = true

    def zero_grad():
        gradient = tensor_ops.zeros(tensor_ops.shape(value))

class Optimizer:
    parameters: list[Parameter]
    learning_rate: float
    weight_decay: float = 0.0
    step_count: int = 0

    def zero_grad():
        for parameter in parameters:
            parameter.zero_grad()

    def set_learning_rate(value: float):
        assert(value >= 0.0)
        learning_rate = value

    def set_weight_decay(value: float):
        assert(value >= 0.0)
        weight_decay = value

    def step():
        step_count += 1
        for parameter in parameters:
            if not parameter.requires_grad:
                continue
            current = tensor_ops.values(parameter.value)
            gradient = tensor_ops.values(parameter.gradient)
            for index in indices(current):
                current[index] -= learning_rate * (gradient[index] + weight_decay * current[index])
            parameter.value = tensor_ops.tensor(current, tensor_ops.shape(parameter.value))

class SGD: Optimizer
    momentum: float = 0.0
    velocity: list[list[float]] = []

    def set_momentum(value: float):
        assert(value >= 0.0 and value < 1.0)
        momentum = value

    def step():
        step_count += 1
        while size(velocity) < size(parameters):
            velocity.append([0.0] * tensor_ops.size_of(parameters[size(velocity)].value))
        for parameter_index, parameter in enumerate(parameters):
            if not parameter.requires_grad:
                continue
            current = tensor_ops.values(parameter.value)
            gradient = tensor_ops.values(parameter.gradient)
            for index in indices(current):
                velocity[parameter_index][index] = momentum * velocity[parameter_index][index] + gradient[index] + weight_decay * current[index]
                current[index] -= learning_rate * velocity[parameter_index][index]
            parameter.value = tensor_ops.tensor(current, tensor_ops.shape(parameter.value))

class Adam: Optimizer
    beta1: float = 0.9
    beta2: float = 0.999
    epsilon: float = 0.00000001
    first_moment: list[list[float]] = []
    second_moment: list[list[float]] = []

    def step():
        step_count += 1
        while size(first_moment) < size(parameters):
            count = tensor_ops.size_of(parameters[size(first_moment)].value)
            first_moment.append([0.0] * count)
            second_moment.append([0.0] * count)
        for parameter_index, parameter in enumerate(parameters):
            if not parameter.requires_grad:
                continue
            current = tensor_ops.values(parameter.value)
            gradient = tensor_ops.values(parameter.gradient)
            for index in indices(current):
                g = gradient[index] + weight_decay * current[index]
                first_moment[parameter_index][index] = beta1 * first_moment[parameter_index][index] + (1.0 - beta1) * g
                second_moment[parameter_index][index] = beta2 * second_moment[parameter_index][index] + (1.0 - beta2) * g * g
                corrected_first = first_moment[parameter_index][index] / (1.0 - math.pow(beta1, step_count))
                corrected_second = second_moment[parameter_index][index] / (1.0 - math.pow(beta2, step_count))
                current[index] -= learning_rate * corrected_first / (math.sqrt(corrected_second) + epsilon)
            parameter.value = tensor_ops.tensor(current, tensor_ops.shape(parameter.value))

class Adagrad: Optimizer
    epsilon: float = 0.00000001
    accumulated: list[list[float]] = []

    def step():
        step_count += 1
        while size(accumulated) < size(parameters):
            accumulated.append([0.0] * tensor_ops.size_of(parameters[size(accumulated)].value))
        for parameter_index, parameter in enumerate(parameters):
            current = tensor_ops.values(parameter.value)
            gradient = tensor_ops.values(parameter.gradient)
            for index in indices(current):
                accumulated[parameter_index][index] += gradient[index] * gradient[index]
                current[index] -= learning_rate * gradient[index] / (math.sqrt(accumulated[parameter_index][index]) + epsilon)
            parameter.value = tensor_ops.tensor(current, tensor_ops.shape(parameter.value))

class RMSprop: Optimizer
    alpha: float = 0.99
    epsilon: float = 0.00000001
    average: list[list[float]] = []

    def step():
        step_count += 1
        while size(average) < size(parameters):
            average.append([0.0] * tensor_ops.size_of(parameters[size(average)].value))
        for parameter_index, parameter in enumerate(parameters):
            current = tensor_ops.values(parameter.value)
            gradient = tensor_ops.values(parameter.gradient)
            for index in indices(current):
                average[parameter_index][index] = alpha * average[parameter_index][index] + (1.0 - alpha) * gradient[index] * gradient[index]
                current[index] -= learning_rate * gradient[index] / (math.sqrt(average[parameter_index][index]) + epsilon)
            parameter.value = tensor_ops.tensor(current, tensor_ops.shape(parameter.value))

class Scheduler:
    optimizer: Optimizer
    initial_rate: float
    kind: string
    total_steps: int
    gamma: float = 0.1
    warmup_steps: int = 0
    best: float = 999999999999.0
    stale_steps: int = 0
    patience: int = 10

    def step(metric: float = 0.0):
        position = optimizer.step_count
        if warmup_steps > 0 and position < warmup_steps:
            optimizer.learning_rate = initial_rate * (position + 1) / warmup_steps
        else if kind == "linear":
            optimizer.learning_rate = initial_rate * max([0.0, 1.0 - position / max([1, total_steps])])
        else if kind == "cosine":
            optimizer.learning_rate = initial_rate * 0.5 * (1.0 + math.cos(3.141592653589793 * position / max([1, total_steps])))
        else if kind == "exponential":
            optimizer.learning_rate = initial_rate * math.pow(gamma, position)
        else if kind == "plateau":
            if metric < best:
                best = metric
                stale_steps = 0
            else:
                stale_steps += 1
                if stale_steps >= patience:
                    optimizer.learning_rate *= gamma
                    stale_steps = 0

def sgd(parameters: list[Parameter], learning_rate: float = 0.01, momentum: float = 0.0, weight_decay: float = 0.0) -> SGD:
    return SGD(parameters, learning_rate, weight_decay, 0, momentum, [])

def adam(parameters: list[Parameter], learning_rate: float = 0.001, weight_decay: float = 0.0) -> Adam:
    return Adam(parameters, learning_rate, weight_decay)

def adamw(parameters: list[Parameter], learning_rate: float = 0.001, weight_decay: float = 0.01) -> Adam:
    return Adam(parameters, learning_rate, weight_decay)

def adagrad(parameters: list[Parameter], learning_rate: float = 0.01) -> Adagrad:
    return Adagrad(parameters, learning_rate)

def adadelta(parameters: list[Parameter], learning_rate: float = 1.0) -> RMSprop:
    return RMSprop(parameters, learning_rate, 0.0, 0, 0.95)

def rmsprop(parameters: list[Parameter], learning_rate: float = 0.001) -> RMSprop:
    return RMSprop(parameters, learning_rate)

def linear_lr(optimizer: Optimizer, total_steps: int) -> Scheduler:
    return Scheduler(optimizer, optimizer.learning_rate, "linear", total_steps)

def cosine_lr(optimizer: Optimizer, total_steps: int) -> Scheduler:
    return Scheduler(optimizer, optimizer.learning_rate, "cosine", total_steps)

def exponential_lr(optimizer: Optimizer, gamma: float = 0.99) -> Scheduler:
    return Scheduler(optimizer, optimizer.learning_rate, "exponential", 1, gamma)

def reduce_lr_on_plateau(optimizer: Optimizer, factor: float = 0.1, patience: int = 10) -> Scheduler:
    return Scheduler(optimizer, optimizer.learning_rate, "plateau", 1, factor, 0, 999999999999.0, 0, patience)

def warmup(optimizer: Optimizer, steps: int) -> Scheduler:
    return Scheduler(optimizer, optimizer.learning_rate, "linear", steps, 0.1, steps)
