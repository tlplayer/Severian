import math
import random

class StandardScaler:
    means: list[float] = []
    scales: list[float] = []

    def fit(input: list[list[float]]) -> StandardScaler:
        assert(size(input) > 0)
        means = [0.0] * size(input[0])
        scales = [0.0] * size(input[0])
        for row in input:
            for column in indices(row):
                means[column] += row[column]
        for column in indices(means):
            means[column] /= float(size(input))
        for row in input:
            for column in indices(row):
                difference = row[column] - means[column]
                scales[column] += difference * difference
        for column in indices(scales):
            scales[column] = sqrt(scales[column] / float([1, size(input) - 1].maximum()))
            if scales[column] == 0.0:
                scales[column] = 1.0
        return self

    def transform(input: list[list[float]]) -> list[list[float]]:
        output := []
        for row in input:
            transformed := []
            for column in indices(row):
                transformed.append((row[column] - means[column]) / scales[column])
            output.append(transformed)
        return output

    def fit_transform(input: list[list[float]]) -> list[list[float]]:
        _fitted = self.fit(input)
        return self.transform(input)

class MinMaxScaler:
    minima: list[float] = []
    maxima: list[float] = []

    def fit(input: list[list[float]]) -> MinMaxScaler:
        minima = input[0][0:size(input[0])]
        maxima = input[0][0:size(input[0])]
        for row in input:
            for column in indices(row):
                minima[column] = [minima[column], row[column]].minimum()
                maxima[column] = [maxima[column], row[column]].maximum()
        return self

    def transform(input: list[list[float]]) -> list[list[float]]:
        output := []
        for row in input:
            transformed := []
            for column in indices(row):
                span = maxima[column] - minima[column]
                transformed.append(0.0 if span == 0.0 else (row[column] - minima[column]) / span)
            output.append(transformed)
        return output

    def fit_transform(input: list[list[float]]) -> list[list[float]]:
        _fitted = self.fit(input)
        return self.transform(input)

class RobustScaler:
    medians: list[float] = []
    ranges: list[float] = []

    def fit(input: list[list[float]]) -> RobustScaler:
        medians = []
        ranges = []
        for column in indices(input[0]):
            values := []
            for row in input:
                values.append(row[column])
            ordered = values.sorted()
            medians.append(ordered[size(ordered) / 2])
            lower = ordered[size(ordered) / 4]
            upper = ordered[(3 * size(ordered)) / 4]
            ranges.append([0.000000000001, upper - lower].maximum())
        return self

    def transform(input: list[list[float]]) -> list[list[float]]:
        output := []
        for row in input:
            transformed := []
            for column in indices(row):
                transformed.append((row[column] - medians[column]) / ranges[column])
            output.append(transformed)
        return output

    def fit_transform(input: list[list[float]]) -> list[list[float]]:
        _fitted = self.fit(input)
        return self.transform(input)

def normalize(input: list[list[float]]) -> list[list[float]]:
    output := []
    for row in input:
        norm := 0.0
        for value in row:
            norm += value * value
        norm = sqrt(norm)
        output.append(row if norm == 0.0 else row.map(|value| value / norm))
    return output

class LabelEncoder:
    classes: list[string] = []

    def fit(values: list[string]) -> LabelEncoder:
        classes = []
        for value in values:
            if value not in classes:
                classes.append(value)
        classes = classes.sorted()
        return self

    def transform(values: list[string]) -> list[int]:
        output := []
        for value in values:
            output.append(classes.index(value))
        return output

    def fit_transform(values: list[string]) -> list[int]:
        _fitted = self.fit(values)
        return self.transform(values)

class OneHotEncoder:
    categories: list[string] = []

    def fit(values: list[string]) -> OneHotEncoder:
        encoder = LabelEncoder().fit(values)
        categories = encoder.classes
        return self

    def transform(values: list[string]) -> list[list[float]]:
        output := []
        for value in values:
            row = [0.0] * size(categories)
            row[categories.index(value)] = 1.0
            output.append(row)
        return output

    def fit_transform(values: list[string]) -> list[list[float]]:
        _fitted = self.fit(values)
        return self.transform(values)

class Imputer:
    fill_values: list[float] = []

    def fit(input: list[list[float]], missing: float = 0.0) -> Imputer:
        fill_values = []
        for column in indices(input[0]):
            total := 0.0
            count := 0
            for row in input:
                if row[column] != missing:
                    total += row[column]
                    count += 1
            fill_values.append(total / float([1, count].maximum()))
        return self

    def transform(input: list[list[float]], missing: float = 0.0) -> list[list[float]]:
        output := []
        for row in input:
            changed := []
            for column in indices(row):
                changed.append(fill_values[column] if row[column] == missing else row[column])
            output.append(changed)
        return output

class PolynomialFeatures:
    degree: int = 2
    include_bias: bool = true

    def transform(input: list[list[float]]) -> list[list[float]]:
        output := []
        for row in input:
            features := [1.0] if include_bias else []
            features.extend(row)
            if degree >= 2:
                for left in indices(row):
                    for right in range(left, size(row)):
                        features.append(row[left] * row[right])
            output.append(features)
        return output

    def fit(input: list[list[float]]) -> PolynomialFeatures:
        return self

    def fit_transform(input: list[list[float]]) -> list[list[float]]:
        return self.transform(input)

def pad(tokens: list[int], length: int, value: int = 0) -> list[int]:
    result = tokens[0:[length, size(tokens)].minimum()]
    while size(result) < length:
        result.append(value)
    return result

def truncate(tokens: list[int], length: int) -> list[int]:
    return tokens[0:[length, size(tokens)].minimum()]

def tokenize(text: string) -> list[string]:
    return text.lower().split()

def augment(input: list[list[float]], noise: float = 0.01) -> list[list[float]]:
    output := []
    for row in input:
        output.append(row.map(|value| value + random.uniform(-noise, noise)))
    return output
