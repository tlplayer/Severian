import file
import hash
import http
import json
import path
import platform
import "src/types.sev" as types

class ResolvedArtifact:
    requested_source: string
    local_path: string
    format: string
    content_sha256: string

def identify_format(source: string) -> Result[string, types.ModelLoadError]:
    normalized = source.lower()
    if normalized.starts_with("hf://"):
        return "huggingface-safetensors"
    if normalized.starts_with("https://") or normalized.starts_with("http://"):
        return "remote"
    if normalized.ends_with(".safetensors"):
        return "safetensors"
    if normalized.ends_with(".onnx"):
        return "onnx"
    if normalized.ends_with(".keras"):
        return "keras"
    if normalized.ends_with(".pt") or normalized.ends_with(".pth"):
        return "pytorch-state-dict"
    if normalized.ends_with(".gguf"):
        return "gguf"
    if normalized.ends_with(".sevmodel"):
        return "severian"
    if path.is_dir(source):
        if path.exists(path.join(source, "model.safetensors.index.json")) or path.exists(path.join(source, "model.safetensors")):
            return "huggingface-safetensors"
        if path.exists(path.join(source, "saved_model.pb")):
            return "tensorflow-saved-model"
    return failure(types.ModelLoadError("could not identify model format: " + source))

def safe_identifier(identifier: string) -> Result[string, types.ModelLoadError]:
    if identifier.is_empty() or ".." in identifier or ":" in identifier:
        return failure(types.ModelLoadError("invalid model identifier"))
    for character in identifier.characters():
        if not character.is_ascii_alnum() and character not in ["-", "_", ".", "/", "@"]:
            return failure(types.ModelLoadError("invalid model identifier"))
    return identifier

def cache_root() -> string:
    return platform.environment_get("SEVERIAN_MODEL_CACHE", ".severian/models")

def cache_path(identifier: string, revision: string) -> Result[string, types.ModelLoadError]:
    safe = safe_identifier(identifier)
    pinned = safe_identifier(revision)
    return path.join(cache_root(), safe.replace("/", "--") + "--" + pinned)

def read_bytes(path_name: string) -> Result[list[int], IOError]:
    handle = file.open(path_name)
    length = file.byte_length(handle)
    bytes = file.read_exact(handle, length)
    _closed = file.close(handle)
    return bytes

def sha256_file(path_name: string) -> Result[string, IOError]:
    # The platform hash consumes the exact byte collection; unlike Python
    # pickle loading this never evaluates artifact content.
    return platform.hash_sha256_bytes(read_bytes(path_name))

def verify(path_name: string, expected_sha256: string) -> Result[string, types.ModelLoadError | IOError]:
    actual = sha256_file(path_name)
    if actual.lower() != expected_sha256.lower():
        return failure(types.ModelLoadError(
            "SHA-256 mismatch for " + path_name + ": expected " + expected_sha256 + ", received " + actual,
        ))
    return actual

def download_verified(url: string, destination: string, expected_sha256: string) -> Result[string, types.ModelLoadError | IOError]:
    assert(url.starts_with("https://"), "remote model downloads require HTTPS")
    if path.exists(destination):
        return verify(destination, expected_sha256)
    body = http.get(url)
    bytes = platform.string_encode(body)
    digest = platform.hash_sha256_bytes(bytes)
    if digest.lower() != expected_sha256.lower():
        return failure(types.ModelLoadError("downloaded artifact SHA-256 mismatch"))
    _directory = platform.directory_make_all(path.dirname(destination))
    temporary = destination + ".partial"
    _written = file.write_bytes(temporary, bytes)
    _renamed = platform.file_rename(temporary, destination)
    return digest

def resolve_huggingface(source: string) -> Result[ResolvedArtifact, types.ModelLoadError | IOError | JsonError]:
    specification = safe_identifier(source[5:])
    revision := "main"
    identifier := specification
    if "@" in specification:
        parts = specification.split("@")
        assert(size(parts) == 2)
        identifier = safe_identifier(parts[0])
        revision = safe_identifier(parts[1])
    # Resolve a moving branch once, then cache exclusively by immutable commit.
    api = "https://huggingface.co/api/models/" + identifier + "/revision/" + revision
    metadata_text = http.get(api)
    metadata: Any = json.decode[Any](metadata_text)
    commit = json.as_string(json.object_get(metadata, "sha"))
    assert(size(commit) == 40, "Hugging Face did not return a full commit hash")
    destination = cache_path(identifier, commit)
    _created = platform.directory_make_all(destination)
    siblings = json.object_get(metadata, "siblings")
    for sibling in json.as_list(siblings):
        name = json.as_string(json.object_get(sibling, "rfilename"))
        if name == "config.json" or name == "model.safetensors" or name == "model.safetensors.index.json" or name.ends_with(".safetensors"):
            lfs = json.object_get(sibling, "lfs")
            digest = json.as_string(json.object_get(lfs, "sha256"))
            assert(size(digest) == 64, "remote model file is missing its LFS SHA-256")
            url = "https://huggingface.co/" + identifier + "/resolve/" + commit + "/" + name
            _verified = download_verified(url, path.join(destination, name), digest)
    return ResolvedArtifact(source, destination, "huggingface-safetensors", commit)

def resolve(source: string, expected_sha256: string = "") -> Result[ResolvedArtifact, types.ModelLoadError | IOError | JsonError]:
    format = identify_format(source)
    if source.starts_with("hf://"):
        return resolve_huggingface(source)
    if source.starts_with("https://"):
        if expected_sha256.is_empty():
            return failure(types.ModelLoadError("direct HTTPS model loads require sha256"))
        extension = path.extension(source)
        destination = path.join(cache_root(), expected_sha256 + extension)
        digest = download_verified(source, destination, expected_sha256)
        return ResolvedArtifact(source, destination, identify_format(destination), digest)
    if not path.exists(source):
        return failure(types.ModelLoadError("model source does not exist: " + source))
    digest = "" if path.is_dir(source) else sha256_file(source)
    if not expected_sha256.is_empty():
        digest = verify(source, expected_sha256)
    return ResolvedArtifact(source, path.absolute(source), format, digest)
