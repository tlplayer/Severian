# Metrics.
def accuracy(expected: list[int], predicted: list[int]) -> float:
    return metrics.accuracy(expected, predicted)
def precision(expected: list[int], predicted: list[int], positive: int = 1) -> float:
    return metrics.precision(expected, predicted, positive)
def recall(expected: list[int], predicted: list[int], positive: int = 1) -> float:
    return metrics.recall(expected, predicted, positive)
def f1(expected: list[int], predicted: list[int], positive: int = 1) -> float:
    return metrics.f1(expected, predicted, positive)
def confusion_matrix(expected: list[int], predicted: list[int], classes: int = 0) -> list[list[int]]:
    return metrics.confusion_matrix(expected, predicted, classes)
def classification_report(expected: list[int], predicted: list[int]) -> string:
    return metrics.classification_report(expected, predicted)
def rmse(expected: list[float], predicted: list[float]) -> float:
    return metrics.rmse(expected, predicted)
def r2(expected: list[float], predicted: list[float]) -> float:
    return metrics.r2(expected, predicted)
def roc_auc(expected: list[int], predicted: list[float]) -> float:
    return metrics.roc_auc(expected, predicted)
def cosine_similarity(left: list[float], right: list[float]) -> float:
    return metrics.cosine_similarity(left, right)
def pairwise_distance(left: list[float], right: list[float]) -> float:
    return metrics.pairwise_distance(left, right)
