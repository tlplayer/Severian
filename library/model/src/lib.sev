unsafe:
    extern("__sev_model_graph_input") def graph_input(value: Tensor[f64]) -> Tensor[f64]
    extern("__sev_model_graph_relu") def graph_relu(value: Tensor[f64]) -> Tensor[f64]
    extern("__sev_model_graph_add") def graph_add(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]
    extern("__sev_model_graph_matmul") def graph_matmul(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]
    extern("__sev_model_graph_transpose") def graph_transpose(value: Tensor[f64]) -> Tensor[f64]
    extern("__sev_model_graph_scale") def graph_scale(value: Tensor[f64], factor: float) -> Tensor[f64]
    extern("__sev_model_graph_softmax_rows") def graph_softmax(value: Tensor[f64]) -> Tensor[f64]
    extern("__sev_model_graph_layer_norm") def graph_layer_norm(value: Tensor[f64], epsilon: float = 0.00001) -> Tensor[f64]
    extern("__sev_model_graph_run") def run_graph(value: Tensor[f64]) -> Tensor[f64]

# Public model types stay in this facade so user code never needs to import an
# implementation submodule just to declare a field.
trait Module:
    forward(input: Tensor[f64]) -> Tensor[f64]
    parameters() -> list[Tensor[f64]]

trait DatasetMap:
    forward(input: Any) -> Any

trait DatasetFilter:
    forward(input: Any) -> bool

class Linear: Module
    weight: Tensor[f64]
    bias: Tensor[f64]

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        projected = tensor_ops.matmul(input, weight)
        projected_values = tensor_ops.values(projected)
        bias_values = tensor_ops.values(bias)
        for index in indices(projected_values):
            projected_values[index] += bias_values[index % size(bias_values)]
        return tensor_ops.tensor(projected_values, tensor_ops.shape(projected))

    def parameters() -> list[Tensor[f64]]:
        return [weight, bias]

class Embedding: Module
    weight: Tensor[f64]

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        indices_values = tensor_ops.values(input)
        dimensions = tensor_ops.shape(weight)
        table = tensor_ops.values(weight)
        output := []
        for raw_index in indices_values:
            index = math.floor(raw_index)
            assert(index >= 0 and index < dimensions[0])
            output.extend(table[index * dimensions[1]:(index + 1) * dimensions[1]])
        return tensor_ops.tensor(output, tensor_ops.shape(input) + [dimensions[1]])

    def parameters() -> list[Tensor[f64]]:
        return [weight]

class LayerNorm: Module
    epsilon: float = 0.00001

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        dimensions = tensor_ops.shape(input)
        width = dimensions[size(dimensions) - 1]
        source = tensor_ops.values(input)
        output := []
        for row_start in range(0, size(source), width):
            row = source[row_start:row_start + width]
            center = row.reduce(|total, value| total + value, 0.0) / width
            variance = row.map(|value| (value - center) * (value - center)).reduce(|total, value| total + value, 0.0) / width
            scale = 1.0 / sqrt(variance + epsilon)
            output.extend(row.map(|value| (value - center) * scale))
        return tensor_ops.tensor(output, dimensions)

    def parameters() -> list[Tensor[f64]]:
        return []

class Dropout: Module
    probability: float = 0.5
    training: bool = true

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        if not training or probability == 0.0:
            return input
        mask = tensor_ops.values(tensor_ops.rand(tensor_ops.shape(input)))
        source = tensor_ops.values(input)
        scale = 1.0 / (1.0 - probability)
        for index in indices(source):
            source[index] = 0.0 if mask[index] < probability else source[index] * scale
        return tensor_ops.tensor(source, tensor_ops.shape(input))

    def parameters() -> list[Tensor[f64]]:
        return []

class MultiheadAttention: Module
    query: Linear
    key: Linear
    value: Linear
    output: Linear
    heads: int

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        query_value = query.forward(input)
        key_value = key.forward(input)
        value_value = value.forward(input)
        width = tensor_ops.shape(query_value)[1]
        scores = tensor_ops.scale(
            tensor_ops.matmul(query_value, tensor_ops.transpose(key_value)),
            1.0 / sqrt(float(width)),
        )
        return output.forward(tensor_ops.matmul(tensor_ops.softmax(scores), value_value))

    def parameters() -> list[Tensor[f64]]:
        return query.parameters() + key.parameters() + value.parameters() + output.parameters()

class Dataset:
    features: list[Any]
    targets: list[Any]

    def map(operation: DatasetMap) -> Dataset:
        return Dataset(features.map(|value| operation.forward(value)), targets[0:size(targets)])

    def filter(predicate: DatasetFilter) -> Dataset:
        selected_features := []
        selected_targets := []
        for index in indices(features):
            if predicate.forward(features[index]):
                selected_features.append(features[index])
                selected_targets.append(targets[index])
        return Dataset(selected_features, selected_targets)

    def shuffled() -> Dataset:
        order = indices(features)
        random.shuffle(order)
        return Dataset(order.map(|index| features[index]), order.map(|index| targets[index]))

    def batch(batch_size: int, drop_last: bool = false) -> list[Dataset]:
        batches := []
        start := 0
        while start < size(features):
            stop = min(start + batch_size, size(features))
            if not drop_last or stop - start == batch_size:
                batches.append(Dataset(features[start:stop], targets[start:stop]))
            start = stop
        return batches

    def cache() -> Dataset:
        return Dataset(features[0:size(features)], targets[0:size(targets)])

    def prefetch(count: int = 1) -> Dataset:
        assert(count > 0)
        return Dataset(features, targets)

class DataLoader:
    source: Dataset
    batch_size: int = 1
    shuffled: bool = false
    drop_last: bool = false

    def batches() -> list[Dataset]:
        selected = source.shuffled() if shuffled else source
        return selected.batch(batch_size, drop_last)

# External frameworks are import formats, never runtime dependencies. Every
# successful load produces this Severian-owned graph and parameter object.
class NeuralNet:
    artifact: types.ModelArtifact
    weight_bindings: weight_runtime.WeightStore = weight_runtime.WeightStore("")
    training_mode: bool = false
    compiled: bool = false

    def forward(input: Tensor[f64]) -> Tensor[f64]:
        return graph_runtime.execute(artifact.graph, input)

    def predict(input: Tensor[f64]) -> Tensor[f64]:
        return graph_runtime.execute(artifact.graph, input)

    def predict_proba(input: Tensor[f64]) -> Tensor[f64]:
        return tensor_ops.softmax(graph_runtime.execute(artifact.graph, input))

    def train():
        training_mode = true
        return

    def eval():
        training_mode = false
        return

    def compile():
        _valid = artifact.graph.validate()
        compiled = true
        return

    def parameters() -> list[types.TensorValue]:
        return artifact.graph.initializers

    def weights() -> list[types.TensorValue]:
        return artifact.graph.initializers

    def weight_f8e4m3fn(name: string) -> Result[Tensor[f8e4m3fn], types.ModelLoadError | IOError | JsonError]:
        return weight_bindings.f8e4m3fn(name)

    def weight_f8e5m2(name: string) -> Result[Tensor[f8e5m2], types.ModelLoadError | IOError | JsonError]:
        return weight_bindings.f8e5m2(name)

    def weight_f16(name: string) -> Result[Tensor[f16], types.ModelLoadError | IOError | JsonError]:
        return weight_bindings.f16(name)

    def weight_bf16(name: string) -> Result[Tensor[bf16], types.ModelLoadError | IOError | JsonError]:
        return weight_bindings.bf16(name)

    def weight_f32(name: string) -> Result[Tensor[f32], types.ModelLoadError | IOError | JsonError]:
        return weight_bindings.f32(name)

    def state() -> list[types.TensorValue]:
        return artifact.graph.initializers

    def summary() -> string:
        return artifact.summary() + ", " + string(size(artifact.graph.nodes)) + " operations, " + string(size(artifact.graph.initializers)) + " tensors"

    def to(device: string):
        artifact.device = device
        return

    def save(destination: string) -> unit | IOError:
        return serialization.save_artifact(artifact, destination)

    def load(source: string) -> unit | types.ModelLoadError | IOError | JsonError:
        format = artifacts.identify_format(source)
        incoming := []
        if format == "safetensors" or format == "huggingface-safetensors":
            incoming = safetensors_importer.load_parameters(source)
        elif format == "pytorch-state-dict":
            incoming = pytorch_importer.import_model(source).initializers
        else:
            return failure(types.ModelLoadError("state loading accepts safetensors or restricted PyTorch state_dict files"))
        existing_names = artifact.graph.initializers.map(|value| value.name)
        for parameter in incoming:
            if parameter.name not in existing_names:
                return failure(types.ModelLoadError("checkpoint contains unknown parameter: " + parameter.name))
            for index, existing in enumerate(artifact.graph.initializers):
                if existing.name == parameter.name:
                    if existing.shape != parameter.shape:
                        return failure(types.ModelLoadError("checkpoint shape mismatch for " + parameter.name))
                    artifact.graph.initializers[index] = parameter
        return

    def load_state(source: string) -> unit | types.ModelLoadError | IOError | JsonError:
        format = artifacts.identify_format(source)
        incoming := []
        if format == "safetensors" or format == "huggingface-safetensors":
            incoming = safetensors_importer.load_parameters(source)
        elif format == "pytorch-state-dict":
            incoming = pytorch_importer.import_model(source).initializers
        else:
            return failure(types.ModelLoadError("state loading accepts safetensors or restricted PyTorch state_dict files"))
        existing_names = artifact.graph.initializers.map(|value| value.name)
        for parameter in incoming:
            if parameter.name not in existing_names:
                return failure(types.ModelLoadError("checkpoint contains unknown parameter: " + parameter.name))
            for index, existing in enumerate(artifact.graph.initializers):
                if existing.name == parameter.name:
                    if existing.shape != parameter.shape:
                        return failure(types.ModelLoadError("checkpoint shape mismatch for " + parameter.name))
                    artifact.graph.initializers[index] = parameter
        return

def identify_format(source: string) -> string | types.ModelLoadError:
    return artifacts.identify_format(source)

def validate_imported_graph(graph: types.ModelGraph) -> unit | types.ModelLoadError:
    match graph.validate():
        ok _value:
            return
        failure invalid:
            return failure(types.ModelLoadError(invalid.message))

def load_graph(
    source: string,
    device: string = "auto",
    dtype: string = "auto",
    sha256: string = "",
) -> NeuralNet | types.ModelLoadError | IOError | JsonError:
    resolved = artifacts.resolve(source, sha256)
    if resolved.format == "severian":
        return NeuralNet(serialization.load_artifact(resolved.local_path))
    graph := types.ModelGraph("", [], [], [], [])
    if resolved.format == "onnx":
        graph = onnx_importer.import_model(resolved.local_path)
    elif resolved.format == "keras":
        graph = keras_importer.import_model(resolved.local_path)
    elif resolved.format == "pytorch-state-dict":
        graph = pytorch_importer.import_model(resolved.local_path)
    elif resolved.format in ["safetensors", "huggingface-safetensors"]:
        graph = safetensors_importer.import_model(resolved.local_path)
    else:
        return failure(types.ModelLoadError("unsupported model import format: " + resolved.format))
    _valid = validate_imported_graph(graph)
    config := json.decode[Any]("{}")
    config_path = path.join(resolved.local_path if path.is_dir(resolved.local_path) else path.dirname(resolved.local_path), "config.json")
    if path.exists(config_path):
        config_text = file.read_text(config_path)
        config = json.decode[Any](config_text)
    selected_dtype := dtype
    if selected_dtype == "auto" and size(graph.initializers) > 0:
        selected_dtype = graph.initializers[0].dtype
    artifact = types.ModelArtifact(source, resolved.local_path, resolved.format, graph.name, device, selected_dtype, config, graph.initializers, graph, resolved.content_sha256)
    return NeuralNet(artifact, weight_runtime.open(resolved.local_path))

# Generic estimator protocol helpers.
def fit(estimator: Any, features: Any, targets: Any) -> Any:
    return estimator.fit(features, targets)
def train(estimator: Any) -> Any:
    return estimator.train()
def eval(estimator: Any) -> Any:
    return estimator.eval()
def predict(estimator: Any, features: Any) -> Any:
    return estimator.predict(features)
def predict_proba(estimator: Any, features: Any) -> Any:
    return estimator.predict_proba(features)
def transform(estimator: Any, features: Any) -> Any:
    return estimator.transform(features)
def fit_transform(estimator: Any, features: Any) -> Any:
    return estimator.fit_transform(features)
def score(estimator: Any, features: Any, targets: Any) -> float:
    return estimator.score(features, targets)
def evaluate(estimator: Any, features: Any, targets: Any) -> float:
    return score(estimator, features, targets)
def compile(estimator: Any) -> Any:
    return estimator.compile()
def forward(estimator: Any, input: Any) -> Any:
    return estimator.forward(input)
def parameters(estimator: Any) -> Any:
    return estimator.parameters()
def weights(estimator: Any) -> Any:
    return estimator.weights()
def state(estimator: Any) -> Any:
    return estimator.state()
def load_state(estimator: Any, source: string) -> Any:
    return estimator.load_state(source)
def summary(estimator: Any) -> string:
    return estimator.summary()
def save(estimator: Any, destination: string) -> Any:
    return estimator.save(destination)

# Tensor surface.
def tensor(values: list[float], shape: list[int]) -> Tensor[f64]:
    return tensor_ops.tensor(values, shape)
def values(input: Tensor[f64]) -> list[float]:
    return tensor_ops.values(input)
def zeros(shape: list[int]) -> Tensor[f64]:
    return tensor_ops.zeros(shape)
def ones(shape: list[int]) -> Tensor[f64]:
    return tensor_ops.ones(shape)
def empty(shape: list[int]) -> Tensor[f64]:
    return tensor_ops.empty(shape)
def full(shape: list[int], value: float) -> Tensor[f64]:
    return tensor_ops.full(shape, value)
def rand(shape: list[int]) -> Tensor[f64]:
    return tensor_ops.rand(shape)
def randn(shape: list[int]) -> Tensor[f64]:
    return tensor_ops.randn(shape)
def randint(low: int, high: int, shape: list[int]) -> Tensor[f64]:
    return tensor_ops.randint(low, high, shape)
def seed(value: int):
    tensor_ops.seed(value)
def floor(value: float) -> int:
    return tensor_ops.floor(value)
def arange(start: float, stop: float = 0.0, step: float = 1.0) -> Tensor[f64]:
    return tensor_ops.arange(start, stop, step)
def linspace(start: float, stop: float, steps: int) -> Tensor[f64]:
    return tensor_ops.linspace(start, stop, steps)
def shape(input: Tensor[f64]) -> list[int]:
    return tensor_ops.shape(input)
def element_count(input: Tensor[f64]) -> int:
    return tensor_ops.size_of(input)
def reshape(input: Tensor[f64], dimensions: list[int]) -> Tensor[f64]:
    return tensor_ops.reshape(input, dimensions)
def view(input: Tensor[f64], dimensions: list[int]) -> Tensor[f64]:
    return tensor_ops.view(input, dimensions)
def flatten(input: Tensor[f64], start_dimension: int = 0, end_dimension: int = -1) -> Tensor[f64]:
    return tensor_ops.flatten(input, start_dimension, end_dimension)
def squeeze(input: Tensor[f64], dimension: int = -1) -> Tensor[f64]:
    return tensor_ops.squeeze(input, dimension)
def unsqueeze(input: Tensor[f64], dimension: int) -> Tensor[f64]:
    return tensor_ops.unsqueeze(input, dimension)
def transpose(input: Tensor[f64], first: int = -2, second: int = -1) -> Tensor[f64]:
    return tensor_ops.transpose(input, first, second)
def permute(input: Tensor[f64], dimensions: list[int]) -> Tensor[f64]:
    return tensor_ops.permute(input, dimensions)
def concat(inputs: list[Tensor[f64]], dimension: int = 0) -> Tensor[f64]:
    return tensor_ops.concat(inputs, dimension)
def stack(inputs: list[Tensor[f64]], dimension: int = 0) -> Tensor[f64]:
    return tensor_ops.stack(inputs, dimension)
def split(input: Tensor[f64], split_size: int, dimension: int = 0) -> list[Tensor[f64]]:
    return tensor_ops.split(input, split_size, dimension)
def chunk(input: Tensor[f64], chunks: int, dimension: int = 0) -> list[Tensor[f64]]:
    return tensor_ops.chunk(input, chunks, dimension)
def sum(input: Tensor[f64]) -> float:
    return tensor_ops.sum(input)
def mean(input: Tensor[f64]) -> float:
    return tensor_ops.mean(input)
def minimum(input: Tensor[f64]) -> float:
    return tensor_ops.minimum(input)
def maximum(input: Tensor[f64]) -> float:
    return tensor_ops.maximum(input)
def argmin(input: Tensor[f64]) -> int:
    return tensor_ops.argmin(input)
def argmax(input: Tensor[f64]) -> int:
    return tensor_ops.argmax(input)
def std(input: Tensor[f64], correction: int = 1) -> float:
    return tensor_ops.std(input, correction)
def var(input: Tensor[f64], correction: int = 1) -> float:
    return tensor_ops.var(input, correction)
def matmul(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.matmul(left, right)
def add(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.add(left, right)
def subtract(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.subtract(left, right)
def multiply(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.multiply(left, right)
def divide(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.divide(left, right)
def scale(input: Tensor[f64], factor: float) -> Tensor[f64]:
    return tensor_ops.scale(input, factor)
def dot(left: Tensor[f64], right: Tensor[f64]) -> float:
    return tensor_ops.dot(left, right)
def einsum(equation: string, left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.einsum(equation, left, right)
def where(condition: Tensor[f64], when_true: Tensor[f64], when_false: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.where(condition, when_true, when_false)
def clamp(input: Tensor[f64], minimum: float, maximum: float) -> Tensor[f64]:
    return tensor_ops.clamp(input, minimum, maximum)
def clip(input: Tensor[f64], minimum: float, maximum: float) -> Tensor[f64]:
    return tensor_ops.clip(input, minimum, maximum)
def topk(input: Tensor[f64], count: int) -> tuple[Tensor[f64], list[int]]:
    return tensor_ops.topk(input, count)
def sort(input: Tensor[f64], descending: bool = false) -> Tensor[f64]:
    return tensor_ops.sort(input, descending)
def argsort(input: Tensor[f64], descending: bool = false) -> list[int]:
    return tensor_ops.argsort(input, descending)
def exp(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.exp(input)
def log(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.log(input)
def square_root(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.square_root(input)
def sin(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.sin(input)
def cos(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.cos(input)
def absolute(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.absolute(input)
def pow(input: Tensor[f64], exponent: float) -> Tensor[f64]:
    return tensor_ops.pow(input, exponent)
def softmax(input: Tensor[f64], dimension: int = -1) -> Tensor[f64]:
    return tensor_ops.softmax(input, dimension)
def log_softmax(input: Tensor[f64], dimension: int = -1) -> Tensor[f64]:
    return tensor_ops.log_softmax(input, dimension)
def sigmoid(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.sigmoid(input)
def relu(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.relu(input)
def gelu(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.gelu(input)
def silu(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.silu(input)
def tanh(input: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.tanh(input)

# Layers.
def linear(inputs: int, outputs: int, bias: bool = true) -> Linear:
    initialized = layers.linear(inputs, outputs, bias)
    return Linear(initialized.weight, initialized.bias)
def dense(inputs: int, outputs: int, bias: bool = true) -> Linear:
    return linear(inputs, outputs, bias)
def embedding(vocabulary: int, dimensions: int) -> Embedding:
    return Embedding(tensor_ops.randn([vocabulary, dimensions]))
def conv1d(input_channels: int, output_channels: int, kernel_size: int, stride: int = 1, padding: int = 0) -> layers.Convolution:
    return layers.conv1d(input_channels, output_channels, kernel_size, stride, padding)
def conv2d(input_channels: int, output_channels: int, kernel_size: int, stride: int = 1, padding: int = 0) -> layers.Convolution:
    return layers.conv2d(input_channels, output_channels, kernel_size, stride, padding)
def conv3d(input_channels: int, output_channels: int, kernel_size: int, stride: int = 1, padding: int = 0) -> layers.Convolution:
    return layers.conv3d(input_channels, output_channels, kernel_size, stride, padding)
def conv_transpose2d(input_channels: int, output_channels: int, kernel_size: int, stride: int = 1, padding: int = 0) -> layers.Convolution:
    return layers.conv_transpose2d(input_channels, output_channels, kernel_size, stride, padding)
def max_pool1d(kernel_size: int, stride: int = 0) -> layers.Pool:
    return layers.max_pool1d(kernel_size, stride)
def max_pool2d(kernel_size: int, stride: int = 0) -> layers.Pool:
    return layers.max_pool2d(kernel_size, stride)
def avg_pool1d(kernel_size: int, stride: int = 0) -> layers.Pool:
    return layers.avg_pool1d(kernel_size, stride)
def avg_pool2d(kernel_size: int, stride: int = 0) -> layers.Pool:
    return layers.avg_pool2d(kernel_size, stride)
def adaptive_avg_pool2d(output_size: int) -> layers.Pool:
    return layers.adaptive_avg_pool2d(output_size)
def batch_norm() -> layers.BatchNorm:
    return layers.batch_norm()
def layer_norm(epsilon: float = 0.00001) -> LayerNorm:
    return LayerNorm(epsilon)
def group_norm(groups: int, epsilon: float = 0.00001) -> layers.GroupNorm:
    return layers.group_norm(groups, epsilon)
def dropout(probability: float = 0.5) -> Dropout:
    return Dropout(probability)
def activation(name: string) -> layers.Activation:
    return layers.Activation(name)
def sequential(items: list[layers.Module]) -> layers.Sequential:
    return layers.sequential(items)
def multihead_attention(width: int, heads: int = 1) -> MultiheadAttention:
    return MultiheadAttention(linear(width, width), linear(width, width), linear(width, width), linear(width, width), heads)
def attention(query: Linear, key: Linear, value: Linear, output: Linear, heads: int = 1) -> MultiheadAttention:
    return MultiheadAttention(query, key, value, output, heads)
def rnn(inputs: int, hidden: int) -> layers.RNN:
    return layers.rnn(inputs, hidden)
def lstm(inputs: int, hidden: int) -> layers.LSTM:
    return layers.lstm(inputs, hidden)
def gru(inputs: int, hidden: int) -> layers.GRU:
    return layers.gru(inputs, hidden)
def transformer(items: list[layers.Module]) -> layers.Transformer:
    return layers.transformer(items)
def transformer_encoder(items: list[layers.Module]) -> layers.Transformer:
    return layers.transformer_encoder(items)
def transformer_decoder(items: list[layers.Module]) -> layers.Transformer:
    return layers.transformer_decoder(items)

# Losses.
def cross_entropy(predicted: Tensor[f64], expected: list[int]) -> float:
    return losses.cross_entropy(predicted, expected)
def binary_cross_entropy(predicted: Tensor[f64], expected: Tensor[f64]) -> float:
    return losses.binary_cross_entropy(predicted, expected)
def binary_cross_entropy_logits(predicted: Tensor[f64], expected: Tensor[f64]) -> float:
    return losses.binary_cross_entropy_logits(predicted, expected)
def mse(predicted: Tensor[f64], expected: Tensor[f64]) -> float:
    return losses.mse(predicted, expected)
def mae(predicted: Tensor[f64], expected: Tensor[f64]) -> float:
    return losses.mae(predicted, expected)
def huber(predicted: Tensor[f64], expected: Tensor[f64], delta: float = 1.0) -> float:
    return losses.huber(predicted, expected, delta)
def nll_loss(predicted: Tensor[f64], expected: list[int]) -> float:
    return losses.nll_loss(predicted, expected)
def kl_divergence(predicted: Tensor[f64], expected: Tensor[f64]) -> float:
    return losses.kl_divergence(predicted, expected)
def cosine_embedding_loss(left: Tensor[f64], right: Tensor[f64], target: float = 1.0, margin: float = 0.0) -> float:
    return losses.cosine_embedding_loss(left, right, target, margin)
def triplet_loss(anchor: Tensor[f64], positive: Tensor[f64], negative: Tensor[f64], margin: float = 1.0) -> float:
    return losses.triplet_loss(anchor, positive, negative, margin)

# Optimizers, gradient controls, and schedules.
def sgd(parameters: list[optimizers.Parameter], learning_rate: float = 0.01, momentum: float = 0.0, weight_decay: float = 0.0) -> optimizers.SGD:
    return optimizers.sgd(parameters, learning_rate, momentum, weight_decay)
def adam(parameters: list[optimizers.Parameter], learning_rate: float = 0.001, weight_decay: float = 0.0) -> optimizers.Adam:
    return optimizers.adam(parameters, learning_rate, weight_decay)
def adamw(parameters: list[optimizers.Parameter], learning_rate: float = 0.001, weight_decay: float = 0.01) -> optimizers.Adam:
    return optimizers.adamw(parameters, learning_rate, weight_decay)
def adagrad(parameters: list[optimizers.Parameter], learning_rate: float = 0.01) -> optimizers.Adagrad:
    return optimizers.adagrad(parameters, learning_rate)
def adadelta(parameters: list[optimizers.Parameter], learning_rate: float = 1.0) -> optimizers.RMSprop:
    return optimizers.adadelta(parameters, learning_rate)
def rmsprop(parameters: list[optimizers.Parameter], learning_rate: float = 0.001) -> optimizers.RMSprop:
    return optimizers.rmsprop(parameters, learning_rate)
def zero_grad(optimizer: optimizers.Optimizer):
    optimizer.zero_grad()
def step(optimizer: optimizers.Optimizer):
    optimizer.step()
def learning_rate(optimizer: optimizers.Optimizer, value: float = -1.0) -> float:
    if value >= 0.0:
        optimizer.set_learning_rate(value)
    return optimizer.current_learning_rate()
def weight_decay(optimizer: optimizers.Optimizer, value: float = -1.0) -> float:
    if value >= 0.0:
        optimizer.set_weight_decay(value)
    return optimizer.current_weight_decay()
def momentum(optimizer: optimizers.SGD, value: float = -1.0) -> float:
    if value >= 0.0:
        optimizer.set_momentum(value)
    return optimizer.momentum
def linear_lr(optimizer: optimizers.Optimizer, total_steps: int) -> optimizers.Scheduler:
    return optimizers.linear_lr(optimizer, total_steps)
def cosine_lr(optimizer: optimizers.Optimizer, total_steps: int) -> optimizers.Scheduler:
    return optimizers.cosine_lr(optimizer, total_steps)
def exponential_lr(optimizer: optimizers.Optimizer, gamma: float = 0.99) -> optimizers.Scheduler:
    return optimizers.exponential_lr(optimizer, gamma)
def reduce_lr_on_plateau(optimizer: optimizers.Optimizer, factor: float = 0.1, patience: int = 10) -> optimizers.Scheduler:
    return optimizers.reduce_lr_on_plateau(optimizer, factor, patience)
def warmup(optimizer: optimizers.Optimizer, steps: int) -> optimizers.Scheduler:
    return optimizers.warmup(optimizer, steps)
def backward(loss: Tensor[f64]):
    tensor_runtime.backward_mse(loss)
def grad(value: Tensor[f64]) -> Tensor[f64]:
    return tensor_runtime.gradient(value)
def detach(value: Tensor[f64]) -> Tensor[f64]:
    return tensor_ops.tensor(tensor_ops.values(value), tensor_ops.shape(value))
def requires_grad(value: Tensor[f64], required: bool = true) -> optimizers.Parameter:
    return optimizers.Parameter(value, tensor_ops.zeros(tensor_ops.shape(value)), required)
def no_grad[T](value: T) -> T:
    return value
def inference[T](value: T) -> T:
    return value
def jacobian(operation: layers.Module, input: Tensor[f64], epsilon: float = 0.000001) -> Tensor[f64]:
    return finite_jacobian(operation, input, epsilon)
def jacobian_list(input: list[float]) -> list[list[float]]:
    output: list[list[float]] = []
    for row in indices(input):
        row_values: list[float] = []
        for column in indices(input):
            row_values.append(1.0 if row == column else 0.0)
        output.append(row_values)
    return output
def hessian(operation: layers.Module, input: Tensor[f64], epsilon: float = 0.0001) -> Tensor[f64]:
    source = tensor_ops.values(input)
    base = tensor_ops.values(operation.forward(input))
    assert(size(base) == 1, "hessian requires a scalar-output module")
    output := []
    for row in indices(source):
        for column in indices(source):
            both = source[0:size(source)]
            row_only = source[0:size(source)]
            column_only = source[0:size(source)]
            both[row] += epsilon
            both[column] += epsilon
            row_only[row] += epsilon
            column_only[column] += epsilon
            both_value = tensor_ops.values(operation.forward(tensor_ops.tensor(both, tensor_ops.shape(input))))[0]
            row_value = tensor_ops.values(operation.forward(tensor_ops.tensor(row_only, tensor_ops.shape(input))))[0]
            column_value = tensor_ops.values(operation.forward(tensor_ops.tensor(column_only, tensor_ops.shape(input))))[0]
            output.append((both_value - row_value - column_value + base[0]) / (epsilon * epsilon))
    return tensor_ops.tensor(output, [size(source), size(source)])
def finite_jacobian(operation: layers.Module, input: Tensor[f64], epsilon: float) -> Tensor[f64]:
    source = tensor_ops.values(input)
    base = tensor_ops.values(operation.forward(input))
    output := []
    for column in indices(source):
        changed = source[0:size(source)]
        changed[column] += epsilon
        shifted = tensor_ops.values(operation.forward(tensor_ops.tensor(changed, tensor_ops.shape(input))))
        for row in indices(base):
            output.append((shifted[row] - base[row]) / epsilon)
    return tensor_ops.tensor(output, [size(base), size(source)])

# Data and model selection.
def dataset(features: list[Any], targets: list[Any]) -> Dataset:
    assert(size(features) == size(targets))
    return Dataset(features, targets)
def dataloader(source: Dataset, batch_size: int = 1, shuffle: bool = false, drop_last: bool = false) -> DataLoader:
    return DataLoader(source, batch_size, shuffle, drop_last)
def batch(source: Dataset, batch_size: int, drop_last: bool = false) -> list[Dataset]:
    return source.batch(batch_size, drop_last)
def shuffle(source: Dataset) -> Dataset:
    return source.shuffled()
def map(source: Dataset, operation: DatasetMap) -> Dataset:
    return source.map(operation)
def filter(source: Dataset, predicate: DatasetFilter) -> Dataset:
    return source.filter(predicate)
def cache(source: Dataset) -> Dataset:
    return source.cache()
def prefetch(source: Dataset, count: int = 1) -> Dataset:
    return source.prefetch(count)
def train_test_split(features: list[Any], targets: list[Any], test_size: float = 0.25, shuffle: bool = true, seed: int = 0) -> tuple[list[Any], list[Any], list[Any], list[Any]]:
    return data_api.train_test_split(features, targets, test_size, shuffle, seed)
def kfold(splits: int = 5, shuffle: bool = false, seed: int = 0) -> data_api.KFold:
    return data_api.kfold(splits, shuffle, seed)
def stratified_kfold(splits: int = 5, shuffle: bool = false, seed: int = 0) -> data_api.StratifiedKFold:
    return data_api.stratified_kfold(splits, shuffle, seed)
def cross_validate(estimator: Any, features: list[Any], targets: list[Any], folds: int = 5) -> list[float]:
    return data_api.cross_validate(estimator, features, targets, folds)
def cross_val_score(estimator: Any, features: list[Any], targets: list[Any], folds: int = 5) -> list[float]:
    return data_api.cross_val_score(estimator, features, targets, folds)
def grid_search(candidates: list[Any], features: list[Any], targets: list[Any], folds: int = 5) -> Any:
    assert(size(candidates) > 0)
    best := candidates[0]
    best_score := -999999999999.0
    for candidate in candidates:
        scores = data_api.cross_val_score(candidate, features, targets, folds)
        candidate_score = scores.reduce(|total, score| total + score, 0.0) / size(scores)
        if candidate_score > best_score:
            best_score = candidate_score
            best = candidate
    return best.fit(features, targets)
def random_search(candidates: list[Any], features: list[Any], targets: list[Any], trials: int = 10, folds: int = 5) -> Any:
    selected = candidates[0:size(candidates)]
    random.shuffle(selected)
    count = trials if trials < size(selected) else size(selected)
    return grid_search(selected[0:count], features, targets, folds)

