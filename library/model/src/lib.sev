import tensor

unsafe:
    native("__sev_tensor_from_list") def tensor(values: list[float], shape: list[int]) -> Tensor[f64]

    native("__sev_tensor_to_list") def values(input: Tensor[f64]) -> list[float]

    native("__sev_tensor_shape") def shape(input: Tensor[f64]) -> list[int]

    native("__sev_tensor_matmul") def matmul(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]

    native("__sev_tensor_add") def add(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]

    native("__sev_tensor_relu") def relu(input: Tensor[f64]) -> Tensor[f64]

    native("__sev_tensor_transpose") def transpose(input: Tensor[f64]) -> Tensor[f64]

    native("__sev_tensor_scale") def scale(input: Tensor[f64], factor: float) -> Tensor[f64]

    native("__sev_tensor_softmax_rows") def softmax_rows(input: Tensor[f64]) -> Tensor[f64]

    native("__sev_tensor_layer_norm") def layer_norm(input: Tensor[f64], epsilon: float = 0.00001) -> Tensor[f64]

def relu_list(input: list[float]) -> list[float]:
    output := []
    for value in input:
        if value > 0.0:
            output.append(value)
        else:
            output.append(0.0)
    return output

def fast_sigmoid_list(input: list[float]) -> list[float]:
    output := []
    for value in input:
        output.append(0.5 + value / (2.0 * (1.0 + abs(value))))
    return output

def fast_tanh_list(input: list[float]) -> list[float]:
    output := []
    for value in input:
        output.append(value / (1.0 + abs(value)))
    return output

def swish_list(input: list[float]) -> list[float]:
    output := []
    for value in input:
        output.append(value * (0.5 + value / (2.0 * (1.0 + abs(value)))))
    return output

def jacobian_list(input: list[float]) -> list[float]:
    output := []
    for row in range(0, size(input)):
        for column in range(0, size(input)):
            if row == column:
                output.append(1.0)
            else:
                output.append(0.0)
    return output

def graph_input(input: Tensor[f64]) -> Tensor[f64]:
    return input

def graph_relu(input: Tensor[f64]) -> Tensor[f64]:
    return relu(input)

def graph_add(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return add(left, right)

def graph_matmul(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return matmul(left, right)

def run_graph(input: Tensor[f64]) -> Tensor[f64]:
    return input

def softmax(input: Tensor[f64], dimension: int = -1) -> Tensor[f64]:
    assert(dimension == -1 or dimension == 1)
    return softmax_rows(input)

def scaled_dot_product_attention(
    query: Tensor[f64],
    key: Tensor[f64],
    value: Tensor[f64],
    attention_scale: float,
) -> Tensor[f64]:
    scores = scale(matmul(query, transpose(key)), attention_scale)
    return matmul(softmax(scores), value)

test "model tensors expose familiar operations":
    x = tensor([1.0, 2.0, 3.0, 4.0], [2, 2])
    identity = tensor([1.0, 0.0, 0.0, 1.0], [2, 2])
    bias = tensor([10.0, 20.0], [2])
    assert(values(matmul(x, identity)) == [1.0, 2.0, 3.0, 4.0])
    assert(values(add(x, bias)) == [11.0, 22.0, 13.0, 24.0])
    assert(shape(relu(x)) == [2, 2])

test "scaled dot product attention retains token shape":
    x = tensor([1.0, 0.0, 0.0, 1.0], [2, 2])
    output = scaled_dot_product_attention(x, x, x, 0.7071067811865476)
    assert(shape(output) == [2, 2])
