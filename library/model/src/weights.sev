import path
import tensor
import "src/types.sev" as types

# A WeightRef is metadata plus a lazy memory-mapped slice. It is deliberately
# untyped until an architecture binds it through one of the checked methods.
class WeightRef:
    entry: tensor.SafeTensorEntry

    def name() -> string:
        return entry.name

    def dtype() -> string:
        return entry.dtype

    def shape() -> list[int]:
        return entry.shape

    def bytes() -> int:
        return entry.bytes()

    def require(expected_dtype: string) -> unit | types.ModelLoadError:
        if entry.dtype != expected_dtype:
            return failure(types.ModelLoadError(
                "weight `" + entry.name + "` has dtype " + entry.dtype + ", expected " + expected_dtype,
            ))
        return

    def f8e4m3fn() -> Result[Tensor[f8e4m3fn], types.ModelLoadError]:
        if entry.dtype not in ["F8_E4M3", "F8_E4M3FN"]:
            return failure(types.ModelLoadError("weight `" + entry.name + "` is not F8_E4M3FN"))
        return entry.f8e4m3fn()

    def f8e5m2() -> Result[Tensor[f8e5m2], types.ModelLoadError]:
        _dtype = self.require("F8_E5M2")
        return entry.f8e5m2()

    def f16() -> Result[Tensor[f16], types.ModelLoadError]:
        _dtype = self.require("F16")
        return entry.f16()

    def bf16() -> Result[Tensor[bf16], types.ModelLoadError]:
        _dtype = self.require("BF16")
        return entry.bf16()

    def f32() -> Result[Tensor[f32], types.ModelLoadError]:
        _dtype = self.require("F32")
        return entry.f32()

class WeightStore:
    model_directory: string

    def tensor_store() -> tensor.SafeTensorStore | types.ModelLoadError | IOError | JsonError:
        if model_directory.is_empty():
            return failure(types.ModelLoadError("this model has no mapped checkpoint"))
        return tensor.open_safetensors(model_directory)

    def keys() -> Result[list[string], types.ModelLoadError | IOError | JsonError]:
        store = self.tensor_store()
        return store.keys()

    def contains(name: string) -> bool | types.ModelLoadError | IOError | JsonError:
        names = self.keys()
        return name in names

    def get(name: string) -> WeightRef | types.ModelLoadError | IOError | JsonError:
        store = self.tensor_store()
        if name not in store.keys():
            return failure(types.ModelLoadError("checkpoint has no weight `" + name + "`"))
        return WeightRef(store.get(name))

    def f8e4m3fn(name: string) -> Result[Tensor[f8e4m3fn], types.ModelLoadError | IOError | JsonError]:
        weight: WeightRef = self.get(name)
        return weight.f8e4m3fn()

    def f8e5m2(name: string) -> Result[Tensor[f8e5m2], types.ModelLoadError | IOError | JsonError]:
        weight: WeightRef = self.get(name)
        return weight.f8e5m2()

    def f16(name: string) -> Result[Tensor[f16], types.ModelLoadError | IOError | JsonError]:
        weight: WeightRef = self.get(name)
        return weight.f16()

    def bf16(name: string) -> Result[Tensor[bf16], types.ModelLoadError | IOError | JsonError]:
        weight: WeightRef = self.get(name)
        return weight.bf16()

    def f32(name: string) -> Result[Tensor[f32], types.ModelLoadError | IOError | JsonError]:
        weight: WeightRef = self.get(name)
        return weight.f32()

def open(source: string) -> WeightStore:
    return WeightStore(source if path.is_dir(source) else path.dirname(source))
