import file
import math
import "src/archive.sev" as archive
import "src/types.sev" as types

class PickleValue:
    kind: string
    text: string = ""
    integer: int = 0
    items: list[PickleValue] = []
    storage_key: string = ""
    dtype: string = ""
    offset: int = 0
    shape: list[int] = []

class RestrictedUnpickler:
    reader: archive.ByteReader
    stack: list[PickleValue] = []
    marks: list[int] = []
    memo: list[PickleValue] = []

    def push(value: PickleValue):
        stack.append(value)
    def pop() -> PickleValue:
        return stack.pop()

    def memo_set(index: int, value: PickleValue):
        while size(memo) <= index:
            memo.append(PickleValue("none"))
        memo[index] = value

    def line() -> string:
        bytes := []
        while true:
            byte = reader.u8()
            if byte == 10:
                break
            bytes.append(byte)
        text: string = file.utf8(bytes)
        return text

    def unicode(count: int) -> PickleValue:
        text: string = file.utf8(reader.take(count))
        return PickleValue("string", text)

    def marked_items() -> list[PickleValue]:
        start = marks.pop()
        items = stack[start:size(stack)]
        while size(stack) > start:
            _discarded = stack.pop()
        return items

    def tuple_value(items: list[PickleValue]) -> PickleValue:
        return PickleValue("tuple", "", 0, items)

    def allowed_global(module: string, name: string) -> PickleValue:
        qualified = module + "." + name
        allowed = [
            "collections.OrderedDict", "torch._utils._rebuild_tensor", "torch._utils._rebuild_tensor_v2",
            "torch._utils._rebuild_parameter", "torch.FloatStorage", "torch.DoubleStorage",
            "torch.HalfStorage", "torch.BFloat16Storage", "torch.LongStorage", "torch.IntStorage",
            "torch.ShortStorage", "torch.CharStorage", "torch.ByteStorage", "torch.BoolStorage",
        ]
        assert(qualified in allowed, "unsafe or unsupported PyTorch pickle global: " + qualified)
        return PickleValue("global", qualified)

    def persistent(storage: PickleValue) -> PickleValue:
        assert(storage.kind == "tuple" and size(storage.items) >= 5)
        assert(storage.items[0].text == "storage", "only PyTorch tensor storage persistent IDs are accepted")
        storage_type = storage.items[1].text
        dtype = "f32" if "FloatStorage" in storage_type else "f64" if "DoubleStorage" in storage_type else "f16" if "HalfStorage" in storage_type else "bf16" if "BFloat16Storage" in storage_type else "i64" if "LongStorage" in storage_type else "i32" if "IntStorage" in storage_type else "i16" if "ShortStorage" in storage_type else "i8" if "CharStorage" in storage_type else "u8" if "ByteStorage" in storage_type else "bool"
        return PickleValue("storage", "", 0, [], storage.items[2].text, dtype)

    def reduce(callable: PickleValue, arguments: PickleValue) -> PickleValue:
        assert(callable.kind == "global" and arguments.kind == "tuple")
        if callable.text == "collections.OrderedDict":
            return PickleValue("dict")
        if callable.text in ["torch._utils._rebuild_tensor", "torch._utils._rebuild_tensor_v2"]:
            assert(size(arguments.items) >= 4 and arguments.items[0].kind == "storage")
            storage = arguments.items[0]
            shape = arguments.items[2].items.map(|value| value.integer)
            return PickleValue("tensor", "", 0, [], storage.storage_key, storage.dtype, arguments.items[1].integer, shape)
        if callable.text == "torch._utils._rebuild_parameter":
            return arguments.items[0]
        assert(false, "unsupported restricted pickle reducer: " + callable.text)
        return PickleValue("none")

    def load() -> PickleValue:
        while true:
            opcode = reader.u8()
            if opcode == 128:
                _protocol = reader.u8()
            elif opcode == 149:
                _frame = reader.take(8)
            elif opcode == 46:
                return self.pop()                  # STOP
            elif opcode == 40:
                marks.append(size(stack))          # MARK
            elif opcode == 78:
                self.push(PickleValue("none"))     # NONE
            elif opcode == 136:
                self.push(PickleValue("bool", "", 1))
            elif opcode == 137:
                self.push(PickleValue("bool", "", 0))
            elif opcode == 75:
                self.push(PickleValue("int", "", reader.u8()))
            elif opcode == 77:
                self.push(PickleValue("int", "", reader.u16()))
            elif opcode == 74:
                self.push(PickleValue("int", "", signed_i32(reader.take(4))))
            elif opcode == 138:
                count = reader.u8()
                self.push(PickleValue("int", "", little_integer(reader.take(count))))
            elif opcode == 88:
                self.push(self.unicode(reader.u32()))
            elif opcode == 140:
                self.push(self.unicode(reader.u8()))
            elif opcode == 141:
                self.push(self.unicode(little_integer(reader.take(8))))
            elif opcode == 99:
                module = self.line()
                name = self.line()
                self.push(self.allowed_global(module, name))
            elif opcode == 147:
                name = self.pop()
                module = self.pop()
                self.push(self.allowed_global(module.text, name.text))
            elif opcode == 41:
                self.push(self.tuple_value([]))
            elif opcode == 116:
                self.push(self.tuple_value(self.marked_items()))
            elif opcode == 133:
                self.push(self.tuple_value([self.pop()]))
            elif opcode == 134:
                right = self.pop()
                left = self.pop()
                self.push(self.tuple_value([left, right]))
            elif opcode == 135:
                third = self.pop()
                second = self.pop()
                first = self.pop()
                self.push(self.tuple_value([first, second, third]))
            elif opcode == 93:
                self.push(PickleValue("list"))
            elif opcode == 125:
                self.push(PickleValue("dict"))
            elif opcode == 101:
                items = self.marked_items()
                stack[size(stack) - 1].items.extend(items)
            elif opcode == 97:
                stack[size(stack) - 1].items.append(self.pop())
            elif opcode == 115:
                value = self.pop()
                key = self.pop()
                stack[size(stack) - 1].items.extend([key, value])
            elif opcode == 117:
                items = self.marked_items()
                stack[size(stack) - 1].items.extend(items)
            elif opcode == 82:
                arguments = self.pop()
                callable = self.pop()
                self.push(self.reduce(callable, arguments))
            elif opcode == 81:
                self.push(self.persistent(self.pop()))
            elif opcode == 98:
                _state = self.pop()               # BUILD metadata only
            elif opcode == 113:
                self.memo_set(reader.u8(), stack[size(stack) - 1])
            elif opcode == 114:
                self.memo_set(reader.u32(), stack[size(stack) - 1])
            elif opcode == 104:
                self.push(memo[reader.u8()])
            elif opcode == 106:
                self.push(memo[reader.u32()])
            elif opcode == 148:
                memo.append(stack[size(stack) - 1])
            elif opcode == 48:
                _discarded = self.pop()
            elif opcode == 49:
                start = marks.pop()
                while size(stack) > start:
                    _discarded = self.pop()
            else:
                assert(false, "unsupported opcode in restricted PyTorch weights pickle: " + string(opcode))
        return PickleValue("none")

def little_integer(data: list[int]) -> int:
    result := 0
    multiplier := 1
    for byte in data:
        result += byte * multiplier
        multiplier *= 256
    return result

def signed_i32(data: list[int]) -> int:
    value = little_integer(data)
    return value - 4294967296 if value >= 2147483648 else value

def storage_entry(entries: list[archive.ZipEntry], key: string) -> archive.ZipEntry:
    for entry in entries:
        if entry.name.ends_with("/data/" + key):
            return entry
    assert(false, "PyTorch archive is missing tensor storage " + key)
    return archive.ZipEntry("", [])

def decode_storage(data: list[int], dtype: string, offset: int, count: int) -> list[float]:
    width = 8 if dtype in ["f64", "i64"] else 4 if dtype in ["f32", "i32"] else 2 if dtype in ["f16", "bf16", "i16"] else 1
    start = offset * width
    output := []
    for index in range(0, count):
        bytes = data[start + index * width:start + (index + 1) * width]
        if dtype == "f32":
            output.append(ieee_float(bytes, 8, 23))
        elif dtype == "f64":
            output.append(ieee_float(bytes, 11, 52))
        elif dtype == "f16":
            output.append(ieee_float(bytes, 5, 10))
        elif dtype == "bf16":
            output.append(ieee_float(bytes + [0, 0], 8, 23))
        else:
            output.append(float(little_integer(bytes)))
    return output

def ieee_float(data: list[int], exponent_bits: int, fraction_bits: int) -> float:
    encoded := little_integer(data)
    fraction_base := 1
    for _index in range(0, fraction_bits):
        fraction_base *= 2
    exponent_base := 1
    for _index in range(0, exponent_bits):
        exponent_base *= 2
    fraction = encoded % fraction_base
    encoded /= fraction_base
    exponent = encoded % exponent_base
    sign = -1.0 if encoded / exponent_base == 1 else 1.0
    bias = exponent_base / 2 - 1
    if exponent == 0:
        return sign * math.pow(2.0, float(1 - bias)) * float(fraction) / float(fraction_base)
    assert(exponent != exponent_base - 1, "PyTorch state contains a non-finite tensor value")
    return sign * math.pow(2.0, float(exponent - bias)) * (1.0 + float(fraction) / float(fraction_base))

def state_tensors(root: PickleValue, entries: list[archive.ZipEntry]) -> list[types.TensorValue]:
    assert(root.kind == "dict", "PyTorch weights root must be a state dictionary")
    output := []
    for index in range(0, size(root.items), 2):
        key = root.items[index]
        value = root.items[index + 1]
        if key.kind != "string" or value.kind != "tensor":
            continue
        count := 1
        for dimension in value.shape:
            count *= dimension
        storage = storage_entry(entries, value.storage_key)
        values = decode_storage(storage.data, value.dtype, value.offset, count)
        output.append(types.TensorValue(key.text, value.dtype, value.shape, values))
    return output

def infer_graph(parameters: list[types.TensorValue]) -> types.ModelGraph:
    nodes := []
    current := "input"
    input_width := -1
    output_width := -1
    for parameter in parameters:
        if parameter.name.ends_with(".weight") and size(parameter.shape) == 2:
            base = parameter.name[0:size(parameter.name) - 7]
            bias_name = base + ".bias"
            inputs = [current, parameter.name]
            if bias_name in parameters.map(|value| value.name):
                inputs.append(bias_name)
            output = base + ".output"
            nodes.append(types.GraphNode(base, "gemm", inputs, [output], "{}"))
            current = output
            if input_width < 0:
                input_width = parameter.shape[1]
            output_width = parameter.shape[0]
    if size(nodes) == 0:
        return failure(types.ModelLoadError("PyTorch state_dict has weights but no inferable linear architecture; load it into a declared Severian network"))
    return types.ModelGraph("pytorch_state_dict", [types.TensorValue("input", "f32", [-1, input_width], [])], [current], nodes, parameters)

def import_model(path: string) -> types.ModelGraph | types.ModelLoadError | IOError:
    entries = archive.zip_entries(path)
    pickle_entry: archive.ZipEntry := archive.ZipEntry("", [])
    found := false
    for entry in entries:
        if entry.name.ends_with("/data.pkl") or entry.name == "data.pkl":
            pickle_entry = entry
            found = true
    if not found:
        return failure(types.ModelLoadError("PyTorch archive contains no data.pkl state dictionary"))
    root = RestrictedUnpickler(archive.ByteReader(pickle_entry.data)).load()
    parameters = state_tensors(root, entries)
    return infer_graph(parameters)
