class Capability:
    name: string
    version: int = 1

class CapabilitySet:
    values: list[Capability]

    def supports(name: string, minimum_version: int = 1) -> bool:
        for capability in values:
            if capability.name == name and capability.version >= minimum_version:
                return true
        return false

    def require(name: string, minimum_version: int = 1) -> Result[unit, CapabilityError]:
        if not supports(name, minimum_version):
            return failure(CapabilityError(
                f"model does not provide capability `{name}` version {minimum_version}",
            ))
        return

class CapabilityError:
    message: string

# Namespaced, versioned strings keep the set open to architecture and plugin
# packages without turning every new generation strategy into a core enum edit.
def forward() -> Capability:
    return Capability("tensor.forward")

def text_generation() -> Capability:
    return Capability("text.generate")

def speech_generation() -> Capability:
    return Capability("audio.generate")

def audio_encode() -> Capability:
    return Capability("audio.codec.encode")

def audio_decode() -> Capability:
    return Capability("audio.codec.decode")

def masked_generation() -> Capability:
    return Capability("generation.masked_iterative")
