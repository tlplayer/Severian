import file
import json
import path
import "src/artifacts.sev" as artifacts
import "src/registry.sev" as registry
import "src/types.sev" as types

def dtype_width(dtype: string) -> Result[int, types.ModelLoadError]:
    if dtype in ["bool", "i8", "u8", "f8_e4m3", "f8_e4m3fn", "f8_e5m2"]:
        return 1
    if dtype in ["i16", "u16", "f16", "bf16"]:
        return 2
    if dtype in ["i32", "u32", "f32"]:
        return 4
    if dtype in ["i64", "u64", "f64", "c64"]:
        return 8
    if dtype == "c128":
        return 16
    return failure(types.ModelLoadError("unsupported safetensors dtype `" + dtype + "`"))

def header_tensors(shard_path: string) -> Result[list[types.TensorValue], types.ModelLoadError | IOError | JsonError]:
    handle = file.open(shard_path)
    prefix = file.read_exact(handle, 8)
    header_length = file.little_endian_u64(prefix)
    assert(header_length > 1 and header_length < 100000000, "invalid safetensors header length")
    header_text = file.utf8(file.read_exact(handle, header_length))
    _closed = file.close(handle)
    header: Any = json.decode[Any](header_text)
    data_start = 8 + header_length
    output := []
    for name in json.object_keys(header):
        if name == "__metadata__":
            continue
        metadata = json.object_get(header, name)
        dtype = json.as_string(json.object_get(metadata, "dtype")).lower()
        shape = json.as_int_list(json.object_get(metadata, "shape"))
        offsets = json.as_int_list(json.object_get(metadata, "data_offsets"))
        assert(size(offsets) == 2 and offsets[0] >= 0 and offsets[1] >= offsets[0])
        elements := 1
        for dimension in shape:
            elements *= dimension
        width = dtype_width(dtype)
        assert(offsets[1] - offsets[0] == elements * width, "safetensors byte range does not match shape/dtype")
        output.append(types.TensorValue(
            name,
            dtype,
            shape,
            [],
            path.absolute(shard_path),
            data_start + offsets[0],
            data_start + offsets[1],
        ))
    return output

def load_parameters(source: string) -> Result[list[types.TensorValue], types.ModelLoadError | IOError | JsonError]:
    if not path.is_dir(source):
        return header_tensors(source)
    index_path = path.join(source, "model.safetensors.index.json")
    if path.exists(index_path):
        index_text = file.read_text(index_path)
        index: Any = json.decode[Any](index_text)
        weight_map = json.object_get(index, "weight_map")
        shards = json.object_values(weight_map).map(|value| json.as_string(value)).unique().sorted()
        output := []
        for shard in shards:
            output.extend(header_tensors(path.join(source, shard)))
        return output
    return header_tensors(path.join(source, "model.safetensors"))

def attribute() -> Any:
    return json.decode[Any]("{}")

def parameter(parameters: list[types.TensorValue], name: string) -> Result[types.TensorValue, types.ModelLoadError]:
    for value in parameters:
        if value.name == name:
            return value
    return failure(types.ModelLoadError("checkpoint is missing required weight `" + name + "`"))

def validate_qwen_weights(config: Any, parameters: list[types.TensorValue], prefix: string) -> Result[unit, types.ModelLoadError]:
    hidden = json.as_int(json.object_get(config, "hidden_size"))
    layers = json.as_int(json.object_get(config, "num_hidden_layers"))
    embedding = parameter(parameters, prefix + "model.embed_tokens.weight")
    if size(embedding.shape) != 2 or embedding.shape[1] != hidden:
        return failure(types.ModelLoadError("Qwen embedding shape does not match hidden_size"))
    if embedding.dtype not in ["f8_e4m3", "f8_e4m3fn", "f8_e5m2", "f16", "bf16", "f32", "f64"]:
        return failure(types.ModelLoadError("Qwen weights require a floating-point dtype"))
    _norm = parameter(parameters, prefix + "model.norm.weight")
    for layer in range(0, layers):
        base = prefix + "model.layers." + string(layer)
        required = [
            base + ".input_layernorm.weight",
            base + ".self_attn.q_proj.weight",
            base + ".self_attn.k_proj.weight",
            base + ".self_attn.v_proj.weight",
            base + ".self_attn.o_proj.weight",
            base + ".post_attention_layernorm.weight",
            base + ".mlp.gate_proj.weight",
            base + ".mlp.up_proj.weight",
            base + ".mlp.down_proj.weight",
        ]
        for name in required:
            _weight = parameter(parameters, name)
    return

def qwen_graph(config: Any, parameters: list[types.TensorValue], prefix: string = "") -> types.ModelGraph:
    layers = json.as_int(json.object_get(config, "num_hidden_layers"))
    hidden = json.as_int(json.object_get(config, "hidden_size"))
    current := "embedded"
    nodes := [types.GraphNode("token_embedding", "embedding", [prefix + "model.embed_tokens.weight", "input_ids"], [current], attribute())]
    for layer in range(0, layers):
        layer_name = "model.layers." + string(layer)
        residual = current
        normalized = layer_name + ".attention_norm.output"
        nodes.append(types.GraphNode(layer_name + ".input_layernorm", "layer_norm", [current, prefix + layer_name + ".input_layernorm.weight"], [normalized], attribute()))
        query = layer_name + ".q"
        key = layer_name + ".k"
        value = layer_name + ".v"
        nodes.append(types.GraphNode(layer_name + ".q_proj", "matmul", [normalized, prefix + layer_name + ".self_attn.q_proj.weight"], [query], attribute()))
        nodes.append(types.GraphNode(layer_name + ".k_proj", "matmul", [normalized, prefix + layer_name + ".self_attn.k_proj.weight"], [key], attribute()))
        nodes.append(types.GraphNode(layer_name + ".v_proj", "matmul", [normalized, prefix + layer_name + ".self_attn.v_proj.weight"], [value], attribute()))
        key_transposed = layer_name + ".k_transposed"
        scores = layer_name + ".attention_scores"
        probabilities = layer_name + ".attention_probabilities"
        context = layer_name + ".attention_context"
        projected = layer_name + ".attention_output"
        nodes.append(types.GraphNode(layer_name + ".key_transpose", "transpose", [key], [key_transposed], attribute()))
        nodes.append(types.GraphNode(layer_name + ".attention_matmul", "matmul", [query, key_transposed], [scores], attribute()))
        nodes.append(types.GraphNode(layer_name + ".attention_softmax", "softmax", [scores], [probabilities], attribute()))
        nodes.append(types.GraphNode(layer_name + ".context", "matmul", [probabilities, value], [context], attribute()))
        nodes.append(types.GraphNode(layer_name + ".o_proj", "matmul", [context, prefix + layer_name + ".self_attn.o_proj.weight"], [projected], attribute()))
        attention_residual = layer_name + ".attention_residual"
        nodes.append(types.GraphNode(layer_name + ".attention_add", "add", [residual, projected], [attention_residual], attribute()))
        post_norm = layer_name + ".post_norm.output"
        nodes.append(types.GraphNode(layer_name + ".post_attention_layernorm", "layer_norm", [attention_residual, prefix + layer_name + ".post_attention_layernorm.weight"], [post_norm], attribute()))
        gate = layer_name + ".gate"
        up = layer_name + ".up"
        activated = layer_name + ".activated_gate"
        gated = layer_name + ".gated_up"
        down = layer_name + ".down"
        nodes.append(types.GraphNode(layer_name + ".gate_proj", "matmul", [post_norm, prefix + layer_name + ".mlp.gate_proj.weight"], [gate], attribute()))
        nodes.append(types.GraphNode(layer_name + ".up_proj", "matmul", [post_norm, prefix + layer_name + ".mlp.up_proj.weight"], [up], attribute()))
        nodes.append(types.GraphNode(layer_name + ".silu", "silu", [gate], [activated], attribute()))
        nodes.append(types.GraphNode(layer_name + ".gate_multiply", "multiply", [activated, up], [gated], attribute()))
        nodes.append(types.GraphNode(layer_name + ".down_proj", "matmul", [gated, prefix + layer_name + ".mlp.down_proj.weight"], [down], attribute()))
        current = layer_name + ".output"
        nodes.append(types.GraphNode(layer_name + ".mlp_add", "add", [attention_residual, down], [current], attribute()))
    normalized = "model.norm.output"
    logits = "logits"
    nodes.append(types.GraphNode("model.norm", "layer_norm", [current, prefix + "model.norm.weight"], [normalized], attribute()))
    output_weight = prefix + "lm_head.weight" if prefix + "lm_head.weight" in parameters.map(|value| value.name) else prefix + "model.embed_tokens.weight"
    nodes.append(types.GraphNode("lm_head", "matmul", [normalized, output_weight], [logits], attribute()))
    return types.ModelGraph("qwen", [types.TensorValue("input_ids", "i64", [-1, -1], [])], [logits], nodes, parameters)

def inferred_linear_graph(parameters: list[types.TensorValue]) -> Result[types.ModelGraph, types.ModelLoadError]:
    nodes := []
    current := "input"
    input_width := -1
    for parameter in parameters:
        if parameter.name.ends_with("weight") and size(parameter.shape) == 2:
            base = parameter.name[0:size(parameter.name) - 6]
            bias = base + "bias"
            inputs = [current, parameter.name]
            if bias in parameters.map(|value| value.name):
                inputs.append(bias)
            output = base + "output"
            nodes.append(types.GraphNode(base + "linear", "gemm", inputs, [output], attribute()))
            current = output
            if input_width < 0:
                input_width = parameter.shape[1]
    if size(nodes) == 0:
        return failure(types.ModelLoadError("safetensors file has no inferable architecture; load it into a declared network"))
    return types.ModelGraph("safetensors_linear", [types.TensorValue("input", "f32", [-1, input_width], [])], [current], nodes, parameters)

def import_model(source: string) -> Result[types.ModelGraph, types.ModelLoadError | IOError | JsonError]:
    parameters = load_parameters(source)
    directory = source if path.is_dir(source) else path.dirname(source)
    config_path = path.join(directory, "config.json")
    if path.exists(config_path):
        config_text = file.read_text(config_path)
        config: Any = json.decode[Any](config_text)
        architecture = registry.resolve(config)
        if architecture.family in ["qwen2", "qwen3", "qwen2_moe"]:
            prefix = registry.infer_weight_prefix(parameters, "model.embed_tokens.weight")
            _valid = validate_qwen_weights(architecture.config, parameters, prefix)
            graph = qwen_graph(architecture.config, parameters, prefix)
            graph.name = architecture.name
            return graph
    return inferred_linear_graph(parameters)
