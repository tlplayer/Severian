import file
import json
import "src/archive.sev" as archive
import "src/types.sev" as types

def field(object: Any, name: string, fallback: Any) -> Any:
    return json.object_get(object, name) if name in json.object_keys(object) else fallback

def integer_pair(value: Any, fallback: int) -> list[int]:
    if json.kind(value) == "integer":
        return [json.as_int(value), json.as_int(value)]
    if json.kind(value) == "array":
        return json.as_int_list(value)
    return [fallback, fallback]

def activation_node(name: string, activation: string, input_name: string) -> list[types.GraphNode]:
    if activation in ["", "linear"]:
        return []
    supported = ["relu", "sigmoid", "tanh", "softmax", "gelu", "silu", "swish"]
    assert(activation in supported, "unsupported Keras activation: " + activation)
    operation = "silu" if activation in ["silu", "swish"] else activation
    return [types.GraphNode(name + "_activation", operation, [input_name], [name], json.decode[Any]("{}"))]

def import_layer(layer: Any, input_name: string) -> tuple[list[types.GraphNode], string]:
    class_name = json.as_string(json.object_get(layer, "class_name"))
    config = json.object_get(layer, "config")
    name = json.as_string(field(config, "name", class_name.lower()))
    attributes: Any = json.decode[Any]("{}")
    if class_name == "InputLayer":
        return ([], name)
    if class_name in ["Dense", "EinsumDense"]:
        json.object_set(attributes, "units", field(config, "units", 0))
        node = types.GraphNode(name + "_linear", "gemm", [input_name, name + "/kernel", name + "/bias"], [name + "_preactivation"], attributes)
        activation = json.as_string(field(config, "activation", "linear"))
        activated = activation_node(name, activation, name + "_preactivation")
        return ([node] + activated, name if size(activated) > 0 else name + "_preactivation")
    if class_name == "Embedding":
        return ([types.GraphNode(name, "embedding", [name + "/embeddings", input_name], [name], attributes)], name)
    if class_name in ["Conv1D", "Conv2D"]:
        dimensions = 1 if class_name == "Conv1D" else 2
        json.object_set(attributes, "strides", integer_pair(field(config, "strides", 1), 1)[0:dimensions])
        json.object_set(attributes, "padding", field(config, "padding", "valid"))
        operation = "conv1d" if dimensions == 1 else "conv2d"
        node = types.GraphNode(name + "_convolution", operation, [input_name, name + "/kernel", name + "/bias"], [name + "_preactivation"], attributes)
        activation = json.as_string(field(config, "activation", "linear"))
        activated = activation_node(name, activation, name + "_preactivation")
        return ([node] + activated, name if size(activated) > 0 else name + "_preactivation")
    if class_name in ["MaxPooling1D", "MaxPooling2D", "AveragePooling1D", "AveragePooling2D", "GlobalAveragePooling1D", "GlobalAveragePooling2D"]:
        operation = "max_pool1d" if class_name == "MaxPooling1D" else "max_pool2d" if class_name == "MaxPooling2D" else "avg_pool1d" if "1D" in class_name else "avg_pool2d"
        json.object_set(attributes, "pool_size", integer_pair(field(config, "pool_size", 2), 2))
        json.object_set(attributes, "global", class_name.starts_with("Global"))
        return ([types.GraphNode(name, operation, [input_name], [name], attributes)], name)
    if class_name in ["BatchNormalization", "LayerNormalization"]:
        operation = "batch_norm" if class_name == "BatchNormalization" else "layer_norm"
        json.object_set(attributes, "epsilon", field(config, "epsilon", 0.00001))
        inputs = [input_name, name + "/gamma", name + "/beta"]
        if operation == "batch_norm":
            inputs.extend([name + "/moving_mean", name + "/moving_variance"])
        return ([types.GraphNode(name, operation, inputs, [name], attributes)], name)
    if class_name == "Dropout":
        json.object_set(attributes, "rate", field(config, "rate", 0.5))
        return ([types.GraphNode(name, "dropout", [input_name], [name], attributes)], name)
    if class_name == "Flatten":
        return ([types.GraphNode(name, "flatten", [input_name], [name], attributes)], name)
    if class_name == "Reshape":
        json.object_set(attributes, "shape", field(config, "target_shape", []))
        return ([types.GraphNode(name, "reshape", [input_name], [name], attributes)], name)
    if class_name in ["ReLU", "Activation", "Softmax"]:
        activation = "relu" if class_name == "ReLU" else "softmax" if class_name == "Softmax" else json.as_string(field(config, "activation", "linear"))
        return (activation_node(name, activation, input_name), name)
    if class_name in ["Add", "Subtract", "Multiply", "Concatenate"]:
        operation = "add" if class_name == "Add" else "subtract" if class_name == "Subtract" else "multiply" if class_name == "Multiply" else "concat"
        return ([types.GraphNode(name, operation, [input_name], [name], attributes)], name)
    return failure(types.ModelLoadError("unsupported Keras layer: " + class_name))

def weight_container(entry: archive.ZipEntry) -> types.TensorValue:
    # HDF5 stays inert data. Dataset binding is performed from Keras layer paths;
    # no Python object or custom Keras code is deserialized.
    signature = entry.data[0:8]
    assert(signature == [137, 72, 68, 70, 13, 10, 26, 10], "Keras weight member is not HDF5")
    return types.TensorValue("__keras_hdf5_weights__", "u8", [size(entry.data)], entry.data.map(|byte| float(byte)))

def import_model(path: string) -> types.ModelGraph | types.ModelLoadError | IOError | JsonError:
    entries = archive.zip_entries(path)
    config_entry = archive.zip_entry(entries, "config.json")
    weights_entry = archive.zip_entry(entries, "model.weights.h5")
    config_text = file.utf8(config_entry.data)
    document: Any = json.decode[Any](config_text)
    model_config = json.object_get(document, "config")
    layers = json.as_list(json.object_get(model_config, "layers"))
    model_name = json.as_string(field(model_config, "name", "keras_model"))
    graph_inputs := []
    graph_nodes := []
    current := "input"
    for layer in layers:
        class_name = json.as_string(json.object_get(layer, "class_name"))
        layer_config = json.object_get(layer, "config")
        if class_name == "InputLayer":
            current = json.as_string(field(layer_config, "name", "input"))
            shape = json.as_int_list(field(layer_config, "batch_shape", []))
            graph_inputs.append(types.TensorValue(current, json.as_string(field(layer_config, "dtype", "f32")), shape, []))
            continue
        nodes, current = import_layer(layer, current)
        graph_nodes.extend(nodes)
    if size(graph_inputs) == 0:
        graph_inputs.append(types.TensorValue("input", "f32", [-1], []))
    graph = types.ModelGraph(model_name, graph_inputs, [current], graph_nodes, [weight_container(weights_entry)])
    return graph
