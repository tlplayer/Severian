import traits
import storage
import "iterator.sev"

class list[T]: traits.Sequence[T]
    storage: storage.ContiguousStorage[T]

    def list():
        this.storage := storage.create[T]()

    def len() -> usize:
        return storage.len()

    def empty() -> bool:
        return storage.len() == 0

    def capacity() -> usize:
        return storage.capacity()

    def reserve(minimum: usize):
        storage.reserve(minimum)

    def get(index: usize) -> T:
        return storage.get(index)

    def set(index: usize, value: T):
        storage.set(index, value)

    def append(value: T):
        storage.append(value)

    def insert(index: usize, value: T):
        storage.insert(index, value)

    def remove(index: usize) -> T:
        return storage.remove(index)

    def pop() -> T:
        assert(not empty(), "cannot pop from an empty list")
        return storage.remove(storage.len() - 1)

    def clear():
        storage.clear()

    def iter() -> traits.Iterator[T]:
        return ListIterator[T](borrow self, 0)


def with_capacity[T](capacity: usize) -> list[T]:
    values := list[T]()
    values.reserve(capacity)
    return values
