import platform

class Stat:
    path: string
    size: int
    modified_seconds: float
    is_file: bool
    is_directory: bool

def exists(path: string) -> bool:
    return platform.file_exists(path)

def stat(path: string) -> Result[Stat, IOError]:
    byte_size = platform.file_size_path(path)
    modified = platform.file_modified_seconds(path)
    return Stat(
        path,
        byte_size,
        modified,
        platform.path_is_file(path),
        platform.path_is_dir(path),
    )

def remove(path: string) -> Result[unit, IOError]:
    return platform.file_remove(path)

def rename(source: string, destination: string) -> Result[unit, IOError]:
    return platform.file_rename(source, destination)

def copy(source: string, destination: string) -> Result[unit, IOError]:
    return platform.file_copy(source, destination)

def list(path: string) -> Result[list[string], IOError]:
    return platform.directory_list(path)

def make_directories(path: string) -> Result[unit, IOError]:
    return platform.directory_make_all(path)

# Familiar command names and descriptive library names share the same behavior.
def ls(path: string) -> Result[list[string], IOError]:
    return list(path)

def mkdir(path: string) -> Result[unit, IOError]:
    return make_directories(path)

def rm(path: string) -> Result[unit, IOError]:
    return remove(path)

def mv(source: string, destination: string) -> Result[unit, IOError]:
    return rename(source, destination)

def cp(source: string, destination: string) -> Result[unit, IOError]:
    return copy(source, destination)

test "filesystem namespace and stat metadata":
    directory = "/tmp/severian-library-os"
    _created = make_directories(directory)
    assert(exists(directory))
    information = stat(directory)
    assert(information.is_directory)
    assert(not information.is_file)
    entries = list(directory)
    assert(size(entries) >= 0)
    aliases = ls(directory)
    assert(aliases == entries)

test "filesystem aliases copy, move, inspect, and remove files":
    directory = "/tmp/severian-library-os-aliases"
    _created = mkdir(directory)
    source = directory + "/source.txt"
    copied = directory + "/copied.txt"
    moved = directory + "/moved.txt"
    switch platform.file_write(source, "filesystem aliases"):
        ok:
            source_information = stat(source)
            assert(source_information.is_file)
            assert(not source_information.is_directory)
            assert(source_information.size == 18)
            _copied = cp(source, copied)
            assert(exists(copied))
            _moved = mv(copied, moved)
            assert(not exists(copied))
            assert(exists(moved))
            _removed_source = rm(source)
            _removed_moved = remove(moved)
            assert(not exists(source))
            assert(not exists(moved))
        failure error:
            assert(false, error)
