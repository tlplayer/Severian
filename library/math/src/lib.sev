import platform

def sqrt(value: float) -> float:
    return platform.math_sqrt(value)

def pow(value: float, exponent: float) -> float:
    return platform.math_pow(value, exponent)

def exp(value: float) -> float:
    return platform.math_exp(value)

def log(value: float) -> float:
    return platform.math_log(value)

def log2(value: float) -> float:
    return platform.math_log2(value)

def log10(value: float) -> float:
    return platform.math_log10(value)

def sin(value: float) -> float:
    return platform.math_sin(value)

def cos(value: float) -> float:
    return platform.math_cos(value)

def tan(value: float) -> float:
    return platform.math_tan(value)

def floor(value: float) -> int:
    return platform.math_floor(value)

def ceil(value: float) -> int:
    return platform.math_ceil(value)

def isfinite(value: float) -> bool:
    return platform.math_isfinite(value)

def isnan(value: float) -> bool:
    return platform.math_isnan(value)

def round(value: float, digits: int = 0) -> float:
    return platform.math_round(value, digits)

test "decimal rounding uses the requested precision":
    assert(round(1.23456, 3) == 1.235)

test "elementary functions cover exact identities and signed rounding":
    assert(sqrt(9.0) == 3.0)
    assert(pow(2.0, 3.0) == 8.0)
    assert(exp(0.0) == 1.0)
    assert(log(1.0) == 0.0)
    assert(log2(8.0) == 3.0)
    assert(log10(100.0) == 2.0)
    assert(sin(0.0) == 0.0)
    assert(cos(0.0) == 1.0)
    assert(tan(0.0) == 0.0)
    assert(floor(-1.25) == -2)
    assert(ceil(-1.25) == -1)
    assert(isfinite(42.0))
    assert(not isnan(42.0))
    assert(isnan(sqrt(-1.0)))
