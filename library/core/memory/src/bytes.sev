import allocate_buffer, buffer_index, load_buffer, store_buffer from "buffer_intrinsics.sev"


# The source equivalent of a zeroed physical allocation. Its descriptor stays
# visible to MLIR ownership; extracting an address does not transfer the owner.
def zeroed_bytes(count: int) -> array[u8]:
    assert(count >= 0)
    result: array[u8] = allocate_buffer(buffer_index(count))
    position := 0
    while position < count:
        store_buffer(u8(0), result, buffer_index(position))
        position += 1
    return result


# Resizing returns a new owner. The input is a view and remains valid until the
# caller replaces or drops its owner; MLIR handles that release and any aliases.
def resized_bytes(value: view array[u8], count: int) -> array[u8]:
    result = zeroed_bytes(count)
    position := 0
    while position < len(value) and position < count:
        store_buffer(load_buffer(value, buffer_index(position)), result, buffer_index(position))
        position += 1
    return result


test "zeroed byte allocations initialize every element":
    value = zeroed_bytes(3)
    assert(len(value) == 3)
    for position in range(3):
        assert(load_buffer(value, buffer_index(position)) == u8(0))
    assert(len(zeroed_bytes(0)) == 0)


test "resized bytes preserve the prefix and zero the extension":
    original = zeroed_bytes(2)
    store_buffer(u8(7), original, buffer_index(0))
    store_buffer(u8(9), original, buffer_index(1))
    grown = resized_bytes(original, 3)
    assert(len(grown) == 3)
    assert(load_buffer(grown, buffer_index(0)) == u8(7))
    assert(load_buffer(grown, buffer_index(1)) == u8(9))
    assert(load_buffer(grown, buffer_index(2)) == u8(0))
    shrunk = resized_bytes(original, 1)
    assert(len(shrunk) == 1)
    assert(load_buffer(shrunk, buffer_index(0)) == u8(7))
    assert(len(original) == 2)
    assert(load_buffer(original, buffer_index(1)) == u8(9))
