# Hosted raw-memory boundaries; typed buffers use the same target memory lowering.
@c(symbol="__sev_memory_zeroed")
def __raw_calloc(count: int, width: int) -> pointer

@c(symbol="__sev_memory_release")
def __raw_free(value: pointer)

@mlir("llvm.ptrtoint")
def __raw_integer(value: pointer) -> int

@mlir("llvm.inttoptr")
def __raw_pointer(value: int) -> pointer

@mlir("llvm.load")
def __raw_load[T](value: pointer) -> T

@mlir("llvm.store")
def __raw_store[T](value: T, destination: pointer)

@mlir("memref.extract_aligned_pointer_as_index")
def __raw_buffer_address[T](value: array[T]) -> index

@mlir("arith.index_cast")
def __raw_index(value: index) -> int

def __raw_allocate(count: int, width: int) -> pointer:
    assert(count >= 0)
    assert(width > 0)
    assert(count <= 9223372036854775807 / width)
    # A zero-element allocation still has a non-null identity that can be freed.
    result = __raw_calloc(count if count > 0 else 1, width)
    assert(__raw_integer(result) != 0)
    return result

def __raw_offset(base: pointer, offset: int) -> pointer:
    return __raw_pointer(__raw_integer(base) + offset)

def __raw_byte_offset(size: byte) -> int:
    bytes = size.amount / 8.0
    assert(bytes >= 0.0)
    assert(bytes < 9223372036854775808.0)
    result = int(bytes)
    assert(float(result) == bytes)
    return result


# A byte quantity requests physical storage; typed allocation still takes an
# integer element count and applies the element's layout exactly once.
def allocate(size: byte) -> pointer[u8]:
    unsafe:
        return allocate[u8](__raw_byte_offset(size))
