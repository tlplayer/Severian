import * from "ffi.sev"

e: f64 = 2.718281828459045


def floor(value: f64) -> int:
    return int(__floor(value))


def ceil(value: f64) -> int:
    return int(__ceil(value))


def round(value: f64, digits: int = 0) -> f64:
    factor = pow(10.0, float(digits))
    return __round(value * factor) / factor


def isnan(value: f64) -> bool:
    return value != value


def isfinite(value: f64) -> bool:
    return not isnan(value - value)
