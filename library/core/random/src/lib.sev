import "src/ffi.sev" as externs

def random() -> float:
    return externs.random()

def randint(start: int, stop: int) -> int:
    assert(stop >= start, "random integer stop must not precede start")
    return externs.randint(start, stop)

def uniform(start: float, stop: float) -> float:
    return start + (stop - start) * random()

def choice[T](values: list[T]) -> T:
    assert(size(values) > 0, "cannot choose from an empty list")
    return values[randint(0, size(values) - 1)]

def shuffle[T](values: list[T]):
    index := size(values) - 1
    while index > 0:
        other = randint(0, index)
        temporary = values[index]
        values[index] = values[other]
        values[other] = temporary
        index -= 1

def sample[T](values: list[T], count: int) -> list[T]:
    assert(count >= 0 and count <= size(values), "sample size is outside the list")
    selected = values[0:size(values)]
    shuffle(selected)
    return selected[0:count]

def seed(value: int):
    externs.seed(value)

test "seeded random helpers respect bounds membership and sample size":
    seed(12345)
    scalar = random()
    assert(scalar >= 0.0 and scalar < 1.0)
    integer = randint(3, 7)
    assert(integer >= 3 and integer < 7)
    decimal = uniform(-2.0, 4.0)
    assert(decimal >= -2.0 and decimal < 4.0)
    assert(choice([10, 20, 30]) in [10, 20, 30])
    values := [1, 2, 3, 4]
    shuffle(values)
    assert(values.sorted() == [1, 2, 3, 4])
    selected = sample([1, 2, 3, 4], 2)
    assert(size(selected) == 2)
    assert(selected[0] in [1, 2, 3, 4])
    assert(selected[1] in [1, 2, 3, 4])
    assert(selected[0] != selected[1])
