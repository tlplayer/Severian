{
  "package": {
    "name": "core.string.regex",
    "version": "0.1.0",
    "edition": "2026",
    "description": "Regular-expression compilation and matching",
    "unsafe": {
      "capabilities": [
        "c-abi"
      ],
      "sources": [
        "src/ffi.sev"
      ]
    },
