import "../../../../sev_compiler/syntax/primitive/char/utf8.sev" as encoding
import "../../collections/array/src/storage.sev" as arrays
import "../../collections/list/src/slice.sev" as _dependency_slice
import "core.sev" as utf8_core
import "../format/src/lib.sev" as formatting
import LiteralBinding, LiteralSyntax, MlirTypeBinding, PrimitiveId, StringPrimitive, TypeId from "../../../../sev_compiler/syntax/primitive/declarations.sev"
import Error from "../../../../sev_compiler/syntax/primitive/primitive.sev"

class UnicodeError: Error
    message: string

    def UnicodeError(value: string):
        message = value


class IndexError: Error
    message: string

    def IndexError(value: string):
        message = value


class ValueError: Error
    message: string

    def ValueError(value: string):
        message = value


class TypeConversionError: Error
    message: string

    def TypeConversionError(value: string):
        message = value


trait StringOperations:
    # Return the raw representation of the data in an array
    def encode[T: u8 | u32]() -> array[T]
    def ends_with(sub_string:string|char) -> bool
    def starts_with(sub_string:string|char) -> bool
    # Finds the index of sub_string within start/end
    def find(sub_string:string|char, start:int|absent = absent, end:int|absent = absent) -> int | None
    # ",".join(["a","b","c"]) -> "a,b,c"
    def join(iterable: list[string], conjunctor: string) -> string

    #Split a string by a substring "a,b,c".split(",")-> ["a","b","c"]
    def split[C=list[string]](separator: string | char | absent = absent) -> C
    def strip() -> string
    def is_digit() -> bool
    def is_alphabetic() -> bool
    def is_alphanumeric() -> bool
    def append(self: borrow Self, addition: string | char) -> borrow Self
    def remove(self: borrow Self, removed: string | char) -> borrow Self
    # Without indices [] or int "abc".without(1) -> "ac"
    def without(indices: int | list[int]) -> string
    # Returns if an object is in the string "a"|'a' in "apple"-> true
    operator in(self: Self, right: string) -> bool
    operator +(self: Self, right: string) -> string
    operator +=(self: borrow Self, right: string)


# Some strings for ctype-style character classification
WHITE_SPACE = " \t\n\r\v\f"
ASCII_LOWERCASE:string = "abcdefghijklmnopqrstuvwxyz"
ASCII_UPPERCASE:string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
ASCII_LETTERS:string = ASCII_LOWERCASE + ASCII_UPPERCASE
DIGITS = "0123456789"
HEXDIGITS = DIGITS + "abcdef" + "ABCDEF"
OCTDIGITS = "01234567"
PUNCTUATION = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
PRINTABLE = DIGITS + ASCII_LETTERS + PUNCTUATION + WHITE_SPACE


# Text owns a vector of encoding units. UTF-8 uses bytes; UTF-32 uses scalars.
# N is the initial number of NUL encoding units; strings can grow beyond N.
trait String: C
    def capacity() -> int
    def reserve(self: borrow Self, required: int)
    def resize(self: borrow Self, required: int)
    def character_count(self: view Self) -> int
    def byte_length(self: view Self) -> int


class string[T: u8 | u32 = u8, N = 32]: String + StringOperations
    identity: PrimitiveId = StringPrimitive().identity
    mlir: MlirTypeBinding = StringPrimitive().mlir
    id: TypeId = StringPrimitive().id
    token_kind: string = StringPrimitive().token_kind
    literal: LiteralSyntax | None = StringPrimitive().literal
    literal_family: string = StringPrimitive().literal_family
    literal_bindings: list[LiteralBinding] = StringPrimitive().literal_bindings

    storage: vector[char[T], N]

    def string():
        storage = vector[char[T], N]()
        resize(N)

    def string(buffer: move vector[char[T], N]):
        storage = move buffer
        position := 0
        while position < storage.used:
            codepoint = __decode(position)
            assert(encoding.valid(codepoint))
            position += __width(position)

    def capacity() -> int:
        return storage.capacity()

    def len(self: view Self) -> int:
        return storage.used

    def size(self: view Self) -> int:
        return len(self)

    def alignment(self: view Self) -> byte:
        return alignment[char[T]]()

    def bytes(self: view Self) -> byte:
        return bytes(storage)

    # Resize initialized encoding units, padding growth with NUL characters.
    # Shrinking UTF-8 must stop at a complete character boundary.
    def resize(self: borrow Self, required: int):
        assert(required >= 0)
        if required < storage.used:
            position := 0
            while position < required:
                position += __width(position)
            assert(position == required)
            storage.used = required
        else:
            reserve(required)
            while storage.used < required:
                storage.append(T(0))

    # Capacity is in encoding units; growth thresholds are always in bytes.
    # Double small allocations, then grow in 1024-byte steps.
    def reserve(self: borrow Self, required: int):
        assert(required >= 0)
        capacity := storage.capacity()
        if required <= capacity:
            return
        width = bytes(T).amount
        step = 1024 / width
        assert(required <= 9223372036854775807 / width)
        if capacity == 0:
            capacity = N
            if capacity == 0:
                capacity = 1
        while capacity < required and capacity < step:
            capacity *= 2
            if capacity > step:
                capacity = step
        if capacity < required:
            increments = (required - capacity - 1) / step + 1
            if increments > (9223372036854775807 / width - capacity) / step:
                capacity = required
            else:
                capacity += increments * step
        storage.reserve_exact(capacity)

    operator copy(self) -> Self:
        return string[T, N](storage.copy())

    operator string(self) -> string:
        result = string()
        position := 0
        while position < storage.used:
            codepoint = __decode(position)
            position += __width(position)
            result.append(encoding.from_codepoint(codepoint))
        return result

    def __unit(position: int) -> int:
        return int(storage.get(position))

    def __width(position: int) -> int:
        if bytes(T).amount == 4:
            return 1
        first = __unit(position)
        width := 0
        if first < 128:
            width = 1
        elif first >= 194 and first <= 223:
            width = 2
        elif first >= 224 and first <= 239:
            width = 3
        elif first >= 240 and first <= 244:
            width = 4
        assert(width > 0 and width <= storage.used - position)
        return width

    def __decode(position: int) -> int:
        first = __unit(position)
        width = __width(position)
        if width == 1:
            assert(encoding.valid(first))
            return first
        second = __unit(position + 1)
        if width == 2:
            return encoding.decode_two(first, second)
        third = __unit(position + 2)
        if width == 3:
            return encoding.decode_three(first, second, third)
        return encoding.decode_four(first, second, third, __unit(position + 3))

    def append(self: borrow Self, value: char) -> borrow Self:
        codepoint = encoding.codepoint(value)
        if bytes(T).amount == 4:
            reserve(storage.used + 1)
            storage.append(T(codepoint))
        else:
            width = encoding.width(codepoint)
            assert(storage.used <= 9223372036854775807 - width)
            reserve(storage.used + width)
            if width == 1:
                storage.append(T(codepoint))
            elif width == 2:
                storage.append(T(192 + codepoint / 64))
                storage.append(T(128 + codepoint % 64))
            elif width == 3:
                storage.append(T(224 + codepoint / 4096))
                storage.append(T(128 + (codepoint / 64) % 64))
                storage.append(T(128 + codepoint % 64))
            else:
                storage.append(T(240 + codepoint / 262144))
                storage.append(T(128 + (codepoint / 4096) % 64))
                storage.append(T(128 + (codepoint / 64) % 64))
                storage.append(T(128 + codepoint % 64))
        return self

    def append(self: borrow Self, value: string) -> borrow Self:
        count = value.storage.used
        if bytes(T).amount == 1:
            assert(storage.used <= 9223372036854775807 - count)
            reserve(storage.used + count)
            position := 0
            while position < count:
                storage.append(T(value.storage.get(position)))
                position += 1
            return self
        position := 0
        while position < count:
            codepoint = value.__decode(position)
            width = value.__width(position)
            append(encoding.from_codepoint(codepoint))
            position += width
        return self

    def __characters() -> list[int]:
        result: list[int] = []
        position := 0
        while position < storage.used:
            result.append(__decode(position))
            position += __width(position)
        return result

    def __pattern(value: string | char) -> list[int]:
        if value is char:
            return [encoding.codepoint(value)]
        else:
            return value.__characters()

    def __piece(values: list[int], start: int, end: int) -> string:
        result = string()
        for index in range(start, end):
            result.append(encoding.from_codepoint(values[index]))
        return result

    def __matches(values: list[int], pattern: list[int], start: int, end: int) -> bool:
        if start < 0 or start > end or len(pattern) > end - start:
            return false
        for index in range(int(len(pattern))):
            if values[start + index] != pattern[index]:
                return false
        return true

    # Transcode only initialized units, independently of reserved capacity.
    def encode[Unit: u8 | u32]() -> array[Unit]:
        converted = string[Unit]()
        for codepoint in __characters():
            converted.append(encoding.from_codepoint(codepoint))
        result = arrays.allocate[Unit](converted.storage.used)
        for index in range(converted.storage.used):
            arrays.write(result, index, Unit(converted.storage.get(index)))
        return result


    def starts_with(sub_string: string | char) -> bool:
        values = __characters()
        return __matches(values, __pattern(sub_string), 0, int(len(values)))

    def ends_with(sub_string: string | char) -> bool:
        values = __characters()
        pattern = __pattern(sub_string)
        return __matches(values, pattern, int(len(values)) - int(len(pattern)), int(len(values)))

    # Bounds are half-open character offsets; negative offsets count from end.
    def find(sub_string: string | char, start: int | absent = absent, end: int | absent = absent) -> int | None:
        values = __characters()
        pattern = __pattern(sub_string)
        count = int(len(values))
        first := 0
        last := count
        if start is int:
            first = start
            if first < 0:
                first = max(0, count + first)
        if end is int:
            last = end
            if last < 0:
                last = max(0, count + last)
            last = min(count, last)
        while first <= last:
            if __matches(values, pattern, first, last):
                return first
            first += 1
        return None

    def join(iterable: list[string], conjunctor: string) -> string:
        result = string()
        for index in range(int(len(iterable))):
            if index > 0:
                result.append(conjunctor)
            result.append(iterable[index])
        return result

    def join(iterable: list[string]) -> string:
        return join(iterable, __piece(__characters(), 0, int(len(__characters()))))

    # C must construct an empty container and support append(string).
    # Explicit separators preserve empty fields; whitespace splitting skips them.
    def split[C=list[string]](separator: string | char | absent = absent) -> C:
        result = C()
        for piece in __split(separator):
            result.append(piece)
        return result

    # The common list result does not require inferring a return-only generic.
    def split(separator: string | char | absent = absent) -> list[string]:
        return __split(separator)

    def __split(separator: string | char | absent) -> list[string]:
        values = __characters()
        result: list[string] = []
        count = int(len(values))
        first := 0
        position := 0
        if separator is absent:
            whitespace = __pattern(WHITE_SPACE)
            while position < count:
                while position < count and values[position] in whitespace:
                    position += 1
                first = position
                while position < count and values[position] not in whitespace:
                    position += 1
                if first < position:
                    result.append(__piece(values, first, position))
            return result
        pattern: list[int] := []
        if separator is string:
            pattern = __pattern(separator)
        elif separator is char:
            pattern = __pattern(separator)
        assert(len(pattern) > 0)
        while position < count:
            if __matches(values, pattern, position, count):
                result.append(__piece(values, first, position))
                position += int(len(pattern))
                first = position
            else:
                position += 1
        result.append(__piece(values, first, count))
        return result

    def is_digit() -> bool:
        return len(self) == 1 and self in DIGITS

    def is_alphabetic() -> bool:
        return len(self) == 1 and self in ASCII_LETTERS

    def is_alphanumeric() -> bool:
        return self.is_alphabetic() or self.is_digit()

    def strip() -> string:
        values = __characters()
        whitespace = __pattern(WHITE_SPACE)
        first := 0
        last := int(len(values))
        while first < last and values[first] in whitespace:
            first += 1
        while last > first and values[last - 1] in whitespace:
            last -= 1
        return __piece(values, first, last)

    def append(self: borrow Self, addition: string | char) -> borrow Self:
        if addition is char:
            return append(addition)
        else:
            return append(addition)

    # Snapshot both operands before mutation, including remove(self).
    # An empty pattern is a no-op; matches are removed without overlapping.
    def remove(self: borrow Self, removed: string | char) -> borrow Self:
        values = __characters()
        pattern = __pattern(removed)
        if len(pattern) == 0:
            return self
        storage.clear()
        position := 0
        count = int(len(values))
        while position < count:
            if __matches(values, pattern, position, count):
                position += int(len(pattern))
            else:
                append(encoding.from_codepoint(values[position]))
                position += 1
        return self

    # Negative indices count from end; duplicates and out-of-range indices
    # have no additional effect. The receiver remains unchanged.
    def without(indices: int | list[int]) -> string:
        values = __characters()
        selected: list[int] := []
        if indices is int:
            selected.append(indices)
        else:
            selected = indices
        count = int(len(values))
        omitted: list[int] = []
        for index in selected:
            omitted.append(count + index if index < 0 else index)
        result = string()
        for index in range(count):
            if index not in omitted:
                result.append(encoding.from_codepoint(values[index]))
        return result

    operator in(self: Self, right: string) -> bool:
        return right.find(__piece(__characters(), 0, int(len(__characters())))) != None

    operator +(self: Self, right: string) -> string:
        result = __piece(__characters(), 0, int(len(__characters())))
        result.append(right)
        return result

    operator +=(self: borrow Self, right: string):
        replacement = string[T, N](storage.copy())
        replacement.append(right)
        self = move replacement

    # len/size count encoding units; character_count counts Unicode scalars.
    def character_count(self: view Self) -> int:
        return int(len(__characters()))

    def byte_length(self: view Self) -> int:
        return storage.used * bytes(T).amount

    def empty(self: view Self) -> bool:
        return storage.used == 0

    operator if(self) -> self.storage.used != 0
    operator else(self) -> self.storage.used == 0

    def string(value: slice[u8]):
        storage = vector[char[T], N]()
        position := 0
        while position < int(value.len()):
            first = int(value[usize(position)])
            width = utf8_core.leading_width(first)
            if width == 0 or width > int(value.len()) - position:
                throw UnicodeError("invalid or truncated UTF-8 sequence")
            codepoint := first
            if width > 1:
                second = int(value[usize(position + 1)])
                if not utf8_core.continuation(second):
                    throw UnicodeError("invalid UTF-8 continuation byte")
                if width == 2:
                    codepoint = encoding.decode_two(first, second)
                else:
                    third = int(value[usize(position + 2)])
                    if not utf8_core.continuation(third):
                        throw UnicodeError("invalid UTF-8 continuation byte")
                    if width == 3:
                        codepoint = encoding.decode_three(first, second, third)
                    else:
                        fourth = int(value[usize(position + 3)])
                        if not utf8_core.continuation(fourth):
                            throw UnicodeError("invalid UTF-8 continuation byte")
                        codepoint = encoding.decode_four(first, second, third, fourth)
            if not encoding.valid(codepoint) or encoding.width(codepoint) != width:
                throw UnicodeError("invalid or overlong UTF-8 scalar")
            append(encoding.from_codepoint(codepoint))
            position += width

    def __from_literal[Count: usize](value: u8[Count]) -> string:
        result = string()
        for index in range(Count):
            result.storage.append(value[index])
        return result

    # Adopt the old UTF-8 boundary by decoding into the single owning vector.
    def __from_valid_utf8(memory: *[u8], byte_length: usize, length: usize) -> string:
        result = string()
        unsafe:
            for index in range(byte_length):
                result.storage.append(memory[index])
            free(memory)
        return result

    operator [](index: usize) -> char:
        values = __characters()
        if index >= usize(len(values)):
            throw IndexError("string character index out of range")
        return encoding.from_codepoint(values[int(index)])

    operator [](range: Range[usize]) -> string:
        values = __characters()
        if range.start > range.end or range.end > usize(len(values)):
            throw IndexError("string character slice out of range")
        return __piece(values, int(range.start), int(range.end))

    # UTF-8 byte access remains available even on a UTF-32 receiver.
    def byte(self: view Self, index: usize) -> u8:
        encoded = encode[u8]()
        if index >= usize(arrays.length(encoded)):
            throw IndexError("string byte index out of range")
        return arrays.read(encoded, int(index))

    def raw(self: view Self) -> StringView[char[T]]:
        return StringView[char[T]](view storage.data, storage.used)

    operator *(count: usize) -> string:
        result = string()
        piece = __piece(__characters(), 0, character_count())
        for repetition in range(count):
            result.append(piece)
        return result

    operator ==(right: string) -> bool:
        left_values = __characters()
        right_values = right.__characters()
        if len(left_values) != len(right_values):
            return false
        return __matches(left_values, right_values, 0, int(len(left_values)))

    operator !=(right: string) -> bool:
        return not (self == right)

    operator <(right: string) -> bool:
        left_values = __characters()
        right_values = right.__characters()
        for index in range(min(int(len(left_values)), int(len(right_values)))):
            if left_values[index] != right_values[index]:
                return left_values[index] < right_values[index]
        return len(left_values) < len(right_values)

    operator <=(right: string) -> bool:
        return self < right or self == right

    operator >(right: string) -> bool:
        return not (self <= right)

    operator >=(right: string) -> bool:
        return not (self < right)

    def contains(needle: string | char) -> bool:
        return find(needle) != None

    operator in(self) -> Iterator[char]:
        position := 0
        while position < storage.used:
            yield encoding.from_codepoint(__decode(position))
            position += __width(position)

    def clone(self: view Self) -> Self:
        return string[T, N](storage.copy())

    def hash(self: view Self) -> u64:
        encoded = encode[u8]()
        value: u64 = 14695981039346656037
        for index in range(arrays.length(encoded)):
            value ^= u64(arrays.read(encoded, index))
            value *= 1099511628211
        return value

    def print(self: view Self) -> string:
        return __piece(__characters(), 0, character_count())

    def from_integer[integer_type: int](value: integer_type, base: u8 = 10) -> string:
        if base < 2 or base > 36:
            throw ValueError(
                f"integer base {base} outside [2, 36]"
            )

        if value == 0:
            return "0"

        negative := integer_type.signed and value < 0

        magnitude: u128
        if negative:
            magnitude = u128(-(value + 1))
            magnitude += 1
        else:
            magnitude = value as u128

        digits := array[u8, 128]()
        count := 0

        while magnitude != 0:
            digit := u8(magnitude % u128(base))

            if digit < 10:
                digits[count] = u8('0') + digit
            else:
                digits[count] = u8('a') + (digit - 10)

            magnitude //= u128(base)
            count += 1

        total := count + (1 if negative else 0)

        unsafe:
            memory := allocate[u8](total)

            output := 0

            if negative:
                memory[0] = u8('-')
                output = 1

            for index in range(count):
                memory[output + index] = digits[count - index - 1]

        return string.__from_valid_utf8(
            move memory,
            total,
            total,
        )


    '''
    ## Integer parsing
    '''
    def parse_integer[integer_type: int](
        self,
        base: u8 = 10,
    ) -> integer_type | TypeConversionError:

        if base < 2 or base > 36:
            throw TypeConversionError(
                f"integer base {base} outside [2, 36]"
            )

        length = character_count()
        if length == 0:
            throw TypeConversionError("empty string is not an integer")

        index := 0
        negative := false

        if self[0] == '-':
            if not integer_type.signed:
                throw TypeConversionError(
                    f"negative value cannot convert to {integer_type}"
                )

            negative = true
            index = 1

        elif self[0] == '+':
            index = 1

        if index == length:
            throw TypeConversionError("sign without integer digits")

        value: u128 = 0

        while index < length:
            current := self[index]
            digit: u8

            if current >= '0' and current <= '9':
                digit = u8(current) - u8('0')

            elif current >= 'a' and current <= 'z':
                digit = u8(current) - u8('a') + 10

            elif current >= 'A' and current <= 'Z':
                digit = u8(current) - u8('A') + 10

            else:
                throw TypeConversionError(
                    f"invalid integer character '{current}'"
                )

            if digit >= base:
                throw TypeConversionError(
                    f"digit '{current}' is invalid for base {base}"
                )

            value = value * u128(base) + u128(digit)
            index += 1

        if negative:
            signed_value := -(i128(value))

            if signed_value < i128(integer_type.min) or signed_value > i128(integer_type.max):
                throw TypeConversionError(
                    f"'{self}' is outside {integer_type}[{integer_type.min}, {integer_type.max}]"
                )

            return signed_value as integer_type

        if value > u128(integer_type.max):
            throw TypeConversionError(
                f"'{self}' is outside {integer_type}[{integer_type.min}, {integer_type.max}]"
            )

        return value as integer_type


    '''
    ## Floating formatting

    Formatting uses the package formatter; its supported float widths and
    precision policy apply here as well.
    '''
    def from_float[float_type: float](value: float_type) -> string:
        return formatting.string(value)


    '''
    ## Floating parsing

    Parsing handles signs, fractions, decimal exponents, NaN, and infinity.
    '''
    def parse_float[float_type: float](self) -> float_type | TypeConversionError:
        if self == "nan":
            return mlir(arith.constant, "nan", to=float_type)

        if self == "inf" or self == "+inf":
            if not float_type.supports_infinity:
                throw TypeConversionError(
                    f"{float_type} does not represent infinity"
                )

            return mlir(arith.constant, "inf", to=float_type)

        if self == "-inf":
            if not float_type.supports_infinity:
                throw TypeConversionError(
                    f"{float_type} does not represent infinity"
                )

            return mlir(arith.constant, "-inf", to=float_type)

        length = character_count()
        if length == 0:
            throw TypeConversionError("empty string is not a float")

        index := 0
        negative := false

        if self[0] == '-':
            negative = true
            index = 1

        elif self[0] == '+':
            index = 1

        if index == length:
            throw TypeConversionError("sign without float digits")

        value := float_type(0.0)
        saw_digit := false

        while index < length and self[index] >= '0' and self[index] <= '9':
            value *= float_type(10.0)
            value += float_type(u8(self[index]) - u8('0'))
            index += 1
            saw_digit = true

        if index < length and self[index] == '.':
            index += 1
            place := float_type(0.1)

            while index < length and self[index] >= '0' and self[index] <= '9':
                value += float_type(u8(self[index]) - u8('0')) * place
                place *= float_type(0.1)
                index += 1
                saw_digit = true

        if not saw_digit:
            throw TypeConversionError(
                f"'{self}' contains no floating digits"
            )

        exponent: i32 = 0

        if index < length and (self[index] == 'e' or self[index] == 'E'):
            index += 1

            exponent_negative := false

            if index < length and self[index] == '-':
                exponent_negative = true
                index += 1

            elif index < length and self[index] == '+':
                index += 1

            if index == length:
                throw TypeConversionError("float exponent has no digits")

            while index < length and self[index] >= '0' and self[index] <= '9':
                exponent = exponent * 10 + i32(u8(self[index]) - u8('0'))
                index += 1

            if exponent_negative:
                exponent = -exponent

        if index != length:
            throw TypeConversionError(
                f"invalid float character '{self[index]}'"
            )

        if exponent > 0:
            for _ in range(usize(exponent)):
                value *= float_type(10.0)

        elif exponent < 0:
            for _ in range(usize(-exponent)):
                value /= float_type(10.0)

        if negative:
            value = -value

        return value




# A bounded read-only loan; unused vector capacity is never exposed.
class StringView[Unit]: C
    data: view array[Unit]
    count: int

    def StringView(value: view array[Unit], used: int):
        assert(used >= 0 and used <= arrays.length(value))
        data = view value
        count = used

    def len(self: view Self) -> int:
        return count

    def bytes(self: view Self) -> byte:
        return bytes[Self]()

    def alignment(self: view Self) -> byte:
        return alignment[Self]()

    operator [](index: int) -> Unit:
        assert(index >= 0 and index < count)
        return arrays.read(data, index)


extend string:

    operator <=>(self, T) -> T | TypeConversionError:

        self -> bytes:
            encoded = self.encode[u8]()
            result := bytes(arrays.length(encoded))

            for index in range(arrays.length(encoded)):
                result[index] = arrays.read(encoded, index)

            return result

        bytes ~> self:
            return string(bytes.slice())

        _ -> [T]:
            throw TypeConversionError(
                f"Failed to convert string to {type(T)}, no compatible conversion"
            )



test "UTF32 string encodes Unicode scalars as UTF8 bytes":
    value = string[u32]()
    value.append('A')
    value.append('λ')
    value.append('😀')
    encoded = value.encode[u8]()
    assert(arrays.length(encoded) == 7)
    expected: list[int] = [65, 206, 187, 240, 159, 152, 128]
    for index in range(7):
        assert(int(arrays.read(encoded, index)) == expected[index])
    assert(len(value) == 3)
    assert(value.size() == 3)


test "UTF8 string encodes Unicode scalars as UTF32 units":
    value = string[u8]()
    value.append("Aλ😀")
    encoded = value.encode[u32]()
    assert(arrays.length(encoded) == 3)
    assert(arrays.read(encoded, 0) == u32(65))
    assert(arrays.read(encoded, 1) == u32(955))
    assert(arrays.read(encoded, 2) == u32(128512))
    assert(len(value) == 7)
    assert(value.size() == 7)


test "string searches use character offsets and half open bounds":
    value = string()
    value.append("aλ😀λ")
    assert(value.starts_with('a'))
    assert(value.ends_with('λ'))
    assert(not value.ends_with("longer than the receiver"))
    assert(value.find('λ') == 1)
    assert(value.find('λ', 2) == 3)
    assert(value.find('λ', -1) == 3)
    assert(value.find('😀', 0, 2) == None)
    assert(value.find("", 4, 4) == 4)
    assert(value.find("", 5) == None)


test "string splitting preserves explicit empty fields and skips whitespace":
    value = string()
    value.append("λ,,😀,")
    pieces: list[string] = value.split(',')
    assert(len(pieces) == 4)
    assert(pieces[0].find('λ') == 0)
    assert(len(pieces[1]) == 0)
    assert(pieces[2].find('😀') == 0)
    assert(len(pieces[3]) == 0)
    padded = string()
    padded.append(" \tλ\n😀\r ")
    words: list[string] = padded.split()
    assert(len(words) == 2)
    assert(len(padded.strip()) == 7)
    separator = string()
    separator.append(',')
    joined = separator.join(words)
    assert(len(joined) == 7)
    assert(joined.find(',') == 1)


test "string removal and exclusion preserve scalar boundaries":
    value = string[u32]()
    value.append("λ😀λ😀")
    excluded = value.without([1, -1, 1, 99])
    assert(len(excluded) == 4)
    assert(excluded.starts_with('λ'))
    assert(len(value) == 4)
    value.remove('λ')
    assert(len(value) == 2)
    assert(value.starts_with('😀'))
    assert(value.size() == 2)
    value.remove("")
    assert(len(value) == 2)


test "string self append and concatenation retain their operands":
    value = string()
    value.append("λ😀")
    value.append(value)
    assert(len(value) == 12)
    combined = value + "!"
    assert(len(combined) == 13)
    assert(combined.ends_with('!'))
    assert(len(value) == 12)
    value.remove(value)
    assert(len(value) == 0)


test "empty string has zero lengths and false truth":
    value := ""

    assert(value.len() == 0)
    assert(value.byte_length() == 0)

    if value:
        throw Error("empty string must be false")


test "non-empty string is true":
    value := "hello"

    if value:
        assert(not value.empty())
    else:
        throw Error("non-empty string must be true")


test "ASCII length equals byte length":
    value := "hello"

    assert(value.len() == 5)
    assert(value.byte_length() == 5)


test "Unicode scalar length differs from byte length":
    value := "aλz"

    assert(value.character_count() == 3)
    assert(value.len() == 4)
    assert(value.byte_length() == 4)


test "string indexing uses Unicode scalar indices":
    value := "aλz"

    assert(value[0] == 'a')
    assert(value[1] == 'λ')
    assert(value[2] == 'z')

    throws(value[3])


test "byte access exposes UTF-8 representation":
    value := "λ"

    assert(value.byte_length() == 2)
    assert(value.byte(0) == 0xce)
    assert(value.byte(1) == 0xbb)


test "string slicing uses Unicode scalar boundaries":
    value := "aλbc"

    assert(value[0:2] == "aλ")
    assert(value[1:3] == "λb")
    assert(value[2:4] == "bc")


test "string concatenation creates a new value":
    left := "hello"
    right := " λ"

    combined := left + right

    assert(left == "hello")
    assert(right == " λ")
    assert(combined == "hello λ")


test "string repetition preserves UTF-8":
    assert("ab" * 3 == "ababab")
    assert("λ" * 3 == "λλλ")
    assert("x" * 0 == "")


test "string equality and ordering are lexical":
    assert("abc" == "abc")
    assert("abc" != "abd")
    assert("abc" < "abd")
    assert("abc" < "abcd")
    assert("λ" < "μ")


test "prefix suffix and contains inspect content":
    value := "severian"

    assert(value.starts_with("sev"))
    assert(value.ends_with("ian"))
    assert(value.contains("ver"))
    assert(not value.contains("xyz"))
    assert(value.contains(""))


test "string iteration yields Unicode scalar values":
    value := "aλz"

    result := array[char, 3]()
    index := 0

    for character in value:
        result[index] = character
        index += 1

    assert(result[0] == 'a')
    assert(result[1] == 'λ')
    assert(result[2] == 'z')


test "string clone owns independent storage":
    original := "hello"
    cloned := original.clone()

    drop original

    assert(cloned == "hello")


test "string bytes borrow does not own allocation":
    value := "hello"
    raw := value.raw()

    assert(raw.len() == 5)
    assert(raw[0] == u8('h'))

    drop raw

    assert(value == "hello")


test "integer formatting handles sign and bases":
    assert(string.from_integer[i32](0) == "0")
    assert(string.from_integer[i32](42) == "42")
    assert(string.from_integer[i32](-42) == "-42")
    assert(string.from_integer[u32](255, base=16) == "ff")


test "integer parsing validates target range":
    assert("42".parse_integer[i32]() == 42)
    assert("-42".parse_integer[i32]() == -42)
    assert("ff".parse_integer[u8](base=16) == 255)

    throws("256".parse_integer[u8]())
    throws("-1".parse_integer[u8]())
    throws("12x".parse_integer[i32]())


test "float parsing handles decimal and exponent":
    assert("3.5".parse_float[f64]() == f64(3.5))
    assert("-2.25".parse_float[f64]() == f64(-2.25))
    assert("1e3".parse_float[f64]() == f64(1000.0))
    assert("1e-2".parse_float[f64]() == f64(0.01))


test "float parsing handles IEEE special values":
    assert("nan".parse_float[f32]().is_nan())
    assert("inf".parse_float[f32]().is_infinite())
    assert("-inf".parse_float[f32]().is_infinite())


test "invalid UTF-8 bytes reject string construction":
    invalid := array[u8, 2]([0xc0, 0x80])

    throws(string(invalid[0:2]))


test "string converts to bytes and validates bytes on return":
    value := "λ"
    raw := value as bytes
    restored := raw as string

    assert(restored == value)


test with compiler "string does not expose character assignment":
    reject:
        value = "hello"
        value[0] = 'H'


test with compiler "borrowed string bytes cannot outlive string":
    reject:
        def invalid() -> StringView[char[u8]]:
            value := "hello"
            return value.raw()


test "ASCII character classification rejects empty and multiple characters":
    assert("7".is_digit() and not "".is_digit() and not "12".is_digit())
    assert("a".is_alphabetic() and "Z".is_alphabetic())
    assert("9".is_alphanumeric() and not "_".is_alphanumeric())
    assert(not "é".is_alphabetic())
