import "../../../../sev_compiler/syntax/primitive/char/utf8.sev" as character

# UTF-8 algorithms use core.string storage through ordinary source calls.
def __dimension(value: string, dimension: int) -> int:
    assert(dimension == 0)
    return len(value)


def _size[T](value: T) -> int:
    return int(value)


def _index(value: int) -> int:
    return value


def __byte_value(value: u8) -> int:
    return int(value)


def __character(value: int) -> char:
    return character.from_codepoint(value)


def byte_at(value: string, position: int) -> int:
    assert(position >= 0)
    assert(position < len(value))
    return int(value.storage.get(position))


test "string views count and address UTF-8 bytes":
    value = "aλ😀z"
    assert(len(value) == 8)
    assert(byte_at(value, 1) == 206)
    assert(byte_at(value, 2) == 187)
    assert(len("") == 0)


def continuation(value: int) -> bool:
    if value < 128:
        return false
    return value <= 191


def leading_width(first: int) -> int:
    if first < 0:
        return 0
    if first <= 127:
        return 1
    if first < 194:
        return 0
    if first <= 223:
        return 2
    if first <= 239:
        return 3
    if first <= 244:
        return 4
    return 0


def decode(value: string, offset: int) -> int:
    first = byte_at(value, offset)
    width = leading_width(first)
    assert(width > 0)
    assert(offset + width <= len(value))
    if width == 1:
        return first
    second = byte_at(value, offset + 1)
    assert(continuation(second))
    if width == 2:
        return character.decode_two(first, second)
    third = byte_at(value, offset + 2)
    assert(continuation(third))
    if width == 3:
        decoded = character.decode_three(first, second, third)
        assert(decoded >= 2048)
        assert(character.valid(decoded))
        return decoded
    fourth = byte_at(value, offset + 3)
    assert(continuation(fourth))
    decoded = character.decode_four(first, second, third, fourth)
    assert(decoded >= 65536)
    assert(character.valid(decoded))
    return decoded


def __count(value: string, offset: int) -> int:
    count := 0
    position := offset
    while position < len(value):
        codepoint = decode(value, position)
        position += character.width(codepoint)
        count += 1
    return count



def _offset(value: string, position: int, offset: int) -> int:
    assert(position >= 0)
    cursor := offset
    remaining := position
    while remaining > 0:
        codepoint = decode(value, cursor)
        cursor += character.width(codepoint)
        remaining -= 1
    return cursor


def character_at(value: string, position: int) -> char:
    assert(position >= 0)
    return __character(decode(value, _offset(value, position, 0)))


test "character indexing decodes each UTF-8 width":
    value = "aλ😀z"
    assert(len(value) == 8)
    assert(character.codepoint(character_at(value, 1)) == 955)
    assert(character.codepoint(character_at(value, 2)) == 128512)
    assert(len("") == 0)
    assert(len("中") == 3)
    assert(decode("中", 0) == 20013)


def __equal(left: string, right: string, offset: int) -> bool:
    assert(offset >= 0 and offset <= len(left))
    position := offset
    while position < len(left):
        if byte_at(left, position) != byte_at(right, position):
            return false
        position += 1
    return true


def equal(left: string, right: string) -> bool:
    if len(left) != len(right):
        return false
    return __equal(left, right, 0)


def not_equal(left: string, right: string) -> bool:
    return not equal(left, right)


test "equality compares bytes and lengths":
    assert(equal("aλ😀z", "aλ😀z"))
    assert(not_equal("aλ😀z", "aλ😃z"))
    assert(not_equal("a", "ab"))
    assert(equal("", ""))


def __copy(source: string, destination: borrow string, offset: int, position: int):
    cursor := position
    while cursor < len(source):
        destination.storage.set(offset + cursor, source.storage.get(cursor))
        cursor += 1


# The result owns new storage; arguments remain borrowed immutable views.
# The MLIR ownership pipeline tracks returned buffers and inserts deallocation.
def concat(left: string, right: string) -> string:
    left_size = len(left)
    right_size = len(right)
    assert(left_size <= 9223372036854775807 - right_size)
    size = left_size + right_size
    result = string[u8, size]()
    __copy(left, result, 0, 0)
    __copy(right, result, left_size, 0)
    return result


test "concatenation preserves borrowed inputs and snapshots":
    original = "a"
    value := concat(original, "λ")
    snapshot = value
    value = concat(value, "😀")
    assert(equal(original, "a"))
    assert(equal(snapshot, "aλ"))
    assert(equal(value, "aλ😀"))
    assert(equal(concat("", ""), ""))
    assert(equal(concat("", value), value))
    assert(equal(concat(value, ""), value))
