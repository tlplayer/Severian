trait Bits[T]:
    operator |(a: T, b: T) -> T
    operator &(a: T, b: T) -> T
    operator ^(a: T, b: T) -> T

def bit_or(left: int, right: int) -> int:
    return left | right

def bit_and(left: int, right: int) -> int:
    return left & right

def bit_xor(left: int, right: int) -> int:
    return left ^ right

test "integer bit algebra is available by T":
    assert(bit_or(5, 3) == 7)
    assert(bit_and(6, 3) == 2)
    assert(bit_xor(5, 3) == 6)


test with compiler "bitwise algebra is declared by integer primitives":
    reject:
        value = 1.0 ^ 2.0

    reject:
        value = true & false
