trait char: Primitive:
    property category: string = "character"
    property representation: string = "unicode-scalar"
    property default_literal: bool = true

    operator ==(right: char) -> bool
    operator !=(right: char) -> bool
    operator <(right: char) -> bool
    operator <=(right: char) -> bool
    operator >(right: char) -> bool
    operator >=(right: char) -> bool
