import "bool.sev" as boolean
import "char.sev" as character
import "integers.sev" as integers
import "floats.sev" as floats
import "string.sev" as text
import "bytes.sev" as byte_string
import "none.sev" as absence
import "unit.sev" as unit_value
import "args.sev" as program_arguments
import "measured.sev" as measured_values
import "error.sev" as errors


# The compiler discovers primitive declarations by this composed trait. The
# properties form the bootstrap protocol; they are data, not ordinary runtime
# fields and are read before user semantic analysis starts.
trait Primitive:
    property category: string
    property representation: string
    property bits: int = 0
    property signed: bool = false
    property default_literal: bool = false
