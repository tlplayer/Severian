trait string: Primitive:
    property category: string = "text"
    property representation: string = "string"
    property default_literal: bool = true

    operator +(right: string) -> string
    operator ==(right: string) -> bool
    operator !=(right: string) -> bool
    operator <(right: string) -> bool
    operator <=(right: string) -> bool
    operator >(right: string) -> bool
    operator >=(right: string) -> bool
