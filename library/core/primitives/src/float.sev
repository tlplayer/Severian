trait Floating[T]:
    operator +(right: T) -> T
    operator -(right: T) -> T
    operator *(right: T) -> T
    operator /(right: T) -> T
    operator %(right: T) -> T
    operator **(right: T) -> T


trait float: Primitive + Floating[float]:
    property kind: string = "float"
    property default: bool = true


trait f32: Primitive + Floating[f32]:
    property kind: string = "float"


trait f64: Primitive + Floating[f64]:
    property kind: string = "float"