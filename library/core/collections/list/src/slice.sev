import * from "list.sev"

class slice[T]: C
    owner: borrow list[T]
    offset: usize
    length: usize

    def slice(values: borrow list[T], start: usize, count: usize):
        assert(start <= values.len())
        assert(count <= values.len() - start)
        owner = borrow values
        offset = start
        length = count

    def len(self: view Self) -> int:
        return int(length)

    # A view consumes its descriptor; the borrowed allocation belongs to owner.
    def bytes(self: view Self) -> byte:
        return bytes[Self]()

    def alignment(self: view Self) -> byte:
        return alignment[Self]()

    def get(index: usize) -> borrow T:
        assert(index < length)
        return owner.get(offset + index)

    def set(index: usize, item: T):
        assert(index < length)
        owner.set(offset + index, item)

    operator [](index: usize) -> borrow T:
        return get(index)

    operator []=(index: usize, item: T):
        set(index, item)
