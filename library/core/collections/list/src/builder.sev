import Container from "../../traits/src/container.sev"
import * from "list.sev"


class ListBuilder[T]: Container
    values: list[T]

    def ListBuilder(capacity: usize):
        this.values := with_capacity[T](capacity)

    def push(item: T):
        values.append(item)

    def bytes(self: view Self) -> byte:
        return values.bytes()

    def alignment(self: view Self) -> byte:
        return values.alignment()

    def len(self: view Self) -> int:
        return int(values.len())

    def finish() -> list[T]:
        return move values


def builder[T](capacity: usize = 0) -> ListBuilder[T]:
    return ListBuilder[T](capacity)
