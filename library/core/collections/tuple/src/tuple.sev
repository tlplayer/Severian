
# This should use grammars because tuples are (...)
trait TupleSyntax: G
    symbol: Y = "("
    form: GrammarForm = GrammarForm.Delimited
    closing: string = ")"
    separator: string = ","
    grouping: bool = true
    constructs: Y = tuple



class tuple[...T]: C
    items: ...T

    def len(self: view Self) -> int:
        return int(len(items))

    def bytes(self: view Self) -> byte:
        return bytes[Self]()

    def alignment(self: view Self) -> byte:
        return alignment[Self]()

    operator string() -> string:
        result := "("
        separator := ""
        for item in self.items:
            result = result + separator + string(item)
            separator = ","
        if len(self.items) == 1:
            result = result + ","
        return result + ")"
