import storage



'''
# `numeric_vector[T, N]`

`numeric_vector` is Severian's fixed-width numeric value collection.

It is distinct from `list[T]`:

```text
list[T]       runtime-sized owned sequence
array[T, N]   fixed-size general storage
numeric_vector[T, N]  fixed-lane arithmetic value
```

Type parameters:

```text
T    scalar lane type
N    compile-time lane count
```

`T` must satisfy the arithmetic lane contract. `N` is part of the type.

A backend may lower a numeric_vector directly to an MLIR numeric_vector type when the active
target supports the lane shape. The source contract remains valid when lowering
falls back to scalar operations.

## Truth

`numeric_vector` intentionally does not implement `Truth`. Multi-lane truth would be
ambiguous: `any`, `all`, and lane-zero semantics are different operations.
Callers must state the reduction they want.

## Operators

Vector-numeric_vector arithmetic is lane-wise:

```text
[a, b] + [c, d] = [a+c, b+d]
[a, b] - [c, d] = [a-c, b-d]
[a, b] * [c, d] = [a*c, b*d]
[a, b] / [c, d] = [a/c, b/d]
```

Vector-scalar multiplication and division broadcast the scalar to every lane.
`dot` performs multiply-then-sum and returns one `T`.
'''


trait VectorScalar:
    Copy
    Default

    # default() must be the additive identity (zero), including custom scalars.
    operator +(right: Self) -> Self
    operator -(right: Self) -> Self
    operator *(right: Self) -> Self
    operator /(right: Self) -> Self


trait Vector[T: VectorScalar, N: usize]:
    property length: usize

    operator [](index: usize) -> T
    operator []=(index: usize, value: T)

    operator +(right: numeric_vector[T, N]) -> numeric_vector[T, N]
    operator -(right: numeric_vector[T, N]) -> numeric_vector[T, N]
    operator *(right: numeric_vector[T, N]) -> numeric_vector[T, N]
    operator /(right: numeric_vector[T, N]) -> numeric_vector[T, N]

    operator *(right: T) -> numeric_vector[T, N]
    operator /(right: T) -> numeric_vector[T, N]

    def len(self) -> usize
    def sum(self) -> T
    def dot(self, right: numeric_vector[T, N]) -> T
    def length_squared(self) -> T
    def map[R: VectorScalar](self, operation: F[T, R]) -> numeric_vector[R, N]
    def copy(self) -> numeric_vector[T, N]
    def iter(self) -> Iterator[T]


class numeric_vector[T: VectorScalar, N: usize]:
    trait Vector[T, N]

    __values: array[T]
    length: usize = N


    def numeric_vector():
        __values = storage.allocate[T](int(N))
        for index in range(N):
            __values[index] = T.default()


    def numeric_vector(values: array[T, N]):
        __values = storage.allocate[T](int(N))
        for index in range(N):
            __values[index] = values[index]


    def len(self) -> usize:
        return N


    operator [](index: usize) -> T:
        return __values[index]


    operator []=(index: usize, value: T):
        __values[index] = value


    operator +(right: numeric_vector[T, N]) -> numeric_vector[T, N]:
        result := numeric_vector[T, N]()

        for index in range(N):
            result[index] = self[index] + right[index]

        return result


    operator -(right: numeric_vector[T, N]) -> numeric_vector[T, N]:
        result := numeric_vector[T, N]()

        for index in range(N):
            result[index] = self[index] - right[index]

        return result


    operator *(right: numeric_vector[T, N]) -> numeric_vector[T, N]:
        result := numeric_vector[T, N]()

        for index in range(N):
            result[index] = self[index] * right[index]

        return result


    operator /(right: numeric_vector[T, N]) -> numeric_vector[T, N]:
        result := numeric_vector[T, N]()

        for index in range(N):
            result[index] = self[index] / right[index]

        return result


    operator *(right: T) -> numeric_vector[T, N]:
        result := numeric_vector[T, N]()

        for index in range(N):
            result[index] = self[index] * right

        return result


    operator /(right: T) -> numeric_vector[T, N]:
        result := numeric_vector[T, N]()

        for index in range(N):
            result[index] = self[index] / right

        return result


    def sum(self) -> T:
        total := T.default()

        for index in range(N):
            total = total + self[index]

        return total


    def dot(self, right: numeric_vector[T, N]) -> T:
        total := T.default()

        for index in range(N):
            total = total + self[index] * right[index]

        return total


    def length_squared(self) -> T:
        return dot(self)


    def map[R: VectorScalar](self, operation: F[T, R]) -> numeric_vector[R, N]:
        result := numeric_vector[R, N]()

        for index in range(N):
            result[index] = operation(self[index])

        return result


    def copy(self) -> numeric_vector[T, N]:
        result := numeric_vector[T, N]()

        for index in range(N):
            result[index] = self[index]

        return result


    def iter(self) -> Iterator[T]:
        for index in range(N):
            yield self[index]


'''
# Executable specification
'''


test "numeric_vector length is part of its type and value contract":
    values := numeric_vector[i32, 4](array[i32, 4]([1, 2, 3, 4]))

    assert(values.len() == 4)
    assert(values[0] == 1)
    assert(values[3] == 4)


test "numeric_vector arithmetic is lane wise":
    left := numeric_vector[i32, 3](array[i32, 3]([1, 2, 3]))
    right := numeric_vector[i32, 3](array[i32, 3]([4, 5, 6]))

    sum := left + right
    product := left * right

    assert(sum[0] == 5)
    assert(sum[1] == 7)
    assert(sum[2] == 9)

    assert(product[0] == 4)
    assert(product[1] == 10)
    assert(product[2] == 18)


test "numeric_vector scalar multiplication broadcasts":
    values := numeric_vector[i32, 3](array[i32, 3]([1, 2, 3]))
    scaled := values * 4

    assert(scaled[0] == 4)
    assert(scaled[1] == 8)
    assert(scaled[2] == 12)


test "numeric_vector reductions are explicit":
    left := numeric_vector[i32, 3](array[i32, 3]([1, 2, 3]))
    right := numeric_vector[i32, 3](array[i32, 3]([4, 5, 6]))

    assert(left.sum() == 6)
    assert(left.dot(right) == 32)
    assert(left.length_squared() == 14)


test "numeric_vector map preserves lane count while changing scalar type":
    values := numeric_vector[i32, 3](array[i32, 3]([1, 2, 3]))
    operation = lambda value: f64(value) * 2.0
    doubled := values.map(operation)

    assert(doubled.len() == 3)
    assert(doubled[0] == 2)
    assert(doubled[2] == 6)


test with compiler "numeric_vector lane count is part of the type":
    reject:
        small := numeric_vector[i32, 2]()
        large: numeric_vector[i32, 4] = small


test with compiler "numeric_vector does not have implicit truth":
    reject:
        values := numeric_vector[i32, 2](array[i32, 2]([1, 0]))

        if values:
            assert(true)


test "numeric_vector empty reductions and copy independence":
    empty := numeric_vector[i32, 0]()
    assert(empty.len() == 0)
    assert(empty.sum() == 0)
    assert(empty.dot(empty) == 0)
    values := numeric_vector[i32, 1](array[i32, 1]([7]))
    copied := values.copy()
    copied[0] = 9
    assert(values[0] == 7)
    assert(values.length_squared() == 49)
