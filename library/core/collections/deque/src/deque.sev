import storage


class deque[T]:
    storage: storage.RingStorage[T]

    def deque(capacity: usize = 0):
        this.storage := storage.RingStorage[T](capacity)

    def len() -> usize:
        return storage.len()

    def empty() -> bool:
        return storage.empty()

    def capacity() -> usize:
        return storage.capacity()

    def reserve(minimum: usize):
        storage.reserve(minimum)

    def front() -> borrow T:
        assert(not empty(), "cannot read the front of an empty deque")
        return storage.get(0)

    def back() -> borrow T:
        assert(not empty(), "cannot read the back of an empty deque")
        return storage.get(len() - 1)

    def push_front(item: T):
        storage.push_front(item)

    def push_back(item: T):
        storage.push_back(item)

    def pop_front() -> T | None:
        if empty():
            return None
        return storage.pop_front()

    def pop_back() -> T | None:
        if empty():
            return None
        return storage.pop_back()

    def get(index: usize) -> borrow T:
        return storage.get(index)

    def clear():
        storage.clear()

    def set(index: usize, item: T):
        storage.set(index, item)

    def cap() -> usize:
        return capacity()

    operator [](index: usize) -> borrow T:
        return get(index)

    operator []=(index: usize, item: T):
        set(index, item)

    def iter():
        for index in range(len()):
            yield get(index)

    def copy(self: view Self) -> Self:
        result := deque[T](capacity())
        for index in range(len()):
            result.push_back(copy get(index))
        return result

    operator if(self) -> bool:
        return not empty()
