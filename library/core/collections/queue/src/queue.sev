import Container from "../../traits/src/container.sev"
import deque


class queue[T]: Container
    values: deque.deque[T]

    def queue(capacity: usize = 0):
        this.values := deque.deque[T](capacity)

    def bytes(self: view Self) -> byte:
        return values.bytes()

    def alignment(self: view Self) -> byte:
        return values.alignment()

    def len(self: view Self) -> int:
        return int(values.len())

    def empty() -> bool:
        return values.empty()

    def enqueue(item: T):
        values.push_back(item)

    def front() -> borrow T | None:
        if empty():
            return None
        return values.front()

    def dequeue() -> T | None:
        return values.pop_front()

    def clear():
        values.clear()
