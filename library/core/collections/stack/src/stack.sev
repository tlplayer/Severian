import storage


class stack[T]: C
    storage: storage.ContiguousStorage[T]

    def stack(capacity: usize = 0):
        this.storage := storage.create[T](capacity)

    def bytes(self: view Self) -> byte:
        return storage.bytes()

    def alignment(self: view Self) -> byte:
        return storage.alignment()

    def len(self: view Self) -> int:
        return int(storage.len())

    def empty() -> bool:
        return storage.empty()

    def push(item: T):
        storage.append(item)

    def peek() -> borrow T | None:
        if empty():
            return None
        return storage.get(len() - 1)

    def pop() -> T | None:
        if empty():
            return None
        return storage.remove(len() - 1)

    def clear():
        storage.clear()
