test "primitive iteration retains the typed element contract":
    text = "AB"
    total = 0
    cursor: iterator[u8] = text.iter()
    for byte in cursor:
        total += int(byte)
    assert(total == 131)

test "utilities delegate to the container implementation":
    class OffsetCounts[T]: C[int,T]
        grammar truth["bool", "(", self, ")"]() -> bool:
            return self.len() != 0

        storage: list[T]

        def len(self: view Self) -> int:
            return storage.len()
        def get(self: view Self, index: int) -> T:
            return storage.get(index)
        def keys(self: view Self) -> list[int]:
            return storage.keys()
        def values(self: view Self) -> list[T]:
            return storage.values()
        def items(self: view Self) -> list[tuple[int,T]]:
            return storage.items()
        def enumerate(self: view Self) -> list[tuple[int,T]]:
            return enumerate(storage, 10)
        def sum(self: view Self) -> T:
            return storage.sum().add(T(1))

        grammar indexed[self, "[", key: int, "]"]() -> T:
            return self.get(key)
        grammar iterate["iterator", "(", self, ")"]() -> iterator[T]:
            for value in self.storage:
                yield value

    source: list[int] = [34,8]
    container = OffsetCounts[int](source)
    assert(sum(container) == 43)
    assert(enumerate(container).get(0)[0] == 10)
    assert(items(container).get(0)[0] == 0)
    assert(not container.empty())

test "primitive for and iterator use the same library traversal":
    source = tensor[int](tuple[int,2](34,8))
    total = 0
    for value in source:
        total += value
    assert(total == 42)
    cursor = iterator(source)
    assert(next(cursor).value == 34)
    assert(next(cursor).value == 8)
    assert(next(cursor) == None)

test "multidimensional strided enumeration follows logical element order":
    grid = tensor[int,(2,3)]()
    grid[0,0] = 10
    grid[0,2] = 20
    grid[1,0] = 5
    grid[1,2] = 7
    subset = grid.slice(tuple[int,2](0,0), tuple[int,2](2,3), tuple[int,2](1,2))
    assert(sum(subset) == 42)
    pairs = enumerate(subset)
    assert(pairs.len() == 4)
    assert(pairs.get(1)[1] == 20 and pairs.get(3)[1] == 7)

test with compiler "primitive iterators retain their source lifetime":
    reject "borrow":
