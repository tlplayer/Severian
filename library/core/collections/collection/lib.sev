test "nested list pop transfers all nested owned storage":
    inner: list[string] = ["kept"]
    outer = list[list[string]]()
    outer.append(inner)
    drop(inner)
    popped = outer.pop()
    drop(outer)
    assert(popped.get(0) == "kept")

test "dictionary values and items preserve nested owners":
    inner: list[string] = ["kept"]
    dictionary = dict[string,list[string]]()
    dictionary.set("first", inner)
    snapshot = dictionary.values()
    pairs = dictionary.items()
    drop(dictionary)
    drop(inner)
    saved = snapshot.get(0)
    assert(saved.get(0) == "kept")
    pair = pairs.get(0)
    assert(pair[0] == "first")
    assert(pair[1].get(0) == "kept")

test "Numeric sum releases each previous owning accumulator":
    class Amount: Numeric
        label: string
        value: int

        def zero() -> Self:
            return Amount("zero", 0)

        def add(other: Self) -> Self:
            return Amount("sum", value + other.value)

    parts = list[Amount]()
    parts.append(Amount("first",34))
    parts.append(Amount("second",8))
    total = sum(parts)
    drop(parts)
    assert(total.value == 42 and total.label == "sum")
    empty = list[Amount]()
    zero = sum(empty)
    assert(zero.value == 0 and zero.label == "zero")

test "list insertion removal and slices retain independent owning strings":
    words: list[string] = ["first", "last"]
    words.reserve(8)
    assert(words.capacity() >= 8 and words.len() == 2)
    words.insert(1, "middle")
    words.insert(0, "start")
    words.insert(words.len(), "end")
    assert(words.len() == 5)
    removed = words.remove(2)
    snapshot = words.slice(1, 3)
    words.clear()
    assert(words.empty() and words.capacity() >= 8)
    words.append("reused")
    drop(words)
    assert(removed == "middle")
    assert(snapshot.get(0) == "first" and snapshot.get(1) == "last")

test "list insert and remove preserve scalar order at both ends":
    values: list[int] = [10, 30]
    values.insert(1, 20)
    values.insert(3, 40)
    assert(values.remove(0) == 10)
    assert(values.pop() == 40)
    assert(values.get(0) == 20 and values.get(1) == 30)
    assert(values.slice(1, 1).empty())

test "list insertion rejects indices beyond its initialized prefix":
    throws "list insertion index outside initialized storage":
        values = list[string]()
        values.reserve(8)
        values.insert(1, "invalid")

test "list removal rejects negative indices":
    throws "list removal index outside initialized storage":
        values: list[int] = [42]
        values.remove(-1)


test "consuming append transfers the caller's owner":
    words = list[string]()
    value = "transferred"
    words.append_owned(value)
    assert(words.get(0) == "transferred")

test with compiler "consuming append rejects subsequent use":
    reject "moved":
