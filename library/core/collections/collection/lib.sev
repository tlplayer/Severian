            return text.iter()

test "enumeration offsets work through C without a mutation requirement":
    text = "AB"
    bytes: list[tuple[int,u8]] = enumerate(text, 5)
    assert(bytes.get(0)[0] == 5 and bytes.get(1)[1] == u8(66))
    source = tensor[int](tuple[int,2](34,8))
    pairs = enumerate(source, -2)
    assert(pairs.get(0)[0] == -2 and pairs.get(1)[0] == -1)
    keyed: dict[int,string] = {10:"ten"}
    shifted = enumerate(keyed, 3)
    assert(shifted.get(0)[0] == 13)

test "hash and equality accept signed integer boolean and character keys":
    negative = -42
    duplicate = -42
    assert(negative.hash() == duplicate.hash())
    wide = i128(18446744073709551616)
    assert(wide.hash() == usize(1))
    flags: dict[bool,int] = {true:34,false:8}
    assert(sum(flags) == 42)
    letters: map[char,int] = {'a':34,'b':8}
    assert(sum(letters) == 42)
    letters.set('a',10)
    assert(letters.get('a') == 10 and letters.len() == 2)

