        assert(len(value) == 11)

test "any storage retains values through replacement and copying":
    values = list[any]()
    values.append(42)
    values.append("retained")
    values.append(true)
    saved = copy values
    values.set(0, "replacement")
    drop(values)
    assert(saved.get(0) == 42)
    assert(saved.get(0) != true)
    assert(saved.get(1) == "retained")
    assert(saved.get(2) == true)
    left = saved.get(1)
    right: any = "retained"
    assert(left == right)

# Double-ended operations share the list's initialized-slot ownership rules.
class deque[T]: Sequence[T]
    grammar truth["bool", "(", self, ")"]() -> bool:
        return self.len() != 0

    storage: list[T]

    def deque():
        storage = list[T]()

    def len(self: view Self) -> int:
        return storage.len()
    def get(self: view Self, index: int) -> T:
        return storage.get(index)
    def set(index: int, item: T):
        storage.set(index, item)
    def append(item: T):
        storage.append(item)
    def push_back(item: T):
        storage.append(item)
    def push_front(item: T):
        storage.insert(0, item)
    def pop_back() -> T | None:
        return storage.try_pop()
    def pop_front() -> T | None:
        if storage.empty():
            return None
        return storage.remove(0)
    def clear():
        storage.clear()
    def keys(self: view Self) -> list[int]:
        return storage.keys()
    def values(self: view Self) -> list[T]:
        return storage.values()
    def items(self: view Self) -> list[tuple[int,T]]:
        return storage.items()
    def iter(self: view Self) -> iterator[T]:
        return iterator(self)
    grammar indexed[self, "[", index: int, "]"]() -> T:
        return self.get(index)
    grammar iterate["iterator", "(", self, ")"]() -> iterator[T]:
        for value in self.storage:
            yield value

# A binary min-heap keeps every duplicate and transfers each removed owner.
class heap[T]: C[int,T] + Iterable[T]
    grammar truth["bool", "(", self, ")"]() -> bool:
        return self.len() != 0

    storage: list[T]

    def heap():
        storage = list[T]()

    def len(self: view Self) -> int:
        return storage.len()
    def get(self: view Self, index: int) -> T:
        return storage.get(index)
    def keys(self: view Self) -> list[int]:
        return storage.keys()
    def values(self: view Self) -> list[T]:
        return storage.values()
    def items(self: view Self) -> list[tuple[int,T]]:
        return storage.items()
    def iter(self: view Self) -> iterator[T]:
        return iterator(self)

    def push(item: T):
        storage.append(item)
        index = storage.len() - 1
        while index > 0:
            parent = (index - 1) / 2
            if not (storage.get(index) < storage.get(parent)):
                break
            value = storage.get(index)
            previous = storage.get(parent)
            storage.set(parent, value)
            storage.set(index, previous)
            index = parent

    def peek(self: view Self) -> T | None:
        if storage.empty():
            return None
        return storage.get(0)

    def pop() -> T | None:
        if storage.empty():
            return None
        result = storage.get(0)
        last = storage.pop()
        if not storage.empty():
            storage.set(0, last)
            index = 0
            while index * 2 + 1 < storage.len():
                child = index * 2 + 1
                if child + 1 < storage.len() and storage.get(child + 1) < storage.get(child):
                    child += 1
                if not (storage.get(child) < storage.get(index)):
                    break
                value = storage.get(index)
                following = storage.get(child)
                storage.set(index, following)
                storage.set(child, value)
                index = child
        return result

    grammar indexed[self, "[", index: int, "]"]() -> T:
        return self.get(index)
    grammar iterate["iterator", "(", self, ")"]() -> iterator[T]:
        for value in self.storage:
            yield value

class count[T:Hash+Equal]: C[T,int] + Iterable[tuple[T,int]]
    grammar truth["bool", "(", self, ")"]() -> bool:
        return self.len() != 0

    storage: map[T,int]

    def count():
        storage = map[T,int]()

    def len(self: view Self) -> int:
        return storage.len()
    def contains(self: view Self, key: T) -> bool:
        return storage.contains(key)
    def get(self: view Self, key: T) -> int:
        if storage.contains(key):
            return storage.get(key)
        return 0
    def add(key: T, amount: int = 1):
        if amount < 0:
            throw Error("count addition must be nonnegative")
        if amount > 0:
            current = self.get(key)
            if current > 9223372036854775807 - amount:
                throw Error("count addition overflow")
            storage.set(key, current + amount)
    def subtract(key: T, amount: int) -> int:
        if amount < 0:
            throw Error("count subtraction must be nonnegative")
        current = self.get(key)
        if amount >= current:
            removed = storage.remove(key)
            return 0
        storage.set(key, current - amount)
        return current - amount
    def total(self: view Self) -> int:
        return storage.sum()
    def keys(self: view Self) -> list[T]:
        return storage.keys()
    def values(self: view Self) -> list[int]:
        return storage.values()
    def items(self: view Self) -> list[tuple[T,int]]:
        return storage.items()
    def iter(self: view Self) -> iterator[tuple[T,int]]:
        return iterator(self)
    grammar indexed[self, "[", key: T, "]"]() -> int:
        return self.get(key)
    grammar iterate["iterator", "(", self, ")"]() -> iterator[tuple[T,int]]:
        for entry in self.storage:
            yield entry

test "deque and heap preserve owning strings after removal":
    jobs = deque[string]()
    jobs.push_back("last")
    jobs.push_front("first")
    first = jobs.pop_front()
    drop(jobs)
    assert(first.has_value and first.value == "first")
    priorities = heap[string]()
    priorities.push("z")
    priorities.push("a")
    priorities.push("a")
    assert(priorities.pop().value == "a")
    assert(priorities.pop().value == "a")
    assert(priorities.pop().value == "z")
    assert(priorities.pop() == None)

test "count removes exhausted keys and does not insert absent lookups":
    frequencies = count[string]()
    frequencies.add("one", 3)
    frequencies.add("two")
    assert(frequencies.get("missing") == 0 and frequencies.len() == 2)
    assert(frequencies.subtract("one", 10) == 0)
    assert(not frequencies.contains("one") and frequencies.total() == 1)

test "dictionary default and removal retain owning values":
    names = dict[int,string]()
    assert(names.set_default(1, "first") == "first")
    assert(names.set_default(1, "ignored") == "first")
    removed = names.remove(1)
    drop(names)
    assert(removed.has_value and removed.value == "first")

test "list growth and cleanup preserve moved-out slots":
    values = list[string]()
    values.append("moved")
    values.append("retained")
    first = move values[0]
    values.reserve(20)
    assert(first == "moved" and values[1] == "retained")
    values[0] = "refilled"
    assert(values[0] == "refilled")
    second = move values[1]
    values.clear()
    assert(second == "retained" and values.empty())


test "list slice notation copies strings and normalizes reversed bounds":
    words = list[string]()
    words.append("one")
    words.append("two")
    words.append("three")
    reverse = words[::-1]
    clipped = words[-20:20:2]
    empty = words[2:1]
    drop words
    assert(reverse.len() == 3 and reverse[0] == "three" and reverse[2] == "one")
    assert(clipped.len() == 2 and clipped[1] == "three")
    assert(empty.len() == 0)

test "zero stride returns an error without consuming the list":
    values = list[int]()
    values.append(10)
    result ?= values[::0]
    assert(result is Error)
    assert(result.message == "slice step cannot be zero")
    assert(values[0] == 10)
    valid = values[::1]
    assert(valid[0] == 10)


test "C Boolean grammar uses element count without consuming storage":
    empty: list[int] = []
    values = [1]
    if empty:
        assert(false)
    if not values:
        assert(false)
    assert(not [] and [1])
    assert(not empty and values)
    assert(bool(values) and not bool(empty))
    assert(values[0] == 1)
    while values:
        values.clear()
    assert(not values)
    keyed = dict[int,int]()
    assert(not keyed)
    keyed.set(1, 0)
    assert(keyed)
    unique = set[int]()
    assert(not unique)
    unique.add(0)
    assert(unique)


test "collection conditions evaluate reached calls once and short circuit":
    def produce(calls: borrow list[int]) -> move list[int]:
        calls[0] += 1
        return [1]

    calls = [0]
    assert(not (false and produce(calls)))
    assert(true or produce(calls))
    assert(calls[0] == 0)
    if produce(calls):
        assert(calls[0] == 1)
    else:
        assert(false)
    assert(calls[0] == 1)
