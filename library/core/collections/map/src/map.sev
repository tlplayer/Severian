import Container from "../../traits/src/container.sev"
import btree
import traits
import * from list as lists

class map[K, V, C:traits.MappingStorage[K,V]=btree.BTree]: Container
    storage: C[K,V]

    def map(entries...: tuple[K,V]):
        storage = C[K,V]()
        for entry in entries:
            storage.set(entry[0], entry[1])

    def bytes(self: view Self) -> byte:
        return storage.bytes()

    def alignment(self: view Self) -> byte:
        return storage.alignment()

    def len(self: view Self) -> int:
        return int(storage.len())

    def empty() -> bool:
        return storage.empty()

    def reserve(minimum: usize):
        storage.reserve(minimum)

    def contains(key: K) -> bool:
        return storage.contains(key)

    def get(key: K) -> V | None:
        return storage.get(key)

    def set(key: K, item: V):
        storage.set(key, item)

    def replace(key: K, item: V) -> V | None:
        return storage.replace(key, item)

    def remove(key: K) -> V | None:
        return storage.remove(key)

    def clear():
        storage.clear()

    def keys() -> lists.list[K]:
        return storage.keys()

    def values() -> lists.list[V]:
        return storage.values()

    operator [](key: K) -> V:
        result ?= get(key)
        assert(result is not None, "map key is not present")
        return result

    operator []=(key: K, item: V):
        set(key, item)

    def items():
        for key in keys():
            yield (key, self[key])

    def copy(self: view Self) -> Self:
        result := map[K, V, C]()
        for key in keys():
            result.set(copy key, copy self[key])
        return result
