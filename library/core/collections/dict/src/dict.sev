import hashed
import traits

class dict[K: traits.HashKey, V]:
    storage: hashed.Hash[K, V]

    def dict():
        storage = hashed.Hash[K, V]()

    def len() -> usize:
        return storage.len()

    def empty() -> bool:
        return storage.empty()

    def reserve(minimum: usize):
        storage.reserve(minimum)

    def contains(key: K) -> bool:
        return storage.contains(key)

    def get(key: K) -> V | None:
        return storage.get(key)

    def set(key: K, item: V):
        storage.set(key, item)

    def replace(key: K, item: V) -> V | None:
        return storage.replace(key, item)

    def remove(key: K) -> V | None:
        return storage.remove(key)

    def set_default(key: K, item: V) -> V:
        existing ?= get(key)
        if existing is not None:
            return existing
        set(key, item)
        return item

    operator [](key: K) -> V:
        result ?= get(key)
        assert(result is not None, "dictionary key is not present")
        return result

    operator []=(key: K, item: V):
        set(key, item)

    operator if(self) -> bool:
        return not empty()

    def keys():
        return storage.keys()

    def values():
        return storage.values()

    def items():
        for key in keys():
            yield (key, self[key])

    def copy(self: view Self) -> Self:
        result := dict[K, V]()
        for key in keys():
            result.set(copy key, copy self[key])
        return result

    def clear():
        storage.clear()
