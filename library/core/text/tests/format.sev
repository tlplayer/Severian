import * from "../src/format.sev" as format

test "decimal conversion covers zero and signed and unsigned limits":
    assert(format.string(0) == "0")
    assert(format.string(-9223372036854775808) == "-9223372036854775808")
    assert(format.string(9223372036854775807) == "9223372036854775807")
    byte: u8 = 255
    small: i8 = -128
    assert(format.string(byte) == "255")
    assert(format.string(small) == "-128")
    largest: u64 = 18446744073709551615
    assert(format.string(largest) == "18446744073709551615")


test "character conversion writes all four UTF-8 widths":
    assert(format.string('a') == "a")
    assert(format.string('λ') == "λ")
    assert(format.string('中') == "中")
    assert(format.string('😀') == "😀")


test "string conversion preserves strings and names boolean and absent values":
    assert(format.string("aλ😀") == "aλ😀")
    assert(format.string(true) == "true")
    assert(format.string(false) == "false")
    assert(format.string(None) == "None")


test "hosted float formatting round-trips full precision and extreme values":
    assert(format.string(3.1415926) == "3.1415926")
    assert(format.string(1.2345678901234567) == "1.2345678901234567")
    assert(format.string(5e-324) == "5e-324")
    assert(format.string(1.7976931348623157e308) == "1.7976931348623157e+308")
    negative_zero = -0.0
    assert(1.0 / (+negative_zero) < 0.0)
    assert(format.string(negative_zero) == "-0")
    nan: f64 = 0.0 / 0.0
    assert(nan != nan)
    assert(not (nan == nan))
    assert(format.string(nan) == "nan")
    assert(format.string(1.0 / 0.0) == "inf")
    assert(format.string(-1.0 / 0.0) == "-inf")

test "object formatting escapes names and string fields":
    assert(format.object_text(("name", "a\"λ\n"), ("count", 42), ("active", true), ("optional", None)) == "{\"name\":\"a\\\"λ\\u000a\",\"count\":42,\"active\":true,\"optional\":null}")

class Display:
    name: string
    count: int

    operator string(self) -> string:
        return format.object_text(("name", copy name), ("count", count))

test with integ "print and string share object conversion":
    value = Display("Ada", 42)
    assert(string(value) == "{\"name\":\"Ada\",\"count\":42}")
    print(value)
    assert(stdout == "{\"name\":\"Ada\",\"count\":42}\n")
