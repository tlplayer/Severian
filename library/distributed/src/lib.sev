def shard_start(length: int, workers: int, worker: int) -> int:
    return length * worker / workers

def shard_end(length: int, workers: int, worker: int) -> int:
    return length * (worker + 1) / workers

def shard_size(length: int, workers: int, worker: int) -> int:
    return shard_end(length, workers, worker) - shard_start(length, workers, worker)

test "even shard plan covers the input":
    assert(shard_start(16, 4, 0) == 0)
    assert(shard_end(16, 4, 3) == 16)
    assert(shard_size(16, 4, 2) == 4)

test "remainder is assigned deterministically":
    assert(shard_start(10, 4, 0) == 0)
    assert(shard_end(10, 4, 3) == 10)
