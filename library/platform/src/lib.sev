    native("__sev_file_mapped_size") def fileMappedSize(mapping: Any) -> int

    native("__sev_file_unmap") def fileUnmap(mapping: Any) -> Result[unit, IOError]

test "native file ABI":
    path = "/tmp/severian-platform-roundtrip.txt"
    switch fileWrite(path, "platform ABI"):
        ok:
            switch fileRead(path):
                ok contents:
                    assert(contents == "platform ABI")
                failure error:
                    assert(false, error)
        failure error:
            assert(false, error)

unsafe:
    native("__sev_json_decode") def jsonDecode(text: string) -> Result[Any, JsonError]

test "native JSON decode ABI":
    switch jsonDecode("42"):
        ok value:
            assert(value == 42)
        failure error:
            assert(false, error)

