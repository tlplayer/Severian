unsafe:
    native("__sev_json_decode") def jsondecode(text: string) -> Result[Any, JsonError]

test "native JSON decode ABI":
    switch jsondecode("42"):
        ok value:
            assert(value == 42)
        failure error:
            assert(false, error)

unsafe:
    native("__sev_json_encode") def jsonencode(value: Any) -> string

    native("__sev_json_object_get") def jsonobject_get(value: Any, key: string) -> Any

    native("__sev_json_object_keys") def jsonobject_keys(value: Any) -> list[string]

    native("__sev_json_object_values") def jsonobject_values(value: Any) -> list[Any]

    native("__sev_json_object_set") def jsonobject_set(value: Any, key: string, item: Any)

    native("__sev_json_as_string") def jsonas_string(value: Any) -> string

    native("__sev_json_as_int") def jsonas_int(value: Any) -> int

    native("__sev_json_as_float") def jsonas_float(value: Any) -> float

    native("__sev_json_as_bool") def jsonas_bool(value: Any) -> bool

    native("__sev_json_as_int_list") def jsonas_int_list(value: Any) -> list[int]

    native("__sev_json_as_string_list") def jsonas_string_list(value: Any) -> list[string]
    native("__sev_json_as_list") def jsonas_list(value: Any) -> list[Any]
    native("__sev_json_is_null") def jsonis_null(value: Any) -> bool
    native("__sev_json_kind") def jsonkind(value: Any) -> string

test "native JSON encode ABI":
    assert(jsonencode([1, 2, 3]) == "[1,2,3]")

unsafe:
