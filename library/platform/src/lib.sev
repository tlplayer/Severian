native("__sev_file_read") def fileRead(path: string) -> Result[string, IOError]

native("__sev_file_write") def fileWrite(path: string, contents: string) -> Result[unit, IOError]

test "native file ABI":
    path = "/tmp/severian-platform-roundtrip.txt"
    switch fileWrite(path, "platform ABI"):
        ok:
            switch fileRead(path):
                ok contents:
                    assert(contents == "platform ABI")
                failure error:
                    assert(false, error)
        failure error:
            assert(false, error)

native("__sev_json_decode") def jsonDecode(text: string) -> Result[Any, JsonError]

test "native JSON decode ABI":
    switch jsonDecode("42"):
        ok value:
            assert(value == 42)
        failure error:
            assert(false, error)

native("__sev_json_encode") def jsonEncode(value: Any) -> string

test "native JSON encode ABI":
    assert(jsonEncode([1, 2, 3]) == "[1,2,3]")

native("__sev_log_info") def logInfo(message: string)

test "native log ABI":
    logInfo("platform ready")

native("__sev_log_error") def logError(message: string, cause: Any)

native("__sev_network_listen") def networkListen(address: string) -> Result[TCPListener, IOError]

native("__sev_network_loopback_echo") def networkLoopbackEcho(message: string) -> Result[string, IOError]

test "native network ABI":
    switch networkLoopbackEcho("platform loopback"):
        ok echoed:
            assert(echoed == "platform loopback")
        failure error:
            logError("native network ABI failed", error)
            assert(false, error)

native("__sev_regex_matches") def regexMatches(text: string, pattern: string) -> bool

test "native regex ABI":
    assert(regexMatches("release-42", "^[a-z]+-[0-9]+$"))

native("__sev_host_container_backend") def hostContainerBackend() -> string

native("__sev_host_kvm_api_version") def hostKvmApiVersion() -> int

native("__sev_host_kvm_create_probe") def hostKvmCreateProbe() -> bool

native("__sev_host_page_size") def hostPageSize() -> int

native("__sev_database_open") def databaseOpen(path: string) -> Result[Database, DatabaseError]

native("__sev_database_execute") def databaseExecute(database: Database, sql: string) -> Result[int, DatabaseError]

native("__sev_database_query") def databaseQuery(database: Database, sql: string) -> Result[list[list[string]], DatabaseError]

native("__sev_database_close") def databaseClose(database: Database) -> Result[unit, DatabaseError]

native("__sev_database_server_start") def databaseServerStart(path: string) -> Result[DatabaseServer, DatabaseError]

native("__sev_database_server_address") def databaseServerAddress(server: DatabaseServer) -> string

native("__sev_database_server_connect") def databaseServerConnect(address: string) -> Result[DatabaseConnection, DatabaseError]

native("__sev_database_server_execute") def databaseServerExecute(connection: DatabaseConnection, sql: string) -> Result[int, DatabaseError]

native("__sev_database_server_query") def databaseServerQuery(connection: DatabaseConnection, sql: string) -> Result[list[list[string]], DatabaseError]

native("__sev_database_server_close") def databaseServerClose(connection: DatabaseConnection) -> Result[unit, DatabaseError]

native("__sev_database_server_stop") def databaseServerStop(server: DatabaseServer) -> Result[unit, DatabaseError]
