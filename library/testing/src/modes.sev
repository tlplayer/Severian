import * from "capture.sev" as capture
import * from "profile.sev" as profile


trait TestMode:
    name: string
    context: T
    begin: F
    ready: F
    before: F
    after: F
    finish: F
    failure: F
    bindings: {string: F}


trait Integration: TestMode:
    name: string = "integ"
    context: T = capture.Capture
    begin: F = capture.begin
    ready: F = capture.freeze
    before: F = capture.resume
    after: F = capture.suspend
    finish: F = capture.finish
    failure: F = capture.finish
    bindings: {string: F} = {
        "stdout": capture.stdout,
        "stderr": capture.stderr,
    }


trait IntegrationLong: TestMode:
    name: string = "integration"
    context: T = capture.Capture
    begin: F = capture.begin
    ready: F = capture.freeze
    before: F = capture.resume
    after: F = capture.suspend
    finish: F = capture.finish
    failure: F = capture.finish
    bindings: {string: F} = {
        "stdout": capture.stdout,
        "stderr": capture.stderr,
    }


trait Profile: TestMode:
    name: string = "profile"
    context: T = profile.Measurement
    begin: F = profile.measure
    ready: F = profile.prepared
    before: F = profile.measure_before
    after: F = profile.report
    finish: F = profile.measured_finish
    failure: F = profile.measured_finish
    bindings: {string: F} = {
        "time": profile.time,
        "memory": profile.memory,
        "allocations": profile.allocations,
    }
