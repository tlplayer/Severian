# Test lifecycle adapters over the reusable system profiling API.
import * from "../../system/profiling/src/measurement.sev"

def ready(context: int) -> int:
    return context


def before(context: int) -> int:
    return begin()


def after(context: int):
    elapsed = begin() - context
    print("profile:", elapsed, "ns")


def finish(context: int):
    pass


def prepared(context: Measurement) -> Measurement:
    return context

def measure_before(context: Measurement) -> Measurement:
    return measure()

def report(context: Measurement):
    elapsed = time(context)
    calls = allocations(context)
    allocated = memory(context)
    print("profile:", elapsed.amount, "ns;", calls, "allocations;", allocated.amount / 8.0, "allocated bytes")

def measured_finish(context: Measurement):
    pass
