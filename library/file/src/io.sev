import abi
import "src/ffi.sev" as externs

def native_handle(value: isize) -> abi.Handle:
    return abi.Handle(value)

def read_text(path: string) -> Result[string, IOError]:
    content = abi.OutHandle(0)
    error = abi.OutError(0, "")
    if externs.read_text(abi.StringView(path), content, error) != 0:
        return failure(IOError(error.message))
    handle = native_handle(content.value)
    value = externs.text_value(handle)
    externs.text_release(handle)
    return value
