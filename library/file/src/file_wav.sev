import "src/file_interface.sev" as file_interface
import platform

class WAV: file_interface.File
    source_path: string
    data: list[int]
    channels: int
    sample_rate: int
    bits_per_sample: int

    def path() -> string:
        return source_path

    def name() -> string:
        return platform.path_basename(source_path)

    def extension() -> string:
        return platform.path_extension(source_path).lower()

    def kind() -> string:
        return "wav"

    def media_type() -> string:
        return "audio/wav"

    def size() -> int:
        return size(data)

    def bytes() -> int:
        return size(data)

    def raw() -> list[int]:
        return data

    def text() -> string | file_interface.FormatError:
        return failure(file_interface.FormatError("WAV files do not have text content"))

    def value() -> Any:
        return data

    def write() -> unit | IOError:
        return platform.file_write_bytes(source_path, data)

class WavReader: file_interface.Reader
    extensions = {".wav"}
    document_class = "WAV"

    def read(path: string) -> file_interface.File | IOError | file_interface.FormatError:
        handle = platform.file_open_binary(path)
        length = platform.file_size(handle)
        loaded = platform.file_read_exact(handle, length)
        data: list[int] = loaded
        _closed = platform.file_close(handle)
        if size(data) < 44:
            return failure(file_interface.FormatError("WAV file is shorter than its required header"))
        if data[0:4] != [82, 73, 70, 70] or data[8:12] != [87, 65, 86, 69]:
            return failure(file_interface.FormatError("WAV file must contain RIFF and WAVE signatures"))
        channels = data[22] + data[23] * 256
        sample_rate = data[24] + data[25] * 256 + data[26] * 65536 + data[27] * 16777216
        bits_per_sample = data[34] + data[35] * 256
        return WAV(path, data, channels, sample_rate, bits_per_sample)
