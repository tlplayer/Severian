import "src/file_interface.sev" as file_interface
import csv
import platform

class CsvReader: file_interface.Reader
    def extensions() -> list[string]:
        return [".csv"]

    def read(path: string) -> Result[file_interface.File, IOError | file_interface.FormatError]:
        content = platform.file_read(path)
        return csv.file_document(path, content)
