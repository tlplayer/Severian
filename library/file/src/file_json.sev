import "src/file_interface.sev" as file_interface
import json
import platform

# JSON owns the document. This adapter only connects the .json extension to
# file.read(); it introduces no second JSON type or JSON behavior.
class JsonReader: file_interface.Reader
    def extensions() -> list[string]:
        return [".json"]

    def read(path: string) -> Result[file_interface.File, IOError | file_interface.FormatError]:
        content = platform.file_read(path)
        switch json.file_document(path, content):
            ok document:
                return document
            failure error:
                return failure(file_interface.FormatError(error.message))
