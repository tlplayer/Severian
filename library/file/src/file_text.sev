import "src/file_interface.sev" as file_interface
import "src/io.sev" as file_io
import platform

class Text: file_interface.File
    source_path: string
    content: string

    def path() -> string:
        return source_path

    def name() -> string:
        return platform.path_basename(source_path)

    def extension() -> string:
        return platform.path_extension(source_path).lower()

    def kind() -> string:
        return "text"

    def media_type() -> string:
        return "text/plain"

    def size() -> int:
        return size(platform.string_encode(content))

    def bytes() -> int:
        return size(platform.string_encode(content))

    def raw() -> list[int]:
        return platform.string_encode(content)

    def text() -> Result[string, file_interface.FormatError]:
        return content

    def value() -> Any:
        return content

    def write() -> Result[unit, IOError]:
        return platform.file_write(source_path, content)

    def lines() -> list[string]:
        return content.split("\n")

    def words() -> list[string]:
        return content.words()

class TextReader: file_interface.Reader
    extensions = {".txt", ".text", ".md", ".sev", ".toml", ".xml", ".html", ".log", ".lua"}
    document_class = "Text"

    def read(path: string) -> Result[file_interface.File, IOError | file_interface.FormatError]:
        content = file_io.read_text(path)
        return Text(path, content)
