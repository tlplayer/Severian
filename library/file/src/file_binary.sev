import "src/file_interface.sev" as file_interface
import platform

class Binary: file_interface.File
    source_path: string
    data: list[int]

    def path() -> string:
        return source_path

    def name() -> string:
        return platform.path_basename(source_path)

    def extension() -> string:
        return platform.path_extension(source_path).lower()

    def kind() -> string:
        return "binary"

    def media_type() -> string:
        return "application/octet-stream"

    def size() -> int:
        return size(data)

    def bytes() -> int:
        return size(data)

    def raw() -> list[int]:
        return data

    def text() -> Result[string, file_interface.FormatError]:
        return failure(file_interface.FormatError("binary files do not have text content"))

    def value() -> Any:
        return data

    def write() -> Result[unit, IOError]:
        return platform.file_write_bytes(source_path, data)

class BinaryReader:

    def read(path: string) -> Result[file_interface.File, IOError | file_interface.FormatError]:
        handle = platform.file_open_binary(path)
        length = platform.file_size(handle)
        loaded = platform.file_read_exact(handle, length)
        data: list[int] = loaded
        _closed = platform.file_close(handle)
        return Binary(path, data)
