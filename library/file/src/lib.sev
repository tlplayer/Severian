import "src/file_interface.sev" as file_interface
import "src/io.sev" as file_io
import "src/file_text.sev" as file_text
import "src/file_csv.sev" as file_csv
import "src/file_json.sev" as file_json
import "src/file_yaml.sev" as file_yaml
import "src/file_wav.sev" as file_wav
import "src/file_mp3.sev" as file_mp3
import "src/file_binary.sev" as file_binary
import platform
import json

def source_text(path: string) -> string | IOError:
    return file_io.read_text(path)

def read_text(path: string) -> string | IOError | file_interface.FormatError:
    document = read(path)
    return document.text()

def write(path: string, contents: string) -> unit | IOError:
    return platform.file_write(path, contents)

def write_text(path: string, contents: string) -> unit | IOError:
    return write(path, contents)

def append_text(path: string, contents: string) -> unit | IOError:
    return platform.file_append(path, contents)

def write_bytes(path: string, contents: list[int]) -> unit | IOError:
    return platform.file_write_bytes(path, contents)

def parse_csv(path: string) -> Result[list[list[string]], IOError | file_interface.FormatError]:
    document = read(path)
    rows: list[list[string]] = document.value()
    return rows

def open(path: string, mode: string = "rb") -> Any | IOError:
    if mode != "rb":
        return error(IOError("binary file mode must be rb"))
    return platform.file_open_binary(path)

def read_bytes_from(handle: Any, count: int) -> Result[list[int], IOError]:
    return platform.file_read_bytes(handle, count)

def read_exact(handle: Any, count: int) -> Result[list[int], IOError]:
    return platform.file_read_exact(handle, count)

def utf8(data: list[int]) -> string | IOError:
    return platform.decode_utf8(data)

def seek(handle: Any, offset: int) -> unit | IOError:
    return platform.file_seek(handle, offset)

def byte_length(handle: Any) -> int | IOError:
    return platform.file_size(handle)

def close(handle: Any) -> unit | IOError:
    return platform.file_close(handle)

def map(path: string) -> Any | IOError:
    return platform.file_map(path)

def mapped_bytes(mapping: Any) -> int:
    return platform.file_mapped_size(mapping)

def unmap(mapping: Any) -> unit | IOError:
    return platform.file_unmap(mapping)

def lock(path: string) -> Any | IOError:
    return platform.file_lock(path)

def unlock(handle: Any) -> unit | IOError:
    return platform.file_unlock(handle)

def little_endian_u64(data: list[int]) -> int:
    assert(size(data) == 8, "u64 requires exactly eight bytes")
    value := 0
    multiplier := 1
    for byte in data:
        value += byte * multiplier
        multiplier *= 256
    return value

def read(path: string) -> file_interface.File | IOError | file_interface.FormatError:
    extension = platform.path_extension(path).lower()
    reader: file_interface.Reader = registry[file_interface.Reader](
        "extensions",
        extension,
        file_binary.BinaryReader(),
    )
    document = reader.read(path)
    return document

def load(path: string) -> Any | IOError | file_interface.FormatError:
    document = read(path)
    return document.value()

test "native file round trip":
    path = "/tmp/severian-library-file-roundtrip.txt"
    _written = write(path, "severian file runtime")
    contents = read_text(path)
    assert(contents == "severian file runtime")

test "missing source text reports an IO error":
    match source_text("/tmp/severian-library-file-does-not-exist.txt"):
        ok contents:
            assert(false, contents)
        failure error:
            assert(error.message != "")

test "read dispatches text and csv formats":
    text_path = "/tmp/severian-library-format.txt"
    table_path = "/tmp/severian-library-format.csv"
    _text_written = write_text(text_path, "hello")
    _table_written = write_text(table_path, "name,note\nAda,\"compiler, author\"\n")
    text_file = read("/tmp/severian-library-format.txt")
    table_file = read("/tmp/severian-library-format.csv")
    assert(text_file.kind() == "text")
    text = text_file.text()
    assert(text == "hello")
    assert(table_file.kind() == "csv")
    assert(table_file.headers() == ["name", "note"])
    assert(table_file.records() == [["Ada", "compiler, author"]])
    rows = table_file.rows()
    assert(size(rows) == 1)
    assert(rows[0].get("name") == "Ada")
    assert(table_file.column("name") == ["Ada"])
    assert(table_file.get(0, "note") == "compiler, author")
    note = table_file.cell(0, "note")
    assert(note == "compiler, author")
    _changed = table_file.set(0, "note", "language designer")
    _saved = table_file.write()
    changed = read("/tmp/severian-library-format.csv")
    assert(changed.get(0, "note") == "language designer")

test "native CSV parsing preserves escaped quotes and quoted newlines":
    path = "/tmp/severian-library-quoted.csv"
    _written = write(path, "name,note\nAda,\"compiler \"\"author\"\"\nsecond line\"\n")
    rows = parse_csv(path)
    assert(rows == [["name", "note"], ["Ada", "compiler \"author\"\nsecond line"]])

test "read returns parsed JSON and YAML objects":
    json_path = "/tmp/severian-library-format.json"
    yaml_path = "/tmp/severian-library-format.yaml"
    _json_written = write(json_path, "{\"name\":\"Ada\",\"languages\":2}")
    _yaml_written = write(yaml_path, "engineers:\n- Ada\n- Grace\nstatus: ready\n")
    loaded_json = read("/tmp/severian-library-format.json")
    json_file := loaded_json
    loaded_yaml = read("/tmp/severian-library-format.yaml")
    yaml_file := loaded_yaml
    assert(json_file.kind() == "json")
    assert(json_file.keys() == ["name", "languages"])
    assert(json.as_string(json_file.get("name")) == "Ada")
    json_file.set("name", "Grace")
    _json_saved = json_file.write()
    changed_json = read("/tmp/severian-library-format.json")
    assert(json.as_string(changed_json.get("name")) == "Grace")
    assert(yaml_file.kind() == "yaml")
    assert(yaml_file.values_for("engineers") == ["Ada", "Grace"])
    assert(yaml_file.scalar("status") == "ready")
    yaml_file.set("status", "complete")
    _yaml_saved = yaml_file.write()
    changed_yaml = read("/tmp/severian-library-format.yaml")
    assert(changed_yaml.scalar("status") == "complete")

test "load returns the decoded value selected by the file extension":
    json_path = "/tmp/severian-library-load.json"
    csv_path = "/tmp/severian-library-load.csv"
    _json_written = write(json_path, "{\"name\":\"Ada\",\"languages\":2}")
    _csv_written = write(csv_path, "name,note\nAda,compiler\n")
    json_value = load(json_path)
    csv_value: list[list[string]] = load(csv_path)
    assert(json.as_string(json.object_get(json_value, "name")) == "Ada")
    assert(csv_value == [["name", "note"], ["Ada", "compiler"]])

test "binary extensions use typed audio and fallback objects":
    mp3_path = "/tmp/severian-library-format.mp3"
    bin_path = "/tmp/severian-library-format.bin"
    _mp3_written = write(mp3_path, "ID3payload")
    _bin_written = write(bin_path, "raw")
    mp3_file = read(mp3_path)
    binary_file = read(bin_path)
    assert(mp3_file.kind() == "mp3")
    assert(mp3_file.get("has_id3"))
    assert(binary_file.kind() == "binary")

test "binary file supports exact reads seeking and sizing":
    path = "/tmp/severian-library-file-binary.bin"
    _written = write(path, "ABCDEFGH")
    handle = open(path)
    length = byte_length(handle)
    assert(length == 8)
    _positioned = seek(handle, 2)
    data = read_exact(handle, 3)
    assert(data == [67, 68, 69])
    _closed = close(handle)
