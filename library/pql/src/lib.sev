class Schema:
    relation: string
    columns: list[string]
    types: list[string]
    nullable: list[bool]
    primary_key: string

class Query:
    relation: string
    fields: list[string]
    outputs: list[string]
    aggregated: list[bool]
    filter_field: string
    parameter_type: string
    group_fields: list[string]

def contains_name(names: list[string], expected: string) -> bool:
    for name in names:
        if name == expected:
            return true
    return false

def field_index(schema: Schema, field: string) -> int:
    for index in indices(schema.columns):
        if schema.columns[index] == field:
            return index
    return -1

def schema_errors(schema: Schema) -> list[string]:
    errors := []
    if schema.relation == "":
        errors.append("schema relation is empty")
    if size(schema.columns) != size(schema.types):
        errors.append("column/type arity mismatch")
    if size(schema.columns) != size(schema.nullable):
        errors.append("column/nullability arity mismatch")
    if schema.primary_key != "" and field_index(schema, schema.primary_key) < 0:
        errors.append("primary key is not a declared column")
    for left in indices(schema.columns):
        for right in range(left + 1, size(schema.columns)):
            if schema.columns[left] == schema.columns[right]:
                errors.append("duplicate column: " + string(schema.columns[left]))
    return errors

def query_errors(schema: Schema, query: Query) -> list[string]:
    errors := []
    for error in schema_errors(schema):
        errors.append(error)
    if query.relation != schema.relation:
        errors.append("query relation does not match schema")
    if size(query.fields) != size(query.outputs):
        errors.append("field/output arity mismatch")
    if size(query.fields) != size(query.aggregated):
        errors.append("field/aggregate arity mismatch")
    for field in query.fields:
        if field_index(schema, field) < 0:
            errors.append("unknown projected field: " + string(field))
    if query.filter_field != "":
        filter_index = field_index(schema, query.filter_field)
        if filter_index < 0:
            errors.append("unknown filter field: " + query.filter_field)
        else:
            if schema.types[filter_index] != query.parameter_type:
                errors.append("filter parameter type mismatch")
    for group_field in query.group_fields:
        if field_index(schema, group_field) < 0:
            errors.append("unknown group field: " + string(group_field))
    if size(query.group_fields) > 0:
        for index in indices(query.fields):
            if not query.aggregated[index] and not contains_name(query.group_fields, query.fields[index]):
                errors.append("ungrouped projected field: " + string(query.fields[index]))
    return errors

def valid(schema: Schema, query: Query) -> bool:
    return size(query_errors(schema, query)) == 0

def join_errors(left: Schema, right: Schema, left_field: string, right_field: string) -> list[string]:
    errors := []
    left_index = field_index(left, left_field)
    right_index = field_index(right, right_field)
    if left_index < 0:
        errors.append("unknown left join field")
    if right_index < 0:
        errors.append("unknown right join field")
    if left_index >= 0 and right_index >= 0:
        if left.types[left_index] != right.types[right_index]:
            errors.append("join field type mismatch")
    return errors

def result_fields(query: Query) -> list[string]:
    return query.outputs

def result_types(schema: Schema, query: Query) -> list[string]:
    types := []
    for field in query.fields:
        index = field_index(schema, field)
        if index >= 0:
            types.append(schema.types[index])
    return types

def result_nullability(schema: Schema, query: Query) -> list[bool]:
    nullable := []
    for field in query.fields:
        index = field_index(schema, field)
        if index >= 0:
            nullable.append(schema.nullable[index])
    return nullable

def join_text(values: list[string], separator: string) -> string:
    output := ""
    for index in indices(values):
        if index > 0:
            output = output + separator
        output = output + string(values[index])
    return output

def logical_plan(schema: Schema, query: Query) -> list[string]:
    assert(valid(schema, query))
    plan := ["scan " + query.relation]
    if query.filter_field != "":
        plan.append("filter " + query.filter_field + ":" + query.parameter_type)
    if size(query.group_fields) > 0:
        plan.append("group " + join_text(query.group_fields, ","))
    plan.append("project " + join_text(query.outputs, ","))
    return plan

def sql(schema: Schema, query: Query, dialect: string) -> string:
    assert(valid(schema, query))
    statement := "SELECT " + join_text(query.outputs, ", ") + " FROM " + schema.relation
    if query.filter_field != "":
        placeholder = "$1" if dialect == "postgres" else "?1"
        statement = statement + " WHERE " + query.filter_field + " = " + placeholder
    if size(query.group_fields) > 0:
        statement = statement + " GROUP BY " + join_text(query.group_fields, ", ")
    return statement

def execute_fixture(schema: Schema, query: Query, rows: list[list[Any]], parameter: Any) -> list[Any]:
    assert(valid(schema, query))
    output := []
    filter_index = field_index(schema, query.filter_field)
    for row in rows:
        if filter_index < 0 or row[filter_index] == parameter:
            for field in query.fields:
                output.append(row[field_index(schema, field)])
    return output

test "schema and query validation":
    users = Schema("users", ["id", "tenantId", "name"], ["int", "int", "string"], [false, false, true], "id")
    query = Query("users", ["id", "name"], ["id", "name"], [false, false], "tenantId", "int", [])
    assert(valid(users, query))
    assert(result_fields(query) == ["id", "name"])
    assert(result_types(users, query) == ["int", "string"])
    assert(result_nullability(users, query) == [false, true])

test "invalid fields and parameter types are rejected before SQL":
    users = Schema("users", ["id", "tenantId"], ["int", "int"], [false, false], "id")
    query = Query("users", ["missing"], ["missing"], [false], "tenantId", "string", [])
    assert(query_errors(users, query) == ["unknown projected field: missing", "filter parameter type mismatch"])

test "grouping and joins are checked":
    users = Schema("users", ["id", "tenantId"], ["int", "int"], [false, false], "id")
    tenants = Schema("tenants", ["id", "name"], ["int", "string"], [false, false], "id")
    grouped = Query("users", ["tenantId", "id"], ["tenantId", "count(id)"], [false, true], "", "", ["tenantId"])
    assert(valid(users, grouped))
    assert(join_errors(users, tenants, "tenantId", "id") == [])
    assert(sql(users, grouped, "postgres") == "SELECT tenantId, count(id) FROM users GROUP BY tenantId")

test "dialects and logical plans are deterministic":
    users = Schema("users", ["id", "tenantId", "name"], ["int", "int", "string"], [false, false, true], "id")
    query = Query("users", ["id", "name"], ["id", "name"], [false, false], "tenantId", "int", [])
    assert(sql(users, query, "postgres") == "SELECT id, name FROM users WHERE tenantId = $1")
    assert(sql(users, query, "sqlite") == "SELECT id, name FROM users WHERE tenantId = ?1")
    assert(logical_plan(users, query) == ["scan users", "filter tenantId:int", "project id,name"])

test "fixtures execute without a database":
    users = Schema("users", ["id", "tenantId", "name"], ["int", "int", "string"], [false, false, true], "id")
    query = Query("users", ["id", "name"], ["id", "name"], [false, false], "tenantId", "int", [])
    rows = [[1, 7, "Ada"], [2, 8, "Grace"], [3, 7, "Linus"]]
    assert(execute_fixture(users, query, rows, 7) == [1, "Ada", 3, "Linus"])
