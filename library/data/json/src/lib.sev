import data_format
import file

class JsonFile: File
    def read(path: string) -> string with { path.ends_with(".json") }:
        return file.raw(path)

class Document: data_format.Data
    source: string
    columns_data: list[string]
    rows_data: list[list[Any]]

    def text() -> string:
        return source

    def columns() -> list[string]:
        return columns_data

    def values() -> list[list[Any]]:
        return rows_data

def tokens(source: string) -> list[string]:
    result: list[string] := []
    token := ""
    quoted := false
    escaped := false
    cursor := 0
    while cursor < size(source):
        character = source[cursor:cursor + 1]
        if quoted:
            if escaped:
                token += "\n" if character == "n" else character
                escaped = false
            else:
                if character == "\\":
                    escaped = true
                else:
                    if character == "\"":
                        result.append(token)
                        token = ""
                        quoted = false
                    else:
                        token += character
            cursor += 1
            continue
        if character == "\"":
            if size(token.strip()) > 0:
                result.append(token.strip())
                token = ""
            quoted = true
            cursor += 1
            continue
        if character in ["{", "}", "[", "]", ":", ","]:
            if size(token.strip()) > 0:
                result.append(token.strip())
                token = ""
            result.append(character)
            cursor += 1
            continue
        if character == " " or character == "\n" or character == "\r" or character == "\t":
            if size(token.strip()) > 0:
                result.append(token.strip())
                token = ""
            cursor += 1
            continue
        token += character
        cursor += 1
    if size(token.strip()) > 0:
        result.append(token.strip())
    return result

def property_key(line: string) -> string:
    stripped = line.strip()
    separator = stripped.find("\":")
    if not stripped.starts_with("\"") or separator < 1:
        return ""
    return stripped[1:separator]

def property_value(line: string) -> Any:
    stripped = line.strip()
    separator = stripped.find("\":")
    if separator < 0:
        return ""
    value := stripped[separator + 2:].strip()
    if value.ends_with(","):
        value = value[0:-1].strip()
    if value == "null":
        return ""
    if size(value) >= 2 and value.starts_with("\"") and value.ends_with("\""):
        return value[1:-1].replace("\\\"", "\"").replace("\\n", "\n")
    return value

def tabular_lines(source: string) -> Document:
    lines = source.split("\n")
    columns: list[string] := []
    for line in lines:
        key = property_key(line)
        if key != "" and key not in columns:
            columns.append(key)
    rows: list[list[Any]] := []
    values: list[Any] := []
    populated := false
    for line in lines:
        stripped = line.strip()
        if stripped == "{" or stripped.ends_with("{"):
            values = []
            for column in columns:
                values.append("")
            populated = false
            continue
        if stripped.starts_with("}"):
            if populated:
                rows.append(values)
            populated = false
            continue
        key = property_key(line)
        if key == "":
            continue
        position := 0
        while position < size(columns):
            if columns[position] == key:
                values[position] = property_value(line)
                populated = true
            position += 1
    return Document(source, columns, rows)

def tabular(source: string) -> Document:
    if source.contains("\n"):
        return tabular_lines(source)
    stream = tokens(source)
    columns: list[string] := []
    cursor := 0
    while cursor < size(stream):
        if stream[cursor] != "{":
            cursor += 1
            continue
        cursor += 1
        while cursor < size(stream) and stream[cursor] != "}":
            if stream[cursor] == ",":
                cursor += 1
                continue
            key = stream[cursor]
            if cursor + 1 < size(stream) and stream[cursor + 1] == ":" and key not in columns:
                columns.append(key)
            cursor += 3
        cursor += 1
    rows: list[list[Any]] := []
    cursor = 0
    while cursor < size(stream):
        if stream[cursor] != "{":
            cursor += 1
            continue
        cursor += 1
        values: list[Any] := []
        for column in columns:
            values.append("")
        populated := false
        while cursor < size(stream) and stream[cursor] != "}":
            if stream[cursor] == ",":
                cursor += 1
                continue
            key = stream[cursor]
            cursor += 1
            if cursor >= size(stream) or stream[cursor] != ":":
                continue
            cursor += 1
            if cursor >= size(stream):
                break
            value: Any := "" if stream[cursor] == "null" else stream[cursor]
            position := 0
            while position < size(columns):
                if columns[position] == key:
                    values[position] = value
                    populated = true
                position += 1
            cursor += 1
        if populated:
            rows.append(values)
        cursor += 1
    return Document(source, columns, rows)

def decode(source: string) -> Document:
    normalized = source.strip()
    if size(normalized) == 0:
        return Document("", [], [])
    if not normalized.starts_with("{") and not normalized.starts_with("["):
        return Document("", [], [])
    return tabular(source)

def encode(document: Document) -> string:
    return document.source

def kind(value: Any) -> string

def is_null(value: Any) -> bool

def encode(values: list[Any]) -> string:
    return string(values)

def read(path: string) -> Document:
    return decode(file.raw(path))

test "JSON file adapter preserves a document":
    document = decode("[{\"name\": \"Ada\", \"age\": 36}, {\"name\": \"Grace\", \"active\": true}]")
    assert(document.text().starts_with("["))
    assert(document.columns() == ["name", "age", "active"])
    assert(size(document.values()) == 2)
    assert(document.values()[0][0] == "Ada")
    assert(document.values()[1][2] == "true")
