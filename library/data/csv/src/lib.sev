import data
from data import Data
import file
import tensor
import os

class CsvFile: File
    def read(path: string) -> Data with { path.ends_with(".csv") }:
        return csv_data_from_text(file.read_text(path))

class Document: data.DataSource
    source: string
    columns_data: list[string]
    rows_data: list[list[Any]]

    def text() -> string:
        return source

    def columns() -> list[string]:
        return columns_data

    def values() -> list[list[Any]]:
        return rows_data

def csv_columns_native(source: string) -> list[string]

def csv_rows_native(source: string) -> list[list[Any]]

def decode(source: string) -> Document:
    return Document(source, csv_columns_native(source), csv_rows_native(source))

def encode(document: Document) -> string:
    return document.text()

def csv_data_from_text(source: string) -> Data:
    document = decode(source)
    return Data(document.columns(), document.values())

def read(path: string) -> Data:
    return csv_data_from_text(file.read_text(path))

test "CSV documents retain their source representation":
    document = decode("name,value,note\nseverian,1,\"hello, world\"\ncompiler,2,\"two \"\"quotes\"\"\"")
    assert(document.text().starts_with("name,value,note"))
    assert(document.columns() == ["name", "value", "note"])
    assert(size(document.values()) == 2)
    assert(document.values()[0][0] == "severian")
    assert(document.values()[0][2] == "hello, world")
    assert(document.values()[1][2] == "two \"quotes\"")

test with integ "CSV file dispatch exposes dataframe and tensor operations":
    path = "/tmp/severian-data-dispatch.csv"
    file.write(path, "id,level,name\n1,10,Ada\n2,20,Grace\n")
    table = file.read(path)
    assert(table.columns() == ["id", "level", "name"])
    assert(table.where_not_empty("name").row_count() == 2)
    values = table.tensor(["id", "level"])
    assert(tensor.shape(values) == [2, 2])
    assert(tensor.values(values) == [1.0, 10.0, 2.0, 20.0])
    os.remove(path)
