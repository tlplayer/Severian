import data
from data import Data
import file

class YamlStreamFile: File
    def read(path: string) -> Data with { path.ends_with(".ymls") }:
        return yaml_stream_data_from_text(file.read_text(path))

class YamlFile: File
    def read(path: string) -> Data with { path.ends_with(".yml") or path.ends_with(".yaml") }:
        return yaml_data_from_text(file.read_text(path))

class Document: data.DataSource
    source: string
    stream: bool
    columns_data: list[string]
    rows_data: list[list[Any]]

    def text() -> string:
        return source

    def columns() -> list[string]:
        return columns_data

    def values() -> list[list[Any]]:
        return rows_data

def unquote(value: string) -> string:
    stripped = value.strip()
    if size(stripped) >= 2 and ((stripped.starts_with("\"") and stripped.ends_with("\"")) or (stripped.starts_with("'") and stripped.ends_with("'"))):
        return stripped[1:-1]
    return stripped

def tabular(source: string, stream: bool) -> Document:
    rows: list[list[Any]] := []
    section := ""
    for original in source.split("\n"):
        line = original.strip()
        if size(line) == 0 or line.starts_with("#") or line == "---":
            continue
        if not original.starts_with(" ") and not original.starts_with("-") and line.ends_with(":"):
            section = line[0:-1].strip()
            continue
        if line.starts_with("-"):
            value: list[Any] := [section, unquote(line[1:].strip())]
            rows.append(value)
            continue
        position = line.find(":")
        if position >= 0:
            value: list[Any] := [unquote(line[0:position]), unquote(line[position + 1:])]
            rows.append(value)
    return Document(source, stream, ["key", "value"], rows)

def decode(source: string) -> Document:
    return tabular(source, false)

def decode_stream(source: string) -> Document:
    return tabular(source, true)

def encode(document: Document) -> string:
    return document.source

def yaml_data_from_text(source: string) -> Data:
    document = decode(source)
    return Data(document.columns(), document.values())

def yaml_stream_data_from_text(source: string) -> Data:
    document = decode_stream(source)
    return Data(document.columns(), document.values())

def read(path: string) -> Data:
    return yaml_data_from_text(file.read_text(path))

def read_stream(path: string) -> Data:
    return yaml_stream_data_from_text(file.read_text(path))

test "YAML adapters retain ordinary and stream documents":
    ordinary = decode("human:\n- Ada\n- Grace\nzone: Stormwind")
    stream = decode_stream("---\nservice: one\n---\nservice: two")
    assert(ordinary.text().starts_with("human:"))
    assert(stream.stream)
    assert(ordinary.columns() == ["key", "value"])
    assert(ordinary.values()[0][0] == "human")
    assert(ordinary.values()[1][1] == "Grace")
