from data import Data
from data import Row
from data import Schema
from data import Table
import file
import tensor

class YamlStreamFile: File
    def read(path: string) -> Yaml with { path.ends_with(".ymls") }:
        return decode_stream(file.read_text(path))

class YamlFile: File
    def read(path: string) -> Yaml with { path.ends_with(".yml") or path.ends_with(".yaml") }:
        return decode(file.read_text(path))

class Yaml: Data
    source_text: string
    stream: bool
    content: Table

    operator [](column: string) -> list[Any]:
        return content.get(column)
    operator [](row: int) -> Row:
        return content.rows()[row]
    operator [](row: int, column: string) -> Any:
        return content.rows()[row].get(column)
    operator [](row: int, column: int) -> Any:
        return content.values()[row][column]

    def text() -> string:
        return source_text
    def data() -> Table:
        return content.collect()
    def schema() -> Schema:
        return content.schema()
    def columns() -> list[string]:
        return content.columns()
    def rows() -> list[Row]:
        return content.rows()
    def values() -> list[list[Any]]:
        return content.values()
    def records() -> list[list[Any]]:
        return content.records()
    def row_count() -> int:
        return content.row_count()
    def has_column(column: string) -> bool:
        return content.has_column(column)
    def get(column: string) -> list[Any]:
        return content.get(column)
    def column(column: string) -> list[Any]:
        return content.column(column)
    def select(columns: list[string]) -> Table:
        return content.select(columns)
    def drop(columns: list[string]) -> Table:
        return content.drop(columns)
    def rename(source: string, destination: string) -> Table:
        return content.rename(source, destination)
    def require_columns(required: list[string]) -> Table:
        return content.require_columns(required)
    def lower(column: string) -> Table:
        return content.lower(column)
    def transform(column: string, operation: (Any) -> Any) -> Table:
        return content.transform(column, operation)
    def strip(columns: list[string]) -> Table:
        return content.strip(columns)
    def where_not_empty(column: string) -> Table:
        return content.where_not_empty(column)
    def filter(predicate: (Row) -> bool) -> Table:
        return content.filter(predicate)
    def sort(column: string) -> Table:
        return content.sort(column)
    def sort_descending(column: string) -> Table:
        return content.sort_descending(column)
    def unique(columns: list[string]) -> Table:
        return content.unique(columns)
    def unique_normalized(columns: list[string], lowercase_columns: list[string], trim_strings: bool) -> Table:
        return content.unique_normalized(columns, lowercase_columns, trim_strings)
    def unique_by(columns: list[string], normalize: (string, Any) -> Any) -> Table:
        return content.unique_by(columns, normalize)
    def index(columns: list[string]) -> map[string, bool]:
        return content.index(columns)
    def index_by(columns: list[string], normalize: (string, Any) -> Any) -> map[string, bool]:
        return content.index_by(columns, normalize)
    def group(columns: list[string]) -> list[Table]:
        return content.group(columns)
    def collapse_text(match_column: string, match_values: list[string], group_columns: list[string], text_column: string) -> Table:
        return content.collapse_text(match_column, match_values, group_columns, text_column)
    def group_merge(predicate: (Row) -> bool, columns: list[string], merge: (Table) -> Row) -> Table:
        return content.group_merge(predicate, columns, merge)
    def limit(count: int) -> Table:
        return content.limit(count)
    def collect() -> Table:
        return content.collect()
    def explain() -> string:
        return content.explain()
    def sql(statement: string) -> Table:
        return content.sql(statement)
    def as_map() -> map[string, Any]:
        return content.as_map()
    def tensor(columns: list[string] = []) -> tensor.Tensor[f64]:
        return content.tensor(columns)

def unquote(value: string) -> string:
    stripped = value.strip()
    if size(stripped) >= 2 and ((stripped.starts_with("\"") and stripped.ends_with("\"")) or (stripped.starts_with("'") and stripped.ends_with("'"))):
        return stripped[1:-1]
    return stripped

def tabular(source: string, stream: bool) -> Yaml:
    rows: list[list[Any]] := []
    section := ""
    for original in source.split("\n"):
        line = original.strip()
        if size(line) == 0 or line.starts_with("#") or line == "---":
            continue
        if not original.starts_with(" ") and not original.starts_with("-") and line.ends_with(":"):
            section = line[0:-1].strip()
            continue
        if line.starts_with("-"):
            value: list[Any] := [section, unquote(line[1:].strip())]
            rows.append(value)
            continue
        position = line.find(":")
        if position >= 0:
            value: list[Any] := [unquote(line[0:position]), unquote(line[position + 1:])]
            rows.append(value)
    return Yaml(source, stream, Table(["key", "value"], rows))

def decode(source: string) -> Yaml:
    return tabular(source, false)

def decode_stream(source: string) -> Yaml:
    return tabular(source, true)

def encode(value: Yaml) -> string:
    return value.text()

def read(path: string) -> Yaml:
    return decode(file.read_text(path))

def read_stream(path: string) -> Yaml:
    return decode_stream(file.read_text(path))

test "YAML values implement Data directly":
    ordinary = decode("human:\n- Ada\n- Grace\nzone: Stormwind")
    stream = decode_stream("---\nservice: one\n---\nservice: two")
    assert(ordinary.text().starts_with("human:"))
    assert(stream.stream)
    assert(ordinary.columns() == ["key", "value"])
    assert(ordinary[0, "key"] == "human")
    assert(ordinary["value"] == ["Ada", "Grace", "Stormwind"])
