import tensor
import "expression.sev" as expression
import "query.sev" as query
import "schema.sev" as schema_logic
import "sql.sev" as sql_parser

class Schema:
    columns: list[string]
    types: list[string]
    nullable: list[bool]
    def has(column: string) -> bool:
        return column in columns

def column(name: string) -> expression.Column:
    return expression.column(name)

def equal(name: string, value: Any) -> expression.Expression:
    return expression.compare(name, "=", value)

def greater_or_equal(name: string, value: Any) -> expression.Expression:
    return expression.compare(name, ">=", value)

def all_of(left: expression.Expression, right: expression.Expression) -> expression.Expression:
    return expression.Expression("and", "", true, [left, right])

def any_of(left: expression.Expression, right: expression.Expression) -> expression.Expression:
    return expression.Expression("or", "", true, [left, right])

def column_position(columns: list[string], name: string) -> int:
    for index, column in enumerate(columns):
        if column == name:
            return index
    return -1

def cell_at(values: list[Any], position: int) -> Any:
    return values[position] if position >= 0 and position < size(values) else ""

def row_map(columns: list[string], values: list[Any]) -> map[string, Any]:
    result: map[string, Any] := {}
    for index in range(int(size(columns))):
        result[columns[index]] = cell_at(values, index)
    return result

class Row:
    columns_data: list[string]
    values_data: list[Any]
    def get(column: string) -> Any:
        return cell_at(values_data, column_position(columns_data, column))

    def values() -> list[Any]:
        return values_data
    def as_map() -> map[string, Any]:
        return row_map(columns_data, values_data)

    def select(columns: list[string]) -> Row:
        selected: list[Any] := []
        for column in columns:
            selected.append(cell_at(values_data, column_position(columns_data, column)))
        return Row(columns, selected)

def values_for(columns: list[string], row: Row) -> list[Any]:
    values: list[Any] := []
    for column in columns:
        values.append(row.get(column))
    return values

def normalized_key(row: Row, columns: list[string], lowercase_columns: list[string], trim_strings: bool) -> string:
    values: list[string] := []
    for column in columns:
        value := row.get(column)
        if trim_strings:
            value = string(value).strip()
        if column in lowercase_columns:
            value = string(value).lower()
        values.append(string(value).replace("\\", "\\\\").replace("|", "\\|"))
    return values.join("|")

def callback_key(row: Row, columns: list[string], normalize: (string, Any) -> Any) -> string:
    values: list[string] := []
    for column in columns:
        values.append(string(normalize(column, row.get(column))).replace("\\", "\\\\").replace("|", "\\|"))
    return values.join("|")

def project_records(source_columns: list[string], source_rows: list[list[Any]], columns: list[string]) -> Table:
    selected: list[list[Any]] := []
    for values in source_rows:
        row = Row(source_columns, values)
        selected.append(values_for(columns, row))
    return Table(columns, selected)

def deduplicate_records(source_columns: list[string], source_rows: list[list[Any]], columns: list[string], lowercase_columns: list[string], trim_strings: bool) -> Table:
    seen: map[string, bool] := {}
    retained: list[list[Any]] := []
    for values in source_rows:
        row = Row(source_columns, values)
        key = normalized_key(row, columns, lowercase_columns, trim_strings)
        if not seen.get(key, false):
            retained.append(values)
            seen[key] = true
    return Table(source_columns, retained)

def deduplicate_records_by(source_columns: list[string], source_rows: list[list[Any]], columns: list[string], normalize: (string, Any) -> Any) -> Table:
    seen: map[string, bool] := {}
    retained: list[list[Any]] := []
    for values in source_rows:
        row = Row(source_columns, values)
        key = callback_key(row, columns, normalize)
        if not seen.get(key, false):
            retained.append(values)
            seen[key] = true
    return Table(source_columns, retained)

def index_records_by(source_columns: list[string], source_rows: list[list[Any]], columns: list[string], normalize: (string, Any) -> Any) -> map[string, bool]:
    index: map[string, bool] := {}
    for values in source_rows:
        index[callback_key(Row(source_columns, values), columns, normalize)] = true
    return index

def group_records(source_columns: list[string], source_rows: list[list[Any]], columns: list[string]) -> list[Table]:
    order: list[string] := []
    groups: map[string, list[list[Any]]] := {}
    for values in source_rows:
        row = Row(source_columns, values)
        key = normalized_key(row, columns, [], false)
        group = groups.get(key, [])
        if size(group) == 0:
            order.append(key)
        group.append(values)
        groups[key] = group
    result: list[Table] = []
    for key in order:
        result.append(Table(source_columns, groups.get(key, [])))
    return result

def group_merge_records(
    source_columns: list[string],
    source_rows: list[list[Any]],
    predicate: (Row) -> bool,
    columns: list[string],
    merge: (Table) -> Row,
) -> Table:
    groups: map[string, list[list[Any]]] := {}
    selected_keys: list[string] := []
    for values in source_rows:
        row = Row(source_columns, values)
        if predicate(row):
            key = normalized_key(row, columns, [], false)
            group = groups.get(key, [])
            group.append(values)
            groups[key] = group
            selected_keys.append(key)
        else:
            selected_keys.append("")
    emitted: map[string, bool] := {}
    retained: list[list[Any]] := []
    for index, values in enumerate(source_rows):
        key = selected_keys[index]
        if size(key) == 0:
            retained.append(values)
            continue
        if not emitted.get(key, false):
            combined = merge(Table(source_columns, groups.get(key, [])))
            retained.append(values_for(source_columns, combined))
            emitted[key] = true
    return Table(source_columns, retained)

def collapse_text_records(
    source_columns: list[string],
    source_rows: list[list[Any]],
    match_column: string,
    match_values: list[string],
    group_columns: list[string],
    text_column: string,
) -> Table:
    order: list[string] := []
    groups: map[string, list[list[Any]]] := {}
    retained: list[list[Any]] := []
    match_position = column_position(source_columns, match_column)
    text_position = column_position(source_columns, text_column)
    for values in source_rows:
        matched = match_position >= 0 and string(cell_at(values, match_position)).lower() in match_values
        if not matched:
            retained.append(values)
            continue
        key = normalized_key(Row(source_columns, values), group_columns, [], false)
        group = groups.get(key, [])
        if size(group) == 0:
            order.append(key)
        group.append(values)
        groups[key] = group
    order = order.sorted()
    seen_texts: map[string, bool] := {}
    for key in order:
        group = groups.get(key, [])
        if size(group) == 0:
            continue
        texts: list[string] := []
        for values in group:
            text = string(cell_at(values, text_position))
            if not seen_texts.get(text, false):
                texts.append(text)
                seen_texts[text] = true
        if size(texts) == 0:
            continue
        merged: list[Any] := []
        for value in group[0]:
            merged.append(value)
        if text_position >= 0:
            merged[text_position] = texts.join(" ").strip()
        retained.append(merged)
    return Table(source_columns, retained)

def sorted_records(source_columns: list[string], source_rows: list[list[Any]], column: string, descending: bool) -> Table:
    position = column_position(source_columns, column)
    if position < 0:
        return Table(source_columns, source_rows)
    used: list[bool] := []
    for values in source_rows:
        used.append(false)
    ordered: list[list[Any]] := []
    while size(ordered) < size(source_rows):
        best := -1
        for index in range(int(size(source_rows))):
            if used[index]:
                continue
            if best < 0:
                best = index
                continue
            candidate = cell_at(source_rows[index], position)
            current = cell_at(source_rows[best], position)
            if (candidate > current and descending) or (candidate < current and not descending):
                best = index
        if best < 0:
            break
        ordered.append(source_rows[best])
        used[best] = true
    return Table(source_columns, ordered)

def selected_data(columns: list[string], rows: list[list[Any]], steps: list[query.Step], source: string, selected: list[string]) -> Table:
    if size(steps) > 0:
        planned = query.copied(steps)
        planned.append(query.project(selected))
        return Table(columns, rows, planned, source)
    return project_records(columns, rows, selected)

def where_data(columns: list[string], rows: list[list[Any]], steps: list[query.Step], source: string, predicate: expression.Expression) -> Table:
    planned = query.copied(steps)
    if size(planned) == 0:
        planned.append(query.Step("scan", [], expression.literal(true), 0, false))
    planned.append(query.filter(predicate))
    return Table(columns, rows, planned, source)

def sorted_data(columns: list[string], rows: list[list[Any]], steps: list[query.Step], source: string, column: string, descending: bool) -> Table:
    if size(steps) > 0:
        planned = query.copied(steps)
        planned.append(query.sort(column, descending))
        return Table(columns, rows, planned, source)
    return sorted_records(columns, rows, column, descending)

def limited_data(columns: list[string], rows: list[list[Any]], steps: list[query.Step], source: string, count: int) -> Table:
    assert(count >= 0, "Table.limit requires a non-negative row count")
    if size(steps) == 0:
        end = count if count < int(size(rows)) else int(size(rows))
        return Table(columns, rows[0:end])
    planned = query.copied(steps)
    planned.append(query.limit(count))
    return Table(columns, rows, planned, source)

def materialized_data(columns: list[string], rows: list[list[Any]], steps: list[query.Step]) -> Table:
    result := Table(columns, rows)
    for step in steps:
        if step.operation == "scan":
            continue
        if step.operation == "filter":
            retained: list[list[Any]] := []
            for values in result.rows_data:
                if expression.evaluate(step.predicate, row_map(result.columns_data, values)):
                    retained.append(values)
            result = Table(result.columns_data, retained)
            continue
        if step.operation == "project":
            result = project_records(result.columns_data, result.rows_data, step.columns)
            continue
        if step.operation == "sort":
            result = sorted_records(result.columns_data, result.rows_data, step.columns[0], step.descending)
            continue
        if step.operation == "limit":
            result = limited_data(result.columns_data, result.rows_data, [], "memory", step.count)
    return result

def schema_data(columns: list[string], rows: list[list[Any]], steps: list[query.Step]) -> Schema:
    materialized = materialized_data(columns, rows, steps)
    width = int(size(materialized.columns_data))
    return Schema(materialized.columns_data, schema_logic.inferred_types(materialized.rows_data, width), schema_logic.inferred_nullability(materialized.rows_data, width))

def visible_columns(columns: list[string], rows: list[list[Any]], steps: list[query.Step]) -> list[string]:
    return materialized_data(columns, rows, steps).columns_data if size(steps) > 0 else columns

def visible_rows(columns: list[string], rows: list[list[Any]], steps: list[query.Step]) -> list[Row]:
    materialized = materialized_data(columns, rows, steps) if size(steps) > 0 else Table(columns, rows)
    result: list[Row] := []
    for values in materialized.rows_data:
        result.append(Row(materialized.columns_data, values))
    return result

def visible_values(columns: list[string], rows: list[list[Any]], steps: list[query.Step]) -> list[list[Any]]:
    return materialized_data(columns, rows, steps).rows_data if size(steps) > 0 else rows

def visible_records(columns: list[string], rows: list[list[Any]], steps: list[query.Step]) -> list[list[Any]]:
    materialized = materialized_data(columns, rows, steps) if size(steps) > 0 else Table(columns, rows)
    records: list[list[Any]] := []
    header: list[Any] := []
    for column in materialized.columns_data:
        header.append(column)
    records.append(header)
    for values in materialized.rows_data:
        records.append(values)
    return records

def first_row_map(columns: list[string], rows: list[list[Any]], steps: list[query.Step]) -> map[string, Any]:
    visible = visible_rows(columns, rows, steps)
    return visible[0].as_map() if size(visible) > 0 else {}

def tensor_data(
    columns: list[string],
    rows: list[list[Any]],
    steps: list[query.Step],
    selected_columns: list[string],
) -> tensor.Tensor[f64]:
    selected = selected_columns if size(selected_columns) > 0 else visible_columns(columns, rows, steps)
    assert(size(selected) > 0, "Table.tensor requires at least one column")
    materialized = project_records(columns, visible_values(columns, rows, steps), selected)
    flattened: list[float] := []
    for row in materialized.rows():
        for column in selected:
            flattened.append(float(string(row.get(column))))
    return tensor.tensor(flattened, [materialized.row_count(), int(size(selected))])

def required_data(source_columns: list[string], source_rows: list[list[Any]], required: list[string]) -> Table:
    columns: list[string] := []
    for column in required:
        if not (column in columns):
            columns.append(column)
    for column in source_columns:
        if not (column in columns):
            columns.append(column)
    return project_records(source_columns, source_rows, columns)

def lower_data(columns: list[string], rows: list[list[Any]], column: string) -> Table:
    position = column_position(columns, column)
    transformed: list[list[Any]] := []
    for original in rows:
        values: list[Any] := []
        for index in range(int(size(original))):
            value = original[index]
            if index == position:
                values.append(string(value).lower())
            else:
                values.append(value)
        transformed.append(values)
    return Table(columns, transformed)

def transformed_data(columns: list[string], rows: list[list[Any]], column: string, operation: (Any) -> Any) -> Table:
    position = column_position(columns, column)
    transformed: list[list[Any]] := []
    for original in rows:
        values: list[Any] := []
        for index in range(int(size(original))):
            if index == position:
                values.append(operation(original[index]))
            else:
                values.append(original[index])
        transformed.append(values)
    return Table(columns, transformed)

def stripped_data(columns: list[string], rows: list[list[Any]], selected_columns: list[string]) -> Table:
    transformed: list[list[Any]] := []
    for original in rows:
        values: list[Any] := []
        for index in range(int(size(original))):
            if columns[index] in selected_columns:
                values.append(string(original[index]).strip())
            else:
                values.append(original[index])
        transformed.append(values)
    return Table(columns, transformed)

def nonempty_data(columns: list[string], rows: list[list[Any]], column: string) -> Table:
    filtered: list[list[Any]] := []
    position = column_position(columns, column)
    for values in rows:
        if position >= 0 and size(string(cell_at(values, position)).strip()) > 0:
            filtered.append(values)
    return Table(columns, filtered)

def visible_column(columns: list[string], rows: list[list[Any]], steps: list[query.Step], column: string) -> list[Any]:
    materialized = materialized_data(columns, rows, steps) if size(steps) > 0 else Table(columns, rows)
    position = column_position(materialized.columns_data, column)
    result: list[Any] := []
    if position < 0:
        return result
    for values in materialized.rows_data:
        result.append(cell_at(values, position))
    return result

def explained_data(source: string, columns: list[string], query_steps: list[query.Step]) -> string:
    steps: list[query.Step] := []
    for step in query_steps:
        if step.operation != "scan":
            steps.append(step)
    return query.explain(source, columns, steps)

def sql_data(columns: list[string], rows: list[list[Any]], steps: list[query.Step], source: string, statement: string) -> Table:
    parsed = sql_parser.parse(statement)
    assert(parsed.error == "", parsed.error)
    assert(parsed.relation.lower() == "self", "instance SQL must read FROM self")
    result := Table(columns, rows, steps, source).lazy(source)
    if parsed.filter_column != "":
        result = where_data(result.columns_data, result.rows_data, result.query_steps, result.source_name, expression.compare(parsed.filter_column, parsed.filter_operation, parsed.filter_value))
    if parsed.order_column != "":
        result = sorted_data(result.columns_data, result.rows_data, result.query_steps, result.source_name, parsed.order_column, parsed.descending)
    if parsed.columns != ["*"]:
        result = selected_data(result.columns_data, result.rows_data, result.query_steps, result.source_name, parsed.columns)
    if parsed.limit_count >= 0:
        result = limited_data(result.columns_data, result.rows_data, result.query_steps, result.source_name, parsed.limit_count)
    return result

trait Data:
    @data

    operator [](key: Any) -> Any
    def text() -> string
    def data() -> Table
    def schema() -> Schema
    def columns() -> list[string]
    def rows() -> list[Row]
    def values() -> list[list[Any]]
    def records() -> list[list[Any]]
    def row_count() -> int
    def has_column(column: string) -> bool
    def get(column: string) -> list[Any]
    def column(column: string) -> list[Any]
    def select(columns: list[string]) -> Table
    def drop(columns: list[string]) -> Table
    def rename(source: string, destination: string) -> Table
    def require_columns(required: list[string]) -> Table
    def lower(column: string) -> Table
    def transform(column: string, operation: (Any) -> Any) -> Table
    def strip(columns: list[string]) -> Table
    def where_not_empty(column: string) -> Table
    def filter(predicate: (Row) -> bool) -> Table
    def sort(column: string) -> Table
    def sort_descending(column: string) -> Table
    def unique(columns: list[string]) -> Table
    def unique_normalized(columns: list[string], lowercase_columns: list[string], trim_strings: bool) -> Table
    def unique_by(columns: list[string], normalize: (string, Any) -> Any) -> Table
    def index(columns: list[string]) -> map[string, bool]
    def index_by(columns: list[string], normalize: (string, Any) -> Any) -> map[string, bool]
    def group(columns: list[string]) -> list[Table]
    def collapse_text(match_column: string, match_values: list[string], group_columns: list[string], text_column: string) -> Table
    def group_merge(predicate: (Row) -> bool, columns: list[string], merge: (Table) -> Row) -> Table
    def limit(count: int) -> Table
    def collect() -> Table
    def explain() -> string
    def sql(statement: string) -> Table
    def as_map() -> map[string, Any]
    def tensor(columns: list[string] = []) -> tensor.Tensor[f64]

class Table: Data
    columns_data: list[string]
    rows_data: list[list[Any]]
    query_steps: list[query.Step]
    source_name: string

    def Table(columns: list[string], rows: list[list[Any]]):
        columns_data = columns
        rows_data = rows
        query_steps = []
        source_name = "memory"

    def Table(columns: list[string], rows: list[list[Any]], steps: list[query.Step], source: string):
        columns_data = columns
        rows_data = rows
        query_steps = steps
        source_name = source

    operator [](column: string) -> list[Any]:
        return visible_column(columns_data, rows_data, query_steps, column)

    operator [](row: int) -> Row:
        return visible_rows(columns_data, rows_data, query_steps)[row]

    operator [](row: int, column: string) -> Any:
        return visible_rows(columns_data, rows_data, query_steps)[row].get(column)

    operator [](row: int, column: int) -> Any:
        return cell_at(visible_values(columns_data, rows_data, query_steps)[row], column)

    def data() -> Table:
        return self.collect()

    def text() -> string:
        return string(self.records())

    def is_lazy() -> bool:
        return size(query_steps) > 0

    def lazy(source: string = "memory") -> Table:
        return Table(columns_data, rows_data, [query.Step("scan", [], expression.literal(true), 0, false)], source)

    def plan() -> list[query.Step]:
        return query.copied(query_steps)
    def schema() -> Schema:
        return schema_data(columns_data, rows_data, query_steps)

    def columns() -> list[string]:
        return visible_columns(columns_data, rows_data, query_steps)

    def rows() -> list[Row]:
        return visible_rows(columns_data, rows_data, query_steps)

    def values() -> list[list[Any]]:
        return visible_values(columns_data, rows_data, query_steps)

    def records() -> list[list[Any]]:
        return visible_records(columns_data, rows_data, query_steps)
    def row_count() -> int:
        if self.is_lazy():
            return int(size(self.collect().rows_data))
        return int(size(rows_data))

    def has_column(column: string) -> bool:
        if self.is_lazy():
            return self.collect().has_column(column)
        return column_position(columns_data, column) >= 0
    def get(column: string) -> list[Any]:
        return visible_column(columns_data, rows_data, query_steps, column)
    def column(column: string) -> list[Any]:
        return visible_column(columns_data, rows_data, query_steps, column)
    def select(columns: list[string]) -> Table:
        return selected_data(columns_data, rows_data, query_steps, source_name, columns)
    def drop(columns: list[string]) -> Table:
        retained: list[string] := []
        for column in columns_data:
            if not (column in columns):
                retained.append(column)
        return project_records(columns_data, rows_data, retained)
    def rename(source: string, destination: string) -> Table:
        columns: list[string] := []
        for column in columns_data:
            columns.append(destination if column == source else column)
        copied: list[list[Any]] := []
        for values in rows_data:
            copied.append(values)
        return Table(columns, copied)

    def require_columns(required: list[string]) -> Table:
        return required_data(columns_data, rows_data, required)

    def append(row: map[string, Any]):
        values: list[Any] := []
        for column in columns_data:
            values.append(row.get(column, ""))
        rows_data.append(values)

    def append_row(row: Row):
        rows_data.append(values_for(columns_data, row))

    def extend(other: Table):
        for row in other.rows():
            rows_data.append(values_for(columns_data, row))

    def lower(column: string) -> Table:
        return lower_data(columns_data, rows_data, column)

    def transform(column: string, operation: (Any) -> Any) -> Table:
        return transformed_data(columns_data, rows_data, column, operation)

    def strip(columns: list[string]) -> Table:
        return stripped_data(columns_data, rows_data, columns)

    def where_not_empty(column: string) -> Table:
        return nonempty_data(columns_data, rows_data, column)

    def filter(predicate: (Row) -> bool) -> Table:
        filtered: list[list[Any]] := []
        for values in rows_data:
            row = Row(columns_data, values)
            if predicate(row):
                filtered.append(values)
        return Table(columns_data, filtered)

    def where(predicate: expression.Expression) -> Table:
        return where_data(columns_data, rows_data, query_steps, source_name, predicate)

    def filter_expression(predicate: expression.Expression) -> Table:
        return self.where(predicate)

    def sort(column: string) -> Table:
        return sorted_data(columns_data, rows_data, query_steps, source_name, column, false)

    def sort_descending(column: string) -> Table:
        return sorted_data(columns_data, rows_data, query_steps, source_name, column, true)

    def unique(columns: list[string]) -> Table:
        return deduplicate_records(columns_data, rows_data, columns, [], false)

    def unique_normalized(columns: list[string], lowercase_columns: list[string], trim_strings: bool) -> Table:
        return deduplicate_records(columns_data, rows_data, columns, lowercase_columns, trim_strings)

    def unique_by(columns: list[string], normalize: (string, Any) -> Any) -> Table:
        return deduplicate_records_by(columns_data, rows_data, columns, normalize)

    def index(columns: list[string]) -> map[string, bool]:
        return index_records_by(columns_data, rows_data, columns, |column, value| value)

    def index_by(columns: list[string], normalize: (string, Any) -> Any) -> map[string, bool]:
        return index_records_by(columns_data, rows_data, columns, normalize)

    def group(columns: list[string]) -> list[Table]:
        return group_records(columns_data, rows_data, columns)

    def collapse_text(match_column: string, match_values: list[string], group_columns: list[string], text_column: string) -> Table:
        return collapse_text_records(columns_data, rows_data, match_column, match_values, group_columns, text_column)

    def group_merge(
        predicate: (Row) -> bool,
        columns: list[string],
        merge: (Table) -> Row,
    ) -> Table:
        return group_merge_records(columns_data, rows_data, predicate, columns, merge)

    def limit(count: int) -> Table:
        return limited_data(columns_data, rows_data, query_steps, source_name, count)

    def collect() -> Table:
        return materialized_data(columns_data, rows_data, query_steps)

    def explain() -> string:
        return explained_data(source_name, columns_data, query_steps)

    def sql(statement: string) -> Table:
        return sql_data(columns_data, rows_data, query_steps, source_name, statement)

    def as_map() -> map[string, Any]:
        return first_row_map(columns_data, rows_data, query_steps)

    def tensor(columns: list[string] = []) -> tensor.Tensor[f64]:
        return tensor_data(columns_data, rows_data, query_steps, columns)

def table(source: Table) -> Table:
    return source

def example_data() -> Table:
    return Table(["name", "group"], [["Ada", "A"], ["Grace", "B"], ["Ada", "a"]])

test "Table provides schema projection, filtering, transforms, and uniqueness":
    constructed := Table(["name"], [["Ada"], ["Grace"]])
    assert(constructed.where(equal("name", "Ada")).collect().row_count() == 1)
    table := example_data()
    assert(table.columns() == ["name", "group"])
    assert(table.rows()[0].get("name") == "Ada")
    assert(table.get("name") == ["Ada", "Grace", "Ada"])
    assert(table["name"] == ["Ada", "Grace", "Ada"])
    assert(table.select(["group"]).records() == [["group"], ["A"], ["B"], ["a"]])
    assert(table.require_columns(["id", "name"]).columns() == ["id", "name", "group"])
    assert(table.where_not_empty("name").row_count() == 3)
    assert(table.lower("group").get("group") == ["a", "b", "a"])
    assert(table.unique_normalized(["name", "group"], ["group"], false).row_count() == 2)
    assert(table.where(equal("name", "Ada")).collect().row_count() == 2)
    assert(table.lower("group").get("group") == ["a", "b", "a"])
    assert(table.sort("name").get("name") == ["Ada", "Ada", "Grace"])
    groups = table.group(["name"])
    assert(size(groups) == 2)
    assert(groups[0].get("name") == ["Ada", "Ada"])

test "collapse_text provides dataframe-style grouped text aggregation":
    table := Table(
        ["name", "note"],
        [["Ada", "first"], ["Grace", "middle"], ["Ada", "second"], ["Grace", "last"]],
    )
    merged = table.collapse_text("name", ["ada"], ["name"], "note")
    assert(size(merged.values()) == 3)
    assert(merged.values()[0][0] == "Grace")
    assert(merged.values()[2][1] == "first second")

test "expression queries stay lazy until collection and expose their plan":
    table := Table(["name", "age", "active"], [["Ada", 36, true], ["Grace", 17, true], ["Linus", 28, false], ["Edsger", 42, true]])
    adults = table.where(all_of(greater_or_equal("age", 18), equal("active", true))).select(["name", "age"]).sort_descending("age").limit(2)
    assert(adults.is_lazy())
    assert(adults.explain() == "DataQuery\n  Scan memory [name, age, active]\n  -> Filter (age >= 18 and active = true)\n  -> Project name, age\n  -> Sort age descending\n  -> Limit 2")
    assert(adults.collect().records() == [["name", "age"], ["Edsger", 42], ["Ada", 36]])
    assert(adults.schema().columns == ["name", "age"])
    assert(adults.schema().types == ["string", "integer"])

test "instance SQL lowers to the same query steps":
    table := Table(["name", "age", "active"], [["Ada", 36, true], ["Grace", 17, true], ["Edsger", 42, true]])
    result = table.sql("SELECT name, age FROM self WHERE active = true ORDER BY age DESC LIMIT 1")
    assert(result.is_lazy())
    assert(result.collect().columns() == ["name", "age"])
    assert(result.collect().row_count() == 1)
    assert(result.collect().rows()[0].get("name") == "Edsger")
    assert(result.collect().rows()[0].get("age") == 42)
