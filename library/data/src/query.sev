import "expression.sev" as expression

class Step:
    operation: string
    columns: list[string]
    predicate: expression.Expression
    count: int
    descending: bool

    def describe() -> string:
        return operation

def describe_step(operation: string, columns: list[string], predicate: expression.Expression, count: int, descending: bool) -> string:
    if operation == "filter":
        return "Filter " + expression.describe_expression(predicate.operation, predicate.column_name, predicate.literal_value, predicate.operands)
    if operation == "project":
        return "Project " + columns.join(", ")
    if operation == "sort":
        direction = " descending" if descending else " ascending"
        return "Sort " + columns[0] + direction
    if operation == "limit":
        return "Limit " + string(count)
    return operation

def filter(predicate: expression.Expression) -> Step:
    return Step("filter", [], predicate, 0, false)

def project(columns: list[string]) -> Step:
    return Step("project", columns, expression.literal(true), 0, false)

def sort(column: string, descending: bool = false) -> Step:
    return Step("sort", [column], expression.literal(true), 0, descending)

def limit(count: int) -> Step:
    return Step("limit", [], expression.literal(true), count, false)

def copied(steps: list[Step]) -> list[Step]:
    result: list[Step] := []
    for step in steps:
        result.append(step)
    return result

def explain(source: string, columns: list[string], steps: list[Step]) -> string:
    output := "DataQuery\n  Scan " + source + " [" + columns.join(", ") + "]"
    for step in steps:
        output += "\n  -> " + describe_step(step.operation, step.columns, step.predicate, step.count, step.descending)
    return output
