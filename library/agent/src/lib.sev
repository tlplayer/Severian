import json

class ModelConfig:
    endpoint: string
    model: string
    context_tokens: int
    output_tokens: int
    temperature: float
    timeout_millis: int

class AgentLimits:
    attempts: int
    command_timeout_millis: int
    max_output_bytes: int
    compact_at_tokens: int

class ToolCall:
    name: string
    arguments: string

class ModelReply:
    content: string
    tool_calls: list[ToolCall]
    prompt_tokens: int
    output_tokens: int
    stopped: bool

class CommandResult:
    command: string
    exit_code: int
    stdout: string
    stderr: string
    timed_out: bool

class AgentState:
    goal: string
    iteration: int
    completed: list[string]
    modified_files: list[string]
    failures: list[string]
    next_action: string

class AgentResult:
    success: bool
    iterations: int
    message: string
    state: AgentState

unsafe:
    extern("__sev_agent_model_request") def model_request(
        endpoint: string,
        model: string,
        system_prompt: string,
        prompt: string,
        context_tokens: int,
        output_tokens: int,
        temperature: float,
        timeout_millis: int,
    ) -> ModelReply | string

    extern("__sev_agent_execute") def execute_command(
        workspace: string,
        command: string,
        timeout_millis: int,
        max_output_bytes: int,
    ) -> CommandResult | string

    extern("__sev_agent_read_file") def read_file(path: string) -> string | string

    extern("__sev_agent_write_file") def write_file(path: string, content: string) -> int | string

    extern("__sev_agent_git_status") def git_status(workspace: string) -> Result[list[string], string]

    extern("__sev_agent_reset_workspace") def reset_workspace(workspace: string) -> int | string

def default_model_config() -> ModelConfig:
    return ModelConfig(
        "http://127.0.0.1:11434",
        "qwen3.5:9b",
        16384,
        4096,
        0.1,
        120000,
    )

def default_agent_limits() -> AgentLimits:
    return AgentLimits(
        20,
        600000,
        1048576,
        2048,
    )

def empty_state(goal: string) -> AgentState:
    return AgentState(
        goal,
        0,
        [],
        [],
        [],
        "inspect the repository",
    )

def system_prompt() -> string:
    return """
You are a Severian development agent.

Use tools instead of describing your capabilities.
Inspect the repository before modifying it.
Make the smallest change that advances the goal.
Run relevant tests after every change.
Do not claim success unless verification passes.
When blocked by the Severian compiler, isolate the smallest reproducer,
add a regression test, fix the compiler, and continue.
"""

def command_tool_description() -> string:
    return """
execute(command: string)

Runs a command inside the isolated workspace.
Use it to inspect files, edit files, compile code, and run tests.
"""

def state_prompt(state: AgentState) -> string:
    prompt := "Goal:\n" + state.goal
    prompt = prompt + "\n\nIteration: " + string(state.iteration)
    prompt = prompt + "\n\nCompleted:\n"

    for item in state.completed:
        prompt = prompt + "- " + item + "\n"

    prompt = prompt + "\nModified files:\n"

    for path in state.modified_files:
        prompt = prompt + "- " + path + "\n"

    prompt = prompt + "\nFailures:\n"

    for failure in state.failures:
        prompt = prompt + "- " + failure + "\n"

    prompt = prompt + "\nNext action:\n" + state.next_action
    prompt = prompt + "\n\nUse a tool now. Do not only explain what you will do."

    return prompt

def compact_state(state: AgentState) -> string:
    return json.encode(state)

def save_state(path: string, state: AgentState) -> int | string:
    return write_file(path, compact_state(state))

def persist_state(path: string, state: AgentState):
    match save_state(path, state):
        ok bytesWritten:
            return
        failure error:
            print("warning: could not persist agent state: " + error)

def load_state(path: string, goal: string) -> AgentState:
    match read_file(path):
        ok content:
            match json.decode[AgentState](content):
                ok state:
                    return state
                failure error:
                    return empty_state(goal)
        failure error:
            return empty_state(goal)

def append_error(state: AgentState, failure: string) -> AgentState:
    failures := []

    for previous in state.failures:
        failures.append(previous)

    failures.append(failure)

    return AgentState(
        state.goal,
        state.iteration,
        state.completed,
        state.modified_files,
        failures,
        state.next_action,
    )

def advance_state(
    state: AgentState,
    completed: string,
    modified_files: list[string],
    next_action: string,
) -> AgentState:
    completed_steps := []

    for previous in state.completed:
        completed_steps.append(previous)

    completed_steps.append(completed)

    return AgentState(
        state.goal,
        state.iteration + 1,
        completed_steps,
        modified_files,
        [],
        next_action,
    )

def replace_state(
    state: AgentState,
    iteration: int,
    modified_files: list[string],
    next_action: string,
) -> AgentState:
    return AgentState(
        state.goal,
        iteration,
        state.completed,
        modified_files,
        state.failures,
        next_action,
    )

def execute_tool(
    workspace: string,
    call: ToolCall,
    limits: AgentLimits,
) -> CommandResult:
    if call.name != "execute":
        return CommandResult(
            "",
            1,
            "",
            "unsupported tool: " + call.name,
            false,
        )

    match json.decode[string](call.arguments):
        ok command:
            match execute_command(
                workspace,
                command,
                limits.command_timeout_millis,
                limits.max_output_bytes,
            ):
                ok result:
                    return result
                failure error:
                    return CommandResult(
                        command,
                        1,
                        "",
                        error,
                        false,
                    )
        failure error:
            return CommandResult(
                "",
                1,
                "",
                "invalid tool arguments: " + error,
                false,
            )

def tool_result_prompt(result: CommandResult) -> string:
    output := "Command: " + result.command
    output = output + "\nExit code: " + string(result.exit_code)
    output = output + "\nTimed out: " + string(result.timed_out)
    output = output + "\n\nstdout:\n" + result.stdout
    output = output + "\n\nstderr:\n" + result.stderr

    if result.exit_code == 0 and not result.timed_out:
        output = output + "\n\nContinue with the next tool call."
    else:
        output = output + "\n\nDiagnose the failure, make the smallest correction, and retry."

    return output

def verify(
    workspace: string,
    command: string,
    limits: AgentLimits,
) -> CommandResult:
    match execute_command(
        workspace,
        command,
        limits.command_timeout_millis,
        limits.max_output_bytes,
    ):
        ok result:
            return result
        failure error:
            return CommandResult(
                command,
                1,
                "",
                error,
                false,
            )

def run_agent(
    workspace: string,
    goal: string,
    verification_command: string,
    state_path: string,
    config: ModelConfig = default_model_config(),
    limits: AgentLimits = default_agent_limits(),
) -> AgentResult:
    state := load_state(state_path, goal)

    for attempt in range(0, limits.attempts):
        state = replace_state(
            state,
            attempt + 1,
            state.modified_files,
            state.next_action,
        )
        prompt = state_prompt(state)

        match model_request(
            config.endpoint,
            config.model,
            system_prompt() + "\n\n" + command_tool_description(),
            prompt,
            config.context_tokens,
            config.output_tokens,
            config.temperature,
            config.timeout_millis,
        ):
            failure error:
                state = append_error(state, error)
                persist_state(state_path, state)

            ok reply:
                if size(reply.tool_calls) == 0:
                    state = append_error(
                        state,
                        "model stopped without using a tool: " + reply.content,
                    )
                    state = replace_state(
                        state,
                        state.iteration,
                        state.modified_files,
                        "use the execute tool immediately",
                    )
                    persist_state(state_path, state)
                else:
                    for call in reply.tool_calls:
                        result = execute_tool(workspace, call, limits)

                        match model_request(
                            config.endpoint,
                            config.model,
                            system_prompt(),
                            tool_result_prompt(result),
                            config.context_tokens,
                            config.output_tokens,
                            config.temperature,
                            config.timeout_millis,
                        ):
                            ok followup:
                                if result.exit_code != 0 or result.timed_out:
                                    state = append_error(
                                        state,
                                        result.stderr,
                                    )
                            failure error:
                                state = append_error(state, error)

                    match git_status(workspace):
                        ok files:
                            state = replace_state(
                                state,
                                state.iteration,
                                files,
                                state.next_action,
                            )
                        failure error:
                            state = append_error(state, error)

                    verification = verify(
                        workspace,
                        verification_command,
                        limits,
                    )

                    if verification.exit_code == 0 and not verification.timed_out:
                        state = advance_state(
                            state,
                            "verification passed",
                            state.modified_files,
                            "complete",
                        )
                        persist_state(state_path, state)

                        return AgentResult(
                            true,
                            attempt + 1,
                            verification.stdout,
                            state,
                        )

                    state = append_error(
                        state,
                        tool_result_prompt(verification),
                    )
                    state = replace_state(
                        state,
                        state.iteration,
                        state.modified_files,
                        "fix the verification failure",
                    )
                    persist_state(state_path, state)

    return AgentResult(
        false,
        limits.attempts,
        "agent iteration limit reached",
        state,
    )

test "default limits bound the agent loop":
    limits = default_agent_limits()
    assert(limits.attempts == 20)
    assert(limits.command_timeout_millis == 600000)
    assert(limits.compact_at_tokens == 2048)

test "agent state begins with repository inspection":
    state = empty_state("build sev agent")
    assert(state.goal == "build sev agent")
    assert(state.iteration == 0)
    assert(state.next_action == "inspect the repository")

test "unsupported tools fail without execution":
    result = execute_tool(
        ".",
        ToolCall("unknown", "\"value\""),
        default_agent_limits(),
    )
    assert(result.exit_code == 1)
    assert(result.stderr == "unsupported tool: unknown")
