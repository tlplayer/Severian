#!/bin/sh
set -eu
launcher=$(readlink -f -- "$0")
repository=$(dirname -- "$(dirname -- "$(dirname -- "$launcher")")")
directory="$repository/package.pkg/bootstrap"
mkdir -p "$directory"
# Only std is needed to recover a compiler, even before Cargo can load it.
candidate="$directory/sev-update.$$"
trap 'rm -f "$candidate"' EXIT HUP INT TERM
"${RUSTC:-rustc}" --edition=2021 "$repository/rust_compiler/bootstrap/update.rs" -o "$candidate"
mv "$candidate" "$directory/sev-update"
trap - EXIT HUP INT TERM
exec "$directory/sev-update" --repository "$repository" "$@"
