import log
import network

enum ChatEvent:
    Join(client_id: int, outbound: Channel[string])
    Say(client_id: int, text: string)
    Leave(client_id: int)

def join_message(clientId: int) -> string:
    return "client " + string(clientId) + " joined"

test "join messages include the client id":
    assert(join_message(7) == "client 7 joined")

def broadcast(clients: map[int, Channel[string]], text: string):
    for _, outbound in clients:
        async send clone text with outbound

def run_hub(events: Channel[ChatEvent]):
    clients := {}

    match events while running with running := true:
        Join from events:
            clients[client_id] = move outbound
            broadcast(view clients, join_message(client_id))

        Say from events:
            broadcast(view clients, string(client_id) + ": " + text)

        Leave from events:
            clients.remove(client_id)
            broadcast(view clients, "client " + string(client_id) + " left")

        fail error:
            log.error("chat event channel collapsed", error)
            running = false

def write_client(writer: network.TCPWriter, outbound: Channel[string]):
    match outbound while connected with connected := true:
        message from outbound:
            match await writer.write_line(message):
                case _:
                    log.info("chat message delivered")

                failure _:
                    connected = false

        fail _:
            connected = false

def read_client(
    client_id: int,
    reader: network.TCPReader,
    events: Channel[ChatEvent],
):
    match await reader.read_line() while true:
        case message:
            await send Say(client_id, move message) with events

        failure _:
            await send Leave(client_id) with events
            return

def serve_client(
    client_id: int,
    connection: network.TCPConnection,
    events: Channel[ChatEvent],
):
    reader, writer = connection.split()
    outbound = Channel[string] with Buffer(64)

    await send Join(client_id, clone outbound) with events
    writing = async write_client(writer, outbound) with self and writer and outbound
    reading = async read_client(client_id, reader, clone events) with self and reader

    await reading, writing

def run_server() -> unit | IOError:
    listener = network.listen("127.0.0.1:7000")
    events = Channel[ChatEvent] with Buffer(256)
    hub = async run_hub(clone events) with self

    with listener:
        while true with next_client_id := 1:
            connection = await listener.accept()
            async serve_client(next_client_id, connection, clone events) with self and connection
            next_client_id += 1

    await hub
