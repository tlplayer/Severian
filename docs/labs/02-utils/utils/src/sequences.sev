def all[T](values: array[T]) -> bool:
    position = 0
    while position < len(values):
        if not bool(values[position]):
            return false
        position += 1
    return true


def any[T](values: array[T]) -> bool:
    position = 0
    while position < len(values):
        if bool(values[position]):
            return true
        position += 1
    return false


def size[T](values: array[T]) -> int:
    return len(values)


# Stable insertion sort returns independent storage and preserves its input.
def sort[T](values: array[T]) -> array[T]:
    result = copy values
    position = 1
    while position < len(result):
        item = copy result[position]
        destination = position
        while destination > 0:
            previous = copy result[destination - 1]
            if not (item < previous):
                break
            result[destination] = previous
            destination -= 1
        result[destination] = item
        position += 1
    return result


# Explicit bounds are normalized like sequence indices; stop is exclusive.
def slice[T](values: array[T], start: int, stop: int, step: int = 1) -> array[T]:
    assert(step != 0)
    count = len(values)
    first = i128(start)
    last = i128(stop)
    if first < 0:
        first += i128(count)
    if last < 0:
        last += i128(count)
    low: i128 = 0
    high = i128(count)
    if step < 0:
        low = -1
        high -= 1
    if first < low:
        first = low
    if first > high:
        first = high
    if last < low:
        last = low
    if last > high:
        last = high
    distance = last - first
    stride = i128(step)
    if stride < 0:
        distance = -distance
        stride = -stride
    length: i128 = 0
    if distance > 0:
        length = (distance - 1) // stride + 1
    result = array[T, int(length)]()
    position = 0
    cursor = first
    while position < int(length):
        result[position] = values[int(cursor)]
        cursor += i128(step)
        position += 1
    return result


def range(stop: int) -> array[int]:
    return range(0, stop, 1)


def range(start: int, stop: int, step: int = 1) -> array[int]:
    assert(step != 0)
    distance = i128(stop) - i128(start)
    stride = i128(step)
    if stride < 0:
        distance = -distance
        stride = -stride
    count: i128 = 0
    if distance > 0:
        count = (distance - 1) // stride + 1
    assert(count <= 9223372036854775807)
    result = array[int, int(count)]()
    position = 0
    cursor = i128(start)
    while position < int(count):
        result[position] = int(cursor)
        cursor += i128(step)
        position += 1
    return result


test "truth reductions and sorting preserve input":
    empty = array[int, 0]()
    assert(all(empty))
    assert(not any(empty))
    values = array[int, 3]()
    values[0] = 3
    values[1] = 0
    values[2] = 1
    assert(not all(values))
    assert(any(values))
    ordered = sort(values)
    assert(ordered[0] == 0)
    assert(ordered[1] == 1)
    assert(ordered[2] == 3)
    assert(values[0] == 3)
    assert(size(values) == 3)


test "ranges and slices respect exclusive stops and negative steps":
    values = range(0, 5, 1)
    assert(len(values) == 5)
    assert(values[4] == 4)
    descending = range(5, 0, -2)
    assert(len(descending) == 3)
    assert(descending[2] == 1)
    selected = slice(values, -4, 5, 2)
    assert(len(selected) == 2)
    assert(selected[0] == 1)
    assert(selected[1] == 3)
    reversed = slice(values, 4, -6, -1)
    assert(len(reversed) == 5)
    assert(reversed[4] == 0)
    edge = range(9223372036854775806, 9223372036854775807, 2)
    assert(len(edge) == 1)


test "range rejects zero step":
    throws "assertion failed":
        values = range(0, 5, 0)


test "slice rejects zero step":
    throws "assertion failed":
        values = array[int, 0]()
        result = slice(values, 0, 0, 0)
