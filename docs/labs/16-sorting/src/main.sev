test "Empty, singleton, duplicates and negative values":
    empty = bubble_sort([])
    assert(len(empty) == 0)
    singleton = bubble_sort([7])
    assert(singleton == [7])
    duplicates = bubble_sort([3, -1, 3, 0, -1])
    assert(duplicates == [-1, -1, 0, 3, 3])
    ordered = bubble_sort([1, 2, 3, 4])
    assert(ordered == [1, 2, 3, 4])

test with profile "Temporary enumeration is released after break" with {
    suffix profile.memory < 128KB,
}:
    values = [3, 1, 4, 1, 5, 9]
    repetitions = 0
    while repetitions < 2000:
        for index, value in enumerate(values):
            assert(value == values[index])
            if index == 2:
                break
        repetitions += 1
    assert(repetitions == 2000)

test with memory "Sorting and iterator cleanup are memory safe":
    repetitions = 0
    while repetitions < 100:
        values = bubble_sort([3, -1, 3, 0, -1])
        assert(values == [-1, -1, 0, 3, 3])
        for index, value in enumerate(values):
            assert(value == values[index])
            if index == 2:
                break
        repetitions += 1
