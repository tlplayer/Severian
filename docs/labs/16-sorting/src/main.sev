from collections import list, enumerate
from util import range

def bubble_sort(values: move list[int]) -> move list[int] with
{
    bubble_sort.complexity.time := BigO.quadratic,
    bubble_sort.complexity.space := BigO.constant,
    len(values) < 10000,
}:
    if not values:
        return move values
    end = len(values) - 1
    while end > 0:
        last_swap = 0
        i = 0
        while i < end:
            if values[i] > values[i + 1]:
                values[i], values[i + 1] = values[i + 1], values[i]
                last_swap = i
            i += 1
        end = last_swap
    return move values
   
def selection_sort(values:move list[int]) -> move list[int] with
{
    selection_sort.complexity.time := BigO.quadratic,
    selection_sort.complexity.space := BigO.constant,
    len(values) < 10000,
}:  
    for n in range(len(values)) with minimum = values[n]:
        for i,value in enumerate(values[n:]) with local.min_index = n:
            if value < minimum:
                minimum,min_index = value,n + i
        values[n],values[min_index] = minimum,values[n]

    return values


def insertion_sort(a:infer):
    # Forward swap then backwards swap 
    for i in range(1, len(a)):
        key = a[i]
        j = i-1
        # while the element to the left by 1 or right till end is 
        while j >= 0 and a[j] > key:
            a[j+1] = a[j] 
            j -= 1
        a[j+1] = key

    return a


def heap_sort(values: move list[int]) -> move list[int]:
    count = len(values)
    
    def heap_sift_down(values: borrow list[int], root: int, end: int):
        # Restore the max heap inside [0, end).
        while root * 2 + 1 < end:
            child = root * 2 + 1
            if child + 1 < end and values[child + 1] > values[child]:
                child += 1
            if values[root] >= values[child]:
                break
            values[root], values[child] = values[child], values[root]
            root = child
    # Build a max heap, starting with the last parent.
    root = count // 2
    while root > 0:
        root -= 1
        heap_sift_down(values, root, count)

    # Move each maximum to the sorted suffix, then repair the remaining heap.
    end = count
    while end > 1:
        end -= 1
        values[0], values[end] = values[end], values[0]
        heap_sift_down(values, 0, end)

    return move values


def main():
    insertion_sort([3,2,1,5,4])

test "insertion sort":
    empty = insertion_sort([])
    assert(len(empty) == 0)
    singleton = insertion_sort([7])
    assert(singleton == [7])
    ordered = insertion_sort([1, 2, 3, 4])
    assert(ordered == [1, 2, 3, 4])
    reversed = insertion_sort([4, 3, 2, 1])
    assert(reversed == [1, 2, 3, 4])
    zero = insertion_sort([0, 2, 1])
    assert(zero == [0, 1, 2])
    duplicates = insertion_sort([3, -1, 3, 0, -1])
    assert(duplicates == [-1, -1, 0, 3, 3])


test with differential "compare bubble and selection sort":
    differential(bubble_sort, selection_sort, times=100)

test "Selection sort initializes each pass and uses absolute indices":
    empty = selection_sort([])
    assert(len(empty) == 0)
    singleton = selection_sort([7])
    assert(singleton == [7])
    ordered = selection_sort([1, 2, 3, 4])
    assert(ordered == [1, 2, 3, 4])
    reversed = selection_sort([4, 3, 2, 1])
    assert(reversed == [1, 2, 3, 4])
    zero = selection_sort([0, 2, 1])
    assert(zero == [0, 1, 2])
    duplicates = selection_sort([3, -1, 3, 0, -1])
    assert(duplicates == [-1, -1, 0, 3, 3])
    

def verify_sorted(values: move list[int], expected: list[int]) -> bool with len(values) < 10000:
    result = bubble_sort(values)
    if result != expected:
        panic("sorted result differs from the expected values")
    return true

def verify_mismatch(values: move list[int], expected: list[int]) -> bool with len(values) < 10000:
    result = bubble_sort(values)
    if result == expected:
        panic("mismatched expected output was accepted")
    return true

test "Happy case":
    sorted = bubble_sort([1,2,3,4][::-1])
    assert(sorted == [1,2,3,4])


test with fuzz "Values within bounds are all valid":
    fuzz(bubble_sort, times=100)

    test "fuzz regression cb23ed845a5574d702ca":
        replay(verify_sorted, cases=[[[], []]])

    test "fuzz regression c9a11e5224d1b9c65b81":
        replay(verify_sorted, fixture="package.pkg/debug/test/fuzz/dev/cases/e39a16b1860acd39aa51901df11e59499093587397bf55ea7593a74595916948.json")

    test "Reject mismatched oracle fuzz regression d8bfd81b3108eb1e4ffd":
        replay(verify_mismatch, fixture="package.pkg/debug/test/fuzz/dev/cases/68538048d238f56af5d7a3da91003ef67bfd62cb53945a56cd6c8e0650eac4c5.json")

