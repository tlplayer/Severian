test "nested consumers have independent continuations":
    values = Vector()
    values.push(1)
    values.push(2)
    total = 0
    for a in values:
        for b in values:
            total += a * b
    assert(total == 9)


test "conditional yields preserve continuation":
    class Choices:
        enabled: bool
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            if self.enabled:
                yield 7
            else:
                yield 3
            yield 11
    choices = Choices(true)
    total = 0
    for value in choices:
        total += value
    assert(total == 18)


test with compiler "yield enforces the iterator element type":
    reject:
        class Items:
            value: int
            grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
                yield "wrong"
        def invalid():
            values = Items(1)
            for x in values:
                assert(x == 1)


test "repeated iterator expansions give stores unique MLIR temporaries":
    class Pair:
        value: int
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            scratch = array[int, 1]()
            scratch[0] = self.value
            yield scratch[0]
            scratch[0] += 1
            yield scratch[0]
    class Last:
        value: int
    pair = Pair(4)
    last = Last(0)
    output = array[int, 1]()
    for value in pair:
        output[0] += value
        last.value = value
    assert(output[0] == 9)
    assert(last.value == 5)
    for value in pair:
        output[0] += value
        last.value = value
    assert(output[0] == 18)
    assert(last.value == 5)


test "nested vector index assignment targets the indexed position":
    V = Vector()
    V.push(1)
    V.push(7)
    V.push(99)

    V[V[0]] = 42

    assert(V[1] == 42)
    assert(V[V[0]] == 42)
    assert(V[0] == 1)
    assert(V[2] == 99)
    assert(V.size() == 3)


def make_vector(value: int) -> Vector[int]:
    result = Vector[int]()
    result.push(value)
    return result


test "owning vector returns transfer storage and copies stay independent":
    values = make_vector(42)
    snapshot = copy values
    values.push(7)
    assert(values.size() == 2)
    assert(snapshot.size() == 1)
    assert(snapshot.get(0) == 42)


test "conditional owner consumption cleans the surviving path":
    def consume(take: bool):
        values = Vector()
        values.push(42)
        if take:
            moved = move values
            assert(moved.get(0) == 42)
    consume(true)
    consume(false)


test "while exit ownership includes zero iterations and break":
    def consume(enter: bool):
        values = Vector()
        values.push(42)
        while enter:
            drop values
            break
    consume(true)
    consume(false)


test "iterator break reconciles consumed outer owner":
    source = Vector()
    source.push(1)
    values = Vector()
    values.push(42)
    for item in source:
        drop values
        break
    source.push(2)
    assert(source.size() == 2)


