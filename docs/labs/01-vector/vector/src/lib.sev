class Vector:
    items: array[int]
    count: int

    def Vector(self: borrow Self):
        self.items = allocate[int](0)
        self.count = 0

    def size(self: view Self) -> int:
        return self.count

    def capacity(self: view Self) -> int:
        return len(self.items)

    def get(self: view Self, position: int) -> int:
        assert(position >= 0)
        assert(position < self.count)
        return self.items[position]

    def set(self: borrow Self, position: int, value: int):
        assert(position >= 0)
        assert(position < self.count)
        self.items[position] = value

    def reserve(self: borrow Self, requested: int):
        assert(requested >= 0)
        assert(requested <= 1152921504606846975)
        if requested > len(self.items):
            grown = allocate[int](requested)
            i = 0
            while i < self.count:
                grown[i] = self.items[i]
                i += 1
            self.items = move grown

    def push(self: borrow Self, value: int):
        available = len(self.items)
        if self.count == available:
            requested = 1
            if available > 0:
                assert(available <= 576460752303423487)
                requested = available * 2
            self.reserve(requested)
        self.items[self.count] = value
        self.count += 1

    grammar assign[self, "[", index: int, "]", "=", value: int]() -> absent:
        self.set(index, value)

    grammar get[self, "[", index: int, "]"]() -> int:
        return self.get(index)

    grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
        while position < self.count with position = 0:
            yield self.items[position]
            position += 1

    def pop(self: borrow Self) -> int:
        assert(self.count > 0)
        self.count -= 1
        value = self.items[self.count]
        self.items[self.count] = 0
        return value

    def pointer_view(self: view Self) -> pointer[int]:
        return pointer[int](self.items)


test "owning vector acceptance":
    values = Vector()
    values.push(42)
    values.push(7)
    assert(values.size() == 2)
    assert(values.get(0) == 42)


test "geometric growth and order":
    values = Vector()
    i = 0
    while i < 1024:
        values.push(i * 3)
        i += 1
    assert(values.size() == 1024)
    assert(values.capacity() == 1024)
    i = 0
    while i < values.size():
        assert(values.get(i) == i * 3)
        i += 1


test "reserve pop mutation and independent copy":
    values = Vector()
    values.push(7)
    values.push(11)
    values.reserve(32)
    snapshot = copy values
    values.set(0, 42)
    assert(snapshot.get(0) == 7)
    assert(values.pop() == 11)
    assert(values.pop() == 42)
    assert(values.size() == 0)


test "move transfers destruction and pointer observes storage":
    values = Vector()
    values.push(42)
    moved = move values
    pointer = moved.pointer_view()
    assert(pointer[0] == 42)
    moved.push(7)
    assert(moved.size() == 2)


test "owned field replacement destroys the previous allocation":
    class Buffer:
        data: array[int]
    original = allocate[int, location=memory.heap](8)
    original[0] = 42
    buffer = Buffer(original)
    snapshot = copy buffer
    buffer.data = allocate[int, location=memory.heap](16)
    assert(len(buffer.data) == 16)
    buffer.data[0] = 9
    assert(buffer.data[0] == 9)
    assert(snapshot.data[0] == 42)
    buffer.data = copy snapshot.data
    assert(buffer.data[0] == 42)


test "nested owned fields copy independently and destroy recursively":
    class Pair:
        left: Vector
        right: Vector
    left = Vector()
    left.push(42)
    right = Vector()
    right.push(7)
    pair = Pair(left, right)
    snapshot = copy pair
    pair.left.set(0, 9)
    drop pair
    assert(snapshot.left.get(0) == 42)
    assert(snapshot.right.get(0) == 7)


test "return break and continue destroy class fields":
    def work() -> int:
        outer = Vector()
        outer.push(42)
        i = 0
        while i < 20:
            temporary = Vector()
            temporary.push(i)
            i += 1
            if i < 10:
                nested = Vector()
                nested.push(i)
                continue
            if i == 12:
                break
        return outer.get(0) + i
    assert(work() == 54)


test with compiler "live pointers prevent field replacement":
    reject "while a borrow is live":
        class Buffer:
            data: array[int]
        def invalid() -> int:
            buffer = Buffer(allocate[int, location=memory.heap](1))
            pointer = pointer[int](buffer.data)
            buffer.data = allocate[int, location=memory.heap](2)
            return pointer[0]


test with compiler "borrowed storage cannot initialize owned fields":
    reject "owned field requires ownership":
        class Buffer:
            data: array[int]
        def invalid(data: array[int]):
            buffer = Buffer(data)


test with compiler "stack storage cannot initialize owned fields":
    reject "owned field cannot retain stack storage":
        class Buffer:
            data: array[int]
        def invalid():
            data = allocate[int, location=memory.stack](1)
            buffer = Buffer(data)


test with compiler "view cannot become owner":
    reject "cannot drop memory through a view":
        def invalid(values: array[int]):
            drop values


test with compiler "pointer cannot escape stack":
    reject "storage belongs to this callable":
        def invalid() -> pointer[int]:
            values = allocate[int, location=memory.stack](4)
            return pointer[int](values)


test "inferred field allocation survives constructor return":
    class Buffer:
        data: array[int]
        def Buffer(self: borrow Self):
            self.data = allocate[int](8)
            self.data[0] = 42
    value = Buffer()
    assert(value.data[0] == 42)
    value.data = allocate[int](16)
    assert(len(value.data) == 16)


test with compiler "field views constrain receiver mutation":
    reject "while a borrow is live":
        class Buffer:
            data: array[int]
            def replace(self: borrow Self) -> int:
                saved = self.data
                self.data = allocate[int](8)
                return saved[0]


test with compiler "shared class ownership needs an aggregate handle":
    reject "shared class ownership requires an owning aggregate handle":
        class Buffer:
            data: array[int]
        def invalid():
            value = Buffer(allocate[int](1))
            shared = share value


test with compiler "returning a local owning class needs value return lowering":
    reject "storage belongs to this callable":
        class Buffer:
            data: array[int]
        def invalid() -> Buffer:
            value = Buffer(allocate[int](1))
            return value


test with compiler "temporary owning receiver requires a binding":
    reject "owning method receiver must be bound before use":
        class Buffer:
            data: array[int]
            def size(self: view Self) -> int:
                return len(self.data)
        def invalid() -> int:
            return Buffer(allocate[int](1)).size()


test with compiler "partial field moves require replacement semantics":
    reject "moving an owned field requires replacing it":
        class Buffer:
            data: array[int]
        def invalid():
            buffer = Buffer(allocate[int](1))
            data = move buffer.data


test with compiler "borrowed class alias cannot replace a pinned field":
    reject "while a borrow is live":
        class Buffer:
            data: array[int]
        def invalid() -> int:
            buffer = Buffer(allocate[int](1))
            alias = borrow buffer
            pointer = pointer[int](buffer.data)
            alias.data = allocate[int](2)
            return pointer[0]


test "class grammar reuses checked vector mutation":
    values = Vector()
    values.push(1)
    values.push(2)
    values[0] = 42
    values[1] = 7
    assert(values.get(0) == 42)
    assert(values.get(1) == 7)


test "class grammar preserves logical bounds checks":
    throws "assertion failed":
        values = Vector()
        values[0] = 42


test "iterator values match indexed access with loop local counter":
    X = Vector()
    X.push(42)
    X.push(7)
    visited = 0
    i = 99
    for x in X with i = 0:
        assert(x == X[i])
        i += 1
        visited += 1
    assert(visited == 2)
    assert(i == 99)
    X.push(11)


test "empty iterator does not execute consumer":
    values = Vector()
    visited = 0
    for x in values:
        visited += 1
    assert(visited == 0)


test "iterator continue resumes producer and break releases view":
    values = Vector()
    values.push(1)
    values.push(2)
    values.push(3)
    total = 0
    for x in iterator(values):
        scratch = allocate[int](1)
        if x == 1:
            continue
        total += x
        break
    assert(total == 2)
    values.push(4)


test "iterator return cleans producer and consumer locals":
    def first() -> int:
        values = Vector()
        values.push(42)
        for x in values:
            scratch = allocate[int](8)
            return x
        return 0
    assert(first() == 42)


test "multiple yields preserve producer locals":
    class Pairs:
        value: int
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            scratch = allocate[int](1)
            scratch[0] = self.value
            yield scratch[0]
            scratch[0] += 1
            yield scratch[0]
    pairs = Pairs(7)
    total = 0
    for x in pairs:
        total += x
    assert(total == 15)
    for x in pairs:
        break


test with compiler "iterator view prevents receiver mutation":
    reject "while a borrow is live":
        class Items:
            value: int
            def set(self: borrow Self):
                self.value = 2
            grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
                yield self.value
        def invalid():
            values = Items(1)
            for x in values:
                values.set()


test with compiler "yield requires an iterator context":
    reject "yield requires an iterator grammar":
        def invalid():
            yield 1


test with compiler "stored iterator needs an independent frame":
    reject "iterator values currently require direct for consumption":
        class Items:
            value: int
            grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
                yield self.value
        def invalid():
            values = Items(1)
            cursor = iterator(values)


test "nested consumers have independent continuations":
    values = Vector()
    values.push(1)
    values.push(2)
    total = 0
    for a in values:
        for b in values:
            total += a * b
    assert(total == 9)


test "with initializer runs once before iteration":
    class Counter:
        count: int
        def increment(self: borrow Self) -> int:
            self.count += 1
            return 0
    counter = Counter(0)
    values = Vector()
    values.push(5)
    values.push(8)
    for x in values with i = counter.increment():
        assert(x == values[i])
        i += 1
    assert(counter.count == 1)


test "conditional yields preserve continuation":
    class Choices:
        enabled: bool
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            if self.enabled:
                yield 7
            else:
                yield 3
            yield 11
    choices = Choices(true)
    total = 0
    for value in choices:
        total += value
    assert(total == 18)


test with compiler "yield enforces the iterator element type":
    reject:
        class Items:
            value: int
            grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
                yield "wrong"
        def invalid():
            values = Items(1)
            for x in values:
                assert(x == 1)


test "while with initializes once and shadows the outer binding":
    class Counter:
        calls: int
        def start(self: borrow Self) -> int:
            self.calls += 1
            return 0
    counter = Counter(0)
    position = 99
    visited = 0
    while position < 3 with position = counter.start():
        visited += 1
        position += 1
    assert(visited == 3)
    assert(counter.calls == 1)
    assert(position == 99)
    while false with position = counter.start():
        visited += 1
    assert(counter.calls == 2)
    assert(visited == 3)


test "while with initializer can read the shadowed binding":
    i = 2
    visited = 0
    while i < 4 with i = i:
        visited += 1
        i += 1
    assert(visited == 2)
    assert(i == 2)


test "nested while with bindings remain independent":
    visited = 0
    while i < 2 with i = 0:
        while i < 2 with i = 0:
            visited += 1
            i += 1
        i += 1
    assert(visited == 4)


test "while with owned initializer survives continue and cleans up on break":
    visited = 0
    while scratch[0] < 4 with scratch = allocate[int, location=memory.heap](1):
        scratch[0] += 1
        if scratch[0] == 1:
            continue
        visited += 1
        if scratch[0] == 3:
            break
    assert(visited == 2)
    while false with scratch = allocate[int, location=memory.heap](1):
        visited += 1
    assert(visited == 2)


test "return cleans the while with initializer":
    def first() -> int:
        while true with scratch = allocate[int, location=memory.heap](1):
            scratch[0] = 42
            return scratch[0]
        return 0
    assert(first() == 42)


test with compiler "while with binding cannot escape the loop":
    reject "unknown binding 'position'":
        def invalid():
            while position < 2 with position = 0:
                position += 1
            assert(position == 2)


test "repeated iterator expansions give stores unique MLIR temporaries":
    class Pair:
        value: int
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            scratch = allocate[int](1)
            scratch[0] = self.value
            yield scratch[0]
            scratch[0] += 1
            yield scratch[0]
    class Last:
        value: int
    pair = Pair(4)
    last = Last(0)
    output = allocate[int](1)
    for value in pair:
        output[0] += value
        last.value = value
    assert(output[0] == 9)
    assert(last.value == 5)
    for value in pair:
        output[0] += value
        last.value = value
    assert(output[0] == 18)
    assert(last.value == 5)
