test "bubble sort preserves equal-key record order":
    class Entry:
        key: int
        ordinal: int
        operator <(right: Entry) -> bool:
            return self.key < right.key
    values = Vector[Entry]()
    position = 0
    while position < 9:
        values.push(Entry(position % 3, position))
        position += 1
    module.bubble_sort_completed = false
    assert(not module.bubble_sort_completed)
    BubbleVectorSort[Entry]().sort(values)
    assert(module.bubble_sort_completed)
    position = 1
    while position < values.size():
        previous = values.get(position - 1)
        current = values.get(position)
        assert(previous.key <= current.key)
        if previous.key == current.key:
            assert(previous.ordinal < current.ordinal)
        position += 1


