test "nested consumers have independent continuations":
    values = Vector()
    values.push(1)
    values.push(2)
    total = 0
    for a in values:
        for b in values:
            total += a * b
    assert(total == 9)


test "with initializer runs once before iteration":
    class Counter:
        count: int
        def increment(self: borrow Self) -> int:
            self.count += 1
            return 0
    counter = Counter(0)
    values = Vector()
    values.push(5)
    values.push(8)
    for x in values with i = counter.increment():
        assert(x == values[i])
        i += 1
    assert(counter.count == 1)


test "conditional yields preserve continuation":
    class Choices:
        enabled: bool
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            if self.enabled:
                yield 7
            else:
                yield 3
            yield 11
    choices = Choices(true)
    total = 0
    for value in choices:
        total += value
    assert(total == 18)


test with compiler "yield enforces the iterator element type":
    reject:
        class Items:
            value: int
            grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
                yield "wrong"
        def invalid():
            values = Items(1)
            for x in values:
                assert(x == 1)


test "while with initializes once and shadows the outer binding":
    class Counter:
        calls: int
        def start(self: borrow Self) -> int:
            self.calls += 1
            return 0
    counter = Counter(0)
    position = 99
    visited = 0
    while position < 3 with position = counter.start():
        visited += 1
        position += 1
    assert(visited == 3)
    assert(counter.calls == 1)
    assert(position == 99)
    while false with position = counter.start():
        visited += 1
    assert(counter.calls == 2)
    assert(visited == 3)


test "while with initializer can read the shadowed binding":
    i = 2
    visited = 0
    while i < 4 with i = i:
        visited += 1
        i += 1
    assert(visited == 2)
    assert(i == 2)


test "nested while with bindings remain independent":
    visited = 0
    while i < 2 with i = 0:
        while i < 2 with i = 0:
            visited += 1
            i += 1
        i += 1
    assert(visited == 4)


test "while with owned initializer survives continue and cleans up on break":
    visited = 0
    while scratch[0] < 4 with scratch = allocate[int, location=memory.heap](1):
        scratch[0] += 1
        if scratch[0] == 1:
            continue
        visited += 1
        if scratch[0] == 3:
            break
    assert(visited == 2)
    while false with scratch = allocate[int, location=memory.heap](1):
        visited += 1
    assert(visited == 2)


test "return cleans the while with initializer":
    def first() -> int:
        while true with scratch = allocate[int, location=memory.heap](1):
            scratch[0] = 42
            return scratch[0]
        return 0
    assert(first() == 42)


test with compiler "while with binding cannot escape the loop":
    reject "unknown binding 'position'":
        def invalid():
            while position < 2 with position = 0:
                position += 1
            assert(position == 2)


test "repeated iterator expansions give stores unique MLIR temporaries":
    class Pair:
        value: int
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            scratch = allocate[int](1)
            scratch[0] = self.value
            yield scratch[0]
            scratch[0] += 1
            yield scratch[0]
    class Last:
        value: int
    pair = Pair(4)
    last = Last(0)
    output = allocate[int](1)
    for value in pair:
        output[0] += value
        last.value = value
    assert(output[0] == 9)
    assert(last.value == 5)
    for value in pair:
        output[0] += value
        last.value = value
    assert(output[0] == 18)
    assert(last.value == 5)


test "nested vector index assignment targets the indexed position":
    V = Vector()
    V.push(1)
    V.push(7)
    V.push(99)

    V[V[0]] = 42

    assert(V[1] == 42)
    assert(V[V[0]] == 42)
    assert(V[0] == 1)
    assert(V[2] == 99)
    assert(V.size() == 3)


def make_vector(value: int) -> Vector[int]:
    result = Vector[int]()
    result.push(value)
    return result


test "owning vector returns transfer storage and copies stay independent":
    values = make_vector(42)
    snapshot = copy values
    values.push(7)
    assert(values.size() == 2)
    assert(snapshot.size() == 1)
    assert(snapshot.get(0) == 42)


test "conditional owner consumption cleans the surviving path":
    def consume(take: bool):
        values = Vector()
        values.push(42)
        if take:
            moved = move values
            assert(moved.get(0) == 42)
    consume(true)
    consume(false)


test "while exit ownership includes zero iterations and break":
    def consume(enter: bool):
        values = Vector()
        values.push(42)
        while enter:
            drop values
            break
    consume(true)
    consume(false)


test "iterator break reconciles consumed outer owner":
    source = Vector()
    source.push(1)
    values = Vector()
    values.push(42)
    for item in source:
        drop values
        break
    source.push(2)
    assert(source.size() == 2)


test with compiler "consumption on either branch forbids later use":
    reject "moved or dropped":
        def invalid(take: bool):
            data = allocate[int](1)
            if take:
                drop data
            assert(data[0] == 0)


test "returned owners survive branches and forwarded calls":
    def choose(first: bool) -> Vector[int]:
        left = make_vector(42)
        right = make_vector(7)
        if first:
            return left
        return right
    def forward() -> Vector[int]:
        return choose(true)
    first = forward()
    second = choose(false)
    assert(first.get(0) == 42)
    assert(second.get(0) == 7)
    pointer = first.pointer_view()
    assert(pointer[0] == 42)


test "replaced owner survives a continuing loop edge":
    values = make_vector(42)
    while position < 3 with position = 0:
        drop values
        values = make_vector(position)
        position += 1
        continue
    assert(values.get(0) == 2)


test with compiler "returned owner cannot invalidate a live pointer":
    reject "while a borrow is live":
        class Buffer:
            data: array[int]
        def invalid() -> Buffer:
            data = allocate[int](1)
            value = Buffer(move data)
            pointer = pointer[int](value.data)
            if pointer[0] == 0:
                return value
            assert(pointer[0] == 0)
            return value


test "class vector growth copies and negative indexing":
    class Point:
        x: int
        y: int
    values = Vector[Point]()
    first = Point(42, 7)
    values.push(first)
    first.x = 99
    while i < 32 with 
    {
        i = 0,
        suffix i += 1
    }:
        point = Point(i, i + 1)
        values.push(point)
        i += 1
    head = values.get(-33)
    tail = values.get(-1)
    assert(head.x == 42)
    assert(tail.x == 31)
    snapshot = copy values
    replacement = Point(8, 9)
    values.set(-1, replacement)
    old = snapshot.get(-1)
    assert(old.x == 31)
    popped = values.pop()
    assert(popped.x == 8)
    assert(values.size() == 32)


test "owning class elements copy their arrays independently":
    class Buffer:
        items: array[int]
    data = allocate[int](2)
    data[0] = 42
    buffer = Buffer(move data)
    values = Vector[Buffer]()
    values.push(buffer)
    buffer.items[0] = 7
    snapshot = copy values
    drop values
    result = snapshot.get(0)
    assert(result.items[0] == 42)
    result.items[0] = 9
    independent = snapshot.get(0)
    assert(independent.items[0] == 42)


test "negative indexing includes both end points":
    values = Vector()
    values.push(42)
    values.push(7)
    assert(values.get(-2) == 42)
    assert(values.get(-1) == 7)
    values.set(-1, 9)
    assert(values.get(1) == 9)


test "negative index outside count fails the parameter contract":
    throws "prefix contract failed":
        values = Vector()
        values.push(42)
        values.get(-2)


test "loop owner replacement infers one compatible placement":
    values = allocate[int](1)
    while i < 128 with i = 0:
        drop values
        values = allocate[int](i + 1)
        values[0] = i
        i += 1
        continue
    assert(values[0] == 127)


test "loop owner replacement handles an empty loop":
    values = allocate[int](1)
    while false:
        drop values
        values = allocate[int](8192)
    assert(values[0] == 0)


test "record array rejects reads before initialization":
    throws "read of uninitialized array element":
        class Point:
            x: int
        values = allocate[array[Point]](1)
        point = values[0]
        assert(point.x == 0)


test with compiler "record array arena regions need initialized cleanup":
    reject "record array arena/pool":
        class Point:
            x: int
        def unsupported():
            values = allocate[array[Point], strategy=memory.arena](2)


test "class element iteration owns independent snapshots":
    class Point:
        x: int
    values = Vector[Point]()
    point = Point(42)
    values.push(point)
    for item in values:
        assert(item.x == 42)
        item.x = 7
    unchanged = values.get(0)
    assert(unchanged.x == 42)


test "record slots support replacement and reuse after pop":
    class Buffer:
        items: array[int]
    data = allocate[int](1)
    data[0] = 42
    buffer = Buffer(move data)
    values = Vector[Buffer]()
    values.push(buffer)
    values.set(0, buffer)
    popped = values.pop()
    values.push(popped)
    drop popped
    result = values.get(0)
    assert(result.items[0] == 42)


test with compiler "borrowed class elements pin their containing allocation":
    reject "while a borrow is live":
        class Point:
            x: int
        def invalid():
            values = allocate[array[Point]](1)
            original = Point(42)
            values[0] = original
            point = values[0]
            drop values
            assert(point.x == 42)


test with compiler "record array borrowed fields require a lifetime contract":
    reject "borrowed fields require element lifetime contracts":
        class Handle:
            value: pointer[int]
        def unsupported():
            values = allocate[array[Handle]](1)


test with compiler "string array elements need a storage contract":
    reject "supported scalar memory representation":
        def unsupported():
            values = allocate[array[string]](1)


def make_char_vector(value: char) -> Vector[char]:
    result = Vector[char]()
    result.push(value)
    return result


test "char vector preserves Unicode growth copies and moves":
    values = make_char_vector('a')
    values.push('λ')
    values.push('😀')
    assert(values.size() == 3)
    assert(values.get(0) == 'a')
    assert(values.get(-2) == 'λ')
    assert(values.get(-1) == '😀')
    snapshot = copy values
    values.set(-1, 'z')
    assert(snapshot.pop() == '😀')
    assert(snapshot.get(-1) == 'λ')
    moved = move values
    pointer = moved.pointer_view()
    assert(pointer[2] == 'z')
