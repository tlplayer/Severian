            values = array[string, 1]()


def make_char_vector(value: char) -> Vector[char]:
    result = Vector[char]()
    result.push(value)
    return result


test "char vector preserves Unicode growth copies and moves":
    unsafe:
        values = make_char_vector('a')
        values.push('λ')
        values.push('😀')
        assert(values.size() == 3)
        assert(values.get(0) == 'a')
        assert(values.get(-2) == 'λ')
        assert(values.get(-1) == '😀')
        snapshot = copy values
        values.set(-1, 'z')
        assert(snapshot.pop() == '😀')
        assert(snapshot.get(-1) == 'λ')
        moved = move values
        pointer = moved.pointer_view()
        assert(pointer[2] == 'z')


test "known wider integer values fit a narrower vector":
    values = Vector[i32]()
    values.push(i64(6))
    known = i64(-2)
    values.push(known)
    values.push(i64(3) + i64(4))
    values.sort()
    assert(values.get(0) == -2)
    assert(values.get(1) == 6)
    assert(values.get(2) == 7)


test "bubble sort completes, preserves counts, and returns an alias":
    def check(count: int, pattern: int):
        module.bubble_sort_completed = false
        values = Vector[int]()
        values.reserve(128)
        before = array[int, 7]()
        position = 0
        while position < count:
            key = (count - position) % 7
            if pattern == 1:
                key = position % 7
            if pattern == 2:
                key = 3
            if pattern == 3:
                key = position * 7 // count
            values.push(key - 3)
            before[key] += 1
            position += 1
        assert(not module.bubble_sort_completed)
        ordered = BubbleVectorSort[int]().sort(values)
        assert(module.bubble_sort_completed)
        assert(ordered.size() == count)
        assert(values.capacity() == 128)
        after = array[int, 7]()
        position = 0
        while position < count:
            key = ordered.get(position)
            after[key + 3] += 1
            if position > 0:
                assert(ordered.get(position - 1) <= key)
            position += 1
        position = 0
        while position < 7:
            assert(before[position] == after[position])
            position += 1
        if count > 0:
            ordered.set(0, -99)
            assert(values.get(0) == -99)
    for count in [0, 1, 2, 6, 31, 65]:
        for pattern in [0, 1, 2, 3]:
            check(count, pattern)


