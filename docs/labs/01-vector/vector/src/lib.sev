test "safe arrays own returned storage and initialize scalar elements":
    def make(count: int) -> array[int]:
        values = array[int, count]()
        return values
    values = make(4)
    assert(len(values) == 4)
    assert(values[0] == 0)
    assert(values[3] == 0)
    values[0] = 7
    snapshot = copy values
    drop values
    assert(snapshot[0] == 7)


test "safe arrays reject negative counts":
    throws "allocation count must be nonnegative":
        values = array[int, -1]()


test "safe arrays reject byte size overflow":
    throws "allocation byte size overflow":
        values = array[int, 9223372036854775807]()


test "safe arrays check fixed count annotations":
    throws "array element count does not match annotation":
        values: array[int, 3] = array[int, 2]()
