class Vector[T = int]:
    items: array[T]
    count: int

    def Vector(self: borrow Self):
        self.items = array[T,0]
        self.count = 0

    def size(self: view Self) -> int:
        return self.count

    def capacity(self: view Self) -> int:
        return len(self.items)

    def get(self: view Self, position: int) -> T with -self.count <= position < self.count:
        if position < 0:
            position += self.count
        value = copy self.items[position]
        return value

    def set(self: borrow Self, position: int, value: T) with -self.count <= position < self.count:
        if position < 0:
            position += self.count
        self.items[position] = value

    def reserve(self: borrow Self, requested: int):
        assert(requested >= 0)
        assert(requested <= 1152921504606846975)
        if requested > len(self.items):
            grown = array[T, requested]()
            while i < self.count with i = 0:
                grown[i] = self.items[i]
                i += 1
            self.items = move grown

    def push(self: borrow Self, value: T):
        available = len(self.items)
        if self.count == available:
            requested = 1
            if available > 0:
                assert(available <= 576460752303423487)
                requested = available * 2
            self.reserve(requested)
        self.items[self.count] = value
        self.count += 1

    grammar assign[self, "[", index: int, "]", "=", value: T]() -> absent:
        self.set(index, value)

    grammar get[self, "[", index: int, "]"]() -> T:
        return self.get(index)

    grammar iterate["iterator", "(", self, ")"]() -> iterator[T]:
        while position < self.count with position = 0:
            yield self.items[position]
            position += 1

    def pop(self: borrow Self) -> T:
        assert(self.count > 0)
        self.count -= 1
        value = copy self.items[self.count]
        drop self.items[self.count]
        return value

    def pointer_view(self: view Self) -> pointer[T]:
        unsafe:
            return pointer[T](self.items)

    # The result keeps a loan on this vector; sorting does not transfer storage.
    def sort(self: borrow Self) -> borrow Vector[T]:
        return VectorSort[T].sort(self)


trait VectorSort[T]:
    def sort(values: borrow Vector[T]) -> borrow Vector[T]


# These domains partition initialized length, not allocated capacity. The cutoff
# is a lab policy, not a claim that 32 is optimal for every element type/target.
class TrivialVectorSort[T]: VectorSort[T]
    def sort(values: borrow Vector[T]) -> borrow Vector[T] with values.count <= 1:
        return borrow values


class InsertionVectorSort[T]: VectorSort[T]
    def sort(values: borrow Vector[T]) -> borrow Vector[T] with 1 < values.count <= 32:
        position = 1
        while position < values.size():
            value = values.get(position)
            destination = position
            while destination > 0:
                previous = values.get(destination - 1)
                if not (value < previous):
                    break
                values.set(destination, previous)
                destination -= 1
            values.set(destination, value)
            position += 1
        module.insertion_sort_completed = true
        return borrow values


class MergeVectorSort[T]: VectorSort[T]
    def sort(values: borrow Vector[T]) -> borrow Vector[T] with values.count > 32:
        count = values.size()
        scratch = Vector[T]()
        scratch.reserve(count)
        position = 0
        while position < count:
            scratch.push(values.get(position))
            position += 1

        merge(values, scratch, 0, count)
        module.merge_sort_completed = true
        return borrow values

    # Stable recursive merge; O(N log N) time, O(N) scratch plus O(log N) stack.
    def merge(values: borrow Vector[T], scratch: borrow Vector[T], start: int, end: int) -> absent:
        if end - start <= 1:
            return
        middle = start + (end - start) // 2
        merge(values, scratch, start, middle)
        merge(values, scratch, middle, end)
        left = start
        right = middle
        destination = start
        while left < middle and right < end:
            left_value = values.get(left)
            right_value = values.get(right)
            if right_value < left_value:
                scratch.set(destination, right_value)
                right += 1
            else:
                scratch.set(destination, left_value)
                left += 1
            destination += 1
        while left < middle:
            scratch.set(destination, values.get(left))
            left += 1
            destination += 1
        while right < end:
            scratch.set(destination, values.get(right))
            right += 1
            destination += 1
        position = start
        while position < end:
            values.set(position, scratch.get(position))
            position += 1

# Direct algorithms are explicit choices; VectorSort's length dispatch stays
# unambiguous. Flags are written only after the algorithm finishes.
bubble_sort_completed: bool = false
selection_sort_completed: bool = false
insertion_sort_completed: bool = false
merge_sort_completed: bool = false
quick_sort_completed: bool = false
heap_sort_completed: bool = false
counting_sort_completed: bool = false


# Stable; best O(N), worst O(N*N); O(1) auxiliary elements.
class BubbleVectorSort[T]:
    def sort(values: borrow Vector[T]) -> borrow Vector[T]:
        end = values.size()
        while end > 1:
            changed = false
            position = 1
            while position < end:
                left = values.get(position - 1)
                right = values.get(position)
                if right < left:
                    values.set(position - 1, right)
                    values.set(position, left)
                    changed = true
                position += 1
            if not changed:
                break
            end -= 1
        module.bubble_sort_completed = true
        return borrow values


# Unstable; O(N*N) comparisons; O(1) auxiliary elements.
class SelectionVectorSort[T]:
    def sort(values: borrow Vector[T]) -> borrow Vector[T]:
        start = 0
        while start < values.size():
            smallest = start
            position = start + 1
            while position < values.size():
                if values.get(position) < values.get(smallest):
                    smallest = position
                position += 1
            if smallest != start:
                value = values.get(start)
                values.set(start, values.get(smallest))
                values.set(smallest, value)
            start += 1
        module.selection_sort_completed = true
        return borrow values


# Unstable; average O(N log N), worst O(N*N). Recurse into the smaller
# partition and iterate over the larger one: O(log N) call-stack space.
class QuickVectorSort[T]:
    def partition(values: borrow Vector[T], first: int, stop: int) -> absent:
        low = first
        high = stop
        while high - low > 1:
            pivot = values.get(high - 1)
            boundary = low
            position = low
            while position < high - 1:
                if values.get(position) < pivot:
                    value = values.get(boundary)
                    values.set(boundary, values.get(position))
                    values.set(position, value)
                    boundary += 1
                position += 1
            value = values.get(boundary)
            values.set(boundary, pivot)
            values.set(high - 1, value)
            if boundary - low < high - boundary - 1:
                partition(values, low, boundary)
                low = boundary + 1
            else:
                partition(values, boundary + 1, high)
                high = boundary

    def sort(values: borrow Vector[T]) -> borrow Vector[T]:
        partition(values, 0, values.size())
        module.quick_sort_completed = true
        return borrow values


# Unstable; O(N log N) time; iterative sift keeps auxiliary space O(1).
class HeapVectorSort[T]:
    def sift(values: borrow Vector[T], start: int, stop: int):
        root = start
        while root < stop // 2:
            child = root * 2 + 1
            if child + 1 < stop:
                if values.get(child) < values.get(child + 1):
                    child += 1
            if not (values.get(root) < values.get(child)):
                break
            value = values.get(root)
            values.set(root, values.get(child))
            values.set(child, value)
            root = child

    def sort(values: borrow Vector[T]) -> borrow Vector[T]:
        count = values.size()
        start = count // 2
        while start > 0:
            start -= 1
            sift(values, start, count)
        stop = count
        while stop > 1:
            stop -= 1
            value = values.get(0)
            values.set(0, values.get(stop))
            values.set(stop, value)
            sift(values, 0, stop)
        module.heap_sort_completed = true
        return borrow values


# Stable integer counting sort; O(N + K) time and auxiliary space.
# K is maximum - minimum + 1. Negative keys use an offset.
class CountingVectorSort:
    def sort(values: borrow Vector[int]) -> borrow Vector[int]:
        count = values.size()
        if count > 0:
            minimum = values.get(0)
            maximum = minimum
            position = 1
            while position < count:
                value = values.get(position)
                if value < minimum:
                    minimum = value
                if value > maximum:
                    maximum = value
                position += 1
            width = i128(maximum) - i128(minimum) + 1
            assert(width <= 1152921504606846975)
            buckets = array[int, int(width)]()
            position = 0
            while position < count:
                key = int(i128(values.get(position)) - i128(minimum))
                buckets[key] += 1
                position += 1
            key = 1
            while key < int(width):
                buckets[key] += buckets[key - 1]
                key += 1
            output = array[int, count]()
            position = count
            while position > 0:
                position -= 1
                value = values.get(position)
                key = int(i128(value) - i128(minimum))
                buckets[key] -= 1
                output[buckets[key]] = value
            position = 0
            while position < count:
                values.set(position, output[position])
                position += 1
        module.counting_sort_completed = true
        return borrow values


test "sort covers empty singleton and both sides of the dispatch boundary":
    for count in [0, 1, 2, 31, 32, 33, 65, 128]:
        values = Vector[int]()
        values.reserve(256)
        position = 0
        while position < count:
            values.push(count - position)
            position += 1
        values.sort()
        assert(values.size() == count)
        assert(values.capacity() == 256)
        position = 0
        while position < count:
            assert(values.get(position) == position + 1)
            position += 1


test "sort returns a mutable alias and preserves the original owner":
    values = Vector[int]()
    values.push(3)
    values.push(1)
    values.push(2)
    sorted_values = values.sort()
    assert(sorted_values.get(0) == 1)
    sorted_values.set(0, -7)
    assert(values.get(0) == -7)
    values.push(4)
    assert(values.size() == 4)


test "sort alias can be forwarded and chained":
    def ordered(values: borrow Vector[int]) -> borrow Vector[int]:
        return values.sort()
    values = Vector[int]()
    values.push(3)
    values.push(1)
    ordered(values).sort().set(0, -1)
    assert(values.get(0) == -1)
    assert(values.get(1) == 3)


test "sort reevaluates length after mutation and preserves duplicates":
    values = Vector[int]()
    position = 0
    while position < 32:
        values.push(1)
        position += 1
    values.sort()
    values.push(-4)
    values.sort()
    assert(values.get(0) == -4)
    position = 1
    while position < values.size():
        assert(values.get(position) == 1)
        position += 1
    values.sort()
    assert(values.size() == 33)
    assert(values.get(0) == -4)
    assert(values.get(-1) == 1)


test "direct trait calls and vector methods preserve generic element types":
    values = Vector[i32]()
    values.push(i64(9))
    values.push(-2)
    sorted_values = VectorSort[i32].sort(values)
    assert(sorted_values.get(0) == -2)
    sorted_values.set(1, 4)
    assert(values.get(1) == 4)
    values.sort()
    assert(values.get(0) == -2)
    wide = Vector[i64]()
    wide.push(values.get(0))
    wide.push(values.get(1))
    assert(wide.get(0) == -2)
    assert(wide.get(1) == 4)


test "insertion and merge sorting preserve the order of equal keys":
    class Entry:
        key: int
        ordinal: int

        operator <(right: Entry) -> bool:
            return self.key < right.key

    for count in [6, 65]:
        values = Vector[Entry]()
        position = 0
        while position < count:
            values.push(Entry(position % 3, position))
            position += 1
        values.sort()
        position = 0
        key = 0
        while key < 3:
            ordinal = key
            while ordinal < count:
                item = values.get(position)
                assert(item.key == key)
                assert(item.ordinal == ordinal)
                position += 1
                ordinal += 3
            key += 1
        assert(position == count)
        assert(values.size() == count)


test with compiler "another matching sorter is ambiguity rather than an override":
    reject:
        class OverlappingVectorSort: VectorSort[int]
            def sort(values: borrow Vector[int]) -> borrow Vector[int] with values.count > 1:
                return borrow values

        def invalid():
            values = Vector[int]()
            values.push(2)
            values.push(1)
            values.sort()


test with compiler "sort result cannot escape its local owner":
    reject:
        def invalid() -> borrow Vector[int]:
            values = Vector[int]()
            values.push(2)
            return values.sort()


test with compiler "sort result is a loan rather than an owned vector":
    reject:
        def invalid(values: borrow Vector[int]) -> Vector[int]:
            return values.sort()


test with compiler "live sort result prevents destruction of its owner":
    reject:
        def invalid() -> int:
            values = Vector[int]()
            values.push(2)
            sorted_values = values.sort()
            drop values
            return sorted_values.get(0)


test with compiler "sort requires mutable access to its input":
    reject:
        def invalid(values: view Vector[int]):
            values.sort()


test "owning vector acceptance":
    values = Vector()
    values.push(42)
    values.push(7)
    assert(values.size() == 2)
    assert(values.get(0) == 42)


test "geometric growth and order":
    values = Vector()
    i = 0
    while i < 1024:
        values.push(i * 3)
        i += 1
    assert(values.size() == 1024)
    assert(values.capacity() == 1024)
    i = 0
    while i < values.size():
        assert(values.get(i) == i * 3)
        i += 1


test "reserve pop mutation and independent copy":
    values = Vector()
    values.push(7)
    values.push(11)
    values.reserve(32)
    snapshot = copy values
    values.set(0, 42)
    assert(snapshot.get(0) == 7)
    assert(values.pop() == 11)
    assert(values.pop() == 42)
    assert(values.size() == 0)


test "move transfers destruction and pointer observes storage":
    unsafe:
        values = Vector()
        values.push(42)
        moved = move values
        pointer = moved.pointer_view()
        assert(pointer[0] == 42)
        moved.push(7)
        assert(moved.size() == 2)


test "owned field replacement destroys the previous allocation":
    class Buffer:
        data: array[int]
    original = array[int, 8]()
    original[0] = 42
    buffer = Buffer(original)
    snapshot = copy buffer
    buffer.data = array[int, 16]()
    assert(len(buffer.data) == 16)
    buffer.data[0] = 9
    assert(buffer.data[0] == 9)
    assert(snapshot.data[0] == 42)
    buffer.data = copy snapshot.data
    assert(buffer.data[0] == 42)


test "nested owned fields copy independently and destroy recursively":
    class Pair:
        left: Vector
        right: Vector
    left = Vector()
    left.push(42)
    right = Vector()
    right.push(7)
    pair = Pair(left, right)
    snapshot = copy pair
    pair.left.set(0, 9)
    drop pair
    assert(snapshot.left.get(0) == 42)
    assert(snapshot.right.get(0) == 7)


test "return break and continue destroy class fields":
    def work() -> int:
        outer = Vector()
        outer.push(42)
        i = 0
        while i < 20:
            temporary = Vector()
            temporary.push(i)
            i += 1
            if i < 10:
                nested = Vector()
                nested.push(i)
                continue
            if i == 12:
                break
        return outer.get(0) + i
    assert(work() == 54)


