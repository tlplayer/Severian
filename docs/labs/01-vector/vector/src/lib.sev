class Vector[T = int]:
    items: array[T]
    count: int

    def Vector(self: borrow Self):
        self.items = allocate[array[T]](0)
        self.count = 0

    def size(self: view Self) -> int:
        return self.count

    def capacity(self: view Self) -> int:
        return len(self.items)

    def get(self: view Self, position: int) -> T with {-self.count <= position < self.count}:
        if position < 0:
            position += self.count
        value = copy self.items[position]
        return value

    def set(self: borrow Self, position: int, value: T) with {-self.count <= position < self.count}:
        if position < 0:
            position += self.count
        self.items[position] = value

    def reserve(self: borrow Self, requested: int):
        assert(requested >= 0)
        assert(requested <= 1152921504606846975)
        if requested > len(self.items):
            grown = allocate[array[T]](requested)
            i = 0
            while i < self.count:
                grown[i] = self.items[i]
                i += 1
            self.items = move grown

    def push(self: borrow Self, value: T):
        available = len(self.items)
        if self.count == available:
            requested = 1
            if available > 0:
                assert(available <= 576460752303423487)
                requested = available * 2
            self.reserve(requested)
        self.items[self.count] = value
        self.count += 1

    grammar assign[self, "[", index: int, "]", "=", value: T]() -> absent:
        self.set(index, value)

    grammar get[self, "[", index: int, "]"]() -> T:
        return self.get(index)

    grammar iterate["iterator", "(", self, ")"]() -> iterator[T]:
        while position < self.count with position = 0:
            yield self.items[position]
            position += 1

    def pop(self: borrow Self) -> T:
        assert(self.count > 0)
        self.count -= 1
        value = copy self.items[self.count]
        drop self.items[self.count]
        return value

    def pointer_view(self: view Self) -> pointer[T]:
        return pointer[T](self.items)

    # The result keeps a loan on this vector; sorting does not transfer storage.
    def sort(self: borrow Self) -> borrow Vector[T]:
        return VectorSort[T].sort(self)


trait VectorSort[T]:
    def sort(values: borrow Vector[T]) -> borrow Vector[T]


# These domains partition initialized length, not allocated capacity. The cutoff
# is a lab policy, not a claim that 32 is optimal for every element type/target.
class TrivialVectorSort[T]: VectorSort[T]:
    def sort(values: borrow Vector[T]) -> borrow Vector[T] with {values.count <= 1}:
        return borrow values


class InsertionVectorSort[T]: VectorSort[T]:
    def sort(values: borrow Vector[T]) -> borrow Vector[T] with {1 < values.count <= 32}:
        position = 1
        while position < values.size():
            value = values.get(position)
            destination = position
            while destination > 0:
                previous = values.get(destination - 1)
                if not (value < previous):
                    break
                values.set(destination, previous)
                destination -= 1
            values.set(destination, value)
            position += 1
        return borrow values


class MergeVectorSort[T]: VectorSort[T]:
    def sort(values: borrow Vector[T]) -> borrow Vector[T] with {values.count > 32}:
        count = values.size()
        scratch = Vector[T]()
        scratch.reserve(count)
        position = 0
        while position < count:
            scratch.push(values.get(position))
            position += 1

        # Bottom-up stable merges need no recursion. Every scratch slot is
        # initialized before replacement, including owned class elements.
        width = 1
        while width < count:
            start = 0
            while start < count:
                middle = start + width
                if middle > count:
                    middle = count
                end = middle + width
                if end > count:
                    end = count
                left = start
                right = middle
                destination = start
                while left < middle and right < end:
                    left_value = values.get(left)
                    right_value = values.get(right)
                    if right_value < left_value:
                        scratch.set(destination, right_value)
                        right += 1
                    else:
                        scratch.set(destination, left_value)
                        left += 1
                    destination += 1
                while left < middle:
                    scratch.set(destination, values.get(left))
                    left += 1
                    destination += 1
                while right < end:
                    scratch.set(destination, values.get(right))
                    right += 1
                    destination += 1
                start = end

            position = 0
            while position < count:
                values.set(position, scratch.get(position))
                position += 1
            if width >= count - width:
                break
            width *= 2
        return borrow values


test "sort covers empty singleton and both sides of the dispatch boundary":
    for count in [0, 1, 2, 31, 32, 33, 65, 128]:
        values = Vector[int]()
        values.reserve(256)
        position = 0
        while position < count:
            values.push(count - position)
            position += 1
        values.sort()
        assert(values.size() == count)
        assert(values.capacity() == 256)
        position = 0
        while position < count:
            assert(values.get(position) == position + 1)
            position += 1


test "sort returns a mutable alias and preserves the original owner":
    values = Vector[int]()
    values.push(3)
    values.push(1)
    values.push(2)
    sorted_values = values.sort()
    assert(sorted_values.get(0) == 1)
    sorted_values.set(0, -7)
    assert(values.get(0) == -7)
    values.push(4)
    assert(values.size() == 4)


test "sort alias can be forwarded and chained":
    def ordered(values: borrow Vector[int]) -> borrow Vector[int]:
        return values.sort()
    values = Vector[int]()
    values.push(3)
    values.push(1)
    ordered(values).sort().set(0, -1)
    assert(values.get(0) == -1)
    assert(values.get(1) == 3)


test "sort reevaluates length after mutation and preserves duplicates":
    values = Vector[int]()
    position = 0
    while position < 32:
        values.push(1)
        position += 1
    values.sort()
    values.push(-4)
    values.sort()
    assert(values.get(0) == -4)
    position = 1
    while position < values.size():
        assert(values.get(position) == 1)
        position += 1
    values.sort()
    assert(values.size() == 33)
    assert(values.get(0) == -4)
    assert(values.get(-1) == 1)


test "direct trait calls and vector methods preserve generic element types":
    values = Vector[i32]()
    values.push(i32(9))
    values.push(i32(-2))
    sorted_values = VectorSort[i32].sort(values)
    assert(sorted_values.get(0) == i32(-2))
    sorted_values.set(1, i32(4))
    assert(values.get(1) == i32(4))
    values.sort()
    assert(values.get(0) == i32(-2))


test "insertion and merge sorting preserve the order of equal keys":
    class Entry:
        key: int
        ordinal: int

        operator <(right: Entry) -> bool:
            return self.key < right.key

    for count in [6, 65]:
        values = Vector[Entry]()
        position = 0
        while position < count:
            values.push(Entry(position % 3, position))
            position += 1
        values.sort()
        position = 0
        key = 0
        while key < 3:
            ordinal = key
            while ordinal < count:
                item = values.get(position)
                assert(item.key == key)
                assert(item.ordinal == ordinal)
                position += 1
                ordinal += 3
            key += 1
        assert(position == count)
        assert(values.size() == count)


test with compiler "another matching sorter is ambiguity rather than an override":
