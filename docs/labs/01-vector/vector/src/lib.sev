        class Buffer:
            data: array[int]
        def invalid():
            value = Buffer(array[int, 1]())
            shared = share value


test "owning class return transfers its fields":
    class Buffer:
        data: array[int]
    def make() -> Buffer:
        value = Buffer(array[int, 1]())
        value.data[0] = 42
        return value
    result = make()
    assert(result.data[0] == 42)


