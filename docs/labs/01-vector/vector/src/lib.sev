test "inferred field allocation survives constructor return":
    class Buffer:
        data: array[int]
        def Buffer(self: borrow Self):
            self.data = array[int, 8]()
            self.data[0] = 42
    value = Buffer()
    assert(value.data[0] == 42)
    value.data = array[int, 16]()
    assert(len(value.data) == 16)


