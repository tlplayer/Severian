                return pointer[0]


test "class grammar reuses checked vector mutation":
    values = Vector()
    values.push(1)
    values.push(2)
    values[0] = 42
    values[1] = 7
    assert(values.get(0) == 42)
    assert(values.get(1) == 7)


test "class grammar preserves logical bounds checks":
    throws "prefix contract failed":
        values = Vector()
        values[0] = 42


test "iterator values match indexed access with existing counter":
    X = Vector()
    X.push(42)
    X.push(7)
    visited = 0
    i = 99
    for x in X with i = 0:
        assert(x == X[i])
        i += 1
        visited += 1
    assert(visited == 2)
    assert(i == 2)
    X.push(11)


test "empty iterator does not execute consumer":
    values = Vector()
    visited = 0
    for x in values:
        visited += 1
    assert(visited == 0)


test "iterator continue resumes producer and break releases view":
    values = Vector()
    values.push(1)
    values.push(2)
    values.push(3)
    total = 0
    for x in iterator(values):
        scratch = array[int, 1]()
        if x == 1:
            continue
        total += x
        break
    assert(total == 2)
    values.push(4)


test "iterator return cleans producer and consumer locals":
    def first() -> int:
        values = Vector()
        values.push(42)
        for x in values:
            scratch = array[int, 8]()
            return x
        return 0
    assert(first() == 42)


test "multiple yields preserve producer locals":
    class Pairs:
        value: int
        grammar iterate["iterator", "(", self, ")"]() -> iterator[int]:
            scratch = array[int, 1]()
            scratch[0] = self.value
            yield scratch[0]
            scratch[0] += 1
            yield scratch[0]
    pairs = Pairs(7)
    total = 0
    for x in pairs:
        total += x
    assert(total == 15)
    for x in pairs:
        break


