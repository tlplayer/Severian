from data import Data
import graphics
import plot

def training_results() -> Data:
    return Data(
        ["step", "loss"],
        [[0.0, 4.0], [1.0, 2.7], [2.0, 1.8], [3.0, 1.2], [4.0, 0.8]],
    )

def loss_chart() -> plot.Chart:
    chart := plot.Chart(800, 500)
    match chart.line_data_labeled(training_results(), "step", "loss", "training loss"):
        case _:
            assert(true)
        case error:
            assert(false, error)
    chart.title("Model training")
    chart.x_label("step")
    chart.y_label("loss")
    return chart

test "plot example renders data labels and a legend":
    chart = loss_chart()
    target: graphics.Canvas = chart.render()
    document = target.svg()
    assert(document.contains("Model training"))
    assert(document.contains("training loss"))
    assert(document.contains("<line"))

def main():
    chart = loss_chart()
    target: graphics.Canvas = chart.render()
    path = "/tmp/severian-plot-example.svg"
    match target.save(path):
        case _:
            print("plot", target.width(), target.height())
            print(path)
        case error:
            assert(false, error)
