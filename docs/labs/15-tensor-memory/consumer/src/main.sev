# Shape and strides travel with the tensor across function boundaries.
def matrix() -> tensor[int, (None, None)]:
    values = tensor[int](2, 3)
    values[1, 2] = 7
    return values

def fixed_chunk() -> tuple[int, 2]:
    chunk = tuple[int,2](1,2)
    chunk[0] = 3
    return chunk

def main() -> int:
    values = matrix()
    values.resize(3, 4)
    if values[1, 2] == 7 and values[2, 3] == 0:
        return 0
    return 1

test  "resize preserves coordinates and initializes new cells":
    values = matrix()
    values.resize(3, 4)
    assert(values[1, 2] == 7)
    assert(values[2, 3] == 0)
    assert(values.dim(0) == 3 and values.dim(1) == 4)
    assert(len(values) == 12)
    values.resize(1, 2)
    assert(len(values) == 2)
    values.resize(0, 2)
    assert(len(values) == 0)

test  "tuple shape is fixed but fields can change":
    chunk = fixed_chunk()
    assert(chunk[0] == 3 and chunk[1] == 2)
    chunk[1] = 4
    assert(chunk[1] == 4)

test  "stack tensor uses the allocation layout contract":
    unsafe:
        values = allocate[tensor[int, (None, None)], location=memory.stack, alignment=64](2, 3)
        values[1, 2] = 9
        assert(values[1, 2] == 9)

test "tensor rejects an invalid dimension":
    throws "tensor dimension outside rank":
        values = tensor[int](2, 3)
        invalid = values.dim(2)

test "tensor rejects negative extents":
    throws "tensor extent must be nonnegative":
        values = tensor[int](-1, 3)

test "rank-one tensor replaces growable vector storage":
    values = tensor[int](0)
    values.append(42)
    values.append(7)
    assert(values[0] == 42 and values[1] == 7)
    assert(len(values) == 2)
