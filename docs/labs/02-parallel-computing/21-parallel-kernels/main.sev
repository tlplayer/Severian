import tensor
import model

def algebra():
    a = tensor([1.0, 0.0, 0.0, 1.0], [2, 2])
    b = tensor([1.0, 0.0, 0.0, 1.0], [2, 2])
    product = tensor.matmul(a, b)
    jacobian = model.jacobian_list([1.0, 0.0])
    zero = tensor([0.0], [1, 1])
    print(tensor.values(product))
    print(jacobian)
    print(tensor.values(zero))

@model(Relu, FastTanh, Swish)
def forward(x: list[float]) -> list[float]:
    return Swish(FastTanh(Relu(x)))

def main():
    algebra()
    print(forward([0.0]))
