# Deterministic port of labrpc's externally observable network behavior.

class RpcReply:
    delivered: bool
    value: int

    def RpcReply(delivered_value: bool, reply_value: int):
        delivered = delivered_value
        value = reply_value

class RpcNetwork:
    endpoint_names: list[string]
    endpoint_servers: list[string]
    endpoint_enabled: list[bool]
    server_names: list[string]
    server_offsets: list[int]
    reliable: bool
    request_count: int
    byte_count: int
    fault_sequence: int

    def RpcNetwork():
        endpoint_names = []
        endpoint_servers = []
        endpoint_enabled = []
        server_names = []
        server_offsets = []
        reliable = true
        request_count = 0
        byte_count = 0
        fault_sequence = 0

    def endpoint_index(name: string) -> int:
        for index in range(size(endpoint_names)):
            if endpoint_names[index] == name:
                return index
        return -1

    def server_index(name: string) -> int:
        for index in range(size(server_names)):
            if server_names[index] == name:
                return index
        return -1

    def make_endpoint(name: string):
        endpoint_names.append(name)
        endpoint_servers.append("")
        endpoint_enabled.append(false)

    def add_server(name: string, offset: int):
        server_names.append(name)
        server_offsets.append(offset)

    def delete_server(name: string):
        index := -1
        for candidate_index in range(size(server_names)):
            if server_names[candidate_index] == name:
                index = candidate_index
        if index >= 0:
            server_names.pop(index)
            server_offsets.pop(index)

    def connect(endpoint: string, server: string):
        for index in range(size(endpoint_names)):
            if endpoint_names[index] == endpoint:
                endpoint_servers[index] = server

    def enable(endpoint: string, enabled: bool):
        for index in range(size(endpoint_names)):
            if endpoint_names[index] == endpoint:
                endpoint_enabled[index] = enabled

    def set_reliable(enabled: bool):
        reliable = enabled

    def call(endpoint: string, argument: int) -> RpcReply:
        request_count += 1
        byte_count += 8
        endpoint_index_value := -1
        for index in range(size(endpoint_names)):
            if endpoint_names[index] == endpoint:
                endpoint_index_value = index
        if endpoint_index_value < 0 or not endpoint_enabled[endpoint_index_value]:
            return RpcReply(false, 0)
        server_index_value := -1
        for index in range(size(server_names)):
            if server_names[index] == endpoint_servers[endpoint_index_value]:
                server_index_value = index
        if server_index_value < 0:
            return RpcReply(false, 0)
        fault_sequence += 1
        if not reliable and fault_sequence % 4 == 0:
            return RpcReply(false, 0)
        byte_count += 8
        return RpcReply(true, argument + server_offsets[server_index_value])

test "disabled disconnected and deleted endpoints fail":
    network := RpcNetwork()
    network.make_endpoint("client")
    assert(not network.call("client", 10).delivered)
    network.add_server("server", 5)
    network.connect("client", "server")
    assert(not network.call("client", 10).delivered)
    network.enable("client", true)
    assert(network.call("client", 10).value == 15)
    network.delete_server("server")
    assert(not network.call("client", 10).delivered)

test "unreliable schedule drops requests reproducibly":
    network := RpcNetwork()
    network.make_endpoint("client")
    network.add_server("server", 1)
    network.connect("client", "server")
    network.enable("client", true)
    network.set_reliable(false)
    assert(network.call("client", 1).delivered)
    assert(network.call("client", 2).delivered)
    assert(network.call("client", 3).delivered)
    assert(not network.call("client", 4).delivered)
    assert(network.request_count == 4)
    assert(network.byte_count == 56)

def main():
    network := RpcNetwork()
    network.make_endpoint("worker-1")
    network.add_server("coordinator", 40)
    network.connect("worker-1", "coordinator")
    network.enable("worker-1", true)
    reply = network.call("worker-1", 2)
    print("rpc", reply.delivered, reply.value, network.request_count)
