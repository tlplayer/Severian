# Behavioral port of rsm and kvraft: leader submission, application, and
# at-most-once handling keyed by client and sequence number.

class CommandReply:
    success: bool
    value: string
    error: string

    def CommandReply(success_value: bool, value_value: string, error_value: string):
        success = success_value
        value = value_value
        error = error_value

class StateMachine:
    keys: list[string]
    values: list[string]
    clients: list[string]
    sequences: list[int]
    cached_values: list[string]
    applied_count: int

    def StateMachine():
        keys = []
        values = []
        clients = []
        sequences = []
        cached_values = []
        applied_count = 0

    def apply(client: string, sequence: int, operation: string, key: string, value: string) -> CommandReply:
        for index in range(size(clients)):
            if clients[index] == client and sequences[index] == sequence:
                return CommandReply(true, cached_values[index], "OK")
        key_index := -1
        for index in range(size(keys)):
            if keys[index] == key:
                key_index = index
        output := ""
        if operation == "put":
            if key_index < 0:
                keys.append(key)
                values.append(value)
            else:
                values[key_index] = value
            output = value
        else operation == "append":
            if key_index < 0:
                keys.append(key)
                values.append(value)
                output = value
            else:
                values[key_index] = values[key_index] + value
                output = values[key_index]
        else operation == "get":
            if key_index < 0:
                return CommandReply(false, "", "ErrNoKey")
            output = values[key_index]
        else:
            return CommandReply(false, "", "ErrOperation")
        clients.append(client)
        sequences.append(sequence)
        cached_values.append(output)
        applied_count += 1
        return CommandReply(true, output, "OK")

class Replica:
    identifier: int
    leader: bool
    state_machine: StateMachine
    log: list[string]

    def Replica(identifier_value: int):
        identifier = identifier_value
        leader = false
        state_machine = StateMachine()
        log = []

    def set_leader(enabled: bool):
        leader = enabled

    def submit(client: string, sequence: int, operation: string, key: string, value: string) -> CommandReply:
        if not leader:
            return CommandReply(false, "", "ErrWrongLeader")
        log.append(client + ":" + string(sequence) + ":" + operation + ":" + key)
        return state_machine.apply(client, sequence, operation, key, value)

class ReplicatedService:
    replicas: list[Replica]
    leader_identifier: int

    def ReplicatedService(count: int):
        replicas = []
        for identifier in range(count):
            replicas.append(Replica(identifier))
        leader_identifier = 0
        replicas[0].set_leader(true)

    def change_leader(identifier: int):
        for index in range(size(replicas)):
            replicas[index].set_leader(index == identifier)
        leader_identifier = identifier

    def command(client: string, sequence: int, operation: string, key: string, value: string) -> CommandReply:
        reply = replicas[leader_identifier].submit(client, sequence, operation, key, value)
        if reply.success and operation != "get":
            for index in range(size(replicas)):
                if index != leader_identifier:
                    replicas[index].state_machine.apply(client, sequence, operation, key, value)
                    replicas[index].log.append(client + ":" + string(sequence) + ":" + operation + ":" + key)
        return reply

test "wrong leader and replicated commands":
    service := ReplicatedService(3)
    assert(service.replicas[1].submit("c", 1, "put", "x", "1").error == "ErrWrongLeader")
    assert(service.command("c", 1, "put", "x", "1").success)
    assert(service.command("c", 2, "append", "x", "2").value == "12")
    assert(service.command("reader", 1, "get", "x", "").value == "12")
    assert(service.replicas[2].state_machine.values[0] == "12")

test "duplicate command is applied once":
    service := ReplicatedService(3)
    assert(service.command("client-a", 9, "put", "counter", "one").success)
    duplicate = service.command("client-a", 9, "put", "counter", "wrong")
    assert(duplicate.value == "one")
    assert(service.replicas[0].state_machine.applied_count == 1)

test "new leader retains replicated state":
    service := ReplicatedService(3)
    service.command("writer", 1, "put", "key", "value")
    service.change_leader(2)
    assert(service.command("reader", 1, "get", "key", "").value == "value")

def main():
    service := ReplicatedService(3)
    service.command("client", 1, "put", "answer", "42")
    print("replicated-state-machine", service.command("client", 2, "get", "answer", "").value)
