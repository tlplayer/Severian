# Behavioral port of labgob: detached values, visible schema fields, and
# default decode receivers. Severian's static fields replace Go reflection.

class WireMessage:
    term: int
    leader: string
    entries: list[string]

    def WireMessage(term_value: int, leader_value: string, entry_values: list[string]):
        term = term_value
        leader = leader_value
        entries = entry_values

class Decoder:
    warning_count: int

    def Decoder():
        warning_count = 0

    def receiver_is_default(message: WireMessage) -> bool:
        if message.term != 0 or message.leader != "" or size(message.entries) != 0:
            warning_count += 1
            return false
        return true

def fields_are_exportable(field_names: list[string]) -> bool:
    for name in field_names:
        if size(name) == 0:
            return false
        first = name[0]
        if first == first.lower():
            return false
    return true

def encode(message: WireMessage) -> list[string]:
    payload := [string(message.term), message.leader]
    payload.extend(message.entries)
    return payload

def decode_known(payload: list[string], term: int) -> WireMessage:
    entries := []
    for index in range(2, size(payload)):
        entries.append(payload[index])
    return WireMessage(term, payload[1], entries)

def detached_copy(message: WireMessage) -> WireMessage:
    entries = [entry for entry in message.entries]
    return WireMessage(message.term, message.leader, entries)

test "public persistence schema":
    assert(fields_are_exportable(["Term", "Leader", "Entries"]))
    assert(not fields_are_exportable(["Term", "leader"]))

test "wire representation and detached collection":
    original := WireMessage(7, "node-2", ["set x 1", "set y 2"])
    payload = encode(original)
    restored = decode_known(payload, 7)
    assert(restored.term == 7)
    assert(restored.leader == "node-2")
    assert(restored.entries == ["set x 1", "set y 2"])
    copied = detached_copy(original)
    copied.entries.append("set z 3")
    assert(size(original.entries) == 2)

test "decoder warns for a reused receiver":
    decoder := Decoder()
    assert(decoder.receiver_is_default(WireMessage(0, "", [])))
    assert(not decoder.receiver_is_default(WireMessage(1, "old", [])))
    assert(decoder.warning_count == 1)

def main():
    message = decode_known(encode(WireMessage(3, "leader-a", ["append 1"])), 3)
    print("serialization", message.term, message.leader, size(message.entries))
