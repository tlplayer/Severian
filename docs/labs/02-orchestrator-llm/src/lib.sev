import model

def escape_json(value: string) -> string:
    return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")

def info_json(loaded: model.LoadedModel, replica: string, accelerator: string) -> string:
    rendered := "{\"model\":\"" + loaded.artifact.identifier
    rendered += "\",\"architecture\":\"" + loaded.architecture
    rendered += "\",\"parameters\":" + string(loaded.parameters)
    rendered += ",\"dtype\":\"" + loaded.dtype
    rendered += "\",\"revision\":\"" + loaded.artifact.revision
    rendered += "\",\"replica\":\"" + escape_json(replica)
    rendered += "\",\"accelerator\":\"" + escape_json(accelerator) + "\"}"
    return rendered

def control_response(request: string, ready: bool, loaded: model.LoadedModel, replica: string, accelerator: string, requests: int) -> string:
    command = request.strip()
    if command.starts_with("GET /live"):
        return "{\"live\":true,\"replica\":\"" + escape_json(replica) + "\"}"
    if command.starts_with("GET /ready"):
        value = "true" if ready else "false"
        return "{\"ready\":" + value + ",\"replica\":\"" + escape_json(replica) + "\"}"
    if command.starts_with("GET /metrics"):
        value = 1 if ready else 0
        return "requests_total " + string(requests) + "\nmodel_loaded " + string(value) + "\nmodel_ready " + string(value) + "\n"
    if command.starts_with("GET /info"):
        return info_json(loaded, replica, accelerator)
    return ""

test "worker protocol keeps liveness separate from model readiness":
    selected = model.artifact(model.SmolLm2, model.SmolLm2Revision, "/tmp/model-missing")
    loaded = model.LoadedModel(selected, "LlamaForCausalLM", 134515008, "bf16")
    assert("\"live\":true" in control_response("GET /live", false, loaded, "tiny-llm-0", "native", 0))
    assert("\"ready\":false" in control_response("GET /ready", false, loaded, "tiny-llm-0", "native", 0))

test "model info reports the immutable artifact revision":
    selected = model.artifact(model.SmolLm2, model.SmolLm2Revision, "/tmp/model-missing")
    loaded = model.LoadedModel(selected, "LlamaForCausalLM", 134515008, "bf16")
    rendered = info_json(loaded, "tiny-llm-0", "gfx1101")
    assert(model.SmolLm2Revision in rendered)
    assert(rendered.contains("golden-smoke") == false)
