# Track: LeetCode 75
# Problem: 1431 - Kids With the Greatest Number of Candies
# Difficulty: easy
# Tags: array, two-pass
# Return whether each child can reach the current maximum after receiving all
# extra candies.

def kids_with_candies(candies: list[int], extra_candies: int) -> list[bool]:
    greatest := candies[0]
    for candy in candies:
        if candy > greatest:
            greatest = candy

    result := []
    for candy in candies:
        result.append(candy + extra_candies >= greatest)

    return result

test "representative distribution":
    assert(kids_with_candies([2, 3, 5, 1, 3], 3) == [true, true, true, false, true])

test "tied greatest values":
    assert(kids_with_candies([4, 2, 1, 1, 2], 1) == [true, false, false, false, false])

test "single child":
    assert(kids_with_candies([7], 0) == [true])
