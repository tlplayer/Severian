# Track: Hard validation
# Problem: 239 - Sliding Window Maximum
# Difficulty: hard
# Tags: monotonic-queue, queue, sliding-window, array

def max_sliding_window(values: list[int], width: int) -> list[int]:
    deque := []
    result := []
    for index, value in enumerate(values):
        while size(deque) > 0 and values[deque.last()] <= value:
            deque.pop()
        if size(deque) > 0 and deque[0] <= index - width:
            deque.popleft()
        deque.append(index)
        if index + 1 >= width:
            result.append(values[deque[0]])
    return result

test "standard windows":
    assert(max_sliding_window([1, 3, -1, -3, 5, 3, 6, 7], 3) == [3, 3, 5, 5, 6, 7])

test "single element windows":
    assert(max_sliding_window([4, 2], 1) == [4, 2])

test "whole array window":
    assert(max_sliding_window([9, 7, 8], 3) == [9])
