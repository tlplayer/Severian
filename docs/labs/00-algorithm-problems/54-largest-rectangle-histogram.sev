# Track: Hard validation
# Problem: 84 - Largest Rectangle in Histogram
# Difficulty: hard
# Tags: monotonic-stack, stack, array

def largest_rectangle_area(heights: list[int]) -> int:
    stack := []
    best := 0
    index := 0
    while index <= size(heights):
        current := 0
        if index < size(heights):
            current = heights[index]
        while size(stack) > 0 and heights[stack.last()] > current:
            height = heights[stack.pop()]
            left := 0
            if size(stack) > 0:
                left = stack.last() + 1
            area = height * (index - left)
            if area > best:
                best = area
        stack.append(index)
        index += 1
    return best

test "mixed histogram":
    assert(largest_rectangle_area([2, 1, 5, 6, 2, 3]) == 10)

test "two bars":
    assert(largest_rectangle_area([2, 4]) == 4)

test "empty histogram":
    assert(largest_rectangle_area([]) == 0)
