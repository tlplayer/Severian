import parallel
import tensor

def attention(
    query: Tensor[f64],
    key: Tensor[f64],
    value: Tensor[f64],
) -> Tensor[f64]:
    with gpu:
        key_transposed = tensor.transpose(key)
        scores = tensor.matmul(query, key_transposed)
        probabilities = tensor.softmax_rows(scores)
        return tensor.matmul(probabilities, value)

test "zero query and key produce a uniform weighted value":
    query = tensor([0.0, 0.0, 0.0, 0.0], [2, 2])
    key = tensor([0.0, 0.0, 0.0, 0.0], [2, 2])
    value = tensor([2.0, 4.0, 6.0, 8.0], [2, 2])

    result = attention(query, key, value)

    assert(tensor.shape(result) == [2, 2])
    assert(tensor.values(result) == [4.0, 6.0, 4.0, 6.0])
