# Track: Concurrency validation
# Problem: 1117 - Building H2O
# Difficulty: medium
# Tags: concurrency, barrier, channel

def release_hydrogen(permit: Channel[int], completed: Channel[int], output: Channel[string]):
    await permit
    emitted = async send "H" with output
    await emitted
    done = async send 1 with completed
    await done

def release_oxygen(completed: Channel[int], output: Channel[string]):
    await completed
    await completed
    emitted = async send "O" with output
    await emitted

def build_water(molecules: int) -> list[string]:
    result := []
    for _ in range(molecules):
        hydrogen = Channel[int] with Buffer(2)
        completed = Channel[int] with Buffer(2)
        output = Channel[string] with Buffer(3)
        first_permit = async send 1 with hydrogen
        second_permit = async send 1 with hydrogen
        oxygen_task = async release_oxygen(completed, output) with self
        first_hydrogen = async release_hydrogen(hydrogen, completed, output) with self
        second_hydrogen = async release_hydrogen(hydrogen, completed, output) with self
        result.append(await output)
        result.append(await output)
        result.append(await output)
        await first_permit, second_permit, first_hydrogen, second_hydrogen, oxygen_task
    return result

test "two molecules":
    assert(build_water(2) == ["H", "H", "O", "H", "H", "O"])

test "single molecule":
    assert(build_water(1) == ["H", "H", "O"])
