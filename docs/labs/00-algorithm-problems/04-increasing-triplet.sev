# Track: LeetCode 75
# Problem: 334 - Increasing Triplet Subsequence
# Difficulty: medium
# Tags: array, greedy
# Return true when three values appear in strictly increasing index and value
# order. The values do not need to be adjacent.

def increasing_triplet(values: list[int]) -> bool:
    first := 0
    second := 0
    has_first := false
    has_second := false

    for value in values:
        if not has_first or value <= first:
            first = value
            has_first = true
        else:
            if not has_second or value <= second:
                second = value
                has_second = true
            else:
                return true

    return false

test "increasing input":
    assert(increasing_triplet([1, 2, 3, 4, 5]))

test "decreasing input":
    assert(not increasing_triplet([5, 4, 3, 2, 1]))

test "non-adjacent triplet":
    assert(increasing_triplet([2, 1, 5, 0, 4, 6]))

test "duplicates are not strictly increasing":
    assert(not increasing_triplet([1, 1, 1, 1]))

test "short input":
    assert(not increasing_triplet([1, 2]))
