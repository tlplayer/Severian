# Track: LeetCode 75
# Problem: 547 - Number of Provinces
# Difficulty: medium
# Tags: graph, matrix, depth-first-search, union-find

def find_root(parent: list[int], city: int) -> int:
    root := city
    while parent[root] != root:
        root = parent[root]
    return root

def provinces_union_find(connected: list[list[int]]) -> int:
    parent := []
    for city in indices(connected):
        parent.append(city)
    provinces := size(connected)
    for first in indices(connected):
        for second in range(first + 1, size(connected)):
            if connected[first][second] == 1:
                first_root = find_root(parent, first)
                second_root = find_root(parent, second)
                if first_root != second_root:
                    parent[second_root] = first_root
                    provinces -= 1
    return provinces

def visit_province(connected: list[list[int]], visited: list[bool], city: int):
    visited[city] = true
    for neighbor in indices(connected):
        if connected[city][neighbor] == 1 and not visited[neighbor]:
            visit_province(connected, visited, neighbor)

def provinces_depth_first(connected: list[list[int]]) -> int:
    visited := []
    for city in indices(connected):
        visited.append(false)
    provinces := 0
    for city in indices(connected):
        if not visited[city]:
            provinces += 1
            visit_province(connected, visited, city)
    return provinces

test "two provinces":
    graph = [[1, 1, 0], [1, 1, 0], [0, 0, 1]]
    assert(provinces_union_find(graph) == 2)
    assert(provinces_depth_first(graph) == 2)

test "separate components":
    graph = [[1, 0, 0], [0, 1, 1], [0, 1, 1]]
    assert(provinces_union_find(graph) == 2)

test "single city":
    assert(provinces_union_find([[1]]) == 1)
    assert(provinces_depth_first([[1]]) == 1)
