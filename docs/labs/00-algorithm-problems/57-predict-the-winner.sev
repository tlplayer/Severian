# Track: Hard validation
# Problem: 486 - Predict the Winner
# Difficulty: medium
# Tags: game-theory, minimax, memoization, dynamic-programming, recursion

def best_difference(values: list[int], memo: list[list[int]], left: int, right: int) -> int:
    if left == right:
        return values[left]
    if memo[left][right] != -1000000000:
        return memo[left][right]
    take_left = values[left] - best_difference(values, memo, left + 1, right)
    take_right = values[right] - best_difference(values, memo, left, right - 1)
    best := take_left
    if take_right > best:
        best = take_right
    memo[left][right] = best
    return best

def predict_the_winner(values: list[int]) -> bool:
    memo := []
    for row_index in indices(values):
        row := []
        for column_index in indices(values):
            row.append(-1000000000)
        memo.append(row)
    return best_difference(values, memo, 0, size(values) - 1) >= 0

test "first player loses":
    assert(not predict_the_winner([1, 5, 2]))

test "first player wins":
    assert(predict_the_winner([1, 5, 233, 7]))

test "tie is a win":
    assert(predict_the_winner([1, 1]))
