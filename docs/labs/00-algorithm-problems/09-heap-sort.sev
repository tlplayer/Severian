def heap_sort(values: list[int]) -> list[int]:
    heap := []

    for value in values:
        heap.heap_push(value)

    output := []
    while size(heap) > 0:
        output.append(heap.heap_pop())

    return output

test "sorts an unsorted list":
    assert(heap_sort([5, 1, 4, 2, 8]) == [1, 2, 4, 5, 8])

test "preserves duplicates":
    assert(heap_sort([3, 1, 3, 2]) == [1, 2, 3, 3])

test "handles empty input":
    assert(heap_sort([]) == [])
