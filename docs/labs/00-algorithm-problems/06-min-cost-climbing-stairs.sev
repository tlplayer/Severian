# Track: LeetCode 75
# Problem: 746 - Min Cost Climbing Stairs
# Difficulty: easy
# Tags: array, dynamic-programming
# Return the minimum cost of stepping beyond the final stair when each move may
# advance by one or two positions.

def minimum(left: int, right: int) -> int:
    if left < right:
        return left
    return right

def min_cost_climbing_stairs(cost: list[int]) -> int:
    two_back := cost[0]
    one_back := cost[1]

    while index < size(cost) with index := 2:
        current = cost[index] + minimum(two_back, one_back)
        two_back = one_back
        one_back = current
        index += 1

    return minimum(two_back, one_back)

test "three stairs":
    assert(min_cost_climbing_stairs([10, 15, 20]) == 15)

test "alternating expensive stairs":
    assert(min_cost_climbing_stairs([1, 100, 1, 1, 1, 100, 1, 1, 100, 1]) == 6)

test "free stairs":
    assert(min_cost_climbing_stairs([0, 0]) == 0)
