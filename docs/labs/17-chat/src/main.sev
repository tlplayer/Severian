import network
import io
import process
import cli
import string
from collections import list
from network import NetworkError
from cli import CliError

# Run ./docs/labs/17-chat/run.sh; connect with nc 127.0.0.1 7777.
# /nick alice, /who, /help, /quit. Every other line broadcasts to the room.
# The reactor is single-threaded: one writer per connection, no shared mutation.
# Limits: 64 clients, 1024-byte lines, 64 KiB queued output per client,
# 300-second idle timeout, 10-second stalled-output timeout, 2-second close grace.

def valid_name(name: string) -> bool:
    if len(name) < 1 or len(name) > 24:
        return false
    for character in name:
        code = int(character)
        if not ((code >= 48 and code <= 57) or (code >= 65 and code <= 90) or
                (code >= 97 and code <= 122) or code == 45 or code == 95):
            return false
    return true

# Validate complete UTF-8 frames; input fragments may split a codepoint.
# Terminal control characters, including embedded CR/ESC/NUL, are rejected.
def valid_message(text: string) -> bool:
    position = 0
    while position < len(text):
        code = int(text[position])
        if code < 32 or code == 127:
            return false
        if code < 128:
            position += 1
            continue
        width = 0
        minimum = 128
        maximum = 191
        if code >= 194 and code <= 223:
            width = 2
        elif code >= 224 and code <= 239:
            width = 3
            if code == 224:
                minimum = 160
            if code == 237:
                maximum = 159
        elif code >= 240 and code <= 244:
            width = 4
            if code == 240:
                minimum = 144
            if code == 244:
                maximum = 143
        else:
            return false
        if width > len(text) - position:
            return false
        next = int(text[position + 1])
        if next < minimum or next > maximum:
            return false
        offset = 2
        while offset < width:
            next = int(text[position + offset])
            if next < 128 or next > 191:
                return false
            offset += 1
        position += width
    return true

class Client:
    connection: network.Connection
    name: string
    input: string = ""
    input_error: string = ""
    output: string = ""
    sent: int = 0
    closing: bool = false
    closed: bool = false
    close_at: int = 0
    activity: int = 0
    progress: int = 0

    def Client(socket: move network.Connection, nickname: string, now: int):
        connection := move socket
        name := nickname
        input := ""
        input_error := ""
        output := ""
        sent := 0
        closing := false
        closed := false
        close_at := 0
        activity := now
        progress := now

    def disconnect():
        connection.close()
        closed = true

    def finish(now: int):
        if not closing:
            closing = true
            close_at = now + 2000000000

    def queue(text: string, now: int):
        if closed or closing:
            return
        pending = len(output) - sent
        if len(text) > 65536 - pending:
            disconnect()
            return
        if pending == 0:
            output = text
            sent = 0
            progress = now
        else:
            output = output[sent:] + text
            sent = 0

    def flush(now: int):
        if closed or sent == len(output):
            return
        bytes = output.utf()
        written = connection.send(bytes, sent, len(bytes) - sent)
        if written > 0:
            sent += written
            progress = now
            if sent == len(output):
                output = ""
                sent = 0
        elif written != -11 and written != -4:
            disconnect()

    def receive(now: int) -> list[string]:
        lines = list[string]()
        if closed or closing:
            return lines
        data = tensor[u8](4096)
        received = connection.receive(data, 0, 4096)
        if received == -11 or received == -4:
            return lines
        if received <= 0:
            # EOF never publishes an unterminated partial line.
            if received == 0:
                finish(now)
            else:
                disconnect()
            return lines
        activity = now
        position = 0
        while position < received:
            code = int(data[position])
            if code == 10:
                line = without_line_ending(input)
                input = ""
                if not valid_message(line):
                    input_error = "error: invalid UTF-8 or control character\n"
                    return lines
                lines.append(line)
            else:
                # One extra byte permits CRLF at the 1024-byte payload limit.
                if len(input) >= 1024 and not (len(input) == 1024 and code == 13):
                    input_error = "error: line exceeds 1024 bytes\n"
                    return lines
                input = input + string(data[position:position + 1))
            position += 1
        return lines

    def finish_input(now: int):
        # Deliver complete valid frames before a later malformed frame, even
        # when TCP coalesces both into the same receive. /quit still wins.
        if input_error != "":
            queue(input_error, now)
            input_error = ""
            finish(now)

    def expire(now: int):
        if closed:
            return
        if closing:
            if sent == len(output) or now >= close_at:
                disconnect()
        elif now - activity >= 300000000000:
            queue("error: idle timeout\n", now)
            finish(now)
        elif len(output) > sent and now - progress >= 10000000000:
            disconnect()

def without_line_ending(text: string) -> string:
    if len(text) > 0 and text[len(text) - 1] == u8(13):
        return text[:len(text) - 1)
    return copy text

class Room:
    clients: list[Client]
    next_identity: int = 1

    def Room():
        clients := list[Client]()
        next_identity := 1
        clients.reserve(64)

    def broadcast(text: string, now: int):
        position = 0
        while position < clients.len():
            client = clients.borrow_at(position)
            client.queue(text, now)
            position += 1

    def queue(position: int, text: string, now: int):
        client = clients.borrow_at(position)
        client.queue(text, now)

    def name_taken(name: string) -> bool:
        position = 0
        while position < clients.len():
            client = clients.view_at(position)
            if not client.closed and client.name == name:
                return true
            position += 1
        return false

    def add(connection: move network.Connection, now: int):
        if clients.len() >= 64:
            message = "error: room full\n".utf()
            connection.send(message, 0, len(message))
            connection.close()
            return
        name = "guest-" + string(next_identity)
        next_identity += 1
        while name_taken(name):
            name = "guest-" + string(next_identity)
            next_identity += 1
        client = Client(connection, name, now)
        client.queue("welcome " + name + "\n/nick NAME /who /help /quit\n", now)
        clients.append_owned(client)
        broadcast("* " + name + " joined\n", now)

    def message(position: int, text: string, now: int):
        if text == "":
            return
        if text == "/help":
            queue(position, "/nick NAME /who /help /quit; other lines broadcast\n", now)
        elif text == "/who":
            names = "users:"
            index = 0
            while index < clients.len():
                client = clients.view_at(index)
                if not client.closed and not client.closing:
                    names = names + " " + client.name
                index += 1
            queue(position, names + "\n", now)
        elif text == "/quit":
            client = clients.borrow_at(position)
            client.queue("bye\n", now)
            client.finish(now)
        elif text == "/nick" or text[:6) == "/nick ":
            name = text[6:]
            if not valid_name(name):
                queue(position, "error: name must be 1-24 ASCII letters, digits, - or _\n", now)
            elif name_taken(name):
                queue(position, "error: name already in use\n", now)
            else:
                previous = rename(position, name)
                broadcast("* " + previous + " is now " + name + "\n", now)
        elif text[0] == u8(47):
            queue(position, "error: unknown command; use /help\n", now)
        else:
            name = nickname(position)
            broadcast("[" + name + "] " + text + "\n", now)

    def rename(position: int, name: string) -> string:
        client = clients.borrow_at(position)
        previous = copy client.name
        client.name = name
        return previous

    def nickname(position: int) -> string:
        client = clients.view_at(position)
        return copy client.name

    def register(events: borrow network.PollSet):
        position = 0
        while position < clients.len():
            client = clients.view_at(position)
            events.watch(position + 1, client.connection.handle,
                         not client.closing and not client.closed,
                         not client.closed and len(client.output) > client.sent)
            position += 1

    def read(position: int, now: int) -> list[string]:
        client = clients.borrow_at(position)
        return client.receive(now)

    def active(position: int) -> bool:
        client = clients.view_at(position)
        return not client.closed and not client.closing

    def write(position: int, now: int):
        client = clients.borrow_at(position)
        client.finish_input(now)
        client.flush(now)
        client.expire(now)

    def sweep(now: int):
        position = clients.len()
        while position > 0:
            position -= 1
            if is_closed(position):
                name = nickname(position)
                removed = clients.remove(position)
                drop(removed)
                broadcast("* " + name + " left\n", now)

    def is_closed(position: int) -> bool:
        client = clients.view_at(position)
        return client.closed

    def close():
        position = 0
        while position < clients.len():
            client = clients.borrow_at(position)
            client.disconnect()
            position += 1

# lifetime_seconds=0 serves until the process is interrupted. A finite lifetime
# is useful for demonstrations and deterministic integration tests.
def serve(listener: move network.Listener, lifetime_seconds: int = 0) -> int:
    room = Room()
    defer room.close()
    events = network.PollSet(65)
    started = io.monotonic_nanoseconds()
    while true:
        now = io.monotonic_nanoseconds()
        if lifetime_seconds > 0 and now - started >= lifetime_seconds * 1000000000:
            return 0
        events.clear()
        events.watch(0, listener.handle)
        room.register(events)
        ready = events.wait(100)
        if ready < 0 and ready != -4:
            io.write_string(io.stderr(), "poll failed: " + string(ready) + "\n")
            return 1
        if ready == -4:
            continue
        now = io.monotonic_nanoseconds()
        position = 0
        count = room.clients.len()
        while position < count:
            if events.readable(position + 1):
                lines = room.read(position, now)
                for line in lines:
                    if room.active(position):
                        room.message(position, line, now)
            # Nonblocking one-attempt flush is safe even before POLLOUT fires;
            # it also delivers newly queued replies within the same iteration.
            room.write(position, now)
            position += 1
        room.sweep(now)
        if events.readable(0):
            accepted = 0
            while accepted < 16:
                try:
                    connection = listener.accept()
                    room.add(connection, now)
                    accepted += 1
                catch error: NetworkError:
                    if error.code != -11 and error.code != -4:
                        io.write_string(io.stderr(), "accept failed: " + string(error.code) + "\n")
                        return 1
                    break
def decimal(value: string, maximum: int) -> int:
    if len(value) == 0:
        return -1
    result = 0
    for character in value:
        digit = int(character) - 48
        if digit < 0 or digit > 9:
            return -1
        if result > (maximum - digit) / 10:
            return -1
        result = result * 10 + digit
        if result > maximum:
            return -1
    return result

def usage():
    io.write_string(io.stdout(), "usage: chat [PORT=7777] [HOST=127.0.0.1] [SECONDS=0]\n")
    io.write_string(io.stdout(), "connect: nc 127.0.0.1 7777\n/nick alice; /who; /help; /quit\n")

def main() -> int:
    arguments = process.arguments()
    if arguments.len() == 2 and (arguments[1] == "--help" or arguments[1] == "-h"):
        usage()
        return 0
    specification = cli.command("chat", "TCP chat lab", [
        cli.argument("port", required=false),
        cli.argument("host", required=false),
        cli.argument("seconds", required=false),
    ])
    try:
        parsed = cli.parse_process(specification)
        return start_chat(parsed)
    catch error: CliError:
        io.write_string(io.stderr(), cli.render_error(error) + "\n")
        usage()
        return 2
    catch error: NetworkError:
        io.write_string(io.stderr(), error.operation + " failed: " + string(error.code) + "\n")
        return 1

def start_chat(parsed: cli.Matches) -> int | NetworkError:
    port = 7777
    host = "127.0.0.1"
    seconds = 0
    ports = cli.values(parsed, "port")
    if ports.len() > 0:
        port = decimal(ports[0], 65535)
    hosts = cli.values(parsed, "host")
    if hosts.len() > 0:
        host = hosts[0]
    lifetimes = cli.values(parsed, "seconds")
    if lifetimes.len() > 0:
        seconds = decimal(lifetimes[0], 86400)
    if port < 0 or seconds < 0:
        io.write_string(io.stderr(), "port must be 0..65535; seconds must be 0..86400\n")
        return 2
    listener = network.listen(host, port)
    address = listener.address()
    io.write_string(io.stdout(), "chat listening on " + address.display() + "\n")
    io.write_string(io.stdout(), "connect: nc " + address.host + " " + string(address.port) + "\n")
    return serve(listener, seconds)

# Tests follow the implementation. No shared files, fixed ports, or public DNS.
test "nicknames and CLI numbers are bounded":
    assert(valid_name("alice-42") and valid_name("A_b"))
    assert(not valid_name("") and not valid_name("two words"))
    assert(not valid_name("1234567890123456789012345"))
    assert(decimal("65535", 65535) == 65535)
    assert(decimal("65536", 65535) == -1)
    assert(decimal("99999999999999999999999999999", 65535) == -1)
    assert(decimal("-1", 65535) == -1 and decimal("", 65535) == -1)

test "messages allow UTF-8 and reject terminal controls":
    assert(valid_message("hello λ 世界"))
    assert(not valid_message("hello\0world"))
    assert(not valid_message("hello\rworld"))
    bytes = tuple[u8,2](192, 128)
    assert(not valid_message(string(bytes)))
    surrogate = tuple[u8,3](237, 160, 128)
    assert(not valid_message(string(surrogate)))

test "queued output has a hard per-client limit":
    connection = network.Connection(-1)
    client = Client(connection, "alice", 0)
    block = tensor[u8](65536)
    client.queue(string(block), 0)
    assert(not client.closed and len(client.output) == 65536)
    client.queue("x", 0)
    assert(client.closed)

test "graceful close and idle/output deadlines are distinct":
    connection = network.Connection(-1)
    client = Client(connection, "alice", 0)
    client.queue("bye\n", 0)
    client.finish(0)
    client.expire(1999999999)
    assert(not client.closed)
    client.expire(2000000000)
    assert(client.closed)
    idle_socket = network.Connection(-1)
    idle = Client(idle_socket, "idle", 0)
    idle.expire(299999999999)
    assert(not idle.closing)
    idle.expire(300000000000)
    assert(idle.closing and idle.output.contains("idle timeout"))
    stalled_socket = network.Connection(-1)
    stalled = Client(stalled_socket, "stalled", 0)
    stalled.queue("pending", 0)
    stalled.expire(9999999999)
    assert(not stalled.closed)
    stalled.expire(10000000000)
    assert(stalled.closed)

# Small bounded client helpers for the adjacent integration tests.
def write_request(connection: borrow network.Connection, text: string):
    bytes = text.utf()
    position = 0
    ready = network.PollSet(1)
    ready.watch(0, connection.handle, false, true)
    deadline = io.monotonic_nanoseconds() + 2000000000
    while position < len(bytes):
        if io.monotonic_nanoseconds() >= deadline:
            throw Error("test client send deadline exceeded")
        written = connection.send(bytes, position, len(bytes) - position)
        if written == -11 or written == -4:
            ready.wait(10)
        else:
            if written <= 0:
                throw Error("test client send failed")
            position += written

def await_text(connection: borrow network.Connection, expected: string) -> string:
    output = ""
    ready = network.PollSet(1)
    ready.watch(0, connection.handle)
    deadline = io.monotonic_nanoseconds() + 2000000000
    buffer = tensor[u8](4096)
    while not output.contains(expected):
        if io.monotonic_nanoseconds() >= deadline:
            throw Error("test client receive deadline exceeded")
        received = connection.receive(buffer, 0, 4096)
        if received == -11 or received == -4:
            ready.wait(10)
        else:
            if received <= 0:
                throw Error("test client disconnected before expected message")
            output = output + string(buffer[:received))
            if len(output) > 65536:
                throw Error("test client output limit exceeded")
    return output

test with integ "two clients rename broadcast list and leave":
    listener = network.listen("127.0.0.1", 0)
    address = listener.address()
    server = async serve(listener, 3) with local
    alice = network.connect(address.host, address.port)
    assert(await_text(alice, "joined\n").contains("welcome guest-1"))
    bob = network.connect(address.host, address.port)
    assert(await_text(bob, "joined\n").contains("welcome guest-2"))
    await_text(alice, "guest-2 joined\n")
    write_request(alice, "/nick alice\r\n")
    await_text(alice, "is now alice\n")
    await_text(bob, "is now alice\n")
    # Two writes, one line. A TCP packet boundary never becomes a chat frame.
    write_request(alice, "hel")
    write_request(alice, "lo λ\n")
    await_text(alice, "[alice] hello λ\n")
    await_text(bob, "[alice] hello λ\n")
    write_request(bob, "/nick alice\n")
    await_text(bob, "name already in use\n")
    write_request(bob, "/who\n")
    assert(await_text(bob, "users:").contains("alice guest-2"))
    write_request(alice, "/quit\n")
    await_text(alice, "bye\n")
    await_text(bob, "alice left\n")
    bob.close()
    alice.close()
    assert(await server == 0)

test with integ "line framing handles fragments coalescing and oversized input":
    listener = network.listen("127.0.0.1", 0)
    address = listener.address()
    writer = network.connect(address.host, address.port)
    socket = listener.accept()
    client = Client(socket, "fixture", 0)
    ready = network.PollSet(1)
    ready.watch(0, client.connection.handle)
    write_request(writer, "hel")
    assert(ready.wait(1000) > 0)
    assert(client.receive(0).len() == 0)
    write_request(writer, "lo\r\none\ntwo\n")
    # A complete local send is allowed to arrive in multiple receives.
    lines = list[string]()
    while lines.len() < 3:
        assert(ready.wait(1000) > 0)
        next = client.receive(0)
        for line in next:
            lines.append(line)
    assert(lines[0] == "hello" and lines[1] == "one" and lines[2] == "two")
    oversized = tensor[u8](1025)
    position = 0
    while position < 1025:
        oversized[position] = u8(97)
        position += 1
    write_request(writer, string(oversized))
    while not client.closing:
        assert(ready.wait(1000) > 0)
        client.receive(0)
        client.finish_input(0)
    assert(client.output.contains("line exceeds 1024 bytes"))

test with integ "valid frames precede a malformed coalesced frame":
    listener = network.listen("127.0.0.1", 0)
    address = listener.address()
    server = async serve(listener, 2) with local
    client = network.connect(address.host, address.port)
    await_text(client, "joined\n")
    write_request(client, "before\ninvalid\0frame\n")
    response = await_text(client, "control character\n")
    assert(response.contains("[guest-1] before\n"))
    assert(not response.contains("[guest-1] invalid"))
    client.close()
    assert(await server == 0)
