import file

class Count:
    value: int

# Importing this package contributes the handler; callers need no registry.
class CountFile: file.File
    def read(path: string) -> Count with path.suffix(".count"):
        text = file.read.default(path)
        value = 0
        index = 0
        while index < len(text):
            digit = int(text[index]) - 48
            if digit < 0 or digit > 9:
                throw Error("count file contains a non-decimal digit")
            if value > (9223372036854775807 - digit) / 10:
                throw Error("count file exceeds int range")
            value = value * 10 + digit
            index += 1
        return Count(value)
