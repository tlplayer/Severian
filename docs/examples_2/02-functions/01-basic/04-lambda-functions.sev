def add(a: int, b: int) -> int:
    return a + b

def apply(op: (int,int) -> int, left: int, right: int) -> int:
    return op(left, right)

test:
    assert(apply(add, 20, 22) == 42)
    offset := 3
    operation = lambda value, unused: value + offset + unused
    offset = 10
    assert(apply(operation, 4, 0) == 7)

def main():
    result = apply(add, 20, 22)
    print(result)
