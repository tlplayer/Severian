import file
import process


def clean(path: string) -> string:
    return file.raw(path)


def run_case(name: string, severian_command: string, reference_command: string, severian_output: string, reference_output: string) -> bool:
    # Cases are deliberately sequential and bounded. The virtual-memory limit
    # protects the workstation; timeout prevents a bad compiler path hanging
    # the suite. Reference programs are behavior oracles, not validators.
    if not (process.run("ulimit -v 524288; timeout 30s taskset -c 0 " + severian_command + " > " + severian_output) == 0):
        print("symmetry: Severian case failed: " + name)
        return false
    if not (process.run("ulimit -v 524288; timeout 30s taskset -c 0 " + reference_command + " > " + reference_output) == 0):
        print("symmetry: reference case failed: " + name)
        return false
    if not (clean(severian_output) == clean(reference_output)):
        print("symmetry: output mismatch: " + name)
        return false
    print("symmetry: passed " + name)
    return true


def check_symmetry() -> int:
    failures := 0
    if not run_case(
        "scalar operators against Python",
        "../target/debug/sev run api/symmetry/operators.sev",
        "python3 api/symmetry/operators.py",
        "/tmp/severian-api-operators.out",
        "/tmp/severian-api-operators-python.out",
    ):
        failures += 1

    if not (process.run("ulimit -v 524288; timeout 30s taskset -c 0 rustc api/symmetry/generics.rs -o /tmp/severian-api-generics-rust") == 0):
        print("symmetry: could not compile Rust generic reference")
        failures += 1
    else not run_case(
        "ordinary generics against Rust",
        "../target/debug/sev run api/symmetry/generics.sev",
        "/tmp/severian-api-generics-rust",
        "/tmp/severian-api-generics.out",
        "/tmp/severian-api-generics-rust.out",
    ):
        failures += 1

    if not (failures == 0):
        print("symmetry: " + string(failures) + " cases failed")
        return 1
    return 0


def main():
    assert(check_symmetry() == 0)


test "Severian agrees with independent scalar references":
    assert(check_symmetry() == 0)
