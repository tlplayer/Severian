def main():
    value = 2 + 3 * 4
    print(value)
    if 7 % 4 == 3:
        remainder_ok: i64 = 1
        print(remainder_ok)
    else:
        remainder_failed: i64 = 0
        print(remainder_failed)
    flag_left: u64 = 12
    flag_right: u64 = 3
    flag_mask: u64 = 10
    flag_toggle: u64 = 5
    flags: u64 = (flag_left | flag_right) & (flag_mask ^ flag_toggle)
    print(flags)
