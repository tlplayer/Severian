import graphics

def drawing() -> Result[graphics.Canvas, graphics.GraphicsError]:
    target = graphics.canvas(640, 360, graphics.white())
    target.rectangle(40, 40, 180, 80, graphics.blue())
    target.rectangle_outline(280, 40, 180, 80, graphics.gray(), 2)
    target.circle(160, 230, 55, graphics.red())
    target.circle_outline(400, 230, 55, graphics.green(), 3)
    target.line_width(40, 320, 600, 320, graphics.black(), 2)
    target.text_styled(320, 30, "Severian graphics", graphics.black(), 20, "middle")
    return target

test "graphics example produces a complete SVG document":
    target = drawing()
    document = target.svg()
    assert(document.contains("<rect"))
    assert(document.contains("<circle"))
    assert(document.contains("Severian graphics"))

def save_drawing(target: graphics.Canvas, path: string):
    match target.save(path):
        ok _:
            print("graphics", target.width(), target.height())
            print(path)
        failure error:
            assert(false, error)

def main():
    path = "/tmp/severian-graphics-example.svg"
    match drawing():
        ok target:
            save_drawing(target, path)
        failure error:
            assert(false, error)
