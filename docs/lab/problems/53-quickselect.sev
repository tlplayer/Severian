# Track: Hard validation
# Problem: 215 - Kth Largest Element in an Array (Quickselect variant)
# Difficulty: medium
# Tags: quickselect, divide-and-conquer, sorting, array

def partition(values: list[int], left: int, right: int) -> int:
    pivot = values[right]
    store := left
    for index in range(left, right):
        if values[index] <= pivot:
            temporary = values[store]
            values[store] = values[index]
            values[index] = temporary
            store += 1
    temporary = values[store]
    values[store] = values[right]
    values[right] = temporary
    return store

def kth_largest_quickselect(values: list[int], k: int) -> int:
    target = size(values) - k
    left := 0
    right := size(values) - 1
    while left <= right:
        pivot = partition(values, left, right)
        if pivot == target:
            return values[pivot]
        if pivot < target:
            left = pivot + 1
        else:
            right = pivot - 1
    return values[target]

test "second largest":
    assert(kth_largest_quickselect([3, 2, 1, 5, 6, 4], 2) == 5)

test "duplicates":
    assert(kth_largest_quickselect([3, 2, 3, 1, 2, 4, 5, 5, 6], 4) == 4)

test "smallest requested":
    assert(kth_largest_quickselect([2, 1], 2) == 1)
