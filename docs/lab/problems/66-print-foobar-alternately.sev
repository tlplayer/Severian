# Track: Concurrency validation
# Problem: 1115 - Print FooBar Alternately
# Difficulty: medium
# Tags: concurrency, channel, synchronization

def emit_foo(count: int, foo_gate: Channel[int], bar_gate: Channel[int], output: Channel[string]):
    for _ in range(count):
        await foo_gate
        emitted = async send "foo" with output
        await emitted
        opened = async send 1 with bar_gate
        await opened

def emit_bar(count: int, bar_gate: Channel[int], foo_gate: Channel[int], output: Channel[string]):
    for _ in range(count):
        await bar_gate
        emitted = async send "bar" with output
        await emitted
        opened = async send 1 with foo_gate
        await opened

def foo_bar(count: int) -> list[string]:
    foo_gate = Channel[int] with Buffer(1)
    bar_gate = Channel[int] with Buffer(1)
    output = Channel[string] with Buffer(2)
    seed = async send 1 with foo_gate
    foo_task = async emit_foo(count, foo_gate, bar_gate, output) with self
    bar_task = async emit_bar(count, bar_gate, foo_gate, output) with self
    result := []
    for _ in range(count * 2):
        result.append(await output)
    await seed, foo_task, bar_task
    return result

test "three alternations":
    assert(foo_bar(3) == ["foo", "bar", "foo", "bar", "foo", "bar"])

test "single alternation":
    assert(foo_bar(1) == ["foo", "bar"])
