# Track: LeetCode 75
# Problem: 790 - Domino and Tromino Tiling
# Difficulty: medium
# Tags: dynamic-programming, math

def num_tilings(n: int) -> int:
    if n == 1:
        return 1
    if n == 2:
        return 2

    three_back := 1
    two_back := 1
    one_back := 2

    while width <= n with width := 3:
        current = (2 * one_back + three_back) % 1000000007
        three_back = two_back
        two_back = one_back
        one_back = current
        width += 1

    return one_back

test "one column":
    assert(num_tilings(1) == 1)

test "three columns":
    assert(num_tilings(3) == 5)

test "five columns":
    assert(num_tilings(5) == 24)

test "larger board":
    assert(num_tilings(30) == 312342182)
