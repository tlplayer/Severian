# Track: Concurrency validation
# Problem: 1279 - Traffic Light Controlled Intersection
# Difficulty: easy
# Tags: concurrency, lock, simulation

class Intersection:
    active_road: int
    crossings: int

    def cross(road: int, car: int) -> int:
        if active_road != road:
            active_road = road
        crossings += 1
        return road * 100 + car

def cross_traffic() -> list[int]:
    intersection := Intersection(1, 0)
    first = async intersection.cross(1, 1) with self and lock
    second = async intersection.cross(2, 2) with self and lock
    third = async intersection.cross(1, 3) with self and lock
    fourth = async intersection.cross(2, 4) with self and lock
    first_result = await first
    second_result = await second
    third_result = await third
    fourth_result = await fourth
    result = [first_result, second_result, third_result, fourth_result]
    assert(intersection.crossings == 4)
    return result

test "cars cross on both roads":
    assert(cross_traffic() == [101, 202, 103, 204])

test "intersection remains reusable":
    assert(cross_traffic().sum() == 610)
