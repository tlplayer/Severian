# Track: Concurrency validation
# Problem: 1188 - Design Bounded Blocking Queue
# Difficulty: medium
# Tags: concurrency, bounded-queue, channel

def bounded_queue(values: list[int], capacity: int) -> list[int]:
    queue = Channel[int] with Buffer(capacity)
    first = async send values[0] with queue
    await first
    second = async send values[1] with queue
    result := []
    if capacity == 1:
        result.append(await queue)
        await second
        third = async send values[2] with queue
        result.append(await queue)
        result.append(await queue)
        await third
    else:
        await second
        third = async send values[2] with queue
        result.append(await queue)
        result.append(await queue)
        result.append(await queue)
        await third
    return result

test "producer blocks at capacity":
    assert(bounded_queue([4, 7, 9], 2) == [4, 7, 9])

test "single slot remains FIFO":
    assert(bounded_queue([1, 2, 3], 1) == [1, 2, 3])
