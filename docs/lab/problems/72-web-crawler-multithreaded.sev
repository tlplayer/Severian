# Track: Concurrency validation
# Problem: 1242 - Web Crawler Multithreaded
# Difficulty: medium
# Tags: concurrency, graph, depth-first-search

def crawl_page(host: string, links: list[string]) -> list[string]:
    return links.filter(|url| url.starts_with(host))

def crawl(host: string, first_links: list[string], second_links: list[string], third_links: list[string]) -> set[string]:
    first = async crawl_page(host, first_links) with self
    second = async crawl_page(host, second_links) with self
    third = async crawl_page(host, third_links) with self
    first_result = await first
    second_result = await second
    third_result = await third
    return first_result.to_set().union(second_result.to_set()).union(third_result.to_set())

test "same-host pages are deduplicated":
    pages = crawl("https://sev.dev", ["https://sev.dev/a", "https://other.dev/x"], ["https://sev.dev/b", "https://sev.dev/a"], ["https://sev.dev/c"])
    assert(pages == {"https://sev.dev/a", "https://sev.dev/b", "https://sev.dev/c"})

test "external links are rejected":
    pages = crawl("https://sev.dev", ["https://other.dev/a"], ["https://else.dev/b"], [])
    assert(size(pages) == 0)
