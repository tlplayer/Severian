# Track: LeetCode 75
# Problem: 2352 - Equal Row and Column Pairs
# Difficulty: medium
# Tags: matrix, array, hash-table

def row_equals_column(grid: list[list[int]], row: int, column: int) -> bool:
    for index in indices(grid):
        if grid[row][index] != grid[index][column]:
            return false
    return true

def equal_pairs(grid: list[list[int]]) -> int:
    pairs := 0
    for row in indices(grid):
        for column in indices(grid):
            if row_equals_column(grid, row, column):
                pairs += 1
    return pairs

test "one matching pair":
    assert(equal_pairs([[3, 2, 1], [1, 7, 6], [2, 7, 7]]) == 1)

test "several matching pairs":
    assert(equal_pairs([[3, 1, 2, 2], [1, 4, 4, 5], [2, 4, 2, 2], [2, 4, 2, 2]]) == 3)

test "single cell":
    assert(equal_pairs([[5]]) == 1)
