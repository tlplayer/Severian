# Shard-group behavior: configuration ownership, wrong-group rejection, and
# explicit transfer of a shard's data during reconfiguration.

class ShardReply:
    success: bool
    value: string
    error: string

    def ShardReply(success_value: bool, value_value: string, error_value: string):
        success = success_value
        value = value_value
        error = error_value

class ShardData:
    shard: int
    keys: list[string]
    values: list[string]

    def ShardData(shard_value: int, key_values: list[string], item_values: list[string]):
        shard = shard_value
        keys = key_values
        values = item_values

class ShardGroup:
    group_identifier: int
    configuration_number: int
    owned_shards: list[int]
    key_shards: list[int]
    keys: list[string]
    values: list[string]

    def ShardGroup(identifier: int):
        group_identifier = identifier
        configuration_number = 0
        owned_shards = []
        key_shards = []
        keys = []
        values = []

    def configure(number: int, shards: list[int]):
        if number > configuration_number:
            configuration_number = number
            owned_shards = shards

    def put(shard: int, key: string, value: string) -> ShardReply:
        if shard not in owned_shards:
            return ShardReply(false, "", "ErrWrongGroup")
        for index in range(size(keys)):
            if keys[index] == key:
                values[index] = value
                key_shards[index] = shard
                return ShardReply(true, value, "OK")
        key_shards.append(shard)
        keys.append(key)
        values.append(value)
        return ShardReply(true, value, "OK")

    def get(shard: int, key: string) -> ShardReply:
        if shard not in owned_shards:
            return ShardReply(false, "", "ErrWrongGroup")
        for index in range(size(keys)):
            if keys[index] == key and key_shards[index] == shard:
                return ShardReply(true, values[index], "OK")
        return ShardReply(false, "", "ErrNoKey")

    def export_shard(shard: int) -> ShardData:
        exported_keys := []
        exported_values := []
        for index in range(size(keys)):
            if key_shards[index] == shard:
                exported_keys.append(keys[index])
                exported_values.append(values[index])
        return ShardData(shard, exported_keys, exported_values)

    def import_shard(data: ShardData, number: int):
        if number < configuration_number:
            return
        configuration_number = number
        if data.shard not in owned_shards:
            owned_shards.append(data.shard)
        for index in range(size(data.keys)):
            found := false
            for local_index in range(size(keys)):
                if keys[local_index] == data.keys[index]:
                    values[local_index] = data.values[index]
                    key_shards[local_index] = data.shard
                    found = true
            if not found:
                keys.append(data.keys[index])
                values.append(data.values[index])
                key_shards.append(data.shard)

    def discard_shard(shard: int):
        if shard in owned_shards:
            owned_shards.remove(shard)
        index := size(keys) - 1
        while index >= 0:
            if key_shards[index] == shard:
                key_shards.pop(index)
                keys.pop(index)
                values.pop(index)
            index -= 1

test "wrong group is rejected":
    group := ShardGroup(1)
    group.configure(1, [0, 1])
    assert(group.put(0, "alpha", "one").success)
    assert(group.get(2, "alpha").error == "ErrWrongGroup")

test "configuration migration preserves data":
    source := ShardGroup(1)
    destination := ShardGroup(2)
    source.configure(1, [3])
    destination.configure(1, [])
    source.put(3, "key", "value")
    transfer = source.export_shard(3)
    destination.import_shard(transfer, 2)
    source.discard_shard(3)
    assert(source.get(3, "key").error == "ErrWrongGroup")
    assert(destination.get(3, "key").value == "value")
    assert(destination.configuration_number == 2)

test "stale migration cannot roll configuration backward":
    group := ShardGroup(5)
    group.configure(4, [1])
    group.import_shard(ShardData(2, ["old"], ["value"]), 3)
    assert(group.configuration_number == 4)
    assert(group.get(2, "old").error == "ErrWrongGroup")

def main():
    source := ShardGroup(1)
    destination := ShardGroup(2)
    source.configure(1, [4])
    source.put(4, "answer", "42")
    destination.import_shard(source.export_shard(4), 2)
    print("sharded-key-value", destination.get(4, "answer").value)
