# A compact Raft implementation for exercising the language. The state
# transitions follow the raftapi/raft1 contract without wall-clock randomness.

class LogEntry:
    term: int
    command: string

    def LogEntry(term_value: int, command_value: string):
        term = term_value
        command = command_value

class VoteReply:
    term: int
    granted: bool

    def VoteReply(term_value: int, granted_value: bool):
        term = term_value
        granted = granted_value

class AppendReply:
    term: int
    success: bool
    match_index: int

    def AppendReply(term_value: int, success_value: bool, match_index_value: int):
        term = term_value
        success = success_value
        match_index = match_index_value

class RaftNode:
    identifier: int
    term: int
    role: string
    voted_for: int
    log: list[LogEntry]
    commit_index: int
    applied_index: int
    snapshot_index: int
    snapshot_value: string
    running: bool

    def RaftNode(identifier_value: int):
        identifier = identifier_value
        term = 0
        role = "follower"
        voted_for = -1
        log = [LogEntry(0, "genesis")]
        commit_index = 0
        applied_index = 0
        snapshot_index = 0
        snapshot_value = ""
        running = true

    def start_election():
        term += 1
        role = "candidate"
        voted_for = identifier

    def set_term(value: int):
        term = value

    def become_leader():
        role = "leader"

    def request_vote(candidate_term: int, candidate_identifier: int, last_index: int, last_term: int) -> VoteReply:
        if not running:
            return VoteReply(term, false)
        if candidate_term < term:
            return VoteReply(term, false)
        if candidate_term > term:
            term = candidate_term
            role = "follower"
            voted_for = -1
        local_last_index = snapshot_index + size(log) - 1
        local_last_term = log[-1].term
        up_to_date = last_term > local_last_term or (last_term == local_last_term and last_index >= local_last_index)
        if up_to_date and (voted_for < 0 or voted_for == candidate_identifier):
            voted_for = candidate_identifier
            return VoteReply(term, true)
        return VoteReply(term, false)

    def append_entries(leader_term: int, previous_index: int, previous_term: int, entries: list[LogEntry], leader_commit: int) -> AppendReply:
        if not running or leader_term < term:
            return AppendReply(term, false, snapshot_index + size(log) - 1)
        term = leader_term
        role = "follower"
        if previous_index < snapshot_index:
            return AppendReply(term, false, snapshot_index)
        local_index = previous_index - snapshot_index
        if local_index >= size(log) or log[local_index].term != previous_term:
            return AppendReply(term, false, snapshot_index + size(log) - 1)
        insertion := local_index + 1
        for entry in entries:
            if insertion < size(log):
                if log[insertion].term != entry.term or log[insertion].command != entry.command:
                    while size(log) > insertion:
                        log.pop()
                    log.append(entry)
            else:
                log.append(entry)
            insertion += 1
        last_index = snapshot_index + size(log) - 1
        if leader_commit > commit_index:
            commit_index = min(leader_commit, last_index)
        return AppendReply(term, true, last_index)

    def append_command(command: string):
        log.append(LogEntry(term, command))

    def commit_through(index: int):
        last_index = snapshot_index + size(log) - 1
        commit_index = min(index, last_index)
        applied_index = commit_index

    def compact(index: int, value: string):
        if index > snapshot_index and index <= commit_index:
            offset = index - snapshot_index
            retained := [LogEntry(log[offset].term, "snapshot")]
            for position in range(offset + 1, size(log)):
                retained.append(log[position])
            log = retained
            snapshot_index = index
            snapshot_value = value

    def crash():
        running = false
        role = "follower"

    def restart():
        running = true
        role = "follower"

class RaftCluster:
    nodes: list[RaftNode]
    connected: list[bool]
    leader_identifier: int

    def RaftCluster(count: int):
        nodes = []
        connected = []
        for identifier in range(count):
            nodes.append(RaftNode(identifier))
            connected.append(true)
        leader_identifier = -1

    def set_connected(identifier: int, enabled: bool):
        connected[identifier] = enabled

    def elect(candidate_identifier: int) -> bool:
        if not connected[candidate_identifier] or not nodes[candidate_identifier].running:
            return false
        nodes[candidate_identifier].start_election()
        candidate_term = nodes[candidate_identifier].term
        last_index = nodes[candidate_identifier].snapshot_index + size(nodes[candidate_identifier].log) - 1
        last_term = nodes[candidate_identifier].log[-1].term
        votes := 1
        for identifier in range(size(nodes)):
            if identifier != candidate_identifier and connected[identifier] and nodes[identifier].running:
                reply = nodes[identifier].request_vote(candidate_term, candidate_identifier, last_index, last_term)
                if reply.granted:
                    votes += 1
        if votes > size(nodes) / 2:
            nodes[candidate_identifier].become_leader()
            leader_identifier = candidate_identifier
            return true
        return false

    def submit(command: string) -> bool:
        if leader_identifier < 0 or not connected[leader_identifier] or not nodes[leader_identifier].running:
            return false
        leader = nodes[leader_identifier]
        leader.append_command(command)
        entry_index = leader.snapshot_index + size(leader.log) - 1
        previous_index = entry_index - 1
        previous_term = leader.log[-2].term
        acknowledgements := 1
        for identifier in range(size(nodes)):
            if identifier != leader_identifier and connected[identifier] and nodes[identifier].running:
                reply = nodes[identifier].append_entries(leader.term, previous_index, previous_term, [LogEntry(leader.term, command)], leader.commit_index)
                if reply.success:
                    acknowledgements += 1
        if acknowledgements > size(nodes) / 2:
            leader.commit_through(entry_index)
            for identifier in range(size(nodes)):
                if identifier != leader_identifier and connected[identifier] and nodes[identifier].running:
                    nodes[identifier].append_entries(leader.term, entry_index, leader.term, [], entry_index)
            return true
        return false

test "majority election and committed replication":
    cluster := RaftCluster(3)
    assert(cluster.elect(0))
    assert(cluster.nodes[0].role == "leader")
    assert(cluster.submit("set x 1"))
    assert(cluster.nodes[0].commit_index == 1)
    assert(cluster.nodes[1].commit_index == 1)
    assert(cluster.nodes[2].log[-1].command == "set x 1")

test "partition prevents minority commit":
    cluster := RaftCluster(3)
    assert(cluster.elect(0))
    cluster.set_connected(1, false)
    cluster.set_connected(2, false)
    assert(not cluster.submit("minority"))
    assert(cluster.nodes[0].commit_index == 0)

test "log freshness voting and conflict repair":
    node := RaftNode(1)
    node.set_term(3)
    node.append_command("old")
    assert(not node.request_vote(3, 2, 0, 0).granted)
    assert(node.request_vote(4, 2, 1, 3).granted)
    assert(node.append_entries(4, 0, 0, [LogEntry(4, "new")], 1).success)
    assert(node.log[-1].command == "new")

test "snapshot survives crash and restart":
    node := RaftNode(0)
    node.set_term(2)
    node.append_command("a")
    node.append_command("b")
    node.commit_through(2)
    node.compact(1, "x=1")
    node.crash()
    node.restart()
    assert(node.snapshot_index == 1)
    assert(node.snapshot_value == "x=1")
    assert(node.log[-1].command == "b")

def main():
    cluster := RaftCluster(3)
    elected = cluster.elect(0)
    committed = cluster.submit("set answer 42")
    print("raft", elected, committed, cluster.nodes[0].term, cluster.nodes[0].commit_index)
