import database

def run_client(connection: DatabaseConnection):
    database.must_remote_execute(connection, "CREATE TABLE people(id INTEGER PRIMARY KEY, name TEXT)")
    database.must_remote_execute(connection, "INSERT INTO people(id, name) VALUES (1, 'Ada'), (2, 'Grace')")
    result ?= database.remote_query(connection, "SELECT id, name FROM people ORDER BY id")
    database.must_disconnect(connection)
    switch result:
        ok rows:
            print(size(rows))
            for row in rows:
                print(row[0], row[1])
        failure error:
            print(error)

def run_client_and_stop(server: DatabaseServer, connection: DatabaseConnection):
    run_client(connection)
    database.must_stop(server)

def run_server(server: DatabaseServer):
    switch database.connect(database.address(server)):
        ok connection:
            run_client_and_stop(server, connection)
        failure error:
            print(error)
            database.must_stop(server)

def main():
    switch database.start(":memory:"):
        ok server:
            run_server(server)
        failure error:
            print(error)
