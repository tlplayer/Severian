def consume(items: list[i64]) -> i64 with
{
    defer items.size() <= 10,
}:
    total := 0

    for item in items:
        total += item

    return total


def fill(buffer: list[i64]) with
{
    defer buffer.size() <= 4,
}:
    buffer.push(1)
    buffer.push(2)
    buffer.push(3)
    buffer.push(4)

test:
    items = [1, 2, 3, 4]

    result = consume(items)

    assert(result == 10)
    assert(items.size() <= 10)