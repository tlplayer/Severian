def process(message: string):
    print("message:", message)

def handle(command: string):
    print("command:", command)

def main():
    messages = channel[string](16) #buffer size 16
    commands = channel[string] #unbounded channnel

    message_producer = async messages.send("hello")
    command_producer = async commands.send("refresh")

    match {messages , commands} while received < 2 with received := 0:
        case command from commands:
            await handle(command) with runtime and lock
            received += 1

        case message from messages:
            process(message)
            received += 1

        case error:
            panic("Channels collapsed", error)

    await message_producer, command_producer
