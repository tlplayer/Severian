print("You can print in global scope before main starts.")


value := "one"
global_fun(value)
value = "two"
global_fun(value)


def global_func(value):
    print(f"Call functions in global or allocate values like python call:{value}")

def main():
    print("Or inside main")

test with integ:
    main()
    print("or in tests")
    assert("""
    You can print in global scope before main starts,
    or inside main
    or in tests
    """ in stdout)