print("You can print in module scope before main starts.")


value = "one"
module_func(value)
value = "two"
module_func(value)


def module_func(value: string):
    print(f"Call functions in module or allocate values like python call:{value}")

def main():
    print("Or inside main")

test with integ:
    main()
    print("or in tests")
    assert("You can print in module scope before main starts." in stdout)
    assert("Call functions in module or allocate values like python call:one" in stdout)
    assert("Call functions in module or allocate values like python call:two" in stdout)
    assert("Or inside main" in stdout)
    assert("or in tests" in stdout)
