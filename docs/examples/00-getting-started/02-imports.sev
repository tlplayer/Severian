import file

def main():
    distance = 9.0 ** .5
    print(distance)

    with file.open("test.txt", "w+") as f:
        f.write(distance)
        f.seek(0)
        file_distance = f.read()

    file.delete("test.txt")

    print(file_distance)

test with integration "imported output":
    main()
    assert("3" in stdout)