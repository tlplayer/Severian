import file

def main():
    distance = 9.0 ** .5
    path = "/tmp/severian-getting-started-imports.txt"
    switch file.write(path, string(distance)):
        ok:
            switch file.read(path):
                ok file_distance:
                    print(file_distance)
                failure error:
                    assert(false, error)
        failure error:
            assert(false, error)

test with integration "imported output":
    main()
    assert("3" in stdout)
