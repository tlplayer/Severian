import tensor
import model

def algebra():
    A = tensor.ranked([1.0, 0.0, 0.0, 1.0], [2, 2])
    B = tensor.ranked([1.0, 0.0, 0.0, 1.0], [2, 2])
    product = tensor.rankedMatmul(A, B)
    jacobian = model.jacobianList([1.0, 0.0])
    zero = tensor.ranked([0.0], [1, 1])
    print(tensor.rankedValues(product))
    print(jacobian)
    print(tensor.rankedValues(zero))

@model(Relu, FastTanh, Swish)
def forward(X: list[float]) -> list[float]:
    return Swish(FastTanh(Relu(X)))

def main():
    algebra()
    print(forward([0.0]))
