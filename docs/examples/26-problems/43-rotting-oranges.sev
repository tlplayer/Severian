# Track: LeetCode 75
# Problem: 994 - Rotting Oranges
# Difficulty: medium
# Tags: matrix, breadth-first-search, queue, graph

def oranges_rotting(grid: list[list[int]]) -> int:
    row_queue := []
    column_queue := []
    minute_queue := []
    fresh := 0
    for row in indices(grid):
        for column in indices(grid[0]):
            if grid[row][column] == 2:
                row_queue.append(row)
                column_queue.append(column)
                minute_queue.append(0)
            else:
                if grid[row][column] == 1:
                    fresh += 1

    row_steps = [-1, 1, 0, 0]
    column_steps = [0, 0, -1, 1]
    head := 0
    elapsed := 0
    while head < size(row_queue):
        row = row_queue[head]
        column = column_queue[head]
        minute = minute_queue[head]
        head += 1
        if minute > elapsed:
            elapsed = minute

        for direction in range(0, 4):
            next_row = row + row_steps[direction]
            next_column = column + column_steps[direction]
            if next_row >= 0 and next_row < size(grid):
                if next_column >= 0 and next_column < size(grid[0]):
                    if grid[next_row][next_column] == 1:
                        grid[next_row][next_column] = 2
                        fresh -= 1
                        row_queue.append(next_row)
                        column_queue.append(next_column)
                        minute_queue.append(minute + 1)

    if fresh > 0:
        return -1
    return elapsed

test "four minutes":
    assert(oranges_rotting([[2, 1, 1], [1, 1, 0], [0, 1, 1]]) == 4)

test "isolated fresh orange":
    assert(oranges_rotting([[2, 1, 1], [0, 1, 1], [1, 0, 1]]) == -1)

test "nothing fresh":
    assert(oranges_rotting([[0, 2]]) == 0)
