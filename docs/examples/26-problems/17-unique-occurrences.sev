# Track: LeetCode 75
# Problem: 1207 - Unique Number of Occurrences
# Difficulty: easy
# Tags: array, hash-table

def uniqueOccurrences(values: list[int]) -> bool:
    counts = values.frequencies()
    return size(counts.values().toSet()) == size(counts)

test "unique frequencies":
    assert(uniqueOccurrences([1, 2, 2, 1, 1, 3]))

test "duplicate frequencies":
    assert(not uniqueOccurrences([1, 2]))

test "negative values":
    assert(uniqueOccurrences([-3, 0, 1, -3, 1, 1, 1, -3, 10, 0]))
