# Track: LeetCode 75
# Problem: 1207 - Unique Number of Occurrences
# Difficulty: easy
# Tags: array, hash-table

def unique_occurrences(values: list[int]) -> bool:
    counts = values.frequencies()
    return size(counts.values().to_set()) == size(counts)

test "unique frequencies":
    assert(unique_occurrences([1, 2, 2, 1, 1, 3]))

test "duplicate frequencies":
    assert(not unique_occurrences([1, 2]))

test "negative values":
    assert(unique_occurrences([-3, 0, 1, -3, 1, 1, 1, -3, 10, 0]))
