# Track: Hard validation
# Problem: 239 - Sliding Window Maximum
# Difficulty: hard
# Tags: monotonic-queue, queue, sliding-window, array

def maxSlidingWindow(values: list[int], width: int) -> list[int]:
    deque := []
    head := 0
    tail := 0
    result := []
    for index in indices(values):
        while tail > head and values[deque[tail - 1]] <= values[index]:
            tail -= 1
        if tail < size(deque):
            deque[tail] = index
        else:
            deque.append(index)
        tail += 1
        if deque[head] <= index - width:
            head += 1
        if index + 1 >= width:
            result.append(values[deque[head]])
    return result

test "standard windows":
    assert(maxSlidingWindow([1, 3, -1, -3, 5, 3, 6, 7], 3) == [3, 3, 5, 5, 6, 7])

test "single element windows":
    assert(maxSlidingWindow([4, 2], 1) == [4, 2])

test "whole array window":
    assert(maxSlidingWindow([9, 7, 8], 3) == [9])
