# Track: Hard validation
# Problem: 28 - Find the Index of the First Occurrence in a String
# Difficulty: easy
# Tags: string-matching, rolling-hash, hash-function, string

def character_code(character: string) -> int:
    alphabet = "abcdefghijklmnopqrstuvwxyz"
    for index in range(0, size(alphabet)):
        if alphabet[index] == character:
            return index + 1
    return 0

def matches_at(haystack: string, needle: string, start: int) -> bool:
    for index in range(0, size(needle)):
        if haystack[start + index] != needle[index]:
            return false
    return true

def first_occurrence(haystack: string, needle: string) -> int:
    if size(needle) == 0:
        return 0
    if size(needle) > size(haystack):
        return -1
    base := 31
    modulus := 1000003
    power := 1
    needle_hash := 0
    window_hash := 0
    for index in range(0, size(needle)):
        needle_hash = (needle_hash * base + character_code(needle[index])) % modulus
        window_hash = (window_hash * base + character_code(haystack[index])) % modulus
        if index + 1 < size(needle):
            power = power * base % modulus
    for start in range(0, size(haystack) - size(needle) + 1):
        if window_hash == needle_hash and matches_at(haystack, needle, start):
            return start
        if start + size(needle) < size(haystack):
            outgoing = character_code(haystack[start]) * power % modulus
            window_hash = (window_hash - outgoing + modulus) % modulus
            window_hash = (window_hash * base + character_code(haystack[start + size(needle)])) % modulus
    return -1

test "found at start":
    assert(first_occurrence("sadbutsad", "sad") == 0)

test "not found":
    assert(first_occurrence("leetcode", "leeto") == -1)

test "empty needle":
    assert(first_occurrence("abc", "") == 0)
