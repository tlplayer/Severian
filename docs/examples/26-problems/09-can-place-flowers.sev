# Track: LeetCode 75
# Problem: 605 - Can Place Flowers
# Difficulty: easy
# Tags: array, greedy

def openPlot(flowerbed: list[int], index: int) -> bool:
    if flowerbed[index] != 0:
        return false
    if index > 0:
        if flowerbed[index - 1] == 1:
            return false
    if index + 1 < size(flowerbed):
        if flowerbed[index + 1] == 1:
            return false
    return true

def canPlaceFlowers(flowerbed: list[int], needed: int) -> bool:
    planted := 0
    for index in indices(flowerbed):
        if openPlot(flowerbed, index):
            flowerbed[index] = 1
            planted += 1
    return planted >= needed

test "one flower fits":
    assert(canPlaceFlowers([1, 0, 0, 0, 1], 1))

test "two flowers do not fit":
    assert(not canPlaceFlowers([1, 0, 0, 0, 1], 2))

test "empty request":
    assert(canPlaceFlowers([1], 0))

test "single open plot":
    assert(canPlaceFlowers([0], 1))
