# Track: LeetCode 75
# Problem: 72 - Edit Distance
# Difficulty: medium
# Tags: string, dynamic-programming

def minimum3(first: int, second: int, third: int) -> int:
    result := first
    if second < result:
        result = second
    if third < result:
        result = third
    return result

def min_distance(first: string, second: string) -> int:
    row := [0]
    while size(row) <= size(second):
        row.append(size(row))

    for first_index in range(0, size(first)):
        diagonal := row[0]
        row[0] = first_index + 1
        for second_index in range(0, size(second)):
            above = row[second_index + 1]
            if first[first_index] == second[second_index]:
                row[second_index + 1] = diagonal
            else:
                row[second_index + 1] = 1 + minimum3(diagonal, above, row[second_index])
            diagonal = above
    return row[size(second)]

test "horse to ros":
    assert(min_distance("horse", "ros") == 3)

test "intention to execution":
    assert(min_distance("intention", "execution") == 5)

test "empty source":
    assert(min_distance("", "abc") == 3)
