# Track: Hard validation
# Problem: 912 - Sort an Array
# Difficulty: medium
# Tags: merge-sort, divide-and-conquer, sorting, array

def mergeRuns(values: list[int], temporary: list[int], left: int, middle: int, right: int):
    first := left
    second := middle
    output := left
    while first < middle and second < right:
        if values[first] <= values[second]:
            temporary[output] = values[first]
            first += 1
        else:
            temporary[output] = values[second]
            second += 1
        output += 1
    while first < middle:
        temporary[output] = values[first]
        first += 1
        output += 1
    while second < right:
        temporary[output] = values[second]
        second += 1
        output += 1
    for index in range(left, right):
        values[index] = temporary[index]

def sortArray(values: list[int]) -> list[int]:
    temporary := []
    for value in values:
        temporary.append(0)
    width := 1
    while width < size(values):
        left := 0
        while left < size(values):
            middle := left + width
            right := left + width * 2
            if middle > size(values):
                middle = size(values)
            if right > size(values):
                right = size(values)
            mergeRuns(values, temporary, left, middle, right)
            left += width * 2
        width *= 2
    return values

test "mixed values":
    assert(sortArray([5, 2, 3, 1]) == [1, 2, 3, 5])

test "duplicates and negatives":
    assert(sortArray([5, 1, 1, 2, 0, 0, -1]) == [-1, 0, 0, 1, 1, 2, 5])

test "empty array":
    assert(sortArray([]) == [])
