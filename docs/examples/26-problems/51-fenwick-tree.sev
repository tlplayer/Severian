# Track: Hard validation
# Problem: 307 - Range Sum Query - Mutable (Fenwick variant)
# Difficulty: medium
# Tags: binary-indexed-tree, prefix-sum, data-stream, array

def lowBit(index: int) -> int:
    value := index
    factor := 1
    while value % 2 == 0:
        value = value / 2
        factor *= 2
    return factor

def add(tree: list[int], index: int, delta: int):
    node := index + 1
    while node < size(tree):
        tree[node] += delta
        node += lowBit(node)

def buildFenwick(values: list[int]) -> list[int]:
    tree := [0]
    for value in values:
        tree.append(0)
    for index in indices(values):
        add(tree, index, values[index])
    return tree

def prefix(tree: list[int], index: int) -> int:
    node := index + 1
    total := 0
    while node > 0:
        total += tree[node]
        node -= lowBit(node)
    return total

def fenwickRange(tree: list[int], left: int, right: int) -> int:
    if left == 0:
        return prefix(tree, right)
    return prefix(tree, right) - prefix(tree, left - 1)

test "prefix and range":
    tree := buildFenwick([1, 3, 5, 7])
    assert(prefix(tree, 2) == 9)
    assert(fenwickRange(tree, 1, 3) == 15)

test "streamed update":
    tree := buildFenwick([1, 3, 5])
    add(tree, 1, -1)
    assert(fenwickRange(tree, 0, 2) == 8)

test "single value":
    tree := buildFenwick([9])
    assert(prefix(tree, 0) == 9)
