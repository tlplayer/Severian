import parallel
import tensor

def rowSoftmax(value: Tensor[f64]) -> Tensor[f64]:
    with gpu:
        return tensor.rankedSoftmaxRows(value)

test "constant rows become uniform probabilities":
    value = tensor.ranked([0.0, 0.0, 0.0, 0.0], [2, 2])
    result = rowSoftmax(value)
    assert(tensor.rankedValues(result) == [0.5, 0.5, 0.5, 0.5])

test "large equal logits stay normalized":
    value = tensor.ranked([1000.0, 1000.0], [1, 2])
    result = rowSoftmax(value)
    assert(tensor.rankedValues(result) == [0.5, 0.5])
