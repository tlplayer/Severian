# Track: LeetCode 75
# Problem: 283 - Move Zeroes
# Difficulty: easy
# Tags: array, two-pointers, mutation

def moveZeroes(values: list[int]) -> list[int]:
    for value in values with write := 0:
        if value != 0:
            values[write] = value
            write += 1

    while write < size(values):
        values[write] = 0
        write += 1

    return values

test "mixed values":
    assert(moveZeroes([0, 1, 0, 3, 12]) == [1, 3, 12, 0, 0])

test "single zero":
    assert(moveZeroes([0]) == [0])

test "no zeroes":
    assert(moveZeroes([1, 2, 3]) == [1, 2, 3])
