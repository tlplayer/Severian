# Track: LeetCode 75
# Problem: 443 - String Compression
# Difficulty: medium
# Tags: array, string, two-pointers, mutation

def compress(characters: list[string]) -> int:
    write := 0
    read := 0

    while read < size(characters):
        character = characters[read]
        end := read
        while end < size(characters) and characters[end] == character:
            end += 1

        characters[write] = character
        write += 1
        count = end - read
        if count > 1:
            countText = string(count)
            for index in range(0, size(countText)):
                characters[write] = countText[index]
                write += 1
        read = end

    return write

test "mixed groups":
    characters := ["a", "a", "b", "b", "c", "c", "c"]
    assert(compress(characters) == 6)
    assert(characters[0] == "a" and characters[1] == "2")
    assert(characters[4] == "c" and characters[5] == "3")

test "single character":
    characters := ["a"]
    assert(compress(characters) == 1)
    assert(characters[0] == "a")

test "two digit count":
    characters := ["a", "a", "a", "a", "a", "a", "a", "a", "a", "a", "a", "a"]
    assert(compress(characters) == 3)
    assert(characters[1] == "1" and characters[2] == "2")
