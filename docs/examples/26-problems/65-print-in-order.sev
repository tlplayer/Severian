# Track: Concurrency validation
# Problem: 1114 - Print in Order
# Difficulty: easy
# Tags: concurrency, channel, ordering

def first(output: Channel[int], second_gate: Channel[int]):
    emitted = async send 1 with output
    await emitted
    opened = async send 1 with second_gate
    await opened

def second(second_gate: Channel[int], output: Channel[int], third_gate: Channel[int]):
    await second_gate
    emitted = async send 2 with output
    await emitted
    opened = async send 1 with third_gate
    await opened

def third(third_gate: Channel[int], output: Channel[int]):
    await third_gate
    emitted = async send 3 with output
    await emitted

def ordered() -> list[int]:
    output = Channel[int] with Buffer(3)
    second_gate = Channel[int] with Buffer(1)
    third_gate = Channel[int] with Buffer(1)
    third_task = async third(third_gate, output) with self
    second_task = async second(second_gate, output, third_gate) with self
    first_task = async first(output, second_gate) with self
    first_value = await output
    second_value = await output
    third_value = await output
    result = [first_value, second_value, third_value]
    await first_task, second_task, third_task
    return result

test "reverse launch order":
    assert(ordered() == [1, 2, 3])

test "ordering is repeatable":
    assert(ordered() == [1, 2, 3])
