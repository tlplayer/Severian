# Track: LeetCode 75
# Problem: 62 - Unique Paths
# Difficulty: medium
# Tags: dynamic-programming, math, matrix, combinatorics
# Count paths from the upper-left to the lower-right of a grid when movement is
# restricted to one cell right or one cell down.

def unique_paths(rows: int, columns: int) -> int:
    paths := []
    while size(paths) < columns:
        paths.append(1)

    for row in range(1, rows):
        for column in range(1, columns):
            paths[column] += paths[column - 1]

    return paths[columns - 1]

test "rectangular grid":
    assert(unique_paths(3, 7) == 28)

test "narrow grid":
    assert(unique_paths(3, 2) == 3)

test "single row":
    assert(unique_paths(1, 8) == 1)

test "single cell":
    assert(unique_paths(1, 1) == 1)
