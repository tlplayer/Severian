# Track: LeetCode 75
# Problem: 198 - House Robber
# Difficulty: medium
# Tags: array, dynamic-programming
# Return the greatest sum obtainable without selecting adjacent values.

def maximum(left: int, right: int) -> int:
    if left > right:
        return left
    return right

def rob(values: list[int]) -> int:
    previous := 0
    current := 0

    for value in values:
        withCurrent = maximum(previous + value, current)
        previous = current
        current = withCurrent

    return current

test "representative street":
    assert(rob([1, 2, 3, 1]) == 4)

test "non-adjacent optimum":
    assert(rob([2, 7, 9, 3, 1]) == 12)

test "single house":
    assert(rob([8]) == 8)

test "empty street":
    assert(rob([]) == 0)
