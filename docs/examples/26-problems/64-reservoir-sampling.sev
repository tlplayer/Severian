# Track: Hard validation
# Problem: 398 - Random Pick Index (Reservoir variant)
# Difficulty: medium
# Tags: reservoir-sampling, randomized, probability-and-statistics, data-stream

def reservoir_sample(values: list[int], sample_size: int, initial_seed: int) -> list[int]:
    sample := []
    for index in range(0, sample_size):
        sample.append(values[index])
    seed := initial_seed
    for index in range(sample_size, size(values)):
        seed = (seed * 1103515245 + 12345) % 2147483647
        chosen = seed % (index + 1)
        if chosen < sample_size:
            sample[chosen] = values[index]
    return sample

test "fixed sample size":
    sample = reservoir_sample([10, 20, 30, 40, 50], 2, 7)
    assert(size(sample) == 2)
    assert(sample[0] in [10, 20, 30, 40, 50])
    assert(sample[1] in [10, 20, 30, 40, 50])

test "seeded reproducibility":
    first = reservoir_sample([1, 2, 3, 4, 5, 6], 3, 42)
    second = reservoir_sample([1, 2, 3, 4, 5, 6], 3, 42)
    assert(first == second)

test "whole stream":
    assert(reservoir_sample([3, 5, 8], 3, 9) == [3, 5, 8])
