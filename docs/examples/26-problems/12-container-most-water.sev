# Track: LeetCode 75
# Problem: 11 - Container With Most Water
# Difficulty: medium
# Tags: array, two-pointers, greedy, math

def smaller(left: int, right: int) -> int:
    if left < right:
        return left
    return right

def maxArea(height: list[int]) -> int:
    right := size(height) - 1
    best := 0

    while left < right with left := 0:
        area = smaller(height[left], height[right]) * (right - left)
        if area > best:
            best = area
        if height[left] < height[right]:
            left += 1
        else:
            right -= 1

    return best

test "representative heights":
    assert(maxArea([1, 8, 6, 2, 5, 4, 8, 3, 7]) == 49)

test "two lines":
    assert(maxArea([1, 1]) == 1)

test "shorter inner line":
    assert(maxArea([4, 3, 2, 1, 4]) == 16)
