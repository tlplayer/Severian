# Track: Hard validation
# Problem: 1755 - Closest Subsequence Sum
# Difficulty: hard
# Tags: meet-in-the-middle, bitmask, enumeration, combinatorics

def subset_sums(values: list[int], start: int, end: int) -> list[int]:
    length = end - start
    combination_count := 1
    for index in range(0, length):
        combination_count *= 2
    sums := []
    for mask in range(0, combination_count):
        remaining := mask
        total := 0
        for offset in range(0, length):
            if remaining % 2 == 1:
                total += values[start + offset]
            remaining = remaining / 2
        sums.append(total)
    return sums

def min_abs_difference(values: list[int], goal: int) -> int:
    middle = size(values) / 2
    left_sums = subset_sums(values, 0, middle)
    right_sums = subset_sums(values, middle, size(values))
    best := abs(goal)
    for left in left_sums:
        for right in right_sums:
            difference = abs(goal - left - right)
            if difference < best:
                best = difference
    return best

test "exact target":
    assert(min_abs_difference([5, -7, 3, 5], 6) == 0)

test "nearest target":
    assert(min_abs_difference([7, -9, 15, -2], -5) == 1)

test "single value":
    assert(min_abs_difference([1], 3) == 2)
