# Track: Hard validation
# Problem: 912 - Sort an Array (Counting Sort variant)
# Difficulty: medium
# Tags: counting-sort, bucket-sort, sorting, counting, array

def countingSort(values: list[int]) -> list[int]:
    if size(values) == 0:
        return []
    smallest := values[0]
    largest := values[0]
    for value in values:
        if value < smallest:
            smallest = value
        if value > largest:
            largest = value
    buckets := []
    for value in range(smallest, largest + 1):
        buckets.append(0)
    for value in values:
        buckets[value - smallest] += 1
    result := []
    for bucket in indices(buckets):
        for count in range(0, buckets[bucket]):
            result.append(bucket + smallest)
    return result

test "negative values":
    assert(countingSort([5, -1, 3, 5, 0]) == [-1, 0, 3, 5, 5])

test "already sorted":
    assert(countingSort([1, 2, 3]) == [1, 2, 3])

test "empty array":
    assert(countingSort([]) == [])
