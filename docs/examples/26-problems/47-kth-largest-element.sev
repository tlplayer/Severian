# Track: LeetCode 75
# Problem: 215 - Kth Largest Element in an Array
# Difficulty: medium
# Tags: heap-priority-queue, sorting, array

def find_kth_largest(values: list[int], k: int) -> int:
    heap := []
    for value in values:
        heap.heap_push(value)
        if size(heap) > k:
            heap.heap_pop()
    return heap[0]

def find_kth_largest_concise(values: list[int], k: int) -> int:
    return values.sorted()[size(values) - k]

test "second largest":
    assert(find_kth_largest([3, 2, 1, 5, 6, 4], 2) == 5)
    assert(find_kth_largest_concise([3, 2, 1, 5, 6, 4], 2) == 5)

test "duplicates":
    assert(find_kth_largest([3, 2, 3, 1, 2, 4, 5, 5, 6], 4) == 4)
    assert(find_kth_largest_concise([3, 2, 3, 1, 2, 4, 5, 5, 6], 4) == 4)

test "only value":
    assert(find_kth_largest([-1], 1) == -1)
    assert(find_kth_largest_concise([-1], 1) == -1)
