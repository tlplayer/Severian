# Track: LeetCode 75
# Problem: 1143 - Longest Common Subsequence
# Difficulty: medium
# Tags: string, dynamic-programming

def larger(left: int, right: int) -> int:
    if left > right:
        return left
    return right

def longest_common_subsequence(first: string, second: string) -> int:
    row := [0]
    while size(row) <= size(second):
        row.append(0)

    for first_index in range(0, size(first)):
        diagonal := 0
        for second_index in range(0, size(second)):
            previous = row[second_index + 1]
            if first[first_index] == second[second_index]:
                row[second_index + 1] = diagonal + 1
            else:
                row[second_index + 1] = larger(row[second_index + 1], row[second_index])
            diagonal = previous
    return row[size(second)]

test "shared subsequence":
    assert(longest_common_subsequence("abcde", "ace") == 3)

test "identical strings":
    assert(longest_common_subsequence("abc", "abc") == 3)

test "disjoint strings":
    assert(longest_common_subsequence("abc", "def") == 0)
