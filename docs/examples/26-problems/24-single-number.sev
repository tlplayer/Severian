# Track: LeetCode 75
# Problem: 136 - Single Number
# Difficulty: easy
# Tags: array, bit-manipulation, counting
# This version uses occurrence counting while integer bitwise operators are not
# part of the language surface.

def single_number(values: list[int]) -> int:
    for value in values:
        count := 0
        for candidate in values:
            if candidate == value:
                count += 1
        if count == 1:
            return value
    return 0

test "pair and singleton":
    assert(single_number([2, 2, 1]) == 1)

test "several pairs":
    assert(single_number([4, 1, 2, 1, 2]) == 4)

test "only value":
    assert(single_number([9]) == 9)
