# Track: LeetCode 75
# Problem: 2390 - Removing Stars From a String
# Difficulty: medium
# Tags: string, stack

def remove_stars(text: string) -> string:
    stack := []
    top := 0
    for index in range(0, size(text)):
        character = text[index]
        if character == "*":
            top -= 1
        else:
            if top < size(stack):
                stack[top] = character
            else:
                stack.append(character)
            top += 1

    result := ""
    for index in range(0, top):
        result += stack[index]
    return result

test "several removals":
    assert(remove_stars("leet**cod*e") == "lecoe")

test "everything removed":
    assert(remove_stars("erase*****") == "")

test "interleaved removals":
    assert(remove_stars("abb*cdfg*****x*") == "a")
