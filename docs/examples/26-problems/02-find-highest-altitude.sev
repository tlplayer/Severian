# Track: LeetCode 75
# Problem: 1732 - Find the Highest Altitude
# Difficulty: easy
# Tags: array, prefix-sum, math
# A cyclist starts at altitude zero. Return the highest altitude reached after
# applying each gain or loss in order.

def largest_altitude(gain: list[int]) -> int:
    altitude := 0
    highest := 0

    for change in gain:
        altitude += change
        if altitude > highest:
            highest = altitude

    return highest

test "mixed gains and losses":
    assert(largest_altitude([-5, 1, 5, 0, -7]) == 1)

test "steadily climbing":
    assert(largest_altitude([-4, -3, -2, -1, 4, 3, 2]) == 0)

test "empty route remains at sea level":
    assert(largest_altitude([]) == 0)
