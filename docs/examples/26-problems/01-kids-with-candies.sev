# Track: LeetCode 75
# Problem: 1431 - Kids With the Greatest Number of Candies
# Difficulty: easy
# Tags: array, two-pass
# Return whether each child can reach the current maximum after receiving all
# extra candies.

def kidsWithCandies(candies: list[int], extraCandies: int) -> list[bool]:
    greatest := candies[0]
    for candy in candies:
        if candy > greatest:
            greatest = candy

    result := []
    for candy in candies:
        result.append(candy + extraCandies >= greatest)

    return result

test "representative distribution":
    assert(kidsWithCandies([2, 3, 5, 1, 3], 3) == [true, true, true, false, true])

test "tied greatest values":
    assert(kidsWithCandies([4, 2, 1, 1, 2], 1) == [true, false, false, false, false])

test "single child":
    assert(kidsWithCandies([7], 0) == [true])
