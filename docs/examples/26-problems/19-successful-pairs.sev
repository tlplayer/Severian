# Track: LeetCode 75
# Problem: 2300 - Successful Pairs of Spells and Potions
# Difficulty: medium
# Tags: array, binary-search, math
# This direct version keeps the input order and counts pairs without requiring a
# sorting primitive.

def successfulPairs(spells: list[int], potions: list[int], success: int) -> list[int]:
    answer := []
    for spell in spells:
        count := 0
        for potion in potions:
            if spell * potion >= success:
                count += 1
        answer.append(count)
    return answer

test "representative pairs":
    assert(successfulPairs([5, 1, 3], [1, 2, 3, 4, 5], 7) == [4, 0, 3])

test "mixed thresholds":
    assert(successfulPairs([3, 1, 2], [8, 5, 8], 16) == [2, 0, 2])

test "single pair":
    assert(successfulPairs([2], [3], 6) == [1])
