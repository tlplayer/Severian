# Track: Concurrency validation
# Problem: 1117 - Building H2O
# Difficulty: medium
# Tags: concurrency, barrier, channel

def releaseHydrogen(permit: Channel[int], completed: Channel[int], output: Channel[string]):
    await permit
    emitted = async send "H" with output
    await emitted
    done = async send 1 with completed
    await done

def releaseOxygen(completed: Channel[int], output: Channel[string]):
    await completed
    await completed
    emitted = async send "O" with output
    await emitted

def buildWater(molecules: int) -> list[string]:
    result := []
    for _ in range(molecules):
        hydrogen = Channel[int] with Buffer(2)
        completed = Channel[int] with Buffer(2)
        output = Channel[string] with Buffer(3)
        firstPermit = async send 1 with hydrogen
        secondPermit = async send 1 with hydrogen
        oxygenTask = async releaseOxygen(completed, output) with self
        firstHydrogen = async releaseHydrogen(hydrogen, completed, output) with self
        secondHydrogen = async releaseHydrogen(hydrogen, completed, output) with self
        result.append(await output)
        result.append(await output)
        result.append(await output)
        await firstPermit, secondPermit, firstHydrogen, secondHydrogen, oxygenTask
    return result

test "two molecules":
    assert(buildWater(2) == ["H", "H", "O", "H", "H", "O"])

test "single molecule":
    assert(buildWater(1) == ["H", "H", "O"])
