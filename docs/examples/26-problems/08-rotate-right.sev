def rotateRight(values: list[int], steps: int) -> list[int]:
    count = size(values)

    if count == 0:
        return []

    normalized = steps % count
    output := []

    for index in range(0, count):
        source_index = (count - normalized + index) % count
        output.append(values[source_index])

    return output

test "rotates by two":
    assert(rotateRight([1, 2, 3, 4, 5], 2) == [4, 5, 1, 2, 3])

test "normalizes a large rotation":
    assert(rotateRight([1, 2, 3], 5) == [2, 3, 1])

test "zero rotation preserves values":
    assert(rotateRight([1, 2, 3], 0) == [1, 2, 3])

test "empty input remains empty":
    assert(rotateRight([], 100) == [])
