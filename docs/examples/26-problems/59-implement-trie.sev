# Track: LeetCode 75
# Problem: 208 - Implement Trie (Prefix Tree)
# Difficulty: medium
# Tags: trie, design, string, array

def letter_index(character: string) -> int:
    alphabet = "abcdefghijklmnopqrstuvwxyz"
    for index in range(0, size(alphabet)):
        if alphabet[index] == character:
            return index
    return -1

def empty_trie_node() -> list[int]:
    node := []
    for index in range(0, 27):
        node.append(0)
    return node

def build_trie(words: list[string]) -> list[list[int]]:
    trie := [empty_trie_node()]
    for word in words:
        node := 0
        for position in range(0, size(word)):
            letter = letter_index(word[position])
            child := trie[node][letter]
            if child == 0:
                trie.append(empty_trie_node())
                child = size(trie) - 1
                trie[node][letter] = child
            node = child
        trie[node][26] = 1
    return trie

def trie_contains(trie: list[list[int]], word: string) -> bool:
    node := 0
    for position in range(0, size(word)):
        letter = letter_index(word[position])
        node = trie[node][letter]
        if node == 0:
            return false
    return trie[node][26] == 1

def trie_starts_with(trie: list[list[int]], prefix: string) -> bool:
    node := 0
    for position in range(0, size(prefix)):
        letter = letter_index(prefix[position])
        node = trie[node][letter]
        if node == 0:
            return false
    return true

test "word and prefix":
    trie := build_trie(["apple"])
    assert(trie_contains(trie, "apple"))
    assert(not trie_contains(trie, "app"))
    assert(trie_starts_with(trie, "app"))

test "inserted prefix":
    trie := build_trie(["apple", "app"])
    assert(trie_contains(trie, "app"))

test "missing branch":
    trie := build_trie(["cat", "car"])
    assert(not trie_starts_with(trie, "cab"))
