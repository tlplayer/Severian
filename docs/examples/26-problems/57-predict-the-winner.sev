# Track: Hard validation
# Problem: 486 - Predict the Winner
# Difficulty: medium
# Tags: game-theory, minimax, memoization, dynamic-programming, recursion

def bestDifference(values: list[int], memo: list[list[int]], left: int, right: int) -> int:
    if left == right:
        return values[left]
    if memo[left][right] != -1000000000:
        return memo[left][right]
    takeLeft = values[left] - bestDifference(values, memo, left + 1, right)
    takeRight = values[right] - bestDifference(values, memo, left, right - 1)
    best := takeLeft
    if takeRight > best:
        best = takeRight
    memo[left][right] = best
    return best

def predictTheWinner(values: list[int]) -> bool:
    memo := []
    for rowIndex in indices(values):
        row := []
        for columnIndex in indices(values):
            row.append(-1000000000)
        memo.append(row)
    return bestDifference(values, memo, 0, size(values) - 1) >= 0

test "first player loses":
    assert(not predictTheWinner([1, 5, 2]))

test "first player wins":
    assert(predictTheWinner([1, 5, 233, 7]))

test "tie is a win":
    assert(predictTheWinner([1, 1]))
