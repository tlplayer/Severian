def mergeSorted(left: list[int], right: list[int]) -> list[int]:
    output := []
    left_index := 0
    right_index := 0

    while left_index < size(left) and right_index < size(right):
        if left[left_index] <= right[right_index]:
            output.append(left[left_index])
            left_index += 1
        else:
            output.append(right[right_index])
            right_index += 1

    while left_index < size(left):
        output.append(left[left_index])
        left_index += 1

    while right_index < size(right):
        output.append(right[right_index])
        right_index += 1

    return output

test "merges two sorted lists":
    assert(mergeSorted([1, 3, 5], [2, 4, 6]) == [1, 2, 3, 4, 5, 6])

test "handles duplicates":
    assert(mergeSorted([1, 2, 2], [2, 3]) == [1, 2, 2, 2, 3])

test "handles an empty side":
    assert(mergeSorted([], [1, 2]) == [1, 2])
    assert(mergeSorted([1, 2], []) == [1, 2])
