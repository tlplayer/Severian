# Track: LeetCode 75
# Problem: 1657 - Determine if Two Strings Are Close
# Difficulty: medium
# Tags: string, hash-table, sorting, counting

def close_strings(first: string, second: string) -> bool:
    first_counts = first.frequencies()
    second_counts = second.frequencies()
    return first_counts.keys().sorted() == second_counts.keys().sorted() and first_counts.values().sorted() == second_counts.values().sorted()

test "same transformations":
    assert(close_strings("abc", "bca"))

test "different character sets":
    assert(not close_strings("a", "aa"))
    assert(not close_strings("cabbba", "aabbss"))

test "frequency permutation":
    assert(close_strings("cabbba", "abbccc"))
