# Track: LeetCode 75
# Problem: 1657 - Determine if Two Strings Are Close
# Difficulty: medium
# Tags: string, hash-table, sorting, counting

def closeStrings(first: string, second: string) -> bool:
    firstCounts = first.frequencies()
    secondCounts = second.frequencies()
    return firstCounts.keys().sorted() == secondCounts.keys().sorted() and firstCounts.values().sorted() == secondCounts.values().sorted()

test "same transformations":
    assert(closeStrings("abc", "bca"))

test "different character sets":
    assert(not closeStrings("a", "aa"))
    assert(not closeStrings("cabbba", "aabbss"))

test "frequency permutation":
    assert(closeStrings("cabbba", "abbccc"))
