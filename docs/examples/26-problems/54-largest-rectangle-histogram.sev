# Track: Hard validation
# Problem: 84 - Largest Rectangle in Histogram
# Difficulty: hard
# Tags: monotonic-stack, stack, array

def largestRectangleArea(heights: list[int]) -> int:
    stack := []
    top := 0
    best := 0
    index := 0
    while index <= size(heights):
        current := 0
        if index < size(heights):
            current = heights[index]
        while top > 0 and heights[stack[top - 1]] > current:
            top -= 1
            height = heights[stack[top]]
            left := 0
            if top > 0:
                left = stack[top - 1] + 1
            area = height * (index - left)
            if area > best:
                best = area
        if top < size(stack):
            stack[top] = index
        else:
            stack.append(index)
        top += 1
        index += 1
    return best

test "mixed histogram":
    assert(largestRectangleArea([2, 1, 5, 6, 2, 3]) == 10)

test "two bars":
    assert(largestRectangleArea([2, 4]) == 4)

test "empty histogram":
    assert(largestRectangleArea([]) == 0)
