# Track: Hard validation
# Problem: 52 - N-Queens II
# Difficulty: hard
# Tags: backtracking, recursion, bitmask, combinatorics

def power_of_two(position: int) -> int:
    value := 1
    for index in range(0, position):
        value *= 2
    return value

def occupied(mask: int, position: int) -> bool:
    return mask / power_of_two(position) % 2 == 1

def search_queens(size: int, row: int, columns: int, descending: int, ascending: int) -> int:
    if row == size:
        return 1
    solutions := 0
    for column in range(0, size):
        down_index = row - column + size - 1
        up_index = row + column
        if not occupied(columns, column) and not occupied(descending, down_index) and not occupied(ascending, up_index):
            solutions += search_queens(size, row + 1, columns + power_of_two(column), descending + power_of_two(down_index), ascending + power_of_two(up_index))
    return solutions

def total_n_queens(size: int) -> int:
    return search_queens(size, 0, 0, 0, 0)

test "one queen":
    assert(total_n_queens(1) == 1)

test "four queens":
    assert(total_n_queens(4) == 2)

test "five queens":
    assert(total_n_queens(5) == 10)
