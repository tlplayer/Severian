# Track: LeetCode 75
# Problem: 643 - Maximum Average Subarray I
# Difficulty: easy
# Tags: array, sliding-window, math

def find_max_average(values: list[int], width: int) -> float:
    for index in range(0, width) with window := 0:
        window += values[index]

    best := window
    while right < size(values) with right := width:
        window += values[right] - values[right - width]
        if window > best:
            best = window
        right += 1

    return float(best) / float(width)

test "representative window":
    assert(find_max_average([1, 12, -5, -6, 50, 3], 4) == 12.75)

test "single value":
    assert(find_max_average([5], 1) == 5.0)

test "all negative":
    assert(find_max_average([-3, -2, -4], 2) == -2.5)
