# Track: LeetCode 75
# Problem: 649 - Dota2 Senate
# Difficulty: medium
# Tags: string, queue, greedy, simulation

def predict_party_victory(senate: string) -> string:
    radiant := []
    dire := []
    for index in range(0, size(senate)):
        if senate[index] == "R":
            radiant.append(index)
        else:
            dire.append(index)

    radiant_head := 0
    dire_head := 0
    turn := size(senate)
    while radiant_head < size(radiant) and dire_head < size(dire):
        if radiant[radiant_head] < dire[dire_head]:
            radiant.append(turn)
        else:
            dire.append(turn)
        radiant_head += 1
        dire_head += 1
        turn += 1

    if radiant_head < size(radiant):
        return "Radiant"
    return "Dire"

test "radiant wins":
    assert(predict_party_victory("RD") == "Radiant")

test "dire survives a cycle":
    assert(predict_party_victory("RDD") == "Dire")

test "longer contest":
    assert(predict_party_victory("DRRDRDRDRDDRDRDR") == "Radiant")
