def valid_parentheses(text: string) -> bool:
    stack := []

    for character in text:
        if character == "(" or character == "[" or character == "{":
            stack.append(character)
            continue

        if size(stack) == 0:
            return false

        opening = stack[-1]

        if character == ")" and opening != "(":
            return false
        if character == "]" and opening != "[":
            return false
        if character == "}" and opening != "{":
            return false

        stack.pop()

    return size(stack) == 0

test "accepts balanced nesting":
    assert(valid_parentheses("([]{})"))

test "accepts an empty string":
    assert(valid_parentheses(""))

test "rejects crossed nesting":
    assert(not valid_parentheses("([)]"))
    assert(not valid_parentheses("(]"))

test "rejects an unmatched close":
    assert(not valid_parentheses("]"))

test "rejects an unmatched open":
    assert(not valid_parentheses("(("))
