# Track: LeetCode 75
# Problem: 1679 - Max Number of K-Sum Pairs
# Difficulty: medium
# Tags: array, two-pointers, counting

def max_operations(values: list[int], target: int) -> int:
    used := []
    for _ in values:
        used.append(false)

    operations := 0
    for first in indices(values):
        if not used[first]:
            second := first + 1
            while second < size(values):
                if not used[second] and values[first] + values[second] == target:
                    used[first] = true
                    used[second] = true
                    operations += 1
                    second = size(values)
                else:
                    second += 1
    return operations

test "two pairs":
    assert(max_operations([1, 2, 3, 4], 5) == 2)

test "duplicate values":
    assert(max_operations([3, 1, 3, 4, 3], 6) == 1)

test "no pair":
    assert(max_operations([1, 1, 1], 5) == 0)
