# Track: LeetCode 75
# Problem: 392 - Is Subsequence
# Difficulty: easy
# Tags: string, two-pointers

def is_subsequence(candidate: string, text: string) -> bool:
    matched := 0
    for index in range(0, size(text)):
        if matched < size(candidate):
            if candidate[matched] == text[index]:
                matched += 1
    return matched == size(candidate)

test "ordered characters":
    assert(is_subsequence("abc", "ahbgdc"))

test "wrong order":
    assert(not is_subsequence("axc", "ahbgdc"))

test "empty candidate":
    assert(is_subsequence("", "anything"))
