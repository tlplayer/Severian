# Track: LeetCode 75
# Problem: 2215 - Find the Difference of Two Arrays
# Difficulty: easy
# Tags: array, set

def unique_difference(source: list[int], excluded: list[int]) -> list[int]:
    return source.to_set().difference(excluded.to_set()).to_list()

def find_difference(first: list[int], second: list[int]) -> list[list[int]]:
    return [unique_difference(first, second), unique_difference(second, first)]

test "overlapping arrays":
    assert(unique_difference([1, 2, 3], [2, 4, 6]) == [1, 3])
    assert(unique_difference([2, 4, 6], [1, 2, 3]) == [4, 6])

test "deduplicates output":
    assert(unique_difference([1, 2, 3, 3], [1, 1, 2, 2]) == [3])
    assert(unique_difference([1, 1, 2, 2], [1, 2, 3, 3]) == [])

test "disjoint arrays":
    assert(unique_difference([1], [2]) == [1])
    assert(unique_difference([2], [1]) == [2])

test "returns both directed differences":
    assert(find_difference([1, 2, 3], [2, 4, 6]) == [[1, 3], [4, 6]])
