# Track: LeetCode 75
# Problem: 2215 - Find the Difference of Two Arrays
# Difficulty: easy
# Tags: array, set

def uniqueDifference(source: list[int], excluded: list[int]) -> list[int]:
    return source.toSet().difference(excluded.toSet()).toList()

def findDifference(first: list[int], second: list[int]) -> list[list[int]]:
    return [uniqueDifference(first, second), uniqueDifference(second, first)]

test "overlapping arrays":
    assert(uniqueDifference([1, 2, 3], [2, 4, 6]) == [1, 3])
    assert(uniqueDifference([2, 4, 6], [1, 2, 3]) == [4, 6])

test "deduplicates output":
    assert(uniqueDifference([1, 2, 3, 3], [1, 1, 2, 2]) == [3])
    assert(uniqueDifference([1, 1, 2, 2], [1, 2, 3, 3]) == [])

test "disjoint arrays":
    assert(uniqueDifference([1], [2]) == [1])
    assert(uniqueDifference([2], [1]) == [2])
