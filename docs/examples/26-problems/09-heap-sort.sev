def heapSort(values: list[int]) -> list[int]:
    heap := []

    for value in values:
        heap.heapPush(value)

    output := []
    while size(heap) > 0:
        output.append(heap.heapPop())

    return output

test "sorts an unsorted list":
    assert(heapSort([5, 1, 4, 2, 8]) == [1, 2, 4, 5, 8])

test "preserves duplicates":
    assert(heapSort([3, 1, 3, 2]) == [1, 2, 3, 3])

test "handles empty input":
    assert(heapSort([]) == [])
