# Track: LeetCode 75
# Problem: 1071 - Greatest Common Divisor of Strings
# Difficulty: easy
# Tags: string, math, number-theory

def gcd(left: int, right: int) -> int:
    first := left
    second := right
    while second != 0:
        remainder = first % second
        first = second
        second = remainder
    return first

def gcd_of_strings(first: string, second: string) -> string:
    if first + second != second + first:
        return ""

    length = gcd(size(first), size(second))
    result := ""
    for index in range(0, length):
        result += first[index]
    return result

test "one string divides the other":
    assert(gcd_of_strings("ABCABC", "ABC") == "ABC")

test "shared shorter divisor":
    assert(gcd_of_strings("ABABAB", "ABAB") == "AB")

test "no common divisor":
    assert(gcd_of_strings("LEET", "CODE") == "")
