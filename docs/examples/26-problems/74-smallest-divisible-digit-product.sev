# Track: LeetCode validation
# Problem: 3345 - Smallest Divisible Digit Product I
# Difficulty: easy
# Tags: math, enumeration, number-theory

def digit_product(value: int) -> int:
    if value == 0:
        return 0
    product := 1
    remaining := value
    while remaining > 0:
        product *= remaining % 10
        remaining = remaining / 10
    return product

def smallest_number(start: int, divisor: int) -> int:
    candidate := start
    while digit_product(candidate) % divisor != 0:
        candidate += 1
    return candidate

test "already divisible":
    assert(smallest_number(10, 2) == 10)
    assert(smallest_number(22, 4) == 22)

test "searches upward":
    assert(smallest_number(19, 2) == 20)
    assert(smallest_number(15, 3) == 16)
    assert(smallest_number(33, 8) == 38)
