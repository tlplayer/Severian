# Track: LeetCode 75
# Problem: 714 - Best Time to Buy and Sell Stock with Transaction Fee
# Difficulty: medium
# Tags: array, dynamic-programming, greedy

def greater(left: int, right: int) -> int:
    if left > right:
        return left
    return right

def maxProfit(prices: list[int], fee: int) -> int:
    cash := 0
    holding := 0 - prices[0]

    for index in range(1, size(prices)):
        previousCash = cash
        cash = greater(cash, holding + prices[index] - fee)
        holding = greater(holding, previousCash - prices[index])

    return cash

test "two transactions":
    assert(maxProfit([1, 3, 2, 8, 4, 9], 2) == 8)

test "delayed sale":
    assert(maxProfit([1, 3, 7, 5, 10, 3], 3) == 6)

test "no profitable sale":
    assert(maxProfit([5, 4, 3], 1) == 0)
