# Track: Top Interview 150
# Problem: 307 - Range Sum Query - Mutable
# Difficulty: medium
# Tags: segment-tree, tree, design, array

def buildTree(values: list[int]) -> list[int]:
    count = size(values)
    tree := []
    for index in range(0, count * 2):
        tree.append(0)
    for index in range(0, count):
        tree[count + index] = values[index]
    for index in range(1, count):
        node = count - index
        tree[node] = tree[node * 2] + tree[node * 2 + 1]
    return tree

def updateTree(tree: list[int], count: int, index: int, value: int):
    node := count + index
    tree[node] = value
    while node > 1:
        node = node / 2
        tree[node] = tree[node * 2] + tree[node * 2 + 1]

def rangeSum(tree: list[int], count: int, left: int, right: int) -> int:
    start := left + count
    end := right + count
    total := 0
    while start <= end:
        if start % 2 == 1:
            total += tree[start]
            start += 1
        if end % 2 == 0:
            total += tree[end]
            end -= 1
        start = start / 2
        end = end / 2
    return total

test "range query":
    tree := buildTree([1, 3, 5])
    assert(rangeSum(tree, 3, 0, 2) == 9)

test "point update":
    tree := buildTree([1, 3, 5])
    updateTree(tree, 3, 1, 2)
    assert(rangeSum(tree, 3, 0, 2) == 8)

test "single value":
    tree := buildTree([7])
    updateTree(tree, 1, 0, -2)
    assert(rangeSum(tree, 1, 0, 0) == -2)
