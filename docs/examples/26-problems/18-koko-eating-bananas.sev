# Track: LeetCode 75
# Problem: 875 - Koko Eating Bananas
# Difficulty: medium
# Tags: array, binary-search, math

def hoursAtSpeed(piles: list[int], speed: int) -> int:
    hours := 0
    for pile in piles:
        hours += (pile + speed - 1) / speed
    return hours

def minEatingSpeed(piles: list[int], availableHours: int) -> int:
    high := piles[0]
    for pile in piles:
        if pile > high:
            high = pile

    while low < high with low := 1:
        middle = low + (high - low) / 2
        if hoursAtSpeed(piles, middle) <= availableHours:
            high = middle
        else:
            low = middle + 1

    return low

test "representative piles":
    assert(minEatingSpeed([3, 6, 7, 11], 8) == 4)

test "tight deadline":
    assert(minEatingSpeed([30, 11, 23, 4, 20], 5) == 30)

test "one extra hour":
    assert(minEatingSpeed([30, 11, 23, 4, 20], 6) == 23)
