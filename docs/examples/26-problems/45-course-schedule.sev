# Track: Top Interview 150
# Problem: 207 - Course Schedule
# Difficulty: medium
# Tags: graph, topological-sort, breadth-first-search, queue

def can_finish(course_count: int, prerequisites: list[list[int]]) -> bool:
    indegree := []
    for course in range(0, course_count):
        indegree.append(0)
    for edge in prerequisites:
        indegree[edge[0]] += 1

    queue := []
    for course in range(0, course_count):
        if indegree[course] == 0:
            queue.append(course)
    head := 0
    completed := 0
    while head < size(queue):
        prerequisite = queue[head]
        head += 1
        completed += 1
        for edge in prerequisites:
            if edge[1] == prerequisite:
                course = edge[0]
                indegree[course] -= 1
                if indegree[course] == 0:
                    queue.append(course)
    return completed == course_count

test "simple dependency":
    assert(can_finish(2, [[1, 0]]))

test "cycle":
    assert(not can_finish(2, [[1, 0], [0, 1]]))

test "several roots":
    assert(can_finish(5, [[1, 0], [2, 0], [3, 1], [3, 2]]))
