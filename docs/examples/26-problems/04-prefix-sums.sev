def prefixSums(values: list[int]) -> list[int]:
    output := []
    total := 0

    for value in values:
        total += value
        output.append(total)

    return output

test "builds inclusive prefix sums":
    assert(prefixSums([1, 2, 3, 4]) == [1, 3, 6, 10])

test "handles negative values":
    assert(prefixSums([5, -2, 3]) == [5, 3, 6])

test "handles empty input":
    assert(prefixSums([]) == [])
