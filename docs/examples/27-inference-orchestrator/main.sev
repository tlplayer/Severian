import model
import network
import orchestrator
import tensor

class InferenceRequest:
    id: int
    features: list[float]

class InferenceResponse:
    id: int
    values: list[float]
    attempt: int

class InferenceBatch:
    id: int
    requests: list[InferenceRequest]
    fail_first: bool

class BatchResult:
    batch_id: int
    ok: bool
    responses: list[InferenceResponse]

class NodeReport:
    health: string
    pressure: string
    accepted: int
    completed: int
    batches: int
    restarts: int
    failed_attempts: int
    responses: list[InferenceResponse]

def predict(features: list[float]) -> list[float]:
    input = tensor.ranked(features, [1, 2])
    weights = tensor.ranked([1.0, 0.0, 0.0, 1.0], [2, 2])
    bias = tensor.ranked([-1.0, 1.0], [1, 2])
    x = model.graph_input(input)
    w = model.graph_input(weights)
    b = model.graph_input(bias)
    output = model.run_graph(model.graph_relu(model.graph_add(model.graph_matmul(x, w), b)))
    return tensor.ranked_values(output)

def make_batches(requests: list[InferenceRequest], batch_size: int, failure_batch: int) -> list[InferenceBatch]:
    assert(batch_size > 0)
    batches := []
    for start in range(0, size(requests), batch_size):
        end := start + batch_size
        if end > size(requests):
            end = size(requests)
        batch_id = size(batches)
        batches.append(InferenceBatch(batch_id, requests[start:end], batch_id == failure_batch))
    return batches

def run_batch(worker_id: int, batch: InferenceBatch, attempt: int) -> BatchResult:
    if batch.fail_first and attempt == 1:
        return BatchResult(batch.id, false, [])
    responses := []
    for request in batch.requests:
        responses.append(InferenceResponse(request.id, predict(request.features), attempt))
    return BatchResult(batch.id, true, responses)

def pool_worker(worker_id: int, jobs: Channel[InferenceBatch], results: Channel[BatchResult]):
    while true:
        batch = await jobs
        if batch.id < 0:
            return
        result = run_batch(worker_id, batch, 1)
        delivered = async send result with results
        await delivered

def run_node(
    requests: list[InferenceRequest],
    batch_size: int,
    queue_capacity: int,
    failure_batch: int,
) -> NodeReport:
    assert(queue_capacity > 0)
    batches = make_batches(requests, batch_size, failure_batch)
    jobs = Channel[InferenceBatch] with Buffer(queue_capacity)
    results = Channel[BatchResult] with Buffer(queue_capacity)

    first_worker = async pool_worker(0, jobs, results) with self
    second_worker = async pool_worker(1, jobs, results) with self

    for batch in batches:
        queued = async send batch with jobs
        await queued

    first_stop = async send InferenceBatch(-1, [], false) with jobs
    await first_stop
    second_stop = async send InferenceBatch(-1, [], false) with jobs
    await second_stop

    raw_results := []
    for _ in batches:
        raw_results.append(await results)

    await first_worker, second_worker

    responses := []
    restarts := 0
    failed_attempts := 0
    for result in raw_results:
        if result.ok:
            responses.extend(result.responses)
        else:
            failed_attempts += 1
            restarts += 1
            replacement = async run_batch(100 + restarts, batches[result.batch_id], 2) with self
            recovered = await replacement
            assert(recovered.ok)
            responses.extend(recovered.responses)

    responses = responses.sorted(|response| response.id)
    completed = size(responses)
    return NodeReport(orchestrator.inference_health(2, 2, completed, size(requests)), orchestrator.queue_pressure(size(batches), queue_capacity), size(requests), completed, size(batches), restarts, failed_attempts, responses)

def sample_requests() -> list[InferenceRequest]:
    return [InferenceRequest(1, [2.0, 3.0]), InferenceRequest(2, [-1.0, 0.0]), InferenceRequest(3, [4.0, -3.0]), InferenceRequest(4, [1.0, 1.0]), InferenceRequest(5, [0.0, 2.0]), InferenceRequest(6, [5.0, 5.0])]

def transport_probe(message: string) -> string:
    switch network.loopback_echo(message):
        ok echoed:
            return "transport " + echoed
        failure _:
            return "transport unavailable"

test "bounded batches recover a failed worker attempt":
    report = run_node(sample_requests(), 2, 2, 1)
    assert(report.health == "ready")
    assert(report.pressure == "saturated")
    assert(report.accepted == 6)
    assert(report.completed == 6)
    assert(report.batches == 3)
    assert(report.restarts == 1)
    assert(report.failed_attempts == 1)
    assert(report.responses[0].values == [1.0, 4.0])
    assert(report.responses[1].values == [0.0, 1.0])
    assert(report.responses[2].values == [3.0, 0.0])
    assert(report.responses[2].attempt == 2)
    assert(report.responses[3].attempt == 2)
    assert(report.responses[5].values == [4.0, 6.0])

test "partial final batches preserve every request":
    requests = sample_requests()[0:5]
    report = run_node(requests, 2, 4, -1)
    assert(report.health == "ready")
    assert(report.pressure == "high")
    assert(report.completed == 5)
    assert(report.batches == 3)
    assert(report.restarts == 0)

test "transport probe reports native socket availability":
    status = transport_probe("inference-ready")
    assert(status == "transport inference-ready" or status == "transport unavailable")

def main():
    report = run_node(sample_requests(), 2, 2, 1)
    print(report.health)
    print(report.pressure)
    print("accepted", report.accepted)
    print("completed", report.completed)
    print("batches", report.batches)
    print("restarts", report.restarts)
    print("failed attempts", report.failed_attempts)
    for response in report.responses:
        print(response.id, response.values[0], response.values[1], response.attempt)
    transport_probe("inference-ready")
    print("transport checked")
