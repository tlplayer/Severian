from collections import list

import dependency
import linker
import file
import os
import process

def main():
    root = process.current_directory() + "/package.pkg"
    output = root + "/artifacts/host/dev"
    os.make_directories(output)
    os.make_directories(root + "/bin")
    graph = dependency.graph(["app", "left", "right", "shared"], [dependency.Edge(0, 1), dependency.Edge(0, 2), dependency.Edge(1, 3), dependency.Edge(2, 3)])
    bodies = ["int left(void); int right(void); int main(void) { return left() + right() == 84 ? 0 : 1; }", "int shared(void); int left(void) { return shared(); }", "int shared(void); int right(void) { return shared(); }", "int shared(void) { return 42; }"]
    for index in dependency.build_order(graph, [0]):
        name = graph.names[index]
        source = output + "/" + name + ".c"
        object = output + "/" + name + ".o"
        if file.write(source, bodies[index]) != len(bodies[index]):
            throw Error("could not write c source")
        if process.run(["cc", "-c", source, "-o", object]) != 0:
            throw Error("could not compile c source")
        if index != 0:
            archive_result = linker.execute_link(linker.plan_inputs("host", "static-archive", output + "/" + name + ".a", "ar", [linker.input(object)], incremental=true))
    inputs: list[linker.LinkInput] = [linker.input(output + "/app.o")]
    for index in dependency.link_order(graph, [0]):
        if index != 0:
            inputs.append(linker.input(output + "/" + graph.names[index] + ".a", "archive"))
    result = linker.execute_link(linker.plan_inputs("host", "executable", root + "/bin/diamond", "cc", inputs))
    if process.run([result.output]) != 0:
        throw Error("linked diamond returned failure")
    print("Linked and ran " + result.output)


test with integ "diamond archives compile link and execute":
    main()
    output = process.current_directory() + "/package.pkg/artifacts/host/dev"
    plan = linker.plan_inputs("host", "static-archive", output + "/reuse.a", "ar", [linker.input(output + "/shared.o")], incremental=true)
    first = linker.execute_link(plan)
    second = linker.execute_link(plan)
    assert(second.reused)
    assert(first.checksum == second.checksum)
    # An input changed after planning must be rejected before invoking the tool.
    file.write.default(output + "/shared.o", "changed")
    stale ?= linker.execute_link(plan)
    assert(stale is Error)
