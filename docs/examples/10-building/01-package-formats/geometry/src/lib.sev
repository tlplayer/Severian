@c(symbol="geometry_scale")
def scale(value: i64) -> i64

def area(width: i64, height: i64) -> i64:
    unsafe:
        return scale(width * height)+1

def answer() -> i64:
    return 42


test "c C provider participates in exported geometry calls":
    assert(area(6, 7) == 85)
    assert(answer() == 42)
