from util import range

import printer

def answer() -> int:
    return 41

def main():
    letter = 'x'
    for repetition in range(3):
        printer.foo("hello")
        printer.foo(letter)
        printer.foo(42)
        printer.foo(1.5)
        printer.foo(true)
    print(answer())

test with integ "imported generic functions specialize for each argument type":
    main()
    assert(stdout == "hello\nx\n42\n1.5\ntrue\nhello\nx\n42\n1.5\ntrue\nhello\nx\n42\n1.5\ntrue\n41\n")
