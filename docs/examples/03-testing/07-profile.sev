class CollectionError:
    message: string

class Deque[T]:
    values: list[T]
    front: int = 0

    def length() -> int:
        return size(values) - front

    def is_empty() -> bool:
        return size(values) == front

    def append(value: T):
        values.append(value)

    def append_left(value: T):
        if front > 0:
            front -= 1
            values[front] = value
        else:
            values.insert(0, value)

    def pop() -> T | CollectionError:
        if size(values) == front:
            return error(CollectionError("cannot pop from an empty deque"))
        return values.pop()

    def pop_left() -> T | CollectionError:
        if size(values) == front:
            return error(CollectionError("cannot pop from an empty deque"))
        value = values[front]
        front += 1
        if front >= 64 and front * 2 >= size(values):
            values = values[front:size(values)]
            front = 0
        return value

    def peek() -> T | CollectionError:
        if size(values) == front:
            return error(CollectionError("cannot peek at an empty deque"))
        return values[size(values) - 1]

    def peek_left() -> T | CollectionError:
        if size(values) == front:
            return error(CollectionError("cannot peek at an empty deque"))
        return values[front]

    def clear():
        values = []
        front = 0

    def to_list() -> list[T]:
        return values[front:size(values)]

class Queue[T]:
    deque: Deque[T]

    def length() -> int:
        return deque.length()

    def is_empty() -> bool:
        return deque.is_empty()

    def push(value: T):
        deque.append(value)

    def pop() -> T | CollectionError:
        return deque.pop_left()

    def peek() -> T | CollectionError:
        return deque.peek_left()

class Stack[T]:
    values: list[T]

    def length() -> int:
        return size(values)

    def is_empty() -> bool:
        return size(values) == 0

    def push(value: T):
        values.append(value)

    def pop() -> T | CollectionError:
        if size(values) == 0:
            return error(CollectionError("cannot pop from an empty stack"))
        return values.pop()

    def peek() -> T | CollectionError:
        if size(values) == 0:
            return error(CollectionError("cannot peek at an empty stack"))
        return values[size(values) - 1]

class MinHeap[T]:
    values: list[T]

    def length() -> int:
        return size(values)

    def is_empty() -> bool:
        return size(values) == 0

    def push(value: T):
        values.append(value)
        index := size(values) - 1
        while index > 0:
            parent = (index - 1) / 2
            if values[parent] <= values[index]:
                return
            temporary = values[parent]
            values[parent] = values[index]
            values[index] = temporary
            index = parent

    def pop() -> T | CollectionError:
        if size(values) == 0:
            return error(CollectionError("cannot pop from an empty heap"))
        root = values[0]
        last = values.pop()
        if size(values) > 0:
            values[0] = last
            index := 0
            while true:
                left = index * 2 + 1
                if left >= size(values):
                    break
                right = left + 1
                smallest := left
                if right < size(values) and values[right] < values[left]:
                    smallest = right
                if values[index] <= values[smallest]:
                    break
                temporary = values[index]
                values[index] = values[smallest]
                values[smallest] = temporary
                index = smallest
        return root

    def peek() -> T | CollectionError:
        if size(values) == 0:
            return error(CollectionError("cannot peek at an empty heap"))
        return values[0]

    def drain() -> list[T]:
        ordered = values.sorted()
        values = []
        return ordered

class Counter[T]:
    counts: map[T, int]
    total_count: int = 0

    def add(value: T, amount: int = 1):
        assert(amount >= 0, "counter increments must be non-negative")
        counts[value] = counts.get(value, 0) + amount
        total_count += amount

    def count(value: T) -> int:
        return counts.get(value, 0)

    def total() -> int:
        return total_count

    def unique() -> int:
        return size(counts)

    def most_common() -> list[tuple[T, int]]:
        remaining := counts.keys()
        ordered := []
        while size(remaining) > 0:
            best := remaining[0]
            for candidate in remaining:
                if counts.get(candidate, 0) > counts.get(best, 0):
                    best = candidate
            ordered.append((best, counts.get(best, 0)))
            remaining.remove(best)
        return ordered

class LruCache[K, V]:
    capacity: int with { capacity > 0 }
    values: map[K, V]
    order: list[K]

    def validate() -> bool:
        return is_valid_capacity(capacity) and size(values) == size(order) and size(order) <= capacity

    def length() -> int:
        return size(order)

    def contains(key: K) -> bool:
        return key in values

    def get(key: K) -> V | CollectionError:
        if key not in values:
            return error(CollectionError("cache key does not exist"))
        order.remove(key)
        order.append(key)
        return values[key]

    def put(key: K, value: V):
        assert(is_valid_capacity(capacity), "LRU capacity must be positive")
        if key in values:
            previous = values[key]
            _removed = values.pop(key, previous)
            order.remove(key)
        else size(order) == capacity:
            expired = order.pop(0)
            _removed = values.pop(expired, value)
        values[key] = value
        order.append(key)
        assert(is_valid_capacity(capacity) and size(values) == size(order) and size(order) <= capacity)

    def keys() -> list[K]:
        return order[0:size(order)]

def is_valid_capacity(capacity: int) -> bool:
    return capacity > 0

test "deque queue and stack preserve their ordering contracts":
    deque = Deque[int]([])
    deque.append(2)
    deque.append_left(1)
    deque.append(3)
    assert(deque.to_list() == [1, 2, 3])
    first = deque.pop_left()
    last = deque.pop()
    remaining = deque.peek()
    assert(first == 1)
    assert(last == 3)
    assert(remaining == 2)

    queue = Queue[string](Deque[string]([]))
    queue.push("first")
    queue.push("second")
    queued = queue.pop()
    assert(queued == "first")

    stack = Stack[int]([])
    stack.push(1)
    stack.push(2)
    stacked = stack.pop()
    assert(stacked == 2)

test "empty collections return structured failures":
    deque = Deque[int]([])
    match deque.pop_left():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot pop from an empty deque")
    heap = MinHeap[int]([])
    match heap.peek():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot peek at an empty heap")

test "heap counter and LRU cover duplicates and eviction":
    heap = MinHeap[int]([])
    for value in [5, -2, 1, 4, 1, 3, 2, -2]:
        heap.push(value)
    assert(heap.drain() == [-2, -2, 1, 1, 2, 3, 4, 5])
    assert(heap.is_empty())

    empty_counts: map[string, int] = {}
    counter = Counter[string](empty_counts)
    counter.add("red")
    counter.add("blue", 2)
    counter.add("red", 2)
    assert(counter.total() == 5)
    assert(counter.unique() == 2)
    assert(counter.count("red") == 3)
    assert(counter.count("missing") == 0)
    assert(counter.most_common()[0] == ("red", 3))

    empty_values: map[string, int] = {}
    cache = LruCache[string, int](2, empty_values, [])
    cache.put("a", 1)
    cache.put("b", 2)
    cached = cache.get("a")
    assert(cached == 1)
    cache.put("c", 3)
    assert(cache.keys() == ["a", "c"])
    assert(not cache.contains("b"))

test "deque compaction and LRU updates preserve logical state":
    deque = Deque[int]([])
    for value in range(0, 160):
        deque.append(value)
    for expected in range(0, 120):
        value = deque.pop_left()
        assert(value == expected)
    deque.append_left(119)
    assert(deque.length() == 41)
    assert(deque.to_list()[0] == 119)
    deque.clear()
    assert(deque.is_empty())
    deque.append_left(7)
    reused = deque.pop()
    assert(reused == 7)

    empty_values: map[string, int] = {}
    cache = LruCache[string, int](2, empty_values, [])
    cache.put("a", 1)
    cache.put("b", 2)
    cache.put("a", 10)
    assert(cache.keys() == ["b", "a"])
    updated = cache.get("a")
    assert(updated == 10)
    cache.put("c", 3)
    assert(cache.keys() == ["a", "c"])
    match cache.get("b"):
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cache key does not exist")

    single_values: map[int, string] = {}
    single = LruCache[int, string](1, single_values, [])
    single.put(1, "one")
    single.put(2, "two")
    assert(single.keys() == [2])
    assert(single.validate())

test "collection accessors cover populated and empty states":
    deque = Deque[int]([])
    match deque.pop():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot pop from an empty deque")
    match deque.peek():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot peek at an empty deque")
    match deque.peek_left():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot peek at an empty deque")
    deque.append(11)
    left = deque.peek_left()
    assert(left == 11)

    queue = Queue[int](Deque[int]([]))
    assert(queue.length() == 0)
    assert(queue.is_empty())
    queue.push(21)
    queue.push(22)
    assert(queue.length() == 2)
    assert(not queue.is_empty())
    queued = queue.peek()
    assert(queued == 21)

    stack = Stack[int]([])
    assert(stack.length() == 0)
    assert(stack.is_empty())
    match stack.pop():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot pop from an empty stack")
    match stack.peek():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot peek at an empty stack")
    stack.push(31)
    assert(stack.length() == 1)
    assert(not stack.is_empty())
    top = stack.peek()
    assert(top == 31)

    heap = MinHeap[int]([])
    heap.push(41)
    minimum = heap.peek()
    assert(minimum == 41)
    drained = heap.pop()
    assert(drained == 41)
    match heap.pop():
        ok _value:
            assert(false)
        failure error:
            assert(error.message == "cannot pop from an empty heap")

    ordered_counts: map[string, int] = {}
    counter = Counter[string](ordered_counts)
    counter.add("low")
    counter.add("high", 2)
    assert(counter.most_common()[0] == ("high", 2))

    empty_values: map[string, int] = {}
    cache = LruCache[string, int](2, empty_values, [])
    assert(cache.length() == 0)
    cache.put("present", 1)
    assert(cache.length() == 1)

test with profile "heap and deque remain bounded under sustained use" -> TestResult with
{
    defer time < 1s,
    defer memory < 16mb,
    defer allocations < 50000,
}:
    heap = MinHeap[int]([])
    deque = Deque[int]([])
    for value in range(0, 4096):
        heap.push(4096 - value)
        deque.append(value)
    assert(heap.length() == 4096)
    assert(deque.length() == 4096)
    for expected in range(1, 4097):
        value = heap.pop()
        assert(value == expected)
    for expected in range(0, 4096):
        value = deque.pop_left()
        assert(value == expected)
    assert(heap.is_empty())
    assert(deque.is_empty())

test with integ "generic collections compose through their public APIs":
    pending = Queue[int](Deque[int]([]))
    empty_values: map[int, string] = {}
    cache = LruCache[int, string](3, empty_values, [])
    for value in range(0, 10):
        pending.push(value)
    while not pending.is_empty():
        value = pending.pop()
        cache.put(value, "seen")
    assert(cache.keys() == [7, 8, 9])
