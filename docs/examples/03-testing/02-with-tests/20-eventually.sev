'''
`eventually` polls a condition without requiring every concurrency test to
hand-roll sleeping, deadlines, cancellation, and failure diagnostics.
'''


def eventually(condition: bool) -> bool:
    # The test-library implementation polls; this deterministic example is the
    # condition shape supplied to that helper.
    return condition


def eventually_value(value: f64) -> f64:
    return value


test with timeout(5s) "worker eventually becomes ready":
    worker_ready = true
    assert(eventually(worker_ready))


test "eventually can retain a useful final observation":
    result = eventually_value(2.00000001)
    assert(approximate(result, 2.0, atol=1e-7))
