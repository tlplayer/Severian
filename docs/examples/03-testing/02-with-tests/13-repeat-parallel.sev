'''
Repeat exposes intermittent races. Parallel marks tests that may execute at
the same time; the command-line runner can also choose a global worker count.

    sev test --parallel 16
'''
class Result:
    valid: bool = false

def concurrent_operation() -> Result:
    return Result(valid=true)


test with repeat(10) "concurrent operation remains valid":
    result = concurrent_operation()
    assert(result.valid)


test with repeat(10) and timeout(5s) "race search is bounded":
    result = concurrent_operation()
    assert(result.valid)


test with parallel "independent worker A":
    assert(concurrent_operation().valid)


test with parallel "independent worker B":
    assert(concurrent_operation().valid)
