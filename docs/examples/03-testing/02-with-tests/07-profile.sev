'''
Profile limits belong in the test contract block. Deferred contracts are
checked after the measured body has completed.
'''


def bounded_work(limit: int) -> int:
    total := 0
    for value in range(0, limit):
        total += value
    return total


test with profile "bounded work stays within its resource budget" with
{
    defer time < 1s,
    defer memory < 16mb,
    defer allocations < 50000,
}:
    assert(bounded_work(4096) == 8386560)
