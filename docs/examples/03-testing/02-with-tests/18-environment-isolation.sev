'''
Environment isolation is a scoped test-library resource. The original process
environment is restored even when an assertion or throw ends the test early.
'''


class TestEnvironment:
    home: string
    debug: string
    http_proxy: string
    https_proxy: string

    def get(name: string) -> string:
        if name == "HOME":
            return home
        if name == "DEBUG":
            return debug
        if name == "HTTP_PROXY":
            return http_proxy
        if name == "HTTPS_PROXY":
            return https_proxy
        return ""


test "environment overrides are local to one test":
    environment = TestEnvironment(
        home="/tmp/severian-test-home",
        debug="1",
        http_proxy="",
        https_proxy="",
    )

    assert(environment.home == "/tmp/severian-test-home")
    assert(environment.debug == "1")


test "environment can explicitly remove inherited values":
    environment = TestEnvironment(home="", debug="", http_proxy="", https_proxy="")

    assert(environment.http_proxy == "")
    assert(environment.https_proxy == "")
