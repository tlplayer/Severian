'''
Mocks replace behavior only inside the active test. One `mock(...)` call groups
one or more call-to-result cases and an optional fallback.
'''


def fetch_price(product: int) -> int:
    return 0


def total(product: int, quantity: int) -> int:
    price = fetch_price(product)
    return price * quantity


test "one-line mock maps one call to one result":
    mock(fetch_price(10) -> 25)

    assert(fetch_price(10) == 25)


test "multiline mock groups cases and failures":
    mock(
        fetch_price(10) -> 25,
        fetch_price(20) -> 50,
        else throw Error("unknown product")
    )

    assert(fetch_price(10) == 25)
    assert(fetch_price(20) == 50)
    throws(fetch_price(30) -> Error)


test "mock fallback handles unmatched calls":
    mock(
        fetch_price(10) -> 25,
        else 0
    )

    assert(fetch_price(10) == 25)
    assert(fetch_price(99) == 0)
