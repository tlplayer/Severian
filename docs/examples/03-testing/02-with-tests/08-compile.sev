def foo(x: int) -> int:
    return x + 1

test with compiler "checks accepted and rejected semantic fragments":
    # This fragment reaches semantic analysis and must be rejected.
    reject:
        foo("bar")

    # This fragment must be accepted.
    accept:
        value = foo(1)

test with compiler "rejects duplicate declarations":
    reject:
        value := 1
        value := 2
