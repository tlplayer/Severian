'''
Fuzz tests search arbitrary inputs and preserve failing inputs for replay.

The runner should report a seed, minimized input, and reproduction command.
'''


class ParseError:
    message: string


def parse_integer(value: string) -> int | ParseError:
    if value == "":
        throw ParseError("empty integer")
    return 0


test parse_integer with fuzz(input: string):
    # A multiline `when operation:` block can inspect either generated result.
    when parse_integer(input):
        when result is int:
            formatted = string(result)
            reparsed = parse_integer(formatted)

            assert(reparsed == result)

        when result is ParseError:
            assert(input == "")
            assert(result.message != "")


test bytes_do_not_crash with fuzz(data: bytes):
    # Compact operations use the same `operation(value -> expectation)` shape.
    when(parser.parse(data) -> assert(parser.remains_memory_safe))


test with fuzz(age: int { 0 <= age and age <= 130 }):
    user = User(age=age)
    assert(user.age == age)
