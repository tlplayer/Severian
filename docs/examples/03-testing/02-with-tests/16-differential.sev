'''
Differential tests execute equivalent code through multiple compiler
backends and compare the results.
'''


def compute(a: f32, b: f32) -> f32:
    return (a * b) + a


def compute_reference(a: f32, b: f32) -> f32:
    product = a * b
    return product + a


test compute with differential
{
    native,
    xla,
}:
    native_result := compute(3.5, 7.25)
    reference_result := compute_reference(3.5, 7.25)
    expect(approximate(native_result, reference_result, atol=1e-6, rtol=1e-5))
