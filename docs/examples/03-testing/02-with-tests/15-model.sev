'''
Model tests compare a real implementation against a simple reference model.

The runner generates operation sequences, reports the chosen operations, and
shrinks a failing sequence to the smallest reproducible state transition.
'''


test with model:
    actual := set[int]()
    expected := list[int]()

    when insert(value):
        actual.add(value)

        if value not in expected:
            expected.append(value)

    when remove(value):
        actual.remove(value)

        if value in expected:
            expected.remove(value)

    when clear():
        actual.clear()
        expected = []

        assert(size(actual) == 0)

    always:
        assert(size(actual) == size(expected))
        assert(actual.sorted() == expected.sorted())
