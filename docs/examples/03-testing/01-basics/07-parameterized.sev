'''
Parameterized tests execute one test body against independent cases.

Each case should be named in output and independently rerunnable.
'''


def add(a: int, b: int) -> int:
    return a + b


test add(a, b, expected) with cases
{
    (0, 0, 0),
    (1, 2, 3),
    (-1, 1, 0),
    (100, 200, 300),
}:
    expect(add(a, b) == expected)
