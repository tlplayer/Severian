import network


test with integ "UDP sockets":
    receiver = network.bind("127.0.0.1", 0)
    defer receiver.close()

    address = receiver.address()

    sender = network.udp_bind("127.0.0.1", 0)
    defer sender.close()

    assert(sender.send([1, 2, 3, 4], address.host, address.port) == 4)

    packet = receiver.receive(4)

    assert(packet.data == [1, 2, 3, 4])
