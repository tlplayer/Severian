import c from xxi


@c
class Point:
    x: f32
    y: f32


@c
class Rectangle:
    top_left: Point
    bottom_right: Point


test:
    assert(bytes[Point]() == 8B)
    assert(alignment[Point]() == 4B)

    assert(offset[Point]("x") == 0B)
    assert(offset[Point]("y") == 4B)

    assert(bytes[Rectangle]() == 16B)
