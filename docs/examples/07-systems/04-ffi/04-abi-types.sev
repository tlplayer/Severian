test:
    assert(bytes[i8]() == 1)
    assert(bytes[u8]() == 1)

    assert(bytes[i16]() == 2)
    assert(bytes[u16]() == 2)

    assert(bytes[i32]() == 4)
    assert(bytes[u32]() == 4)

    assert(bytes[i64]() == 8)
    assert(bytes[u64]() == 8)

    assert(bytes[f32]() == 4)
    assert(bytes[f64]() == 8)