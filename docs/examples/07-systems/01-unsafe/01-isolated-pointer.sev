def byte_at(bytes: list[u8], index: int) -> u8 | BoundsError:
    if index < 0 or index >= size(bytes):
        return failure(BoundsError(index))

    unsafe:
        ptr:*list[u8] = &bytes
        #You cannot do *ptr you must ptr[0] to keep symantics coherent
        return ptr[index]

test "in bounds":
    byte_at([65, 66, 67], 1):
    assert(byte == 66)

test "out of bounds":
    throws(byte_at([65], 4)):
        

def main():
    result ?= byte_at([65, 66, 67], 1)
    print(result)
