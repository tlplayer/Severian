import cli


def interface() -> cli.Command:
    return cli.command(
        "arguments",
        "Print each application argument",
        arguments=[
            cli.argument(
                "values",
                "Values to print",
                required=false,
                multiple=true,
            ),
        ],
    )


def main():
    application = interface()
    match cli.parse_process(application):
        case matches:
            for value in cli.values(matches, "values"):
                print(value)
        case error:
            print(cli.render_error(error))
