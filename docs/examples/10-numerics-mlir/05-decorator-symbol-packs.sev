import tensor
import probability

@probability(P)
def expectedProjection(weights: Tensor[f64], samples: Tensor[f64]) -> f32:
    projected = tensor.rankedMatmul(weights, samples)
    return P(tensor.rankedValues(projected)[0] > 0.5)

def main():
    weights = tensor.ranked([1.0], [1, 1])
    samples = tensor.ranked([1.0], [1, 1])

    print(expectedProjection(weights, samples))
