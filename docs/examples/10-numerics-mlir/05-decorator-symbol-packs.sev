import tensor
import probability

@probability(P)
def expected_projection(weights: Tensor[f64], samples: Tensor[f64]) -> f32:
    projected = tensor.ranked_matmul(weights, samples)
    return P(tensor.ranked_values(projected)[0] > 0.5)

def main():
    weights = tensor.ranked([1.0], [1, 1])
    samples = tensor.ranked([1.0], [1, 1])

    print(expected_projection(weights, samples))
