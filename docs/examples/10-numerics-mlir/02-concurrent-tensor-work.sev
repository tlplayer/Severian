import tensor

def worker(id: int) -> int:
    return id * 2

def main():
    first = async worker(10) with self
    second = async worker(20) with self

    a = await first
    b = await second

    x = tensor.ranked([1.0, 0.0, 0.0, 1.0], [2, 2])
    y = tensor.rankedMatmul(x, x)

    print(a + b)
    print(tensor.rankedShape(y))
