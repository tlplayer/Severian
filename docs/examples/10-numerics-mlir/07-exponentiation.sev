def square(value: float) -> float:
    return value ** 2

test "square":
    assert(square(3.0) == 9.0)

def square_root(value: float) -> float:
    return value ** .5

test "square root":
    assert(square_root(9.0) == 3.0)

def main():
    print(square(3.0))
    print(square_root(9.0))

test with integ "native exponentiation":
    main()
    assert("9" in stdout)
    assert("3" in stdout)
