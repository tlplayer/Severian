import tensor


@tensor(X)
def contract(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    return left X right


test:
    left = tensor(
        [1.0, 0.0,
         0.0, 1.0],
        [2, 2],
    )

    right = tensor(
        [2.0, 3.0,
         4.0, 5.0],
        [2, 2],
    )

    result = contract(left, right)

    assert(tensor.values(result) == [
        2.0, 3.0,
        4.0, 5.0,
    ])