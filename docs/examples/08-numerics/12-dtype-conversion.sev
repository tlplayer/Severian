import tensor


test "convert tensor dtype":
    original = tensor(
        [1.0, 2.0, 3.0, 4.0],
        [2, 2],
    )

    single = tensor.f32(original)

    assert(tensor.shape(single) == [2, 2])

    round_trip = tensor.f64(single)

    assert(tensor.values(round_trip) == [
        1.0, 2.0,
        3.0, 4.0,
    ])


test "bf16 storage can return to f64":
    original = tensor([1.0, 2.0], [2])

    compact = tensor.bf16(original)
    restored = tensor.f64(compact)

    assert(tensor.values(restored) == [1.0, 2.0])


test "every integer and floating tensor storage type executes a round trip":
    original = tensor([1.0, 2.0], [2])

    assert(tensor.values(tensor.f64(tensor.i8(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.i16(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.i32(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.i64(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.i128(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.u8(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.u16(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.u32(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.u64(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.u128(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.f8e4m3fn(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.f8e5m2(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.f16(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.bf16(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.f32(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.f64(original))) == [1.0, 2.0])
    assert(tensor.values(tensor.f64(tensor.f128(original))) == [1.0, 2.0])
