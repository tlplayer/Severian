import math


test "powers and logarithms":
    assert(pow(2.0, 3.0) == 8.0)
    assert(log(1.0) == 0.0)
    assert(log2(8.0) == 3.0)
    assert(log10(100.0) == 2.0)
    assert(approximate(ln(e), 1.0))


test "trigonometry":
    assert(math.sin(0.0) == 0.0)
    assert(math.cos(0.0) == 1.0)
    assert(math.tan(0.0) == 0.0)


test "rounding":
    assert(floor(-1.25) == -2)
    assert(ceil(-1.25) == -1)
    assert(round(1.23456, 3) == 1.235)


test "finite numbers":
    assert(isfinite(42.0))
    assert(not isnan(42.0))
