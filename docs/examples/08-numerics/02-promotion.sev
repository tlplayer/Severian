def main():
    count: i32 = 4
    ratio: f64 = 0.5

    value = float(count) + ratio

    print(value)


test "integer to float conversion can be explicit":
    count: i32 = 4
    ratio: f64 = 0.5

    assert(float(count) + ratio == 4.5)

test "mixed arithmetic promotes integer operands":
    count: i32 = 4
    ratio: f64 = 0.5

    assert(count + ratio == 4.5)
    assert(ratio + count == 4.5)
