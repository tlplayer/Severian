import tensor


test "construct tensor":
    value = tensor(
        [1.0, 2.0,
         3.0, 4.0],
        [2, 2],
    )

    assert(tensor.shape(value) == [2, 2])
    assert(tensor.values(value) == [
        1.0, 2.0,
        3.0, 4.0,
    ])


test "elementwise tensor operations":
    left = tensor([1.0, 2.0], [2])
    right = tensor([3.0, 4.0], [2])

    added = left + right
    multiplied = left * right

    assert(added.values == [4.0, 6.0])
    assert(multiplied.values == [3.0, 8.0])