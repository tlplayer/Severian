def read(value: view tensor[int]) -> int:
    return value[0]


def increment(value: borrow tensor[int]):
    value[0] += 1


test:
    values := tuple[int,3](1,2,3)

    assert(read(values) == 1)

    increment(values)

    assert(values[0] == 2)

test with compiler:
    values := tuple[int,3](1,2,3)

    first := borrow values

    reject:
        second := borrow values
        print(len(first))


test "read-only calls preserve caller values":
    values = tuple[int,3](1,2,3)
    assert(read(values) == 1)
    assert(read(values) == 1)
    assert(values[0] == 1)

test with compiler "view parameters cannot mutate their elements":
    reject:
        def invalid(value: view tensor[int]):
            value[0] = 9
