def read(value: borrow list[int]) -> int:
    return value[0]


def increment(value: borrow mut list[int]):
    value[0] += 1


test:
    values := [1, 2, 3]

    assert(read(borrow values) == 1)

    increment(borrow mut values)

    assert(values[0] == 2)

test with compiler:
    values := [1, 2, 3]

    first := borrow values

    reject:
        second := borrow mut values
        print(first.length())
