test:
    values := ["a", "b", "c"]
    value := "d"

    values.append(move value)
    moved := move values[0]
    borrowed := borrow values[1]
    copied := clone values[2]

    assert(moved == "a")
    assert(borrowed == "b")
    assert(copied == "c")

test with compiler:
    values := ["a", "b", "c"]

    first := borrow values

    reject:
        mutation := borrow mut values
        assert(first.length() == 3)
