from collections import list

test:
    values := ["a", "b", "c"]
    value := "d"

    values.append_owned(value)
    moved := move values[0]
    borrowed := view values[1]
    copied := copy values[2]

    assert(moved == "a")
    assert(borrowed == "b")
    assert(copied == "c")

test with compiler:
    values := ["a", "b", "c"]

    first := borrow values

    reject:
        mutation := borrow values
        assert(first.len() == 3)
