def inspect(value: borrow string):
    print(value)


def consume(value: move string):
    print(value)


test:
    name := "severian"

    inspect(borrow name)
    inspect(borrow name)

    copied := clone name
    assert(copied == "severian")

    consume(move name)


test with compiler:
    value := "severian"
    consume(move value)

    reject:
        print(value)