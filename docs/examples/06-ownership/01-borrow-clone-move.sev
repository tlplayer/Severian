def inspect(value: borrow string):
    print(value)


def consume(value: move string):
    print(value)


test:
    name := "severian"

    inspect(name)
    inspect(name)

    copied := copy name
    assert(copied == "severian")

    consume(name)


test with compiler:
    value := "severian"
    consume(value)

    reject:
        print(value)

test "copied string survives consuming its original":
    original = "owned"
    independent = copy original
    assert(not (independent is original))
    consume(original)
    assert(independent == "owned")

test with compiler "a consumed string cannot be copied":
    original = "owned"
    consume(original)
    reject:
        independent = copy original
