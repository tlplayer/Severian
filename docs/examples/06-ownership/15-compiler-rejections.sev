test with compiler:
    reject:
        value := "owned"
        consumed := move value
        print(value)

    reject:
        value := "shared"
        shared := borrow value
        exclusive := borrow mut value
        print(shared)

    reject:
        value := "exclusive"
        first := borrow mut value
        second := borrow mut value
        print(first)

    reject:
        def escaping_borrow() -> borrow string:
            local := "temporary"
            return borrow local

    reject:
        values := [1, 2, 3]
        view := borrow values
        mutation := borrow mut values
        assert(view.length() == 3)

    reject:
        value := "finished"
        drop(value)
        print(borrow value)

    reject:
        value := "task data"
        task := async print(borrow value) with self
        mutation := borrow mut value
        await task
