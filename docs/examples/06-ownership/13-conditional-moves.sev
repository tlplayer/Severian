from io import capture_stdout

def read_branch(condition: bool):
    value := "hello"
    if condition:
        print(value)
    else:
        print(value)
    print(value)

def consume_branch(condition: bool) -> int:
    value := "hello"
    if condition:
        consumed := move value
        return len(consumed)
    return len(value)

test with compiler:
    reject:
        value := "hello"
        condition := true

        if condition:
            consumed := move value

        print(value)

test with integ "both read-only branches preserve their owner":
    read_branch(true)
    read_branch(false)
    assert(capture_stdout() == "hello\nhello\nhello\nhello\n")

test "moving on a returning branch preserves the other path":
    assert(consume_branch(true) == 5)
    assert(consume_branch(false) == 5)

test with compiler "a possible move forbids a read after the merge":
    reject:
        def invalid(condition: bool):
            value := "hello"
            if condition:
                consumed := move value
            print(value)
