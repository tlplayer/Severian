class Server:
    host: string
    port: int


def server(host: string, port: int) -> Server:
    result := Server(host, port)
    return result


test:
    server := server("localhost", 8080)

    assert(server.host == "localhost")
    assert(server.port == 8080)

test "builders preserve independent records":
    first = server("localhost", 80)
    second = server("example", 443)
    first.port = 8080
    assert(second.port == 443)
    assert(first.host == "localhost")
