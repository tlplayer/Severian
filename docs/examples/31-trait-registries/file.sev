class FileType:
    name: string

trait File:
    @file
    property file_type: FileType
    property extensions: set[string]
    def read(path: string) -> string

class JsonFile: File:
    file_type = FileType("json")
    extensions = {".json"}

    def read(path: string) -> string:
        return path

class TextFile: File:
    file_type = FileType("text")
    extensions = {".txt"}

    def read(path: string) -> string:
        return path

class YamlFile: File:
    file_type = FileType("yaml")
    extensions = {".yaml", ".yml"}

    def read(path: string) -> string:
        return path

class LuaFile: File:
    file_type = FileType("lua")
    extensions = {".lua"}

    def read(path: string) -> string:
        return path

def main():
    print("File registry: JSON, text, YAML, Lua")
