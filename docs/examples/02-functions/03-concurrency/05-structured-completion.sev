GLOBAL := 0
def refresh_cache():
    GLOBAL += 1

def main():
    # Work owned by self may run concurrently, but main cannot finish until the
    # work completes. No task handle or manual await is needed for unit work.

    for i in range(5):
        async refresh_cache() with self and lock

    print("main continues")
    # Leaving main automatically waits for refresh_cache.

test with integ "Global should finalize at 5 by the end":
    main()
    print(GLOBAL)
    assert(GLOBAL == 5)
