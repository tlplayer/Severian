# channel[T,N] elements
def main():
    messages = channel[string,10]

    first = async messages.send("hello") with self
    second = async messages.send("hello") with self
    message = await messages
    print(message)
    message = messages.receive()

    print(message)


test with integ "both queued messages are received":
    main()
    assert(stdout == "hello\nhello\n")
