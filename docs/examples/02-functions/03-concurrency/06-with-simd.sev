import tensor


def simd_multiply(left: Tensor[f64], right: Tensor[f64]) -> Tensor[f64]:
    with self and simd:
        result = left * right
    return result


test "simd tensor placement uses the host vector component":
    left = tensor([1.0, 2.0, 3.0, 4.0], [4])
    right = tensor([2.0, 2.0, 2.0, 2.0], [4])
    result = simd_multiply(left, right)

    assert(result.values == [2.0, 4.0, 6.0, 8.0])
