from collections import list

class Counter:
    value: int

    def inc():
        value += 1

def count_all(values: list[int]) -> int:
    counter := Counter(0)

    for value in values:
        if value > 0:
            counter.inc()

    return counter.value

def main():
    task = async count_all([1, -2, 3]) with self
    print(await task)


test "task captures retain independent list storage":
    values = [1, -2, 3]
    task = async count_all(values)
    drop(values)
    assert(await task == 2)
