# Tags: concurrency, channel, queue, fan-in

test "two producers":
    messages = Channel[string](2)
    first = async messages.send("alpha") with self
    second = async messages.send("beta") with self
    left = await messages
    right = await messages
    received = [left, right].sorted()
    assert(received == ["alpha", "beta"])

test "integer channel":
    values = Channel[int](3)
    one = async values.send(3)
    two = async values.send(5)
    three = async values.send(8)
    assert(await values + await values + await values == 16)
    await one, two, three
