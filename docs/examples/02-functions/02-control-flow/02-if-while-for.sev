from util import Range

def main():
    while count < 3 with count = 0:
        print(count)
        count += 1

    for value in Range(0, 4):
        if value % 2 == 0:
            print("even")
        else:
            print("odd")

test with integ "control flow output":
    main()
    assert:
        "0" in stdout
        "1" in stdout
        "2" in stdout
        "even" in stdout
        "odd" in stdout
