from collections import list
def consume(items: list[i64]) -> i64 with
{
    defer items.len() <= 10,
}:
    total = i64(0)

    for item in items:
        total += item

    return total


def fill(buffer: borrow list[i64]) with
{
    defer buffer.len() <= 4,
}:
    buffer.append(1)
    buffer.append(2)
    buffer.append(3)
    buffer.append(4)

test:
    items: list[i64] = [1, 2, 3, 4]

    result = consume(items)

    assert(result == 10)
    assert(items.len() <= 10)
