def transfer(
    source: i64,
    destination: i64,
    amount: i64,
) -> (i64,i64) with
{
    amount > 0,
    amount <= source,
    defer source >= 0,
    defer source + destination == original_total,
}:
    original_total = source + destination

    source -= amount
    destination += amount

    return (source, destination)


test "transfer":
    balances = transfer(10,10,10)

    assert(balances[0] == 0)
    assert(balances[1] == 20)

test "transfer preserves the total across partial movement":
    balances = transfer(25, 7, 9)
    assert(balances[0] == 16)
    assert(balances[1] == 16)
    assert(balances[0] + balances[1] == 32)

test "transfer rejects zero amount":
    throws "prefix contract failed":
        balances = transfer(10, 10, 0)

test "transfer rejects an overdraft":
    throws "prefix contract failed":
        balances = transfer(10, 10, 11)
