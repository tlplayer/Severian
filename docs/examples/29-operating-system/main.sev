import kernel

def bootImageByte(image: list[u8], index: int) -> u8:
    assert(index >= 0 and index < size(image))
    unsafe:
        pointer = &image
        return pointer[index]

def bootLaboratory() -> kernel.KernelReport:
    init = kernel.Process(1, "init", "ready", 10, ["memory.map", "console.write", "fs.read", "fs.write"])
    shell = kernel.Process(2, "shell", "ready", 5, ["memory.map", "console.write", "fs.read"])
    disk = kernel.Process(3, "disk", "blocked", 50, ["fs.read", "fs.write"])
    processes = [init, shell, disk]

    owners = kernel.initialPageOwners(10, 2)
    initAllocation = kernel.allocatePages(owners, 2, init.id)
    assert(initAllocation.ok)
    shellAllocation = kernel.allocatePages(initAllocation.owners, 1, shell.id)
    assert(shellAllocation.ok)

    pageSize = kernel.pageSize()
    firstMap = kernel.mapPage([], shellAllocation.owners, init, pageSize, initAllocation.frames[0], true, false)
    assert(firstMap.ok)
    secondMap = kernel.mapPage(firstMap.mappings, shellAllocation.owners, shell, pageSize, shellAllocation.frames[0], false, true)
    assert(secondMap.ok)

    nodes = [kernel.FileNode("/etc/motd", "welcome to severian", 1, true, false), kernel.FileNode("/tmp/session", "", 1, true, true)]
    requests = [kernel.SyscallRequest(3, shell, "yield", ""), kernel.SyscallRequest(1, init, "fs.read", "/etc/motd"), kernel.SyscallRequest(4, disk, "console.write", "blocked"), kernel.SyscallRequest(2, shell, "console.write", "shell ready")]
    replies = kernel.runSyscalls(requests, nodes, 4)
    schedule = kernel.roundRobinSchedule(processes, 8)
    interrupts = [kernel.classifyInterrupt(32), kernel.classifyInterrupt(14), kernel.classifyInterrupt(33)]
    audit = kernel.auditKernel(shellAllocation.owners, secondMap.mappings, processes)
    return kernel.KernelReport(shellAllocation.owners, secondMap.mappings, schedule, replies, interrupts, audit)

test "boot composes memory mappings scheduling syscalls and interrupts":
    report = bootLaboratory()
    assert(report.pageOwners == [-1, -1, 1, 1, 2, 0, 0, 0, 0, 0])
    assert(size(report.mappings) == 2)
    assert(report.schedule == [1, 2, 1, 2, 1, 2, 1, 2])
    assert(report.interrupts == ["timer", "page-fault", "keyboard"])
    assert(report.audit == [])

test "concurrent syscall completion is sorted for deterministic replay":
    first = bootLaboratory().replies
    second = bootLaboratory().replies
    assert(first[0].id == 1 and first[0].value == "welcome to severian")
    assert(first[1].id == 2 and first[1].value == "shell ready")
    assert(first[2].id == 3 and first[2].value == "yielded")
    assert(not first[3].ok and first[3].value == "permission denied")
    assert(first[0].value == second[0].value)
    assert(first[3].value == second[3].value)

test "process teardown releases only its physical frames":
    report = bootLaboratory()
    released = kernel.releaseProcessPages(report.pageOwners, 1)
    assert(released == [-1, -1, 0, 0, 2, 0, 0, 0, 0, 0])

test "unsafe boot image inspection remains bounds guarded":
    assert(bootImageByte([83, 69, 86, 0], 0) == 83)
    assert(bootImageByte([83, 69, 86, 0], 2) == 86)

def main():
    report = bootLaboratory()
    print("kernel laboratory")
    print("pages", report.pageOwners)
    print("mappings", size(report.mappings))
    print("schedule", report.schedule)
    for reply in report.replies:
        print("syscall", reply.id, reply.processId, reply.ok, reply.value)
    print("interrupts", report.interrupts)
    print("audit", "clean" if size(report.audit) == 0 else "failed")
    print("boot byte", bootImageByte([83, 69, 86, 0], 0))
