from collections import deque

# deque[T]: add and remove elements at either end.
def main():
    jobs := deque[int]()
    jobs.push_back(20)
    jobs.push_back(30)
    jobs.push_front(10)
    if not (jobs.len() == 3):
        throw Error("deque invariant failed")

    first = jobs.pop_front()
    if not (first.has_value and first.value == 10):
        throw Error("deque invariant failed")
    last = jobs.pop_back()
    if not (last.has_value and last.value == 30):
        throw Error("deque invariant failed")
    print(jobs[0])  # 20

    jobs.clear()
    missing = jobs.pop_front()
    if not (not missing.has_value):
        throw Error("deque invariant failed")


test "deque preserves order across operations at both ends":
    values := deque[int]()
    values.push_back(20)
    values.push_front(10)
    values.push_back(30)
    first = values.pop_front()
    assert(first.has_value and first.value == 10)
    last = values.pop_back()
    assert(last.has_value and last.value == 30)
    assert(values.len() == 1 and values[0] == 20)

test "cleared deque reports absence at both ends":
    values := deque[int]()
    values.push_back(10)
    values.clear()
    missing = values.pop_front()
    assert(not missing.has_value)
    missing = values.pop_back()
    assert(not missing.has_value)

test "deque can hold a union of element types":
    values := deque[int | string]()
    values.push_back("ready")
    values.push_front(10)
    first = values.pop_front()
    assert(first.has_value and first.value == 10)
    last = values.pop_back()
    assert(last.has_value and last.value == "ready")
