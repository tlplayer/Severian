from collections import heap

# heap[T]: a priority queue that removes the smallest value first.
def main():
    priorities := heap[int]()
    priorities.push(30)
    priorities.push(10)
    priorities.push(20)

    next_priority = priorities.peek()
    if not (next_priority.has_value and next_priority.value == 10):
        throw Error("heap invariant failed")
    if not (priorities.len() == 3):
        throw Error("heap invariant failed")

    while priorities.len() > 0:
        priority = priorities.pop()
        if not (priority.has_value):
            throw Error("heap invariant failed")
        print(priority.value)  # 10, 20, 30 on successive lines.

    missing = priorities.pop()
    if not (not missing.has_value):
        throw Error("heap invariant failed")


test "heap pops in priority order and retains duplicates":
    values := heap[int]()
    values.push(30)
    values.push(10)
    values.push(20)
    values.push(10)
    for expected in [10, 10, 20, 30]:
        value = values.pop()
        assert(value.has_value and value.value == expected)
    missing = values.pop()
    assert(not missing.has_value)

test "heap peek leaves the minimum in place":
    values := heap[int]()
    values.push(20)
    values.push(10)
    value = values.peek()
    assert(value.has_value and value.value == 10)
    assert(values.len() == 2)
    value = values.pop()
    assert(value.has_value and value.value == 10)

test "heap infers ordered string elements":
    names := heap()
    names.push("grace")
    names.push("ada")
    first = names.pop()
    assert(first.has_value and first.value == "ada")
    second = names.pop()
    assert(second.has_value and second.value == "grace")

test with compiler "empty heap inference rejects conflicting element types":
    reject "conflicting":
        values = heap()
        values.push("text")
        values.push(42)
