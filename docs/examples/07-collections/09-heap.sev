# heap[T]: a priority queue that removes the smallest value first.
def main():
    priorities := heap()
    priorities.push(30)
    priorities.push(10)
    priorities.push(20)

    next_priority, found := priorities.peek()
    assert(found and next_priority == 10)
    assert(priorities.len() == 3)  # Peeking does not remove the value.

    while priorities.len() > 0:
        priority, found := priorities.pop()
        assert(found)
        print(priority)  # 10, 20, 30 on successive lines.

    _, found := priorities.pop()
    assert(not found)

test "heap pops in priority order and retains duplicates":
    values := heap()
    values.push(30)
    values.push(10)
    values.push(20)
    values.push(10)
    for expected in [10, 10, 20, 30]:
        value, found := values.pop()
        assert(found and value == expected)
    _, found := values.pop()
    assert(not found)

test "heap peek leaves the minimum in place":
    values := heap()
    values.push(20)
    values.push(10)
    value, found := values.peek()
    assert(found and value == 10)
    assert(values.len() == 2)
    value, found = values.pop()
    assert(found and value == 10)

test "heap infers ordered string elements":
    names := heap()
    names.push("grace")
    names.push("ada")
    first, found := names.pop()
    assert(found and first == "ada")
    second, found := names.pop()
    assert(found and second == "grace")
