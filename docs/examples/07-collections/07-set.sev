from collections import set

# set[T]: unique values, ordered by default.
def main():
    levels := {30, 10, 20, 10}
    if not (levels.len() == 3):
        throw Error("set invariant failed")
    if not (levels.contains(20)):
        throw Error("set invariant failed")

    inserted = levels.add(20)
    if not (not inserted):
        throw Error("set invariant failed")
    inserted = levels.add(40)
    if not (inserted):
        throw Error("set invariant failed")

    found = levels.remove(30)
    if not (found):
        throw Error("set invariant failed")
    if not (not levels.contains(30)):
        throw Error("set invariant failed")
    for level in levels.iter():
        print(level)  # 10, 20, 40 on successive lines.


test "set ignores duplicates and reports removal":
    values := {30, 10, 20, 10}
    assert(values.len() == 3)
    inserted = values.add(20)
    assert(not inserted and values.len() == 3)
    found = values.remove(20)
    assert(found and not values.contains(20))
    found = values.remove(20)
    assert(not found)

test "set iterates unique values in ascending order":
    values := {30, 10, 20, 10}
    expected = 10
    for value in values.iter():
        assert(value == expected)
        expected += 10
    assert(expected == 40)

test "set infers string elements and removes duplicates":
    names := {"ada", "grace", "ada"}
    assert(names.len() == 2)
    assert(names.contains("ada"))
    assert(names.contains("grace"))
    assert(not names.contains("katherine"))
