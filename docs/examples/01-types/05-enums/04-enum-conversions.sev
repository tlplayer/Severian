enum TypeSymbols:
    Add {"+", "+="}
    Sub {"-", "-="}
    # Multiple types can funnel to one canonical enum variant.
    Mult {"*", "*=", 0}


test "Converting symbols to enums":
    operations = ["+", "-", "*=", "*"]

    for operation in operations:
        symbol = TypeSymbols(operation)

    assert(TypeSymbols("+") == TypeSymbols.Add)
    assert(TypeSymbols("+=") == TypeSymbols.Add)
    assert(TypeSymbols("-=") == TypeSymbols.Sub)
    assert(TypeSymbols("*=") == TypeSymbols.Mult)
    assert(TypeSymbols(0) == TypeSymbols.Mult)

    throws(TypeSymbols("/") -> Error)

test with compiler "Enums cannot share the same symbol":
    reject:
        enum Fake:
            A {"+"}
            B {"+"}
