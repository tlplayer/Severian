enum TypeSymbols:
    Add {"+", "+="}
    Sub {"-", "-"}
    #Multiple types are allowed but they funnel to one enum, error if there is a conflict in symbol funneling 
    Mult {"*", "*=",0}


test "Conveting symbols to enums":
    operations = ["+","-","*=","*",0]

    for operation in operations:
        TypeSymbol = TypeSymbols(operation)

    throws(TypeSymbols("/") -> Error)

test with compiler "Enums cannot share the same symbol":
    reject:
        enum Fake:
            A {"+"}
            B {"+"}

