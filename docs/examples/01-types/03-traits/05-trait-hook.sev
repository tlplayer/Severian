'''
Compiler-defined hocase context.
The important semantic distinction is:

@monitor_time
@monitor_error
search()

executes as nested hooks:

monitor_time.with
    monitor_error.with
        search
    monitor_error.without
monitor_time.without


For a successful call:

context.result   = 10
context.error    = None
context.duration = ...

For a throw:

context.result   = None
context.error    = Error(...)
context.duration = ...

Then the error continues propagating after all without hooks have run.

For panic, no such guarantee:

with hooks
    function
    PANIC


# without hooks are not guaranteed
def ... with context declares a hocase implementation.
Such a function may contain with context: and without context: phases.
with executes before the decorated function.
without executes on return or throw.
without does not execute reliably on panic.
Multiple hooks enter top-to-bottom and exit bottom-to-top.
context.result and context.error are unavailable/None during with.
context.duration becomes final before without begins.

The last point makes this much more than decorators. It is compiler-supported structured interception with guaranteed error unwinding.
'''
#Context is a core trait property which houses information for hooks, tests etc.
class HookContext: Context
    function: string
    args: tuple
    result: int | None
    error: string | None
    duration: duration


trait Monitor:
    # Namespace / composed hook.
    @monitor

    # Individual hooks.
    @monitor_error
    def monitor_error(context: HookContext) -> None with context

    @monitor_time
    def monitor_time(context: HookContext) -> None with context


class Metric: Monitor
    def monitor_error(context: HookContext) -> None with context:
        with context:
            print("start:", context.function)

        without context:
            if context.error:
                print("error:", context.error)


    def monitor_time(context: HookContext) -> None with context:
        with context:
            print("timer start:", context.function)

        without context:
            print("timer duration:", context.duration)


# Hooks compose top to bottom.
@monitor_time
@monitor_error
def search(items: list[int], item: int) -> int:
    for i in items:
        print(i)
        if i == item:
            return item

    throw Error("Failed to find item in items")
# Includes all hooks by default
@monitor
def composed_hook():
    print("doing stuff")

# Includes specific hooks, in order of args
@monitor(monitor_error)
def isolated_hook():
    print("doing stuff while monitoring error")

def main():
    items = [10, 20, 30]
    result = search(items, 10)
    print(result)


test with integ:
    result = search([10, 20, 30], 10)
    print(("tuple:", result))
    assert(result == 10)
    assert("timer start: search" in stdout)
    assert("timer duration: " in stdout)
    assert("(tuple:,10)" in stdout)

test with integ:
    result = composed_hook()
    assert("start: composed_hook" in stdout)
    assert("timer start: composed_hook" in stdout)
    assert("doing stuff" in stdout)
    assert("timer duration: " in stdout)

test with integ:
    isolated_hook()
    assert("start: isolated_hook" in stdout)
    assert("timer start:" not in stdout)
    assert("doing stuff while monitoring error" in stdout)
    assert("timer duration: " not in stdout)

test:
    result = search([10, 20, 30], 30)
    assert(result == 30)
