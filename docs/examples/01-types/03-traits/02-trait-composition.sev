trait Named:
    def name() -> string

trait Drawable:
    Named
    def draw()

trait Color:
    shade: string

    def paint()

class Button: Drawable + Color
    label: string
    shade: string
    def name() -> string:
        return label

    def draw():
        print(label)

    def paint():
        print(shade)

def render(item: Drawable):
    print(item.name())
    item.draw()

def main():
    button = Button("Save","mauve")
    render(button)

test:
    main()