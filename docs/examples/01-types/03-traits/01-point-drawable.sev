trait Drawable:
    def draw() -> float

class Point: Drawable
    x: float
    y: float

    def magnitude() -> float:
        return (x*x + y*y) ** .5

    def draw():
        print("point", x, y)

def main():
    p = Point(3.0, 4.0)
    p.draw()
    print(p.magnitude())


test with integ:
    main()
    p = Point(2.0,1.0)
    assert((2**2+1**2)**.5 == p.magnitude())
