def parse_count(text: string) -> Result[int, ParseError]:
    if text == "":
        return failure(ParseError("empty count"))

    value = int.parse(text)
    return value

test "valid count":
    match parse_count("42"):
        ok count:
            assert(count == 42)

        failure error:
            assert(false, error)

test "empty count":
    match parse_count(""):
        ok _:
            assert(false, "expected failure")

        failure reason:
            assert(reason.message == "empty count")

def main():
    result ?= parse_count("42")

    match result:
        ok count:
            print(count)

        failure reason:
            print(reason)
