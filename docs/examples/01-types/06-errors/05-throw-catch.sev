class InvalidValue: Error:
    value: int

    def InvalidValue(input: int):
        value := input


def validate(value: int) -> int | InvalidValue:
    if value < 0:
        throw InvalidValue(value)

    return value


def recover(value: int) -> int:
    try:
        return validate(value)
    catch error: InvalidValue:
        return 0


test "catch handles an error":
    assert(recover(-10) == 0)
    assert(recover(10) == 10)


def log_and_rethrow(value: int) -> int | InvalidValue:
    try:
        return validate(value)
    catch InvalidValue error:
        print("invalid:", error.value)
        throw error


test "rethrow preserves the error":
    result ?= log_and_rethrow(-10)

    assert(result is InvalidValue)
    assert(result.value == -10)
