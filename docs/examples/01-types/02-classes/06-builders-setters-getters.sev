# Builders and updates share validation. Mocks replace test-local calls.
def restricted_account() -> bool:
    return false

class User:
    name: string = "pending" {len(name) == 0 -> Error("name cannot be empty"),}
    age: int = 0 {age < 0 -> Error("age cannot be negative"), age > 130 -> Error("invalid age"), age < 18 and restricted_account() -> Error("restricted accounts require an adult"),}

def runtime_int(value: int) -> int:
    return value

def foo(value: int) -> int:
    return value

def calculate(value: int) -> int:
    return foo(value) * 2

test "chained construction and validated update":
    user = (
        User()
            .set("name","Alice")
            .set("age",36)
    )
    assert(user.name == "Alice" and user.age == 36)
    assert(user.get("name") == "Alice")
    assert(user.get("age") == 36)
    user.set("age",40)
    assert(user.age == 40)

test "invalid age preserves the original value":
    user = User("Alice",36)
    age = runtime_int(-1)
    throws "ConstraintError":
        user.set("age",age)
    assert(user.age == 36)
    age = runtime_int(200)
    throws "ConstraintError":
        user.set("age",age)
    assert(user.age == 36)

test "group validation is atomic across string and integer storage":
    user = User("Alice",36)
    age = runtime_int(200)
    throws "ConstraintError":
        user.set({"name":"Bob","age":age})
    assert(user.name == "Alice" and user.age == 36)

test "mock affects direct and transitive calls":
    mock(foo(0) -> 10, else throw Error("unexpected foo argument"))
    assert(foo(0) == 10)
    assert(calculate(0) == 20)
    throws "unexpected foo argument":
        result = calculate(1)

test "mock supports multiple exact invocations":
    mock(foo(0) -> 10, foo(1) -> 20, foo(2) -> 30,
         else throw Error("unexpected foo argument"))
    assert(calculate(0) == 20)
    assert(calculate(1) == 40)
    assert(calculate(2) == 60)

test "mock does not leak into another test":
    assert(calculate(2) == 4)

test "mocked constraint dependency rejects underage updates atomically":
    mock(restricted_account() -> true)
    user = User("Alice",36)
    throws "ConstraintError":
        user.set("age",runtime_int(16))
    assert(user.age == 36)

test "mocked constraint dependency accepts the same age":
    mock(restricted_account() -> false)
    user = User("Alice",36)
    user.set("age",runtime_int(16))
    assert(user.age == 16)

test with compiler "builder names and value types are checked":
    reject:
        user = User()
        user.get("does_not_exist")
    reject:
        user = User()
        user.set("does_not_exist",10)
    reject:
        user = User()
        user.set("age","thirty six")

test "production constraint dependency is unchanged after mocks":
    user = User("Alice",16)
    assert(user.age == 16)
