class Counter:
    #readable and not writable externally
    _value: int
    #Not readable and not writable externally
    __secret: int

    def Counter():
        _value := 0
        __secret := 42

    def inc():
        _value += 1


test:
    counter := Counter()
    counter.inc()

    # Read-only externally.
    assert(counter._value == 1)


test with compiler:
    counter := Counter()

    reject:
        counter._value += 1

    reject:
        counter.__secret

    reject:
        counter.__secret = 10