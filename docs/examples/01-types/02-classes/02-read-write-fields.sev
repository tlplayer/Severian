class Counter:
    # External: read yes, write no.
    _value: int

    # External: read no, write no.
    __secret: int

    def Counter():
        _value := 0
        __secret := 42

    def inc():
        _value += 1

    # Class-private behavior.
    def __reset():
        _value = 0
        __secret = 42

    def reset():
        __reset()


test:
    counter := Counter()
    counter.inc()

    assert(counter._value == 1)
    counter.reset()
    assert(counter._value == 0)


test with compiler:
    counter := Counter()

    reject:
        counter._value += 1

    reject:
        counter.__secret

    reject:
        counter.__secret = 10

    reject:
        counter.__reset()