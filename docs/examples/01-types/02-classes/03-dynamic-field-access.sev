'''
To avoid having getX() setX() etc. which is a big reason for camelcases existence imo,
we have the set, and get properties on objects. This allows Point.set("x",0)
'''
class Point:
    x: int
    y: int

def main():
    point := Point(3, 4)
    axis = "x"

    print(point.get(axis))
    point.set(axis, 10)
    print(point.x)
    point.y = 20
    print(point.y)

