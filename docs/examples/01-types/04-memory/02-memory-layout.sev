class Header:
    kind: u8
    flags: u8
    length: u32

test:
    assert:
        bytes[u8]() == 1B
        bytes[u32]() == 4B
        alignment[u8]() == 1B
        alignment[u32]() == 4B

    # Equivalent calls
    print(bytes[Header]())
    print(bytes(Header))
    print(alignment[Header]())
    print(alignment(Header))
