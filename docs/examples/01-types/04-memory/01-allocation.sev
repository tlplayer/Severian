class Point:
    x: int
    y: int


test "managed memory allocation":
    point := Point(10, 20)

    assert(point.x == 10)
    assert(point.y == 20)

test "raw memory allocation":
    unsafe:
        memory := allocate[int](4)

        memory[0] = 10
        memory[1] = 20
        memory[2] = 30
        memory[3] = 40

        assert(memory[2] == 30)

        free(memory)

test with compiler "compiler rejects raw allocation from safe code":
    reject:
        memory := allocate[int](4)

test "raw allocation by byte quantity":
    unsafe:
        memory = allocate(7B)
        memory[0B] = u8(65)
        memory[6B] = u8(90)
        assert(memory[0] == u8(65))
        assert(memory[6] == u8(90))
        free(memory)

test with compiler "byte allocation also requires unsafe":
    reject:
        memory = allocate(7B)
