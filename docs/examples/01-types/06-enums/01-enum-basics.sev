enum Color:

    # Simple key in the enum value defaults to absent meaning it is not supplied
    Blue

    # Specify the values that can exist to populate the enum
    Green {3}

    # Multiple values for the same enum need a default value representation
    Red {1, 2} = 2

    # Mixed type values
    Purple {"purple"}

def name(color: Color) -> string | int:
    match color:
        case Red:
            return Red.key

        case Green:
            return Green.value

        case Blue:
            return Blue.key

        case Purple:
            return Purple.value

test "Getting enum keys and values":
    assert:
        name(Red) == "Red"
        name(Green) == 3
        name(Purple) == "purple"
        name(Blue) == "Blue"
        Blue.value is absent

test "variant default is selected from its allowed value set":
    assert(Red.value == 2)
