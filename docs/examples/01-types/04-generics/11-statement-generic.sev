# S - Statement
# Execute a sequence of statements against compiler state.

trait StatementTerm:
    def execute(state: i64) -> i64


class AffineStatement: StatementTerm
    scale: i64
    bias: i64

    def execute(state: i64) -> i64:
        return state * scale + bias


def execute_statements[S: StatementTerm](statements: list[S], initial: i64) -> i64:
    state := initial

    for statement in statements:
        state = statement.execute(state)

    return state


test:
    statements := [AffineStatement(2, 1), AffineStatement(3, -1)]
    result := execute_statements(statements, 2)

    assert(result == 14)
