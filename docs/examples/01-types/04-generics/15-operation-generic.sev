# O - Operation
# O carries executable semantics. Y carries only the resolved symbol identity.

trait OperationTerm:
    def apply(left: i64, right: i64) -> i64


class AddOperation: OperationTerm
    def apply(left: i64, right: i64) -> i64:
        return left + right


class MultiplyOperation: OperationTerm
    def apply(left: i64, right: i64) -> i64:
        return left * right


def apply_operation[O: OperationTerm](left: i64, right: i64, operation: O) -> i64:
    return operation.apply(left, right)


test:
    assert(apply_operation(19, 23, AddOperation()) == 42)
    assert(apply_operation(6, 7, MultiplyOperation()) == 42)
