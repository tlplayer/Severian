# A - Argument
# Lower a method call by prepending its receiver while preserving argument type.

trait ArgumentTerm:
    def value_id() -> u64


class CallArgument: ArgumentTerm
    id: u64

    def value_id() -> u64:
        return id


def prepend_receiver[A: ArgumentTerm](receiver: A, arguments: list[A]) -> list[A]:
    lowered: list[A] = []
    lowered.append(receiver)

    for argument in arguments:
        lowered.append(argument)

    return lowered


test:
    receiver := CallArgument(10)
    arguments := [CallArgument(20), CallArgument(30)]
    lowered := prepend_receiver(receiver, arguments)

    assert(size(lowered) == 3)
    assert(lowered[0].value_id() == 10)
    assert(lowered[1].value_id() == 20)
    assert(lowered[2].value_id() == 30)
