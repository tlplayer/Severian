# X - Any compiler term
# X is the umbrella parameter used by passes shared across compiler categories.

trait CompilerTerm:
    def apply_pass(revision: u64) -> Self


class TypeCompilerTerm: CompilerTerm
    revision: u64
    normalized: bool

    def apply_pass(revision: u64) -> Self:
        return TypeCompilerTerm(revision, true)


class ExpressionCompilerTerm: CompilerTerm
    revision: u64
    left: i64
    right: i64
    value: i64

    def apply_pass(revision: u64) -> Self:
        return ExpressionCompilerTerm(revision, left, right, left + right)


class StatementCompilerTerm: CompilerTerm
    revision: u64
    reachable: bool

    def apply_pass(revision: u64) -> Self:
        return StatementCompilerTerm(revision, true)


def run_pass[X: CompilerTerm](term: X, revision: u64) -> X:
    return term.apply_pass(revision)


test:
    type_term := run_pass(TypeCompilerTerm(0, false), 1)
    expression_term := run_pass(ExpressionCompilerTerm(0, 19, 23, 0), 2)
    statement_term := run_pass(StatementCompilerTerm(0, false), 3)

    assert(type_term.revision == 1)
    assert(type_term.normalized == true)
    assert(expression_term.revision == 2)
    assert(expression_term.value == 42)
    assert(statement_term.revision == 3)
    assert(statement_term.reachable == true)
