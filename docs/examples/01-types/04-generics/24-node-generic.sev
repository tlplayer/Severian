# N - Node
# Traverse nodes without assuming a particular AST, HIR, MIR, or LIR node type.

trait NodeTerm:
    def parent_id() -> u64


class SyntaxNode: NodeTerm
    id: u64
    parent: u64

    def parent_id() -> u64:
        return parent


def root_nodes[N: NodeTerm](nodes: list[N]) -> list[N]:
    roots: list[N] = []

    for node in nodes:
        if node.parent_id() == 0:
            roots.append(node)

    return roots


test:
    nodes := [SyntaxNode(1, 0), SyntaxNode(2, 1), SyntaxNode(3, 1), SyntaxNode(4, 0)]
    roots := root_nodes(nodes)

    assert(size(roots) == 2)
    assert(roots[0].id == 1)
    assert(roots[1].id == 4)
