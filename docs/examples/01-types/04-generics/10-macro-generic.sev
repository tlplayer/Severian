# M - Macro
# Expand compiler input through the concrete macro implementation.

trait MacroTerm:
    def expand(input_tokens: list[i64]) -> list[i64]


class RepeatMacro: MacroTerm
    repetitions: usize

    def expand(input_tokens: list[i64]) -> list[i64]:
        output: list[i64] = []
        remaining := repetitions

        while remaining > 0:
            for token in input_tokens:
                output.append(token)

            remaining -= 1

        return output


def expand_macro[M: MacroTerm](macro: M, input_tokens: list[i64]) -> list[i64]:
    return macro.expand(input_tokens)


test:
    expanded := expand_macro(RepeatMacro(3), [4, 2])

    assert(size(expanded) == 6)
    assert(expanded[0] == 4)
    assert(expanded[1] == 2)
    assert(expanded[4] == 4)
    assert(expanded[5] == 2)
