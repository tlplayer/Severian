# P - Pattern
# Select the first matching pattern instead of exposing pattern metadata.

trait PatternTerm:
    def matches(value: i64) -> bool


class RangePattern: PatternTerm
    minimum: i64
    maximum: i64

    def matches(value: i64) -> bool:
        return minimum <= value and value <= maximum


def select_pattern[P: PatternTerm](patterns: list[P], value: i64) -> i64:
    for pattern in patterns with index := 0:
        if pattern.matches(value):
            return index

        index += 1

    return -1


test:
    patterns := [RangePattern(0, 9), RangePattern(10, 19), RangePattern(20, 29)]

    assert(select_pattern(patterns, 17) == 1)
    assert(select_pattern(patterns, 42) == -1)
