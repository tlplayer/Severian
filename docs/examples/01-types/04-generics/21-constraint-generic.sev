# C - Constraint
# Evaluate every semantic constraint against the same candidate value.

trait ConstraintTerm:
    def accepts(value: i64) -> bool


class RangeConstraint: ConstraintTerm
    minimum: i64
    maximum: i64

    def accepts(value: i64) -> bool:
        return minimum <= value and value <= maximum


def satisfies_all[C: ConstraintTerm](constraints: list[C], value: i64) -> bool:
    for constraint in constraints:
        if constraint.accepts(value) == false:
            return false

    return true


test:
    constraints := [RangeConstraint(0, 100), RangeConstraint(4, 9)]

    assert(satisfies_all(constraints, 7) == true)
    assert(satisfies_all(constraints, 12) == false)
