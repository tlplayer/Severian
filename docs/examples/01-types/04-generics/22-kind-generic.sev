# K - Kind
# Select the wider compiler kind while preserving its concrete kind type.

trait KindTerm:
    def width() -> usize


class IntegerKind: KindTerm
    bits: usize
    signed: bool

    def width() -> usize:
        return bits


def wider_kind[K: KindTerm](left: K, right: K) -> K:
    if left.width() >= right.width():
        return left

    return right


test:
    narrow := IntegerKind(16, true)
    wide := IntegerKind(64, true)
    selected := wider_kind(narrow, wide)

    assert(selected.bits == 64)
    assert(selected.signed == true)
