# D - Declaration
# Bind declarations to resolved symbol identifiers.

trait DeclarationTerm:
    def bind(symbol_id: u64) -> Self


class LocalDeclaration: DeclarationTerm
    symbol_id: u64
    slots: usize

    def bind(symbol_id: u64) -> Self:
        return LocalDeclaration(symbol_id, slots)


def bind_declarations[D: DeclarationTerm](declarations: list[D], first_symbol: u64) -> list[D]:
    bound: list[D] = []
    next_symbol := first_symbol

    for declaration in declarations:
        bound.append(declaration.bind(next_symbol))
        next_symbol += 1

    return bound


test:
    declarations := [LocalDeclaration(0, 1), LocalDeclaration(0, 3)]
    bound := bind_declarations(declarations, 100)

    assert(bound[0].symbol_id == 100)
    assert(bound[1].symbol_id == 101)
    assert(bound[1].slots == 3)
