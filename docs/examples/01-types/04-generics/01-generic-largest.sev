trait Ordered:
    less_than(other: Self) -> bool

    
def largest[T: Ordered](values: list[T]) -> Option[T]:
    if size(values) == 0:
        return absent

    best := values[0]

    for value in values:
        if best < value:
            best = value

    return present(best)

test:
    match largest([3, 9, 2]):
        case value:
            assert(value == 9)

        case absent:
            assert(false, "expected largest value")

def main():
    result = largest([3, 9, 2])
    print(result)
