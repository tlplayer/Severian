# L - Literal
# Constant-fold literals while retaining the concrete literal representation.

trait LiteralTerm:
    def zero() -> Self
    def add(other: Self) -> Self


class IntegerLiteral: LiteralTerm
    value: i64

    def zero() -> Self:
        return IntegerLiteral(0)

    def add(other: Self) -> Self:
        return IntegerLiteral(value + other.value)


def fold_literals[L: LiteralTerm](literals: list[L]) -> L:
    result := L.zero()

    for literal in literals:
        result = result.add(literal)

    return result


test:
    literals := [IntegerLiteral(7), IntegerLiteral(11), IntegerLiteral(24)]
    folded := fold_literals(literals)

    assert(folded.value == 42)
