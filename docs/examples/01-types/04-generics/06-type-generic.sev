# T - Type
# Substitute one compiler type while preserving the concrete type representation.

trait TypeTerm:
    def same_type(other: Self) -> bool


class TypeReference: TypeTerm
    id: u64
    is_parameter: bool

    def same_type(other: Self) -> bool:
        return id == other.id


def substitute_type[T: TypeTerm](subject: T, parameter: T, replacement: T) -> T:
    return replacement if subject.same_type(parameter) else subject


test:
    parameter := TypeReference(1, true)
    integer := TypeReference(2, false)
    floating := TypeReference(3, false)

    substituted := substitute_type(parameter, parameter, integer)
    unchanged := substitute_type(integer, parameter, floating)

    assert(substituted.id == 2)
    assert(substituted.is_parameter == false)
    assert(unchanged.id == 2)
