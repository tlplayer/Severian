# F - Callable
# Invoke a concrete callable through a generic callable parameter.

trait CallableTerm:
    def call(value: i64) -> i64


class AffineCallable: CallableTerm
    scale: i64
    bias: i64

    def call(value: i64) -> i64:
        return value * scale + bias


def invoke_twice[F: CallableTerm](callable: F, value: i64) -> i64:
    return callable.call(callable.call(value))


test:
    callable := AffineCallable(2, 1)

    assert(invoke_twice(callable, 3) == 15)
