# Lx - Lexeme: matched source text and span. L remains Literal.
# Classification into a token is a separate step.

class Span:
    start: int
    end: int


trait LexemeTerm:
    property text: string
    property span: Span


class SourceLexeme: LexemeTerm
    text: string
    span: Span


def span_contains(span: Span, offset: int) -> bool:
    return span.start <= offset and offset < span.end


def contains[Lx: LexemeTerm](lexeme: Lx, offset: int) -> bool:
    return span_contains(lexeme.span, offset)


test:
    lexeme = SourceLexeme("1_024", Span(7, 12))
    assert(contains(lexeme, 7))
    assert(contains(lexeme, 11))
    assert(not contains(lexeme, 12))
    assert(lexeme.text == "1_024")
