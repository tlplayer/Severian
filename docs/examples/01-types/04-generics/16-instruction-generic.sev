# I - Instruction
# Remove no-op instructions, then execute the optimized instruction stream.

trait InstructionTerm:
    def is_noop() -> bool
    def execute(register: i64) -> i64


class AddImmediate: InstructionTerm
    amount: i64

    def is_noop() -> bool:
        return amount == 0

    def execute(register: i64) -> i64:
        return register + amount


def remove_noops[I: InstructionTerm](instructions: list[I]) -> list[I]:
    optimized: list[I] = []

    for instruction in instructions:
        if instruction.is_noop() == false:
            optimized.append(instruction)

    return optimized


def execute_instructions[I: InstructionTerm](instructions: list[I], initial: i64) -> i64:
    register := initial

    for instruction in instructions:
        register = instruction.execute(register)

    return register


test:
    instructions := [AddImmediate(0), AddImmediate(2), AddImmediate(0), AddImmediate(5)]
    optimized := remove_noops(instructions)

    assert(size(optimized) == 2)
    assert(execute_instructions(optimized, 35) == 42)
