import collections


# An ordinary generic class selects another generic class as its storage.
# Slot is a one-value provider used to illustrate the contract.
trait SingleValue[T]: collections.C[int,T]

class Slot[T]: SingleValue[T]
    value: T

    def len(self: view Self) -> int:
        return 1

    def get(self: view Self, index: int) -> T:
        if index != 0:
            throw Error("slot index must be zero")
        return copy value

    def keys(self: view Self) -> collections.list[int]:
        return [0]

    def values(self: view Self) -> collections.list[T]:
        return [value]

    def items(self: view Self) -> collections.list[tuple[int,T]]:
        result = collections.list[tuple[int,T]]()
        result.append(tuple[int,T](0,value))
        return result

    grammar indexed[self, "[", index: int, "]"]() -> T:
        return self.get(index)

    grammar iterate["iterator", "(", self, ")"]() -> iterator[T]:
        yield self.get(0)

class Collection[T, C:collections.C[int,T]]:
    storage: C[T]
    def Collection(value: T):
        storage = C[T](value)
    def get() -> T:
        return storage.get(0)

Collection[T:Element, C:Backend] as Stored[Element, Backend]

def main():
    number = Collection[T:int, C:Slot](42)
    text = Collection[C:Slot, T:string]("typed")
    print(number.get())
    print(text.get())

test "named container bindings preserve input and output types":
    number = Stored[Backend:Slot, Element:int](42)
    text = Stored[Element:string, Backend:Slot]("owned")
    assert(number.get() == 42)
    assert(text.get() == "owned")


test "provider results own their string after the collection is dropped":
    collection = Collection[T:string, C:Slot]("retained")
    result = collection.get()
    drop(collection)
    assert(result == "retained")

test "a one-slot provider uses the common container utilities":
    slot = Slot[int](42)
    assert(collections.sum(slot) == 42)
    pairs: collections.list[(int,int)] = collections.enumerate(slot)
    assert(pairs.get(0)[0] == 0 and pairs.get(0)[1] == 42)

test with compiler "providers must satisfy the complete container contract":
    reject "missing":
        class Incomplete[T]: collections.C[int,T]
            value: T
        collection = Collection[T:int,C:Incomplete](42)
