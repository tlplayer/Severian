# M - Macro
# Expand compiler input through the concrete macro implementation.

trait MacroTerm:
    def expand(input_tokens: list[i64]) -> list[i64]


class RepeatMacro: MacroTerm
    repetitions: usize

    def expand(input_tokens: list[i64]) -> list[i64]:
        return repeat_tokens(input_tokens, repetitions)


def repeat_tokens(input_tokens: list[i64], repetitions: usize) -> list[i64]:
    output: list[i64] = []
    remaining := repetitions

    while remaining > 0:
        for token in input_tokens:
            output.append(token)

        remaining -= 1

    return output


-> expand_macro[M: MacroTerm](macro_term: M, input_tokens: list[i64]) -> list[i64]:
    return macro_term.expand(input_tokens)


test:
    expanded := expand_macro[RepeatMacro](RepeatMacro(3), [4, 2])

    assert(size(expanded) == 6)
    assert(expanded[0] == 4)
    assert(expanded[1] == 2)
    assert(expanded[4] == 4)
    assert(expanded[5] == 2)
