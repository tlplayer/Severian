# Ex - Expression
# Rewrite an expression and return the same concrete expression representation.

trait ExpressionTerm:
    def fold_constants() -> Self


class AddExpression: ExpressionTerm
    left: i64
    right: i64
    value: i64
    folded: bool

    def fold_constants() -> Self:
        return AddExpression(left, right, left + right, true)


def fold_expression[Ex: ExpressionTerm](expression: Ex) -> Ex:
    return expression.fold_constants()


test:
    expression := AddExpression(19, 23, 0, false)
    folded := fold_expression(expression)

    assert(folded.value == 42)
    assert(folded.folded == true)
