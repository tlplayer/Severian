# V - Value
# Fold compiler values without erasing their concrete representation.

trait ValueTerm:
    def zero() -> Self
    def add(other: Self) -> Self


class ConstantValue: ValueTerm
    value: i64

    def zero() -> Self:
        return ConstantValue(0)

    def add(other: Self) -> Self:
        return ConstantValue(value + other.value)


def fold_values[V: ValueTerm](values: list[V]) -> V:
    total := V.zero()

    for value in values:
        total = total.add(value)

    return total


test:
    values := [ConstantValue(10), ConstantValue(20), ConstantValue(12)]
    folded := fold_values(values)

    assert(folded.value == 42)
