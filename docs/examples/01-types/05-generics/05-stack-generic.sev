from collections import list


class Stack[T]:
    values: list[T]

    def Stack():
        values := []

    def push(value: T):
        values.append(value)

    def pop() -> T | None:
        if size(values) == 0:
            return None

        return values.pop()


def main():
    ints := Stack[int]()
    ints.push(10)
    ints.push(20)

    strings := Stack[string]()
    strings.push("a")
    strings.push("b")

    integer = ints.pop()
    print(integer.value)
    text = strings.pop()
    print(text.value)

test "stack returns values in LIFO order and then absence":
    stack = Stack[int]()
    stack.push(10)
    stack.push(20)
    second = stack.pop()
    first = stack.pop()
    missing = stack.pop()
    assert(second.has_value and second.value == 20)
    assert(first.has_value and first.value == 10)
    assert(not missing.has_value)

test "popped string owns its value after the stack is dropped":
    stack = Stack[string]()
    stack.push("owned")
    result = stack.pop()
    drop(stack)
    assert(result.has_value and result.value == "owned")
