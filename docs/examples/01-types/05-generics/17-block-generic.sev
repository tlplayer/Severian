# B - Block
# Ensure a control-flow block has a terminator while preserving its block type.

trait BlockTerm:
    def terminated() -> bool
    def with_terminator() -> Self


class BasicBlock: BlockTerm
    operations: list[i64]
    has_terminator: bool

    def terminated() -> bool:
        return has_terminator

    def with_terminator() -> Self:
        return BasicBlock(operations, true)


def ensure_terminated[B: BlockTerm](block: B) -> B:
    if block.terminated():
        return block

    return block.with_terminator()


test:
    block := BasicBlock([10, 20, 12], false)
    terminated := ensure_terminated(block)

    assert(terminated.has_terminator == true)
    assert(size(terminated.operations) == 3)
