# Y - Symbol
# Y identifies syntax. It resolves to O, which owns executable semantics.

enum OperationKind:
    Add
    Multiply


trait SymbolTerm:
    def same_symbol(other: Self) -> bool


class ResolvedSymbol: SymbolTerm
    id: u64

    def same_symbol(other: Self) -> bool:
        return id == other.id


class OperationBinding[Y]:
    symbol: Y
    operation: OperationKind


def resolve_operation[Y: SymbolTerm](
    first: OperationBinding[Y],
    second: OperationBinding[Y],
    symbol: Y,
) -> OperationKind:
    if first.symbol.same_symbol(symbol):
        return first.operation

    if second.symbol.same_symbol(symbol):
        return second.operation
    throw Error("unknown operation symbol")


def apply_operation(operation: OperationKind, left: i64, right: i64) -> i64:
    match operation:
        case Add:
            return left + right

        case Multiply:
            return left * right


test:
    plus := ResolvedSymbol(1)
    multiply := ResolvedSymbol(2)

    add_binding := OperationBinding[ResolvedSymbol](plus, OperationKind.Add)
    multiply_binding := OperationBinding[ResolvedSymbol](multiply, OperationKind.Multiply)

    add := resolve_operation(add_binding, multiply_binding, plus)
    product := resolve_operation(add_binding, multiply_binding, multiply)

    assert(apply_operation(add, 19, 23) == 42)
    assert(apply_operation(product, 6, 7) == 42)


test "unknown symbol fails instead of selecting the second operation":
    throws "unknown operation symbol":
        plus = ResolvedSymbol(1)
        multiply = ResolvedSymbol(2)
        unknown = ResolvedSymbol(3)
        first = OperationBinding[ResolvedSymbol](plus, OperationKind.Add)
        second = OperationBinding[ResolvedSymbol](multiply, OperationKind.Multiply)
        result = resolve_operation(first, second, unknown)

class Probe:
    calls: int
    def read() -> OperationKind:
        calls += 1
        return OperationKind.Multiply

test "match evaluates its subject once and carries mutated state":
    probe = Probe(0)
    result = 0
    match probe.read():
        case Add:
            result = 1
        case Multiply:
            result = 2
    assert(probe.calls == 1)
    assert(result == 2)

def fallback(operation: OperationKind) -> int:
    match operation:
        case Add:
            return 1
        case _:
            return 9

test "wildcard matches the remaining variants":
    assert(fallback(OperationKind.Add) == 1)
    assert(fallback(OperationKind.Multiply) == 9)

test with compiler "missing enum case is rejected":
    reject:
        operation = OperationKind.Add
        match operation:
            case Add:
                result = 1
