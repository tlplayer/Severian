# R - Result
# Merge pass results while preserving the concrete result representation.

trait ResultTerm:
    def empty() -> Self
    def merge(other: Self) -> Self


class AnalysisResult: ResultTerm
    facts: usize
    warnings: usize

    def empty() -> Self:
        return AnalysisResult(0, 0)

    def merge(other: Self) -> Self:
        return AnalysisResult(facts + other.facts, warnings + other.warnings)


def merge_results[R: ResultTerm](results: list[R]) -> R:
    merged := R.empty()

    for result in results:
        merged = merged.merge(result)

    return merged


test:
    results := [AnalysisResult(12, 1), AnalysisResult(30, 2)]
    merged := merge_results(results)

    assert(merged.facts == 42)
    assert(merged.warnings == 3)
