'''
`numeric` is the gap-filling numeric domain.

A numeric value may remain unresolved across expressions, generics, tensor
elements, and tensor dimensions.

Only an explicit concretization such as `int(...)`, `float(...)`, `i32(...)`,
etc. requires the compiler to select a concrete representation.

The important invariant is:

    numeric + numeric -> numeric

unless the caller explicitly requests another numeric representation.
'''


def add_to_int(a: numeric, b: numeric) -> int:
    return int(a + b)


def add_to_float(a: numeric, b: numeric) -> float:
    return float(a + b)


def add_to_numeric(a: numeric, b: numeric) -> numeric:
    return numeric(a + b)


test "numeric arithmetic can be concretized after the operation":
    assert(add_to_float(1.0, 1) is float)
    assert(add_to_float(1, 1) is float)

    assert(add_to_int(1, 1) is int)
    assert(add_to_int(1.0, 1) is int)

    assert(add_to_numeric(1, 1) is numeric)
    assert(add_to_numeric(1.0, 1) is numeric)
    assert(add_to_numeric(1, 1.0) is numeric)
    assert(add_to_numeric(1.0, 1.0) is numeric)


'''
A tensor may carry unresolved numeric elements.

This must not cause the compiler to collapse `numeric` to float, int,
object, boxed-any, or another fallback representation.
'''


def add_tensor(
    left: Tensor[numeric, Shape(N: numeric, M: numeric)],
    right: Tensor[numeric, Shape(N: numeric, M: numeric)],
) -> Tensor[numeric, Shape(N: numeric, M: numeric)]:

    return left + right


test "tensor elements remain numeric through tensor arithmetic":
    left = Tensor[numeric, Shape(N: numeric, M: numeric)](
        [
            [1,   2.0],
            [3.0, 4],
        ]
    )

    right = Tensor[numeric, Shape(N: numeric, M: numeric)](
        [
            [5.0, 6],
            [7,   8.0],
        ]
    )

    result = add_tensor(left, right)

    assert(result is Tensor[numeric, Shape(N: numeric, M: numeric)])
    assert(result[0, 0] is numeric)
    assert(result[0, 1] is numeric)
    assert(result[1, 0] is numeric)
    assert(result[1, 1] is numeric)


'''
Element representation may be concretized without changing the shape domain.
'''


def tensor_to_float(
    value: Tensor[numeric, Shape(N: numeric, M: numeric)],
) -> Tensor[float, Shape(N: numeric, M: numeric)]:

    return float(value)


def tensor_to_int(
    value: Tensor[numeric, Shape(N: numeric, M: numeric)],
) -> Tensor[int, Shape(N: numeric, M: numeric)]:

    return int(value)


test "tensor element concretization does not concretize its shape":
    value = Tensor[numeric, Shape(N: numeric, M: numeric)](
        [
            [1, 2.0],
            [3, 4.0],
        ]
    )

    floats = tensor_to_float(value)
    ints = tensor_to_int(value)

    assert(floats is Tensor[float, Shape(N: numeric, M: numeric)])
    assert(ints is Tensor[int, Shape(N: numeric, M: numeric)])


'''
Shape dimensions are independently typed numeric values.

Tensor[T, Shape(N:T1, M:T2)]

means:

    T   element type
    N   first dimension value
    T1  numeric representation/domain of N
    M   second dimension value
    T2  numeric representation/domain of M

The shape is therefore not forced into one global index representation.
'''


def preserve_shape[
    T: numeric,
    T1: numeric,
    T2: numeric,
](
    value: Tensor[T, Shape(N: T1, M: T2)],
) -> Tensor[T, Shape(N: T1, M: T2)]:

    return value


test "each tensor dimension preserves its own numeric domain":
    value: Tensor[
        numeric,
        Shape(
            N: int,
            M: numeric,
        ),
    ]

    result = preserve_shape(value)

    assert(
        result
        is Tensor[
            numeric,
            Shape(
                N: int,
                M: numeric,
            ),
        ]
    )


'''
A transformation may change the symbolic shape while retaining numeric
dimension expressions.

Nothing here requires N, M, or N * M to become i64 just because a backend
eventually uses an integer index.
'''


def flatten[
    T: numeric,
    T1: numeric,
    T2: numeric,
](
    value: Tensor[T, Shape(N: T1, M: T2)],
) -> Tensor[T, Shape(S: numeric)]:

    return reshape(
        value,
        Shape(
            S: numeric(N * M),
        ),
    )


test "shape arithmetic remains numeric until backend concretization":
    value: Tensor[
        float,
        Shape(
            N: numeric,
            M: numeric,
        ),
    ]

    result = flatten(value)

    assert(result is Tensor[float, Shape(S: numeric)])


'''
The hard case:

Both the element domain and the shape domain are unresolved.

Compiler passes must be allowed to transpose, reshape, specialize, fold, and
lower this tensor without inventing a concrete integer/float representation.
'''


def transpose_numeric[
    T: numeric,
    T1: numeric,
    T2: numeric,
](
    value: Tensor[T, Shape(N: T1, M: T2)],
) -> Tensor[T, Shape(M: T2, N: T1)]:

    return transpose(value)


test "numeric tensor survives element and shape polymorphism":
    value: Tensor[
        numeric,
        Shape(
            N: numeric,
            M: int,
        ),
    ]

    result = transpose_numeric(value)

    assert(
        result
        is Tensor[
            numeric,
            Shape(
                M: int,
                N: numeric,
            ),
        ]
    )
