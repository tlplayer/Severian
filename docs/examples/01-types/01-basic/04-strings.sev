def main():
    name: string = "Severian"

    print(name)
    print(len(name))
    print(name.upper())
    print(name.contains("ver"))
    print(f"Hello, {name}!")
    print(name.slice(0,5))

test with integ:
    main()
    assert("Hello, Severian!" in stdout)
    assert("Apple".concat("s") + '!' == "Apples!")