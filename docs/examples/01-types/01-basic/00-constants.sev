MAX_RETRIES: int := view 3
PI: float := view 3.1415926
variable_global = 0

test "constant output":
    module.variable_global = 1
    assert(module.variable_global == 1)

test with compiler "You cannot change a constant binding view":
    reject:
        MAX_RETRIES = 1

def increment_global():
    variable_global += 1

test "unqualified assignments update the module binding":
    variable_global = 0
    increment_global()
    assert(module.variable_global == 1)

test with compiler "qualified constants cannot be reassigned either":
    reject "constant":
        module.MAX_RETRIES = 1

test "explicit declarations can shadow a module constant":
    max_retries: int = 9
    assert(max_retries == 9)
    assert(module.MAX_RETRIES == 3)
