'''
E2E: extend is additive only.

An extension may add new behavior to an existing type.
It may not replace behavior already defined directly on that type.
'''

class Counter:
    value: int

    def get() -> int:
        return value


# Valid: reset() does not already exist on Counter.
extend Counter:

    def reset() -> Counter:
        return Counter(0)


def main():
    counter = Counter(10)

    if counter.get() != 10:
        throw Error("unexpected initial counter")

    counter = counter.reset()

    if counter.get() != 0:
        throw Error("counter did not reset")


test "extension adds new behavior":
    counter := Counter(42)

    assert(counter.get() == 42)
    assert(counter.reset().get() == 0)


test with compiler "extension cannot overwrite existing behavior":

    reject:
        class InvalidCounter:
            value: int

            def get() -> int:
                return value

        extend InvalidCounter:

            # Reject: get() already belongs to InvalidCounter.
            def get() -> int:
                return 0


extend Counter:
    def increment():
        value += 1

test "extension mutation updates the existing receiver":
    counter = Counter(10)
    counter.increment()
    assert(counter.get() == 11)

test "reset returns an independent counter":
    counter = Counter(42)
    reset = counter.reset()
    assert(reset.get() == 0)
    assert(counter.get() == 42)

test "main uses additive extensions":
    main()

test with compiler "extensions cannot add storage":
    reject:
        extend Counter:
            extra: int
