# R denotes a returned value's generic type; E is the prelude Error alias.
def returned[R](value: R) -> R:
    return value

def lookup(found: bool) -> int | E:
    if not found:
        throw E("missing result")
    return returned(42)

def forwarded(found: bool) -> int | E:
    return lookup(found)

test "type unions flatten duplicates and preserve member identity":
    number = float | int
    assert:
        number is union
        (number | int) == number
        (int | float) == number
        (int | int) == int
        not (int | int) is union
        E == Error
        (int | E) == (int | Error)
        (int | E) != number

test "generic returned values preserve their concrete types":
    number = returned(42)
    text = returned("result")
    assert(type(number) == int and number == 42)
    assert(type(text) == string and text == "result")

test "capture preserves errors and ordinary calls propagate them":
    success ?= forwarded(true)
    failure ?= forwarded(false)
    assert:
        success == 42
        failure is E
        failure.message == "missing result"
    throws(forwarded(false) -> E)
    assert(forwarded(true) == 42)

test with compiler "a type union requires types on both sides":
    reject:
        invalid = int | 42
