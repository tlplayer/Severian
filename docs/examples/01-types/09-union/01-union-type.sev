union Foobar:
    Foo
    Bar

class Foo:
    def return_foobar() -> Foobar:
        return self

    def foo_value() -> int:
        return 1

class Bar:
    def return_bar() -> Foobar:
        return self

    def bar_value() -> int:
        return 2

test "Fixed point type collapse":

    '''
    When we zip a union we get a fixed point colpase if there is no conflict
    in implementation
    '''
    Foobar = zip(Foo, Bar)

    # We instantiate the new class which has both functions/values
    fb = Foobar()

    assert:
        fb.bar_value() == 2
        fb.foo_value() == 1
        type(fb) == Foobar
