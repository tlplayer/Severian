import c from xxi


@c(symbol = "strlen")
def c_strlen(text: view string) -> usize


def string_length(text: string) -> usize:
    unsafe:
        return c_strlen(text)

def main():
    print(int(string_length("severian")))

test "C string conversion terminates slices without changing the source":
    assert(string_length("severian") == 8)
    assert(string_length("") == 0)

test with compiler:
    reject:
        c_strlen("unsafe boundary")
