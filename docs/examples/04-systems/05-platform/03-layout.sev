import platform

class Header:
    tag: u8
    length: u32

test "layout comes from the selected target":
    target = platform.current()
    layout = platform.Layout[Header](target)

    assert:
        layout.size >= 5B
        layout.alignment >= 1B
        layout.field("tag").offset == 0B
        layout
            .field("length").offset % layout
            .field("length").alignment == 0B
