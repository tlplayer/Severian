def byte_at(bytes: list[u8], index: int) -> u8 | BoundsError:
    if index < 0 or index >= size(bytes):
        return error(BoundsError(index))

    unsafe:
        pointer: *[u8] = &bytes[0]
        # Raw access is always indexed; Severian has no unary `*pointer` form.
        return pointer[index]

test "in bounds":
    
    byte ?= byte_at([65, 66, 67], 1)
    assert(byte == 66)

test "out of bounds":
    throws(byte_at([65], 4)):
        BoundsError(index):
            assert(index == 4)

def main():
    result ?= byte_at([65, 66, 67], 1)
    print(result)
