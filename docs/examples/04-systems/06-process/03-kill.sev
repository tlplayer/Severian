import process


test with integ "kill terminates a child with SIGTERM":
    child = process.spawn(["/bin/sleep", "30"])
    assert(child.pid > 0)
    assert(process.kill(child))
    # Signal termination retains the signal number: 128 + SIGTERM(15).
    assert(process.wait(child) == 143)
    assert(child.completed)
