import process


test with integ "spawn returns a child and wait retains its exit status":
    child = process.spawn(["/bin/sh", "-c", "exit 7"])
    assert(child.pid > 0)
    assert(process.wait(child) == 7)
    assert(child.completed)
    assert(process.wait(child) == 7)
    assert(not process.kill(child))
