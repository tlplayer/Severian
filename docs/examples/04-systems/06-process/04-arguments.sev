import cli
from collections import list


def interface() -> cli.Command:
    return cli.command(
        "arguments",
        "Print each application argument",
        arguments=[
            cli.argument(
                "values",
                "Values to print",
                required=false,
                multiple=true,
            ),
        ],
    )


def main():
    application = interface()
    matches = cli.parse_process(application)
    for value in cli.values(matches, "values"):
        print(value)

test "CLI captures each positional argument literally":
    application = interface()
    matches = cli.parse(application, ["one", "two words", "$HOME"])
    values = cli.values(matches, "values")
    assert(values.len() == 3)
    assert(values[1] == "two words" and values[2] == "$HOME")
