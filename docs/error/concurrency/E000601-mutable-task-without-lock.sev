# E000601: mutable task call without transferring the lock capability
# Mutable state cannot cross an async boundary as an unsynchronized alias.
# Use `with self and lock`, or pass frozen data for shared reads.

class Counter:
    value: int = 0

    def increment():
        value += 1

def main():
    counter := Counter()
    work = async counter.increment() with self
    await work
