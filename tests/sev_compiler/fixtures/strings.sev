import "../../../sev_compiler/universal/primitive/string/core.sev" as utf8


def message() -> string:
    return "aλ😀z"


def relay(value: string) -> string:
    return value


def choose(first: bool) -> string:
    if first:
        return "λ"
    return "😀"


def main():
    text = relay(message())
    assert(utf8.byte_count(text) == 8)
    assert(utf8.length(text) == 4)
    assert(utf8.byte_at(text, 1) == 206)
    assert(utf8.byte_at(text, 2) == 187)
    assert(utf8.character.codepoint(utf8.character_at(text, 1)) == 955)
    assert(utf8.character.codepoint(utf8.character_at(text, 2)) == 128512)
    assert(utf8.equal(text, "aλ😀z"))
    assert(not utf8.equal(text, "aλ😃z"))
    assert(utf8.length("") == 0)
    assert(utf8.equal("", ""))
    assert(utf8.equal(choose(true), "λ"))
    assert(utf8.equal(choose(false), "😀"))
    assert(utf8.character.codepoint('a') == 97)
    assert(utf8.character.codepoint('λ') == 955)
    assert(utf8.character.codepoint('中') == 20013)
    assert(utf8.character.codepoint('😀') == 128512)
    assert(utf8.character.codepoint('\n') == 10)
    assert(utf8.length("中") == 1)
    assert(utf8.decode("中", 0) == 20013)
    assert(utf8.character.valid(1114111))
    assert(not utf8.character.valid(1114112))
    assert(not utf8.character.valid(55296))
    assert(not utf8.character.valid(57343))
    print(text)
    print("")
    print("quote: \" slash: \\ tab:\tend")
