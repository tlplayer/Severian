import attention
import decoder_layer
import mlp
import qwen2_config
import rope
import safetensor_weights
import tensor

class Qwen2Weights:
    embedding: Tensor[bf16]
    layers: list[decoder_layer.Qwen2DecoderWeights]
    final_norm: Tensor[bf16]

class Qwen2State:
    hidden: Tensor[bf16]
    caches: list[attention.KvCache]

class Qwen2Output:
    logits: Tensor[bf16]
    caches: list[attention.KvCache]

def load_attention_weights(
    store: tensor.SafeTensorStore,
    prefix: string,
) -> Result[attention.Qwen2AttentionWeights, IOError]:
    query = store.get(prefix + ".q_proj.weight")
    query_bias = store.get(prefix + ".q_proj.bias")
    key = store.get(prefix + ".k_proj.weight")
    key_bias = store.get(prefix + ".k_proj.bias")
    value = store.get(prefix + ".v_proj.weight")
    value_bias = store.get(prefix + ".v_proj.bias")
    output = store.get(prefix + ".o_proj.weight")
    return attention.Qwen2AttentionWeights(
        query.bf16(), query_bias.bf16(),
        key.bf16(), key_bias.bf16(),
        value.bf16(), value_bias.bf16(),
        output.bf16(),
    )

def load_mlp_weights(
    store: tensor.SafeTensorStore,
    prefix: string,
) -> Result[mlp.Qwen2MlpWeights, IOError]:
    gate = store.get(prefix + ".gate_proj.weight")
    up = store.get(prefix + ".up_proj.weight")
    down = store.get(prefix + ".down_proj.weight")
    return mlp.Qwen2MlpWeights(gate.bf16(), up.bf16(), down.bf16())

def load_qwen_2_weights(
    store: tensor.SafeTensorStore,
    num_layers: int,
) -> Result[Qwen2Weights, IOError]:
    embedding_entry = store.get("model.embed_tokens.weight")
    layers := []
    for layer in range(0, num_layers):
        prefix = "model.layers." + string(layer)
        input_norm = store.get(prefix + ".input_layernorm.weight")
        post_norm = store.get(prefix + ".post_attention_layernorm.weight")
        attention_weights = load_attention_weights(store, prefix + ".self_attn")
        mlp_weights = load_mlp_weights(store, prefix + ".mlp")
        layers.append(decoder_layer.Qwen2DecoderWeights(
            input_norm.bf16(),
            attention_weights,
            post_norm.bf16(),
            mlp_weights,
        ))
    final_norm = store.get("model.norm.weight")
    return Qwen2Weights(embedding_entry.bf16(), layers, final_norm.bf16())

def embed(input_ids: Tensor[i64], weights: Qwen2Weights) -> Tensor[bf16]:
    return tensor.gather_bf_16(weights.embedding, input_ids)

def logits(hidden: Tensor[bf16], weights: Qwen2Weights) -> Tensor[bf16]:
    # Qwen2.5-3B-Instruct has tie_word_embeddings=true, so the embedding table
    # is the LM head. No invented second projection is allocated.
    projection = tensor.transpose_bf_16(weights.embedding, [1, 0])
    return tensor.matmul_bf_16(hidden, projection)

def forward(
    input_ids: Tensor[i64],
    weights: Qwen2Weights,
    caches: list[attention.KvCache],
    rotary: rope.RopeValues,
    causal_mask: Tensor[f32],
    position: int,
    config: qwen2_config.Qwen2Config,
) -> Qwen2Output:
    assert(size(weights.layers) == config.num_hidden_layers)
    assert(size(caches) == config.num_hidden_layers)
    hidden := embed(input_ids, weights)
    updated_caches := []
    for layer in range(0, config.num_hidden_layers):
        result = decoder_layer.decoder_layer(
            hidden,
            weights.layers[layer],
            caches[layer],
            rotary,
            causal_mask,
            position,
            config.rms_norm_epsilon,
            config.num_attention_heads,
            config.num_key_value_heads,
            config.head_dimension(),
        )
        hidden = result.hidden
        updated_caches.append(result.cache)
    hidden = decoder_layer.rms_norm(
        hidden,
        weights.final_norm,
        config.rms_norm_epsilon,
    )
    return Qwen2Output(logits(hidden, weights), updated_caches)
