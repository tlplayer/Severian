import file
import json
from platform import monotonicNs
import qwen2
import qwen2_config
import qwen_kernels
import qwen_tokenizer
import safetensor_weights
import tensor

def forward(weights: qwen2.Qwen2Weights, promptTokens: list[int]) -> Tensor[bf16, 1, 32, 151936]:
    inputIds = tensor.from_i64_tokens_32(promptTokens)
    cosine = tensor.rope_cosine_32(promptTokens)
    sine = tensor.rope_sine_32(promptTokens)
    mask = tensor.causal_mask_32(promptTokens)
    hidden := qwen_kernels.embeddingKernel(weights.embedding, inputIds)
    for layer in weights.layers:
        hidden = qwen_kernels.qwen2LayerKernel(
            hidden,
            layer.inputNorm,
            layer.attention.query,
            layer.attention.queryBias,
            layer.attention.key,
            layer.attention.keyBias,
            layer.attention.value,
            layer.attention.valueBias,
            layer.attention.output,
            layer.postAttentionNorm,
            layer.mlp.gate,
            layer.mlp.up,
            layer.mlp.down,
            cosine,
            sine,
            mask,
        )
    logits = qwen_kernels.logitsKernel(hidden, weights.finalNorm, weights.embedding)
    return logits

def runBenchmark() -> Result[qwen2.Qwen2Weights, exception]:
    modelPath = "benchmarks/inference/models/Qwen2.5-3B-Instruct"
    processStart = monotonicNs()
    configText = file.read_text(modelPath + "/config.json")
    configRead = monotonicNs()
    print("config_read_ns", configRead)
    config = qwen2_config.parseQwen2Config(configText)
    configParsed = monotonicNs()
    print("config_parsed_ns", configParsed)
    store = safetensor_weights.openSafeTensorStore(modelPath)
    indexParsed = monotonicNs()
    print("index_parsed_ns", indexParsed)
    weights = qwen2.loadQwen2Weights(store, config.numHiddenLayers)
    weightsMapped = monotonicNs()
    print("weights_mapped_ns", weightsMapped)

    assert(config.vocabSize == 151936)
    assert(config.hiddenSize == 2048)
    assert(config.intermediateSize == 11008)
    assert(config.numHiddenLayers == 36)
    assert(config.numAttentionHeads == 16)
    assert(config.numKeyValueHeads == 2)
    assert(config.headDimension() == 128)
    assert(config.kvRepeat() == 8)
    assert(config.tieWordEmbeddings)

    print("process_start_ns", processStart)
    print("checkpoint_tensor_count", size(json.objectKeys(store.weightMap)))
    print("loaded_layers", size(weights.layers))
    fixtureText = file.read_text("benchmarks/inference/example_inputs.json")
    fixtureDocument = json.decode[Any](fixtureText)
    fixture = json.objectGet(fixtureDocument, "32")
    prompt = json.asString(json.objectGet(fixture, "prompt_text"))
    promptTokens = json.asIntList(json.objectGet(fixture, "input_ids"))
    attentionMask = json.asIntList(json.objectGet(fixture, "attention_mask"))
    positionIds = json.asIntList(json.objectGet(fixture, "position_ids"))
    expectedTokens = json.asIntList(json.objectGet(fixture, "expected_output_ids"))
    logitsPosition = json.asInt(json.objectGet(fixture, "logits_position"))
    assert(size(promptTokens) == 32)
    assert(size(attentionMask) == 32)
    assert(size(positionIds) == 32)
    assert(size(expectedTokens) == 1)
    assert(logitsPosition == 31)
    for position in positionIds:
        assert(attentionMask[position] == 1)
        assert(positionIds[position] == position)
    assert(qwen_tokenizer.encode(modelPath, prompt) == promptTokens)
    warmupStart = monotonicNs()
    warmupLogits = forward(weights, promptTokens)
    warmupToken = tensor.argmax_at_active_position(warmupLogits, promptTokens)
    assert(warmupToken == expectedTokens[0])
    modelReady = monotonicNs()
    inferenceStart = monotonicNs()
    logits = forward(weights, promptTokens)
    forwardEnd = monotonicNs()
    nextToken = tensor.argmax_at_active_position(logits, promptTokens)
    firstToken = monotonicNs()
    nextText = qwen_tokenizer.decodeToken(modelPath, nextToken)
    print("prompt", prompt)
    print("prompt_token_count", size(promptTokens))
    print("logits_position", logitsPosition)
    print("warmup_token", warmupToken)
    print("next_token", nextToken)
    print("next_text", nextText)
    print("model_ready_ns", modelReady)
    print("first_token_ns", firstToken)
    print("load_ns", modelReady - processStart)
    print("warmup_ns", modelReady - warmupStart)
    print("prefill_ns", forwardEnd - inferenceStart)
    print("ttft_ns", forwardEnd - inferenceStart)
    assert(nextToken == warmupToken)
    assert(nextToken == expectedTokens[0])
    return weights

def main():
    switch runBenchmark():
        ok weights:
            assert(size(weights.layers) == 36)
        failure error:
            assert(false, error)
