import file
import qwen2
import qwen2_config
import safetensor_weights

native("__sev_monotonic_ns") def monotonicNs() -> int

def runBenchmark() -> Result[qwen2.Qwen2Weights, exception]:
    modelPath = "benchmarks/inference/models/Qwen2.5-3B-Instruct"
    processStart = monotonicNs()
    configText ?= file.read(modelPath + "/config.json")
    configRead = monotonicNs()
    print("config_read_ns", configRead)
    config ?= qwen2_config.parseQwen2Config(configText)
    configParsed = monotonicNs()
    print("config_parsed_ns", configParsed)
    store ?= safetensor_weights.openSafeTensorStore(modelPath)
    indexParsed = monotonicNs()
    print("index_parsed_ns", indexParsed)
    weights ?= qwen2.loadQwen2Weights(store, config.numHiddenLayers)
    weightsMapped = monotonicNs()
    print("weights_mapped_ns", weightsMapped)

    assert(config.vocabSize == 151936)
    assert(config.hiddenSize == 2048)
    assert(config.intermediateSize == 11008)
    assert(config.numHiddenLayers == 36)
    assert(config.numAttentionHeads == 16)
    assert(config.numKeyValueHeads == 2)
    assert(config.headDimension() == 128)
    assert(config.kvRepeat() == 8)
    assert(config.tieWordEmbeddings)

    print("process_start_ns", processStart)
    print("checkpoint_tensor_count", size(store.keys()))
    print("loaded_layers", size(weights.layers))
    return weights

def main():
    switch runBenchmark():
        ok weights:
            assert(size(weights.layers) == 36)
        failure error:
            assert(false, error)
