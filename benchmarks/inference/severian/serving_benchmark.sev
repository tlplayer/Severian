import file
import json
from platform import monotonic_ns
import qwen2
import qwen2_config
import qwen_decode_kernels
import qwen_prefill_kernels
import safetensor_weights
import tensor

class RequestState:
    id: int
    key_caches: list[Tensor[bf16]]
    value_caches: list[Tensor[bf16]]
    token: int
    output_tokens: list[int]
    token_times_ns: list[int]
    started_ns: int
    first_token_ns: int
    completed_ns: int

def prefill_request(
    request_id: int,
    started_ns: int,
    weights: qwen2.Qwen2Weights,
    input_ids: Tensor[i64],
    cosine: Tensor[f32],
    sine: Tensor[f32],
    mask: Tensor[f32],
    cache_index: Tensor[i64],
) -> RequestState:
    key_caches := []
    value_caches := []
    hidden := qwen_prefill_kernels.embedding_kernel(weights.embedding, input_ids)
    for layer_index in range(0, 36):
        layer = weights.layers[layer_index]
        empty_key = tensor.empty_kv_cache()
        key_cache = qwen_prefill_kernels.prefill_key_cache_kernel(
            hidden,
            layer.input_norm,
            layer.attention.key,
            layer.attention.key_bias,
            cosine,
            sine,
            empty_key,
            cache_index,
        )
        tensor.release(empty_key)
        empty_value = tensor.empty_kv_cache()
        value_cache = qwen_prefill_kernels.prefill_value_cache_kernel(
            hidden,
            layer.input_norm,
            layer.attention.value,
            layer.attention.value_bias,
            empty_value,
            cache_index,
        )
        tensor.release(empty_value)
        next_hidden = qwen_prefill_kernels.qwen2_layer_kernel(
            hidden,
            layer.input_norm,
            layer.attention.query,
            layer.attention.query_bias,
            layer.attention.key,
            layer.attention.key_bias,
            layer.attention.value,
            layer.attention.value_bias,
            layer.attention.output,
            layer.post_attention_norm,
            layer.mlp.gate,
            layer.mlp.up,
            layer.mlp.down,
            cosine,
            sine,
            mask,
        )
        tensor.release(hidden)
        hidden = next_hidden
        key_caches.append(key_cache)
        value_caches.append(value_cache)
    logits = qwen_prefill_kernels.last_logits_kernel(hidden, weights.final_norm, weights.embedding)
    token = tensor.argmax(logits)
    first_token_ns = monotonic_ns()
    tensor.release(logits)
    tensor.release(hidden)
    return RequestState(
        request_id,
        key_caches,
        value_caches,
        token,
        [token],
        [first_token_ns],
        started_ns,
        first_token_ns,
        0,
    )

def decode_request(
    state: RequestState,
    weights: qwen2.Qwen2Weights,
    cosine: Tensor[f32],
    sine: Tensor[f32],
    mask: Tensor[f32],
    cache_index: Tensor[i64],
) -> RequestState:
    input_ids = tensor.from_i64_token(state.token)
    hidden := qwen_decode_kernels.embedding_kernel(weights.embedding, input_ids)
    tensor.release(input_ids)
    for layer_index in range(0, 36):
        layer = weights.layers[layer_index]
        old_key = state.key_caches[layer_index]
        key_cache = qwen_decode_kernels.update_key_cache_kernel(
            hidden,
            layer.input_norm,
            layer.attention.key,
            layer.attention.key_bias,
            cosine,
            sine,
            old_key,
            cache_index,
        )
        tensor.release(old_key)
        state.key_caches[layer_index] = key_cache
        old_value = state.value_caches[layer_index]
        value_cache = qwen_decode_kernels.update_value_cache_kernel(
            hidden,
            layer.input_norm,
            layer.attention.value,
            layer.attention.value_bias,
            old_value,
            cache_index,
        )
        tensor.release(old_value)
        state.value_caches[layer_index] = value_cache
        next_hidden = qwen_decode_kernels.qwen2_layer_kernel(
            hidden,
            layer.input_norm,
            layer.attention.query,
            layer.attention.query_bias,
            layer.attention.output,
            layer.post_attention_norm,
            layer.mlp.gate,
            layer.mlp.up,
            layer.mlp.down,
            key_cache,
            value_cache,
            cosine,
            sine,
            mask,
        )
        tensor.release(hidden)
        hidden = next_hidden
    logits = qwen_decode_kernels.logits_kernel(hidden, weights.final_norm, weights.embedding)
    token = tensor.argmax(logits)
    token_time_ns = monotonic_ns()
    tensor.release(logits)
    tensor.release(hidden)
    state.output_tokens.append(token)
    state.token_times_ns.append(token_time_ns)
    return RequestState(
        state.id,
        state.key_caches,
        state.value_caches,
        token,
        state.output_tokens,
        state.token_times_ns,
        state.started_ns,
        state.first_token_ns,
        token_time_ns,
    )

def release_request(state: RequestState):
    for layer_index in range(0, 36):
        tensor.release(state.key_caches[layer_index])
        tensor.release(state.value_caches[layer_index])

def run_wave(
    first_request_id: int,
    request_count: int,
    emit_measurements: bool,
    weights: qwen2.Qwen2Weights,
    input_ids: Tensor[i64],
    prefill_cosine: Tensor[f32],
    prefill_sine: Tensor[f32],
    prefill_mask: Tensor[f32],
    prefill_index: Tensor[i64],
):
    wave_start_ns = monotonic_ns()
    states := []
    for offset in range(0, request_count):
        states.append(prefill_request(
            first_request_id + offset,
            wave_start_ns,
            weights,
            input_ids,
            prefill_cosine,
            prefill_sine,
            prefill_mask,
            prefill_index,
        ))
    for position in range(256, 287):
        cosine = tensor.rope_cosine_at(position)
        sine = tensor.rope_sine_at(position)
        mask = tensor.causal_mask_at(position)
        cache_index = tensor.from_i64_position(position)
        for request_index in range(0, request_count):
            states[request_index] = decode_request(
                states[request_index], weights, cosine, sine, mask, cache_index,
            )
        tensor.release(cosine)
        tensor.release(sine)
        tensor.release(mask)
        tensor.release(cache_index)
    for state in states:
        assert(size(state.output_tokens) == 32)
        assert(size(state.token_times_ns) == 32)
        if emit_measurements:
            print(
                "request_measurement",
                state.id,
                state.started_ns,
                state.first_token_ns,
                state.completed_ns,
                json.encode(state.output_tokens),
                json.encode(state.token_times_ns),
            )
        release_request(state)

def run_benchmark() -> Result[qwen2.Qwen2Weights, exception]:
    model_path = "benchmarks/inference/models/Qwen2.5-3B-Instruct"
    process_start_ns = monotonic_ns()
    config_text = file.read_text(model_path + "/config.json")
    config = qwen2_config.parse_qwen_2_config(config_text)
    store = safetensor_weights.open_safe_tensor_store(model_path)
    weights = qwen2.load_qwen_2_weights(store, config.num_hidden_layers)
    weights_mapped_ns = monotonic_ns()
    assert(config.vocab_size == 151936)
    assert(config.hidden_size == 2048)
    assert(config.intermediate_size == 11008)
    assert(config.num_hidden_layers == 36)
    assert(config.num_attention_heads == 16)
    assert(config.num_key_value_heads == 2)
    assert(config.head_dimension() == 128)
    assert(config.tie_word_embeddings)

    fixture_text = file.read_text("benchmarks/inference/inputs.json")
    fixture_document = json.decode[Any](fixture_text)
    fixture = json.object_get(fixture_document, "256")
    prompt_tokens = json.as_int_list(json.object_get(fixture, "input_ids"))
    output_tokens = json.as_int(json.object_get(fixture, "output_tokens"))
    assert(size(prompt_tokens) == 256)
    assert(output_tokens == 32)

    input_ids = tensor.from_i64_tokens_256(prompt_tokens)
    prefill_cosine = tensor.rope_cosine_256()
    prefill_sine = tensor.rope_sine_256()
    prefill_mask = tensor.causal_mask_256()
    prefill_index = tensor.from_i64_position(0)

    warmup_start_ns = monotonic_ns()
    run_wave(
        -1,
        1,
        false,
        weights,
        input_ids,
        prefill_cosine,
        prefill_sine,
        prefill_mask,
        prefill_index,
    )
    model_ready_ns = monotonic_ns()
    benchmark_start_ns = model_ready_ns
    for wave in range(0, 5):
        run_wave(
            wave * 16,
            16,
            true,
            weights,
            input_ids,
            prefill_cosine,
            prefill_sine,
            prefill_mask,
            prefill_index,
        )
    benchmark_end_ns = monotonic_ns()

    print("process_start_ns", process_start_ns)
    print("weights_mapped_ns", weights_mapped_ns)
    print("warmup_start_ns", warmup_start_ns)
    print("model_ready_ns", model_ready_ns)
    print("benchmark_start_ns", benchmark_start_ns)
    print("benchmark_end_ns", benchmark_end_ns)
    print("input_tokens", 256)
    print("output_tokens", 32)
    print("request_count", 80)
    print("concurrency", 16)
    print("scheduler", "round_robin_batch_one")

    tensor.release(input_ids)
    tensor.release(prefill_cosine)
    tensor.release(prefill_sine)
    tensor.release(prefill_mask)
    tensor.release(prefill_index)
    return weights

def main():
    switch run_benchmark():
        ok weights:
            assert(size(weights.layers) == 36)
        failure error:
            assert(false, error)
