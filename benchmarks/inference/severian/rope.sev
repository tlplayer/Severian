import tensor

class RopeValues:
    cosine: Tensor[f32]
    sine: Tensor[f32]

def rotary_values(position_frequencies: Tensor[f32]) -> RopeValues:
    # Frequencies are built from position * theta^(-2i/head_dimension) by the
    # caller so sequence length remains dynamic and prompt-independent.
    return RopeValues(
        tensor.cosine_f_32(position_frequencies),
        tensor.sine_f_32(position_frequencies),
    )

def rotate_half(value: Tensor[f32], half_dimension: int) -> Tensor[f32]:
    first = tensor.slice_f_32(value, [0, 0, 0, 0], [-1, -1, -1, half_dimension], [1, 1, 1, 1])
    second = tensor.slice_f_32(value, [0, 0, 0, half_dimension], [-1, -1, -1, half_dimension * 2], [1, 1, 1, 1])
    negative_second = tensor.scale_f_32(second, -1.0)
    return tensor.concatenate_f_32([negative_second, first], 3)

def apply_rotary(
    value: Tensor[bf16],
    rope: RopeValues,
    half_dimension: int,
) -> Tensor[bf16]:
    value_f_32 = tensor.bf16_to_f_32(value)
    cosine = tensor.broadcast_like_f_32(rope.cosine, value_f_32)
    sine = tensor.broadcast_like_f_32(rope.sine, value_f_32)
    direct = tensor.multiply_f_32(value_f_32, cosine)
    rotated = tensor.multiply_f_32(rotate_half(value_f_32, half_dimension), sine)
    return tensor.f32_to_bf_16(tensor.add_f_32(direct, rotated))
