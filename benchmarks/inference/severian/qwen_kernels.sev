import tensor

native("__sev_xla_i64_token") def inputToken(value: int) -> Tensor[i64, 1, 1]
native("__sev_xla_argmax_bf16") def argmaxBf16(value: Tensor[bf16]) -> int

# Static single-token Qwen2.5-3B tensor regions. Shape specialization belongs
# in Severian source; the StableHLO lowerer only sees typed tensor functions.

def modelToF32(value: Tensor[bf16, 1, 1, 2048]) -> Tensor[f32, 1, 1, 2048]:
    return tensor.bf16ToF32(value)

def modelToBf16(value: Tensor[f32, 1, 1, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.f32ToBf16(value)

def modelMultiplyF32(left: Tensor[f32, 1, 1, 2048], right: Tensor[f32, 1, 1, 2048]) -> Tensor[f32, 1, 1, 2048]:
    return tensor.multiplyF32(left, right)

def modelMeanLast(value: Tensor[f32, 1, 1, 2048]) -> Tensor[f32, 1, 1]:
    return tensor.meanLastF32(value)

def stabilizeMean(value: Tensor[f32, 1, 1]) -> Tensor[f32, 1, 1]:
    return tensor.addScalarF32(value, 0.000001)

def inverseMean(value: Tensor[f32, 1, 1]) -> Tensor[f32, 1, 1]:
    return tensor.rsqrtF32(value)

def broadcastMean(value: Tensor[f32, 1, 1], target: Tensor[f32, 1, 1, 2048]) -> Tensor[f32, 1, 1, 2048]:
    return tensor.broadcastLikeF32(value, target)

def broadcastNorm(value: Tensor[bf16, 2048], target: Tensor[bf16, 1, 1, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.broadcastLikeBf16(value, target)

def modelMultiplyBf16(left: Tensor[bf16, 1, 1, 2048], right: Tensor[bf16, 1, 1, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.multiplyBf16(left, right)

def modelAddBf16(left: Tensor[bf16, 1, 1, 2048], right: Tensor[bf16, 1, 1, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.addBf16(left, right)

def qwenRmsNorm(value: Tensor[bf16, 1, 1, 2048], weight: Tensor[bf16, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    valueF32 = modelToF32(value)
    square = modelMultiplyF32(valueF32, valueF32)
    variance = modelMeanLast(square)
    inverse = inverseMean(stabilizeMean(variance))
    normalizedF32 = modelMultiplyF32(valueF32, broadcastMean(inverse, valueF32))
    normalized = modelToBf16(normalizedF32)
    return modelMultiplyBf16(normalized, broadcastNorm(weight, normalized))

def transposeModelWeight(weight: Tensor[bf16, 2048, 2048]) -> Tensor[bf16, 2048, 2048]:
    return tensor.transposeBf16(weight, [1, 0])

def transposeKvWeight(weight: Tensor[bf16, 256, 2048]) -> Tensor[bf16, 2048, 256]:
    return tensor.transposeBf16(weight, [1, 0])

def transposeMlpWeight(weight: Tensor[bf16, 11008, 2048]) -> Tensor[bf16, 2048, 11008]:
    return tensor.transposeBf16(weight, [1, 0])

def transposeDownWeight(weight: Tensor[bf16, 2048, 11008]) -> Tensor[bf16, 11008, 2048]:
    return tensor.transposeBf16(weight, [1, 0])

def transposeEmbedding(weight: Tensor[bf16, 151936, 2048]) -> Tensor[bf16, 2048, 151936]:
    return tensor.transposeBf16(weight, [1, 0])

def queryProjection(value: Tensor[bf16, 1, 1, 2048], weight: Tensor[bf16, 2048, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.matmulBf16(value, weight)

def kvProjection(value: Tensor[bf16, 1, 1, 2048], weight: Tensor[bf16, 2048, 256]) -> Tensor[bf16, 1, 1, 256]:
    return tensor.matmulBf16(value, weight)

def broadcastQueryBias(value: Tensor[bf16, 2048], target: Tensor[bf16, 1, 1, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.broadcastLikeBf16(value, target)

def broadcastKvBias(value: Tensor[bf16, 256], target: Tensor[bf16, 1, 1, 256]) -> Tensor[bf16, 1, 1, 256]:
    return tensor.broadcastLikeBf16(value, target)

def addKv(left: Tensor[bf16, 1, 1, 256], right: Tensor[bf16, 1, 1, 256]) -> Tensor[bf16, 1, 1, 256]:
    return tensor.addBf16(left, right)

def reshapeQuery(value: Tensor[bf16, 1, 1, 2048]) -> Tensor[bf16, 1, 1, 16, 128]:
    return tensor.reshapeBf16(value, [1, 1, 16, 128])

def reshapeKv(value: Tensor[bf16, 1, 1, 256]) -> Tensor[bf16, 1, 1, 2, 128]:
    return tensor.reshapeBf16(value, [1, 1, 2, 128])

def transposeQuery(value: Tensor[bf16, 1, 1, 16, 128]) -> Tensor[bf16, 1, 16, 1, 128]:
    return tensor.transposeBf16(value, [0, 2, 1, 3])

def transposeKv(value: Tensor[bf16, 1, 1, 2, 128]) -> Tensor[bf16, 1, 2, 1, 128]:
    return tensor.transposeBf16(value, [0, 2, 1, 3])

def queryHeadsToF32(value: Tensor[bf16, 1, 16, 1, 128]) -> Tensor[f32, 1, 16, 1, 128]:
    return tensor.bf16ToF32(value)

def kvHeadsToF32(value: Tensor[bf16, 1, 2, 1, 128]) -> Tensor[f32, 1, 2, 1, 128]:
    return tensor.bf16ToF32(value)

def queryScaleOne(value: Tensor[f32, 1, 16, 1, 128]) -> Tensor[f32, 1, 16, 1, 128]:
    return tensor.scaleF32(value, 1.0)

def queryScaleZero(value: Tensor[f32, 1, 16, 1, 128]) -> Tensor[f32, 1, 16, 1, 128]:
    return tensor.scaleF32(value, 0.0)

def kvScaleOne(value: Tensor[f32, 1, 2, 1, 128]) -> Tensor[f32, 1, 2, 1, 128]:
    return tensor.scaleF32(value, 1.0)

def kvScaleZero(value: Tensor[f32, 1, 2, 1, 128]) -> Tensor[f32, 1, 2, 1, 128]:
    return tensor.scaleF32(value, 0.0)

def queryAddF32(left: Tensor[f32, 1, 16, 1, 128], right: Tensor[f32, 1, 16, 1, 128]) -> Tensor[f32, 1, 16, 1, 128]:
    return tensor.addF32(left, right)

def kvAddF32(left: Tensor[f32, 1, 2, 1, 128], right: Tensor[f32, 1, 2, 1, 128]) -> Tensor[f32, 1, 2, 1, 128]:
    return tensor.addF32(left, right)

def expandKey(value: Tensor[f32, 1, 2, 1, 128]) -> Tensor[f32, 1, 2, 1, 1, 128]:
    return tensor.reshapeF32(value, [1, 2, 1, 1, 128])

def expandValue(value: Tensor[bf16, 1, 2, 1, 128]) -> Tensor[bf16, 1, 2, 1, 1, 128]:
    return tensor.reshapeBf16(value, [1, 2, 1, 1, 128])

def repeatKey(value: Tensor[f32, 1, 2, 1, 1, 128]) -> Tensor[f32, 1, 2, 8, 1, 128]:
    return tensor.broadcastF32(value, [1, 2, 8, 1, 128])

def repeatValue(value: Tensor[bf16, 1, 2, 1, 1, 128]) -> Tensor[bf16, 1, 2, 8, 1, 128]:
    return tensor.broadcastBf16(value, [1, 2, 8, 1, 128])

def mergeKeyHeads(value: Tensor[f32, 1, 2, 8, 1, 128]) -> Tensor[f32, 1, 16, 1, 128]:
    return tensor.reshapeF32(value, [1, 16, 1, 128])

def mergeValueHeads(value: Tensor[bf16, 1, 2, 8, 1, 128]) -> Tensor[bf16, 1, 16, 1, 128]:
    return tensor.reshapeBf16(value, [1, 16, 1, 128])

def valueHeadsToF32(value: Tensor[bf16, 1, 16, 1, 128]) -> Tensor[f32, 1, 16, 1, 128]:
    return tensor.bf16ToF32(value)

def transposeKey(value: Tensor[f32, 1, 16, 1, 128]) -> Tensor[f32, 1, 16, 128, 1]:
    return tensor.transposeF32(value, [0, 1, 3, 2])

def attentionScores(query: Tensor[f32, 1, 16, 1, 128], key: Tensor[f32, 1, 16, 128, 1]) -> Tensor[f32, 1, 16, 1, 1]:
    return tensor.batchedMatmulF32(query, key)

def scaleScores(value: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1, 1]:
    return tensor.scaleF32(value, 0.08838834764831845)

def scoresMax(value: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1]:
    return tensor.maxLastF32(value)

def broadcastScores(value: Tensor[f32, 1, 16, 1], target: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1, 1]:
    return tensor.broadcastLikeF32(value, target)

def subtractScores(left: Tensor[f32, 1, 16, 1, 1], right: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1, 1]:
    return tensor.subtractF32(left, right)

def expScores(value: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1, 1]:
    return tensor.expF32(value)

def scoresSum(value: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1]:
    return tensor.sumLastF32(value)

def divideScores(left: Tensor[f32, 1, 16, 1, 1], right: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1, 1]:
    return tensor.divideF32(left, right)

def stableSoftmaxSingle(value: Tensor[f32, 1, 16, 1, 1]) -> Tensor[f32, 1, 16, 1, 1]:
    maximum = scoresMax(value)
    shifted = subtractScores(value, broadcastScores(maximum, value))
    exponentials = expScores(shifted)
    denominator = scoresSum(exponentials)
    return divideScores(exponentials, broadcastScores(denominator, exponentials))

def attentionContext(probabilities: Tensor[f32, 1, 16, 1, 1], values: Tensor[f32, 1, 16, 1, 128]) -> Tensor[f32, 1, 16, 1, 128]:
    return tensor.batchedMatmulF32(probabilities, values)

def contextToBf16(value: Tensor[f32, 1, 16, 1, 128]) -> Tensor[bf16, 1, 16, 1, 128]:
    return tensor.f32ToBf16(value)

def transposeContext(value: Tensor[bf16, 1, 16, 1, 128]) -> Tensor[bf16, 1, 1, 16, 128]:
    return tensor.transposeBf16(value, [0, 2, 1, 3])

def mergeContext(value: Tensor[bf16, 1, 1, 16, 128]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.reshapeBf16(value, [1, 1, 2048])

def outputProjection(value: Tensor[bf16, 1, 1, 2048], weight: Tensor[bf16, 2048, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.matmulBf16(value, weight)

def mlpProjection(value: Tensor[bf16, 1, 1, 2048], weight: Tensor[bf16, 2048, 11008]) -> Tensor[bf16, 1, 1, 11008]:
    return tensor.matmulBf16(value, weight)

def mlpSigmoid(value: Tensor[bf16, 1, 1, 11008]) -> Tensor[bf16, 1, 1, 11008]:
    return tensor.sigmoidBf16(value)

def mlpMultiply(left: Tensor[bf16, 1, 1, 11008], right: Tensor[bf16, 1, 1, 11008]) -> Tensor[bf16, 1, 1, 11008]:
    return tensor.multiplyBf16(left, right)

def mlpDown(value: Tensor[bf16, 1, 1, 11008], weight: Tensor[bf16, 11008, 2048]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.matmulBf16(value, weight)

def qwenMlp(value: Tensor[bf16, 1, 1, 2048], gateWeight: Tensor[bf16, 11008, 2048], upWeight: Tensor[bf16, 11008, 2048], downWeight: Tensor[bf16, 2048, 11008]) -> Tensor[bf16, 1, 1, 2048]:
    gate = mlpProjection(value, transposeMlpWeight(gateWeight))
    up = mlpProjection(value, transposeMlpWeight(upWeight))
    activated = mlpMultiply(gate, mlpSigmoid(gate))
    return mlpDown(mlpMultiply(activated, up), transposeDownWeight(downWeight))

@tensor()
def embeddingKernel(embedding: Tensor[bf16, 151936, 2048], inputIds: Tensor[i64, 1, 1]) -> Tensor[bf16, 1, 1, 2048]:
    return tensor.gatherBf16(embedding, inputIds)

@tensor()
def qwen2LayerKernel(
    hidden: Tensor[bf16, 1, 1, 2048],
    inputNorm: Tensor[bf16, 2048],
    queryWeight: Tensor[bf16, 2048, 2048],
    queryBias: Tensor[bf16, 2048],
    keyWeight: Tensor[bf16, 256, 2048],
    keyBias: Tensor[bf16, 256],
    valueWeight: Tensor[bf16, 256, 2048],
    valueBias: Tensor[bf16, 256],
    outputWeight: Tensor[bf16, 2048, 2048],
    postNorm: Tensor[bf16, 2048],
    gateWeight: Tensor[bf16, 11008, 2048],
    upWeight: Tensor[bf16, 11008, 2048],
    downWeight: Tensor[bf16, 2048, 11008],
) -> Tensor[bf16, 1, 1, 2048]:
    normalized = qwenRmsNorm(hidden, inputNorm)
    projectedQuery = queryProjection(normalized, transposeModelWeight(queryWeight))
    projectedKey = kvProjection(normalized, transposeKvWeight(keyWeight))
    projectedValue = kvProjection(normalized, transposeKvWeight(valueWeight))
    query = modelAddBf16(projectedQuery, broadcastQueryBias(queryBias, projectedQuery))
    key = addKv(projectedKey, broadcastKvBias(keyBias, projectedKey))
    value = addKv(projectedValue, broadcastKvBias(valueBias, projectedValue))
    queryHeads = transposeQuery(reshapeQuery(query))
    keyHeads = transposeKv(reshapeKv(key))
    valueHeads = transposeKv(reshapeKv(value))
    queryF32 = queryHeadsToF32(queryHeads)
    keyF32 = kvHeadsToF32(keyHeads)
    queryRotary = queryAddF32(queryScaleOne(queryF32), queryScaleZero(queryF32))
    keyRotary = kvAddF32(kvScaleOne(keyF32), kvScaleZero(keyF32))
    repeatedKey = mergeKeyHeads(repeatKey(expandKey(keyRotary)))
    repeatedValue = valueHeadsToF32(mergeValueHeads(repeatValue(expandValue(valueHeads))))
    scores = scaleScores(attentionScores(queryRotary, transposeKey(repeatedKey)))
    probabilities = stableSoftmaxSingle(scores)
    context = mergeContext(transposeContext(contextToBf16(attentionContext(probabilities, repeatedValue))))
    attended = outputProjection(context, transposeModelWeight(outputWeight))
    residual = modelAddBf16(hidden, attended)
    feedForward = qwenMlp(qwenRmsNorm(residual, postNorm), gateWeight, upWeight, downWeight)
    return modelAddBf16(residual, feedForward)

def logitsProjection(value: Tensor[bf16, 1, 1, 2048], embedding: Tensor[bf16, 2048, 151936]) -> Tensor[bf16, 1, 1, 151936]:
    return tensor.matmulBf16(value, embedding)

@tensor()
def logitsKernel(hidden: Tensor[bf16, 1, 1, 2048], normWeight: Tensor[bf16, 2048], embedding: Tensor[bf16, 151936, 2048]) -> Tensor[bf16, 1, 1, 151936]:
    return logitsProjection(qwenRmsNorm(hidden, normWeight), transposeEmbedding(embedding))
