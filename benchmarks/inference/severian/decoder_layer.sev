import attention
import mlp
import rope
import tensor

class Qwen2DecoderWeights:
    input_norm: Tensor[bf16]
    attention: attention.Qwen2AttentionWeights
    post_attention_norm: Tensor[bf16]
    mlp: mlp.Qwen2MlpWeights

class DecoderResult:
    hidden: Tensor[bf16]
    cache: attention.KvCache

def rms_norm(
    input: Tensor[bf16],
    weight: Tensor[bf16],
    epsilon: float,
) -> Tensor[bf16]:
    input_f_32 = tensor.bf16_to_f_32(input)
    square = tensor.multiply_f_32(input_f_32, input_f_32)
    variance := tensor.mean_last_f_32(square)
    variance = tensor.add_scalar_f_32(variance, epsilon)
    inverse_rms := tensor.rsqrt_f_32(variance)
    inverse_rms = tensor.broadcast_like_f_32(inverse_rms, input_f_32)
    normalized = tensor.multiply_f_32(input_f_32, inverse_rms)
    normalized_bf_16 = tensor.f32_to_bf_16(normalized)
    broadcast_weight = tensor.broadcast_like_bf_16(weight, normalized_bf_16)
    return tensor.multiply_bf_16(normalized_bf_16, broadcast_weight)

def decoder_layer(
    hidden: Tensor[bf16],
    weights: Qwen2DecoderWeights,
    cache: attention.KvCache,
    rotary: rope.RopeValues,
    causal_mask: Tensor[f32],
    position: int,
    epsilon: float,
    num_heads: int,
    num_kv_heads: int,
    head_dimension: int,
) -> DecoderResult:
    current := hidden
    residual := current
    normalized := rms_norm(current, weights.input_norm, epsilon)
    attended = attention.self_attention(
        normalized,
        weights.attention,
        cache,
        rotary,
        causal_mask,
        position,
        num_heads,
        num_kv_heads,
        head_dimension,
    )
    current = tensor.ranked_add(residual, attended.output)
    residual = current
    normalized = rms_norm(current, weights.post_attention_norm, epsilon)
    feed_forward = mlp.qwen2_mlp(normalized, weights.mlp)
    return DecoderResult(
        tensor.ranked_add(residual, feed_forward),
        attended.cache,
    )
