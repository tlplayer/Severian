def following_view() -> string:
    text = "old"
    alias := text
    text = "new"
    return alias

def copied_value() -> string:
    text = "old"
    snapshot := copy text
    text = "new"
    return snapshot

test "compound grammar borrows storage through a fixed borrow binding":
    value = 2
    slot := borrow value
    slot += 3
    assert(value == 5)

test with compiler "compound grammar rejects a view receiver":
    reject:
        def invalid():
            value = 2
            slot := view value
            slot += 3


test "move and drop are prefix operators":
    item = 3
    moved := move item
    drop moved
