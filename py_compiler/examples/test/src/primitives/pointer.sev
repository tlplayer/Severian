unsafe:
    address: pointer = pointer(0)

test "pointer construction stays within unsafe":
    unsafe:
        address: pointer = pointer(4096)
        copied = address

test with compiler "pointer construction requires unsafe":
    reject:
        address: pointer = pointer(0)
    reject:
        address: pointer = 0
    accept:
        unsafe:
            address: pointer = pointer(0)

test "raw pointer scalar comparisons and address conversion":
    unsafe:
        address: usize = 4096
        raw = pointer(address)
        assert(usize(raw) == address)
        assert(raw == pointer(4096))
        assert(raw != pointer(0))
        assert(raw > pointer(0))
