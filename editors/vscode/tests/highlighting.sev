import math
import tensor
from model import neuralnet as nn

native("sev_print_i64") def native_print(value: i64)

@tensor(target, amd, ^)
class HttpServer:
    port: int

    def HttpServer(initial_port: int):
        port = initial_port

    def run_server(input_tensor: Tensor[f32, dynamic, 768]) -> Result[int, IoError]:
        values := [1, 2, 3]
        values_view = view values
        mutable_values := [1, 2, 3]
        writable = borrow mutable_values
        copy_source = [1, 2, 3]
        copied = clone copy_source
        owned = move copied
        worker = async print(f"port={port}") with runtime
        await worker
        score = 3.0 ** 2.0
        return size(values_view)

    test with integration "native output":
        assert(size([1, 2, 3]) == 3)

    test with property and chaos "ownership":
        assert(true and not false)
