import math
import tensor
from model import neuralnet as nn

# Primitive coverage is intentionally explicit: the editor/API test checks
# every width family without inventing width-named operations.
type PrimitiveFixture:
    signed: i128
    unsigned: u128
    float_e4m3: f8e4m3fn
    float_e5m2: f8e5m2
    brain: bf16
    extended: f80
    widest: f128
    elapsed: duration


enum EditorMode:
    Ready
    Failed


extern def editor_clock() -> duration

trait Bits[T]:
    operator |(a: T, b: T) -> T
    operator &(a: T, b: T) -> T
    operator ^(a: T, b: T) -> T

def native_print(value: i64):
    print(value)

@tensor(target, amd, ^)
class HttpServer:
    port: int

    def HttpServer(initial_port: int):
        port = initial_port

    def run_server(input_tensor: Tensor[f32, dynamic, 768]) -> int | IoError:
        values := [1, 2, 3]
        values_view = view values
        mutable_values := [1, 2, 3]
        writable = borrow mutable_values
        copy_source = [1, 2, 3]
        copied = clone copy_source
        owned = move copied
        worker = async print(f"port={port}") with runtime
        summary = f"""server port={port}
status=ready
"""
        await worker
        score = 3.0 ** 2.0
        maybe ?= find_port()
        exact := 1
        window = values[0..2]
        rest = values[...]
        return size(values_view)

    test with integ "native output":
        assert(size([1, 2, 3]) == 3)

    test with property and chaos "ownership":
        assert(true and not false)


extend HttpServer:
    property active: bool


def control_surface(value: int):
    mut pending := value
    copied = copy pending
    locked = lock copied
    try:
        always pending > 0:
            pass
    catch Error:
        pending = 0
    select:
        case pending > 0:
            pending = limit(pending, 1)


compiler "editor vocabulary":
    accept:
        copy_source = clone [1]
    reject:
        moved = move copy_source
