{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Severian",
  "scopeName": "source.severian",
  "fileTypes": [
    "sev"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#formatted-strings" },
    { "include": "#characters" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#native-declarations" },
    { "include": "#function-declarations" },
    { "include": "#type-declarations" },
    { "include": "#tests" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#ownership" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#member-access" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.severian",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.severian" }
          },
          "end": "$"
        }
      ]
    },
    "formatted-strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.interpolated.severian",
          "begin": "(?<![A-Za-z0-9_])f\"\"\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.severian" }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.severian" }
          },
          "patterns": [
            {
              "name": "meta.interpolation.severian",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.severian" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.severian" }
              },
              "patterns": [
                { "include": "#numbers" },
                { "include": "#constants" },
                { "include": "#member-access" },
                { "include": "#function-calls" },
                { "include": "#operators" },
                { "include": "#punctuation" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.interpolated.severian",
          "begin": "(?<![A-Za-z0-9_])f\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.severian" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.severian" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.severian",
              "match": "\\\\[nrt\"\\\\]"
            },
            {
              "name": "meta.interpolation.severian",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.severian" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.severian" }
              },
              "patterns": [
                { "include": "#numbers" },
                { "include": "#constants" },
                { "include": "#member-access" },
                { "include": "#function-calls" },
                { "include": "#operators" },
                { "include": "#punctuation" }
              ]
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.severian",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.severian" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.severian" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.severian",
              "match": "\\\\[nrt\"\\\\]"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.character.severian",
          "match": "'(?:\\\\[nrt'\\\\]|[^'\\\\])'"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "begin": "^\\s*(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.annotation.severian" },
            "2": { "name": "entity.name.function.decorator.severian" },
            "3": { "name": "punctuation.definition.arguments.begin.severian" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.arguments.end.severian" }
          },
          "patterns": [
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#strings" },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "constant.other.decorator-symbol.severian"
            },
            {
              "match": "[+\\-*/%^|&]",
              "name": "keyword.operator.decorator.severian"
            },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "native-declarations": {
      "patterns": [
        {
          "match": "\\b(extern)\\b",
          "captures": {
            "1": { "name": "storage.modifier.native.severian" }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.severian" },
            "2": { "name": "entity.name.function.constructor.severian" }
          }
        },
        {
          "match": "\\b(def)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.severian" },
            "2": { "name": "entity.name.function.severian" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*:\\s*[A-Za-z_][A-Za-z0-9_.]*(?:\\s*\\[)?)",
          "name": "variable.parameter.severian"
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(class|trait|enum|extend|type)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.severian" },
            "2": { "name": "entity.name.type.severian" }
          }
        }
      ]
    },
    "tests": {
      "patterns": [
        {
          "match": "^\\s*(test)\\b",
          "captures": {
            "1": { "name": "keyword.other.test.severian" }
          }
        },
        {
          "match": "\\b(compiler|accept|reject|property|bench|chaos|integ|profile|differential|timeout|skip|repeat|mock)\\b",
          "name": "storage.modifier.test.severian"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "^\\s*(import|from)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.severian" }
          }
        },
        {
          "match": "\\bas\\b",
          "name": "keyword.control.import.severian"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|elif|else|while|for|in|switch|match|case|when|always|return|throw|break|continue|pass|try|catch|unsafe|defer|with|select|limit|operator)\\b",
          "name": "keyword.control.severian"
        },
        {
          "match": "\\b(async|await|send|parallel|distributed|tasks|simd|simt|gpu)\\b",
          "name": "keyword.control.flow.severian"
        },
        {
          "match": "\\b(with|from|as)\\b",
          "name": "keyword.control.resource.severian"
        },
        {
          "match": "\\b(and|or|not|is)\\b",
          "name": "keyword.operator.logical.severian"
        },
        {
          "match": "\\b(assert|throws)\\b",
          "name": "keyword.other.assert.severian"
        }
      ]
    },
    "ownership": {
      "patterns": [
        {
          "match": "\\b(view|borrow|clone|move|mut|drop|copy|lock)\\b",
          "name": "storage.modifier.ownership.severian"
        },
        {
          "match": "&",
          "name": "keyword.operator.address.severian"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false|None|absent|invalid|dynamic)\\b",
          "name": "constant.language.severian"
        },
        {
          "match": "\\b(self|runtime)\\b",
          "name": "variable.language.severian"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:ns|us|ms|s|b|kb|mb|gb)?\\b",
          "name": "constant.numeric.severian"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(bool|char|int|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|float|f8e4m3fn|f8e5m2|f16|bf16|f32|f64|f80|f128|string|bytes|Error|None|unit|args|data_size|duration|data_rate|frequency|percentage|temperature|voltage|current|power)\\b",
          "name": "storage.type.primitive.severian"
        },
        {
          "match": "\\b(Any|Tensor|Result|TestResult|Option|Function|Channel|Buffer|Path|list|map|set|tuple|pointer)\\b",
          "name": "support.type.builtin.severian"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "support.type.severian"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(assert|panic|exception|print|range|size|enumerate|zip|indices|present|throws)\\b(?=\\s*\\()",
          "name": "support.function.builtin.severian"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.member.severian"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b(?=\\s*\\()",
          "name": "entity.name.function.call.severian"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\.\\.\\.|\\.\\.|\\?=|:=|==|!=|<=|>=|->|\\+=|-=|\\*=|/=|%=|\\*\\*|[=+\\-*/%<>|&@^]",
          "name": "keyword.operator.severian"
        },
        {
          "match": "(?<![A-Za-z0-9_])X(?![A-Za-z0-9_])",
          "name": "keyword.operator.matrix.severian"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[()\\[\\]{},.:]",
          "name": "punctuation.separator.severian"
        }
      ]
    }
  }
}
